// std.thread: operating system threads (pthreads).

/// The error of `spawn`: the system has no resources for another thread.
pub error SpawnError {
    SystemResources
}

/// A running thread. `join` waits for it to finish; every spawned thread
/// is joined once.
pub struct Thread {
    handle: u64

    /// Waits until the thread's function has returned.
    pub fn join(self: Self) {
        ore_thread_join(self.handle)
    }
}

/// Starts a thread that runs `f(arg)`. `arg` must stay valid until the
/// thread is joined, and what the thread shares with others is guarded by
/// a `std.sync.Mutex`, sent through a `std.sync.Channel` or an
/// `std.sync.Atomic` (an allocator is not shared: give each thread its
/// own).
pub fn spawn(comptime T: type, f: fn(*mut T), arg: *mut T) SpawnError!Thread {
    var handle: u64 = 0
    if !ore_thread_spawn(@ptrCast(fn([*]u8), f), @ptrCast([*]u8, arg), &mut handle) {
        return SpawnError.SystemResources
    }
    return Thread { handle: handle }
}

extern fn ore_thread_spawn(f: fn([*]u8), arg: [*]u8, out: *mut u64) bool
extern fn ore_thread_join(t: u64)
