// std.http: the HTTP/1.1 wire format, `Server` on a fixed number of worker
// threads, and a client (`get`, `post`, `request`; `https://` through libcurl).
// `parse` reads one request from a byte buffer and says how many bytes it used,
// so a server can parse pipelined requests by parsing again from the rest.
// `writeResponse` builds a response. A handler takes a context pointer and
// a `*Request` and returns a `Response`; there are no closures.
//
// Parsing is strict: lines end in CRLF, a header value has no bare CR, LF
// or NUL, and a request that has both Content-Length and Transfer-Encoding
// is refused. The size limits give distinct error tags, so the server can
// answer 400, 413, 414, 431 or 505 (`errorStatus`).

@linkOptional("libcurl")

import std
import std.heap.Arena
import std.heap.General
import std.list.List
import std.mem
import std.mem.AllocError
import std.mem.Allocator
import std.net
import std.net.Conn
import std.net.ListenError
import std.net.Listener
import std.net.PollFd
import std.net.ReadError
import std.os
import std.sync.Atomic
import std.sync.Mutex
import std.text
import std.text.Builder
import std.thread
import std.thread.Thread
import std.time

/// Why `parse` gave no request. `Incomplete` is not a fault: the buffer
/// holds only the start of a request, so read more bytes and parse again.
/// The size tags are `RequestLineTooLong` (414), `HeadersTooLarge` (431)
/// and `BodyTooLarge` (413); `BadRequest` (400) and `UnsupportedVersion`
/// (505) are malformed input.
pub error ParseError {
    Incomplete,
    BadRequest,
    UnsupportedVersion,
    RequestLineTooLong,
    HeadersTooLarge,
    BodyTooLarge,
    OutOfMemory,
}

/// Size limits for `parse`, in bytes.
pub struct Limits {
    /// The request line, without its CRLF.
    maxRequestLine: usize
    /// All header lines together, with their CRLFs and the blank line.
    maxHeaders: usize
    /// The body, after any chunked decoding.
    maxBody: usize
}

/// 8 KiB for the request line, 16 KiB for the headers, 1 MiB for the body.
pub fn defaultLimits() Limits {
    return Limits { maxRequestLine: 8192, maxHeaders: 16384, maxBody: 1048576 }
}

/// A header: both slices point into the buffer given to `parse`, or into
/// the data of the response being built.
pub struct Header {
    name: []u8
    value: []u8
}

/// A parsed request. `method`, `target` and the headers point into the
/// buffer given to `parse`, which must outlive the request; a chunked body
/// is a copy owned by the request. Call `deinit` when done.
pub struct Request {
    method: []u8
    target: []u8
    /// 0 for HTTP/1.0, 1 for HTTP/1.1.
    minor: u8
    headers: List(Header)
    /// The body: empty when the request had none.
    body: []u8
    chunks: Builder

    /// Frees the headers and the decoded chunked body.
    pub fn deinit(self: *mut Self) {
        self.headers.deinit()
        self.chunks.deinit()
        self.body = []u8{}
    }

    /// The value of the first header called `name`, compared without
    /// regard to ASCII case; null when there is none.
    pub fn header(self: *Self, name: []u8) ?[]u8 {
        for h in self.headers.items() {
            if text.eqlIgnoreCase(h.name, name) {
                return h.value
            }
        }
        return null
    }

    /// Should the connection stay open after the response? HTTP/1.1
    /// unless `Connection: close`; HTTP/1.0 only with `Connection:
    /// keep-alive`.
    pub fn keepAlive(self: *Self) bool {
        if self.header("connection") |v| {
            if text.eqlIgnoreCase(v, "close") {
                return false
            }
            if text.eqlIgnoreCase(v, "keep-alive") {
                return true
            }
        }
        return self.minor == 1
    }

    /// The target without its query string.
    pub fn path(self: *Self) []u8 {
        return pathOf(self.target)
    }

    /// The first value of `name` in the query string, percent-decoded
    /// (`+` is a space) in `alloc`; null when there is none. See
    /// `queryValue`.
    pub fn query(self: *Self, alloc: Allocator, name: []u8) AllocError!?[]u8 {
        return queryValue(alloc, queryOf(self.target), name)
    }

    /// The first value of the field `name` of a `application/x-www-form-urlencoded`
    /// body, decoded in `alloc`; null when there is none or the request has
    /// another content type. See `formValue`.
    pub fn form(self: *Self, alloc: Allocator, name: []u8) AllocError!?[]u8 {
        return formValue(alloc, self.header("content-type"), self.body, name)
    }

    /// The value of the cookie `name` of the `Cookie` header, as sent;
    /// null when there is none. See `cookieValue`.
    pub fn cookie(self: *Self, name: []u8) ?[]u8 {
        if self.header("cookie") |h| {
            return cookieValue(h, name)
        }
        return null
    }
}

/// The result of `parse`: the request and the number of bytes it took from
/// the buffer (parse the rest for a pipelined request).
pub struct Parsed {
    request: Request
    consumed: usize
}

/// The target without its query string.
pub fn pathOf(target: []u8) []u8 {
    if text.indexOf(target, "?") |i| {
        return target[..i]
    }
    return target
}

/// The query string of a target: what follows the first `?`, as sent;
/// empty when there is none.
pub fn queryOf(target: []u8) []u8 {
    if text.indexOf(target, "?") |i| {
        return target[i + 1..]
    }
    return target[target.len..]
}

/// Decodes `%XX` escapes of `s` in `alloc`. A `%` not followed by two hex
/// digits stays as it is. `+` stays a `+`; `formDecode` makes it a space.
pub fn percentDecode(alloc: Allocator, s: []u8) AllocError![]mut u8 {
    return decodeEscapes(alloc, s, false)
}

/// Like `percentDecode`, and each `+` becomes a space: the decoding of a
/// query string or a form body.
pub fn formDecode(alloc: Allocator, s: []u8) AllocError![]mut u8 {
    return decodeEscapes(alloc, s, true)
}

fn decodeEscapes(alloc: Allocator, s: []u8, plusIsSpace: bool) AllocError![]mut u8 {
    var out = Builder.init(alloc)
    errdefer out.deinit()
    var i: usize = 0
    while i < s.len {
        let c = s[i]
        i += 1
        if c == '+' && plusIsSpace {
            try out.appendByte(' ')
            continue
        }
        if c == '%' && i + 1 < s.len {
            if hexValue(s[i]) |hi| {
                if hexValue(s[i + 1]) |lo| {
                    try out.appendByte((hi * 16 + lo) as u8)
                    i += 2
                    continue
                }
            }
        }
        try out.appendByte(c)
    }
    return out.toOwned()
}

/// The first value of `name` in `pairs`, a query string or a form body
/// (`a=1&b=2`), with names and value decoded by `formDecode` in `alloc`; a
/// pair without `=` has the value "". Null when no pair has the name.
pub fn queryValue(alloc: Allocator, pairs: []u8, name: []u8) AllocError!?[]u8 {
    var it = text.split(pairs, "&")
    while it.next() |pair| {
        if pair.len == 0 {
            continue
        }
        var key = pair
        var value = pair[pair.len..]
        if text.indexOf(pair, "=") |eq| {
            key = pair[..eq]
            value = pair[eq + 1..]
        }
        let k = try formDecode(alloc, key)
        if text.eql(k, name) {
            return try formDecode(alloc, value)
        }
    }
    return null
}

/// `queryValue` of `body` when `contentType` is `application/x-www-form-urlencoded`
/// (parameters such as `; charset=utf-8` and ASCII case are ignored); null
/// for any other type, or none.
pub fn formValue(alloc: Allocator, contentType: ?[]u8, body: []u8, name: []u8) AllocError!?[]u8 {
    let ct = contentType orelse return null
    var media = ct
    if text.indexOf(ct, ";") |i| {
        media = ct[..i]
    }
    if !text.eqlIgnoreCase(text.trim(media), "application/x-www-form-urlencoded") {
        return null
    }
    return queryValue(alloc, body, name)
}

/// The value of the cookie `name` in the value of a `Cookie` header
/// (`a=1; b=2`): spaces around a pair are trimmed and the value is not
/// decoded. Null when there is none.
pub fn cookieValue(header: []u8, name: []u8) ?[]u8 {
    var it = text.split(header, ";")
    while it.next() |part| {
        let pair = text.trim(part)
        if text.indexOf(pair, "=") |eq| {
            if text.eql(pair[..eq], name) {
                return pair[eq + 1..]
            }
        }
    }
    return null
}

/// A response: the one a server handler fills for `writeResponse` (do not
/// put Content-Length or Transfer-Encoding in `headers`: the writer sets
/// the length itself), and the one a client call returns.
pub struct Response {
    status: u16
    headers: []Header
    body: []u8
    /// Set by `stream()`; a client response never has it.
    streaming: bool = false

    /// Turns the response of a server handler into a server-sent event
    /// stream (O3.6b). The server writes the status line, the handler's
    /// `headers`, `Content-Type: text/event-stream`, `Cache-Control:
    /// no-cache` and `Connection: keep-alive`, with no `Content-Length`
    /// (`Content-Type` is not to be in `headers`). A non-empty `res.body` is
    /// written as is, right after the head, as the first chunk of the stream
    /// (O3.6d): the handler formats it as event frames (`event: build\ndata:
    /// x\n\n`), with no chunked framing. Then the server keeps the connection
    /// open: `Server.broadcast` sends events to it until the client leaves
    /// or the server stops, and none is sent before the first chunk is
    /// written. A `HEAD` request is answered as a plain response.
    pub fn stream(self: *mut Self) {
        self.streaming = true
    }

    /// The value of the first header called `name`, compared without
    /// regard to ASCII case; null when there is none.
    pub fn header(self: *Self, name: []u8) ?[]u8 {
        return findHeader(self.headers, name)
    }
}

// The value of the first header of `hs` called `name`, ignoring ASCII case.
fn findHeader(hs: []Header, name: []u8) ?[]u8 {
    for h in hs {
        if text.eqlIgnoreCase(h.name, name) {
            return h.value
        }
    }
    return null
}

/// The HTTP status that answers a `ParseError`: 400, 413, 414, 431, 500 or
/// 505. `Incomplete` is 400 too, for a peer that closed in mid-request.
pub fn errorStatus(e: ParseError) u16 {
    return match e {
        .Incomplete => 400
        .BadRequest => 400
        .UnsupportedVersion => 505
        .RequestLineTooLong => 414
        .HeadersTooLarge => 431
        .BodyTooLarge => 413
        .OutOfMemory => 500
    }
}

/// Parses one HTTP/1.1 request from the start of `buf`: the request line,
/// the headers, then the body by Content-Length or `Transfer-Encoding:
/// chunked`. Returns the request and the bytes used; `Incomplete` when
/// `buf` holds only part of a request. A limit is checked as soon as it is
/// passed, not when the request is complete.
pub fn parse(alloc: Allocator, buf: []u8, limits: Limits) ParseError!Parsed {
    // Request line.
    var lineEnd: usize = 0
    if crlf(buf, 0) |i| {
        lineEnd = i
    } else {
        if buf.len > limits.maxRequestLine + 1 {
            return ParseError.RequestLineTooLong
        }
        return ParseError.Incomplete
    }
    if lineEnd > limits.maxRequestLine {
        return ParseError.RequestLineTooLong
    }
    let line = buf[..lineEnd]
    let sp1 = text.indexOf(line, " ") orelse return ParseError.BadRequest
    let rest = line[sp1 + 1..]
    let sp2 = text.indexOf(rest, " ") orelse return ParseError.BadRequest
    let method = line[..sp1]
    let target = rest[..sp2]
    let version = rest[sp2 + 1..]
    if method.len == 0 || target.len == 0 {
        return ParseError.BadRequest
    }
    for c in method {
        if !isToken(c) {
            return ParseError.BadRequest
        }
    }
    for c in target {
        if c <= 32 || c == 127 {
            return ParseError.BadRequest
        }
    }
    var minor: u8 = 1
    if text.eql(version, "HTTP/1.1") {
        minor = 1
    } else if text.eql(version, "HTTP/1.0") {
        minor = 0
    } else if text.startsWith(version, "HTTP/") {
        return ParseError.UnsupportedVersion
    } else {
        return ParseError.BadRequest
    }

    var req = Request {
        method: method,
        target: target,
        minor: minor,
        headers: List(Header).init(alloc),
        body: []u8{},
        chunks: Builder.init(alloc),
    }
    errdefer req.deinit()

    // Headers.
    var pos = lineEnd + 2
    let headersStart = pos
    while true {
        var end: usize = 0
        if crlf(buf, pos) |i| {
            end = i
        } else {
            if buf.len - headersStart > limits.maxHeaders + 1 {
                return ParseError.HeadersTooLarge
            }
            return ParseError.Incomplete
        }
        if end + 2 - headersStart > limits.maxHeaders {
            return ParseError.HeadersTooLarge
        }
        if end == pos {
            pos = end + 2
            break
        }
        let h = parseHeader(buf[pos..end]) orelse return ParseError.BadRequest
        req.headers.append(h) catch return ParseError.OutOfMemory
        pos = end + 2
    }

    // Body.
    let te = req.header("transfer-encoding")
    let cl = req.header("content-length")
    if te |t| {
        if cl != null || !text.eqlIgnoreCase(text.trim(t), "chunked") {
            return ParseError.BadRequest
        }
        pos = try readChunked(buf, pos, limits, &mut req.chunks)
        req.body = req.chunks.bytes()
    } else if cl |v| {
        for h in req.headers.items() {
            if text.eqlIgnoreCase(h.name, "content-length") && !text.eql(h.value, v) {
                return ParseError.BadRequest
            }
        }
        let n = try contentLength(v, limits.maxBody)
        if buf.len - pos < n {
            return ParseError.Incomplete
        }
        req.body = buf[pos..pos + n]
        pos += n
    }
    return Parsed { request: req, consumed: pos }
}

// The index of the first CRLF at or after `from`.
fn crlf(buf: []u8, from: usize) ?usize {
    var i = from
    while i + 1 < buf.len {
        if buf[i] == '\r' && buf[i + 1] == '\n' {
            return i
        }
        i += 1
    }
    return null
}

// A tchar of RFC 9110: what a method or a header name is made of.
fn isToken(c: u8) bool {
    if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') {
        return true
    }
    return c == '!' || c == '#' || c == '$' || c == '%' || c == '&' || c == '\'' || c == '*' || c == '+' || c == '-' || c == '.' || c == '^' || c == '_' || c == '`' || c == '|' || c == '~'
}

// "Name: value" as a Header; null when it is malformed.
fn parseHeader(line: []u8) ?Header {
    let colon = text.indexOf(line, ":") orelse return null
    if colon == 0 {
        return null
    }
    let name = line[..colon]
    for c in name {
        if !isToken(c) {
            return null
        }
    }
    let value = text.trim(line[colon + 1..])
    for c in value {
        if c == '\r' || c == '\n' || c == 0 {
            return null
        }
    }
    return Header { name: name, value: value }
}

// A Content-Length value: digits only; over `max` is BodyTooLarge.
fn contentLength(v: []u8, max: usize) ParseError!usize {
    if v.len == 0 {
        return ParseError.BadRequest
    }
    var n: usize = 0
    for c in v {
        if c < '0' || c > '9' {
            return ParseError.BadRequest
        }
        // Checked before the arithmetic, which would overflow a 32-bit
        // `usize` (wasm32) when `max` is near its top.
        let d = (c - '0') as usize
        if n > max / 10 || d > max - n * 10 {
            return ParseError.BodyTooLarge
        }
        n = n * 10 + d
    }
    return n
}

fn hexValue(c: u8) ?usize {
    if c >= '0' && c <= '9' {
        return (c - '0') as usize
    }
    if c >= 'a' && c <= 'f' {
        return (c - 'a') as usize + 10
    }
    if c >= 'A' && c <= 'F' {
        return (c - 'A') as usize + 10
    }
    return null
}

// Decodes the chunks that start at `from` into `out`; returns the index
// after the last chunk and its trailers.
fn readChunked(buf: []u8, from: usize, limits: Limits, out: *mut Builder) ParseError!usize {
    var pos = from
    while true {
        var end: usize = 0
        if crlf(buf, pos) |i| {
            end = i
        } else {
            if buf.len - pos > limits.maxRequestLine + 1 {
                return ParseError.BadRequest
            }
            return ParseError.Incomplete
        }
        var sizeLine = buf[pos..end]
        if text.indexOf(sizeLine, ";") |semi| {
            sizeLine = sizeLine[..semi]
        }
        sizeLine = text.trim(sizeLine)
        if sizeLine.len == 0 {
            return ParseError.BadRequest
        }
        var size: usize = 0
        for c in sizeLine {
            let d = hexValue(c) orelse return ParseError.BadRequest
            if size > limits.maxBody / 16 || d > limits.maxBody - size * 16 {
                return ParseError.BodyTooLarge
            }
            size = size * 16 + d
        }
        pos = end + 2
        if size == 0 {
            // Trailers: skipped, within the header limit.
            let trailersStart = pos
            while true {
                var tend: usize = 0
                if crlf(buf, pos) |i| {
                    tend = i
                } else {
                    if buf.len - trailersStart > limits.maxHeaders + 1 {
                        return ParseError.HeadersTooLarge
                    }
                    return ParseError.Incomplete
                }
                if tend + 2 - trailersStart > limits.maxHeaders {
                    return ParseError.HeadersTooLarge
                }
                let empty = tend == pos
                pos = tend + 2
                if empty {
                    return pos
                }
            }
        }
        if size > limits.maxBody - out.len() {
            return ParseError.BodyTooLarge
        }
        if buf.len - pos < 2 || buf.len - pos - 2 < size {
            return ParseError.Incomplete
        }
        if buf[pos + size] != '\r' || buf[pos + size + 1] != '\n' {
            return ParseError.BadRequest
        }
        out.append(buf[pos..pos + size]) catch return ParseError.OutOfMemory
        pos += size + 2
    }
    unreachable
}

/// The standard reason phrase of `status` ("OK" for 200); "Unknown" for a
/// code without one.
pub fn reason(status: u16) []u8 {
    return match status {
        100 => "Continue"
        200 => "OK"
        201 => "Created"
        202 => "Accepted"
        204 => "No Content"
        206 => "Partial Content"
        301 => "Moved Permanently"
        302 => "Found"
        303 => "See Other"
        304 => "Not Modified"
        307 => "Temporary Redirect"
        308 => "Permanent Redirect"
        400 => "Bad Request"
        401 => "Unauthorized"
        403 => "Forbidden"
        404 => "Not Found"
        405 => "Method Not Allowed"
        408 => "Request Timeout"
        409 => "Conflict"
        411 => "Length Required"
        413 => "Content Too Large"
        414 => "URI Too Long"
        415 => "Unsupported Media Type"
        422 => "Unprocessable Content"
        429 => "Too Many Requests"
        431 => "Request Header Fields Too Large"
        500 => "Internal Server Error"
        501 => "Not Implemented"
        502 => "Bad Gateway"
        503 => "Service Unavailable"
        504 => "Gateway Timeout"
        505 => "HTTP Version Not Supported"
        _ => "Unknown"
    }
}

/// Appends the response to `out`: the status line with its reason phrase,
/// the headers of `res`, `Content-Length` and the body.
pub fn writeResponse(out: *mut Builder, res: Response) AllocError!void {
    try out.append("HTTP/1.1 ")
    try out.appendUint(res.status as u64)
    try out.append(" ")
    try out.append(reason(res.status))
    try out.append("\r\n")
    for h in res.headers {
        try out.append(h.name)
        try out.append(": ")
        try out.append(h.value)
        try out.append("\r\n")
    }
    try out.append("Content-Length: ")
    try out.appendUint(res.body.len as u64)
    try out.append("\r\n\r\n")
    try out.append(res.body)
}

/// Adds a `Connection` header to a copy of the response's header list.
fn withConnection(alloc: Allocator, res: Response, value: []u8) AllocError!Response {
    let n = res.headers.len
    let hs = try alloc.alloc(Header { name: "Connection", value: value }, n + 1)
    for i in 0..n {
        hs[i] = res.headers[i]
    }
    return Response { status: res.status, headers: hs, body: res.body }
}

/// Listens on `host:port` (port 0 lets the system pick one) for a
/// context of type `T`; `ctx` must stay valid until `run` has returned.
pub fn listen(comptime T: type, host: []u8, port: u16, ctx: *mut T, handler: fn(*mut T, *Request, *mut Response, Allocator)) ListenError!Server {
    let l = try net.listenShared(host, port)
    var lo: []u8 = "127.0.0.1"
    if mem.indexOf(host, ':') != null {
        lo = "::1"
    }
    return Server {
        listener: l,
        ctx: @ptrCast([*]u8, ctx),
        handler: @ptrCast(fn([*]u8, *Request, *mut Response, Allocator), handler),
        limits: defaultLimits(),
        idleMs: 5000,
        workers: defaultWorkers(),
        stopped: Atomic(u32).init(0),
        accepting: Atomic(u32).init(0),
        loopback: lo,
        streamLock: Mutex.init(),
        streamHead: null,
        openLock: Mutex.init(),
        openGpa: General.init(),
        crew: []mut Worker{},
    }
}

// `Server.workers` to begin with: the number of CPUs, 2 to 64.
fn defaultWorkers() u32 {
    let n = os.cpuCount()
    if n < 2 {
        return 2
    }
    if n > 64 {
        return 64
    }
    return n
}

/// Serves HTTP/1.1 on a TCP port with a fixed number of threads (`workers`),
/// each accepting connections and serving the ones it holds, with keep-alive
/// and pipelining. Every handler gets the context pointer given to `listen`
/// (the `std.thread.spawn(T, f, arg)` shape; there are no closures). A
/// handler is `fn(ctx: *mut T, req: *Request, res: *mut Response, alloc:
/// Allocator)`: it fills `res` (status 200 and no body to begin with);
/// `alloc` is an arena that lives until the response is written (the
/// connection's arena, reset once the response is all written), so a handler
/// allocates and never frees, and keeps no pointer into it past the call. Handlers run on many threads at once:
/// what they share through `ctx` needs a `std.sync.Mutex` or an `Atomic`.
/// A `HEAD` request is answered like a `GET` (the handler sees the method and
/// may fill the same body): the server writes the status line, the headers
/// and the `Content-Length` of `res.body`, and not the body.
///
/// Make it with `listen` (which listens, so `port()` is known at once, also
/// for port 0), run `run` on a thread, and end it with `stop`.
///
/// Slow clients (O3.9a): connections are non-blocking, and what the socket
/// does not take of a response at once stays in the connection's arena
/// until `poll` says there is room, so a client that reads slowly holds up
/// only itself. Its next request (pipelined or not) is answered only after
/// the response is all written, and a client that takes no bytes for
/// `idleMs` is closed. A write error closes the connection.
///
/// Slow handlers (O3.9b): a worker that has run one handler for more than
/// 20 ms has its other connections taken over by another worker, which
/// serves them from then on, so a slow handler holds up only its own
/// connection. With `workers = 1` there is no other worker to take them.
///
/// New connections (O3.9c): on Linux each worker has a listener of its own
/// on the port (`SO_REUSEPORT`, `net.listenShared`), so the kernel hands a
/// new connection to one worker and wakes only that one; the connections
/// waiting on the listener of a worker whose handler is slow are taken
/// with its other connections. On macOS, which does not spread connections
/// over such listeners, the workers share one. Because of `SO_REUSEPORT`, a
/// second server of the same user on the same port does not fail on Linux.
///
/// Server-sent events (O3.6b): a handler that calls `res.stream()` makes its
/// connection a stream, which `broadcast` writes events to from any thread.
/// Threading: the worker that accepted the connection owns it (it reads
/// and closes it, and discards what the client sends); `streamLock` guards
/// the list of open streams, and every write to a stream happens under it.
/// A worker takes the lock to add a stream (once the response head and the
/// body, the first chunk, are written, so no event comes before them) and
/// to remove it before it closes the connection, so `broadcast` never writes to a closed or reused
/// descriptor. A stream that cannot take an event at once (the client is
/// gone, or its socket buffer is full) is dropped, never waited for: the
/// writing thread removes it from the list and the owning worker closes it
/// within about 100 ms. A stream has no idle timeout, and `stop` closes it.
pub struct Server {
    listener: Listener
    ctx: [*]u8
    handler: fn([*]u8, *Request, *mut Response, Allocator)
    /// The size limits for parsing requests; `defaultLimits()` to begin with.
    limits: Limits
    /// How long an open connection may wait for its next request, in
    /// milliseconds (5000 to begin with); `stop` takes at most this long to
    /// finish the connections that are open.
    idleMs: u32
    /// How many threads `run` serves on (at most 64): the number of CPUs,
    /// at least 2, to begin with. Set it before `run`. A handler that blocks
    /// holds up only its own connection (see `Server`).
    workers: u32
    stopped: Atomic(u32)
    // 1 while a worker accepts from `listener` (`acceptOn`).
    accepting: Atomic(u32)
    loopback: []u8
    // Guards `streamHead` and the writes to the streams on it.
    streamLock: Mutex
    // The open streams, linked through `Open.next`.
    streamHead: ?*mut Open
    // The `Open` records of all workers come from `openGpa`, under
    // `openLock`, so that any worker can close one (O3.9b).
    openLock: Mutex
    openGpa: General
    // The workers of `run`, so that one can take the connections of
    // another whose handler is slow.
    crew: []mut Worker

    /// The port it listens on.
    pub fn port(self: *Self) u16 {
        return self.listener.port()
    }

    /// Serves until `stop` (or SIGINT or SIGTERM after `std.os.onStop()`):
    /// starts `workers - 1` threads and serves on this one too. Each worker
    /// waits (`poll`) on its listener (see `Server`) and on the connections
    /// it has accepted, and answers the requests that arrive; the kernel spreads
    /// the connections over the workers. Then it finishes the answered
    /// responses (see `stop`), closes the open connections, waits for the
    /// workers and closes the listener. `alloc` is used only by this
    /// thread, for the bookkeeping.
    pub fn run(self: *mut Self, alloc: Allocator) AllocError!void {
        var n = self.workers
        if n < 1 {
            n = 1
        }
        if n > 64 {
            n = 64
        }
        let crew = try alloc.alloc(Worker { s: self, open: List(*mut Open).init(alloc), current: null, state: Atomic(u32).init(0), since: Atomic(u64).init(0), moved: false, lastLook: 0, listener: self.listener, own: false, accepting: Atomic(u32).init(0) }, n as usize)
        defer alloc.free(crew)
        self.crew = crew
        var none: ?Thread = null
        let threads = try alloc.alloc(none, (n - 1) as usize)
        defer alloc.free(threads)
        for i in 0..threads.len {
            let w = &mut crew[i + 1]
            // O3.9c: on Linux each worker gets a listener of its own, so a
            // new connection wakes one worker; else they share `listener`.
            if self.listener.again() |l| {
                w.listener = l
                w.own = true
            } else |e| {}
            threads[i] = thread.spawn(Worker, workerMain, w) catch |e| {
                if w.own {
                    w.listener.close()
                    w.own = false
                }
                break
            }
        }
        workerMain(&mut crew[0])
        for i in 0..threads.len {
            if threads[i] |t| {
                t.join()
            }
        }
        for w in crew {
            if w.own {
                w.listener.close()
            }
        }
        self.listener.close()
        self.streamLock.deinit()
        self.openLock.deinit()
        self.openGpa.deinit()
    }

    /// The number of open event streams.
    pub fn streams(self: *mut Self) usize {
        self.streamLock.lock()
        defer self.streamLock.unlock()
        var n: usize = 0
        var cur = self.streamHead
        while cur |o| {
            n += 1
            cur = o.next
        }
        return n
    }

    /// Writes one event frame to every open stream, from any thread: `event:
    /// <event>` (left out when `event` is empty), one `data:` line per line
    /// of `data`, and a blank line. Gives the number of streams it wrote to;
    /// a stream that cannot take the frame is dropped (see `Server`). `alloc`
    /// holds the frame for the call. Do not call it after `run` has returned.
    pub fn broadcast(self: *mut Self, alloc: Allocator, event: []u8, data: []u8) AllocError!usize {
        var b = Builder.init(alloc)
        defer b.deinit()
        if event.len > 0 {
            try b.append("event: ")
            for c in event {
                if c != '\r' && c != '\n' {
                    try b.appendByte(c)
                }
            }
            try b.append("\n")
        }
        try b.append("data: ")
        for c in data {
            if c == '\n' {
                try b.append("\ndata: ")
            } else if c != '\r' {
                try b.appendByte(c)
            }
        }
        try b.append("\n\n")
        let wire = b.bytes()
        self.streamLock.lock()
        defer self.streamLock.unlock()
        var sent: usize = 0
        var prev: ?*mut Open = null
        var cur = self.streamHead
        while cur |o| {
            let next = o.next
            var ok = writable(o.conn)
            if ok {
                o.conn.write(wire) catch |e| {
                    ok = false
                }
            }
            if ok {
                sent += 1
                prev = o
            } else {
                if prev |p| {
                    p.next = next
                } else {
                    self.streamHead = next
                }
                o.next = null
                o.dead.store(1)
            }
            cur = next
        }
        return sent
    }

    // Removes `o` from the list of streams, if it is on it.
    fn unlinkStream(self: *mut Self, o: *mut Open) {
        self.streamLock.lock()
        defer self.streamLock.unlock()
        var prev: ?*mut Open = null
        var cur = self.streamHead
        while cur |c| {
            if c == o {
                if prev |p| {
                    p.next = c.next
                } else {
                    self.streamHead = c.next
                }
                c.next = null
                return
            }
            prev = c
            cur = c.next
        }
    }

    /// Asks `run` to return: sets the flag and connects once to wake up the
    /// workers. Safe to call from any thread; the listener stops accepting,
    /// a request that is being handled is answered (the rest of a response
    /// the socket has not taken is written first, for at most `idleMs`),
    /// the other open connections are closed, and `run` returns within about
    /// 100 ms. SIGINT or SIGTERM does the same after `std.os.onStop()`.
    pub fn stop(self: *mut Self) {
        self.stopped.store(1)
        let c = net.connect(self.loopback, self.listener.port()) catch |e| {
            return
        }
        c.close()
    }

    // Reads what the peer of `o` has sent (a `poll` said it is there) and
    // answers each whole request in it; false when `o` is to be closed.
    fn serveReady(self: *mut Self, w: *mut Worker, o: *mut Open) bool {
        var chunk = @zeroed([4096]u8)
        let n = o.conn.read(chunk[..]) catch |e| {
            return e == ReadError.WouldBlock
        }
        if n == 0 {
            return false
        }
        if o.stream {
            return true
        }
        o.inbuf.append(chunk[0..n]) catch |e| {
            return false
        }
        return self.serveBuffered(w, o)
    }

    // Writes what the socket of `o` takes of its pending output (a `poll`
    // said it has room). Once all of it is written, the connection is
    // closed if the response said so, or the requests already read are
    // answered; false when `o` is to be closed.
    fn flushReady(self: *mut Self, w: *mut Worker, o: *mut Open) bool {
        if !put(o, o.pending) {
            return false
        }
        if o.pending.len > 0 {
            return true
        }
        if o.stream {
            self.linkStream(o)
            return true
        }
        if o.closing {
            return false
        }
        return self.serveBuffered(w, o)
    }

    // Answers each whole request in `o.inbuf` from `o.off` on, in order. It
    // stops at a response the socket did not take whole: the worker writes
    // the rest when `poll` says there is room (`flushReady`) and only then
    // answers the next request. False when `o` is to be closed.
    fn serveBuffered(self: *mut Self, w: *mut Worker, o: *mut Open) bool {
        let a = o.arena.allocator()
        while self.stopped.load() == 0 {
            let parsed = parse(a, o.inbuf.bytes()[o.off..], self.limits) catch |e| {
                if e == ParseError.Incomplete {
                    o.arena.reset()
                    if o.off > 0 {
                        var rest = Builder.init(o.gpa.allocator())
                        rest.append(o.inbuf.bytes()[o.off..]) catch |e2| {
                            rest.deinit()
                            return false
                        }
                        o.inbuf.deinit()
                        o.inbuf = rest
                        o.off = 0
                    }
                    return true
                }
                let bad = Response { status: errorStatus(e), headers: []Header{}, body: []u8{} }
                let wire = encode(a, bad, "close", false) catch |e2| {
                    return false
                }
                o.closing = true
                return put(o, wire) && o.pending.len > 0
            }
            var req = parsed.request
            o.off += parsed.consumed
            var res = Response { status: 200, headers: []Header{}, body: []u8{} }
            // While the handler runs, another worker may take the other
            // connections of `w` (`rescue`); it waits for state 2 to end.
            w.current = o
            w.since.store(time.monotonicMs())
            w.state.store(1)
            self.handler(self.ctx, &req, &mut res, a)
            while !w.state.compareSwap(1, 0) {
                _ = sched_yield()
            }
            let keep = req.keepAlive()
            var how: []u8 = ""
            if !keep {
                how = "close"
            } else if req.minor == 0 {
                how = "keep-alive"
            }
            if res.streaming && !text.eql(req.method, "HEAD") {
                let ok = self.openStream(a, o, res)
                req.deinit()
                o.inbuf.clear()
                o.off = 0
                return ok
            }
            let wire = encode(a, res, how, text.eql(req.method, "HEAD")) catch |e| {
                return false
            }
            req.deinit()
            o.closing = !keep
            if !put(o, wire) {
                return false
            }
            if o.off == o.inbuf.len() {
                o.inbuf.clear()
                o.off = 0
            }
            if o.pending.len > 0 {
                return true
            }
            if !keep {
                return false
            }
        }
        return false
    }

    // Writes the head of a stream response and its body (the first chunk)
    // as `put` does, and puts `o` on the list of streams once all of it is
    // written (`flushReady` does when the socket took only part), so that
    // `broadcast` never writes before it; false when the write fails.
    fn openStream(self: *mut Self, a: Allocator, o: *mut Open, res: Response) bool {
        var out = Builder.init(a)
        out.append("HTTP/1.1 ") catch |e| {
            return false
        }
        out.appendUint(res.status as u64) catch |e| {
            return false
        }
        out.append(" ") catch |e| {
            return false
        }
        out.append(reason(res.status)) catch |e| {
            return false
        }
        out.append("\r\n") catch |e| {
            return false
        }
        for h in res.headers {
            out.append(h.name) catch |e| {
                return false
            }
            out.append(": ") catch |e| {
                return false
            }
            out.append(h.value) catch |e| {
                return false
            }
            out.append("\r\n") catch |e| {
                return false
            }
        }
        out.append("Content-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: keep-alive\r\n\r\n") catch |e| {
            return false
        }
        out.append(res.body) catch |e| {
            return false
        }
        o.stream = true
        if !put(o, out.bytes()) {
            return false
        }
        if o.pending.len == 0 {
            self.linkStream(o)
        }
        return true
    }

    // Puts `o` on the list of streams, under the lock.
    fn linkStream(self: *mut Self, o: *mut Open) {
        self.streamLock.lock()
        defer self.streamLock.unlock()
        o.next = self.streamHead
        self.streamHead = o
    }
}

// A connection that a worker holds: the bytes from `off` on are read and not
// yet parsed; `last` is when bytes last came (`time.monotonicMs`). `arena`
// serves one request at a time (parse, handler, send) and is reset after
// each; `inbuf` survives the reset. Both are on the connection's own `gpa`,
// so the connection can move to another worker (O3.9b).
// `pending` is the part of the last response the socket has not taken yet:
// it is in the arena, so the arena is reset only once it is written, and
// `closing` says to close the connection then.
struct Open {
    conn: Conn
    gpa: General
    arena: Arena
    inbuf: Builder
    off: usize
    last: u64
    pending: []u8
    closing: bool
    // True once the connection is an event stream: it is on the server's
    // list (`next`), the worker only discards what the client sends, and
    // `dead` is 1 when `broadcast` dropped it from the list.
    stream: bool
    next: ?*mut Open
    dead: Atomic(u32)
}

// A new `Open` for `c` from the server's `openGpa`, or null.
fn makeOpen(s: *mut Server, c: Conn, now: u64) ?*mut Open {
    s.openLock.lock()
    defer s.openLock.unlock()
    let shared = s.openGpa.allocator()
    let o = shared.create(Open { conn: c, gpa: General.init(), arena: Arena.init(shared), inbuf: Builder.init(shared), off: 0, last: now, pending: []u8{}, closing: false, stream: false, next: null, dead: Atomic(u32).init(0) }) catch |e| {
        return null
    }
    o.arena = Arena.init(o.gpa.allocator())
    o.inbuf = Builder.init(o.gpa.allocator())
    return o
}

fn closeOpen(s: *mut Server, o: *mut Open) {
    if o.stream {
        s.unlinkStream(o)
    }
    o.conn.close()
    o.arena.deinit()
    o.inbuf.deinit()
    o.gpa.deinit()
    s.openLock.lock()
    defer s.openLock.unlock()
    s.openGpa.allocator().destroy(o)
}

// A worker of `Server.run`, as the other workers see it (O3.9b). `open` is
// the connections it serves. While it runs a handler, `state` is 1,
// `since` is when the handler began and `current` is the connection the
// handler runs for; another worker that finds the handler running for more
// than SLOW_MS sets `state` to 2, moves the other connections to itself
// (`rescue`), sets `moved` and `state` back to 1. The worker waits for
// `state` 1 to go back to 0 after the handler, so it never sees `open`
// change under it, and starts its loop afresh when `moved` is set.
struct Worker {
    s: *mut Server
    open: List(*mut Open)
    current: ?*mut Open
    state: Atomic(u32)
    since: Atomic(u64)
    moved: bool
    // When it last looked for a slow worker.
    lastLook: u64
    // The listener it accepts from: its own when `own` (O3.9c, Linux), else
    // the server's, which the workers share under `Server.accepting`.
    listener: Listener
    own: bool
    // 1 while a worker accepts from the own listener.
    accepting: Atomic(u32)
}

// Accepts a waiting connection on the listener of `w`, or gives null. One
// worker accepts from a listener at a time, and only after a `poll` that
// does not wait shows a connection, so `accept` never blocks a worker that
// holds other connections.
fn acceptOn(w: *mut Worker) ?Conn {
    var gate = &mut w.s.accepting
    if w.own {
        gate = &mut w.accepting
    }
    if !gate.compareSwap(0, 1) {
        return null
    }
    defer gate.store(0)
    var fds = [1]PollFd{PollFd { fd: w.listener.fd(), events: POLLIN, revents: 0 }}
    if poll(fds[..].ptr, 1, 0) <= 0 {
        return null
    }
    let c = w.listener.accept() catch |e| {
        return null
    }
    return c
}

// Adds a new connection to the list of `me`; false when it was closed instead.
fn adopt(me: *mut Worker, c: Conn, now: u64) bool {
    _ = c.setNonBlocking()
    let made = makeOpen(me.s, c, now)
    if made |o| {
        me.open.append(o) catch |e| {
            closeOpen(me.s, o)
            return false
        }
        return true
    }
    c.close()
    return false
}

// How long a handler may run before the other connections of its worker
// move to another worker, in milliseconds.
let SLOW_MS: u64 = 20

// Takes the connections of each other worker whose handler has run for more
// than SLOW_MS, all but the one the handler runs for, and the connections
// waiting on its own listener (O3.9c).
fn rescue(me: *mut Worker, now: u64) {
    let s = me.s
    for k in 0..s.crew.len {
        let w = &mut s.crew[k]
        if w == me || w.state.load() != 1 {
            continue
        }
        let since = w.since.load()
        if now < since + SLOW_MS || !w.state.compareSwap(1, 2) {
            continue
        }
        var i = w.open.len()
        while i > 0 {
            i -= 1
            let o = w.open.items()[i]
            if w.current |c| {
                if c == o {
                    continue
                }
            }
            me.open.append(o) catch |e| {
                break
            }
            w.open.swapRemove(i)
            w.moved = true
        }
        w.state.store(1)
        if w.own {
            while s.stopped.load() == 0 {
                if acceptOn(w) |c| {
                    _ = adopt(me, c, now)
                } else {
                    break
                }
            }
        }
    }
}

// Fills `fds` with the listener, then one entry per connection of `open`:
// it waits for room to write when the connection has pending output, else
// for bytes to read.
fn pollSet(fds: *mut List(PollFd), listener: Listener, open: *List(*mut Open)) AllocError!void {
    fds.clear()
    try fds.append(PollFd { fd: listener.fd(), events: POLLIN, revents: 0 })
    for o in open.items() {
        var ev = POLLIN
        if o.pending.len > 0 {
            ev = POLLOUT
        }
        try fds.append(PollFd { fd: o.conn.fd(), events: ev, revents: 0 })
    }
}

// A worker of `Server.run`, with its own allocator for its lists (they are
// not shared). It wakes at least every 100 ms to see `stop`, the idle
// connections and the slow workers.
fn workerMain(w: *mut Worker) {
    let s = w.s
    var gpa = General.init()
    defer gpa.deinit()
    let alloc = gpa.allocator()
    w.open = List(*mut Open).init(alloc)
    defer w.open.deinit()
    var fds = List(PollFd).init(alloc)
    defer fds.deinit()
    var tick: i32 = 100
    if s.idleMs < 100 {
        tick = s.idleMs as i32
    }
    while s.stopped.load() == 0 {
        pollSet(&mut fds, w.listener, &w.open) catch |e| {
            break
        }
        let r = poll(fds.items().ptr, fds.len() as u64, tick)
        if os.stopRequested() {
            s.stopped.store(1)
        }
        let now = time.monotonicMs()
        // Backwards, so that `swapRemove` moves only entries already seen
        // and `fds.items()[i + 1]` stays the entry of `w.open.items()[i]`.
        var i = w.open.len()
        while i > 0 {
            i -= 1
            let o = w.open.items()[i]
            var keep = true
            if r > 0 && fds.items()[i + 1].revents != 0 {
                if o.pending.len > 0 {
                    keep = s.flushReady(w, o)
                } else {
                    keep = s.serveReady(w, o)
                }
                o.last = now
            } else if o.stream {
                keep = o.dead.load() == 0
            } else if now - o.last >= s.idleMs as u64 {
                keep = false
            }
            if w.moved {
                // Another worker took the rest during a slow handler: only
                // `o` is left, maybe at another index.
                w.moved = false
                if !keep {
                    for k, x in w.open.items() {
                        if x == o {
                            w.open.swapRemove(k)
                            break
                        }
                    }
                    closeOpen(s, o)
                }
                break
            }
            if !keep {
                closeOpen(s, o)
                w.open.swapRemove(i)
            }
        }
        if now - w.lastLook >= 10 {
            w.lastLook = now
            rescue(w, now)
        }
        if r > 0 && fds.items()[0].revents != 0 {
            if acceptOn(w) |c| {
                if s.stopped.load() != 0 {
                    c.close()
                    break
                }
                _ = adopt(w, c, now)
            }
        }
    }
    drain(s, &w.open, &mut fds)
    for o in w.open.items() {
        closeOpen(s, o)
    }
}

// After `stop`: writes the rest of the answered responses that the sockets
// have not taken yet (event streams aside), for at most `idleMs`, so that a
// client gets the whole response before its connection is closed.
fn drain(s: *mut Server, open: *List(*mut Open), fds: *mut List(PollFd)) {
    let end = time.monotonicMs() + s.idleMs as u64
    while time.monotonicMs() < end {
        fds.clear()
        for o in open.items() {
            if o.pending.len > 0 && !o.stream {
                fds.append(PollFd { fd: o.conn.fd(), events: POLLOUT, revents: 0 }) catch |e| {
                    return
                }
            }
        }
        if fds.len() == 0 {
            return
        }
        _ = poll(fds.items().ptr, fds.len() as u64, 100)
        for o in open.items() {
            if o.pending.len > 0 && !o.stream && !put(o, o.pending) {
                o.pending = []u8{}
            }
        }
    }
}

// The bytes of `res` in `a`, with a `Connection` header when `how` is not
// empty; with `head`, the body is left out (its length stays in
// `Content-Length`).
fn encode(a: Allocator, res: Response, how: []u8, head: bool) AllocError![]u8 {
    var out = Builder.init(a)
    var r = res
    if how.len > 0 {
        r = try withConnection(a, res, how)
    }
    try writeResponse(&mut out, r)
    var wire = out.bytes()
    if head {
        wire = wire[0..wire.len - r.body.len]
    }
    return wire
}

// Writes what the socket of `o` takes of `wire` (in `o`'s arena) and keeps
// the rest in `o.pending`; resets the arena once all of it is written.
// False on a write error: the connection is dropped.
fn put(o: *mut Open, wire: []u8) bool {
    let n = o.conn.writeSome(wire) catch |e| {
        return false
    }
    o.pending = wire[n..]
    if o.pending.len == 0 {
        o.arena.reset()
    }
    return true
}

let POLLIN: i16 = 1
let POLLOUT: i16 = 4

// True when the socket of `conn` can take bytes at once (`poll`, no wait).
fn writable(conn: Conn) bool {
    var fds = [1]PollFd{PollFd { fd: conn.fd(), events: POLLOUT, revents: 0 }}
    return poll(fds[..].ptr, 1, 0) > 0 && (fds[0].revents & POLLOUT) != 0
}

extern fn poll(fds: [*]PollFd, n: u64, timeout: i32) i32
extern fn sched_yield() i32

// The client: HTTP/1.1, one request per connection (`Connection: close`).
// `http://` runs over `std.net`. For `https://`, libcurl (linked only where
// installed) opens the connection in connect-only mode, which includes the
// TLS handshake, the certificate check and the host-name check; the bytes
// then move with `curl_easy_send` and `curl_easy_recv`. The request writer
// and the response parser are the same for both. Without libcurl, an
// `https://` URL is `HttpsUnsupported`. When the environment variable
// `AYE_HTTP_DEBUG` is set, a failed connect logs libcurl's text with
// `std.log.info`.

/// Why a client call gave no response. `InvalidUrl`, `UnsupportedScheme`
/// (not http or https) come from the URL; `HttpsUnsupported` is an
/// `https://` URL in a program built without libcurl;
/// `InvalidRequest` is a method or header that cannot be sent; the connect
/// tags are `UnknownHost`, `ConnectionRefused`, `ConnectFailed` and
/// `TimedOut`; `TlsFailed` is a TLS handshake or certificate failure (an
/// untrusted or expired certificate, a wrong host name, a bad `caFile`).
/// `ConnectionClosed` is a connection that failed or ended
/// before the response was complete; `BadResponse` is malformed input.
/// `HeadersTooLarge`, `BodyTooLarge` and `TooManyRedirects` are limits.
pub error ClientError {
    InvalidUrl,
    UnsupportedScheme,
    HttpsUnsupported,
    TlsFailed,
    InvalidRequest,
    UnknownHost,
    ConnectionRefused,
    ConnectFailed,
    TimedOut,
    ConnectionClosed,
    BadResponse,
    HeadersTooLarge,
    BodyTooLarge,
    TooManyRedirects,
    OutOfMemory,
}

/// Options of `requestWith`.
pub struct ClientOptions {
    /// How long one wait for data may take, in milliseconds (10000 to
    /// begin with). It is not a limit on the whole call.
    timeoutMs: u32 = 10000
    /// The longest response body, after any chunked decoding (16 MiB to
    /// begin with).
    maxBodyBytes: usize = 16777216
    /// Follow 301, 302, 303, 307 and 308 with a `Location` (at most 10
    /// times). Off to begin with: the redirect is returned as it is.
    followRedirects: bool = false
    /// A file of PEM certificates that `https://` trusts instead of the
    /// system's store (null to begin with: the system's store). The
    /// certificate and the host name are always checked.
    caFile: ?[]u8 = null
}

/// A URL split by `parseUrl`; the slices point into the string given.
pub struct Url {
    https: bool
    /// The host name or address, without the brackets of an IPv6 address.
    host: []u8
    /// The port written, else 80 (443 for https).
    port: u16
    /// `host[:port]` as written, for the `Host` header.
    authority: []u8
    /// The path and query as written, without any fragment. It is empty or
    /// starts with `?` when the URL has no path; the request line then
    /// gives `/`.
    target: []u8
}

// The most redirects a call follows.
let maxRedirects: u32 = 10

fn hasPrefixNoCase(s: []u8, prefix: []u8) bool {
    return s.len >= prefix.len && text.eqlIgnoreCase(s[..prefix.len], prefix)
}

/// Splits `http://host[:port][/path][?query]`; `[::1]` is an IPv6 host and
/// a `#fragment` is dropped. `https://` parses (default port 443) and is
/// refused later, by the request. Other schemes are `UnsupportedScheme`; a
/// missing scheme, an empty host, user info, a bad port or a space or
/// control character is `InvalidUrl`.
pub fn parseUrl(url: []u8) ClientError!Url {
    var https = false
    var rest: []u8 = []u8{}
    if hasPrefixNoCase(url, "http://") {
        rest = url[7..]
    } else if hasPrefixNoCase(url, "https://") {
        https = true
        rest = url[8..]
    } else if text.indexOf(url, "://") != null {
        return ClientError.UnsupportedScheme
    } else {
        return ClientError.InvalidUrl
    }
    for c in rest {
        if c <= 32 || c == 127 {
            return ClientError.InvalidUrl
        }
    }
    var end: usize = 0
    while end < rest.len && rest[end] != '/' && rest[end] != '?' && rest[end] != '#' {
        end += 1
    }
    let authority = rest[..end]
    var target = rest[end..]
    if mem.indexOf(target, '#') |h| {
        target = target[..h]
    }
    if mem.indexOf(authority, '@') != null {
        return ClientError.InvalidUrl
    }
    var host = authority
    var portText: []u8 = []u8{}
    var hasPort = false
    if authority.len > 0 && authority[0] == '[' {
        let close = mem.indexOf(authority, ']') orelse return ClientError.InvalidUrl
        host = authority[1..close]
        let after = authority[close + 1..]
        if after.len > 0 {
            if after[0] != ':' {
                return ClientError.InvalidUrl
            }
            portText = after[1..]
            hasPort = true
        }
    } else if mem.indexOf(authority, ':') |colon| {
        host = authority[..colon]
        portText = authority[colon + 1..]
        hasPort = true
    }
    if host.len == 0 {
        return ClientError.InvalidUrl
    }
    var port: u16 = 80
    if https {
        port = 443
    }
    if hasPort {
        if portText.len == 0 {
            return ClientError.InvalidUrl
        }
        var n: u32 = 0
        for c in portText {
            if c < '0' || c > '9' {
                return ClientError.InvalidUrl
            }
            n = n * 10 + (c - '0') as u32
            if n > 65535 {
                return ClientError.InvalidUrl
            }
        }
        if n == 0 {
            return ClientError.InvalidUrl
        }
        port = n as u16
    }
    return Url { https: https, host: host, port: port, authority: authority, target: target }
}

/// `requestWith` with the default `ClientOptions`: sends `method` to `url`
/// with the extra `headers` and the `body`, and returns the response. The
/// response (its headers and body) is allocated from `alloc`, which should
/// be an `Arena` that the caller frees as a whole. The request is HTTP/1.1
/// with `Host`, `Content-Length` (for a body, and for POST, PUT and PATCH)
/// and `Connection: close`; `headers` must not name Content-Length,
/// Transfer-Encoding or Connection, and a `Host` among them replaces the
/// automatic one. A status of 3xx or 4xx is a response, not an error.
pub fn request(alloc: Allocator, method: []u8, url: []u8, headers: []Header, body: []u8) ClientError!Response {
    return requestWith(alloc, ClientOptions {}, method, url, headers, body)
}

/// `request` with a GET and no body.
pub fn get(alloc: Allocator, url: []u8) ClientError!Response {
    return request(alloc, "GET", url, []Header{}, "")
}

/// `request` with a POST of `body`, sent with the `Content-Type`
/// `contentType`.
pub fn post(alloc: Allocator, url: []u8, contentType: []u8, body: []u8) ClientError!Response {
    let hs = alloc.alloc(Header { name: "Content-Type", value: contentType }, 1) catch return ClientError.OutOfMemory
    return request(alloc, "POST", url, hs, body)
}

/// `request` with `opts`. With `followRedirects`, a 301, 302 or 303 turns a
/// request other than GET or HEAD into a GET without a body, a 307 or 308
/// repeats it, and the extra `headers` go only to the same host and port.
/// Every response on the way stays allocated in `alloc`.
pub fn requestWith(alloc: Allocator, opts: ClientOptions, method: []u8, url: []u8, headers: []Header, body: []u8) ClientError!Response {
    var cur = url
    var m = method
    var hs = headers
    var b = body
    var hops: u32 = 0
    while true {
        let u = try parseUrl(cur)
        let r = try exchange(alloc, opts, u, m, hs, b)
        if !opts.followRedirects || !isRedirect(r.status) {
            return r
        }
        let loc = r.header("location") orelse return r
        if hops >= maxRedirects {
            return ClientError.TooManyRedirects
        }
        hops += 1
        if loc.len == 0 || text.startsWith(loc, "//") {
            return ClientError.BadResponse
        }
        let next = resolveLocation(alloc, u, loc) catch return ClientError.OutOfMemory
        let nu = try parseUrl(next)
        if nu.port != u.port || !text.eqlIgnoreCase(nu.host, u.host) {
            hs = []Header{}
        }
        if r.status != 307 && r.status != 308 && !text.eql(m, "GET") && !text.eql(m, "HEAD") {
            m = "GET"
            b = ""
        }
        cur = next
    }
    unreachable
}

fn isRedirect(status: u16) bool {
    return status == 301 || status == 302 || status == 303 || status == 307 || status == 308
}

// The absolute URL that `loc` names when it comes from a response to `u`:
// an absolute URL, an absolute path, or a path relative to `u`'s.
fn resolveLocation(alloc: Allocator, u: Url, loc: []u8) AllocError![]u8 {
    if hasPrefixNoCase(loc, "http://") || hasPrefixNoCase(loc, "https://") {
        return loc
    }
    var out = Builder.init(alloc)
    if u.https {
        try out.append("https://")
    } else {
        try out.append("http://")
    }
    try out.append(u.authority)
    if loc[0] == '/' {
        try out.append(loc)
        return out.bytes()
    }
    var path: []u8 = "/"
    if u.target.len > 0 && u.target[0] == '/' {
        path = u.target
        if mem.indexOf(path, '?') |q| {
            path = path[..q]
        }
    }
    if loc[0] != '?' {
        var dir = path.len
        while dir > 0 && path[dir - 1] != '/' {
            dir -= 1
        }
        path = path[..dir]
    }
    try out.append(path)
    try out.append(loc)
    return out.bytes()
}

// Checks the parts of a request that are written to the wire as they are.
fn checkRequest(method: []u8, headers: []Header) ClientError!void {
    if method.len == 0 {
        return ClientError.InvalidRequest
    }
    for c in method {
        if !isToken(c) {
            return ClientError.InvalidRequest
        }
    }
    for h in headers {
        if h.name.len == 0 {
            return ClientError.InvalidRequest
        }
        for c in h.name {
            if !isToken(c) {
                return ClientError.InvalidRequest
            }
        }
        for c in h.value {
            if c == '\r' || c == '\n' || c == 0 {
                return ClientError.InvalidRequest
            }
        }
        if text.eqlIgnoreCase(h.name, "content-length") || text.eqlIgnoreCase(h.name, "transfer-encoding") || text.eqlIgnoreCase(h.name, "connection") {
            return ClientError.InvalidRequest
        }
    }
}

// Appends the request head and body to `out`.
fn writeRequest(out: *mut Builder, u: Url, method: []u8, headers: []Header, body: []u8) AllocError!void {
    try out.append(method)
    try out.append(" ")
    if u.target.len == 0 || u.target[0] != '/' {
        try out.append("/")
    }
    try out.append(u.target)
    try out.append(" HTTP/1.1\r\nHost: ")
    try out.append(findHeader(headers, "host") orelse u.authority)
    try out.append("\r\n")
    for h in headers {
        if !text.eqlIgnoreCase(h.name, "host") {
            try out.append(h.name)
            try out.append(": ")
            try out.append(h.value)
            try out.append("\r\n")
        }
    }
    if body.len > 0 || text.eql(method, "POST") || text.eql(method, "PUT") || text.eql(method, "PATCH") {
        try out.append("Content-Length: ")
        try out.appendUint(body.len as u64)
        try out.append("\r\n")
    }
    try out.append("Connection: close\r\n\r\n")
    try out.append(body)
}

// An open connection of the client: a TCP `Conn` (http) or a libcurl
// handle in connect-only mode (https). Exactly one is set.
struct Stream {
    conn: ?Conn
    curl: ?*mut Curl

    // Waits at most `ms` for data: the number of bytes read, 0 when the
    // peer has closed.
    fn read(self: Self, buf: []mut u8, ms: u32) ClientError!usize {
        if self.curl |h| {
            if @hasLink("libcurl") {
                return tlsRead(h, buf, ms)
            } else {
                return ClientError.HttpsUnsupported
            }
        }
        let c = self.conn orelse return ClientError.ConnectionClosed
        return c.readTimeout(buf, ms) catch |e| {
            return match e {
                .TimedOut => ClientError.TimedOut
                .ConnectionReset => ClientError.ConnectionClosed
                .WouldBlock => ClientError.TimedOut
                .ReadFailed => ClientError.ConnectionClosed
            }
        }
    }

    // Writes all of `bytes`; one wait for the socket takes at most `ms`.
    fn write(self: Self, bytes: []u8, ms: u32) ClientError!void {
        if self.curl |h| {
            if @hasLink("libcurl") {
                return tlsWrite(h, bytes, ms)
            } else {
                return ClientError.HttpsUnsupported
            }
        }
        let c = self.conn orelse return ClientError.ConnectionClosed
        c.write(bytes) catch return ClientError.ConnectionClosed
    }

    fn close(self: Self) {
        if self.curl |h| {
            if @hasLink("libcurl") {
                curl_easy_cleanup(h)
            }
        }
        if self.conn |c| {
            c.close()
        }
    }
}

// Opens the connection of `u`: where the transport is chosen.
fn openStream(alloc: Allocator, opts: ClientOptions, u: Url) ClientError!Stream {
    if u.https {
        if @hasLink("libcurl") {
            let h = try tlsConnect(alloc, opts, u)
            return Stream { conn: null, curl: h }
        } else {
            return ClientError.HttpsUnsupported
        }
    }
    let conn = net.connect(u.host, u.port) catch |e| {
        return match e {
            .InvalidAddress => ClientError.InvalidUrl
            .UnknownHost => ClientError.UnknownHost
            .ConnectionRefused => ClientError.ConnectionRefused
            .Unreachable => ClientError.ConnectFailed
            .TimedOut => ClientError.TimedOut
            .ConnectFailed => ClientError.ConnectFailed
        }
    }
    return Stream { conn: conn, curl: null }
}

// One request on its own connection.
fn exchange(alloc: Allocator, opts: ClientOptions, u: Url, method: []u8, headers: []Header, body: []u8) ClientError!Response {
    try checkRequest(method, headers)
    var out = Builder.init(alloc)
    defer out.deinit()
    writeRequest(&mut out, u, method, headers, body) catch return ClientError.OutOfMemory
    let conn = try openStream(alloc, opts, u)
    defer conn.close()
    try conn.write(out.bytes(), opts.timeoutMs)
    return readResponse(alloc, opts, conn, method)
}

// Waits for data: the number of bytes read, 0 when the peer has closed.
fn readSome(conn: Stream, buf: []mut u8, ms: u32) ClientError!usize {
    return conn.read(buf, ms)
}

// The status and headers of the response head `head` (the status line and
// the header lines, each with its CRLF): a Response without a body, all in
// `alloc`.
fn parseHead(alloc: Allocator, head: []u8) ClientError!Response {
    let hb = alloc.alloc(0 as u8, head.len) catch return ClientError.OutOfMemory
    mem.copy(hb, head)
    let lineEnd = crlf(hb, 0) orelse return ClientError.BadResponse
    let line = hb[..lineEnd]
    if line.len < 12 || !text.startsWith(line, "HTTP/1.") || (line[7] != '0' && line[7] != '1') || line[8] != ' ' {
        return ClientError.BadResponse
    }
    var status: u16 = 0
    for i in 9..12 {
        if line[i] < '0' || line[i] > '9' {
            return ClientError.BadResponse
        }
        status = status * 10 + (line[i] - '0') as u16
    }
    if line.len > 12 && line[12] != ' ' {
        return ClientError.BadResponse
    }
    var list = List(Header).init(alloc)
    defer list.deinit()
    var pos = lineEnd + 2
    while pos < hb.len {
        let end = crlf(hb, pos) orelse return ClientError.BadResponse
        let h = parseHeader(hb[pos..end]) orelse return ClientError.BadResponse
        list.append(h) catch return ClientError.OutOfMemory
        pos = end + 2
    }
    var hs = []Header{}
    if list.len() > 0 {
        let owned = alloc.alloc(Header { name: "", value: "" }, list.len()) catch return ClientError.OutOfMemory
        for i in 0..list.len() {
            owned[i] = list.items()[i]
        }
        hs = owned
    }
    return Response { status: status, headers: hs, body: []u8{} }
}

// Reads the response to a request with `method` from `conn`: the head, then
// the body by Transfer-Encoding: chunked, Content-Length, or until the peer
// closes. An interim 1xx response is skipped.
fn readResponse(alloc: Allocator, opts: ClientOptions, conn: Stream, method: []u8) ClientError!Response {
    let limits = Limits { maxRequestLine: 8192, maxHeaders: 16384, maxBody: opts.maxBodyBytes }
    var wire = Builder.init(alloc)
    defer wire.deinit()
    var chunk = @zeroed([4096]u8)
    var off: usize = 0
    var res = Response { status: 0, headers: []Header{}, body: []u8{} }
    var bodyStart: usize = 0
    while true {
        if text.indexOf(wire.bytes()[off..], "\r\n\r\n") |i| {
            if i + 4 > limits.maxHeaders {
                return ClientError.HeadersTooLarge
            }
            res = try parseHead(alloc, wire.bytes()[off..off + i + 2])
            bodyStart = off + i + 4
            if res.status >= 100 && res.status < 200 && res.status != 101 {
                off = bodyStart
                continue
            }
            break
        }
        if wire.len() - off > limits.maxHeaders {
            return ClientError.HeadersTooLarge
        }
        let n = try readSome(conn, chunk[..], opts.timeoutMs)
        if n == 0 {
            return ClientError.ConnectionClosed
        }
        wire.append(chunk[0..n]) catch return ClientError.OutOfMemory
    }
    if text.eql(method, "HEAD") || res.status == 204 || res.status == 304 {
        return res
    }
    if findHeader(res.headers, "transfer-encoding") |te| {
        if !text.eqlIgnoreCase(text.trim(te), "chunked") {
            return ClientError.BadResponse
        }
        var chunks = Builder.init(alloc)
        errdefer chunks.deinit()
        while true {
            chunks.clear()
            if readChunked(wire.bytes(), bodyStart, limits, &mut chunks) |end| {
                break
            } else |e| {
                if e != ParseError.Incomplete {
                    return match e {
                        .BodyTooLarge => ClientError.BodyTooLarge
                        .HeadersTooLarge => ClientError.HeadersTooLarge
                        .OutOfMemory => ClientError.OutOfMemory
                        _ => ClientError.BadResponse
                    }
                }
            }
            let n = try readSome(conn, chunk[..], opts.timeoutMs)
            if n == 0 {
                return ClientError.ConnectionClosed
            }
            wire.append(chunk[0..n]) catch return ClientError.OutOfMemory
        }
        res.body = chunks.toOwned() catch return ClientError.OutOfMemory
        return res
    }
    if findHeader(res.headers, "content-length") |cl| {
        for h in res.headers {
            if text.eqlIgnoreCase(h.name, "content-length") && !text.eql(h.value, cl) {
                return ClientError.BadResponse
            }
        }
        let n = contentLength(cl, limits.maxBody) catch |e| {
            return match e {
                .BodyTooLarge => ClientError.BodyTooLarge
                _ => ClientError.BadResponse
            }
        }
        if n == 0 {
            return res
        }
        let buf = alloc.alloc(0 as u8, n) catch return ClientError.OutOfMemory
        var got = wire.len() - bodyStart
        if got > n {
            got = n
        }
        mem.copy(buf, wire.bytes()[bodyStart..bodyStart + got])
        while got < n {
            let r = try readSome(conn, buf[got..], opts.timeoutMs)
            if r == 0 {
                return ClientError.ConnectionClosed
            }
            got += r
        }
        res.body = buf
        return res
    }
    var rest = Builder.init(alloc)
    errdefer rest.deinit()
    rest.append(wire.bytes()[bodyStart..]) catch return ClientError.OutOfMemory
    while true {
        if rest.len() > limits.maxBody {
            return ClientError.BodyTooLarge
        }
        let n = try readSome(conn, chunk[..], opts.timeoutMs)
        if n == 0 {
            break
        }
        rest.append(chunk[0..n]) catch return ClientError.OutOfMemory
    }
    res.body = rest.toOwned() catch return ClientError.OutOfMemory
    return res
}

// TLS through libcurl: the easy interface in connect-only mode, hand-declared
// like `browser/net/http.aye` in aye-lang/anyknown. Only called where `@hasLink("libcurl")`.

extern struct Curl {}

extern fn curl_easy_init() ?*mut Curl
extern fn curl_easy_setopt(h: *mut Curl, option: i32, ...) i32
extern fn curl_easy_perform(h: *mut Curl) i32
extern fn curl_easy_send(h: *mut Curl, buf: [*]u8, n: usize, sent: *mut usize) i32
extern fn curl_easy_recv(h: *mut Curl, buf: [*]u8, n: usize, got: *mut usize) i32
extern fn curl_easy_cleanup(h: *mut Curl)
extern fn curl_easy_strerror(code: i32) [*]u8
extern fn strlen(s: [*]u8) usize

let CURLOPT_URL: i32 = 10002
let CURLOPT_ERRORBUFFER: i32 = 10010
let CURLOPT_CAINFO: i32 = 10065
let CURLOPT_NOSIGNAL: i32 = 99
let CURLOPT_CONNECT_ONLY: i32 = 141
let CURLOPT_CONNECTTIMEOUT_MS: i32 = 156
let CURLOPT_HTTP_VERSION: i32 = 84
// CURL_HTTP_VERSION_1_1: no ALPN offer of h2.
let CURL_HTTP_VERSION_1_1: i64 = 2
let CURLE_AGAIN: i32 = 81

// The error tag of a failed connect (`curl_easy_perform` result `code`).
fn tlsConnectError(code: i32) ClientError {
    return match code {
        3 => ClientError.InvalidUrl
        6 => ClientError.UnknownHost
        27 => ClientError.OutOfMemory
        28 => ClientError.TimedOut
        35, 51, 53, 54, 58, 59, 60, 64, 66, 77, 80, 82, 83, 90, 91, 98 => ClientError.TlsFailed
        _ => ClientError.ConnectFailed
    }
}

// Appends `s` and a NUL byte.
fn cString(b: *mut Builder, s: []u8) AllocError!void {
    try b.append(s)
    try b.appendByte(0)
}

// Connects to `u` (an https URL) and finishes the TLS handshake. The
// certificate and host name are checked by libcurl's defaults
// (CURLOPT_SSL_VERIFYPEER and CURLOPT_SSL_VERIFYHOST stay on).
fn tlsConnect(alloc: Allocator, opts: ClientOptions, u: Url) ClientError!*mut Curl {
    let h = curl_easy_init() orelse return ClientError.ConnectFailed
    errdefer curl_easy_cleanup(h)
    var target = Builder.init(alloc)
    defer target.deinit()
    target.append("https://") catch return ClientError.OutOfMemory
    target.append(u.authority) catch return ClientError.OutOfMemory
    cString(&mut target, "/") catch return ClientError.OutOfMemory
    var err = @zeroed([256]u8)
    curl_easy_setopt(h, CURLOPT_URL, target.bytes().ptr)
    curl_easy_setopt(h, CURLOPT_CONNECT_ONLY, 1 as i64)
    curl_easy_setopt(h, CURLOPT_HTTP_VERSION, CURL_HTTP_VERSION_1_1)
    curl_easy_setopt(h, CURLOPT_CONNECTTIMEOUT_MS, opts.timeoutMs as i64)
    curl_easy_setopt(h, CURLOPT_NOSIGNAL, 1 as i64)
    curl_easy_setopt(h, CURLOPT_ERRORBUFFER, err[..].ptr)
    var ca = Builder.init(alloc)
    defer ca.deinit()
    if opts.caFile |path| {
        cString(&mut ca, path) catch return ClientError.OutOfMemory
        curl_easy_setopt(h, CURLOPT_CAINFO, ca.bytes().ptr)
    }
    let code = curl_easy_perform(h)
    // `err` ends with this call: libcurl must not keep the pointer.
    curl_easy_setopt(h, CURLOPT_ERRORBUFFER, 0 as i64)
    if code != 0 {
        if os.getenv("AYE_HTTP_DEBUG") |_| {
            var detail = err[0..strlen(err[..].ptr)]
            if detail.len == 0 {
                let t = curl_easy_strerror(code)
                detail = t[0..strlen(t)]
            }
            std.log.info("std.http: https connect to {} failed (libcurl {}): {}", u.authority, code, detail)
        }
        return tlsConnectError(code)
    }
    return h
}

// libcurl has no blocking mode here: `curl_easy_recv` and `curl_easy_send`
// give CURLE_AGAIN when the socket is not ready. This sleeps a little
// (1 ms, doubling to 20 ms) and says TimedOut once `ms` have passed since
// `start` (`time.monotonicMs`).
fn pause(start: u64, ms: u32, step: *mut u64) ClientError!void {
    if time.monotonicMs() - start >= ms as u64 {
        return ClientError.TimedOut
    }
    time.sleep(step.*)
    if step.* < 20 {
        step.* = step.* * 2
    }
}

fn tlsRead(h: *mut Curl, buf: []mut u8, ms: u32) ClientError!usize {
    let start = time.monotonicMs()
    var step: u64 = 1
    while true {
        var got: usize = 0
        let code = curl_easy_recv(h, buf.ptr, buf.len, &mut got)
        if code == 0 {
            return got
        }
        if code != CURLE_AGAIN {
            return ClientError.ConnectionClosed
        }
        try pause(start, ms, &mut step)
    }
    unreachable
}

fn tlsWrite(h: *mut Curl, bytes: []u8, ms: u32) ClientError!void {
    var off: usize = 0
    var start = time.monotonicMs()
    var step: u64 = 1
    while off < bytes.len {
        var sent: usize = 0
        let code = curl_easy_send(h, bytes[off..].ptr, bytes.len - off, &mut sent)
        if code == 0 {
            off += sent
            start = time.monotonicMs()
            step = 1
        } else if code == CURLE_AGAIN {
            try pause(start, ms, &mut step)
        } else {
            return ClientError.ConnectionClosed
        }
    }
}
