// std.fs: files, and the standard input, output and error streams.

import std.mem.Allocator
import std.mem.AllocError

pub error OpenError { NotFound, AccessDenied, OpenFailed }
pub error ReadError { ReadFailed, OutOfMemory }
pub error WriteError { WriteFailed }
pub error ReadFileError = OpenError || ReadError
pub error PathError { NotFound, AccessDenied, NotADirectory, Exists, NotEmpty, PathFailed }
pub error ReadDirError = PathError || AllocError
pub error ReadLinkError = PathError || AllocError

/// What a path names: a regular file, a directory, a symbolic link, or
/// anything else (a device, a socket, a pipe; also an entry that the file
/// system does not describe).
pub enum Kind { File, Dir, Symlink, Other }

/// What `stat` knows about a path: the size in bytes, the modification time
/// in nanoseconds since 1970-01-01 UTC, and the kind.
pub struct Stat {
    size: u64
    mtime: i64
    kind: Kind
}

/// An entry of a directory: its name (without the directory) and kind.
pub struct DirEntry {
    name: []u8
    kind: Kind
}

/// The entries of a directory, from `readDir`. The names are valid until
/// `deinit`.
pub struct DirEntries {
    items: []mut DirEntry
    store: []mut DirEntry
    names: []mut u8
    alloc: Allocator

    /// Free the entries and their names.
    pub fn deinit(self: Self) {
        self.alloc.free(self.store)
        self.alloc.free(self.names)
    }
}

/// An open file: a file descriptor.
pub struct File {
    fd: i32

    /// Read the rest of the file into new memory from `alloc` (free it with
    /// `alloc.free`). An empty file gives the empty slice.
    pub fn readAll(self: Self, alloc: Allocator) ReadError![]mut u8 {
        var cap: usize = 4096
        var buf = try alloc.alloc(0 as u8, cap)
        var len: usize = 0
        while true {
            if len == cap {
                let bigger = alloc.alloc(0 as u8, cap * 2) catch |e| {
                    alloc.free(buf)
                    return e
                }
                memcpy(bigger.ptr, buf.ptr, len)
                alloc.free(buf)
                buf = bigger
                cap = cap * 2
            }
            let n = read(self.fd, buf[len..].ptr, cap - len)
            if n < 0 {
                alloc.free(buf)
                return ReadError.ReadFailed
            }
            if n == 0 {
                break
            }
            len += n as usize
        }
        if len == 0 {
            alloc.free(buf)
            return []mut u8{}
        }
        // The exact size, so that `alloc.free` of the result frees what was
        // allocated.
        let exact = alloc.resize(buf, len, 0) catch |e| {
            alloc.free(buf)
            return e
        }
        return exact
    }

    /// Write all of `bytes`. Output of `@print` is flushed first, so the
    /// two stay in order.
    pub fn write(self: Self, bytes: []u8) WriteError!void {
        fflush([]u8{}.ptr)
        var done: usize = 0
        while done < bytes.len {
            let n = write(self.fd, bytes[done..].ptr, bytes.len - done)
            if n <= 0 {
                return WriteError.WriteFailed
            }
            done += n as usize
        }
    }

    /// Read at most `buf.len` bytes into `buf`: the number read, 0 at the
    /// end of the file. Waits for input on a terminal or a pipe.
    pub fn read(self: Self, buf: []mut u8) ReadError!usize {
        let n = read(self.fd, buf.ptr, buf.len)
        if n < 0 {
            return ReadError.ReadFailed
        }
        return n as usize
    }

    /// A buffered reader of this file, for `readLine`; its buffer comes
    /// from `alloc` (call `deinit`).
    pub fn reader(self: Self, alloc: Allocator) Reader {
        return Reader { file: self, alloc: alloc }
    }

    /// Closes the file.
    pub fn close(self: Self) {
        _ = close(self.fd)
    }
}

/// Reads a file line by line through a buffer that grows to the longest
/// line: `var r = std.fs.stdin().reader(alloc)`, then
/// `while try r.readLine() |line| { ... }`.
pub struct Reader {
    file: File
    alloc: Allocator
    buf: []mut u8 = []mut u8{}
    start: usize = 0
    end: usize = 0
    eof: bool = false

    /// The next line, without its `\n` (or `\r\n`); null at the end of the
    /// file (a last line without `\n` is a line too). It reads only as much
    /// as it needs, so it answers each line of an interactive input as it
    /// comes. The slice is valid until the next `readLine`.
    pub fn readLine(self: *mut Self) ReadError!?[]u8 {
        var scan = self.start
        while true {
            var i = scan
            while i < self.end {
                if self.buf[i] == '\n' {
                    var stop = i
                    if stop > self.start && self.buf[stop - 1] == '\r' {
                        stop -= 1
                    }
                    let line = self.buf[self.start..stop]
                    self.start = i + 1
                    return line
                }
                i += 1
            }
            if self.eof {
                if self.start == self.end {
                    return null
                }
                let last = self.buf[self.start..self.end]
                self.start = self.end
                return last
            }
            // Keep the pending bytes at the start, and grow when full.
            if self.start > 0 {
                let pending = self.end - self.start
                if pending > 0 {
                    _ = memmove(self.buf.ptr, self.buf[self.start..].ptr, pending)
                }
                scan = pending
                self.end = pending
                self.start = 0
            } else {
                scan = self.end
            }
            if self.end == self.buf.len {
                var cap: usize = 4096
                if self.buf.len > 0 {
                    cap = self.buf.len * 2
                }
                self.buf = try self.alloc.resize(self.buf, cap, 0)
            }
            let n = read(self.file.fd, self.buf[self.end..].ptr, self.buf.len - self.end)
            if n < 0 {
                return ReadError.ReadFailed
            }
            if n == 0 {
                self.eof = true
            } else {
                self.end += n as usize
            }
        }
        unreachable
    }

    /// Free the buffer.
    pub fn deinit(self: *mut Self) {
        self.alloc.free(self.buf)
        self.buf = []mut u8{}
        self.start = 0
        self.end = 0
    }
}

/// Open the file at `path` for reading.
pub fn open(path: []u8) OpenError!File {
    return openResult(aye_std_open(path.ptr, path.len))
}

// A descriptor, or -errno, as a `File` or an error.
fn openResult(fd: i32) OpenError!File {
    if fd == -2 {
        return OpenError.NotFound
    }
    if fd == -13 {
        return OpenError.AccessDenied
    }
    if fd < 0 {
        return OpenError.OpenFailed
    }
    return File { fd: fd }
}

/// Create the file at `path` for writing, or empty it if it exists.
pub fn create(path: []u8) OpenError!File {
    return openResult(aye_std_create(path.ptr, path.len))
}

/// Is there a file or directory at `path`?
pub fn exists(path: []u8) bool {
    return aye_std_exists(path.ptr, path.len)
}

/// The modification time of the file or directory at `path`, in
/// nanoseconds since 1970-01-01 UTC; null if it cannot be read.
pub fn mtime(path: []u8) ?i64 {
    let s = statPath(path, true) catch |_| {
        return null
    }
    return s.mtime
}

/// Size, modification time and kind of the file at `path`. This `stat` does
/// not follow a symbolic link: its own kind is `Symlink`, and its size is
/// the length of its target. `statFollow` follows links.
pub fn stat(path: []u8) PathError!Stat {
    return statPath(path, false)
}

/// Like `stat`, but follows symbolic links: the result describes what the
/// link leads to, never a `Symlink`. A link to nothing is `NotFound`.
pub fn statFollow(path: []u8) PathError!Stat {
    return statPath(path, true)
}

/// The entries of the directory at `path`, in no particular order, without
/// `.` and `..`. Free the result with `deinit`. A symbolic link is a
/// `Symlink`. Where the file system does not give an entry's kind, it is
/// found as `stat` finds it; it is `Other` only for a socket, pipe or
/// device, or if that fails.
pub fn readDir(alloc: Allocator, path: []u8) ReadDirError!DirEntries {
    var err: i32 = 0
    let dir = aye_std_opendir(path.ptr, path.len, &mut err) orelse return pathError(err)
    defer aye_std_closedir(dir)
    // Two passes: count the entries and the bytes of their names, then
    // fill. If the directory changes in between, the second pass stops at
    // the room it has.
    var count: usize = 0
    var bytes: usize = 0
    var kind: i32 = 0
    while aye_std_readdir(dir, &mut kind) |name| {
        let n = strlen(name)
        if !isDots(name[0..n]) {
            count += 1
            bytes += n
        }
    }
    if count == 0 {
        return DirEntries {
            items: []mut DirEntry{},
            store: []mut DirEntry{},
            names: []mut u8{},
            alloc: alloc,
        }
    }
    aye_std_rewinddir(dir)
    let names = try alloc.alloc(0 as u8, bytes)
    let store = alloc.alloc(DirEntry { name: []u8{}, kind: Kind.Other }, count) catch |e| {
        alloc.free(names)
        return e
    }
    var used: usize = 0
    var n: usize = 0
    while aye_std_readdir(dir, &mut kind) |name| {
        let len = strlen(name)
        if isDots(name[0..len]) {
            continue
        }
        if n == count || used + len > bytes {
            break
        }
        memcpy(names[used..].ptr, name, len)
        let entry = names[used..used + len]
        var k = kindOfType(kind)
        if kind == 0 {
            k = kindOfEntry(alloc, path, entry)
        }
        store[n] = DirEntry { name: entry, kind: k }
        used += len
        n += 1
    }
    return DirEntries { items: store[0..n], store: store, names: names, alloc: alloc }
}

/// Create the directory at `path`; its parent must exist.
pub fn mkdir(path: []u8) PathError!void {
    try pathResult(aye_std_pathop(0, path.ptr, path.len, path.ptr, 0))
}

/// Delete the file, symbolic link or empty directory at `path`.
pub fn remove(path: []u8) PathError!void {
    try pathResult(aye_std_pathop(1, path.ptr, path.len, path.ptr, 0))
}

/// Rename or move `from` to `to`; an existing `to` is replaced (a file by
/// a file, an empty directory by a directory).
pub fn rename(from: []u8, to: []u8) PathError!void {
    try pathResult(aye_std_pathop(2, from.ptr, from.len, to.ptr, to.len))
}

/// Create a symbolic link at `link` that holds `target` (as given; it is
/// not looked at). An existing `link` is `Exists`; a path of 4096 bytes or
/// more is `PathFailed`.
pub fn symlink(target: []u8, link: []u8) PathError!void {
    if target.len >= 4096 || link.len >= 4096 {
        return PathError.PathFailed
    }
    // NUL-terminated copies.
    var t = @zeroed([4096]u8)
    var l = @zeroed([4096]u8)
    memcpy(t[0..].ptr, target.ptr, target.len)
    memcpy(l[0..].ptr, link.ptr, link.len)
    var code: i32 = 0
    if cSymlink(t[0..].ptr, l[0..].ptr) != 0 {
        code = aye_std_fail()
    }
    try pathResult(code)
}

/// The target a symbolic link holds, as stored (not resolved), in new
/// memory from `alloc` (free it with `alloc.free`). A path that is not a
/// link is `PathFailed`; a target of 4096 bytes or more is `PathFailed`.
pub fn readLink(alloc: Allocator, path: []u8) ReadLinkError![]mut u8 {
    if path.len >= 4096 {
        return PathError.PathFailed
    }
    var p = @zeroed([4096]u8)
    memcpy(p[0..].ptr, path.ptr, path.len)
    var buf = @zeroed([4096]u8)
    let n = cReadlink(p[0..].ptr, buf[0..].ptr, 4096)
    if n < 0 {
        return pathError(aye_std_fail())
    }
    if n >= 4096 {
        return PathError.PathFailed
    }
    let len = n as usize
    let out = try alloc.alloc(0 as u8, len)
    memcpy(out.ptr, buf[0..].ptr, len)
    return out
}

// 0, or -errno (ENOTEMPTY as -39), as nothing or an error.
fn pathResult(code: i32) PathError!void {
    if code != 0 {
        return pathError(code)
    }
}

fn pathError(code: i32) PathError {
    if code == -2 {
        return PathError.NotFound
    }
    if code == -13 {
        return PathError.AccessDenied
    }
    if code == -17 {
        return PathError.Exists
    }
    if code == -20 {
        return PathError.NotADirectory
    }
    if code == -39 {
        return PathError.NotEmpty
    }
    return PathError.PathFailed
}

// `lstat` (`stat` if `follow`) of `path`. Linux asks `statx`, whose layout
// is the same on x86_64 and aarch64; macOS (`struct stat64`) and wasi-libc
// keep the fields at their own offsets. `st` is read as little-endian
// 8-byte words (every target is little-endian); a path of 4096 bytes or
// more is `PathFailed`.
fn statPath(path: []u8, follow: bool) PathError!Stat {
    if path.len >= 4096 {
        return PathError.PathFailed
    }
    var p = @zeroed([4096]u8)
    memcpy(p[0..].ptr, path.ptr, path.len)
    var st = @zeroed([32]i64)
    var r: i32 = 0
    if @targetOs() is .linux {
        // AT_FDCWD; AT_SYMLINK_NOFOLLOW unless `follow`; STATX_BASIC_STATS.
        var flags: i32 = 0x100
        if follow {
            flags = 0
        }
        if statx(-100, p[0..].ptr, flags, 0x7ff, &mut st[0]) != 0 {
            r = aye_std_fail()
        }
    } else {
        r = aye_std_statbuf(p[0..].ptr, follow, &mut st[0])
    }
    try pathResult(r)
    var size: i64 = 0
    var sec: i64 = 0
    var nsec: i64 = 0
    var mode: i64 = 0
    if @targetOs() is .linux {
        // stx_mode (16 bits) at byte 28, stx_size at 40, stx_mtime at 112.
        mode = st[3] >> 32
        size = st[5]
        sec = st[14]
        nsec = st[15] & 0xffffffff
    } else if @targetOs() is .macos {
        // st_mode (16 bits) at byte 4, st_mtimespec at 48, st_size at 96.
        mode = st[0] >> 32
        sec = st[6]
        nsec = st[7]
        size = st[12]
    } else {
        // wasi-libc: st_mode at byte 24, st_size at 48, st_mtim at 88 (its
        // tv_nsec is a 32-bit long; the padding is not zeroed).
        mode = st[3]
        size = st[6]
        sec = st[11]
        nsec = st[12] & 0xffffffff
    }
    return Stat { size: size as u64, mtime: sec * 1000000000 + nsec, kind: kindOfMode(mode & 0xf000) }
}

// The S_IFMT bits of a mode: S_IFREG, S_IFDIR, S_IFLNK.
fn kindOfMode(mode: i64) Kind {
    if mode == 0x8000 {
        return Kind.File
    }
    if mode == 0x4000 {
        return Kind.Dir
    }
    if mode == 0xa000 {
        return Kind.Symlink
    }
    return Kind.Other
}

// A `d_type`: DT_REG, DT_DIR, DT_LNK.
fn kindOfType(t: i32) Kind {
    if t == 8 {
        return Kind.File
    }
    if t == 4 {
        return Kind.Dir
    }
    if t == 10 {
        return Kind.Symlink
    }
    return Kind.Other
}

// The kind of `dir/name` by `lstat`, for an entry whose `d_type` is
// DT_UNKNOWN; `Other` if that fails.
fn kindOfEntry(alloc: Allocator, dir: []u8, name: []u8) Kind {
    let buf = alloc.alloc(0 as u8, dir.len + 1 + name.len) catch |_| {
        return Kind.Other
    }
    defer alloc.free(buf)
    memcpy(buf.ptr, dir.ptr, dir.len)
    buf[dir.len] = '/'
    memcpy(buf[dir.len + 1..].ptr, name.ptr, name.len)
    let s = statPath(buf, false) catch |_| {
        return Kind.Other
    }
    return s.kind
}

fn isDots(name: []u8) bool {
    return name.len == 1 && name[0] == '.' || name.len == 2 && name[0] == '.' && name[1] == '.'
}

/// Read the whole file at `path` into new memory from `alloc` (free it
/// with `alloc.free`).
pub fn readFile(alloc: Allocator, path: []u8) ReadFileError![]mut u8 {
    let f = try open(path)
    defer f.close()
    return f.readAll(alloc)
}

/// Standard input (file descriptor 0).
pub fn stdin() File {
    return File { fd: 0 }
}

/// Standard output (file descriptor 1).
pub fn stdout() File {
    return File { fd: 1 }
}

/// Standard error (file descriptor 2).
pub fn stderr() File {
    return File { fd: 2 }
}

extern fn aye_std_open(path: [*]u8, len: usize) i32
extern fn aye_std_create(path: [*]u8, len: usize) i32
extern fn aye_std_exists(path: [*]u8, len: usize) bool
extern fn aye_std_statbuf(path: [*]u8, follow: bool, st: *mut i64) i32
extern fn statx(dirfd: i32, path: [*]u8, flags: i32, mask: u32, st: *mut i64) i32
extern fn aye_std_pathop(op: i32, path: [*]u8, len: usize, to: [*]u8, tolen: usize) i32
extern fn aye_std_opendir(path: [*]u8, len: usize, err: *mut i32) ?[*]u8
extern fn aye_std_readdir(dir: [*]u8, kind: *mut i32) ?[*]u8
extern fn aye_std_closedir(dir: [*]u8)
extern fn aye_std_rewinddir(dir: [*]u8)
extern fn aye_std_fail() i32
extern("symlink") fn cSymlink(target: [*]u8, link: [*]u8) i32
extern("readlink") fn cReadlink(path: [*]u8, buf: [*]u8, n: usize) isize
extern fn strlen(s: [*]u8) usize
extern fn read(fd: i32, buf: [*]u8, n: usize) isize
extern fn write(fd: i32, buf: [*]u8, n: usize) isize
extern fn close(fd: i32) i32
extern fn memcpy(dst: [*]u8, src: [*]u8, n: usize) [*]u8
extern fn memmove(dst: [*]u8, src: [*]u8, n: usize) [*]u8
extern fn fflush(stream: [*]u8) i32
