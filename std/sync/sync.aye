// std.sync: sharing data between threads.

import std.mem.AllocError
import std.mem.Allocator

/// A lock: one thread at a time holds it. Share it by pointer: copies made
/// after the first `lock` are the same lock, a copy made before is another.
/// `deinit` it once, when no thread uses it.
pub struct Mutex {
    // Made by the first `lock` (a compare-and-swap in the runtime), so that
    // `init` is a constant and a global can start as `Mutex.init()`.
    handle: ?[*]u8

    /// A new lock; a constant, so a global `var` can hold it.
    pub fn init() Mutex {
        return Mutex { handle: null }
    }

    /// Waits until no other thread holds the lock, and takes it.
    pub fn lock(self: *Self) {
        aye_mutex_lock(&self.handle)
    }

    /// Releases the lock.
    pub fn unlock(self: *Self) {
        aye_mutex_unlock(&self.handle)
    }

    /// Frees the lock, once, when no thread uses it.
    pub fn deinit(self: *Self) {
        aye_mutex_free(&self.handle)
    }
}

/// A condition variable: threads wait on it, with a `Mutex` held, until
/// another thread signals it.
struct Cond {
    handle: [*]u8

    fn init() Cond {
        return Cond { handle: aye_cond_new() }
    }

    fn wait(self: *Self, m: *Mutex) {
        aye_cond_wait(self.handle, &m.handle)
    }

    fn signal(self: *Self) {
        aye_cond_signal(self.handle)
    }

    fn broadcast(self: *Self) {
        aye_cond_broadcast(self.handle)
    }

    fn deinit(self: *Self) {
        aye_cond_free(self.handle)
    }
}

/// The error of `Channel.send`: the channel is closed.
pub error ChannelError {
    Closed
}

/// A queue of at most `capacity` values that threads send to and receive
/// from, in order. Share it as a `*mut Channel(T)`.
pub fn Channel(comptime T: type) type {
    return struct {
        mutex: Mutex
        notEmpty: Cond
        notFull: Cond
        slots: []mut ?T
        head: usize
        count: usize
        closed: bool
        alloc: Allocator

        /// An empty channel with room for `capacity` (at least 1) values.
        pub fn init(alloc: Allocator, capacity: usize) AllocError!Self {
            let none: ?T = null
            var n = capacity
            if n == 0 {
                n = 1
            }
            let slots = try alloc.alloc(none, n)
            return Self {
                mutex: Mutex.init(),
                notEmpty: Cond.init(),
                notFull: Cond.init(),
                slots: slots,
                head: 0,
                count: 0,
                closed: false,
                alloc: alloc,
            }
        }

        /// Frees the channel, once no thread uses it.
        pub fn deinit(self: *mut Self) {
            self.alloc.free(self.slots)
            self.notFull.deinit()
            self.notEmpty.deinit()
            self.mutex.deinit()
        }

        /// Adds `value` at the end, waiting while the channel is full.
        pub fn send(self: *mut Self, value: T) ChannelError!void {
            self.mutex.lock()
            defer self.mutex.unlock()
            while self.count == self.slots.len && !self.closed {
                self.notFull.wait(&self.mutex)
            }
            if self.closed {
                return ChannelError.Closed
            }
            self.slots[(self.head + self.count) % self.slots.len] = value
            self.count += 1
            self.notEmpty.signal()
        }

        /// Takes the first value, waiting while the channel is empty; null
        /// once it is closed and empty.
        pub fn recv(self: *mut Self) ?T {
            self.mutex.lock()
            defer self.mutex.unlock()
            while self.count == 0 && !self.closed {
                self.notEmpty.wait(&self.mutex)
            }
            if self.count == 0 {
                return null
            }
            let value = self.slots[self.head]
            self.slots[self.head] = null
            self.head = (self.head + 1) % self.slots.len
            self.count -= 1
            self.notFull.signal()
            return value
        }

        /// No more values can be sent; receivers get the values left, then
        /// null.
        pub fn close(self: *mut Self) {
            self.mutex.lock()
            defer self.mutex.unlock()
            self.closed = true
            self.notEmpty.broadcast()
            self.notFull.broadcast()
        }
    }
}

/// An integer that threads read and change without a lock. Every
/// operation is sequentially consistent; `add` and `sub` wrap around.
pub fn Atomic(comptime T: type) type where T: Integer {
    return struct {
        value: T

        /// An atomic integer holding `value`.
        pub fn init(value: T) Self {
            return Self { value: value }
        }

        /// The current value.
        pub fn load(self: *Self) T {
            return @atomicLoad(&self.value)
        }

        /// Sets the value to `value`.
        pub fn store(self: *mut Self, value: T) {
            @atomicStore(&mut self.value, value)
        }

        /// Adds `n` and returns the value before.
        pub fn add(self: *mut Self, n: T) T {
            return @atomicAdd(&mut self.value, n)
        }

        /// Subtracts `n` and returns the value before.
        pub fn sub(self: *mut Self, n: T) T {
            return @atomicSub(&mut self.value, n)
        }

        /// Sets the value to `new` if it is `expected`; says whether it was.
        pub fn compareSwap(self: *mut Self, expected: T, new: T) bool {
            return @atomicCas(&mut self.value, expected, new)
        }
    }
}

extern fn aye_mutex_lock(m: *?[*]u8)
extern fn aye_mutex_unlock(m: *?[*]u8)
extern fn aye_mutex_free(m: *?[*]u8)
extern fn aye_cond_new() [*]u8
extern fn aye_cond_wait(c: [*]u8, m: *?[*]u8)
extern fn aye_cond_signal(c: [*]u8)
extern fn aye_cond_broadcast(c: [*]u8)
extern fn aye_cond_free(c: [*]u8)
