// std.time: the monotonic clock, the wall clock, sleeping, and UTC dates.
//
// Dates are the proleptic Gregorian calendar in UTC (no time zones, no
// leap seconds), computed with integer arithmetic only: Howard Hinnant's
// days-from-civil and civil-from-days. They work before 1970 too.
// Text forms: RFC 3339 (`2026-10-10T07:20:00Z`) and the IMF-fixdate of an
// HTTP `Date` header (`Sat, 10 Oct 2026 07:20:00 GMT`).

import std.mem.AllocError
import std.mem.Allocator
import std.text
import std.text.Builder

pub error ParseError { Invalid }

/// Milliseconds on a clock that never goes back (not the time of day; its
/// start is unspecified). Subtract two readings to measure a duration.
pub fn monotonicMs() u64 {
    return aye_std_monotonic_ns() / 1000000
}

/// Milliseconds since 1970-01-01T00:00:00Z (Unix time, leap seconds not
/// counted), from the system's real-time clock. It can jump when the
/// system clock is set; measure durations with `monotonicMs`.
pub fn now() i64 {
    // A C `struct timespec`: seconds and nanoseconds.
    var ts = [2]i64{0, 0}
    aye_std_realtime(ts[..].ptr)
    return ts[0] * 1000 + ts[1] / 1000000
}

/// Waits at least `ms` milliseconds. On wasm32-freestanding it is a busy
/// wait on the host's monotonic clock.
pub fn sleep(ms: u64) {
    // A C `struct timespec`: seconds and nanoseconds. When a signal ends
    // the sleep early, `nanosleep` stores the time left in it.
    var ts = [2]i64{(ms / 1000) as i64, (ms % 1000 * 1000000) as i64}
    while nanosleep(ts[..].ptr, ts[..].ptr) != 0 {
    }
}

/// A moment in UTC, split into calendar fields. `weekday` is 0 for Sunday
/// to 6 for Saturday.
pub struct DateTime {
    year: i32
    month: u8
    day: u8
    hour: u8
    minute: u8
    second: u8
    millis: u16
    weekday: u8

    /// Milliseconds since 1970-01-01T00:00:00Z. The fields are not
    /// checked and `weekday` is ignored: a `month` of 13 or a `day` of 0
    /// counts on from the neighboring month, as the arithmetic gives it.
    pub fn toUnixMs(self: Self) i64 {
        let days = daysFromCivil(self.year as i64, self.month as i64, self.day as i64)
        return days * 86400000 + (self.hour as i64) * 3600000 + (self.minute as i64) * 60000 + (self.second as i64) * 1000 + (self.millis as i64)
    }

    /// The date as RFC 3339 in UTC, in new memory from `alloc` (free it with
    /// `alloc.free`): `2026-10-10T07:20:00Z`, and `2026-10-10T07:20:00.123Z`
    /// when `millis` is not 0. RFC 3339 has years 0000 to 9999 only; for
    /// others the text is not valid RFC 3339 and `parseRfc3339` rejects it.
    pub fn formatRfc3339(self: Self, alloc: Allocator) AllocError![]mut u8 {
        var b = Builder.init(alloc)
        defer b.deinit()
        try appendYear(&mut b, self.year)
        try b.appendByte('-')
        try appendPadded(&mut b, self.month as u64, 2)
        try b.appendByte('-')
        try appendPadded(&mut b, self.day as u64, 2)
        try b.appendByte('T')
        try appendClock(&mut b, self)
        if self.millis != 0 {
            try b.appendByte('.')
            try appendPadded(&mut b, self.millis as u64, 3)
        }
        try b.appendByte('Z')
        return b.toOwned()
    }

    /// The date as an HTTP IMF-fixdate (RFC 7231, section 7.1.1.1), in new
    /// memory from `alloc` (free it with `alloc.free`): `Sat, 10 Oct 2026
    /// 07:20:00 GMT`. The milliseconds are dropped. `weekday` and `month`
    /// must be in range (`fromUnixMs` and the parsers give that).
    pub fn formatHttp(self: Self, alloc: Allocator) AllocError![]mut u8 {
        var b = Builder.init(alloc)
        defer b.deinit()
        let wd = (self.weekday as usize) * 3
        let mo = ((self.month as usize) - 1) * 3
        try b.append(weekdays[wd..wd + 3])
        try b.append(", ")
        try appendPadded(&mut b, self.day as u64, 2)
        try b.appendByte(' ')
        try b.append(months[mo..mo + 3])
        try b.appendByte(' ')
        try appendYear(&mut b, self.year)
        try b.appendByte(' ')
        try appendClock(&mut b, self)
        try b.append(" GMT")
        return b.toOwned()
    }
}

/// The calendar fields of `ms` milliseconds since 1970-01-01T00:00:00Z
/// (negative before). Inverse of `DateTime.toUnixMs`.
pub fn fromUnixMs(ms: i64) DateTime {
    var days = ms / 86400000
    var rem = ms % 86400000
    if rem < 0 {
        rem += 86400000
        days -= 1
    }
    // civil-from-days: days since 0000-03-01, in 400-year eras.
    let z = days + 719468
    var era = z / 146097
    if z < 0 {
        era = (z - 146096) / 146097
    }
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    var month = mp + 3
    if mp >= 10 {
        month = mp - 9
    }
    var year = yoe + era * 400
    if month <= 2 {
        year += 1
    }
    // 1970-01-01 was a Thursday.
    var wd = (days + 4) % 7
    if wd < 0 {
        wd += 7
    }
    return DateTime {
        year: year as i32,
        month: month as u8,
        day: day as u8,
        hour: (rem / 3600000) as u8,
        minute: (rem / 60000 % 60) as u8,
        second: (rem / 1000 % 60) as u8,
        millis: (rem % 1000) as u16,
        weekday: wd as u8,
    }
}

/// Parses RFC 3339 `YYYY-MM-DDThh:mm:ss[.f...](Z|+hh:mm|-hh:mm)` and gives
/// the moment in UTC (an offset is subtracted). `T` and `Z` may be lower
/// case. Fractional digits beyond the third are dropped. The date must
/// exist (no February 30) and a second of 60 (a leap second) is rejected,
/// as is any other text: `Invalid`.
pub fn parseRfc3339(s: []u8) ParseError!DateTime {
    if s.len < 20 {
        return ParseError.Invalid
    }
    let year = digits(s, 0, 4) orelse return ParseError.Invalid
    let month = digits(s, 5, 2) orelse return ParseError.Invalid
    let day = digits(s, 8, 2) orelse return ParseError.Invalid
    let hour = digits(s, 11, 2) orelse return ParseError.Invalid
    let minute = digits(s, 14, 2) orelse return ParseError.Invalid
    let second = digits(s, 17, 2) orelse return ParseError.Invalid
    if s[4] != '-' || s[7] != '-' || (s[10] != 'T' && s[10] != 't') || s[13] != ':' || s[16] != ':' {
        return ParseError.Invalid
    }
    var i: usize = 19
    var millis: i64 = 0
    if s[i] == '.' {
        i += 1
        var n: usize = 0
        while i < s.len && s[i] >= '0' && s[i] <= '9' {
            if n < 3 {
                millis = millis * 10 + (s[i] - '0') as i64
            }
            n += 1
            i += 1
        }
        if n == 0 {
            return ParseError.Invalid
        }
        var k = n
        while k < 3 {
            millis *= 10
            k += 1
        }
        if i >= s.len {
            return ParseError.Invalid
        }
    }
    // The offset from UTC in minutes.
    var offset: i64 = 0
    if s[i] == 'Z' || s[i] == 'z' {
        i += 1
    } else if s[i] == '+' || s[i] == '-' {
        if i + 6 > s.len || s[i + 3] != ':' {
            return ParseError.Invalid
        }
        let oh = digits(s, i + 1, 2) orelse return ParseError.Invalid
        let om = digits(s, i + 4, 2) orelse return ParseError.Invalid
        if oh > 23 || om > 59 {
            return ParseError.Invalid
        }
        offset = oh * 60 + om
        if s[i] == '-' {
            offset = -offset
        }
        i += 6
    } else {
        return ParseError.Invalid
    }
    if i != s.len {
        return ParseError.Invalid
    }
    if !validDate(year, month, day) || hour > 23 || minute > 59 || second > 59 {
        return ParseError.Invalid
    }
    let days = daysFromCivil(year, month, day)
    let ms = days * 86400000 + hour * 3600000 + minute * 60000 + second * 1000 + millis - offset * 60000
    return fromUnixMs(ms)
}

/// Parses an HTTP date (RFC 7231, section 7.1.1.1): the IMF-fixdate
/// `Sat, 10 Oct 2026 07:20:00 GMT`, and the two obsolete forms a recipient
/// must still accept: RFC 850 `Sunday, 06-Nov-94 08:49:37 GMT` (a two-digit
/// year: 50 to 99 is 19xx, 00 to 49 is 20xx) and asctime
/// `Sun Nov  6 08:49:37 1994` (space-padded day, taken as GMT). The weekday
/// must match the date. Anything else: `Invalid`.
pub fn parseHttp(s: []u8) ParseError!DateTime {
    if s.len == 29 {
        if !text.eql(s[3..5], ", ") || s[7] != ' ' || s[11] != ' ' || s[16] != ' ' || s[19] != ':' || s[22] != ':' || !text.eql(s[25..29], " GMT") {
            return ParseError.Invalid
        }
        let wd = nameIndex(weekdays, s[0..3]) orelse return ParseError.Invalid
        let month = (nameIndex(months, s[8..11]) orelse return ParseError.Invalid) + 1
        let day = digits(s, 5, 2) orelse return ParseError.Invalid
        let year = digits(s, 12, 4) orelse return ParseError.Invalid
        return httpFields(wd, year, month, day, digits(s, 17, 2), digits(s, 20, 2), digits(s, 23, 2))
    }
    if s.len == 24 {
        if s[3] != ' ' || s[7] != ' ' || s[10] != ' ' || s[13] != ':' || s[16] != ':' || s[19] != ' ' {
            return ParseError.Invalid
        }
        let wd = nameIndex(weekdays, s[0..3]) orelse return ParseError.Invalid
        let month = (nameIndex(months, s[4..7]) orelse return ParseError.Invalid) + 1
        var day: i64 = 0
        if s[8] == ' ' {
            day = digits(s, 9, 1) orelse return ParseError.Invalid
        } else {
            day = digits(s, 8, 2) orelse return ParseError.Invalid
        }
        let year = digits(s, 20, 4) orelse return ParseError.Invalid
        return httpFields(wd, year, month, day, digits(s, 11, 2), digits(s, 14, 2), digits(s, 17, 2))
    }
    // RFC 850: the full weekday name, then `, dd-Mon-yy hh:mm:ss GMT`.
    var c: usize = 0
    while c < s.len && s[c] != ',' {
        c += 1
    }
    if c < 6 || c > 9 || s.len != c + 24 || s[c + 1] != ' ' {
        return ParseError.Invalid
    }
    let wd = nameIndex(weekdays, s[0..3]) orelse return ParseError.Invalid
    if !text.eql(s[0..c], fullWeekday(wd)) {
        return ParseError.Invalid
    }
    let r = c + 2
    if s[r + 2] != '-' || s[r + 6] != '-' || s[r + 9] != ' ' || s[r + 12] != ':' || s[r + 15] != ':' || !text.eql(s[r + 18..r + 22], " GMT") {
        return ParseError.Invalid
    }
    let month = (nameIndex(months, s[r + 3..r + 6]) orelse return ParseError.Invalid) + 1
    let day = digits(s, r, 2) orelse return ParseError.Invalid
    var year = digits(s, r + 7, 2) orelse return ParseError.Invalid
    if year >= 50 {
        year += 1900
    } else {
        year += 2000
    }
    return httpFields(wd, year, month, day, digits(s, r + 10, 2), digits(s, r + 13, 2), digits(s, r + 16, 2))
}

// The date of parsed HTTP fields (null digits are `Invalid`), checking the
// ranges and that the weekday `wd` matches.
fn httpFields(wd: i64, year: i64, month: i64, day: i64, h: ?i64, m: ?i64, sec: ?i64) ParseError!DateTime {
    let hour = h orelse return ParseError.Invalid
    let minute = m orelse return ParseError.Invalid
    let second = sec orelse return ParseError.Invalid
    if !validDate(year, month, day) || hour > 23 || minute > 59 || second > 59 {
        return ParseError.Invalid
    }
    let d = fromUnixMs(daysFromCivil(year, month, day) * 86400000 + hour * 3600000 + minute * 60000 + second * 1000)
    if (d.weekday as i64) != wd {
        return ParseError.Invalid
    }
    return d
}

fn fullWeekday(i: i64) []u8 {
    return match i {
        0 => "Sunday"
        1 => "Monday"
        2 => "Tuesday"
        3 => "Wednesday"
        4 => "Thursday"
        5 => "Friday"
        _ => "Saturday"
    }
}

let weekdays = "SunMonTueWedThuFriSat"
let months = "JanFebMarAprMayJunJulAugSepOctNovDec"

// The index of the 3-byte `name` among the 3-byte entries of `names`.
fn nameIndex(names: []u8, name: []u8) ?i64 {
    var i: usize = 0
    while i + 3 <= names.len {
        if text.eql(names[i..i + 3], name) {
            return (i / 3) as i64
        }
        i += 3
    }
    return null
}

// The value of the `n` ASCII digits of `s` at `pos`; null if they are not
// all there.
fn digits(s: []u8, pos: usize, n: usize) ?i64 {
    if pos + n > s.len {
        return null
    }
    var v: i64 = 0
    var i = pos
    while i < pos + n {
        if s[i] < '0' || s[i] > '9' {
            return null
        }
        v = v * 10 + (s[i] - '0') as i64
        i += 1
    }
    return v
}

fn isLeap(year: i64) bool {
    return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

fn validDate(year: i64, month: i64, day: i64) bool {
    if month < 1 || month > 12 || day < 1 {
        return false
    }
    var last: i64 = 31
    if month == 2 {
        last = 28
        if isLeap(year) {
            last = 29
        }
    } else if month == 4 || month == 6 || month == 9 || month == 11 {
        last = 30
    }
    return day <= last
}

// days-from-civil: days since 1970-01-01 of a proleptic Gregorian date.
fn daysFromCivil(year: i64, month: i64, day: i64) i64 {
    var y = year
    if month <= 2 {
        y -= 1
    }
    var era = y / 400
    if y < 0 {
        era = (y - 399) / 400
    }
    let yoe = y - era * 400
    var mp = month - 3
    if month <= 2 {
        mp = month + 9
    }
    let doy = (153 * mp + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// `v` in decimal, left-padded with zeros to `width` digits.
fn appendPadded(b: *mut Builder, v: u64, width: usize) AllocError!void {
    var div: u64 = 1
    var k: usize = 1
    while k < width {
        div *= 10
        k += 1
    }
    while div > 1 && v < div {
        try b.appendByte('0')
        div /= 10
    }
    try b.appendUint(v)
}

fn appendYear(b: *mut Builder, year: i32) AllocError!void {
    if year < 0 {
        try b.appendByte('-')
    }
    var y = year as i64
    if y < 0 {
        y = -y
    }
    try appendPadded(b, y as u64, 4)
}

// `hh:mm:ss`.
fn appendClock(b: *mut Builder, d: DateTime) AllocError!void {
    try appendPadded(b, d.hour as u64, 2)
    try b.appendByte(':')
    try appendPadded(b, d.minute as u64, 2)
    try b.appendByte(':')
    try appendPadded(b, d.second as u64, 2)
}

extern fn aye_std_monotonic_ns() u64
extern fn aye_std_realtime(ts: [*]i64) i32
extern fn nanosleep(req: [*]i64, rem: [*]i64) i32
