// std.net: TCP over IPv4 and IPv6. `listen` gives a `Listener`, whose
// `accept` gives a `Conn`; `connect` gives a `Conn` too. A host is an IPv4
// or IPv6 address (`127.0.0.1`, `::1`) or a name, resolved with
// `getaddrinfo`. `connectTimeout` is `connect` that gives up after a
// number of milliseconds.
//
// The C constants that differ between macOS and Linux (the layout of
// `struct addrinfo`, SOL_SOCKET and its options, errno values, MSG_NOSIGNAL
// or SO_NOSIGPIPE) are chosen by `@targetOs()` when the program is built.
// Writes never raise SIGPIPE: a closed peer is an error.

import std.text

pub error ListenError { InvalidAddress, AddressInUse, AccessDenied, UnknownHost, ListenFailed }
pub error ConnectError { InvalidAddress, UnknownHost, ConnectionRefused, Unreachable, TimedOut, ConnectFailed }
pub error AcceptError { AcceptFailed }
pub error ReadError { TimedOut, ConnectionReset, WouldBlock, ReadFailed }
pub error WriteError { ConnectionClosed, WriteFailed }

/// A socket that waits for connections.
pub struct Listener {
    sock: i32
    portNumber: u16

    /// Waits for the next connection.
    pub fn accept(self: Self) AcceptError!Conn {
        while true {
            let fd = accept(self.sock, null, null)
            if fd >= 0 {
                noSigpipe(fd)
                return Conn { sock: fd }
            }
            if errno() != EINTR {
                return AcceptError.AcceptFailed
            }
        }
        unreachable
    }

    /// The socket's file descriptor, for `poll` (O3.9b). It stays owned by
    /// the listener: do not close it.
    pub fn fd(self: Self) i32 {
        return self.sock
    }

    /// The port it listens on: the one the system picked for port 0.
    pub fn port(self: Self) u16 {
        return self.portNumber
    }

    /// Another listener on the same address and port, for a listener from
    /// `listenShared` on Linux, where the kernel spreads the new
    /// connections over them (`SO_REUSEPORT`). Elsewhere (macOS does not
    /// spread them), or for a listener from `listen`, it is ListenFailed or
    /// AddressInUse.
    pub fn again(self: Self) ListenError!Listener {
        if @targetOs() is .macos {
            return ListenError.ListenFailed
        }
        var addr = @zeroed([128]u8)
        var len: u32 = 128
        if getsockname(self.sock, addr[..].ptr, &mut len) != 0 {
            return ListenError.ListenFailed
        }
        // Linux's sa_family is a u16 at byte 0.
        let fd = socket(addr[0] as i32 | (addr[1] as i32) << 8, SOCK_STREAM, 0)
        if fd < 0 {
            return ListenError.ListenFailed
        }
        var one = [4]u8{1, 0, 0, 0}
        _ = setsockopt(fd, solSocket(), 2, one[..].ptr, 4)
        _ = setsockopt(fd, solSocket(), SO_REUSEPORT_LINUX, one[..].ptr, 4)
        if bind(fd, addr[..].ptr, len) != 0 || cListen(fd, 128) != 0 {
            let e = errno()
            _ = close(fd)
            if e == eaddrinuse() {
                return ListenError.AddressInUse
            }
            return ListenError.ListenFailed
        }
        return Listener { sock: fd, portNumber: self.portNumber }
    }

    /// Stops listening and releases the port.
    pub fn close(self: Self) {
        _ = close(self.sock)
    }
}

/// A TCP connection.
pub struct Conn {
    sock: i32

    /// The socket's file descriptor, for `poll` (O3.9b). It stays owned by
    /// the connection: do not close it.
    pub fn fd(self: Self) i32 {
        return self.sock
    }

    /// Waits for data and reads at most `buf.len` bytes: the number read, 0
    /// when the peer has closed its side. On a non-blocking connection
    /// (`setNonBlocking`) with no data there, WouldBlock.
    pub fn read(self: Self, buf: []mut u8) ReadError!usize {
        while true {
            let n = read(self.sock, buf.ptr, buf.len)
            if n >= 0 {
                return n as usize
            }
            let e = errno()
            if e != EINTR {
                return readError(e)
            }
        }
        unreachable
    }

    /// `read`, waiting at most `ms` milliseconds for data (`poll`):
    /// TimedOut when none came.
    pub fn readTimeout(self: Self, buf: []mut u8, ms: u32) ReadError!usize {
        var fds = [1]PollFd{PollFd { fd: self.sock, events: POLLIN, revents: 0 }}
        while true {
            let r = poll(fds[..].ptr, 1, ms as i32)
            if r > 0 {
                return self.read(buf)
            }
            if r == 0 {
                return ReadError.TimedOut
            }
            if errno() != EINTR {
                return ReadError.ReadFailed
            }
        }
        unreachable
    }

    /// Writes all of `bytes`; ConnectionClosed when the peer is gone.
    /// WriteFailed on a non-blocking connection whose buffer is full.
    pub fn write(self: Self, bytes: []u8) WriteError!void {
        var off: usize = 0
        while off < bytes.len {
            let n = try self.writeSome(bytes[off..])
            if n == 0 {
                return WriteError.WriteFailed
            }
            off += n
        }
    }

    /// Writes what the socket takes now, at most `bytes.len`: the number
    /// written, 0 when the buffer of a non-blocking connection is full
    /// (`setNonBlocking`; wait with `poll` for POLLOUT). A blocking
    /// connection waits for room, as `write` does. ConnectionClosed when
    /// the peer is gone.
    pub fn writeSome(self: Self, bytes: []u8) WriteError!usize {
        if bytes.len == 0 {
            return 0
        }
        var flags: i32 = 0
        if !(@targetOs() is .macos) {
            flags = MSG_NOSIGNAL_LINUX
        }
        while true {
            let n = send(self.sock, bytes.ptr, bytes.len, flags)
            if n > 0 {
                return n as usize
            }
            let e = errno()
            if n == 0 || e == EPIPE || e == econnreset() {
                return WriteError.ConnectionClosed
            }
            if e == eagain() {
                return 0
            }
            if e != EINTR {
                return WriteError.WriteFailed
            }
        }
        unreachable
    }

    /// Makes the connection non-blocking (`O_NONBLOCK`): `writeSome` gives
    /// 0 instead of waiting, and `read` gives WouldBlock when no data is
    /// there, so wait with `poll` (on `fd()`) first. False when the system refused.
    pub fn setNonBlocking(self: Self) bool {
        let flags = fcntl(self.sock, F_GETFL)
        return flags >= 0 && fcntl(self.sock, F_SETFL, flags | pick(0x4, 0x800)) == 0
    }

    /// Closes the connection.
    pub fn close(self: Self) {
        _ = close(self.sock)
    }
}

/// What `wait` waits for: data to read (or the peer closing), or room to
/// write.
pub enum Ready { Read, Write }

/// Waits at most `ms` milliseconds until the socket `fd` (`Conn.fd()`,
/// `Listener.fd()`, or a socket from a C library) is ready: readable for
/// `Ready.Read` (a listener: a connection to accept), writable for
/// `Ready.Write`. True when it is, also when the socket failed or the peer
/// hung up, so that the next read or write reports it; false when `ms`
/// passed first. `ms` 0 only checks.
pub fn wait(fd: i32, ready: Ready, ms: u32) bool {
    var ev = POLLIN
    if ready == Ready.Write {
        ev = POLLOUT
    }
    var fds = [1]PollFd{PollFd { fd: fd, events: ev, revents: 0 }}
    while true {
        let r = poll(fds[..].ptr, 1, ms as i32)
        if r >= 0 {
            return r > 0
        }
        if errno() != EINTR {
            return true
        }
    }
    unreachable
}

/// Listens on `host` at `port`; port 0 lets the system pick one
/// (`Listener.port`). `host` is a dotted IPv4 address, an IPv6 address
/// (`::1`, `::` for every interface), a host name (`getaddrinfo`), or
/// `0.0.0.0` for every IPv4 interface. `localhost` is 127.0.0.1. A name
/// that does not resolve is UnknownHost; an empty or over-long one is
/// InvalidAddress.
pub fn listen(host: []u8, port: u16) ListenError!Listener {
    return listenOn(host, port, false)
}

/// `listen` that lets `Listener.again` open more listeners on the same
/// address (O3.9c). On Linux it sets `SO_REUSEPORT`, so another
/// `listenShared` of the same user on that port succeeds too and the kernel
/// spreads the new connections over all of them; elsewhere it is `listen`.
pub fn listenShared(host: []u8, port: u16) ListenError!Listener {
    return listenOn(host, port, true)
}

fn listenOn(host: []u8, port: u16, shared: bool) ListenError!Listener {
    var head: ?*mut AddrInfo = null
    var name = host
    if text.eql(host, "localhost") {
        name = "127.0.0.1"
    }
    let rc = resolve(name, port, AI_PASSIVE, &mut head)
    if rc == RESOLVE_INVALID {
        return ListenError.InvalidAddress
    }
    if rc != 0 {
        return ListenError.UnknownHost
    }
    var e: i32 = 0
    var cur = head
    while cur |ai| {
        let fd = socket(ai.family, SOCK_STREAM, 0)
        if fd >= 0 {
            var one = [4]u8{1, 0, 0, 0}
            var reuse: i32 = 2
            if @targetOs() is .macos {
                reuse = 4
            }
            _ = setsockopt(fd, solSocket(), reuse, one[..].ptr, 4)
            if shared && !(@targetOs() is .macos) {
                _ = setsockopt(fd, solSocket(), SO_REUSEPORT_LINUX, one[..].ptr, 4)
            }
            if bind(fd, sockAddr(ai), ai.addrlen) == 0 && cListen(fd, 128) == 0 {
                var addr = @zeroed([128]u8)
                var len: u32 = 128
                if getsockname(fd, addr[..].ptr, &mut len) != 0 {
                    _ = close(fd)
                    freeaddrinfo(head)
                    return ListenError.ListenFailed
                }
                freeaddrinfo(head)
                // sin_port and sin6_port are both at byte 2
                return Listener { sock: fd, portNumber: (addr[2] as u16) << 8 | addr[3] as u16 }
            }
            e = errno()
            _ = close(fd)
        } else {
            e = errno()
        }
        cur = ai.next
    }
    freeaddrinfo(head)
    if e == eaddrinuse() {
        return ListenError.AddressInUse
    }
    if e == EACCES {
        return ListenError.AccessDenied
    }
    return ListenError.ListenFailed
}

/// Connects to `host` at `port`. `host` is a dotted IPv4 address, an IPv6
/// address (`::1`) or a host name (`getaddrinfo`); a name with several
/// addresses is tried address by address. A name that does not resolve is
/// UnknownHost; an empty or over-long one is InvalidAddress.
pub fn connect(host: []u8, port: u16) ConnectError!Conn {
    var head: ?*mut AddrInfo = null
    let rc = resolve(host, port, 0, &mut head)
    if rc == RESOLVE_INVALID {
        return ConnectError.InvalidAddress
    }
    if rc != 0 {
        return ConnectError.UnknownHost
    }
    var e: i32 = 0
    var cur = head
    while cur |ai| {
        let fd = socket(ai.family, SOCK_STREAM, 0)
        if fd >= 0 {
            if cConnect(fd, sockAddr(ai), ai.addrlen) == 0 {
                freeaddrinfo(head)
                noSigpipe(fd)
                return Conn { sock: fd }
            }
            e = errno()
            _ = close(fd)
        } else {
            e = errno()
        }
        cur = ai.next
    }
    freeaddrinfo(head)
    return connectError(e)
}

fn connectError(e: i32) ConnectError {
    if e == econnrefused() {
        return ConnectError.ConnectionRefused
    }
    if e == enetunreach() || e == ehostunreach() {
        return ConnectError.Unreachable
    }
    if e == etimedout() {
        return ConnectError.TimedOut
    }
    return ConnectError.ConnectFailed
}

/// `connect` that gives up after `ms` milliseconds (per address when a
/// name has several): a non-blocking connect, `poll` for POLLOUT, then
/// `SO_ERROR`. TimedOut when the peer did not answer in time; the other
/// errors are `connect`'s. The returned `Conn` is blocking, as from `connect`.
pub fn connectTimeout(host: []u8, port: u16, ms: u32) ConnectError!Conn {
    var head: ?*mut AddrInfo = null
    let rc = resolve(host, port, 0, &mut head)
    if rc == RESOLVE_INVALID {
        return ConnectError.InvalidAddress
    }
    if rc != 0 {
        return ConnectError.UnknownHost
    }
    var e: i32 = 0
    var cur = head
    while cur |ai| {
        let fd = socket(ai.family, SOCK_STREAM, 0)
        if fd >= 0 {
            let flags = fcntl(fd, F_GETFL)
            if flags < 0 || fcntl(fd, F_SETFL, flags | pick(0x4, 0x800)) != 0 {
                e = errno()
                _ = close(fd)
                cur = ai.next
                continue
            }
            var pending = false
            if cConnect(fd, sockAddr(ai), ai.addrlen) == 0 {
                e = 0
            } else {
                e = errno()
                pending = e == einprogress() || e == EINTR
            }
            if pending {
                var fds = [1]PollFd{PollFd { fd: fd, events: POLLOUT, revents: 0 }}
                var r = poll(fds[..].ptr, 1, ms as i32)
                while r < 0 && errno() == EINTR {
                    r = poll(fds[..].ptr, 1, ms as i32)
                }
                if r == 0 {
                    e = etimedout()
                } else if r < 0 {
                    e = errno()
                } else {
                    var err = @zeroed([4]u8)
                    var len: u32 = 4
                    if getsockopt(fd, solSocket(), pick(0x1007, 4), err[..].ptr, &mut len) != 0 {
                        e = errno()
                    } else {
                        e = (err[0] as i32) | (err[1] as i32) << 8 | (err[2] as i32) << 16 | (err[3] as i32) << 24
                    }
                }
            }
            if e == 0 {
                _ = fcntl(fd, F_SETFL, flags)
                freeaddrinfo(head)
                noSigpipe(fd)
                return Conn { sock: fd }
            }
            _ = close(fd)
        } else {
            e = errno()
        }
        cur = ai.next
    }
    freeaddrinfo(head)
    return connectError(e)
}

// `struct addrinfo` as C lays it out on 64-bit macOS and Linux. The two
// pointers swap places: macOS has ai_canonname then ai_addr, Linux the
// reverse (`sockAddr` picks). Declared by hand so std needs no libclang.
extern struct AddrInfo {
    flags: i32
    family: i32
    socktype: i32
    protocol: i32
    addrlen: u32
    first: ?[*]u8
    second: ?[*]u8
    next: ?*mut AddrInfo
}

let AI_PASSIVE: i32 = 1
let RESOLVE_INVALID: i32 = -1

// ai_addr of `ai`.
fn sockAddr(ai: *mut AddrInfo) [*]u8 {
    var p = ai.first
    if @targetOs() is .macos {
        p = ai.second
    }
    if p |a| {
        return a
    }
    unreachable
}

// getaddrinfo for `host` and `port` (TCP) into `head`: 0, RESOLVE_INVALID
// when `host` is empty or too long, or getaddrinfo's own non-zero code.
fn resolve(host: []u8, port: u16, flags: i32, head: *mut ?*mut AddrInfo) i32 {
    var name = @zeroed([256]u8)
    if host.len == 0 || host.len >= 256 {
        return RESOLVE_INVALID
    }
    for i, c in host {
        if c == 0 {
            return RESOLVE_INVALID
        }
        name[i] = c
    }
    // the port in decimal, NUL-terminated
    var service = @zeroed([8]u8)
    var digits = @zeroed([8]u8)
    var n: usize = 0
    var v = port as u32
    while true {
        digits[n] = '0' + (v % 10) as u8
        n += 1
        v = v / 10
        if v == 0 {
            break
        }
    }
    for i in 0..n {
        service[i] = digits[n - 1 - i]
    }
    var hints = @zeroed(AddrInfo)
    hints.flags = flags
    hints.socktype = SOCK_STREAM
    return getaddrinfo(name[..].ptr, service[..].ptr, &hints, head)
}

/// C's `struct pollfd`, for `poll` on `Listener.fd()` and `Conn.fd()`
/// (`std.http.Server` uses it).
pub extern struct PollFd {
    fd: i32
    events: i16
    revents: i16
}

let SOCK_STREAM: i32 = 1
let POLLIN: i16 = 1
let POLLOUT: i16 = 4
let EINTR: i32 = 4
let EACCES: i32 = 13
let EPIPE: i32 = 32
let F_GETFL: i32 = 3
let F_SETFL: i32 = 4
// Linux: send's flag; macOS: the socket option.
let MSG_NOSIGNAL_LINUX: i32 = 0x4000
let SO_NOSIGPIPE_DARWIN: i32 = 0x1022

// macOS's value, else Linux's.
fn pick(mac: i32, linux: i32) i32 {
    if @targetOs() is .macos {
        return mac
    }
    return linux
}

fn solSocket() i32 { return pick(0xffff, 1) }
// Linux's SO_REUSEPORT (`listenShared`).
let SO_REUSEPORT_LINUX: i32 = 15
fn econnrefused() i32 { return pick(61, 111) }
fn econnreset() i32 { return pick(54, 104) }
fn eaddrinuse() i32 { return pick(48, 98) }
fn enetunreach() i32 { return pick(51, 101) }
fn ehostunreach() i32 { return pick(65, 113) }
fn etimedout() i32 { return pick(60, 110) }
fn einprogress() i32 { return pick(36, 115) }
fn eagain() i32 { return pick(35, 11) }

fn readError(e: i32) ReadError {
    if e == econnreset() {
        return ReadError.ConnectionReset
    }
    if e == etimedout() {
        return ReadError.TimedOut
    }
    if e == eagain() {
        return ReadError.WouldBlock
    }
    return ReadError.ReadFailed
}

// No SIGPIPE for writes to `fd` on macOS (Linux: `write`'s flag).
fn noSigpipe(fd: i32) {
    if @targetOs() is .macos {
        var one = [4]u8{1, 0, 0, 0}
        _ = setsockopt(fd, solSocket(), SO_NOSIGPIPE_DARWIN, one[..].ptr, 4)
    }
}

// `errno`: `__error()` on macOS, `__errno_location()` on Linux.
fn errno() i32 {
    if @targetOs() is .macos {
        return darwinErrno().*
    } else {
        return linuxErrno().*
    }
}

extern("__error") fn darwinErrno() *i32
extern("__errno_location") fn linuxErrno() *i32
extern("listen") fn cListen(fd: i32, backlog: i32) i32
extern("connect") fn cConnect(fd: i32, addr: [*]u8, len: u32) i32
extern fn socket(domain: i32, kind: i32, protocol: i32) i32
extern fn bind(fd: i32, addr: [*]u8, len: u32) i32
extern fn accept(fd: i32, addr: ?[*]u8, len: ?[*]u32) i32
extern fn getsockname(fd: i32, addr: [*]u8, len: *mut u32) i32
extern fn setsockopt(fd: i32, level: i32, name: i32, value: [*]u8, len: u32) i32
extern fn getsockopt(fd: i32, level: i32, name: i32, value: [*]u8, len: *mut u32) i32
extern fn poll(fds: [*]PollFd, n: u64, timeout: i32) i32
extern fn send(fd: i32, buf: [*]u8, n: usize, flags: i32) isize
extern fn getaddrinfo(node: [*]u8, service: [*]u8, hints: *AddrInfo, res: *mut ?*mut AddrInfo) i32
extern fn freeaddrinfo(res: ?*mut AddrInfo)
extern fn read(fd: i32, buf: [*]u8, n: usize) isize
extern fn close(fd: i32) i32
extern fn fcntl(fd: i32, cmd: i32, ...) i32
