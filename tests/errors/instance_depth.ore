// A generic that instantiates itself with a larger type never ends.
fn Nest(comptime T: type) type {
    return struct {
        value: T
        next: ?*Nest(?T)
    }
}

fn grow(comptime T: type, x: T) {
    grow(?T, x)
}

pub fn main() {
    let n = Nest(i64) { value: 1, next: null }
    grow(i64, n.value)
}
