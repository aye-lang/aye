enum Shape {
    Circle { r: i64 }
    Rect { w: i64, h: i64 }
    Empty
}

error E { Bad, Worse }

fn f(x: i64) E!i64 {
    if x < 0 { return E.Bad }
    return x
}

fn class(c: u8) []u8 {
    return match c {
        'a'..='z', 'A'..='Z' => "word"
        '0'..='9' => "digit"
        _ => "other"
    }
}

fn area(s: Shape) i64 {
    match s {
        .Circle { r } => {
            @println(r)
        }
        .Rect { w, .. } => @println(w)
        .Empty => @println(0)
    }
    return match s {
        .Circle { r: radius } => 3 * radius * radius
        .Rect { w, h } =>
            w * h
        .Empty => 0
    }
}

pub fn main() {
    @println(class('q'))
    @println(area(Shape.Rect { w: 2, h: 3 }))
    let n = f(-1) catch |e| match e {
        .Bad => -1
        .Worse => -2
    }
    let m = f(1) catch |e| {
        return
    }
    @println(n + m)
}
