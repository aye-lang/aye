// O3.2: std.time wall clock, UTC calendar fields, RFC 3339 and HTTP dates.

import std.testing
import std.time

fn rfcFails(s: []u8) bool {
    if time.parseRfc3339(s) |d| {
        return false
    } else |e| {
        return true
    }
}

fn httpFails(s: []u8) bool {
    if time.parseHttp(s) |d| {
        return false
    } else |e| {
        return true
    }
}

test "now is a plausible Unix time in milliseconds" {
    let a = time.now()
    @expect(a > 1700000000000)
    time.sleep(5)
    @expect(time.now() > a)
}

test "calendar fields" {
    let epoch = time.fromUnixMs(0)
    @expectEqual(1970, epoch.year)
    @expectEqual(1, epoch.month)
    @expectEqual(1, epoch.day)
    @expectEqual(4, epoch.weekday)

    let leap = time.fromUnixMs(951782400000)
    @expectEqual(2000, leap.year)
    @expectEqual(2, leap.month)
    @expectEqual(29, leap.day)

    let before = time.fromUnixMs(-1)
    @expectEqual(1969, before.year)
    @expectEqual(12, before.month)
    @expectEqual(31, before.day)
    @expectEqual(23, before.hour)
    @expectEqual(59, before.minute)
    @expectEqual(59, before.second)
    @expectEqual(999, before.millis)

    let late = time.fromUnixMs(2147483648000)
    @expectEqual(2038, late.year)
    @expectEqual(19, late.day)
    @expectEqual(8, late.second)
    @expectEqual(2147483648000, late.toUnixMs())
}

test "RFC 3339 format and parse" {
    let alloc = testing.allocator()
    let d = time.fromUnixMs(1760080800123)
    let s = try d.formatRfc3339(alloc)
    defer alloc.free(s)
    @expectEqual("2025-10-10T07:20:00.123Z", s)
    let back = try time.parseRfc3339(s)
    @expectEqual(1760080800123, back.toUnixMs())
    let shifted = try time.parseRfc3339("2026-10-10T12:50:00+05:30")
    @expectEqual(1791616800000, shifted.toUnixMs())
    @expect(rfcFails("2026-02-29T00:00:00Z"))
}

test "HTTP date format and parse" {
    let alloc = testing.allocator()
    let d = time.fromUnixMs(1791616800000)
    let s = try d.formatHttp(alloc)
    defer alloc.free(s)
    @expectEqual("Sat, 10 Oct 2026 07:20:00 GMT", s)
    let back = try time.parseHttp(s)
    @expectEqual(1791616800000, back.toUnixMs())
    @expect(httpFails("Fri, 10 Oct 2026 07:20:00 GMT"))

    // The obsolete forms parse to the same instants (RFC 7231 examples).
    let a = try time.parseHttp("Sun, 06 Nov 1994 08:49:37 GMT")
    let b = try time.parseHttp("Sunday, 06-Nov-94 08:49:37 GMT")
    let c = try time.parseHttp("Sun Nov  6 08:49:37 1994")
    @expectEqual(784111777000, a.toUnixMs())
    @expectEqual(a.toUnixMs(), b.toUnixMs())
    @expectEqual(a.toUnixMs(), c.toUnixMs())
    // Two-digit years: 49 is 2049, 50 is 1950.
    let y49 = try time.parseHttp("Friday, 01-Jan-49 00:00:00 GMT")
    @expectEqual(2049, y49.year)
    let y50 = try time.parseHttp("Sunday, 01-Jan-50 00:00:00 GMT")
    @expectEqual(1950, y50.year)
    let two = try time.parseHttp("Wed Nov 16 08:49:37 1994")
    @expectEqual(16, two.day)
    // Round trip through the IMF-fixdate.
    let rt = try c.formatHttp(alloc)
    defer alloc.free(rt)
    @expectEqual("Sun, 06 Nov 1994 08:49:37 GMT", rt)
    @expect(httpFails("Monday, 06-Nov-94 08:49:37 GMT"))
    @expect(httpFails("Sun, 06-Nov-94 08:49:37 GMT"))
    @expect(httpFails("Sun Nov  6 08:49:37 1994 "))
    @expect(httpFails("Mon Nov  6 08:49:37 1994"))
    @expect(httpFails("Sunday, 06-Nov-94 08:49:37 UTC"))
}
