// Every way a test can end, as `ore test` reports it.

error ParseError { Empty, Bad }

struct Point { x: i32, y: i32 }

fn parse(s: []u8) ParseError!u32 {
    if s.len == 0 {
        return ParseError.Empty
    }
    return 7
}

fn half(x: u8) u8 {
    return x / 2
}

test "passes" {
    @println("output of a passing test is not shown")
    @expect(half(10) == 5)
    @expectEqual(7, try parse("x"))
    @expectEqual("abc", "abc")
    @expectEqual(true, half(1) == 0)
}

test "expect fails" {
    @println("before")
    @expect(half(10) == 4)
    @println("not reached")
}

test "expectEqual fails" {
    @expectEqual(4, half(10))
}

test "strings differ" {
    @expectEqual("abc", "abd")
}

test "panics" {
    var x: u8 = 255
    x += 1
}

test "returns an error" {
    let n = try parse("")
    @println(n)
}

test "double free" {
    let alloc = @testAllocator()
    let p = try alloc.create(Point { x: 1, y: 2 })
    alloc.destroy(p)
    alloc.destroy(p)
}
