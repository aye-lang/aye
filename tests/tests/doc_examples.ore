// `ore test` runs each ```ore block of a `///` doc comment as the body of a
// test named after the declaration below it.
import std.mem.AllocError
import std.mem.Allocator

/// The square of `x`:
///
/// ```ore
/// @expectEqual(9, square(3))
/// @expectEqual(0, square(0))
/// ```
pub fn square(x: i64) i64 {
    return x * x
}

/// A stack of integers.
pub struct Stack {
    items: []mut i64
    len: usize

    /// A stack with room for `n` items:
    ///
    /// ```ore
    /// let alloc = @testAllocator()
    /// var s = try Stack.init(alloc, 2)
    /// defer s.deinit(alloc)
    /// s.push(5)
    /// @expectEqual(5, s.top())
    /// ```
    pub fn init(alloc: Allocator, n: usize) AllocError!Stack {
        return Stack { items: try alloc.alloc(0 as i64, n), len: 0 }
    }

    pub fn deinit(self: *mut Self, alloc: Allocator) {
        alloc.free(self.items)
    }

    pub fn push(self: *mut Self, x: i64) {
        self.items[self.len] = x
        self.len += 1
    }

    pub fn top(self: *Self) i64 {
        return self.items[self.len - 1]
    }
}

/// Only ```ore blocks run; this one is text:
///
/// ```text
/// half(3) is 1
/// ```
///
/// This example is wrong, and its failure points into the comment:
///
/// ```ore
/// @expectEqual(2, half(3))
/// ```
fn half(x: i64) i64 {
    return x / 2
}

test "plain" {
    @expectEqual(1, half(2))
}
