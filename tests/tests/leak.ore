// Acceptance (M3): a test that leaks memory fails, and the report names the
// allocation site.

import std.heap.Arena

struct Node {
    value: i64
    next: ?*mut Node
}

test "create and destroy" {
    let alloc = @testAllocator()
    let n = try alloc.create(Node { value: 1, next: null })
    defer alloc.destroy(n)
    @expectEqual(1, n.value)
}

test "leaks a node" {
    let alloc = @testAllocator()
    let n = try alloc.create(Node { value: 2, next: null })
    @expectEqual(2, n.value)
}

test "arena without deinit" {
    var arena = Arena.init(@testAllocator())
    let alloc = arena.allocator()
    let n = try alloc.create(Node { value: 3, next: null })
    @expectEqual(3, n.value)
}

test "arena with deinit" {
    var arena = Arena.init(@testAllocator())
    defer arena.deinit()
    let alloc = arena.allocator()
    for i in 0..1000 {
        let n = try alloc.create(Node { value: i, next: null })
        @expectEqual(i, n.value)
    }
}
