// std in a small CLI: arguments, stdin, stdout, stderr, std.mem, std.log
// and the exit status. Run as `ore run std_use -- -v two`.

import std
import std.mem.Allocator
import std.mem.AllocError

fn count(text: []u8) [3]usize {
    var lines: usize = 0
    var words: usize = 0
    var inWord = false
    for i in 0..text.len {
        let c = text[i]
        if c == '\n' {
            lines += 1
        }
        if c == ' ' || c == '\n' || c == '\t' {
            inWord = false
        } else if !inWord {
            inWord = true
            words += 1
        }
    }
    return [3]usize{lines, words, text.len}
}

fn upper(alloc: Allocator, s: []u8) AllocError![]mut u8 {
    let out = try alloc.alloc(0 as u8, s.len)
    std.mem.copy(out, s)
    for i in 0..out.len {
        if out[i] >= 'a' && out[i] <= 'z' {
            out[i] -= 32
        }
    }
    return out
}

pub fn main() !void {
    var gpa = std.heap.General.init()
    defer gpa.deinit()
    let alloc = gpa.allocator()

    let args = try std.os.args(alloc)
    defer alloc.free(args)
    var verbose = false
    for i in 1..args.len {
        if std.mem.eql(args[i], "-v") {
            verbose = true
        }
    }
    let input = try std.fs.stdin().readAll(alloc)
    defer alloc.free(input)
    let n = count(input)
    if verbose {
        std.log.info("{} arguments, last {}", args.len - 1, args[args.len - 1])
    }
    let out = std.fs.stdout()
    try out.write("lines words bytes: ")
    @print(n[0])
    @print(" ")
    @print(n[1])
    @print(" ")
    @println(n[2])
    let shout = try upper(alloc, args[args.len - 1])
    defer alloc.free(shout)
    try out.write(shout)
    try out.write("\n")
    try std.fs.stderr().write("done\n")
    if verbose {
        std.os.exit(3)      // defers do not run
    }
}
