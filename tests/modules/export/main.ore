// `pub extern fn` exports an Ore function to C under its own name: the
// `extern fn` declarations below reach module `cb`'s functions through C.
import cb

extern fn ore_twice(x: i32) i32
extern fn qsort(base: [*]i32, n: usize, size: usize, cmp: fn([*]i32, [*]i32) i32)

pub fn main() {
    @println(ore_twice(21))
    @println(cb.ore_twice(4))
    var xs = [4]i32{3, 1, 4, 2}
    qsort(xs[..].ptr, xs.len, @sizeOf(i32), cb.ore_compare)
    for x in xs {
        @print(x)
    }
    @println()
}
