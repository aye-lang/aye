import std.crypto.Sha1
import std.crypto.sha1

fn hex(d: []u8) {
    let digits = "0123456789abcdef"
    for b in d {
        let hi = (b >> 4) as usize
        let lo = (b & 15) as usize
        @print(digits[hi..hi + 1])
        @print(digits[lo..lo + 1])
    }
    @println("")
}

/// One million "a", fed in chunks of 1000 bytes.
fn million() [20]u8 {
    var h = Sha1.init()
    let chunk = [1000]u8{97, ..}
    for i in 0..1000 {
        h.update(chunk[..])
    }
    return h.final()
}

pub fn main() {
    let d0 = sha1("abc")
    hex(d0[..])
    let d1 = sha1("")
    hex(d1[..])
    let d2 = sha1("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    hex(d2[..])
    let d3 = sha1("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")
    hex(d3[..])
    let dm = million()
    hex(dm[..])
}
