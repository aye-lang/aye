import std.heap.General
import std.list.List

pub fn main() !void {
    var gpa = General.init()
    defer gpa.deinit()
    var l = List(i32).init(gpa.allocator())
    defer l.deinit()
    for i in 0..5 {
        try l.append(i as i32 * 10)
    }
    @println(l.len())
    @println(l.items()[4])
    @println(l.pop() orelse -1)
    try l.insert(1, 99)
    @println(l.items()[1])
    @println(l.orderedRemove(0))
    @println(l.swapRemove(0))
    @println(l.len())
    l.clear()
    @println(l.len())
    @println(l.pop() == null)
}
