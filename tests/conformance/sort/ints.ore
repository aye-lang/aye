import std.sort

fn less(a: i32, b: i32) bool {
    return a < b
}

fn greater(a: i32, b: i32) bool {
    return a > b
}

pub fn main() {
    var xs = [8]i32{5, 3, 9, 1, 3, 7, -2, 0}
    sort.sort(i32, xs[..], less)
    for x in xs {
        @print(x)
        @print(" ")
    }
    @println("")
    sort.sort(i32, xs[..], greater)
    for x in xs {
        @print(x)
        @print(" ")
    }
    @println("")
}
