error ParseError { Empty, InvalidDigit, Overflow }

fn parseU32(s: []u8) ParseError!u32 {
    if s.len == 0 {
        return ParseError.Empty
    }
    var n: u64 = 0
    for i in 0..s.len {
        let c = s[i]
        if c < '0' || c > '9' {
            return ParseError.InvalidDigit
        }
        n = n * 10 + (c - '0') as u64
        if n > 4294967295 {
            return ParseError.Overflow
        }
    }
    return n as u32
}

// `try` passes any `ParseError` on to the caller.
fn sum(a: []u8, b: []u8) ParseError!u64 {
    let x = try parseU32(a)
    let y = try parseU32(b)
    return x as u64 + y as u64
}

// Every error is handled with `catch`; `match e` covers each one.
fn show(s: []u8) {
    let n = parseU32(s) catch |e| {
        match e {
            .Empty => @println("empty")
            .InvalidDigit => @println("invalid digit")
            .Overflow => @println("overflow")
        }
        return
    }
    @println(n)
}

pub fn main() {
    show("0")
    show("42")
    show("4294967295")
    show("")
    show("12x")
    show("4294967296")
    @println(sum("40", "2") catch 0)
    @println(sum("1", "x") catch |e| 7)
}
