// M8: std.math.

import std.math

pub fn main() {
    @println(math.pi)
    @println(math.sqrt(2.0))
    @println(math.sqrt(-1.0) != math.sqrt(-1.0))
    @println(math.floor(-2.5))
    @println(math.ceil(-2.5))
    @println(math.round(2.5))
    @println(math.round(-2.5))
    @println(math.round(2.4))
    @println(math.pow(2.0, 10.0))
    @println(math.pow(9.0, 0.5))
    @println(math.min(1.5, -3.0))
    @println(math.max(1.5, -3.0))
    @println(math.abs(-4.25))
    @println(math.abs(4.25))
    @println(math.clamp(5.0, 0.0, 1.0))
    @println(math.clamp(-5.0, 0.0, 1.0))
    @println(math.clamp(0.5, 0.0, 1.0))
    let r = 2.0
    @println(math.pi * r * r)
}
