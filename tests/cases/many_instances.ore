// 200 instances of one generic (stage0 once allowed at most 64), and a
// generic nested 20 deep (the limit is 32 levels of nesting).

import std
import std.list.List
import std.mem.Allocator

fn Box(comptime T: type) type {
    return struct {
        v: T
    }
}

