// `s[i..j]` with `i < s.len` and `j < s.len` known, but not `i <= j`.
fn mid(s: []u32, i: usize, j: usize) usize {
    if i < s.len && j < s.len {
        return s[i..j].len
    }
    return 0
}

pub fn main() {
    var a = [4]u32{1, 2, 3, 4}
    @println(mid(a[..], 1, 3))
    @println(mid(a[..], 3, 1))
}
