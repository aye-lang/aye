pub fn main() {
    // A range of two literals is `usize`: `k` adds to a `usize` and indexes.
    let s: usize = 3
    let xs = [4]i32{10, 20, 30, 40}
    let v: []i32 = xs[0..4]
    var sum: i32 = 0
    for k in 0..4 {
        let i = s + k
        @print(i)
        @print(" ")
        sum += v[k]
    }
    @println()
    @println(sum)

    // A signed counter: give one bound a type.
    var acc: i64 = 0
    for i in (0 as i64)..4 {
        acc += i - 2
    }
    @println(acc)
    for i in -2..(2 as i64) {
        acc += i
    }
    @println(acc)
}
