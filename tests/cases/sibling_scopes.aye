fn twice(x: i32) i32 {
    let y = x * 2
    return y
}

pub fn main() {
    {
        let x = 1
        @println(x)
    }
    {
        let x = 2
        @println(x)
    }
    for i in 0..2 {
        @println(i)
    }
    for i in 5..6 {
        @println(i)
    }
    let y = twice(21)
    @println(y)
}
