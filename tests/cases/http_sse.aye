// std.http server-sent events (O3.6b): the `/events` handler calls
// `res.stream()`, so the server writes the head of an event stream and keeps
// the connection open. The main thread broadcasts a frame, another thread a
// second one, && a second connection is answered meanwhile. A client that
// leaves is dropped from `streams()`. `stop` closes the stream: the client
// reads EOF. A stream response with a body (O3.6d) writes it right after the
// head, as the first frame; one that does not fit the socket at once goes out
// through the pending buffer, and a broadcast comes after it.

import std.heap.General
import std.http
import std.http.Header
import std.http.Request
import std.http.Response
import std.http.Server
import std.mem
import std.mem.Allocator
import std.net
import std.net.Conn
import std.text
import std.text.Builder
import std.thread
import std.time

struct App {
    unused: u32
}

fn handle(app: *mut App, req: *Request, res: *mut Response, alloc: Allocator) {
    if text.eql(req.path(), "/events") {
        res.body = "event: hello\ndata: first\n\n"
        res.stream()
        return
    }
    if text.eql(req.path(), "/big") {
        // 2 MiB of comment lines, then one event: more than the socket takes.
        var line = @zeroed([1024]u8)
        for i in 0..1024 {
            line[i] = 'x'
        }
        line[0] = ':'
        line[1023] = '\n'
        var b = Builder.init(alloc)
        for i in 0..2048 {
            b.append(line[0..1024]) catch |e| {
                return
            }
        }
        b.append("data: end\n\n") catch |e| {
            return
        }
        res.body = b.bytes()
        res.stream()
        return
    }
    res.body = "pong"
}

fn run(s: *mut Server) {
    var gpa = General.init()
    defer gpa.deinit()
    s.run(gpa.allocator()) catch |e| {
        @println("run failed")
    }
}

fn sender(s: *mut Server) {
    var gpa = General.init()
    defer gpa.deinit()
    let n = s.broadcast(gpa.allocator(), "tick", "two\nlines") catch |e| {
        0
    }
    @print("thread wrote to ")
    @println(n)
}

// Reads from `c` until `buf` ends with `tail`; prints what came, without the
// CRs.
fn readUntil(c: Conn, tail: []u8) !void {
    var buf = @zeroed([1024]u8)
    var got: usize = 0
    while got < 1024 {
        let n = try c.readTimeout(buf[got..], 5000)
        if n == 0 {
            break
        }
        got += n
        if got >= tail.len && mem.eql(buf[got - tail.len..got], tail) {
            break
        }
    }
    var line = @zeroed([1024]u8)
    var k: usize = 0
    for i in 0..got {
        if buf[i] == '\r' {
            continue
        }
        line[k] = buf[i]
        k += 1
    }
    @print(line[0..k])
    @println("<end>")
}

// Reads from `c` until `want` bytes came; prints whether that many did.
fn readCount(c: Conn, want: usize) !void {
    var buf = @zeroed([65536]u8)
    var got: usize = 0
    while got < want {
        var room = want - got
        if room > 65536 {
            room = 65536
        }
        let n = try c.readTimeout(buf[0..room], 5000)
        if n == 0 {
            break
        }
        got += n
    }
    @print("big: ")
    @println(got == want)
}

// True when `want` streams are open within 5 s (the worker adds a stream
// after it writes the last of its first chunk, so the client can read that
// chunk and ask `streams()` first; O3.6e).
fn waitOpen(s: *mut Server, want: usize) bool {
    for i in 0..100 {
        if s.streams() == want {
            return true
        }
        time.sleep(50)
    }
    return false
}

// True when `broadcast` has dropped every stream but `want` within 5 s.
fn waitStreams(s: *mut Server, want: usize) bool {
    var gpa = General.init()
    defer gpa.deinit()
    for i in 0..100 {
        _ = s.broadcast(gpa.allocator(), "ping", "") catch |e| {
            0
        }
        if s.streams() == want {
            return true
        }
        time.sleep(50)
    }
    return false
}

pub fn main() !void {
    var gpa = General.init()
    defer gpa.deinit()
    var app = App { unused: 0 }
    var s = try http.listen(App, "127.0.0.1", 0, &mut app, handle)
    let t = try thread.spawn(Server, run, &mut s)

    // The head: no Content-Length, nothing after it until an event.
    let c = try net.connect("127.0.0.1", s.port())
    try c.write("GET /events HTTP/1.1\r\nHost: x\r\n\r\n")
    try readUntil(c, "first\n\n")
    _ = waitOpen(&mut s, 1)
    @print("streams: ")
    @println(s.streams())

    // Another connection is answered while the stream is open.
    let p = try net.connect("127.0.0.1", s.port())
    try p.write("GET /ping HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
    try readUntil(p, "pong")
    p.close()

    // A frame from the main thread, one from another thread.
    var n = try s.broadcast(gpa.allocator(), "greet", "hello")
    @print("main wrote to ")
    @println(n)
    try readUntil(c, "hello\n\n")
    let w = try thread.spawn(Server, sender, &mut s)
    w.join()
    try readUntil(c, "lines\n\n")

    // A body that the socket takes in parts: all of it, then the broadcast.
    let head = "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: keep-alive\r\n\r\n"
    let g = try net.connect("127.0.0.1", s.port())
    try g.write("GET /big HTTP/1.1\r\nHost: x\r\n\r\n")
    try readCount(g, head.len + 2048 * 1024 + 11)
    @print("big open: ")
    @println(waitOpen(&mut s, 2))
    n = try s.broadcast(gpa.allocator(), "after", "ok")
    @print("after wrote to ")
    @println(n)
    try readUntil(g, "ok\n\n")
    g.close()
    @print("big dropped: ")
    @println(waitStreams(&mut s, 1))

    // A second stream that leaves is dropped.
    let d = try net.connect("127.0.0.1", s.port())
    try d.write("GET /events HTTP/1.1\r\nHost: x\r\n\r\n")
    try readUntil(d, "first\n\n")
    _ = waitOpen(&mut s, 2)
    @print("streams: ")
    @println(s.streams())
    d.close()
    @print("dropped: ")
    @println(waitStreams(&mut s, 1))

    // `stop` closes the stream: EOF.
    s.stop()
    var buf = @zeroed([256]u8)
    var eof = false
    while true {
        let r = try c.readTimeout(buf[..], 5000)
        if r == 0 {
            eof = true
            break
        }
    }
    @print("eof: ")
    @println(eof)
    c.close()
    t.join()
}
