fn sum(xs: []i64) i64 {
    var s: i64 = 0
    for i in 0..xs.len {
        s += xs[i]
    }
    return s
}

fn count(s: []u8, c: u8) usize {
    var n: usize = 0
    for i in 0..s.len {
        if s[i] == c {
            n += 1
        }
    }
    return n
}

pub fn main() {
    var a = [5]i64{1, 2, 3, 4, 5}
    @println(a.len)
    @println(sum(a[0..5]))
    @println(sum(a[1..3]))
    @println(sum(a[..2]))
    @println(sum(a[3..]))
    let s = a[1..]
    let t = s[1..3]
    @println(t.len)
    @println(t[0])
    // Arrays are values.
    var b = a
    b[0] = 100
    @println(a[0])
    @println(b[0])
    let text = "banana"
    @println(text.len)
    @println(count(text, 'a'))
    @println(text[2..4])
    let grid = [2][2]i32{[2]i32{1, 2}, [2]i32{3, 4}}
    @println(grid[1][0])
    // Any unsigned integer type can index; literals default to usize.
    let k: u32 = 4
    let lo: u8 = 1
    @println(a[k])
    @println(a[lo..k].len)
}
