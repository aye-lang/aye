// `extern("name")` (O1.3a): the C symbol differs from the Ore name, so the
// module can define its own `abs`.

extern("abs") fn cAbs(x: i32) i32
extern("strlen") fn cStrlen(s: [*]u8) usize

fn abs(x: i32) i32 {
    return x + 1000
}

pub fn main() {
    @println(cAbs(-5))
    @println(abs(-5))
    @println(cStrlen("hello".ptr))
    let f = cAbs
    @println(f(-7))
}
