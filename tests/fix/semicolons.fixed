fn add(a: i64, b: i64) i64 {
    return a + b
}

fn first(xs: []i64) i64 { return xs[0] }

pub fn main() {
    let x = 1
    var y = 2 // keep this comment
    y += x
    let a = 3
    let b = 4
    if a < b { @println("a; b") }
    let s = "no; change;"
    @println(add(x, y))
    @println(s)
    var xs = [2]i64{9, 8}
    @println(first(xs[..]))
    @println(a + b)
    @println(0)
}
