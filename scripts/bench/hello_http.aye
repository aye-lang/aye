// Benchmark server (O7.1): `std.http` hello world on port 8081.
// Build: aye build --mode fast scripts/bench/hello_http.aye -o target/hello_aye

import std.heap.General
import std.http
import std.http.Header
import std.http.Request
import std.http.Response
import std.http.Server
import std.mem.Allocator

struct App {
    unused: u32
}

fn handle(app: *mut App, req: *Request, res: *mut Response, alloc: Allocator) {
    res.body = "hello\n"
    let hs = alloc.alloc(Header { name: "Content-Type", value: "text/plain" }, 1) catch |e| {
        return
    }
    res.headers = hs
}

pub fn main() !void {
    var gpa = General.init()
    defer gpa.deinit()
    var app = App { unused: 0 }
    var s = try http.listen(App, "127.0.0.1", 8081, &mut app, handle)
    try s.run(gpa.allocator())
}
