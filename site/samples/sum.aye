import std.heap.General
import std.list.List

error ParseError { BadDigit }

fn parse(s: []u8) ParseError!i64 {
    var n: i64 = 0
    for c in s {
        if c < '0' || c > '9' {
            return ParseError.BadDigit
        }
        n = n * 10 + (c - '0') as i64
    }
    return n
}

pub fn main() !void {
    var gpa = General.init()
    defer gpa.deinit()
    var xs = List(i64).init(gpa.allocator())
    defer xs.deinit()
    try xs.append(try parse("12"))
    try xs.append(try parse("30"))
    var total: i64 = 0
    for x in xs.items() {
        total += x
    }
    @println(total)
}
