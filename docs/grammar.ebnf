(* Ore stage0 grammar: the subset implemented by the stage0 compiler.
   This is the starting point of the P0 formal grammar.

   Notation: ISO-style EBNF.  { x } = zero or more, [ x ] = optional,
   "..." = literal token.  Whitespace and `//` line comments separate tokens.

   NEWLINE is the statement terminator.  It is not written in the source:
   the lexer inserts it (Go rule) at a line break or at end of file when the
   last token on the line is one of
       identifier, integer/float/string/char literal,
       ")"  "]"  "}"  ".*"  "return"  "break"  "continue",
   except after a line_str when the next line starts with "\\", ",", ")",
   "]" or "}".  An explicit ";" is a lexical error. *)

(* ------------------------------------------------------------ lexical *)

ident       = letter , { letter | digit } ;          (* not a keyword *)
letter      = "A".."Z" | "a".."z" | "_" ;
digit       = "0".."9" ;
int_lit     = dec_lit | "0x" hex_digit { hex_digit | "_" }
                      | "0o" oct_digit { oct_digit | "_" }
                      | "0b" bin_digit { bin_digit | "_" } ;
dec_lit     = digit , { digit | "_" } ;
float_lit   = dec_lit "." dec_lit [ exponent ] | dec_lit exponent ;
exponent    = ( "e" | "E" ) [ "+" | "-" ] dec_lit ;
string_lit  = '"' , { char | escape } , '"'           (* single line, UTF-8 *)
            | line_str , { line_str } ;               (* consecutive lines, joined with "\n" *)
line_str    = "\\" , { char } ;                       (* to the end of the line, no escapes *)
char_lit    = "'" , ( char | escape ) , "'" ;           (* one code point *)
escape      = "\n" | "\t" | "\r" | "\0" | "\\" | '\"' | "\'" | "\x" hex_digit hex_digit ;
builtin     = "@" ident ;

keyword     = "fn" | "let" | "var" | "pub" | "import" | "struct" | "enum"
            | "error" | "interface" | "dyn" | "match" | "if" | "else" | "for"
            | "while" | "break" | "continue" | "return" | "defer" | "errdefer"
            | "try" | "catch" | "orelse" | "unreachable" | "comptime" | "where"
            | "as" | "test" | "mut" | "extern" | "is" ;
(* `comptime` appears only before a parameter and `where` only after a
   return type; elsewhere they are errors.
   `true`, `false`, `null`, `in`, `Self`, `type`, the primitive type
   names and C's integer type names (c_short c_ushort c_int c_uint c_long
   c_ulong c_longlong c_ulonglong: i16 u16 i32 u32 i64 u64 i64 u64) are
   predeclared identifiers, not keywords. `Allocator`,
   `AllocError`, `General` and `Arena` are items of std (`std.mem`,
   `std.heap`) and must be imported. *)

(* --------------------------------------------------------- top level *)

file        = { NEWLINE } , { ( import | item ) , ( NEWLINE | EOF ) , { NEWLINE } } ;
item        = fn_decl | extern_fn | struct_decl | union_decl | enum_decl | error_decl
            | interface_decl | test_decl | global_decl | link_decl ;

link_decl   = ( "@link" | "@linkOptional" ) "(" string_lit ")" ;
               (* a C library: a pkg-config package, -lname, or
                  "framework:Name" (macOS); only at the top level.
                  @linkOptional links it only where it is installed;
                  @hasLink("name") in an expression says whether it is *)

global_decl = [ "pub" ] ( "let" | "var" ) ident [ ":" type ] "=" arg ;
               (* a constant (let) or global variable (var) whose value is
                  computed at compile time; or, for a `let` without a type
                  whose value names a type, a type alias: let P = Pool(Node) *)

import      = "import" ident { "." ident } ;
               (* binds its last name in the file: a module (directory
                  a/b under the root module's directory, or a std module),
                  or a single pub item of a module (import std.mem.Allocator) *)
path        = ident { "." ident } ;
               (* a name, or an item of a module: std.fs.File *)

fn_decl     = [ "pub" ] "fn" ident "(" [ params ] ")" [ ret_type ] [ where ] block ;
extern_fn   = [ "pub" ] "extern" "fn" ident "(" [ params [ "," "..." ] ] ")" [ type ]
            | "pub" "extern" "fn" ident "(" [ params ] ")" [ type ] block ;
               (* without a body: a C function, variadic with "..." after at
                  least one parameter; with a body: an Ore function exported
                  to C under its own name *)
ret_type    = type
            | [ path ] "!" ( type | "void" ) ;   (* error union E!T; !T infers the set
                                                     (not allowed on a `pub fn` other than main,
                                                     nor on a generic) *)
params      = param { "," param } [ "," ] ;
param       = [ "comptime" ] ident ":" type ;    (* comptime T: type; only on top-level fns *)
where       = "where" ident ":" path { "," ident ":" path } ;
               (* T: I -- the comptime parameter T implements interface I;
                  write T: A, T: B for two interfaces *)
(* A fn with comptime parameters is generic. A fn whose return type is
   `type` is a type function: it has only comptime parameters, and its body
   is exactly  "{" "return" struct_type "}"  (with newlines). *)

struct_decl = [ "pub" ] [ "extern" ] "struct" ident "{" { NEWLINE }
              [ member { ( "," | NEWLINE ) { NEWLINE } member } [ "," ] { NEWLINE } ] "}" ;
member      = field [ "=" expr ] | fn_decl ;
                                         (* a field with a default value, a constant that a
                                            literal leaving the field out gives it; a method,
                                            followed by a newline; any order *)
               (* in a method, `Self` is the struct; a first parameter of type
                  Self, *Self or *mut Self makes it callable as x.method().
                  An extern struct has C layout and C-compatible fields. *)
union_decl  = [ "pub" ] "extern" "union" ident "{" { NEWLINE }
              [ member { ( "," | NEWLINE ) { NEWLINE } member } [ "," ] { NEWLINE } ] "}" ;
               (* a C union: the fields share their memory; a literal sets
                  exactly one field; no field defaults. "union" is an
                  identifier everywhere else *)
struct_type = "struct" "{" { NEWLINE }
              [ member { ( "," | NEWLINE ) { NEWLINE } member } [ "," ] { NEWLINE } ] "}" ;
               (* anonymous struct: only as the value a type function returns *)
field_list  = "{" { NEWLINE }
              [ field { ( "," | NEWLINE ) { NEWLINE } field } [ "," ] { NEWLINE } ] "}" ;
field       = ident ":" type ;

enum_decl   = [ "pub" ] "enum" ident "{" { NEWLINE }
              enum_member { ( "," | NEWLINE ) { NEWLINE } enum_member } [ "," ] { NEWLINE } "}" ;
enum_member = variant | fn_decl ;              (* a method, followed by a newline; Self is the enum *)
variant     = ident [ field_list ] ;           (* field_list not empty *)

interface_decl = [ "pub" ] "interface" ident "{" { NEWLINE }
              [ fn_sig { NEWLINE { NEWLINE } fn_sig } { NEWLINE } ] "}" ;
fn_sig      = "fn" ident "(" ident ":" "*" [ "mut" ] "Self" { "," param } [ "," ] ")" [ ret_type ] ;
               (* the first parameter is self: *Self or self: *mut Self *)

test_decl   = "test" string_lit block ;   (* the body is like a `!void` function *)

error_decl  = [ "pub" ] "error" ident
              ( "{" { NEWLINE } ident { ( "," | NEWLINE ) { NEWLINE } ident } [ "," ] { NEWLINE } "}"
              | "=" path { "||" path } ) ;  (* merged set: every error of each part *)

(* ------------------------------------------------------------- types *)

type        = path                     (* i8 i16 i32 i64 isize u8 u16 u32 u64
                                          usize f32 f64 bool, a struct or an enum,
                                          a comptime parameter, mod.Name *)
            | path "(" [ type { "," type } [ "," ] ] ")"    (* instance of a type function  Pool(Node) *)
            | "[" expr "]" type        (* fixed array      [N]T; the length is a
                                          constant integer expression: 3, N, mod.N, N * 2 *)
            | "simd" "[" expr "]" type (* vector           simd[4]f32: 2 to 64 lanes (a power
                                          of two) of a number or bool; `simd` is special
                                          only before "[" *)
            | "[" "]" [ "mut" ] type   (* slice            []T, []mut T (writable elements) *)
            | "[" "*" "]" type         (* C pointer (FFI)  [*]T *)
            | "*" [ "mut" ] type       (* pointer          *T, *mut T *)
            | "?" type                 (* optional         ?T   *)
            | "dyn" path               (* interface value  dyn I *)
            | "fn" "(" [ type { "," type } [ "," ] ] ")" [ ret_type ] ;
                                       (* function         fn(A, B) R; the result
                                          type is there when a type starts *)
(* an ident can also name an error set; its values are written Set.Name *)

(* -------------------------------------------------------- statements *)

block       = "{" { NEWLINE } [ stmt { NEWLINE { NEWLINE } stmt } { NEWLINE } ] "}" ;

stmt        = let_stmt | if_stmt | while_stmt | for_stmt
            | "break" | "continue" | "return" [ expr ]
            | ( "defer" | "errdefer" ) ( block | if_stmt | simple_stmt )
            | block
            | simple_stmt ;

let_stmt    = ( "let" | "var" ) ident [ ":" type ] "=" expr ;
if_stmt     = "if" cond_expr [ "|" ident "|" ] block
              [ "else" ( if_stmt | block | "|" ident "|" block ) ] ;
               (* with "|v|" the header is a ?T and v is its value;
                  with "else |e|" it is an error union E!T: v is the
                  payload and e the error *)
               (* "else" must follow "}" on the same line *)
while_stmt  = "while" cond_expr [ "|" ident "|" ] block ;
               (* with "|v|": loop while the header, evaluated each time, has a value *)
for_stmt    = "for" ident "in" header_expr ".." header_expr block
            | "for" [ ident "," ] ident "in" header_expr block ;
               (* half-open range lo..hi; or the elements of an array or
                  slice, with their usize index; "in" is a contextual identifier *)
simple_stmt = expr [ assign_op expr ] ;   (* a bare expr must be a call, try, catch or match;
                                             "_" "=" expr drops the value of any expr *)
assign_op   = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "+%=" | "-%=" | "*%="
            | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

(* header_expr is expr, except that `Name {` and `Enum.Variant {` are not
   parsed as literals at its top level (write `(Name { ... })` there).
   cond_expr, the header of `if` and `while`, is a header_expr in which a
   "|" at the top level is not an operator: it starts the capture. *)
header_expr = expr ;
cond_expr   = header_expr ;

(* ------------------------------------------------------- expressions *)

(* A postfix chain that starts with a module name is resolved as a path:
   std.fs.open(p) calls the function open of module std.fs, and
   std.heap.General.init() calls init of the type std.heap.General.
   Slicing a C pointer [*]T needs both bounds: p[0..n].
   x.f(args) calls a method, or the function value in the field f.

   Precedence, lowest to highest; binary operators are left-associative
   except comparisons, which do not chain (`a < b < c` is an error), and
   & | ^, which do not mix without parentheses (`a & b | c` is an error).
     1  ||
     2  &&
     3  == != < <= > >= is
     4  catch orelse
     5  & | ^
     6  << >>
     7  + - +% -%
     8  * / % *%
     9  as            (postfix cast, binds looser than unary: -x as f32 == (-x) as f32)
    10  - ! ~ & &mut try   (unary prefix)
    11  call, index, slice, field, .*, .?  *)

expr        = or_expr ;
or_expr     = and_expr { "||" and_expr } ;
and_expr    = cmp_expr { "&&" cmp_expr } ;
cmp_expr    = catch_expr [ cmp_op catch_expr | "is" "." ident ] ;
               (* x is .V: does the enum x (or *x) hold the variant V; a bool *)
cmp_op      = "==" | "!=" | "<" | "<=" | ">" | ">=" ;
catch_expr  = bit_expr { ( "catch" [ "|" ident "|" ] | "orelse" ) fallback } ;
               (* x catch |e| { ... } runs the block on an error; x catch v gives v;
                  x orelse v gives v when the optional x is null; a ?T v makes
                  the result a ?T, so a orelse b orelse c chains *)
fallback    = block | "return" [ expr ] | "break" | "continue" | bit_expr ;
bit_expr    = shift_expr { "&" shift_expr } | shift_expr { "|" shift_expr }
            | shift_expr { "^" shift_expr } ;   (* one operator per chain *)
shift_expr  = add_expr { ( "<<" | ">>" ) add_expr } ;
add_expr    = mul_expr { ( "+" | "-" | "+%" | "-%" ) mul_expr } ;
mul_expr    = cast_expr { ( "*" | "/" | "%" | "*%" ) cast_expr } ;
cast_expr   = unary { "as" type } ;
unary       = ( "-" | "!" | "~" | "&" [ "mut" ] | "try" ) unary | postfix ;
postfix     = primary { "." ident
                      | "." ident "(" [ args ] ")"             (* method call; Type.f(...) *)
                      | ".*"                                   (* dereference *)
                      | ".?"                                   (* unwrap an optional *)
                      | "(" [ args ] ")"                       (* call of a function value
                                                                  that is not a name: f()(x) *)
                      | "[" expr "]"
                      | "[" [ expr ] ".." [ expr ] "]" } ;
primary     = int_lit | float_lit | string_lit | char_lit
            | "true" | "false" | "null"
            | "unreachable"                                (* panics; any type *)
            | ident
            | path "." ident                               (* variant without payload, or error *)
            | path "." ident "{" [ field_init { "," field_init } [ "," ] ] "}"
                                                           (* variant literal, or a struct literal
                                                              mod.Name { ... } of another module *)
            | match_expr
            | ident "(" [ args ] ")"                       (* call of a function or of a function
                                                              value; also F(T) naming a type,
                                                              as in F(T).init() *)
            | builtin "(" [ args ] ")"                     (* @print @println @expect @expectEqual
                                                              @testAllocator @sizeOf @zeroed @ptrCast
                                                              @downcast @embedFile
                                                              @hash @splat @reduceAdd @reduceMin
                                                              @reduceMax @all @any @select;
                                                              @setSafety(true|false) only as the
                                                              first statement of a block *)
            | ident "{" [ field_init { "," field_init } [ "," ] ] "}"   (* struct literal *)
            | path "(" [ args ] ")" "{" [ field_init { "," field_init } [ "," ] ] "}"
                                                           (* literal of a type function's struct:
                                                              Pair(i64) { ... }; the args are types *)
            | "[" ( expr | "_" ) "]" type "{" [ args ] "}"   (* array literal; [_]: length from
                                                              the elements, only here *)
            | "[" expr "]" type "{" expr "," ".." [ "," ] "}"   (* repeat: every element is the
                                                              value, evaluated once *)
            | "[" "]" [ "mut" ] type "{" "}"               (* the empty slice []T{} *)
            | "simd" "[" expr "]" type "{" [ args ] "}"    (* simd literal: one value per lane *)
            | "simd" "[" expr "]" type "{" expr "," ".." [ "," ] "}"   (* every lane the value *)
            | struct_type                                  (* only after `return` in a type function *)
            | "(" expr ")" ;
args        = arg { "," arg } [ "," ] ;
arg         = expr
            | ( "*" | "?" | "dyn" | "fn" ) type ;   (* a type for a comptime parameter or a
                                                        builtin; [N]T, []T and [*]T also parse
                                                        as primary *)
field_init  = ident ":" expr ;

match_expr  = "match" header_expr "{" { NEWLINE }
              { arm ( "," | NEWLINE ) { NEWLINE } } "}" ;   (* the last separator is optional *)
arm         = pattern "=>" ( block | expr ) ;   (* block only in a match statement *)
pattern     = "_"
            | variant_pat { "," variant_pat }
            | int_pat { "," int_pat } ;
               (* in a match on errors: "." ident, the error's name;
                  in a match on an integer: int_pat, several per arm;
                  an arm with several variant_pats binds no fields *)
variant_pat = "." ident [ "{" [ field_pat { "," field_pat } [ "," ".." ] | ".." ] "}" ] ;
int_pat     = int_value [ "..=" int_value ] ;    (* inclusive range 'a'..='z' *)
int_value   = [ "-" ] int_lit | char_lit ;
field_pat   = ident [ ":" ident ] ;
