(* Ore stage0 grammar: the subset implemented by the stage0 compiler.
   This is the starting point of the P0 formal grammar.

   Notation: ISO-style EBNF.  { x } = zero or more, [ x ] = optional,
   "..." = literal token.  Whitespace and `//` line comments separate tokens.

   NEWLINE is the statement terminator.  It is not written in the source:
   the lexer inserts it (Go rule) at a line break or at end of file when the
   last token on the line is one of
       identifier, integer/float/string/char literal,
       ")"  "]"  "}"  ".*"  "return"  "break"  "continue".
   An explicit ";" is a lexical error. *)

(* ------------------------------------------------------------ lexical *)

ident       = letter , { letter | digit } ;          (* not a keyword *)
letter      = "A".."Z" | "a".."z" | "_" ;
digit       = "0".."9" ;
int_lit     = dec_lit | "0x" hex_digit { hex_digit | "_" }
                      | "0o" oct_digit { oct_digit | "_" }
                      | "0b" bin_digit { bin_digit | "_" } ;
dec_lit     = digit , { digit | "_" } ;
float_lit   = dec_lit "." dec_lit [ exponent ] | dec_lit exponent ;
exponent    = ( "e" | "E" ) [ "+" | "-" ] dec_lit ;
string_lit  = '"' , { char | escape } , '"' ;          (* single line, UTF-8 *)
char_lit    = "'" , ( char | escape ) , "'" ;           (* one code point *)
escape      = "\n" | "\t" | "\r" | "\0" | "\\" | '\"' | "\'" | "\x" hex_digit hex_digit ;
builtin     = "@" ident ;

keyword     = "fn" | "let" | "var" | "pub" | "import" | "struct" | "enum"
            | "error" | "interface" | "dyn" | "match" | "if" | "else" | "for"
            | "while" | "break" | "continue" | "return" | "defer" | "errdefer"
            | "try" | "catch" | "comptime" | "where" | "as" | "test"
            | "mut" | "extern" ;
(* `import` is reserved; stage0 reports "... is not yet supported".
   `comptime` appears only before a parameter and `where` only after a
   return type; elsewhere they are errors.
   `true`, `false`, `null`, `in`, `Self`, `type`, the primitive type names,
   and `Allocator`, `General`, `Arena` and `AllocError` are predeclared
   identifiers, not keywords. *)

(* --------------------------------------------------------- top level *)

file        = { NEWLINE } , { item , ( NEWLINE | EOF ) , { NEWLINE } } ;
item        = fn_decl | extern_fn | struct_decl | enum_decl | error_decl
            | interface_decl | test_decl ;

fn_decl     = [ "pub" ] "fn" ident "(" [ params ] ")" [ ret_type ] [ where ] block ;
extern_fn   = [ "pub" ] "extern" "fn" ident "(" [ params ] ")" [ type ] ;
ret_type    = type
            | [ ident ] "!" ( type | "void" ) ;   (* error union E!T; !T infers the set
                                                     (not allowed on a `pub fn` other than main,
                                                     nor on a generic) *)
params      = param { "," param } [ "," ] ;
param       = [ "comptime" ] ident ":" type ;    (* comptime T: type; only on top-level fns *)
where       = "where" ident ":" ident { "," ident ":" ident } ;
               (* T: I -- the comptime parameter T implements interface I;
                  write T: A, T: B for two interfaces *)
(* A fn with comptime parameters is generic. A fn whose return type is
   `type` is a type function: it has only comptime parameters, and its body
   is exactly  "{" "return" struct_type "}"  (with newlines). *)

struct_decl = [ "pub" ] "struct" ident "{" { NEWLINE }
              [ member { ( "," | NEWLINE ) { NEWLINE } member } [ "," ] { NEWLINE } ] "}" ;
member      = field | fn_decl ;          (* a method, followed by a newline; fields and
                                            methods come in any order *)
               (* in a method, `Self` is the struct; a first parameter of type
                  Self, *Self or *mut Self makes it callable as x.method() *)
struct_type = "struct" "{" { NEWLINE }
              [ member { ( "," | NEWLINE ) { NEWLINE } member } [ "," ] { NEWLINE } ] "}" ;
               (* anonymous struct: only as the value a type function returns *)
field_list  = "{" { NEWLINE }
              [ field { ( "," | NEWLINE ) { NEWLINE } field } [ "," ] { NEWLINE } ] "}" ;
field       = ident ":" type ;

enum_decl   = [ "pub" ] "enum" ident "{" { NEWLINE }
              variant { ( "," | NEWLINE ) { NEWLINE } variant } [ "," ] { NEWLINE } "}" ;
variant     = ident [ field_list ] ;           (* field_list not empty *)

interface_decl = [ "pub" ] "interface" ident "{" { NEWLINE }
              [ fn_sig { NEWLINE { NEWLINE } fn_sig } { NEWLINE } ] "}" ;
fn_sig      = "fn" ident "(" ident ":" "*" [ "mut" ] "Self" { "," param } [ "," ] ")" [ ret_type ] ;
               (* the first parameter is self: *Self or self: *mut Self *)

test_decl   = "test" string_lit block ;   (* the body is like a `!void` function *)

error_decl  = [ "pub" ] "error" ident
              ( "{" { NEWLINE } ident { ( "," | NEWLINE ) { NEWLINE } ident } [ "," ] { NEWLINE } "}"
              | "=" ident { "||" ident } ) ;  (* merged set: every error of each part *)

(* ------------------------------------------------------------- types *)

type        = ident                    (* i8 i16 i32 i64 isize u8 u16 u32 u64
                                          usize f32 f64 bool, a struct or an enum,
                                          a comptime parameter *)
            | ident "(" [ type { "," type } [ "," ] ] ")"   (* instance of a type function  Pool(Node) *)
            | "[" int_lit "]" type     (* fixed array      [N]T *)
            | "[" "]" [ "mut" ] type   (* slice            []T, []mut T (writable elements) *)
            | "[" "*" "]" type         (* C pointer (FFI)  [*]T *)
            | "*" [ "mut" ] type       (* pointer          *T, *mut T *)
            | "?" type                 (* optional         ?T   *)
            | "dyn" ident ;            (* interface value  dyn I *)
(* an ident can also name an error set; its values are written Set.Name *)

(* -------------------------------------------------------- statements *)

block       = "{" { NEWLINE } [ stmt { NEWLINE { NEWLINE } stmt } { NEWLINE } ] "}" ;

stmt        = let_stmt | if_stmt | while_stmt | for_stmt
            | "break" | "continue" | "return" [ expr ]
            | ( "defer" | "errdefer" ) ( block | simple_stmt )
            | block
            | simple_stmt ;

let_stmt    = ( "let" | "var" ) ident [ ":" type ] "=" expr ;
if_stmt     = "if" header_expr [ "|" ident "|" ] block [ "else" ( if_stmt | block ) ] ;
               (* with "|v|" the header is a ?T and v is its value *)
               (* "else" must follow "}" on the same line *)
while_stmt  = "while" header_expr block ;
for_stmt    = "for" ident "in" header_expr ".." header_expr block ;
               (* half-open range lo..hi; "in" is a contextual identifier *)
simple_stmt = expr [ assign_op expr ] ;   (* a bare expr must be a call, try, catch or match *)
assign_op   = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "+%=" | "-%=" | "*%=" ;

(* header_expr is expr, except that `Name {` and `Enum.Variant {` are not
   parsed as literals at its top level (write `(Name { ... })` there). *)
header_expr = expr ;

(* ------------------------------------------------------- expressions *)

(* Precedence, lowest to highest; binary operators are left-associative
   except comparisons, which do not chain (`a < b < c` is an error).
     1  ||
     2  &&
     3  == != < <= > >=
     4  catch
     5  + - +% -%
     6  * / % *%
     7  as            (postfix cast, binds looser than unary: -x as f32 == (-x) as f32)
     8  - ! & &mut try   (unary prefix)
     9  call, index, slice, field, .*  *)

expr        = or_expr ;
or_expr     = and_expr { "||" and_expr } ;
and_expr    = cmp_expr { "&&" cmp_expr } ;
cmp_expr    = catch_expr [ cmp_op catch_expr ] ;
cmp_op      = "==" | "!=" | "<" | "<=" | ">" | ">=" ;
catch_expr  = add_expr { "catch" [ "|" ident "|" ] ( block | add_expr ) } ;
               (* x catch |e| { ... } runs the block on an error; x catch v gives v *)
add_expr    = mul_expr { ( "+" | "-" | "+%" | "-%" ) mul_expr } ;
mul_expr    = cast_expr { ( "*" | "/" | "%" | "*%" ) cast_expr } ;
cast_expr   = unary { "as" type } ;
unary       = ( "-" | "!" | "&" [ "mut" ] | "try" ) unary | postfix ;
postfix     = primary { "." ident
                      | "." ident "(" [ args ] ")"             (* method call; Type.f(...) *)
                      | ".*"                                   (* dereference *)
                      | "[" expr "]"
                      | "[" [ expr ] ".." [ expr ] "]" } ;
primary     = int_lit | float_lit | string_lit | char_lit
            | "true" | "false" | "null"
            | ident
            | ident "." ident                              (* variant without payload, or error *)
            | ident "." ident "{" [ field_init { "," field_init } [ "," ] ] "}"   (* variant literal *)
            | match_expr
            | ident "(" [ args ] ")"                       (* call; also F(T) naming a type,
                                                              as in F(T).init() *)
            | builtin "(" [ args ] ")"                     (* @print @println @expect
                                                              @expectEqual @testAllocator *)
            | ident "{" [ field_init { "," field_init } [ "," ] ] "}"   (* struct literal *)
            | ident "(" [ args ] ")" "{" [ field_init { "," field_init } [ "," ] ] "}"
                                                           (* literal of a type function's struct:
                                                              Pair(i64) { ... }; the args are types *)
            | "[" int_lit "]" type "{" [ args ] "}"        (* array literal *)
            | "[" "]" [ "mut" ] type "{" "}"               (* the empty slice []T{} *)
            | struct_type                                  (* only after `return` in a type function *)
            | "(" expr ")" ;
args        = arg { "," arg } [ "," ] ;
arg         = expr
            | ( "*" | "?" | "dyn" ) type ;   (* a type for a comptime parameter;
                                                 [N]T and []T also parse as primary *)
field_init  = ident ":" expr ;

match_expr  = "match" header_expr "{" { NEWLINE }
              { arm ( "," | NEWLINE ) { NEWLINE } } "}" ;   (* the last separator is optional *)
arm         = pattern "=>" ( block | expr ) ;   (* block only in a match statement *)
pattern     = "_"
            | "." ident [ "{" [ field_pat { "," field_pat } [ "," ".." ] | ".." ] "}" ] ;
               (* in a match on errors: "." ident, the error's name *)
field_pat   = ident [ ":" ident ] ;
