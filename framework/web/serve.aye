// web.run: serves a route table over std.http. The allocator std.http gives
// a handler is an arena freed once the response is written; the request,
// the response and the page live in it.

import std.fs
import std.fs.WriteError
import std.heap.Arena
import std.http
import std.mem.AllocError
import std.mem.Allocator
import std.net.ListenError
import std.os
import std.text
import std.text.Builder
import std.thread

/// Why `run` gave up: it could not listen, write or allocate.
pub error ServeError = ListenError || WriteError || AllocError || thread.SpawnError

/// What every connection thread reads: the route table, the directory of
/// static files, the directory of the islands' `.wasm` files, the page for a
/// path that nothing answers, and whether the
/// server runs with `--dev` (see `dev.aye`).
struct App {
    routes: []Route
    public: []u8
    client: []u8
    notFound: ?Handler
    dev: bool
}

/// The port after `--port` in the program's arguments, or `fallback`.
pub fn portArg(alloc: Allocator, fallback: u16) u16 {
    let args = os.args(alloc) catch |e| {
        return fallback
    }
    var i: usize = 1
    while i + 1 < args.len {
        if text.eql(args[i], "--port") {
            let n = text.parseInt(args[i + 1]) catch |e| {
                return fallback
            }
            if n >= 0 && n <= 65535 {
                return n as u16
            }
            return fallback
        }
        i += 1
    }
    return fallback
}

/// Listens on 127.0.0.1:`port` (0 picks a free port), prints `listening on
/// 127.0.0.1:<port>`, and serves `routes` until the process ends. A path
/// that no route has gets 404; a path with other methods only gets 405 and
/// an `Allow` header. `HEAD` is answered from the `Get` route with the same
/// headers and `Content-Length`, and no body (`std.http.Server` leaves it out). When no route matches a `GET` or `HEAD`, the
/// file of that path under `public` is served (see `serveFile`); `public` is
/// the path of the directory, absolute or relative to the working directory,
/// or empty for none. With `--dev` in the program's arguments, every HTML
/// page gets `<script src="/_web/dev.js">` before `</body>` (or at its end),
/// `GET /_web/dev.js` serves that script and `GET /_web/events` is an event
/// stream that sends `event: build` with the build id (the start time in
/// milliseconds) every 200 ms; without `--dev` those two paths are not special.
pub fn run(alloc: Allocator, port: u16, routes: []Route, public: []u8) ServeError!void {
    try serve(alloc, port, routes, public, "", null)
}

/// `run` for an app with a `not-found.aye`: a request that no route and no
/// file answers (any method) gets `notFound` called with the status set to
/// 404. If `notFound` returns an error, the plain page of that error is sent.
pub fn runApp(alloc: Allocator, port: u16, routes: []Route, public: []u8, notFound: Handler) ServeError!void {
    try serve(alloc, port, routes, public, "", notFound)
}

/// `run` and `runApp` for an app with islands (`web gen` writes the call):
/// `GET` and `HEAD` of `/_web/islands/<name>.wasm` serve the file of that
/// name under `client` (see `serveFile`; a name that is not there falls
/// through to the 404 of the app), and `/_web/islands.js` serves
/// `islandsScript()`. The script is served by every app, `client` or not.
pub fn runClient(alloc: Allocator, port: u16, routes: []Route, public: []u8, client: []u8, notFound: ?Handler) ServeError!void {
    try serve(alloc, port, routes, public, client, notFound)
}

fn serve(alloc: Allocator, port: u16, routes: []Route, public: []u8, client: []u8, notFound: ?Handler) ServeError!void {
    let dev = devArg(alloc)
    var app = App { routes: routes, public: public, client: client, notFound: notFound, dev: dev }
    var server = try http.listen(App, "127.0.0.1", port, &mut app, handle)
    if dev {
        try devBeats(alloc, &mut server, try devBuildId(alloc))
    }
    var line = Builder.init(alloc)
    defer line.deinit()
    try line.append("listening on 127.0.0.1:")
    try line.appendUint(server.port() as u64)
    try line.append("\n")
    try fs.stdout().write(line.bytes())
    try server.run(alloc)
}

fn handle(app: *mut App, hreq: *http.Request, hres: *mut http.Response, alloc: Allocator) {
    var req = Request {
        method: methodOf(hreq.method),
        path: pathOf(hreq.target),
        rawQuery: http.queryOf(hreq.target),
        route: "",
        headers: hreq.headers.items(),
        body: hreq.body,
        arena: alloc,
    }
    if app.dev && req.method == Method.Get && text.eql(req.path, "/_web/events") {
        hres.status = 200
        hres.stream()
        return
    }
    var res = Response.init(alloc)
    if app.dev && (req.method == Method.Get || req.method == Method.Head) && text.eql(req.path, "/_web/dev.js") {
        res.contentType = "text/javascript; charset=utf-8"
        res.page.raw(devScript()) catch |e| {
            fail(&mut res, e)
        }
    } else if island(app, &req, &mut res) {
    } else if find(app.routes, req.method, req.path) |r| {
        req.route = r.pattern
        r.handler(&req, &mut res) catch |e| {
            if r.kind == Kind.Api {
                failJson(&mut res, e)
            } else {
                fail(&mut res, e)
            }
        }
    } else if served(app, &req, &mut res) {
    } else {
        let allowed = allow(alloc, app.routes, req.path) catch |e| {
            hres.status = 500
            return
        }
        if allowed |methods| {
            fail(&mut res, Error.MethodNotAllowed)
            res.header("Allow", methods) catch |e| {
                res.headers.clear()
            }
        } else if app.notFound |page| {
            res.status = 404
            page(&req, &mut res) catch |e| {
                fail(&mut res, e)
            }
        } else {
            fail(&mut res, Error.NotFound)
        }
    }
    if app.dev && devIsHtml(&res) {
        devInject(&mut res) catch |e| {
            fail(&mut res, Error.OutOfMemory)
        }
    }
    let hs = alloc.alloc(http.Header { name: "Content-Type", value: res.contentType }, 1 + res.headers.len()) catch |e| {
        hres.status = 500
        return
    }
    for i in 0..res.headers.len() {
        hs[i + 1] = res.headers.items()[i]
    }
    hres.status = res.status
    hres.headers = hs
    hres.body = res.page.bytes()
}

// Does `public` have the file of a `GET` or `HEAD` request? Then `res` is
// its answer. A path that leaves `public` gets 400.
fn served(app: *mut App, req: *Request, res: *mut Response) bool {
    if req.method != Method.Get && req.method != Method.Head {
        return false
    }
    let found = serveFile(req.arena, app.public, req.path, req, res) catch |e| {
        fail(res, e)
        return true
    }
    return found
}

// Is `req` a `GET` or `HEAD` of `/_web/islands.js`, or of a file of
// `app.client` under `/_web/islands/`? Then `res` is its answer. A path that
// leaves `client` gets 400.
fn island(app: *mut App, req: *Request, res: *mut Response) bool {
    if req.method != Method.Get && req.method != Method.Head {
        return false
    }
    if text.eql(req.path, "/_web/islands.js") {
        res.contentType = "text/javascript; charset=utf-8"
        res.page.raw(islandsScript()) catch |e| {
            fail(res, e)
        }
        return true
    }
    let prefix = "/_web/islands"
    if !text.startsWith(req.path, "/_web/islands/") {
        return false
    }
    let found = serveFile(req.arena, app.client, req.path[prefix.len..req.path.len], req, res) catch |e| {
        fail(res, e)
        return true
    }
    return found
}

// Turns the response into the plain page of the status that `e` means.
fn fail(res: *mut Response, e: Error) {
    res.status = statusOf(e)
    res.headers.clear()
    res.text(http.reason(res.status)) catch |e2| {
        res.page.buf.clear()
    }
}

// Like `fail`, for an API route: the body is JSON, `{"error":"<name>"}`
// with the name of the error (a plain identifier, so it needs no escaping).
fn failJson(res: *mut Response, e: Error) {
    res.status = statusOf(e)
    res.headers.clear()
    res.contentType = "application/json"
    res.page.buf.clear()
    res.page.raw("{\"error\":\"") catch |e2| {
        res.page.buf.clear()
        return
    }
    res.page.raw(@tagName(e)) catch |e2| {
        res.page.buf.clear()
        return
    }
    res.page.raw("\"}") catch |e2| {
        res.page.buf.clear()
    }
}

fn statusOf(e: Error) u16 {
    if e == Error.BadRequest {
        return 400
    }
    if e == Error.Unauthorized {
        return 401
    }
    if e == Error.Forbidden {
        return 403
    }
    if e == Error.NotFound {
        return 404
    }
    if e == Error.MethodNotAllowed {
        return 405
    }
    if e == Error.Conflict {
        return 409
    }
    if e == Error.PayloadTooLarge {
        return 413
    }
    return 500
}

fn methodOf(m: []u8) Method {
    if text.eql(m, "GET") {
        return Method.Get
    }
    if text.eql(m, "HEAD") {
        return Method.Head
    }
    if text.eql(m, "POST") {
        return Method.Post
    }
    if text.eql(m, "PUT") {
        return Method.Put
    }
    if text.eql(m, "PATCH") {
        return Method.Patch
    }
    if text.eql(m, "DELETE") {
        return Method.Delete
    }
    return Method.Other
}

// The target without its query string.
fn pathOf(target: []u8) []u8 {
    if text.indexOf(target, "?") |i| {
        return target[0..i]
    }
    return target
}

test "every error has its status" {
    @expectEqual(400, statusOf(Error.BadRequest))
    @expectEqual(401, statusOf(Error.Unauthorized))
    @expectEqual(403, statusOf(Error.Forbidden))
    @expectEqual(404, statusOf(Error.NotFound))
    @expectEqual(405, statusOf(Error.MethodNotAllowed))
    @expectEqual(409, statusOf(Error.Conflict))
    @expectEqual(413, statusOf(Error.PayloadTooLarge))
    @expectEqual(500, statusOf(Error.OutOfMemory))
    @expectEqual(500, statusOf(Error.Internal))
}

test "an API error is JSON with the name and the status" {
    var arena = Arena.init(@testAllocator())
    defer arena.deinit()
    var res = Response.init(arena.allocator())
    failJson(&mut res, Error.Forbidden)
    @expectEqual(403, res.status)
    @expectEqual("application/json", res.contentType)
    @expectEqual("{\"error\":\"Forbidden\"}", res.page.bytes())
}
