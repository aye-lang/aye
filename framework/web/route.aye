// web.Route: the route table and its matcher.

import std.text

/// A page or an API function: reads the request, fills the response.
pub let Handler = fn(*Request, *mut Response) Error!void

/// One route: a method and a path of literal segments (`/`, `/about`,
/// `/docs/intro`), and the function that answers it.
pub struct Route {
    method: Method
    pattern: []u8
    handler: Handler
}

/// The handler of the first route with this method and path, or null.
/// Both sides drop one trailing `/`, so `/about/` is `/about`.
pub fn find(routes: []Route, method: Method, path: []u8) ?Handler {
    for r in routes {
        if r.method == method && sameSegments(r.pattern, path) {
            return r.handler
        }
    }
    return null
}

fn trimSlash(s: []u8) []u8 {
    if s.len > 1 && s[s.len - 1] == '/' {
        return s[0..s.len - 1]
    }
    return s
}

fn sameSegments(pattern: []u8, path: []u8) bool {
    return text.eql(trimSlash(pattern), trimSlash(path))
}
