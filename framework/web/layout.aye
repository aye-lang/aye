// web.wrap: puts a rendered page inside a layout.

import std.text.Builder

/// The function of an `app/**/layout.aye`: writes the document around `body`,
/// the page (or the inner layout) already rendered. Aye has no closures, so
/// the body comes as bytes rather than as a callback.
pub let Layout = fn(*Request, *mut Html, []u8) Error!void

/// Replaces the body of `res` with `layout` called on it, and makes the
/// response `text/html`. The status and headers stay. Call it once per
/// layout, innermost first (`web gen` writes these calls).
pub fn wrap(req: *Request, res: *mut Response, layout: Layout) Error!void {
    var out = Html { buf: Builder.init(req.arena) }
    try layout(req, &mut out, res.page.bytes())
    res.page = out
    res.contentType = "text/html; charset=utf-8"
}
