// web.Request: what a handler reads of the HTTP request.

import std.heap.Arena
import std.http
import std.mem.Allocator
import std.text

/// The request methods a route can name. Any other method is `Other`. A
/// `HEAD` request is answered from the route's `Get`, so no route names
/// `Head`.
pub enum Method { Get, Head, Post, Put, Patch, Delete, Other }

/// One request, as a handler sees it. `path` has no query string; `rawQuery`
/// is what follows the `?`, as sent (empty when there is none). `path`,
/// `rawQuery`, `headers` and `body` point into the connection's buffer. `route` is the
/// pattern of the matched route (`/blog/[slug]`). `arena` lives until the
/// response is written: handlers allocate from it and never free.
pub struct Request {
    method: Method
    path: []u8
    rawQuery: []u8
    route: []u8
    headers: []http.Header
    body: []u8
    arena: Allocator

    /// The part of the path that the `[name]` segment of the route matched.
    /// A `name` that is no segment of the route is a bug: it panics.
    pub fn param(self: *Self, name: []u8) []u8 {
        var ps = text.split(trimSlash(self.route), "/")
        var xs = text.split(trimSlash(self.path), "/")
        while ps.next() |p| {
            let x = xs.next() orelse unreachable
            if isParam(p) && text.eql(p[1..p.len - 1], name) {
                return x
            }
        }
        unreachable
    }

    /// The first value of `name` in the query string, percent-decoded (`+`
    /// is a space) into the request arena; null when there is none.
    pub fn query(self: *Self, name: []u8) Error!?[]u8 {
        return try http.queryValue(self.arena, self.rawQuery, name)
    }

    /// The first value of the field `name` of the body, decoded like
    /// `query`, when the `Content-Type` is `application/x-www-form-urlencoded`;
    /// null when there is no such field or the body is of another type.
    pub fn form(self: *Self, name: []u8) Error!?[]u8 {
        return try http.formValue(self.arena, self.header("content-type"), self.body, name)
    }

    /// The value of the cookie `name` of the `Cookie` header, as sent (not
    /// decoded); null when there is none.
    pub fn cookie(self: *Self, name: []u8) ?[]u8 {
        if self.header("cookie") |h| {
            return http.cookieValue(h, name)
        }
        return null
    }

    /// The value of the first header called `name`, compared without regard
    /// to ASCII case; null when there is none.
    pub fn header(self: *Self, name: []u8) ?[]u8 {
        for h in self.headers {
            if text.eqlIgnoreCase(h.name, name) {
                return h.value
            }
        }
        return null
    }
}

test "header ignores case" {
    let hs = [2]http.Header{
        http.Header { name: "Host", value: "example.test" },
        http.Header { name: "X-Test", value: "yes" },
    }
    let req = Request {
        method: Method.Get,
        path: "/",
        rawQuery: "",
        route: "/",
        headers: hs[..],
        body: "",
        arena: @testAllocator(),
    }
    @expectEqual("yes", req.header("x-test").?)
    @expectEqual("example.test", req.header("HOST").?)
    @expect(req.header("accept") == null)
}

test "param reads a [name] segment" {
    let req = Request {
        method: Method.Get,
        path: "/blog/hello/",
        rawQuery: "",
        route: "/blog/[slug]",
        headers: []http.Header{},
        body: "",
        arena: @testAllocator(),
    }
    @expectEqual("hello", req.param("slug"))
}

test "query, form and cookie" {
    let hs = [3]http.Header{
        http.Header { name: "Cookie", value: "sid=abc; theme=dark" },
        http.Header { name: "Content-Type", value: "application/x-www-form-urlencoded" },
        http.Header { name: "Host", value: "example.test" },
    }
    var arena = Arena.init(@testAllocator())
    defer arena.deinit()
    let req = Request {
        method: Method.Post,
        path: "/search",
        rawQuery: "q=a%20b+c&n=1",
        route: "/search",
        headers: hs[..],
        body: "msg=hi+you%21",
        arena: arena.allocator(),
    }
    @expectEqual("a b c", (try req.query("q")).?)
    @expectEqual("1", (try req.query("n")).?)
    @expect((try req.query("msg")) == null)
    @expectEqual("hi you!", (try req.form("msg")).?)
    @expectEqual("dark", req.cookie("theme").?)
    @expect(req.cookie("none") == null)
}
