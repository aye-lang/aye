// `web gen --prod`: the source of `.web/assets.aye`, the files of the app
// that the production executable carries (FD7). One `@embedFile` for each
// regular file below `<app>/public/` (found recursively; a dotfile, a
// dot directory and a symbolic link are left out) and each `*.wasm` of
// `.web/client/`. A `public/` file is also served under a hashed name,
// `/name.<first 8 hex of its SHA-256>.ext`; an island keeps its URL
// `/_web/islands/<name>.wasm`.

import std.crypto
import std.encoding
import std.fs
import std.fs.ReadDirError
import std.fs.ReadFileError
import std.list.List
import std.mem.Allocator
import std.path
import std.text
import std.text.Builder

/// What reading the files can fail with.
pub error AssetsError = ReadDirError || ReadFileError

// A file to embed: its URL, its path relative to `.web/assets.aye`, whether
// it gets a hashed name (`public/` files do), and the hex SHA-256 of its
// content.
struct Entry {
    url: []u8
    embed: []u8
    hashed: bool
    sha: []u8
}

/// The source of `.web/assets.aye` for the app `app` whose build root is
/// `out`. Needs `out/client/` to be built already.
pub fn assetsSource(alloc: Allocator, app: []u8, out: []u8) AssetsError![]u8 {
    var entries = List(Entry).init(alloc)
    let files = try path.join(alloc, app, "public")
    if fs.exists(files) {
        try walk(alloc, files, "", &mut entries)
    }
    let client = try path.join(alloc, out, "client")
    if fs.exists(client) {
        let found = try fs.readDir(alloc, client)
        defer found.deinit()
        for e in found.items {
            if e.kind != fs.Kind.File || !text.endsWith(e.name, ".wasm") {
                continue
            }
            var url = Builder.init(alloc)
            try url.append("/_web/islands/")
            try url.append(e.name)
            var embed = Builder.init(alloc)
            try embed.append("client/")
            try embed.append(e.name)
            try add(alloc, &mut entries, url.bytes(), embed.bytes(), false, try path.join(alloc, client, e.name))
        }
    }
    sort(entries.items())

    var b = Builder.init(alloc)
    try b.append("// Generated by `web gen --prod`; do not edit.\n//\n// The files of `public/` and the islands of `.web/client/`, embedded in the\n// executable. `hashed` is the URL of a file with the first 8 hex digits of\n// its SHA-256 in the name (the path itself for an island), `etag` the quoted\n// full hash. `web.runProd` serves the table.\n\nimport web.Asset\n\npub let table = [")
    try b.appendUint(entries.len() as u64)
    try b.append("]Asset{\n")
    for e in entries.items() {
        try b.append("    Asset { path: \"")
        try b.append(e.url)
        try b.append("\", hashed: \"")
        if e.hashed {
            try b.append(try hashedName(alloc, e.url, e.sha[0..8]))
        } else {
            try b.append(e.url)
        }
        try b.append("\", contentType: \"")
        try b.append(mimeOf(e.url))
        try b.append("\", etag: \"\\\"")
        try b.append(e.sha)
        try b.append("\\\"\", bytes: @embedFile(\"")
        try b.append(e.embed)
        try b.append("\") },\n")
    }
    try b.append("}\n")
    return b.bytes()
}

// Adds the files below `dir` (the real path; `url` is the part below
// `public/`, "" for `public/` itself) to `entries`.
fn walk(alloc: Allocator, dir: []u8, url: []u8, entries: *mut List(Entry)) AssetsError!void {
    let found = try fs.readDir(alloc, dir)
    defer found.deinit()
    for e in found.items {
        if text.startsWith(e.name, ".") {
            continue
        }
        var u = Builder.init(alloc)
        try u.append(url)
        try u.append("/")
        try u.append(e.name)
        let file = try path.join(alloc, dir, e.name)
        if e.kind == fs.Kind.Dir {
            try walk(alloc, file, u.bytes(), entries)
        } else if e.kind == fs.Kind.File {
            var embed = Builder.init(alloc)
            try embed.append("../public")
            try embed.append(u.bytes())
            try add(alloc, entries, u.bytes(), embed.bytes(), true, file)
        }
    }
}

fn add(alloc: Allocator, entries: *mut List(Entry), url: []u8, embed: []u8, hashed: bool, file: []u8) AssetsError!void {
    if text.indexOf(url, "\"") != null || text.indexOf(url, "\\") != null {
        die("the name of a file to embed has a quote or a backslash", url, "")
    }
    let content = try fs.readFile(alloc, file)
    let sum = crypto.sha256(content)
    let sha = try encoding.hexEncode(alloc, sum[..])
    try entries.append(Entry { url: url, embed: embed, hashed: hashed, sha: sha })
}

// `/img/logo.svg` and `4fe2a1b9` give `/img/logo.4fe2a1b9.svg`; a name
// without an extension gets `.4fe2a1b9` at the end.
fn hashedName(alloc: Allocator, url: []u8, short: []u8) ![]u8 {
    var dot: usize = url.len
    var i: usize = url.len
    while i > 0 {
        i -= 1
        if url[i] == '/' {
            break
        }
        if url[i] == '.' {
            dot = i
            break
        }
    }
    var b = Builder.init(alloc)
    try b.append(url[0..dot])
    try b.append(".")
    try b.append(short)
    try b.append(url[dot..url.len])
    return b.bytes()
}

// Insertion sort by URL, so that the file does not depend on the order of
// the directory.
fn sort(entries: []mut Entry) {
    var i: usize = 1
    while i < entries.len {
        var j = i
        while j > 0 && less(entries[j].url, entries[j - 1].url) {
            let t = entries[j]
            entries[j] = entries[j - 1]
            entries[j - 1] = t
            j -= 1
        }
        i += 1
    }
}

fn less(a: []u8, b: []u8) bool {
    var i: usize = 0
    while i < a.len && i < b.len {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
        i += 1
    }
    return a.len < b.len
}

// The `Content-Type` for the extension of `name` (the types of
// `web.mimeOf`).
fn mimeOf(name: []u8) []u8 {
    var dot: usize = name.len
    var i: usize = name.len
    while i > 0 {
        i -= 1
        if name[i] == '/' {
            break
        }
        if name[i] == '.' {
            dot = i
            break
        }
    }
    if dot == name.len {
        return "application/octet-stream"
    }
    let ext = name[dot + 1..name.len]
    if text.eqlIgnoreCase(ext, "html") {
        return "text/html; charset=utf-8"
    }
    if text.eqlIgnoreCase(ext, "css") {
        return "text/css; charset=utf-8"
    }
    if text.eqlIgnoreCase(ext, "js") {
        return "text/javascript; charset=utf-8"
    }
    if text.eqlIgnoreCase(ext, "json") {
        return "application/json"
    }
    if text.eqlIgnoreCase(ext, "png") {
        return "image/png"
    }
    if text.eqlIgnoreCase(ext, "jpg") {
        return "image/jpeg"
    }
    if text.eqlIgnoreCase(ext, "svg") {
        return "image/svg+xml"
    }
    if text.eqlIgnoreCase(ext, "ico") {
        return "image/x-icon"
    }
    if text.eqlIgnoreCase(ext, "txt") {
        return "text/plain; charset=utf-8"
    }
    if text.eqlIgnoreCase(ext, "woff2") {
        return "font/woff2"
    }
    if text.eqlIgnoreCase(ext, "wasm") {
        return "application/wasm"
    }
    return "application/octet-stream"
}
