// `web gen`: reads the pages of an app and writes its build root, `.web/`.
//
//     aye run framework/gen -- <app> [--web <dir>] [--prod]
//
// `<app>/app/` holds the routes as in Next.js: a directory with a `page.aye`
// serves its path with `page`; one with a `route.aye` serves it with the
// functions `get`, `post`, `put`, `patch` and `delete` that the file exports
// (a method without one gets 405). `[name]` is one dynamic segment
// (`req.param("name")`), `[...name]` the last one or more segments joined by
// `/` (nothing may be below it), and `(group)` adds no segment to the path
// (a `layout.aye` in it still wraps what is below it). Segments are
// percent-decoded after the path is split. A path that no route has is looked up in
// `<app>/public/`; `main.aye` passes the absolute path of that directory to
// `web.run` (a link would depend on the working directory).
// `<app>/islands/<name>/` with a `client.aye` is an island (FD6): `gen` builds
// it with `aye build --target wasm32-freestanding` into
// `.web/client/<name>.wasm` (`aye` as below) and `main.aye` passes the
// absolute path of `.web/client/` to `web.runClient`, which serves the files
// at `/_web/islands/<name>.wasm`. A failing build ends `gen` with the
// compiler's text. On a machine without a wasm32 clang (`AYE_WASI_CLANG`, or
// Homebrew's `llvm`) `gen` prints one warning and builds no island.
// A `layout.aye` (`pub fn layout`) wraps every page below its directory, the
// innermost layout first (`web.wrap`); API routes are never wrapped. A
// `not-found.aye` in `app/` (`pub fn notFound`) is the page, with status 404
// and the root layout, of a path that nothing answers (`web.runApp`) and of
// a `page` that returns `Error.NotFound` (the generated wrapper of the page
// catches it). An error of a `route.aye` handler is answered as JSON
// (`Kind.Api` in the route table, see `web.Route`). What the files export is
// read with `aye doc --signatures`: set `AYE` to the `aye` program if it is
// not on `PATH`.
// `.web/` gets a `main.aye`, a `routes/` module with the route table, a link
// `r/r<i>_<name>` to each route's directory, a link to every other directory
// of the app except `public/` (`lib`), and `web`, a link to the web module
// (`--web`, `framework/web` by default). `aye check .web` and `aye build
// .web` then work. Everything in `.web/` is replaced on each run.
// With `--prod` `gen` also writes `.web/assets.aye` (`assets.aye` of `gen`):
// the files of `public/` and of `.web/client/` as `@embedFile` constants in
// a table (`table`, `lookup`; the file is a module of `.web/` with
// `main.aye`, so no import). The server does not serve the table yet (that
// is F5.2, `web.runProd`); until then `main.aye` is the same as without
// `--prod`.

import std.fs
import std.fs.ReadDirError
import std.heap.Arena
import std.heap.General
import std.list.List
import std.mem.Allocator
import std.os
import std.path
import std.process
import std.process.Stdio
import std.text
import std.text.Builder

extern fn getcwd(buf: [*]u8, size: usize) ?[*]u8
extern fn strlen(s: [*]u8) usize

pub fn main() !void {
    var gpa = General.init()
    defer gpa.deinit()
    var arena = Arena.init(gpa.allocator())
    defer arena.deinit()
    let alloc = arena.allocator()

    let args = try os.args(alloc)
    var app: []u8 = ""
    var web: []u8 = "framework/web"
    var prod = false
    var i: usize = 1
    while i < args.len {
        if text.eql(args[i], "--web") && i + 1 < args.len {
            web = args[i + 1]
            i += 2
        } else if text.eql(args[i], "--prod") {
            prod = true
            i += 1
        } else if app.len == 0 {
            app = args[i]
            i += 1
        } else {
            die("usage: gen <app> [--web <dir>] [--prod]", args[i], "")
        }
    }
    if app.len == 0 {
        die("usage: gen <app> [--web <dir>] [--prod]", "", "")
    }
    let root = try path.join(alloc, app, "app")
    if !fs.exists(root) {
        die("no such directory", root, "")
    }
    if !fs.exists(web) {
        die("no such web module", web, "")
    }

    var pages = List(Page).init(alloc)
    try scan(alloc, root, "", &mut pages)
    order(pages.items())
    checkClashes(pages.items())

    let out = try path.join(alloc, app, ".web")
    if fs.exists(out) {
        try clean(alloc, out)
    }
    try fs.mkdir(out)
    try fs.mkdir(try path.join(alloc, out, "r"))
    try fs.mkdir(try path.join(alloc, out, "routes"))

    var names = List([]u8).init(alloc)
    for n in 0..pages.len() {
        let page = pages.items()[n]
        let name = try linkName(alloc, n, page.dir)
        try names.append(name)
        var target = Builder.init(alloc)
        try target.append("../../app")
        if page.dir.len > 0 {
            try target.append("/")
            try target.append(page.dir)
        }
        try fs.symlink(target.bytes(), try path.join(alloc, try path.join(alloc, out, "r"), name))
    }
    try linkOthers(alloc, app, out)
    try fs.symlink(try absolute(alloc, web), try path.join(alloc, out, "web"))
    let islands = try buildIslands(alloc, app, out)

    try put(alloc, try path.join(alloc, out, "main.aye"), try mainSource(alloc, try publicDir(alloc, app), islands.dir, hasNotFound(pages.items())))
    if prod {
        try put(alloc, try path.join(alloc, out, "assets.aye"), try assetsSource(alloc, app, out))
    }
    try put(alloc, try path.join(alloc, try path.join(alloc, out, "routes"), "routes.aye"), try routesSource(alloc, pages.items(), names.items()))

    var line = Builder.init(alloc)
    try line.append("web gen: ")
    try line.append(out)
    try line.append(", ")
    try line.appendUint(routeCount(pages.items()) as u64)
    try line.append(" routes")
    if islands.count > 0 {
        try line.append(", ")
        try line.appendUint(islands.count as u64)
        try line.append(" islands")
    }
    try line.append("\n")
    try fs.stdout().write(line.bytes())
}

// `.web/<dir>` links to the app's own code directories, so that a page can
// `import lib.posts`.
fn linkOthers(alloc: Allocator, app: []u8, out: []u8) !void {
    let found = try fs.readDir(alloc, app)
    defer found.deinit()
    for e in found.items {
        if e.kind != fs.Kind.Dir || text.startsWith(e.name, ".") {
            continue
        }
        if text.eql(e.name, "app") || text.eql(e.name, "public") {
            continue
        }
        if text.eql(e.name, "r") || text.eql(e.name, "routes") || text.eql(e.name, "web") {
            die("the name is used by .web", e.name, "")
        }
        var target = Builder.init(alloc)
        try target.append("../")
        try target.append(e.name)
        try fs.symlink(target.bytes(), try path.join(alloc, out, e.name))
    }
}

// Removes `dir` and everything in it. A link is removed, not followed.
fn clean(alloc: Allocator, dir: []u8) ReadDirError!void {
    let found = try fs.readDir(alloc, dir)
    defer found.deinit()
    for e in found.items {
        let p = try path.join(alloc, dir, e.name)
        if e.kind == fs.Kind.Dir {
            try clean(alloc, p)
        } else {
            try fs.remove(p)
        }
    }
    try fs.remove(dir)
}

// `p` as an absolute path: a link to it must not depend on where it sits.
fn absolute(alloc: Allocator, p: []u8) ![]u8 {
    if p.len > 0 && p[0] == '/' {
        return p
    }
    var buf = try alloc.alloc(0 as u8, 4096)
    let cwd = getcwd(buf.ptr, buf.len) orelse {
        die("cannot read the current directory", "", "")
        return p
    }
    return path.join(alloc, cwd[0..strlen(cwd)], p)
}

// The absolute path of the app's `public/`, written into `main.aye` (the
// server may run from any directory, so a link in `.web/` would not do), or
// "" when the app has none.
fn publicDir(alloc: Allocator, app: []u8) ![]u8 {
    let dir = try path.join(alloc, app, "public")
    if !fs.exists(dir) {
        return ""
    }
    let abs = try absolute(alloc, dir)
    if text.indexOf(abs, "\"") != null || text.indexOf(abs, "\\") != null {
        die("the path of public/ has a quote or a backslash", abs, "")
    }
    return abs
}

// What `buildIslands` made: the absolute path of `.web/client/` ("" when
// nothing was built) and the number of islands in it.
struct Islands {
    dir: []u8
    count: usize
}

// Builds `<app>/islands/<name>/client.aye` of every island into
// `<out>/client/<name>.wasm`. Without a wasm32 toolchain it prints one
// warning and builds none.
fn buildIslands(alloc: Allocator, app: []u8, out: []u8) !Islands {
    let none = Islands { dir: "", count: 0 }
    let dir = try path.join(alloc, app, "islands")
    if !fs.exists(dir) {
        return none
    }
    let found = try fs.readDir(alloc, dir)
    defer found.deinit()
    let client = try path.join(alloc, out, "client")
    var count: usize = 0
    for e in found.items {
        if e.kind != fs.Kind.Dir || text.startsWith(e.name, ".") {
            continue
        }
        let island = try path.join(alloc, dir, e.name)
        if !fs.exists(try path.join(alloc, island, "client.aye")) {
            continue
        }
        if count == 0 {
            try fs.mkdir(client)
        }
        var file = Builder.init(alloc)
        try file.append(e.name)
        try file.append(".wasm")
        if !buildIsland(alloc, island, try path.join(alloc, client, file.bytes())) {
            fs.stderr().write("web gen: warning: no wasm32 toolchain (set AYE_WASI_CLANG, or `brew install llvm`); the islands are not built\n") catch |err| {}
            try clean(alloc, client)
            return none
        }
        count += 1
    }
    if count == 0 {
        return none
    }
    let abs = try absolute(alloc, client)
    if text.indexOf(abs, "\"") != null || text.indexOf(abs, "\\") != null {
        die("the path of .web/client/ has a quote or a backslash", abs, "")
    }
    return Islands { dir: abs, count: count }
}

// Runs `aye build --target wasm32-freestanding <island> -o <wasm>` (`aye` is
// `$AYE`, else the one on `PATH`). False when the build failed because this
// machine has no wasm32 clang (clang's text for a missing backend, or aye not
// finding clang); any other failure ends `gen` with the text of aye.
fn buildIsland(alloc: Allocator, island: []u8, wasm: []u8) bool {
    var bin: []u8 = "aye"
    if os.getenv("AYE") |p| {
        bin = p
    }
    let argv = [7][]u8{bin, "build", "--target", "wasm32-freestanding", island, "-o", wasm}
    var child = process.spawn(alloc, argv[..], Stdio.Inherit, Stdio.Inherit, Stdio.Pipe) catch |err| {
        die("cannot run aye (set AYE to its path)", bin, "")
        return false
    }
    let msg = child.stderr.?.readAll(alloc) catch |err| {
        die("cannot read the output of aye build", island, "")
        return false
    }
    child.stderr.?.close()
    let status = child.wait() catch |err| {
        die("cannot wait for aye build", island, "")
        return false
    }
    if status.success() {
        return true
    }
    if text.indexOf(msg, "No available targets are compatible") != null || text.indexOf(msg, "failed to run clang") != null {
        return false
    }
    die("building the island failed", island, msg)
    return false
}

fn put(alloc: Allocator, file: []u8, content: []u8) !void {
    let f = try fs.create(file)
    defer f.close()
    try f.write(content)
}

fn mainSource(alloc: Allocator, public: []u8, client: []u8, notFound: bool) ![]u8 {
    var b = Builder.init(alloc)
    try b.append("// Generated by `web gen`; do not edit.\n\nimport std.heap.General\nimport routes\nimport web\n\npub fn main() !void {\n    var gpa = General.init()\n    defer gpa.deinit()\n    let alloc = gpa.allocator()\n    try web.")
    if client.len > 0 {
        try b.append("runClient")
    } else if notFound {
        try b.append("runApp")
    } else {
        try b.append("run")
    }
    try b.append("(alloc, web.portArg(alloc, 8080), routes.table[..], \"")
    try b.append(public)
    if client.len > 0 {
        try b.append("\", \"")
        try b.append(client)
        if notFound {
            try b.append("\", routes.notFound")
        } else {
            try b.append("\", null")
        }
    } else if notFound {
        try b.append("\", routes.notFound")
    } else {
        try b.append("\"")
    }
    try b.append(")\n}\n")
    return b.bytes()
}

// The calls that wrap the page of the directory `dir` in its layouts, as the
// lines of a function body: innermost first.
fn wrapCalls(alloc: Allocator, pages: []Page, names: [][]u8, dir: []u8) ![]u8 {
    var b = Builder.init(alloc)
    for l in try layouts(alloc, pages, dir) {
        try b.append("    try web.wrap(req, res, ")
        try b.append(names[l])
        try b.append(".layout)\n")
    }
    return b.bytes()
}

fn routesSource(alloc: Allocator, pages: []Page, names: [][]u8) ![]u8 {
    var b = Builder.init(alloc)
    try b.append("// Generated by `web gen`; do not edit.\n\n")
    for n in names {
        try b.append("import r.")
        try b.append(n)
        try b.append("\n")
    }
    try b.append("import web\nimport web.Kind\nimport web.Method\nimport web.Route\n\n")
    // A page with layouts, or in an app with a `not-found.aye`, is served
    // through a function that renders it, then wraps the result in each
    // layout, innermost first. `Error.NotFound` from the page is answered
    // with `notFound` instead. API routes are never wrapped.
    let notFound = hasNotFound(pages)
    for i in 0..pages.len {
        if wrapped(alloc, pages, i, "page", notFound) {
            try b.append("fn page")
            try b.appendUint(i as u64)
            try b.append("(req: *web.Request, res: *mut web.Response) web.Error!void {\n")
            if notFound {
                try b.append("    ")
                try b.append(names[i])
                try b.append(".page(req, res) catch |e| {\n        if e != web.Error.NotFound {\n            return e\n        }\n        res.status = 404\n        res.headers.clear()\n        res.page.buf.clear()\n        try notFound(req, res)\n        return\n    }\n")
            } else {
                try b.append("    try ")
                try b.append(names[i])
                try b.append(".page(req, res)\n")
            }
            try b.append(try wrapCalls(alloc, pages, names, pages[i].dir))
            try b.append("}\n\n")
        }
        if pages[i].notFound {
            try b.append("pub fn notFound(req: *web.Request, res: *mut web.Response) web.Error!void {\n    try ")
            try b.append(names[i])
            try b.append(".notFound(req, res.html())\n")
            try b.append(try wrapCalls(alloc, pages, names, pages[i].dir))
            try b.append("}\n\n")
        }
    }
    try b.append("pub let table = [")
    try b.appendUint(routeCount(pages) as u64)
    try b.append("]Route{\n")
    for i in 0..pages.len {
        for f in pages[i].fns {
            try b.append("    Route { method: Method.")
            try b.append(methodName(f))
            try b.append(", pattern: \"")
            try b.append(pages[i].url)
            try b.append("\", handler: ")
            if wrapped(alloc, pages, i, f, notFound) {
                try b.append("page")
                try b.appendUint(i as u64)
            } else {
                try b.append(names[i])
                try b.append(".")
                try b.append(f)
            }
            if text.eql(f, "page") {
                try b.append(", kind: Kind.Page },\n")
            } else {
                try b.append(", kind: Kind.Api },\n")
            }
        }
    }
    try b.append("}\n")
    return b.bytes()
}

fn hasNotFound(pages: []Page) bool {
    for p in pages {
        if p.notFound {
            return true
        }
    }
    return false
}

// Does `pages[i]` have a `page` (and `f` is that name) that needs a wrapper:
// with at least one layout around it, or in an app with a `not-found.aye`
// (`notFound`)?
fn wrapped(alloc: Allocator, pages: []Page, i: usize, f: []u8, notFound: bool) bool {
    if !text.eql(f, "page") {
        return false
    }
    var hasPage = false
    for g in pages[i].fns {
        if text.eql(g, "page") {
            hasPage = true
        }
    }
    if !hasPage {
        return false
    }
    if notFound {
        return true
    }
    let found = layouts(alloc, pages, pages[i].dir) catch |e| {
        die("out of memory", "", "")
        return false
    }
    return found.len > 0
}

// The `Method` variant a handler answers: `page` is a `get`.
fn methodName(name: []u8) []u8 {
    if text.eql(name, "post") {
        return "Post"
    }
    if text.eql(name, "put") {
        return "Put"
    }
    if text.eql(name, "patch") {
        return "Patch"
    }
    if text.eql(name, "delete") {
        return "Delete"
    }
    return "Get"
}
