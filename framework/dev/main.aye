// `web dev`: generates, checks and builds an app, runs its server and runs
// it again when the app changes.
//
//     aye run framework/dev -- <app> [--port N]
//
// It runs `web gen` on `<app>` (`aye run framework/gen -- <app> --web
// framework/web`, so run it from the root of the checkout), then `aye check
// <app>/.web` and `aye build <app>/.web -o <app>/.web/server`, and starts
// `<app>/.web/server --port N` (no `--port` when there is none here) as a
// child. The server's first line, `listening on 127.0.0.1:<port>`, is
// printed to the standard output, a thread copies the rest of its output
// there, and its standard error is this program's. Then every 250 ms the
// program reads the modification times of the `.aye` files below `<app>`
// (not `.web/` and not `public/`, see `watch.aye`). When one is added,
// removed or changed it prints `web dev: restarting (<path> changed)`, ends
// the server (SIGTERM, then waits), builds again and starts a new server on
// the same port (the one of the first `listening on` line when there was no
// `--port`). When a step fails, this program itself listens on that port
// and answers every request with status 500 and the error page of
// `diag.aye`: built from the JSON of `aye check --json` for the check step,
// and from the step's standard error text for `web gen` and `aye build`
// (the text is printed to this program's standard error too). It prints
// `web dev: serving the error page: 127.0.0.1:<port>` and goes on watching;
// the next change that builds stops this listener and starts the server on
// the same port. With no `--port` and a first build that fails, the system
// picks the port. A server that ends by itself is
// reported and not started again before a change. SIGINT or SIGTERM to this
// program ends the server and then the program (status 0); the program
// otherwise runs until it is killed. The `aye` program is `$AYE`, else the
// one on `PATH`. A SIGKILL to this program does not stop the server: signal
// the process group.

import std.fs
import std.heap.Arena
import std.heap.General
import std.http
import std.mem.Allocator
import std.os
import std.path
import std.process
import std.process.Stdio
import std.sync.Atomic
import std.text
import std.text.Builder
import std.thread
import std.time

extern fn signal(sig: i32, handler: fn(i32)) usize

/// How often the files are looked at, in milliseconds.
let pollMs: u64 = 250

/// 1 once a signal asked this program to end.
var stopped = Atomic(u32) { value: 0 }

/// 1 once the server has closed its output, that is, has ended.
var ended = Atomic(u32) { value: 0 }

/// What the thread that copies the server's output needs.
struct Copy {
    from: fs.File
}

/// A running server: the process, the thread that copies its output, that
/// thread's argument, and the first line the server printed.
struct Server {
    child: process.Child
    copier: thread.Thread
    job: []mut Copy
    line: []mut u8
}

/// What the error server of a broken build answers with.
struct Page {
    body: []u8
}

/// The error server: the listener (on the heap, as the thread has its
/// address), the page it serves and the thread that runs it.
struct Fallback {
    cell: []mut http.Server
    page: []mut Page
    runner: thread.Thread
    port: u16
}

/// What a build ended in: a running app server, or an error server, or
/// neither when even that could not be started.
struct Up {
    server: ?Server
    fallback: ?Fallback
}

/// The output of a command.
struct Ran {
    ok: bool
    out: []u8
    err: []u8
}

pub fn main() !void {
    var gpa = General.init()
    defer gpa.deinit()
    let alloc = gpa.allocator()

    let args = try os.args(alloc)
    var app: []u8 = ""
    var port: []u8 = ""
    var i: usize = 1
    while i < args.len {
        if text.eql(args[i], "--port") && i + 1 < args.len {
            port = args[i + 1]
            i += 2
        } else if app.len == 0 {
            app = args[i]
            i += 1
        } else {
            die("usage: dev <app> [--port N]", args[i])
        }
    }
    if app.len == 0 {
        die("usage: dev <app> [--port N]", "")
    }

    var bin: []u8 = "aye"
    if os.getenv("AYE") |p| {
        bin = p
    }
    let web = try path.join(alloc, app, ".web")
    let server = try path.join(alloc, web, "server")
    signal(2, onSignal)
    signal(15, onSignal)

    // Two arenas for the snapshots: the one that was last taken and the one
    // for the next look.
    var arenas = [2]Arena{Arena.init(alloc), Arena.init(alloc)}
    var cur: usize = 0
    var before = read(arenas[0].allocator(), app) orelse {
        die("cannot read", app)
        unreachable
    }
    var running: ?Server = null
    var serving: ?Fallback = null
    let first = up(alloc, bin, app, web, server, port, null)
    running = first.server
    serving = first.fallback
    port = portOf(alloc, first, port)
    while stopped.load() == 0 {
        time.sleep(pollMs)
        if running |s| {
            if ended.load() == 1 {
                stop(alloc, s)
                running = null
                note("server ended", "")
            }
        }
        let other = 1 - cur
        if read(arenas[other].allocator(), app) |now| {
            if changed(before, now) |p| {
                note("restarting", p)
                if running |s| {
                    stop(alloc, s)
                    running = null
                }
                arenas[cur].deinit()
                arenas[cur] = Arena.init(alloc)
                before = now
                cur = other
                let next = up(alloc, bin, app, web, server, port, serving)
                running = next.server
                serving = next.fallback
                port = portOf(alloc, next, port)
            } else {
                arenas[other].deinit()
                arenas[other] = Arena.init(alloc)
            }
        } else {
            arenas[other].deinit()
            arenas[other] = Arena.init(alloc)
        }
    }
    if running |s| {
        stop(alloc, s)
    }
    if serving |f| {
        stopFallback(alloc, f)
    }
    os.exit(0)
}

/// Runs when SIGINT or SIGTERM reaches this program.
fn onSignal(sig: i32) {
    stopped.store(1)
}

/// The snapshot of `app`, null when it cannot be read (a directory went
/// away while it was read; the next look finds it again).
fn read(alloc: Allocator, app: []u8) ?Snapshot {
    return snapshot(alloc, app) catch |err| {
        return null
    }
}

/// Generates, checks and builds the app. When that works, ends the error
/// server `old` (if any) and starts the app server; when a step fails, ends
/// `old` and starts an error server with the new page.
fn up(alloc: Allocator, bin: []u8, app: []u8, web: []u8, server: []u8, port: []u8, old: ?Fallback) Up {
    var arena = Arena.init(alloc)
    defer arena.deinit()
    let tmp = arena.allocator()
    let failed = failure(tmp, bin, app, web, server)
    if old |f| {
        stopFallback(alloc, f)
    }
    if failed |report| {
        return Up { server: null, fallback: serveError(alloc, port, report, app) }
    }
    return Up { server: launch(alloc, server, port), fallback: null }
}

/// Runs the three steps; null when all worked, else the text for the error
/// page: the JSON of `aye check` or the standard error of the step.
fn failure(tmp: Allocator, bin: []u8, app: []u8, web: []u8, server: []u8) ?[]u8 {
    let gen = [7][]u8{bin, "run", "framework/gen", "--", app, "--web", "framework/web"}
    var ran = capture(tmp, gen[..], "web gen", false)
    if !ran.ok {
        return ran.err
    }
    let check = [4][]u8{bin, "check", web, "--json"}
    ran = capture(tmp, check[..], "aye check", true)
    if !ran.ok {
        if ran.out.len > 0 {
            return ran.out
        }
        return ran.err
    }
    let build = [5][]u8{bin, "build", web, "-o", server}
    ran = capture(tmp, build[..], "aye build", false)
    if !ran.ok {
        return ran.err
    }
    return null
}

/// Starts the server. When the port is given and the server prints nothing
/// (it could not listen yet), tries again after 200 ms, up to 10 times.
fn launch(alloc: Allocator, server: []u8, port: []u8) Server {
    var tries: usize = 0
    while true {
        let s = start(alloc, server, port)
        if s.line.len > 0 || port.len == 0 || tries >= 10 {
            return s
        }
        stop(alloc, s)
        alloc.free(s.line)
        tries += 1
        time.sleep(200)
    }
    unreachable
}

/// The port for the next start: that of `u`'s server or error server when
/// `port` is empty.
fn portOf(alloc: Allocator, u: Up, port: []u8) []u8 {
    if u.server |s| {
        return keepPort(alloc, s, port)
    }
    if port.len == 0 {
        if u.fallback |f| {
            var digits = Builder.init(alloc)
            digits.appendUint(f.port as u64) catch |err| {}
            if digits.toOwned() |owned| {
                return owned
            } else |err| {
                return port
            }
        }
    }
    return port
}

/// The port to start the next server on: `port`, or the one in the first
/// line of `s` when `port` is empty. `s.line` is kept only for that.
fn keepPort(alloc: Allocator, s: Server, port: []u8) []u8 {
    if port.len > 0 {
        alloc.free(s.line)
        return port
    }
    var colon: usize = 0
    var found = false
    var i: usize = 0
    while i < s.line.len {
        if s.line[i] == ':' {
            colon = i
            found = true
        }
        i += 1
    }
    if !found {
        return ""
    }
    return text.trim(s.line[colon + 1..s.line.len])
}

/// Ends the server (SIGTERM), waits for it and for the thread that copies
/// its output.
fn stop(alloc: Allocator, s: Server) {
    var child = s.child
    child.kill() catch |err| {}
    let status = child.wait() catch |err| {
        process.Status { code: 0, signal: 0 }
    }
    s.copier.join()
    child.stdout.?.close()
    alloc.free(s.job)
}

/// Copies what the server writes to this program's standard output until the
/// server closes it.
fn copy(job: *mut Copy) {
    var gpa = General.init()
    defer gpa.deinit()
    let alloc = gpa.allocator()
    let buf = alloc.alloc(0 as u8, 4096) catch |err| {
        ended.store(1)
        return
    }
    defer alloc.free(buf)
    while true {
        let n = job.from.read(buf) catch |err| {
            break
        }
        if n == 0 {
            break
        }
        fs.stdout().write(buf[0..n]) catch |err| {
            break
        }
    }
    ended.store(1)
}

/// Runs `argv` with its standard error piped (and its standard output too
/// when `pipeOut`, else it is this program's). The standard error is also
/// copied to this program's, so the terminal shows it. When the command
/// fails, says so.
fn capture(tmp: Allocator, argv: [][]u8, what: []u8, pipeOut: bool) Ran {
    var outMode = Stdio.Inherit
    if pipeOut {
        outMode = Stdio.Pipe
    }
    var child = process.spawn(tmp, argv, Stdio.Inherit, outMode, Stdio.Pipe) catch |err| {
        die("cannot run", argv[0])
        unreachable
    }
    var out: []u8 = ""
    if child.stdout |f| {
        out = slurp(tmp, f)
        f.close()
    }
    let err = slurp(tmp, child.stderr.?)
    child.stderr.?.close()
    fs.stderr().write(err) catch |e| {}
    let status = child.wait() catch |e| {
        die("cannot wait for", what)
        unreachable
    }
    if status.success() {
        return Ran { ok: true, out: out, err: err }
    }
    note("failed", what)
    if out.len == 0 && err.len == 0 {
        var msg = Builder.init(tmp)
        msg.append(what) catch |e| {}
        msg.append(" failed with no output") catch |e| {}
        return Ran { ok: false, out: out, err: msg.bytes() }
    }
    return Ran { ok: false, out: out, err: err }
}

/// Everything `f` gives until it is closed; "" when it cannot be read.
fn slurp(tmp: Allocator, f: fs.File) []u8 {
    if f.readAll(tmp) |bytes| {
        return bytes
    } else |err| {
        return ""
    }
}

/// Starts the error server on `port` (the system picks one when it is
/// empty) with the page for `report`. Null when that did not work.
fn serveError(alloc: Allocator, port: []u8, report: []u8, app: []u8) ?Fallback {
    var number: u16 = 0
    if port.len > 0 {
        let n = text.parseInt(port) catch |err| {
            0
        }
        number = n as u16
    }
    let body = errorPage(alloc, report, app) catch |err| {
        note("cannot build the error page", "")
        return null
    }
    let page = alloc.alloc(Page { body: body }, 1) catch |err| {
        die("out of memory", "")
        unreachable
    }
    var tries: usize = 0
    while true {
        if http.listen(Page, "127.0.0.1", number, &mut page[0], answer) |srv| {
            let cell = alloc.alloc(srv, 1) catch |err| {
                die("out of memory", "")
                unreachable
            }
            let t = thread.spawn(http.Server, runFallback, &mut cell[0]) catch |err| {
                die("cannot start a thread", "")
                unreachable
            }
            let bound = cell[0].port()
            var addr = Builder.init(alloc)
            defer addr.deinit()
            addr.append("127.0.0.1:") catch |err| {}
            addr.appendUint(bound as u64) catch |err| {}
            note("serving the error page", addr.bytes())
            return Fallback { cell: cell, page: page, runner: t, port: bound }
        } else |err| {
            if number == 0 || tries >= 10 {
                note("cannot listen for the error page", port)
                return null
            }
            tries += 1
            time.sleep(200)
        }
    }
    unreachable
}

/// Answers every request with the error page.
fn answer(page: *mut Page, req: *http.Request, res: *mut http.Response, alloc: Allocator) {
    let hs = alloc.alloc(http.Header { name: "Content-Type", value: "text/html; charset=utf-8" }, 1) catch |err| {
        res.status = 500
        return
    }
    res.status = 500
    res.headers = hs
    res.body = page.body
}

/// Runs the error server until `stop`.
fn runFallback(srv: *mut http.Server) {
    var gpa = General.init()
    defer gpa.deinit()
    srv.run(gpa.allocator()) catch |err| {}
}

/// Ends the error server, waits for its thread and frees its page.
fn stopFallback(alloc: Allocator, f: Fallback) {
    f.cell[0].stop()
    f.runner.join()
    alloc.free(f.page[0].body)
    alloc.free(f.page)
    alloc.free(f.cell)
}

/// Starts the server with its standard output piped, prints its first line
/// and starts the thread that copies the rest.
fn start(alloc: Allocator, server: []u8, port: []u8) Server {
    var argv = [3][]u8{server, "--port", port}
    var n: usize = 3
    if port.len == 0 {
        n = 1
    }
    var child = process.spawn(alloc, argv[0..n], Stdio.Inherit, Stdio.Pipe, Stdio.Inherit) catch |err| {
        die("cannot start the server", server)
        unreachable
    }
    let out = child.stdout.?
    // The first line, a byte at a time, so that nothing after it is taken.
    var line = Builder.init(alloc)
    defer line.deinit()
    var byte = [1]u8{0}
    while true {
        let got = out.read(byte[..]) catch |err| {
            break
        }
        if got == 0 {
            break
        }
        line.appendByte(byte[0]) catch |err| {
            break
        }
        if byte[0] == '\n' {
            break
        }
    }
    fs.stdout().write(line.bytes()) catch |err| {}
    ended.store(0)
    let job = alloc.alloc(Copy { from: out }, 1) catch |err| {
        die("out of memory", "")
        unreachable
    }
    let t = thread.spawn(Copy, copy, &mut job[0]) catch |err| {
        die("cannot start a thread", "")
        unreachable
    }
    let owned = line.toOwned() catch |err| {
        die("out of memory", "")
        unreachable
    }
    return Server { child: child, copier: t, job: job, line: owned }
}

/// Prints `web dev: <what> (<a> changed)`, or just `web dev: <what>` and, for
/// a failed step, `: <a>`.
fn note(what: []u8, a: []u8) {
    fs.stdout().write("web dev: ") catch |e| {}
    fs.stdout().write(what) catch |e| {}
    if a.len > 0 {
        if text.eql(what, "restarting") {
            fs.stdout().write(" (") catch |e| {}
            fs.stdout().write(a) catch |e| {}
            fs.stdout().write(" changed)") catch |e| {}
        } else {
            fs.stdout().write(": ") catch |e| {}
            fs.stdout().write(a) catch |e| {}
        }
    }
    fs.stdout().write("\n") catch |e| {}
}

fn die(what: []u8, a: []u8) {
    fs.stderr().write("web dev: ") catch |e| {}
    fs.stderr().write(what) catch |e| {}
    if a.len > 0 {
        fs.stderr().write(": ") catch |e| {}
        fs.stderr().write(a) catch |e| {}
    }
    fs.stderr().write("\n") catch |e| {}
    os.exit(1)
}
