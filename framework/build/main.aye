// `web build`: one command from an app to one executable.
//
//     aye run framework/build -- <app> [-o <exe>] [--mode fast]
//
// It runs `web gen --prod` on `<app>` (`aye run framework/gen -- <app> --web
// framework/web --prod`, so run it from the root of the checkout), then `aye
// check <app>/.web`, then `aye build <app>/.web --no-link libcurl -o <exe>`.
// `--mode fast` is passed on to `aye build` (an optimized build, as the
// benchmarks in `docs/aye-bench.md` use); without it the build is the default
// one. `<exe>` is `<app>/<name>` by default: `name` of `<app>/aye.toml` when it
// has one, else the name of the app's directory. The executable holds the
// pages and the files of `public/` (and the islands' `.wasm` files), so it
// runs without the app tree and without the Aye toolchain. It is built
// without libcurl: the server makes no HTTPS client calls, and an app that
// calls `std.http.get` on an `https://` URL gets the client's own error.
// When it worked, the program prints `web build: <exe> (<n> bytes)` and ends
// with status 0. When a step fails, the text of the step is on the standard
// error, `web build: <step> failed` follows, and the status is 1. `.web/`
// stays for debugging. The `aye` program is `$AYE`, else the one on `PATH`.

import std.fs
import std.heap.Arena
import std.heap.General
import std.mem.Allocator
import std.os
import std.path
import std.process
import std.process.Stdio
import std.text
import std.text.Builder

extern fn getcwd(buf: [*]u8, size: usize) ?[*]u8
extern fn strlen(s: [*]u8) usize

pub fn main() !void {
    var gpa = General.init()
    defer gpa.deinit()
    let alloc = gpa.allocator()
    var arena = Arena.init(alloc)
    defer arena.deinit()
    let tmp = arena.allocator()

    let args = try os.args(tmp)
    var app: []u8 = ""
    var exe: []u8 = ""
    var fast = false
    var i: usize = 1
    while i < args.len {
        if text.eql(args[i], "--mode") && i + 1 < args.len {
            if !text.eql(args[i + 1], "fast") {
                die("only --mode fast is supported", args[i + 1])
            }
            fast = true
            i += 2
        } else if text.eql(args[i], "-o") && i + 1 < args.len {
            exe = args[i + 1]
            i += 2
        } else if app.len == 0 {
            app = args[i]
            i += 1
        } else {
            die("usage: build <app> [-o <exe>] [--mode fast]", args[i])
        }
    }
    if app.len == 0 {
        die("usage: build <app> [-o <exe>] [--mode fast]", "")
    }
    if !fs.exists(app) {
        die("cannot read", app)
    }

    var bin: []u8 = "aye"
    if os.getenv("AYE") |p| {
        bin = p
    }
    let web = try path.join(tmp, app, ".web")
    if exe.len == 0 {
        exe = try path.join(tmp, app, try appName(tmp, app))
    }

    let gen = [8][]u8{bin, "run", "framework/gen", "--", app, "--web", "framework/web", "--prod"}
    run(tmp, gen[..], "web gen")
    let check = [3][]u8{bin, "check", web}
    run(tmp, check[..], "aye check")
    if fast {
        let build = [9][]u8{bin, "build", "--mode", "fast", web, "--no-link", "libcurl", "-o", exe}
        run(tmp, build[..], "aye build")
    } else {
        let build = [7][]u8{bin, "build", web, "--no-link", "libcurl", "-o", exe}
        run(tmp, build[..], "aye build")
    }

    let st = fs.stat(exe) catch |err| {
        die("cannot read", exe)
        unreachable
    }
    var line = Builder.init(tmp)
    try line.append("web build: ")
    try line.append(exe)
    try line.append(" (")
    try line.appendUint(st.size)
    try line.append(" bytes)\n")
    fs.stdout().write(line.bytes()) catch |e| {}
}

/// The name of the executable: `name` in `<app>/aye.toml`, else the name of
/// the app's directory.
fn appName(tmp: Allocator, app: []u8) ![]u8 {
    let toml = try path.join(tmp, app, "aye.toml")
    if fs.readFile(tmp, toml) |src| {
        var lines = text.split(src, "\n")
        while lines.next() |raw| {
            let line = text.trim(raw)
            if !text.startsWith(line, "name") {
                continue
            }
            let rest = text.trim(line[4..])
            if rest.len < 2 || rest[0] != '=' {
                continue
            }
            let value = text.trim(rest[1..])
            if value.len >= 2 && value[0] == '"' && value[value.len - 1] == '"' {
                return value[1..value.len - 1]
            }
        }
    } else |err| {}
    let name = path.basename(try absolute(tmp, app))
    if name.len == 0 {
        die("cannot name the executable, use -o", app)
    }
    return name
}

// `p` as an absolute path, for its last name.
fn absolute(alloc: Allocator, p: []u8) ![]u8 {
    if p.len > 0 && p[0] == '/' {
        return p
    }
    var buf = try alloc.alloc(0 as u8, 4096)
    let cwd = getcwd(buf.ptr, buf.len) orelse {
        die("cannot read the current directory", "")
        return p
    }
    return path.join(alloc, cwd[0..strlen(cwd)], p)
}

/// Runs `argv` with its standard output and input this program's and its
/// standard error piped and copied to this program's. A command that fails
/// ends this program with status 1.
fn run(tmp: Allocator, argv: [][]u8, what: []u8) {
    var child = process.spawn(tmp, argv, Stdio.Inherit, Stdio.Inherit, Stdio.Pipe) catch |err| {
        die("cannot run", argv[0])
        unreachable
    }
    var err: []u8 = ""
    if child.stderr |f| {
        if f.readAll(tmp) |bytes| {
            err = bytes
        } else |e| {}
        f.close()
    }
    fs.stderr().write(err) catch |e| {}
    let status = child.wait() catch |e| {
        die("cannot wait for", what)
        unreachable
    }
    if !status.success() {
        die("failed", what)
    }
}

fn die(what: []u8, a: []u8) {
    fs.stderr().write("web build: ") catch |e| {}
    if text.eql(what, "failed") {
        fs.stderr().write(a) catch |e| {}
        fs.stderr().write(" failed\n") catch |e| {}
        os.exit(1)
    }
    fs.stderr().write(what) catch |e| {}
    if a.len > 0 {
        fs.stderr().write(": ") catch |e| {}
        fs.stderr().write(a) catch |e| {}
    }
    fs.stderr().write("\n") catch |e| {}
    os.exit(1)
}
