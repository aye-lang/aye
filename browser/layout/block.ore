// Block formatting: widths (CSS 2.1 10.3.3: auto widths fill the
// containing block, auto margins center, min/max widths, box-sizing),
// heights (10.6.3: auto heights hold the content; percentages of a
// definite containing block), vertical margin collapsing between
// siblings, between a box and its first or last child, and through empty
// boxes; `aspect-ratio`; replaced elements; relative positioning;
// absolute positions.

import css
import css.Value
import std.list.List
import std.math
import std.mem.AllocError
import std.text

// ---- edges

/// Sets the borders and paddings of box `i` (percentages of `cb_w`) and
/// its vertical margins (auto margins are 0).
fn resolveEdges(t: *mut Tree, i: usize, cb_w: f64) {
    let b = t.bx(i)
    let s = b.style
    for side in 0..4 {
        b.padding[side] = lengthOr0(s[css.PADDING_TOP + side], cb_w)
        b.border[side] = lengthOr0(s[css.BORDER_TOP_WIDTH + side], cb_w)
    }
    b.margin[0] = lengthOr0(s[css.MARGIN_TOP], cb_w)
    b.margin[2] = lengthOr0(s[css.MARGIN_TOP + 2], cb_w)
}

fn hEdges(b: *Box) f64 {
    return b.padding[1] + b.padding[3] + b.border[1] + b.border[3]
}

fn vEdges(b: *Box) f64 {
    return b.padding[0] + b.padding[2] + b.border[0] + b.border[2]
}

fn borderBoxSizing(style: []Value) bool {
    return isKeyword(style[css.BOX_SIZING], "border-box")
}

// A border-box size from the value `v` of width/height/min/max (`edges`:
// the box's padding and borders in that direction); null for `auto`,
// `none` and percentages of an unknown base.
fn sizeOf(style: []Value, v: Value, base: f64, edges: f64) ?f64 {
    if lengthOf(v, base) |n| {
        if borderBoxSizing(style) {
            return math.max(n, edges)
        }
        return n + edges
    }
    return null
}

// `w` (a border-box width) within min-width and max-width.
fn clampWidth(t: *Tree, i: usize, w: f64, cb_w: f64) f64 {
    let b = t.bx(i)
    let e = hEdges(b)
    var r = w
    if sizeOf(b.style, b.style[css.MAX_WIDTH], cb_w, e) |mx| {
        r = math.min(r, mx)
    }
    if sizeOf(b.style, b.style[css.MIN_WIDTH], cb_w, e) |mn| {
        r = math.max(r, mn)
    }
    return math.max(r, e)
}

fn clampHeight(t: *Tree, i: usize, h: f64, cb_h: f64) f64 {
    let b = t.bx(i)
    let e = vEdges(b)
    var r = h
    if sizeOf(b.style, b.style[css.MAX_HEIGHT], cb_h, e) |mx| {
        r = math.min(r, mx)
    }
    if sizeOf(b.style, b.style[css.MIN_HEIGHT], cb_h, e) |mn| {
        r = math.max(r, mn)
    }
    return math.max(r, e)
}

/// The border-box width of box `i` from its `width` property, within
/// min/max; null for `auto`.
fn specifiedWidth(t: *Tree, i: usize, cb_w: f64) ?f64 {
    let b = t.bx(i)
    if sizeOf(b.style, b.style[css.WIDTH], cb_w, hEdges(b)) |w| {
        return clampWidth(t, i, w, cb_w)
    }
    return null
}

// The content height of box `i` when its `height` makes it definite;
// -1 when not.
fn definiteContentHeight(t: *Tree, i: usize, cb_h: f64) f64 {
    let b = t.bx(i)
    if b.forced_h >= 0.0 {
        return math.max(0.0, b.forced_h - vEdges(b))
    }
    if sizeOf(b.style, b.style[css.HEIGHT], cb_h, vEdges(b)) |h| {
        return clampHeight(t, i, h, cb_h) - vEdges(b)
    }
    return -1.0
}

// Sets the horizontal margins of box `i` (border box `w` wide) in a
// containing block `cb_w` wide: auto margins share the free space.
fn horizontalMargins(t: *mut Tree, i: usize, cb_w: f64) {
    let b = t.bx(i)
    let s = b.style
    let left_auto = isKeyword(s[css.MARGIN_TOP + 3], "auto")
    let right_auto = isKeyword(s[css.MARGIN_TOP + 1], "auto")
    b.margin[3] = lengthOr0(s[css.MARGIN_TOP + 3], cb_w)
    b.margin[1] = lengthOr0(s[css.MARGIN_TOP + 1], cb_w)
    let free = cb_w - b.w - b.margin[1] - b.margin[3]
    if left_auto && right_auto {
        b.margin[3] = math.max(0.0, (cb_w - b.w) / 2.0)
        b.margin[1] = b.margin[3]
    } else if left_auto {
        b.margin[3] = math.max(0.0, free)
    } else if right_auto {
        b.margin[1] = math.max(0.0, free)
    }
}

/// The offsets of `position: relative` of box `i`.
fn relOffsets(t: *mut Tree, i: usize, cb_w: f64, cb_h: f64) {
    let b = t.bx(i)
    let s = b.style
    b.rel_x = 0.0
    b.rel_y = 0.0
    if !isKeyword(s[css.POSITION], "relative") {
        return
    }
    if lengthOf(s[css.INSET_TOP + 3], cb_w) |left| {
        b.rel_x = left
    } else if lengthOf(s[css.INSET_TOP + 1], cb_w) |right| {
        b.rel_x = -right
    }
    if lengthOf(s[css.INSET_TOP], cb_h) |top| {
        b.rel_y = top
    } else if lengthOf(s[css.INSET_TOP + 2], cb_h) |bottom| {
        b.rel_y = -bottom
    }
}

// ---- boxes

fn layoutRoot(t: *mut Tree, r: usize) AllocError!void {
    try layoutBlockLevel(t, r, t.viewport_w, t.viewport_h)
    let b = t.bx(r)
    b.x = b.margin[3]
    b.y = b.margin[0]
}

// Does box `i` establish a block formatting context (so that its
// margins do not collapse with its children's)?
fn isFormattingRoot(t: *Tree, i: usize) bool {
    let b = t.bx(i)
    if b.parent |p| {
        let pk = t.bx(p).kind
        if pk == BoxKind.Flex || pk == BoxKind.Grid || pk == BoxKind.Table {
            return true
        }
    } else {
        return true
    }
    if b.oof() {
        return true
    }
    if b.kind != BoxKind.Block && b.kind != BoxKind.Anonymous {
        return true
    }
    return !isKeyword(b.style[css.OVERFLOW_X], "visible") || !isKeyword(b.style[css.OVERFLOW_Y], "visible") || isKeyword(b.style[css.DISPLAY], "flow-root")
}

/// Lays out the block-level box `i` in a containing block `cb_w` wide
/// (and `cb_h` high, or -1): its size, margins and content; its parent
/// sets its position.
fn layoutBlockLevel(t: *mut Tree, i: usize, cb_w: f64, cb_h: f64) AllocError!void {
    let kind = t.bx(i).kind
    resolveEdges(t, i, cb_w)
    if kind == BoxKind.Table {
        try layoutTable(t, i, cb_w)
        horizontalMargins(t, i, cb_w)
    } else if kind == BoxKind.Image {
        replacedSize(t, i, cb_w, cb_h)
        horizontalMargins(t, i, cb_w)
    } else {
        let b = t.bx(i)
        b.margin[3] = lengthOr0(b.style[css.MARGIN_TOP + 3], cb_w)
        b.margin[1] = lengthOr0(b.style[css.MARGIN_TOP + 1], cb_w)
        if specifiedWidth(t, i, cb_w) |w| {
            b.w = w
        } else {
            b.w = clampWidth(t, i, cb_w - b.margin[1] - b.margin[3], cb_w)
        }
        horizontalMargins(t, i, cb_w)
        try layoutContents(t, i, cb_h)
    }
    let b = t.bx(i)
    if kind == BoxKind.Table || kind == BoxKind.Image {
        b.top_strut = Strut.of(b.margin[0])
        b.bottom_strut = Strut.of(b.margin[2])
        b.through = false
    }
    relOffsets(t, i, cb_w, cb_h)
}

/// Lays out an atomic inline (inline-block, image, inline table or
/// flex) in a line `avail` px wide: shrink-to-fit width, auto margins 0.
fn layoutAtomic(t: *mut Tree, i: usize, avail: f64) AllocError!void {
    let kind = t.bx(i).kind
    resolveEdges(t, i, avail)
    let b = t.bx(i)
    b.margin[3] = lengthOr0(b.style[css.MARGIN_TOP + 3], avail)
    b.margin[1] = lengthOr0(b.style[css.MARGIN_TOP + 1], avail)
    if kind == BoxKind.Image {
        replacedSize(t, i, avail, -1.0)
    } else if kind == BoxKind.Table {
        try layoutTable(t, i, avail)
    } else {
        try shrinkToFit(t, i, avail)
        try layoutContents(t, i, -1.0)
    }
    relOffsets(t, i, avail, -1.0)
}

// Sets the width of box `i` (margins and edges resolved) to its
// specified width, or else to its shrink-to-fit width in `avail` px.
fn shrinkToFit(t: *mut Tree, i: usize, avail: f64) AllocError!void {
    if specifiedWidth(t, i, avail) |w| {
        t.bx(i).w = w
        return
    }
    if controlContentWidth(t, i) |cw| {
        t.bx(i).w = clampWidth(t, i, cw + hEdges(t.bx(i)), avail)
        return
    }
    let mm = try intrinsic(t, i)
    let b = t.bx(i)
    let room = avail - b.margin[1] - b.margin[3]
    t.bx(i).w = clampWidth(t, i, math.min(math.max(mm.min, room), mm.max), avail)
}

// The size of a replaced element (`replacedDims`) within its min/max.
// An auto size follows the other one's clamped value by the aspect
// ratio (CSS 2.1 10.4: a clamped width first, then the height).
fn replacedSize(t: *mut Tree, i: usize, cb_w: f64, cb_h: f64) {
    let b = t.bx(i)
    let he = hEdges(b)
    let ve = vEdges(b)
    let dims = replacedDims(t, i, cb_w, cb_h, he, ve)
    var cw = clampWidth(t, i, dims.w, cb_w)
    var ch = clampHeight(t, i, dims.h, cb_h)
    let w_auto = sizeOf(b.style, b.style[css.WIDTH], cb_w, he) == null
    let h_auto = sizeOf(b.style, b.style[css.HEIGHT], cb_h, ve) == null
    if replacedRatio(t, i) |r| {
        if h_auto && cw != dims.w {
            ch = clampHeight(t, i, (cw - he) / r + ve, cb_h)
        } else if w_auto && ch != dims.h {
            cw = clampWidth(t, i, (ch - ve) * r + he, cb_w)
        }
    }
    let bb = t.bx(i)
    bb.w = cw
    bb.h = ch
    bb.first_baseline = -1.0
    bb.last_baseline = -1.0
}

// The width / height ratio of the replaced box `i`: its `aspect-ratio`,
// else its natural size's, else its `viewBox`'s; null for none.
fn replacedRatio(t: *Tree, i: usize) ?f64 {
    if aspectRatio(t, i) |r| {
        return r
    }
    if naturalSize(t, i) |n| {
        if n.w > 0.0 && n.h > 0.0 {
            return n.w / n.h
        }
        return null
    }
    if defaultRatio(t, i) |r| {
        if r > 0.0 {
            return r
        }
    }
    return null
}

/// The `aspect-ratio` of box `i` (width / height) as "W / H" or "N";
/// null for `auto`, and for `auto W / H` when it has a natural size.
fn aspectRatio(t: *Tree, i: usize) ?f64 {
    var s = text.trim(keywordOf(t.bx(i).style[css.ASPECT_RATIO]))
    if text.startsWith(s, "auto") {
        if naturalSize(t, i) != null {
            return null
        }
        s = text.trim(s[4..])
    }
    if s.len == 0 {
        return null
    }
    var slash = s.len
    for k in 0..s.len {
        if s[k] == '/' {
            slash = k
        }
    }
    let a = text.parseFloat(text.trim(s[..slash])) catch return null
    var b = 1.0
    if slash < s.len {
        b = text.parseFloat(text.trim(s[slash + 1..])) catch return null
    }
    if a <= 0.0 || b <= 0.0 {
        return null
    }
    return a / b
}

/// The border-box size of a replaced element whose padding and borders
/// are `he` (left and right) and `ve` (top and bottom): its
/// `width`/`height` (its `width`/`height` attributes are presentational
/// hints); a missing one follows the other by the aspect ratio of its
/// natural size (an image's, a canvas's); with neither, the natural
/// size; else, for `svg` (its `viewBox` gives the ratio), `iframe`,
/// `embed`, `object` and `video`, 300 x 150 (an `svg` with only a ratio
/// is as wide as its containing block); else 0.
fn replacedDims(t: *Tree, i: usize, cb_w: f64, cb_h: f64, he: f64, ve: f64) Size {
    let style = t.bx(i).style
    var w: ?f64 = sizeOf(style, style[css.WIDTH], cb_w, he)
    var h: ?f64 = sizeOf(style, style[css.HEIGHT], cb_h, ve)
    if aspectRatio(t, i) |r| {
        // `aspect-ratio`: a missing size follows the given one.
        if w |ww| {
            if h == null {
                h = (ww - he) / r + ve
            }
        } else if h |hh| {
            w = (hh - ve) * r + he
        } else if naturalSize(t, i) == null && cb_w > he {
            w = cb_w
            h = (cb_w - he) / r + ve
        }
    }
    if naturalSize(t, i) == null {
        if defaultRatio(t, i) |ratio| {
            // 300 x 150, or a ratio that one given size follows.
            if w |ww| {
                if h == null {
                    if ratio > 0.0 {
                        h = (ww - he) / ratio + ve
                    } else {
                        h = 150.0 + ve
                    }
                }
            } else if h |hh| {
                if ratio > 0.0 {
                    w = (hh - ve) * ratio + he
                } else {
                    w = 300.0 + he
                }
            } else if ratio > 0.0 && cb_w > he && isSvg(t, i) {
                // Only a ratio (an `svg` with a `viewBox`): as wide as
                // the containing block.
                w = cb_w
                h = (cb_w - he) / ratio + ve
            } else {
                w = 300.0 + he
                h = 150.0 + ve
            }
        }
    }
    if naturalSize(t, i) |n| {
        if w |ww| {
            if h == null && n.w > 0.0 {
                h = (ww - he) * n.h / n.w + ve
            }
        } else if h |hh| {
            if n.h > 0.0 {
                w = (hh - ve) * n.w / n.h + he
            }
        } else {
            w = n.w + he
            h = n.h + ve
        }
    }
    return Size { w: w orelse he, h: h orelse ve }
}

fn isSvg(t: *Tree, i: usize) bool {
    if t.bx(i).node |el| {
        return t.doc.isElement(el, "svg")
    }
    return false
}

// For replaced elements that are 300 x 150 when nothing sizes them:
// the width/height ratio a single given size follows (0 for none, as
// for frames); null for other elements.
fn defaultRatio(t: *Tree, i: usize) ?f64 {
    let el = t.bx(i).node orelse return null
    let name = t.doc.node(el).name
    if text.eql(name, "iframe") || text.eql(name, "embed") || text.eql(name, "object") {
        return 0.0
    }
    if text.eql(name, "video") {
        return 2.0
    }
    if !text.eql(name, "svg") {
        return null
    }
    // The ratio of the `viewBox` (min-x min-y width height).
    if t.doc.attr(el, "viewbox") |vb| {
        var nums = [4]f64{0.0, 0.0, 0.0, 0.0}
        var n: usize = 0
        var start: usize = 0
        for k in 0..vb.len + 1 {
            if k == vb.len || vb[k] == ' ' || vb[k] == ',' {
                if k > start && n < 4 {
                    nums[n] = text.parseFloat(vb[start..k]) catch 0.0
                    n += 1
                }
                start = k + 1
            }
        }
        if n == 4 && nums[2] > 0.0 && nums[3] > 0.0 {
            return nums[2] / nums[3]
        }
    }
    return 0.0
}

/// Lays out the content of the block container (or flex container) `i`
/// whose width, edges and margins are set; sets its height, its
/// collapsed margins and its baselines.
fn layoutContents(t: *mut Tree, i: usize, cb_h: f64) AllocError!void {
    let b = t.bx(i)
    let cw = math.max(0.0, b.w - hEdges(b))
    var ch = definiteContentHeight(t, i, cb_h)
    // `aspect-ratio` with an auto height: the height the width gives
    // (content may still make the box taller, as with min-height: auto).
    var ratio_h = -1.0
    if ch < 0.0 {
        if aspectRatio(t, i) |r| {
            let e = vEdges(b)
            var rh = b.w / r - e
            if !borderBoxSizing(b.style) {
                rh = cw / r
            }
            ratio_h = math.max(0.0, clampHeight(t, i, rh + e, cb_h) - e)
        }
    }
    if ch < 0.0 {
        if controlContentHeight(t, i) |control_h| {
            ch = control_h
        }
    }
    let root = isFormattingRoot(t, i)
    // The origin of the content box for floats: a new formatting
    // context, or the parent's origin and this box's offset in it.
    let save_fx = t.fx
    let save_fy = t.fy
    let save_base = t.float_base
    if root {
        t.fx = 0.0
        t.fy = 0.0
        t.float_base = t.floats.len()
    } else {
        t.fx = save_fx + b.margin[3] + b.border[3] + b.padding[3]
        t.fy = save_fy + t.hint_y + b.border[0] + b.padding[0]
    }
    let auto_height = ch < 0.0 && sizeOf(b.style, b.style[css.MIN_HEIGHT], cb_h, 0.0) == null
    let top_open = !root && b.border[0] == 0.0 && b.padding[0] == 0.0
    let bottom_open = !root && b.border[2] == 0.0 && b.padding[2] == 0.0 && auto_height
    b.top_strut = Strut.of(b.margin[0])
    b.bottom_strut = Strut.of(b.margin[2])
    b.first_baseline = -1.0
    b.last_baseline = -1.0
    b.line_start = 0
    b.line_end = 0
    var content_h = 0.0
    var empty = true
    let kind = b.kind
    if isFrameset(t, i) {
        // The outermost frameset fills the viewport.
        content_h = try layoutFrameset(t, i, cw, t.viewport_h)
        empty = false
    } else if hasInlineContent(t, i) {
        content_h = try layoutInline(t, i, cw)
        scrollControl(t, i)
        let bb = t.bx(i)
        if bb.line_end > bb.line_start {
            empty = false
            let first = t.lines.items()[bb.line_start]
            let last = t.lines.items()[bb.line_end - 1]
            bb.first_baseline = bb.border[0] + bb.padding[0] + first.y + first.baseline
            bb.last_baseline = bb.border[0] + bb.padding[0] + last.y + last.baseline
        }
    } else if kind == BoxKind.Flex {
        content_h = try layoutFlex(t, i, cw, ch)
        empty = t.children(i).len == 0
        childBaselines(t, i)
    } else if kind == BoxKind.Grid {
        content_h = try layoutGrid(t, i, cw, ch)
        empty = t.children(i).len == 0
        childBaselines(t, i)
    } else {
        let r = try flow(t, i, cw, ch, top_open, bottom_open)
        content_h = r.height
        empty = r.empty
        childBaselines(t, i)
    }
    if root {
        // A formatting context root holds its floats.
        if t.floats.len() > t.float_base {
            content_h = math.max(content_h, floatsBottom(t))
            empty = false
        }
        while t.floats.len() > t.float_base {
            _ = t.floats.pop()
        }
    }
    t.fx = save_fx
    t.fy = save_fy
    t.float_base = save_base
    let bb = t.bx(i)
    var h = math.max(content_h, ratio_h) + vEdges(bb)
    if ch >= 0.0 {
        h = ch + vEdges(bb)
    }
    bb.h = clampHeight(t, i, h, cb_h)
    bb.through = top_open && bottom_open && empty && bb.h == 0.0
    if bb.through {
        // An empty box: its margins and those of its children collapse
        // into one.
        var all = bb.top_strut
        all.merge(bb.bottom_strut)
        bb.top_strut = all
        bb.bottom_strut = Strut { pos: 0.0, neg: 0.0 }
    }
    if bb.marker.len > 0 {
        placeMarker(t, i)
    }
}

// The first and last baselines of a box without lines of its own, from
// its in-flow children.
fn childBaselines(t: *mut Tree, i: usize) {
    var first = -1.0
    var last = -1.0
    for c in t.children(i) {
        let cb = t.bx(c)
        if cb.oof() {
            continue
        }
        if cb.first_baseline >= 0.0 && first < 0.0 {
            first = cb.y + cb.first_baseline
        }
        if cb.last_baseline >= 0.0 {
            last = cb.y + cb.last_baseline
        }
    }
    let b = t.bx(i)
    let top = b.border[0] + b.padding[0]
    if first >= 0.0 {
        b.first_baseline = top + first
    }
    if last >= 0.0 {
        b.last_baseline = top + last
    }
}

struct Flow {
    height: f64
    // No child had content (every one collapsed through).
    empty: bool
}

// Block flow: stacks the block-level children of `p` (content box `cw`
// wide, `ch` high or -1) with their collapsed margins. `top_open` and
// `bottom_open`: the margins of the first and last child collapse with
// `p`'s own.
fn flow(t: *mut Tree, p: usize, cw: f64, ch: f64, top_open: bool, bottom_open: bool) AllocError!Flow {
    var y = 0.0
    var pending = Strut { pos: 0.0, neg: 0.0 }
    var started = false
    let n = t.children(p).len
    for k in 0..n {
        let c = t.children(p)[k]
        let ob = t.bx(c)
        if ob.abs != 0 {
            // Laid out later; its static position for now.
            ob.x = 0.0
            ob.y = 0.0
            if started || !top_open {
                ob.y = y + pending.value()
            }
            continue
        }
        if ob.float != 0 {
            try layoutAtomic(t, c, cw)
            var fy = 0.0
            if started || !top_open {
                fy = y + pending.value()
            }
            try placeFloat(t, c, fy, cw)
            continue
        }
        // Where the child's border box goes, as far as known before its
        // layout (for floats), below the floats it clears; a formatting
        // context root goes beside the floats.
        var est = 0.0
        if started || !top_open {
            var s = pending
            s.merge(collapsedTop(t, c, cw))
            est = y + s.value()
        }
        var clear_to: ?f64 = null
        if clearanceY(t, clearOf(ob.style)) |cy| {
            if cy > est {
                clear_to = cy
                est = cy
            }
        }
        var shift = 0.0
        var room = cw
        if t.floats.len() > t.float_base && isFormattingRoot(t, c) {
            let band = bandAt(t, est, 1.0, cw)
            shift = band.left
            room = band.width()
        }
        t.hint_y = est
        try layoutBlockLevel(t, c, room, ch)
        let cb = t.bx(c)
        cb.x = shift + cb.margin[3]
        if clear_to |cy| {
            // Clearance: below the floats, margins do not collapse
            // across it.
            cb.y = cy
            started = true
            y = cb.y + cb.h
            pending = cb.bottom_strut
            continue
        }
        if cb.through {
            pending.merge(cb.top_strut)
            if started || !top_open {
                cb.y = y + pending.value()
            } else {
                cb.y = 0.0
            }
            continue
        }
        if !started && top_open {
            var top = t.bx(p).top_strut
            top.merge(pending)
            top.merge(cb.top_strut)
            t.bx(p).top_strut = top
            cb.y = 0.0
        } else {
            var s = pending
            s.merge(cb.top_strut)
            cb.y = y + s.value()
        }
        started = true
        y = cb.y + cb.h
        pending = cb.bottom_strut
    }
    if !started {
        if top_open {
            var top = t.bx(p).top_strut
            top.merge(pending)
            t.bx(p).top_strut = top
            return Flow { height: 0.0, empty: true }
        }
        return Flow { height: math.max(0.0, pending.value()), empty: true }
    }
    if bottom_open {
        var bottom = t.bx(p).bottom_strut
        bottom.merge(pending)
        t.bx(p).bottom_strut = bottom
        return Flow { height: y, empty: false }
    }
    return Flow { height: y + pending.value(), empty: false }
}

// ---- absolute positions

/// Sets the absolute positions of box `i` and its subtree; `ox`, `oy`:
/// the origin its `x`, `y` are relative to.
fn place(t: *mut Tree, i: usize, ox: f64, oy: f64) {
    let b = t.bx(i)
    b.ax = ox + b.x + b.rel_x
    b.ay = oy + b.y + b.rel_y
    let cx = b.ax + b.border[3] + b.padding[3]
    let cy = b.ay + b.border[0] + b.padding[0]
    placeChildren(t, i, cx, cy)
}

fn placeChildren(t: *mut Tree, i: usize, cx: f64, cy: f64) {
    let n = t.children(i).len
    for k in 0..n {
        let c = t.children(i)[k]
        let kind = t.bx(c).kind
        if kind == BoxKind.Inline || kind == BoxKind.Text || kind == BoxKind.LineBreak {
            // Inside an inline formatting context: relative to the
            // block container, like the lines.
            let cb = t.bx(c)
            cb.ax = cx
            cb.ay = cy
            placeChildren(t, c, cx, cy)
        } else {
            place(t, c, cx, cy)
        }
    }
}
