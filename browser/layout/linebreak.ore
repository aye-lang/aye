// Line breaks inside words for East Asian text (UAX 14, the basics): a
// line may break between two characters when one of them is wide (an
// ideograph, kana, hangul, a fullwidth form, an emoji), except before
// closing punctuation, small kana and the iteration and prolonged sound
// marks (classes CL, CP, NS, EX, IS and CJ, kinsoku), and after opening
// punctuation (OP).

import font

/// May a line break between the characters `a` and `b` of a word?
fn breaksBetween(a: u32, b: u32) bool {
    if font.columns(a) != 2 && font.columns(b) != 2 {
        return false
    }
    if font.columns(b) == 0 || noBreakBefore(b) || noBreakAfter(a) {
        return false
    }
    return true
}

// Closing punctuation (CL, CP), exclamation and infix separators (EX,
// IS), nonstarters (NS) and conditional Japanese starters (CJ).
fn noBreakBefore(c: u32) bool {
    if c < 0x80 {
        return c == ')' || c == ']' || c == '}' || c == ',' || c == '.' || c == '!' || c == '?' || c == ':' || c == ';' || c == '%'
    }
    return match c {
        0x2019, 0x201D, 0x2026, 0x2025, 0x203C, 0x2047, 0x2048, 0x2049, 0x00BB => true
        0x3001, 0x3002, 0x3005, 0x3009, 0x300B, 0x300D, 0x300F, 0x3011, 0x3015, 0x3017, 0x3019, 0x301B, 0x301C, 0x301E, 0x301F => true
        0x303B, 0x309B, 0x309C, 0x309D, 0x309E, 0x30A0, 0x30FB, 0x30FC, 0x30FD, 0x30FE => true
        0x3041, 0x3043, 0x3045, 0x3047, 0x3049, 0x3063, 0x3083, 0x3085, 0x3087, 0x308E, 0x3095, 0x3096 => true
        0x30A1, 0x30A3, 0x30A5, 0x30A7, 0x30A9, 0x30C3, 0x30E3, 0x30E5, 0x30E7, 0x30EE, 0x30F5, 0x30F6 => true
        0xFF01, 0xFF09, 0xFF0C, 0xFF0E, 0xFF1A, 0xFF1B, 0xFF1F, 0xFF3D, 0xFF5D, 0xFF60, 0xFF61, 0xFF63, 0xFF64, 0xFF65, 0xFF70, 0xFF9E, 0xFF9F => true
        0xFE10, 0xFE11, 0xFE12, 0xFE13, 0xFE14, 0xFE15, 0xFE16, 0xFE50, 0xFE51, 0xFE52, 0xFE54, 0xFE55, 0xFE56, 0xFE57, 0xFE5A, 0xFE5C, 0xFE5E => true
        _ => (c >= 0x31F0 && c <= 0x31FF)
    }
}

// Opening punctuation (OP) and initial quotes.
fn noBreakAfter(c: u32) bool {
    if c < 0x80 {
        return c == '(' || c == '[' || c == '{'
    }
    return match c {
        0x2018, 0x201C, 0x00AB => true
        0x3008, 0x300A, 0x300C, 0x300E, 0x3010, 0x3014, 0x3016, 0x3018, 0x301A, 0x301D => true
        0xFF08, 0xFF3B, 0xFF5B, 0xFF5F, 0xFF62, 0xFE59, 0xFE5B, 0xFE5D => true
        _ => false
    }
}

test "line breaks between East Asian characters" {
    @expect(breaksBetween(0x65E5, 0x672C))
    @expect(breaksBetween('a' as u32, 0x65E5))
    @expect(breaksBetween(0x65E5, 'a' as u32))
    @expect(!breaksBetween('a' as u32, 'b' as u32))
    // Not before 。、」 or small kana, not after 「.
    @expect(!breaksBetween(0x65E5, 0x3002))
    @expect(!breaksBetween(0x65E5, 0x3001))
    @expect(!breaksBetween(0x65E5, 0x300D))
    @expect(!breaksBetween(0x30C6, 0x30A3))
    @expect(!breaksBetween(0x300C, 0x65E5))
    @expect(!breaksBetween(0x65E5, ','))
    @expect(breaksBetween(0x3002, 0x65E5))
}
