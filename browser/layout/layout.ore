// layout: the box tree of a styled document and its geometry.
//
// - layout.ore: boxes, lines and fragments; building the box tree from
//   the DOM and computed styles (display types, anonymous block boxes,
//   table fix-up, flex items, list markers).
// - values.ore: reading computed values (lengths, keywords, fonts).
// - block.ore: block formatting (widths, heights, margin collapsing),
//   replaced elements, relative positioning, absolute positions.
// - inline.ore: inline formatting (whitespace, line breaking, alignment).
// - intrinsic.ore: min-content and max-content widths.
// - table.ore: tables with automatic column widths.
// - flex.ore: flexbox (row and column, wrap, grow and shrink).
// - grid.ore: grid (track lists, areas, line placement, auto-placement).
// - float.ore: floats, clearance, lines and boxes beside floats.
// - absolute.ore: absolutely positioned boxes, laid out last.
// - transform.ore: CSS transforms, applied after layout.
// - scroll.ore: fixed and sticky boxes following the scroll offset.
// - frameset.ore: framesets (a grid of frames filling the viewport).
// - markers.ore: list item markers.
// - controls.ore: form controls (generated content, sizes) and images.
// - dump.ore: the box tree as text (`anyknown dump --layout`).
//
// Boxes live in `Tree.boxes` and name each other by index. Geometry is
// relative: a box's `x`, `y` are of its border box, relative to the
// content box of its parent, or of the block container whose lines hold
// it for boxes inside an inline formatting context. `place` turns them
// into absolute positions (`ax`, `ay`). Lines and fragments are relative
// to the content box of their block container.
//
// Out-of-flow boxes: floats (`float.ore`) and absolutely positioned
// boxes (`absolute`, `fixed`; laid out after the rest, `absolute.ore`)
// stay children of their parent, take no space in its flow and are
// left out of anonymous block wrapping (they join a neighboring run).
//
// The `::before` and `::after` of an element (`css.Styles.pseudo`) are
// boxes without a node (`Box.pseudo` says which) around a text box of
// their `content` (strings, `attr()`, quotes; `url()`, counters and
// images are left out), first and last among the element's children.
//
// Simplifications: an inline box that contains a block becomes a block
// box; vertical-align is always `baseline`; table cells do not span
// rows; border-spacing and border-collapse are ignored; `fixed` boxes
// are positioned in the initial containing block and moved by
// `scrollTo`, which also moves `sticky` boxes (else `relative` without
// offsets).

import css
import css.Value
import dom
import dom.Document
import dom.Kind
import dom.NodeId
import font
import std.heap.Arena
import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text

pub enum BoxKind {
    // A block container: block, list-item, flow-root, table-caption;
    // also orphaned table parts.
    Block
    // An anonymous block box around the inline content of a block
    // container that also has block children.
    Anonymous
    // An inline box (`span`, `a`, ...).
    Inline
    // An inline-level block container (inline-block).
    InlineBlock
    Text
    // A replaced element: `img` (and other elements whose content is not
    // rendered by layout).
    Image
    LineBreak
    Table
    RowGroup
    Row
    Cell
    Flex
    // A grid container (`grid.ore`).
    Grid
}

/// Collapsed vertical margins: the largest positive and the most
/// negative margin of a set; the result is their sum.
pub struct Strut {
    pos: f64
    neg: f64

    fn of(m: f64) Strut {
        var s = Strut { pos: 0.0, neg: 0.0 }
        s.add(m)
        return s
    }

    fn add(self: *mut Self, m: f64) {
        if m > self.pos {
            self.pos = m
        }
        if m < self.neg {
            self.neg = m
        }
    }

    fn merge(self: *mut Self, o: Strut) {
        self.add(o.pos)
        self.add(o.neg)
    }

    fn value(self: Self) f64 {
        return self.pos + self.neg
    }
}

pub struct Box {
    kind: BoxKind
    // The element or text node; null for anonymous boxes.
    node: ?NodeId
    // Computed values (`css.PROPERTIES` order). Text boxes share their
    // parent element's; anonymous boxes have their own.
    style: []Value
    parent: ?usize
    children: List(usize)
    // Takes part in an inline formatting context (inline boxes, text,
    // `<br>`, inline-blocks, inline images, inline tables and flexes).
    inline_level: bool
    // Text: the text after whitespace processing (the DOM text until
    // then).
    text: []u8
    // Table cells: the number of columns the cell spans.
    span: usize
    // Out of flow: `float` (0 none, 1 left, 2 right) and absolute
    // positioning (0 none, 1 absolute, 2 fixed).
    float: u8
    abs: u8

    // Geometry (see the top of the file): the border box, and the used
    // margins, borders and padding (top, right, bottom, left).
    x: f64
    y: f64
    w: f64
    h: f64
    margin: [4]f64
    border: [4]f64
    padding: [4]f64
    // The offsets of `position: relative`.
    rel_x: f64
    rel_y: f64
    // The border box's absolute position, set by `place`.
    ax: f64
    ay: f64
    // Block containers with inline content: lines `line_start..line_end`
    // of `Tree.lines`.
    line_start: usize
    line_end: usize
    // The baseline of the first and of the last line inside, from the
    // top of the border box; -1 when there is none.
    first_baseline: f64
    last_baseline: f64
    // Margins after collapsing with the children (block flow): the top
    // margin with the first child's, the bottom one with the last
    // child's. `through`: an empty box whose margins collapse together.
    top_strut: Strut
    bottom_strut: Strut
    through: bool
    // List items: the marker text ("" for none) and its box, relative to
    // the content box.
    marker: []u8
    marker_x: f64
    marker_y: f64
    marker_w: f64
    marker_h: f64
    // Cached min-content and max-content border-box widths.
    has_intrinsic: bool
    min_w: f64
    max_w: f64
    // The linear part of its transform that paint draws
    // (`Tree.xforms`), if any.
    xform: ?usize
    // Fixed and sticky boxes: how far `scrollTo` moved the box and its
    // subtree down.
    scroll_dy: f64
    // The box of a pseudo-element and its text: 1 `::before`, 2
    // `::after`; else 0.
    pseudo: u8
    // A border-box height its flex container imposed (a stretched or
    // flexed item, CSS Flexbox 9.4 and 9.8): definite for its content
    // while it is laid out again; -1 otherwise.
    forced_h: f64

    /// Is the box out of flow (a float, or absolutely positioned)?
    pub fn oof(self: *Self) bool {
        return self.float != 0 || self.abs != 0
    }
}

/// A line box; relative to its block container's content box.
pub struct Line {
    x: f64
    y: f64
    w: f64
    h: f64
    // From the top of the line.
    baseline: f64
    frag_start: usize
    frag_end: usize
}

pub enum FragKind {
    // A run of text of one text box.
    Text
    // The part of an inline box on one line.
    Inline
    // An atomic inline (inline-block, image, ...): see the box itself.
    Atomic
}

/// A piece of a line; its border box relative to the block container's
/// content box. `depth` is the number of inline boxes around it on the
/// line.
pub struct Frag {
    kind: FragKind
    box: usize
    depth: usize
    // Text: `box.text[start..end]`.
    start: usize
    end: usize
    x: f64
    y: f64
    w: f64
    h: f64
    // Text at an odd bidi level: drawn right to left.
    rtl: bool = false
}

pub struct Tree {
    // The allocator everything is in (an arena owned by the tree), and
    // the one the tree came from (for temporary lists).
    alloc: Allocator
    backing: Allocator
    arena: *mut Arena
    doc: *Document
    styles: *css.Styles
    measure: dyn font.Measurer
    // The decoded images of the document, when it has any.
    images: ?*Images
    viewport_w: f64
    viewport_h: f64
    boxes: List(Box)
    lines: List(Line)
    frags: List(Frag)
    // The box of the root element, if it has one.
    root: ?usize
    // The floats of the block formatting contexts being laid out
    // (`floats[float_base..]` are the current one's), and the origin of
    // the content box of the block container being laid out in the
    // coordinates of its formatting context root's content box.
    floats: List(FloatBox)
    float_base: usize
    fx: f64
    fy: f64
    // Set by block flow before a child is laid out: the estimated top of
    // its border box in its parent's content box.
    hint_y: f64
    // Absolutely positioned boxes, in tree order, laid out after the
    // rest.
    absolutes: List(usize)
    // The linear parts of transforms (`Box.xform`), the fixed and sticky
    // boxes in tree order, and the scroll offset they are at.
    xforms: List(Xform)
    scrolled: List(usize)
    scroll_y: f64
    // The documents of the frames, laid out by the engine afterwards.
    frames: List(FrameView)

    pub fn deinit(self: *mut Self) {
        self.arena.deinit()
        self.backing.destroy(self.arena)
    }

    /// The box `i`; valid until the next box is added.
    pub fn bx(self: *Self, i: usize) *mut Box {
        return &mut self.boxes.items()[i]
    }

    pub fn children(self: *Self, i: usize) []usize {
        return self.boxes.items()[i].children.items()
    }

    fn newBox(self: *mut Self, kind: BoxKind, node: ?NodeId, style: []Value, parent: ?usize) AllocError!usize {
        let z4 = [4]f64{0.0, 0.0, 0.0, 0.0}
        try self.boxes.append(Box {
            kind: kind,
            node: node,
            style: style,
            parent: parent,
            children: List(usize).init(self.alloc),
            inline_level: false,
            text: "",
            span: 1,
            float: 0,
            abs: 0,
            x: 0.0,
            y: 0.0,
            w: 0.0,
            h: 0.0,
            margin: z4,
            border: z4,
            padding: z4,
            rel_x: 0.0,
            rel_y: 0.0,
            ax: 0.0,
            ay: 0.0,
            line_start: 0,
            line_end: 0,
            first_baseline: -1.0,
            last_baseline: -1.0,
            top_strut: Strut { pos: 0.0, neg: 0.0 },
            bottom_strut: Strut { pos: 0.0, neg: 0.0 },
            through: false,
            marker: "",
            marker_x: 0.0,
            marker_y: 0.0,
            marker_w: 0.0,
            marker_h: 0.0,
            has_intrinsic: false,
            min_w: 0.0,
            max_w: 0.0,
            xform: null,
            scroll_dy: 0.0,
            pseudo: 0,
            forced_h: -1.0,
        })
        return self.boxes.len() - 1
    }

    fn appendChild(self: *mut Self, parent: usize, child: usize) AllocError!void {
        self.bx(child).parent = parent
        try self.boxes.items()[parent].children.append(child)
    }
}

/// Builds the box tree of `doc` (styled by `styles`) and lays it out in a
/// viewport `width` x `height` px, measuring text with `measure`. Free
/// the result with `deinit`; it refers to `doc` and `styles`.
pub fn layoutDocument(alloc: Allocator, doc: *Document, styles: *css.Styles, measure: dyn font.Measurer, width: f64, height: f64) AllocError!Tree {
    return layoutDocumentWith(alloc, doc, styles, null, measure, width, height)
}

/// `layoutDocument` with the decoded images of the document (natural
/// sizes for layout, pixels for paint); `images` must outlive the tree.
pub fn layoutDocumentWith(alloc: Allocator, doc: *Document, styles: *css.Styles, images: ?*Images, measure: dyn font.Measurer, width: f64, height: f64) AllocError!Tree {
    let arena = try alloc.create(Arena.init(alloc))
    let a = arena.allocator()
    var t = Tree {
        alloc: a,
        backing: alloc,
        arena: arena,
        doc: doc,
        styles: styles,
        measure: measure,
        images: images,
        viewport_w: width,
        viewport_h: height,
        boxes: List(Box).init(a),
        lines: List(Line).init(a),
        frags: List(Frag).init(a),
        root: null,
        floats: List(FloatBox).init(a),
        float_base: 0,
        fx: 0.0,
        fy: 0.0,
        hint_y: 0.0,
        absolutes: List(usize).init(a),
        xforms: List(Xform).init(a),
        scrolled: List(usize).init(a),
        scroll_y: 0.0,
        frames: List(FrameView).init(a),
    }
    errdefer t.deinit()
    if doc.documentElement() |el| {
        if styles.get(el) |style| {
            let name = doc.node(el).name
            if kindOf(name, keywordOf(style[css.DISPLAY])) |k| {
                let r = try t.newBox(k.kind, el, style, null)
                blockify(&mut t, r)
                t.root = r
                try buildChildren(&mut t, r, el)
                try fixUp(&mut t, r)
                try prepareText(&mut t)
                try layoutRoot(&mut t, r)
                place(&mut t, r, 0.0, 0.0)
                try layoutAbsolutes(&mut t)
                try applyTransforms(&mut t, r)
                try collectScrolled(&mut t, r, false, false)
                _ = scrollTo(&mut t, 0.0)
            }
        }
    }
    return t
}

// ---- building the box tree

// The kind of box for an element, and whether it is inline-level; null
// for no box (display: none, table columns).
struct KindOf {
    kind: BoxKind
    inline_level: bool
}

fn kindOf(name: []u8, display: []u8) ?KindOf {
    if text.eql(display, "none") {
        return null
    }
    let inl = text.eql(display, "inline") || text.eql(display, "inline-block") || text.eql(display, "inline-table") || text.eql(display, "inline-flex") || text.eql(display, "inline-grid")
    if text.eql(name, "img") || text.eql(name, "video") || text.eql(name, "canvas") || text.eql(name, "iframe") || text.eql(name, "embed") || text.eql(name, "object") || text.eql(name, "svg") || text.eql(name, "frame") {
        return KindOf { kind: BoxKind.Image, inline_level: inl }
    }
    if text.eql(name, "br") {
        return KindOf { kind: BoxKind.LineBreak, inline_level: true }
    }
    if text.eql(display, "inline") {
        return KindOf { kind: BoxKind.Inline, inline_level: true }
    }
    if text.eql(display, "inline-block") {
        return KindOf { kind: BoxKind.InlineBlock, inline_level: true }
    }
    if text.eql(display, "table") || text.eql(display, "inline-table") {
        return KindOf { kind: BoxKind.Table, inline_level: inl }
    }
    if text.eql(display, "flex") || text.eql(display, "inline-flex") {
        return KindOf { kind: BoxKind.Flex, inline_level: inl }
    }
    if text.eql(display, "grid") || text.eql(display, "inline-grid") {
        return KindOf { kind: BoxKind.Grid, inline_level: inl }
    }
    if text.eql(display, "table-row-group") || text.eql(display, "table-header-group") || text.eql(display, "table-footer-group") {
        return KindOf { kind: BoxKind.RowGroup, inline_level: false }
    }
    if text.eql(display, "table-row") {
        return KindOf { kind: BoxKind.Row, inline_level: false }
    }
    if text.eql(display, "table-cell") {
        return KindOf { kind: BoxKind.Cell, inline_level: false }
    }
    if text.eql(display, "table-column") || text.eql(display, "table-column-group") {
        return null
    }
    return KindOf { kind: BoxKind.Block, inline_level: false }
}

// Adds the boxes of the children of the node `el` in the flat tree (a
// shadow host's shadow tree, a slot's assigned nodes) to the box
// `parent`.
fn buildChildren(t: *mut Tree, parent: usize, el: NodeId) AllocError!void {
    var cur = dom.flatFirstChild(t.doc, el)
    while cur |c| {
        let n = t.doc.node(c)
        if n.kind == Kind.Text {
            // A frameset has only frames and framesets.
            if n.data.len > 0 && !t.doc.isElement(el, "frameset") {
                if t.styles.get(el) |style| {
                    let b = try t.newBox(BoxKind.Text, c, style, parent)
                    t.bx(b).inline_level = true
                    t.bx(b).text = n.data
                    try t.appendChild(parent, b)
                }
            }
        } else if n.kind == Kind.Element {
            try buildElement(t, parent, c)
        }
        cur = dom.flatNextSibling(t.doc, c)
    }
}

fn buildElement(t: *mut Tree, parent: usize, el: NodeId) AllocError!void {
    if t.styles.get(el) |style| {
        let display = keywordOf(style[css.DISPLAY])
        if text.eql(display, "contents") {
            return buildChildren(t, parent, el)
        }
        let name = t.doc.node(el).name
        if kindOf(name, display) |kind_of| {
            var k = kind_of
            if isReplacedInput(t.doc, el) {
                k.kind = BoxKind.Image
            }
            let b = try t.newBox(k.kind, el, style, parent)
            t.bx(b).inline_level = k.inline_level
            try t.appendChild(parent, b)
            try outOfFlow(t, b, parent)
            if k.kind == BoxKind.Cell {
                if t.doc.attr(el, "colspan") |v| {
                    let n = text.parseInt(text.trim(v)) catch 1
                    if n > 1 && n <= 1000 {
                        t.bx(b).span = n as usize
                    }
                }
            }
            if text.eql(display, "list-item") {
                try listMarker(t, b, el)
            }
            if k.kind != BoxKind.Image && k.kind != BoxKind.LineBreak {
                if text.eql(name, "details") && t.doc.attr(el, "open") == null {
                    // A closed `details` shows only its summary.
                    try buildSummary(t, b, el)
                } else if !(try controlContent(t, b, el)) {
                    try buildPseudo(t, b, el, 1)
                    try buildChildren(t, b, el)
                    try buildPseudo(t, b, el, 2)
                }
            }
        }
    }
}

// The box of the `::before` (`which` 1) or `::after` (2) of `el` (whose
// box is `parent`), if it has one.
fn buildPseudo(t: *mut Tree, parent: usize, el: NodeId, which: u8) AllocError!void {
    let style = t.styles.pseudo(el, which) orelse return
    let content = try contentText(t, el, keywordOf(style[css.CONTENT]))
    var display = keywordOf(style[css.DISPLAY])
    if text.eql(display, "contents") || text.eql(display, "list-item") {
        display = "inline"
    }
    let k = kindOf("", display) orelse return
    let b = try t.newBox(k.kind, null, style, parent)
    t.bx(b).inline_level = k.inline_level
    t.bx(b).pseudo = which
    try t.appendChild(parent, b)
    try outOfFlow(t, b, parent)
    if content.len > 0 {
        let tb = try t.newBox(BoxKind.Text, null, style, b)
        t.bx(tb).inline_level = true
        t.bx(tb).text = content
        t.bx(tb).pseudo = which
        try t.appendChild(b, tb)
    }
}

// The text of a `content` value: its strings, `attr(name)`s of `el` and
// quotes (curly ones), in order; the rest (`url()`, counters, images)
// adds nothing.
fn contentText(t: *mut Tree, el: NodeId, v: []u8) AllocError![]u8 {
    var out = List(u8).init(t.alloc)
    var k: usize = 0
    while k < v.len {
        let c = v[k]
        if c == '"' || c == '\'' {
            var e = k + 1
            while e < v.len && v[e] != c {
                e += 1
            }
            try appendText(&mut out, v[k + 1..e])
            k = e + 1
            continue
        }
        if c == ' ' {
            k += 1
            continue
        }
        // A word or a function.
        var e = k
        var depth: usize = 0
        while e < v.len {
            if v[e] == '(' {
                depth += 1
            } else if v[e] == ')' && depth > 0 {
                depth -= 1
            } else if v[e] == ' ' && depth == 0 {
                break
            }
            e += 1
        }
        let word = v[k..e]
        if text.startsWith(word, "attr(") && text.endsWith(word, ")") {
            if t.doc.attr(el, text.trim(word[5..word.len - 1])) |a| {
                try appendText(&mut out, a)
            }
        } else if text.eql(word, "open-quote") {
            try appendText(&mut out, "“")
        } else if text.eql(word, "close-quote") {
            try appendText(&mut out, "”")
        }
        k = e
    }
    return out.items()
}

fn appendText(out: *mut List(u8), s: []u8) AllocError!void {
    for c in s {
        try out.append(c)
    }
}

// The box of the first `summary` child of the `details` element `el`.
fn buildSummary(t: *mut Tree, parent: usize, el: NodeId) AllocError!void {
    var cur = dom.flatFirstChild(t.doc, el)
    while cur |c| {
        if t.doc.isElement(c, "summary") {
            return buildElement(t, parent, c)
        }
        cur = dom.flatNextSibling(t.doc, c)
    }
}

// Marks box `b` (a new child of `parent`) as a float or an absolutely
// positioned box after its `position` and `float`, and makes it
// block-level (CSS 2.1 9.7). Floats in flex and grid containers are
// items like the others.
fn outOfFlow(t: *mut Tree, b: usize, parent: usize) AllocError!void {
    let k = t.bx(b).kind
    if k == BoxKind.LineBreak || k == BoxKind.Text {
        return
    }
    let s = t.bx(b).style
    let pos = keywordOf(s[css.POSITION])
    if text.eql(pos, "absolute") || text.eql(pos, "fixed") {
        t.bx(b).abs = 1
        if text.eql(pos, "fixed") {
            t.bx(b).abs = 2
        }
        try t.absolutes.append(b)
    } else {
        let pk = t.bx(parent).kind
        if pk == BoxKind.Flex || pk == BoxKind.Grid {
            return
        }
        let f = keywordOf(s[css.FLOAT])
        if text.eql(f, "left") || text.eql(f, "inline-start") {
            t.bx(b).float = 1
        } else if text.eql(f, "right") || text.eql(f, "inline-end") {
            t.bx(b).float = 2
        } else {
            return
        }
    }
    blockify(t, b)
}

// Is the box a block container (its children are either all
// block-level or all inline-level after `fixUp`)?
fn isBlockContainer(k: BoxKind) bool {
    return match k {
        .Block, .Anonymous, .InlineBlock, .Cell => true
        _ => false
    }
}

// Does box `i` hold inline content (lines)? Out-of-flow children do
// not count.
pub fn hasInlineContent(t: *Tree, i: usize) bool {
    let b = t.bx(i)
    if !isBlockContainer(b.kind) {
        return false
    }
    for c in b.children.items() {
        let cb = t.bx(c)
        if !cb.oof() {
            return cb.inline_level
        }
    }
    return false
}

// Normalizes the subtree of `i` (children first): an inline box with a
// block inside becomes a block; a block container's runs of inline
// content next to blocks go into anonymous blocks (runs of collapsible
// whitespace are dropped); tables get rows and cells where they are
// missing; flex items are blockified.
fn fixUp(t: *mut Tree, i: usize) AllocError!void {
    let n = t.children(i).len
    for k in 0..n {
        try fixUp(t, t.children(i)[k])
    }
    let kind = t.bx(i).kind
    if kind == BoxKind.Inline {
        var block = false
        for c in t.children(i) {
            if !t.bx(c).inline_level && !t.bx(c).oof() {
                block = true
            }
        }
        if block {
            t.bx(i).kind = BoxKind.Block
            t.bx(i).inline_level = false
            try wrapInline(t, i)
        }
        return
    }
    if isBlockContainer(kind) {
        for c in t.children(i) {
            let ck = t.bx(c).kind
            if ck == BoxKind.Row || ck == BoxKind.RowGroup || ck == BoxKind.Cell {
                // Table parts outside a table: laid out as blocks.
                t.bx(c).kind = BoxKind.Block
                try wrapInline(t, c)
            }
        }
        return wrapInline(t, i)
    }
    if kind == BoxKind.Flex || kind == BoxKind.Grid {
        try wrapInline(t, i)
        for c in t.children(i) {
            blockify(t, c)
        }
        return
    }
    if kind == BoxKind.Table {
        return tableChildren(t, i, BoxKind.Row)
    }
    if kind == BoxKind.RowGroup {
        return tableChildren(t, i, BoxKind.Row)
    }
    if kind == BoxKind.Row {
        return tableChildren(t, i, BoxKind.Cell)
    }
}

// A flex or grid item, a float, an absolutely positioned box:
// block-level.
fn blockify(t: *mut Tree, i: usize) {
    let b = t.bx(i)
    b.inline_level = false
    if b.kind == BoxKind.InlineBlock || b.kind == BoxKind.Inline {
        b.kind = BoxKind.Block
    }
}

// When box `i` has both block-level and inline-level children, wraps
// each run of inline-level children (with the out-of-flow boxes among
// them) in an anonymous block, dropping runs of only collapsible
// whitespace. In a flex or grid container every element is an item of
// its own (or out of flow), and only runs of text are wrapped.
fn wrapInline(t: *mut Tree, i: usize) AllocError!void {
    let kids = t.children(i)
    var inl = false
    var blk = false
    for c in kids {
        if t.bx(c).oof() {
            continue
        }
        if t.bx(c).inline_level {
            inl = true
        } else {
            blk = true
        }
    }
    let items = t.bx(i).kind == BoxKind.Flex || t.bx(i).kind == BoxKind.Grid
    if !inl || (!blk && !items) {
        return
    }
    var out = List(usize).init(t.alloc)
    var k: usize = 0
    while k < kids.len {
        let c = kids[k]
        if standsAlone(t, c, items) {
            try out.append(c)
            k += 1
            continue
        }
        var end = k
        var empty = true
        while end < kids.len && !standsAlone(t, kids[end], items) {
            if !t.bx(kids[end]).oof() && !isCollapsibleSpace(t, kids[end]) {
                empty = false
            }
            end += 1
        }
        if !empty {
            let anon = try anonymousBox(t, i, BoxKind.Anonymous)
            for j in k..end {
                try t.appendChild(anon, t.children(i)[j])
            }
            try out.append(anon)
        } else {
            for j in k..end {
                if t.bx(kids[j]).oof() {
                    try out.append(kids[j])
                }
            }
        }
        k = end
    }
    t.bx(i).children = out
}

// Does child `c` stay out of anonymous blocks: an in-flow block-level
// box, or in a flex or grid container (`items`) anything but text?
fn standsAlone(t: *Tree, c: usize, items: bool) bool {
    let b = t.bx(c)
    if items {
        return b.kind != BoxKind.Text
    }
    return !b.oof() && !b.inline_level
}

// A new anonymous box of `kind` (not yet a child of `parent`) with the
// inherited values of `parent`'s style and initial values for the rest.
fn anonymousBox(t: *mut Tree, parent: usize, kind: BoxKind) AllocError!usize {
    let ps = t.bx(parent).style
    let style = try t.alloc.alloc(Value.Initial, css.NPROPS)
    for p in 0..css.NPROPS {
        if css.PROPERTIES[p].inherited {
            style[p] = ps[p]
        } else {
            style[p] = t.styles.initial[p]
        }
    }
    style[css.DISPLAY] = Value.Keyword { k: "block" }
    let b = try t.newBox(kind, null, style, parent)
    return b
}

// Is box `i` (inline-level) only whitespace that collapses away?
fn isCollapsibleSpace(t: *Tree, i: usize) bool {
    let b = t.bx(i)
    if b.kind == BoxKind.Text {
        let ws = keywordOf(b.style[css.WHITE_SPACE])
        let pre = text.eql(ws, "pre") || text.eql(ws, "pre-wrap") || text.eql(ws, "break-spaces")
        for c in b.text {
            if !isWhite(c) || pre || (c == '\n' && text.eql(ws, "pre-line")) {
                return false
            }
        }
        return true
    }
    if b.kind == BoxKind.Inline {
        for c in b.children.items() {
            if !isCollapsibleSpace(t, c) {
                return false
            }
        }
        return true
    }
    return false
}

pub fn isWhite(c: u8) bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\x0C'
}

// The children of a table (`want` Row), row group (Row) or row (Cell):
// whitespace text is dropped; other children that are not `want` (or,
// in a table, row groups and captions) go into anonymous boxes of kind
// `want`.
fn tableChildren(t: *mut Tree, i: usize, want: BoxKind) AllocError!void {
    let kids = t.children(i)
    var out = List(usize).init(t.alloc)
    var k: usize = 0
    let in_table = t.bx(i).kind == BoxKind.Table
    while k < kids.len {
        let c = kids[k]
        let ck = t.bx(c).kind
        if ck == want || (in_table && (ck == BoxKind.RowGroup || isCaption(t, c))) {
            try out.append(c)
            k += 1
            continue
        }
        if t.bx(c).inline_level && isCollapsibleSpace(t, c) {
            k += 1
            continue
        }
        // A run of other children.
        var end = k
        while end < kids.len {
            let ek = t.bx(kids[end]).kind
            if ek == want || (in_table && (ek == BoxKind.RowGroup || isCaption(t, kids[end]))) {
                break
            }
            end += 1
        }
        let anon = try anonymousBox(t, i, want)
        for j in k..end {
            try t.appendChild(anon, t.children(i)[j])
        }
        try fixUp(t, anon)
        try out.append(anon)
        k = end
    }
    t.bx(i).children = out
}

fn isCaption(t: *Tree, i: usize) bool {
    let b = t.bx(i)
    return b.kind == BoxKind.Block && isKeyword(b.style[css.DISPLAY], "table-caption")
}
