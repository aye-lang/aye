// The box tree as text, for `anyknown dump --layout`: one box per line,
// children indented by two spaces, with the absolute position and size
// of its border box (px, at most two decimals):
//
//     viewport 800x600
//       block <html> (0, 0) 800x52
//         block <body> (8, 16) 784x20
//           block <p> (8, 16) 784x20
//             line (8, 16) 784x20
//               text (8, 18) 48x16 "Hello "
//               inline <b> (56, 18) 24x16
//                 text (56, 18) 24x16 "you"
//
// Block containers with inline content list their lines, and each line
// its fragments: text runs, the parts of inline boxes (their content
// indented below them) and atomic inlines (with their own subtree).
// List items show their marker first. Floats and absolutely positioned
// boxes say so after their size; those inside inline content follow
// the lines.

import css
import dom.Kind
import std.mem.AllocError
import std.text

pub fn dumpTree(t: *Tree, out: *mut text.Builder) AllocError!void {
    try out.append("viewport ")
    try css.writeNumber(t.viewport_w, out)
    try out.appendByte('x')
    try css.writeNumber(t.viewport_h, out)
    try out.appendByte('\n')
    if t.root |r| {
        try dumpBox(t, r, 1, out)
    }
}

fn dumpBox(t: *Tree, i: usize, depth: usize, out: *mut text.Builder) AllocError!void {
    let b = t.bx(i)
    try indentBy(out, depth)
    try out.append(kindName(t, i))
    if b.node |el| {
        let n = t.doc.node(el)
        try out.append(" <")
        try out.append(n.name)
        for a in n.attrs {
            try out.appendByte(' ')
            try out.append(a.name)
            try out.append("=")
            try quote(out, a.value)
        }
        try out.appendByte('>')
    } else {
        try out.append(" (anonymous)")
    }
    try out.appendByte(' ')
    try rect(out, b.ax, b.ay, b.w, b.h)
    if b.float == 1 {
        try out.append(" float left")
    } else if b.float == 2 {
        try out.append(" float right")
    } else if b.abs == 1 {
        try out.append(" absolute")
    } else if b.abs == 2 {
        try out.append(" fixed")
    }
    try out.appendByte('\n')
    let cx = b.ax + b.border[3] + b.padding[3]
    let cy = b.ay + b.border[0] + b.padding[0]
    if b.marker.len > 0 {
        try indentBy(out, depth + 1)
        try out.append("marker ")
        try rect(out, cx + b.marker_x, cy + b.marker_y, b.marker_w, b.marker_h)
        try out.appendByte(' ')
        try quote(out, b.marker)
        try out.appendByte('\n')
    }
    if hasInlineContent(t, i) {
        for li in b.line_start..b.line_end {
            let line = t.lines.items()[li]
            try indentBy(out, depth + 1)
            try out.append("line ")
            try rect(out, cx + line.x, cy + line.y, line.w, line.h)
            try out.appendByte('\n')
            for fi in line.frag_start..line.frag_end {
                try dumpFrag(t, t.frags.items()[fi], depth + 2, cx, cy, out)
            }
        }
        try dumpOutOfFlow(t, i, depth + 1, out)
        return
    }
    for c in t.children(i) {
        try dumpBox(t, c, depth + 1, out)
    }
}

// The out-of-flow boxes among the inline content of box `i`.
fn dumpOutOfFlow(t: *Tree, i: usize, depth: usize, out: *mut text.Builder) AllocError!void {
    for c in t.children(i) {
        let cb = t.bx(c)
        if cb.oof() {
            try dumpBox(t, c, depth, out)
        } else if cb.kind == BoxKind.Inline {
            try dumpOutOfFlow(t, c, depth, out)
        }
    }
}

fn dumpFrag(t: *Tree, f: Frag, depth: usize, cx: f64, cy: f64, out: *mut text.Builder) AllocError!void {
    let d = depth + f.depth
    match f.kind {
        .Atomic => {
            try dumpBox(t, f.box, d, out)
        }
        .Text => {
            try indentBy(out, d)
            try out.append("text ")
            try rect(out, cx + f.x, cy + f.y, f.w, f.h)
            try out.appendByte(' ')
            try quote(out, t.bx(f.box).text[f.start..f.end])
            try out.appendByte('\n')
        }
        .Inline => {
            try indentBy(out, d)
            try out.append("inline")
            if t.bx(f.box).node |el| {
                let n = t.doc.node(el)
                try out.append(" <")
                try out.append(n.name)
                for a in n.attrs {
                    try out.appendByte(' ')
                    try out.append(a.name)
                    try out.append("=")
                    try quote(out, a.value)
                }
                try out.appendByte('>')
            }
            try out.appendByte(' ')
            try rect(out, cx + f.x, cy + f.y, f.w, f.h)
            try out.appendByte('\n')
        }
    }
}

fn kindName(t: *Tree, i: usize) []u8 {
    let b = t.bx(i)
    return match b.kind {
        .Block => blockName(b)
        .Anonymous => "block"
        .Inline => "inline"
        .InlineBlock => "inline-block"
        .Text => "text"
        .Image => "replaced"
        .LineBreak => "br"
        .Table => inlineName(b, "table", "inline-table")
        .RowGroup => "row-group"
        .Row => "row"
        .Cell => "cell"
        .Flex => inlineName(b, "flex", "inline-flex")
        .Grid => inlineName(b, "grid", "inline-grid")
    }
}

fn blockName(b: *Box) []u8 {
    if isKeyword(b.style[css.DISPLAY], "list-item") {
        return "list-item"
    }
    return "block"
}

fn inlineName(b: *Box, block: []u8, inl: []u8) []u8 {
    if b.inline_level {
        return inl
    }
    return block
}

fn rect(out: *mut text.Builder, x: f64, y: f64, w: f64, h: f64) AllocError!void {
    try out.appendByte('(')
    try css.writeNumber(x, out)
    try out.append(", ")
    try css.writeNumber(y, out)
    try out.append(") ")
    try css.writeNumber(w, out)
    try out.appendByte('x')
    try css.writeNumber(h, out)
}

fn indentBy(out: *mut text.Builder, depth: usize) AllocError!void {
    for k in 0..depth {
        try out.append("  ")
    }
}

// `s` in double quotes, with `"`, `\` and control characters escaped.
fn quote(out: *mut text.Builder, s: []u8) AllocError!void {
    try out.appendByte('"')
    for c in s {
        if c == '"' || c == '\\' {
            try out.appendByte('\\')
            try out.appendByte(c)
        } else if c == '\n' {
            try out.append("\\n")
        } else if c == '\t' {
            try out.append("\\t")
        } else {
            try out.appendByte(c)
        }
    }
    try out.appendByte('"')
}
