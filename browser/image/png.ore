// png: the PNG decoder. All color types and bit depths, PLTE and tRNS,
// the five row filters and Adam7 interlacing. Ancillary chunks (gamma,
// color profiles, text) are skipped. Chunk CRCs are not checked: the
// zlib stream's Adler-32 still catches corrupt image data. 16-bit
// samples keep their high byte; a palette index past the palette is
// opaque black.

import std
import std.mem.Allocator

let PNG_SIGNATURE = "\x89PNG\r\n\x1A\n"

// Adam7: where each of the 7 passes starts and how far apart its pixels
// are. A non-interlaced image is one pass that starts at 0 with step 1.
let ADAM7_X0 = [7]usize{0, 4, 0, 2, 0, 1, 0}
let ADAM7_Y0 = [7]usize{0, 0, 4, 0, 2, 0, 1}
let ADAM7_DX = [7]usize{8, 8, 4, 4, 2, 2, 1}
let ADAM7_DY = [7]usize{8, 8, 8, 4, 4, 2, 2}

// What the chunks before the image data say.
struct PngHeader {
    width: usize
    height: usize
    depth: usize
    color: u8
    channels: usize
    interlaced: bool
    // 256 RGBA entries; alpha from tRNS, else 255.
    palette: [1024]u8
    palette_len: usize
    // tRNS for color types 0 and 2: the samples (at full depth) of the
    // one transparent color.
    has_key: bool
    key_r: u32
    key_g: u32
    key_b: u32
}

/// Decodes a PNG file. Free the result with `deinit`.
pub fn decodePng(alloc: Allocator, data: []u8) ImageError!Bitmap {
    if data.len < 8 || !std.mem.eql(data[..8], PNG_SIGNATURE) {
        return ImageError.Invalid
    }
    var hd = PngHeader {
        width: 0,
        height: 0,
        depth: 0,
        color: 0,
        channels: 0,
        interlaced: false,
        palette: @zeroed([1024]u8),
        palette_len: 0,
        has_key: false,
        key_r: 0,
        key_g: 0,
        key_b: 0,
    }
    // The first IDAT chunk, and the size and number of all of them.
    var idat_first = data[0..0]
    var idat_total: usize = 0
    var idat_chunks: usize = 0
    var seen_header = false
    var pos: usize = 8
    // Chunks: length, type, data, CRC. A file may stop after the last
    // IDAT without IEND; a chunk cut short is an error.
    while pos < data.len {
        if data.len - pos < 12 {
            return ImageError.Invalid
        }
        let len = pngBe32(data, pos) as usize
        if len > data.len - pos - 12 {
            return ImageError.Invalid
        }
        let kind = data[pos + 4..pos + 8]
        let body = data[pos + 8..pos + 8 + len]
        pos += 12 + len
        if std.mem.eql(kind, "IHDR") {
            if seen_header {
                return ImageError.Invalid
            }
            try pngReadHeader(&mut hd, body)
            seen_header = true
        } else if !seen_header {
            return ImageError.Invalid
        } else if std.mem.eql(kind, "PLTE") {
            if body.len % 3 != 0 || body.len == 0 || body.len > 768 {
                return ImageError.Invalid
            }
            hd.palette_len = body.len / 3
            for i in 0..hd.palette_len {
                hd.palette[i * 4] = body[i * 3]
                hd.palette[i * 4 + 1] = body[i * 3 + 1]
                hd.palette[i * 4 + 2] = body[i * 3 + 2]
                hd.palette[i * 4 + 3] = 255
            }
        } else if std.mem.eql(kind, "tRNS") {
            pngReadTrns(&mut hd, body)
        } else if std.mem.eql(kind, "IDAT") {
            if idat_chunks == 0 {
                idat_first = body
            }
            idat_total += len
            idat_chunks += 1
        } else if std.mem.eql(kind, "IEND") {
            break
        }
    }
    if !seen_header || idat_total == 0 {
        return ImageError.Invalid
    }
    if hd.color == 3 && hd.palette_len == 0 {
        return ImageError.Invalid
    }

    // The size of the filtered rows of all passes, each row with its
    // filter byte.
    let bits_per_pixel = hd.channels * hd.depth
    var expected: usize = 0
    for p in 0..7 {
        let pw = pngPassSize(hd.width, hd.interlaced, ADAM7_X0[p], ADAM7_DX[p])
        let ph = pngPassSize(hd.height, hd.interlaced, ADAM7_Y0[p], ADAM7_DY[p])
        if pw > 0 && ph > 0 {
            expected += ph * (1 + (pw * bits_per_pixel + 7) / 8)
        }
        if !hd.interlaced {
            break
        }
    }
    // One IDAT chunk (the usual case) is decompressed in place; several
    // are joined first.
    var joined_size: usize = 0
    if idat_chunks > 1 {
        joined_size = idat_total
    }
    let joined = try alloc.alloc(0 as u8, joined_size)
    defer alloc.free(joined)
    var stream = idat_first
    if idat_chunks > 1 {
        pngJoinIdat(data, joined)
        stream = joined
    }
    let raw = try zlibDecode(alloc, stream, expected, expected)
    defer alloc.free(raw)
    if raw.len < expected {
        return ImageError.Invalid
    }

    var bmp = try newBitmap(alloc, hd.width, hd.height)
    errdefer bmp.deinit(alloc)
    // Bytes per complete pixel, at least 1: the distance the Sub, Average
    // and Paeth filters look back.
    var bpp = bits_per_pixel / 8
    if bpp == 0 {
        bpp = 1
    }
    var off: usize = 0
    for p in 0..7 {
        var x0: usize = 0
        var y0: usize = 0
        var dx: usize = 1
        var dy: usize = 1
        if hd.interlaced {
            x0 = ADAM7_X0[p]
            y0 = ADAM7_Y0[p]
            dx = ADAM7_DX[p]
            dy = ADAM7_DY[p]
        }
        let pw = pngPassSize(hd.width, hd.interlaced, x0, dx)
        let ph = pngPassSize(hd.height, hd.interlaced, y0, dy)
        if pw > 0 && ph > 0 {
            let row_bytes = (pw * bits_per_pixel + 7) / 8
            for r in 0..ph {
                let start = off + r * (row_bytes + 1)
                try pngUnfilter(raw, start, row_bytes, bpp, r > 0)
                let row = raw[start + 1..start + 1 + row_bytes]
                pngExpandRow(&hd, row, pw, bmp.pixels, (y0 + r * dy) * hd.width, x0, dx)
            }
            off += ph * (row_bytes + 1)
        }
        if !hd.interlaced {
            break
        }
    }
    return bmp
}

// Copies the data of the IDAT chunks of `data` (already checked by
// decodePng) to `out`, which has their total size.
fn pngJoinIdat(data: []u8, out: []mut u8) {
    var pos: usize = 8
    var at: usize = 0
    while pos + 12 <= data.len {
        let len = pngBe32(data, pos) as usize
        if len > data.len - pos - 12 {
            return
        }
        let kind = data[pos + 4..pos + 8]
        if std.mem.eql(kind, "IEND") {
            return
        }
        if std.mem.eql(kind, "IDAT") && len <= out.len - at {
            std.mem.copy(out[at..at + len], data[pos + 8..pos + 8 + len])
            at += len
        }
        pos += 12 + len
    }
}

fn pngBe32(data: []u8, at: usize) u32 {
    return (data[at] as u32 << 24) | (data[at + 1] as u32 << 16) | (data[at + 2] as u32 << 8) | data[at + 3] as u32
}

fn pngReadHeader(hd: *mut PngHeader, body: []u8) ImageError!void {
    if body.len != 13 {
        return ImageError.Invalid
    }
    hd.width = pngBe32(body, 0) as usize
    hd.height = pngBe32(body, 4) as usize
    try checkSize(hd.width, hd.height)
    hd.depth = body[8] as usize
    hd.color = body[9]
    // Compression and filter method 0 are the only ones defined.
    if body[10] != 0 || body[11] != 0 || body[12] > 1 {
        return ImageError.Invalid
    }
    hd.interlaced = body[12] == 1
    let d = hd.depth
    var ok = false
    if hd.color == 0 {
        hd.channels = 1
        ok = d == 1 || d == 2 || d == 4 || d == 8 || d == 16
    } else if hd.color == 2 {
        hd.channels = 3
        ok = d == 8 || d == 16
    } else if hd.color == 3 {
        hd.channels = 1
        ok = d == 1 || d == 2 || d == 4 || d == 8
    } else if hd.color == 4 {
        hd.channels = 2
        ok = d == 8 || d == 16
    } else if hd.color == 6 {
        hd.channels = 4
        ok = d == 8 || d == 16
    }
    if !ok {
        return ImageError.Invalid
    }
}

// A malformed tRNS is ignored, as libpng does.
fn pngReadTrns(hd: *mut PngHeader, body: []u8) {
    if hd.color == 3 {
        for i in 0..body.len {
            if i < 256 {
                hd.palette[i * 4 + 3] = body[i]
            }
        }
    } else if hd.color == 0 && body.len >= 2 {
        hd.has_key = true
        hd.key_r = (body[0] as u32 << 8) | body[1] as u32
    } else if hd.color == 2 && body.len >= 6 {
        hd.has_key = true
        hd.key_r = (body[0] as u32 << 8) | body[1] as u32
        hd.key_g = (body[2] as u32 << 8) | body[3] as u32
        hd.key_b = (body[4] as u32 << 8) | body[5] as u32
    }
}

// The pixels of a pass along one axis of `size` pixels.
fn pngPassSize(size: usize, interlaced: bool, start: usize, step: usize) usize {
    if !interlaced {
        return size
    }
    if size <= start {
        return 0
    }
    return (size - start + step - 1) / step
}

// Undoes the filter of the row whose filter byte is `raw[start]`, in
// place; the row above (already unfiltered) ends right before it.
fn pngUnfilter(raw: []mut u8, start: usize, row_bytes: usize, bpp: usize, has_prev: bool) ImageError!void {
    let filter = raw[start]
    let cur = start + 1
    // The row above starts row_bytes + 1 bytes earlier.
    var prev: usize = 0
    if has_prev {
        prev = cur - row_bytes - 1
    }
    if filter == 0 {
        return
    }
    if filter == 1 {
        for i in bpp..row_bytes {
            raw[cur + i] = raw[cur + i] +% raw[cur + i - bpp]
        }
    } else if filter == 2 {
        if !has_prev {
            return
        }
        for i in 0..row_bytes {
            raw[cur + i] = raw[cur + i] +% raw[prev + i]
        }
    } else if filter == 3 {
        for i in 0..row_bytes {
            var a: u32 = 0
            var b: u32 = 0
            if i >= bpp {
                a = raw[cur + i - bpp] as u32
            }
            if has_prev {
                b = raw[prev + i] as u32
            }
            raw[cur + i] = raw[cur + i] +% ((a + b) / 2) as u8
        }
    } else if filter == 4 {
        for i in 0..row_bytes {
            var a: i32 = 0
            var b: i32 = 0
            var c: i32 = 0
            if i >= bpp {
                a = raw[cur + i - bpp] as i32
            }
            if has_prev {
                b = raw[prev + i] as i32
                if i >= bpp {
                    c = raw[prev + i - bpp] as i32
                }
            }
            raw[cur + i] = raw[cur + i] +% pngPaeth(a, b, c)
        }
    } else {
        return ImageError.Invalid
    }
}

fn pngPaeth(a: i32, b: i32, c: i32) u8 {
    let p = a + b - c
    var pa = p - a
    var pb = p - b
    var pc = p - c
    if pa < 0 {
        pa = -pa
    }
    if pb < 0 {
        pb = -pb
    }
    if pc < 0 {
        pc = -pc
    }
    if pa <= pb && pa <= pc {
        return a as u8
    }
    if pb <= pc {
        return b as u8
    }
    return c as u8
}

// Sample `i` of an unfiltered row, at its own depth.
fn pngSample(row: []u8, i: usize, depth: usize) u32 {
    if depth == 8 {
        return row[i] as u32
    }
    if depth == 16 {
        return (row[i * 2] as u32 << 8) | row[i * 2 + 1] as u32
    }
    // 1, 2 or 4 bits, the leftmost pixel in the high bits.
    let bit = i * depth
    let shift = (8 - depth - bit % 8) as u32
    return ((row[bit / 8] as u32) >> shift) & ((1 << depth as u32) - 1)
}

// A sample scaled to 8 bits: low depths are replicated (a 4-bit 0xA is
// 0xAA), 16-bit samples keep the high byte.
fn pngTo8(v: u32, depth: usize) u8 {
    if depth == 16 {
        return (v >> 8) as u8
    }
    if depth == 4 {
        return (v * 17) as u8
    }
    if depth == 2 {
        return (v * 85) as u8
    }
    if depth == 1 {
        return (v * 255) as u8
    }
    return v as u8
}

// Writes the `count` pixels of an unfiltered row to `pixels`, from
// pixel `base + x0` every `dx` pixels.
fn pngExpandRow(hd: *PngHeader, row: []u8, count: usize, pixels: []mut u8, base: usize, x0: usize, dx: usize) {
    let d = hd.depth
    if d == 8 && !hd.has_key && (hd.color == 2 || hd.color == 6) {
        // The common case, without the per-sample calls (this loop runs
        // for every pixel in the browser's debug build).
        var at = (base + x0) * 4
        let step = dx * 4
        var i: usize = 0
        let alpha = hd.color == 6
        for x in 0..count {
            pixels[at] = row[i]
            pixels[at + 1] = row[i + 1]
            pixels[at + 2] = row[i + 2]
            if alpha {
                pixels[at + 3] = row[i + 3]
                i += 4
            } else {
                pixels[at + 3] = 255
                i += 3
            }
            at += step
        }
        return
    }
    for x in 0..count {
        let at = (base + x0 + x * dx) * 4
        var r: u8 = 0
        var g: u8 = 0
        var b: u8 = 0
        var a: u8 = 255
        if hd.color == 0 {
            let v = pngSample(row, x, d)
            r = pngTo8(v, d)
            g = r
            b = r
            if hd.has_key && v == hd.key_r {
                a = 0
            }
        } else if hd.color == 2 {
            let sr = pngSample(row, x * 3, d)
            let sg = pngSample(row, x * 3 + 1, d)
            let sb = pngSample(row, x * 3 + 2, d)
            r = pngTo8(sr, d)
            g = pngTo8(sg, d)
            b = pngTo8(sb, d)
            if hd.has_key && sr == hd.key_r && sg == hd.key_g && sb == hd.key_b {
                a = 0
            }
        } else if hd.color == 3 {
            let index = pngSample(row, x, d) as usize
            // An index past the palette is opaque black.
            if index < hd.palette_len {
                r = hd.palette[index * 4]
                g = hd.palette[index * 4 + 1]
                b = hd.palette[index * 4 + 2]
                a = hd.palette[index * 4 + 3]
            }
        } else if hd.color == 4 {
            r = pngTo8(pngSample(row, x * 2, d), d)
            g = r
            b = r
            a = pngTo8(pngSample(row, x * 2 + 1, d), d)
        } else {
            r = pngTo8(pngSample(row, x * 4, d), d)
            g = pngTo8(pngSample(row, x * 4 + 1, d), d)
            b = pngTo8(pngSample(row, x * 4 + 2, d), d)
            a = pngTo8(pngSample(row, x * 4 + 3, d), d)
        }
        pixels[at] = r
        pixels[at + 1] = g
        pixels[at + 2] = b
        pixels[at + 3] = a
    }
}
