// webp: the WebP container (RIFF): a simple file is one `VP8 ` (lossy,
// vp8.aye) or `VP8L` (lossless, vp8l.aye) chunk; an extended one starts
// with `VP8X` and may add an `ALPH` chunk (the alpha of a lossy image:
// raw or VP8L-compressed, with a prediction filter), metadata, or an
// animation, of which only the first frame is decoded (placed on a
// transparent canvas). ICC profiles, EXIF and XMP are skipped.

import std
import std.mem.Allocator

// The flag of VP8X for an animation.
let WEBP_FLAG_ANIMATION: u32 = 0x02

// The chunks of one image: the bitstream (VP8 or VP8L) and the alpha
// chunk of a lossy one.
struct WebpFrame {
    vp8: []u8
    vp8l: []u8
    alph: []u8
    has_vp8: bool
    has_vp8l: bool
    has_alph: bool
}

/// Decodes a WebP file (the first frame of an animation). Free the
/// result with `deinit`.
pub fn decodeWebp(alloc: Allocator, data: []u8) ImageError!Bitmap {
    if data.len < 12 || !std.mem.eql(data[0..4], "RIFF") || !std.mem.eql(data[8..12], "WEBP") {
        return ImageError.Invalid
    }
    // The RIFF size counts from byte 8; bytes after it are ignored.
    let riff = webpLe32(data, 4) as usize
    if riff < 4 {
        return ImageError.Invalid
    }
    var end = data.len
    if riff <= data.len - 8 {
        end = riff + 8
    }
    let body = data[12..end]
    if body.len < 8 {
        return ImageError.Invalid
    }
    let first = body[0..4]
    if !std.mem.eql(first, "VP8X") {
        var frame = webpEmptyFrame()
        try webpFrameChunks(body, &mut frame)
        if frame.has_alph {
            // ALPH needs VP8X.
            return ImageError.Invalid
        }
        return webpDecodeFrame(alloc, &frame)
    }
    // VP8X: flags (4 bytes), canvas width - 1 and height - 1 (3 bytes
    // each).
    let x = try webpChunk(body, 0)
    if x.body.len < 10 {
        return ImageError.Invalid
    }
    let flags = webpLe32(x.body, 0)
    let cw = webpLe24(x.body, 4) + 1
    let ch = webpLe24(x.body, 7) + 1
    try checkSize(cw, ch)
    let rest = body[x.next..]
    if flags & WEBP_FLAG_ANIMATION != 0 {
        return webpFirstFrame(alloc, rest, cw, ch)
    }
    var frame = webpEmptyFrame()
    try webpFrameChunks(rest, &mut frame)
    let bmp = try webpDecodeFrame(alloc, &frame)
    if bmp.width != cw || bmp.height != ch {
        var wrong = bmp
        wrong.deinit(alloc)
        return ImageError.Invalid
    }
    return bmp
}

fn webpEmptyFrame() WebpFrame {
    return WebpFrame { vp8: "", vp8l: "", alph: "", has_vp8: false, has_vp8l: false, has_alph: false }
}

// One chunk at `pos` of `chunks`: its kind, its body and where the next
// one starts (bodies are padded to an even size).
struct WebpChunk {
    kind: []u8
    body: []u8
    next: usize
}

fn webpChunk(chunks: []u8, pos: usize) ImageError!WebpChunk {
    if chunks.len - pos < 8 {
        return ImageError.Invalid
    }
    let size = webpLe32(chunks, pos + 4) as usize
    if size > chunks.len - pos - 8 {
        return ImageError.Invalid
    }
    var next = pos + 8 + size
    if size % 2 == 1 && next < chunks.len {
        next += 1
    }
    return WebpChunk { kind: chunks[pos..pos + 4], body: chunks[pos + 8..pos + 8 + size], next: next }
}

// The image chunks among `chunks`: the first VP8 or VP8L, and an ALPH
// before it. Other chunks are skipped.
fn webpFrameChunks(chunks: []u8, frame: *mut WebpFrame) ImageError!void {
    var pos: usize = 0
    while pos < chunks.len {
        let c = try webpChunk(chunks, pos)
        pos = c.next
        if std.mem.eql(c.kind, "ALPH") {
            if !frame.has_alph {
                frame.alph = c.body
                frame.has_alph = true
            }
        } else if std.mem.eql(c.kind, "VP8 ") {
            frame.vp8 = c.body
            frame.has_vp8 = true
            return
        } else if std.mem.eql(c.kind, "VP8L") {
            frame.vp8l = c.body
            frame.has_vp8l = true
            return
        }
    }
    return ImageError.Invalid
}

// The bitmap of one image: VP8L, or VP8 with the alpha of its ALPH
// chunk (opaque without one).
fn webpDecodeFrame(alloc: Allocator, frame: *WebpFrame) ImageError!Bitmap {
    if frame.has_vp8l {
        return vp8lDecode(alloc, frame.vp8l)
    }
    if !frame.has_vp8 {
        return ImageError.Invalid
    }
    var bmp = try vp8Decode(alloc, frame.vp8)
    errdefer bmp.deinit(alloc)
    if frame.has_alph {
        try webpAlpha(alloc, frame.alph, &mut bmp)
    }
    return bmp
}

// ALPH: a header byte (compression in bits 0-1, filter in bits 2-3,
// preprocessing in bits 4-5, which needs nothing here), then the alpha
// values, raw or as the green channel of a headerless VP8L image, and
// filtered: each value is stored as its difference from a prediction.
fn webpAlpha(alloc: Allocator, chunk: []u8, bmp: *mut Bitmap) ImageError!void {
    if chunk.len < 1 {
        return ImageError.Invalid
    }
    let w = bmp.width
    let h = bmp.height
    let method = chunk[0] & 3
    let filter = (chunk[0] >> 2) & 3
    if method > 1 {
        return ImageError.Invalid
    }
    let alpha = try alloc.alloc(0 as u8, w * h)
    defer alloc.free(alpha)
    if method == 0 {
        if chunk.len - 1 < w * h {
            return ImageError.Invalid
        }
        std.mem.copy(alpha, chunk[1..1 + w * h])
    } else {
        try vp8lDecodeAlpha(alloc, chunk[1..], w, h, alpha)
    }
    webpUnfilter(alpha, w, h, filter)
    let px = bmp.pixels
    for i in 0..w * h {
        px[i * 4 + 3] = alpha[i]
    }
}

// Undoes ALPH filter 1 (horizontal: the left value predicts), 2
// (vertical: the value above) or 3 (gradient: left + above - above
// left, clamped). The first value is predicted by 0, the rest of the
// first row by the left one, and the first column by the value above.
fn webpUnfilter(a: []mut u8, w: usize, h: usize, filter: u8) {
    if filter == 0 {
        return
    }
    for x in 1..w {
        a[x] = a[x] +% a[x - 1]
    }
    for y in 1..h {
        let row = y * w
        let up = row - w
        a[row] = a[row] +% a[up]
        for x in 1..w {
            var pred: u8 = 0
            if filter == 1 {
                pred = a[row + x - 1]
            } else if filter == 2 {
                pred = a[up + x]
            } else {
                let g = a[row + x - 1] as i32 + a[up + x] as i32 - a[up + x - 1] as i32
                pred = jpegClamp(g)
            }
            a[row + x] = a[row + x] +% pred
        }
    }
}

// An animation: the chunks after VP8X are ANIM, then ANMF frames. The
// first frame (an offset, a size, and its image chunks) is drawn on a
// transparent canvas.
fn webpFirstFrame(alloc: Allocator, chunks: []u8, cw: usize, ch: usize) ImageError!Bitmap {
    var pos: usize = 0
    while pos < chunks.len {
        let c = try webpChunk(chunks, pos)
        pos = c.next
        if !std.mem.eql(c.kind, "ANMF") {
            continue
        }
        if c.body.len < 16 {
            return ImageError.Invalid
        }
        let fx = webpLe24(c.body, 0) * 2
        let fy = webpLe24(c.body, 3) * 2
        let fw = webpLe24(c.body, 6) + 1
        let fh = webpLe24(c.body, 9) + 1
        if fx + fw > cw || fy + fh > ch {
            return ImageError.Invalid
        }
        var frame = webpEmptyFrame()
        try webpFrameChunks(c.body[16..], &mut frame)
        let img = try webpDecodeFrame(alloc, &frame)
        defer img.deinit(alloc)
        if img.width != fw || img.height != fh {
            return ImageError.Invalid
        }
        if fx == 0 && fy == 0 && fw == cw && fh == ch {
            let copy = try newBitmap(alloc, cw, ch)
            std.mem.copy(copy.pixels, img.pixels)
            return copy
        }
        let canvas = try newBitmap(alloc, cw, ch)
        for y in 0..fh {
            let from = y * fw * 4
            let to = ((fy + y) * cw + fx) * 4
            std.mem.copy(canvas.pixels[to..to + fw * 4], img.pixels[from..from + fw * 4])
        }
        return canvas
    }
    return ImageError.Invalid
}

fn webpLe32(b: []u8, at: usize) u32 {
    return b[at] as u32 | (b[at + 1] as u32 << 8) | (b[at + 2] as u32 << 16) | (b[at + 3] as u32 << 24)
}

fn webpLe24(b: []u8, at: usize) usize {
    return b[at] as usize | (b[at + 1] as usize << 8) | (b[at + 2] as usize << 16)
}
