// agent: the browser without pixels, for AI agents (docs/browser.md, B7).
//
// - session.ore: a `Session`: a tab (engine.Tab: the page shown and its
//   history) and what the agent keeps about the page: where its nodes
//   are (laid out with the fixed-metric font) and their refs. The focus
//   and the state of form controls are the page's (`doc.controls`), as
//   in the window.
// - a11y.ore: the accessibility tree (`snapshot`) with refs `e1, e2, ...`.
// - markdown.ore: the main content as Markdown (`read`).
// - actions.ore: navigate, back, forward, reload, click, type, select,
//   press, scroll, find, wait, eval; snapshot diffs.
// - scripts.ore: events for the actions, eval and wait, and what
//   follows when scripts ran (navigations, layout, focus).
// - json.ore: a JSON parser and writer.
// - server.ore: `anyknown agent` (JSON lines) and `anyknown mcp` (MCP over
//   stdio), and `anyknown dump --a11y|--md`.
// - shared.ore: the agents of a window (`anyknown --agent-socket`,
//   ui/agents.ore): the same protocols on the window's tabs, and the
//   commands only a window has (tabs, the user's context).

import css
import dom
import dom.NodeId
import engine
import engine.Page
import font
import layout
import std
import std.list.List
import std.map.IntMap
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url
import url.Url

/// A node of a document of the tab: of the page shown, or of the page
/// of one of its frames.
pub struct RefNode {
    page: *mut Page
    node: NodeId
}

// A ref: the id of the page of its node, and the node.
struct RefEntry {
    page_id: u32
    node: NodeId
}

// The key of node `n` of page `p` in `Session.rects` and `ref_of`.
fn nodeKey(p: *Page, n: NodeId) u64 {
    return ((p.id as u64) << 32) | (n.index as u64)
}

/// A rectangle in document coordinates (px).
pub struct Rect {
    x: f64
    y: f64
    w: f64
    h: f64
}

/// The state of one agent: a tab, what the agent knows of the page it
/// shows, and what the page's scripts would have seen (recorded events).
pub struct Session {
    alloc: Allocator
    // Owned (allocated by the session).
    tab: *mut engine.Tab
    // Measures text for layouts: the fixed-metric font, so that boxes do
    // not depend on the fonts of the system; in a window, the window's
    // measurer (`measure`), so that the agent sees the human's layout.
    font: font.Fixed
    measure: ?dyn font.Measurer
    // The system's fonts, to draw text in screenshots (screenshot.ore):
    // the window's, or opened at the first screenshot (`own_system`);
    // null when there are none.
    system: ?*mut font.System
    own_system: bool
    tried_system: bool
    media: css.Media
    // Node (`nodeKey`) to the border box of its boxes and fragments, in
    // the coordinates of the document shown (a frame's nodes too).
    rects: IntMap(u64, Rect)
    // Refs: `refs[i]` is the node of ref number `ref_base + i`.
    ref_base: u32
    refs: List(RefEntry)
    ref_of: IntMap(u64, u32)
    // The id of the page whose element the agent focused last (a frame's
    // for a field in a frame); `press` acts there.
    focus_page: u32
    // The number of the next ref: refs are unique in a session, so a ref
    // of an old page is never taken for another node.
    next_ref: u32
    // Owned descriptions of clicks, key presses and submissions that
    // scripts will see once they run.
    events: List([]u8)
    // In a window (shared.ore): what the window does for its agents, and
    // the connection served now; `later` is set when the window answers
    // the request afterwards (a `wait`).
    host: ?dyn Host
    conn: usize
    later: bool
    // Documents the session gave new refs for (`newDocument`).
    loads: u64
}

fn newSession(alloc: Allocator, width: f64, height: f64) AllocError!Session {
    let tab = try alloc.create(engine.Tab.init(alloc))
    return Session {
        alloc: alloc,
        tab: tab,
        font: font.Fixed.init(),
        measure: null,
        system: null,
        own_system: false,
        tried_system: false,
        media: css.Media { width: width, height: height },
        rects: IntMap(u64, Rect).init(alloc),
        ref_base: 1,
        refs: List(RefEntry).init(alloc),
        ref_of: IntMap(u64, u32).init(alloc),
        focus_page: 0,
        next_ref: 1,
        events: List([]u8).init(alloc),
        host: null,
        conn: 0,
        later: false,
        loads: 0,
    }
}

/// A session for a tab of a window: its layouts measure text with the
/// window's `measure`, in a viewport of `width` x `height` px (the
/// window updates `media` when it is resized); screenshots draw text with
/// the window's `system` fonts.
pub fn newWindowSession(alloc: Allocator, measure: dyn font.Measurer, system: ?*mut font.System, width: f64, height: f64) AllocError!Session {
    var s = try newSession(alloc, width, height)
    s.measure = measure
    s.system = system
    s.tried_system = true
    return s
}

pub fn freeSession(s: *mut Session) {
    s.tab.deinit()
    s.alloc.destroy(s.tab)
    s.rects.deinit()
    s.refs.deinit()
    s.ref_of.deinit()
    for e in s.events.items() {
        s.alloc.free(e)
    }
    s.events.deinit()
    if s.own_system {
        if s.system |sys| {
            sys.deinit()
            s.alloc.destroy(sys)
        }
    }
}

fn recordEvent(s: *mut Session, what: []u8) AllocError!void {
    let copy = try s.alloc.alloc(0 as u8, what.len)
    std.mem.copy(copy, what)
    try s.events.append(copy)
}

// ---- the page shown

/// After the tab shows a new document: forgets the refs of the old one,
/// lays it out and scrolls where the tab wants.
fn newDocument(s: *mut Session) AllocError!void {
    s.refs.clear()
    s.ref_of.deinit()
    s.ref_of = IntMap(u64, u32).init(s.alloc)
    s.focus_page = 0
    s.ref_base = s.next_ref
    s.loads += 1
    try relayout(s)
    s.tab.settle(maxScroll(s))
}

/// Lays the page out again (after it was loaded, or after the DOM
/// changed), and finds the rectangles of its nodes.
fn relayout(s: *mut Session) AllocError!void {
    let p = s.tab.page.?
    try p.restyle()
    if s.measure |m| {
        try p.layoutPage(m, s.media.width, s.media.height)
    } else {
        try p.layoutPage(&mut s.font, s.media.width, s.media.height)
    }
    s.rects.deinit()
    s.rects = IntMap(u64, Rect).init(s.alloc)
    try addRects(s, p, 0.0, 0.0)
}

// The rectangles of the nodes of `p`, whose document starts at (`ox`,
// `oy`) of the document shown; then those of its frames.
fn addRects(s: *mut Session, p: *mut Page, ox: f64, oy: f64) AllocError!void {
    let t = p.tree orelse return
    for i in 0..t.boxes.len() {
        let b = t.bx(i).*
        if b.node |n| {
            if b.kind != layout.BoxKind.Inline && b.kind != layout.BoxKind.Text && b.kind != layout.BoxKind.LineBreak {
                try addRect(s, p, n, Rect { x: ox + b.ax, y: oy + b.ay, w: b.w, h: b.h })
            }
        }
        if layout.hasInlineContent(t, i) {
            let cx = ox + b.ax + b.border[3] + b.padding[3]
            let cy = oy + b.ay + b.border[0] + b.padding[0]
            for li in b.line_start..b.line_end {
                let line = t.lines.items()[li]
                for fi in line.frag_start..line.frag_end {
                    let f = t.frags.items()[fi]
                    if f.kind != layout.FragKind.Atomic {
                        if t.bx(f.box).node |fn_node| {
                            try addRect(s, p, fn_node, Rect { x: cx + f.x, y: cy + f.y, w: f.w, h: f.h })
                        }
                    }
                }
            }
        }
    }
    for k in 0..p.frames.len() {
        let r = engine.frameRect(p, k) orelse continue
        let f = p.frames.items()[k]
        try addRects(s, f.page, ox + r.x, oy + r.y - f.scroll)
    }
}

fn addRect(s: *mut Session, p: *Page, n: NodeId, r: Rect) AllocError!void {
    let key = nodeKey(p, n)
    if s.rects.getPtr(key) |old| {
        let x0 = minF(old.x, r.x)
        let y0 = minF(old.y, r.y)
        let x1 = maxF(old.x + old.w, r.x + r.w)
        let y1 = maxF(old.y + old.h, r.y + r.h)
        old.* = Rect { x: x0, y: y0, w: x1 - x0, h: y1 - y0 }
        return
    }
    try s.rects.put(key, r)
}

fn minF(a: f64, b: f64) f64 {
    if a < b {
        return a
    }
    return b
}

fn maxF(a: f64, b: f64) f64 {
    if a > b {
        return a
    }
    return b
}

/// The rectangle of node `n` of page `p` (in the coordinates of the
/// document shown): of its own boxes, else of its nearest ancestor (in
/// the flat tree) that has one.
fn rectOf(s: *Session, p: *Page, n: NodeId) ?Rect {
    var cur: ?NodeId = n
    while cur |c| {
        if s.rects.get(nodeKey(p, c)) |r| {
            return r
        }
        cur = dom.flatParent(&p.doc, c)
    }
    return null
}

/// The height of the document's content.
fn docHeight(s: *Session) f64 {
    if s.tab.page |p| {
        if p.tree |t| {
            if t.root |r| {
                let b = t.boxes.items()[r]
                return b.ay + b.h + b.margin[2]
            }
        }
    }
    return 0.0
}

fn maxScroll(s: *Session) f64 {
    return maxF(0.0, docHeight(s) - s.media.height)
}

/// Is `r` outside the viewport (scrolled to the tab's offset)?
fn offscreen(s: *Session, r: Rect) bool {
    return r.y + r.h <= s.tab.scroll || r.y >= s.tab.scroll + s.media.height
}

/// `s` with runs of ASCII whitespace as one space, trimmed.
fn collapse(alloc: Allocator, s: []u8) AllocError![]u8 {
    var b = text.Builder.init(alloc)
    defer b.deinit()
    var space = false
    for c in s {
        if layout.isWhite(c) {
            space = b.len() > 0
        } else {
            if space {
                try b.appendByte(' ')
                space = false
            }
            try b.appendByte(c)
        }
    }
    let out = try b.toOwned()
    return out
}

// ---- refs

/// The ref number of node `n` of page `p`, given one if it has none.
fn refFor(s: *mut Session, p: *Page, n: NodeId) AllocError!u32 {
    let key = nodeKey(p, n)
    if s.ref_of.get(key) |r| {
        return r
    }
    let r = s.next_ref
    try s.refs.append(RefEntry { page_id: p.id, node: n })
    try s.ref_of.put(key, r)
    s.next_ref += 1
    return r
}

/// The ref number of node `n` of page `p`, if it has one.
fn refOf(s: *Session, p: *Page, n: NodeId) ?u32 {
    return s.ref_of.get(nodeKey(p, n))
}

/// The node of the ref `name` ("e12" or "12") on the page shown or in
/// one of its frames.
fn nodeOfRef(s: *Session, name: []u8) ?RefNode {
    var digits = text.trim(name)
    if digits.len > 0 && (digits[0] == 'e' || digits[0] == 'E') {
        digits = digits[1..]
    }
    let n = text.parseInt(digits) catch |e| {
        return null
    }
    if n < s.ref_base as i64 {
        return null
    }
    let i = (n - s.ref_base as i64) as usize
    if i >= s.refs.len() {
        return null
    }
    let e = s.refs.items()[i]
    let top = s.tab.page orelse return null
    // The frame may show another document now.
    let p = engine.findPage(top, e.page_id) orelse return null
    // Scripts may have removed (and freed) the node.
    if !p.doc.isLive(e.node) {
        return null
    }
    return RefNode { page: p, node: e.node }
}

// ---- URLs

/// The URL an agent means by `target`: relative to the current page
/// (which an absolute URL is too); without a page, as typed in an
/// address bar (`engine.urlOfInput`: a URL, a file path, a host name).
fn targetUrl(s: *Session, alloc: Allocator, target: []u8) AllocError!?Url {
    let t = text.trim(target)
    if t.len == 0 {
        return null
    }
    if s.tab.page |p| {
        let r = url.resolve(alloc, &p.url, t) catch |e| {
            return null
        }
        return r
    }
    let u = engine.urlOfInput(alloc, t) catch |e| {
        return null
    }
    return u
}

/// `href` resolved against the page, or `href` itself when it does not
/// resolve.
fn absoluteHref(p: *Page, alloc: Allocator, href: []u8) AllocError![]u8 {
    let t = text.trim(href)
    let r = p.resolve(alloc, t) catch |e| {
        return t
    }
    return r.href
}
