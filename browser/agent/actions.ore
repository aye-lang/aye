// Actions on a session: navigate, back, forward, reload, click, type,
// select, press, scroll, wait, eval, and find. Each returns an `Outcome`: a
// short message, whether a new document is shown, and for actions that
// stay on the document, the lines of the snapshot that changed.
//
// Form controls keep their state where the window keeps it (the page's
// `doc.controls`); a click on a submit button, or `type` with `submit`,
// submits the form through the engine (engine/forms.ore) and loads the
// response. Clicks, typing, key presses, selections and submissions fire
// their events at the page's scripts first (scripts.ore); a canceled
// click (or submit, or keydown) skips the default action. Clicks and key
// presses are also recorded in `Session.events`.

import dom
import dom.Document
import dom.Kind
import dom.NodeId
import engine
import engine.Page
import html
import net
import std
import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url
import url.Url

pub enum Action {
    Navigate { target: []u8 }
    Back
    Forward
    Reload
    Click { ref: []u8 }
    Type { ref: []u8, input: []u8, submit: bool }
    Select { ref: []u8, option: []u8 }
    Press { key: []u8 }
    // To the element `ref`, or by `dy` px when `ref` is empty.
    Scroll { ref: []u8, dy: f64 }
    // For an element matching `selector`, or `ms` of the page's time
    // (neither: until no timer is left).
    Wait { selector: []u8, ms: f64 }
    Eval { src: []u8 }
}

pub struct Outcome {
    ok: bool
    // What happened, or why not.
    message: []u8
    // A new document is shown.
    navigated: bool
    // The snapshot lines that changed ("- old" and "+ new"), for actions
    // that stayed on the document.
    diff: []u8
}

fn done(message: []u8) Outcome {
    return Outcome { ok: true, message: message, navigated: false, diff: "" }
}

fn failed(message: []u8) Outcome {
    return Outcome { ok: false, message: message, navigated: false, diff: "" }
}

/// Runs `act`; for an action that stays on the document, also the
/// snapshot diff. Everything returned is in `tmp`.
fn perform(s: *mut Session, tmp: Allocator, act: Action) AllocError!Outcome {
    let before_page = s.tab.page
    var before: []u8 = ""
    if before_page != null {
        before = try snapshotText(s, tmp, false)
    }
    var o = try applyAction(s, tmp, act)
    try settleScripts(s, tmp, &mut o)
    if o.ok && !o.navigated && before_page != null && s.tab.page == before_page {
        let after = try snapshotText(s, tmp, false)
        o.diff = try diffLines(tmp, before, after)
    }
    return o
}

/// The snapshot of the page shown.
fn snapshotText(s: *mut Session, tmp: Allocator, boxes: bool) AllocError![]u8 {
    let ax = try buildAx(s, tmp)
    var out = text.Builder.init(tmp)
    try writeAxText(&ax, &mut out, boxes)
    return out.bytes()
}

fn applyAction(s: *mut Session, tmp: Allocator, act: Action) AllocError!Outcome {
    return match act {
        .Navigate { target } => navigate(s, tmp, target)
        .Back => moveInHistory(s, tmp, -1)
        .Forward => moveInHistory(s, tmp, 1)
        .Reload => moveInHistory(s, tmp, 0)
        .Click { ref } => click(s, tmp, ref)
        .Type { ref, input, submit } => typeInto(s, tmp, ref, input, submit)
        .Select { ref, option } => selectOption(s, tmp, ref, option)
        .Press { key } => press(s, tmp, key)
        .Scroll { ref, dy } => scroll(s, tmp, ref, dy)
        .Wait { selector, ms } => waitFor(s, tmp, selector, ms)
        .Eval { src } => evalScript(s, tmp, src)
    }
}

// ---- navigation

fn navigate(s: *mut Session, tmp: Allocator, target: []u8) AllocError!Outcome {
    let dest = try targetUrl(s, tmp, target)
    if dest |w| {
        return goTo(s, tmp, &w)
    }
    return failed(try concat(tmp, "not a URL: ", target, ""))
}

/// Shows `target` in a new history entry (navigate, links): in the
/// document when only the fragment differs, else by loading it.
fn goTo(s: *mut Session, tmp: Allocator, target: *Url) AllocError!Outcome {
    if s.tab.sameDocument(target) {
        try s.tab.push(target, null)
        s.tab.settle(maxScroll(s))
        return done(try concat(tmp, "scrolled to #", target.fragment, ""))
    }
    let p = try engine.load(s.alloc, target)
    if p.failure.len > 0 {
        return refused(tmp, p)
    }
    try s.tab.push(target, p)
    return opened(s, tmp)
}

/// Back (`step` -1), forward (1) or reload (0).
fn moveInHistory(s: *mut Session, tmp: Allocator, step: i64) AllocError!Outcome {
    if s.tab.page == null {
        return failed("no page: navigate first")
    }
    let href = s.tab.hrefAt(step)
    if href.len == 0 {
        if step < 0 {
            return failed("no previous page in the history")
        }
        return failed("no next page in the history")
    }
    let target = url.parse(tmp, href) catch |e| {
        return failed(try concat(tmp, "not a URL: ", href, ""))
    }
    let p = try engine.load(s.alloc, &target)
    if p.failure.len > 0 {
        return refused(tmp, p)
    }
    try s.tab.moveTo(step, p)
    return opened(s, tmp)
}

// The error page of a fetch that failed: the agent is told why instead,
// and the tab stays where it is.
fn refused(tmp: Allocator, p: *mut Page) AllocError!Outcome {
    let why = try concat(tmp, "cannot fetch ", p.url.href, try concat(tmp, ": ", p.failure, ""))
    p.destroy()
    return failed(why)
}

// After the tab moved to a new page: lays it out, gives the refs in
// document order (before anyone asks), and says what was loaded.
fn opened(s: *mut Session, tmp: Allocator) AllocError!Outcome {
    try newDocument(s)
    try buildAx(s, tmp)
    let p = s.tab.page.?
    var msg = text.Builder.init(tmp)
    try msg.append("loaded ")
    try msg.append(p.url.href)
    if p.status != 200 {
        try msg.append(" (status ")
        try msg.appendInt(p.status)
        try msg.appendByte(')')
    }
    return Outcome { ok: true, message: msg.bytes(), navigated: true, diff: "" }
}

// ---- elements

/// `a`, `b` and `c` joined, in `tmp`.
fn concat(tmp: Allocator, a: []u8, b: []u8, c: []u8) AllocError![]u8 {
    var out = text.Builder.init(tmp)
    try out.append(a)
    try out.append(b)
    try out.append(c)
    return out.bytes()
}

/// The page and the node of `ref`, or why there is none.
struct Target {
    page: ?*mut Page
    node: ?NodeId
    why: []u8
}

fn findTarget(s: *mut Session, tmp: Allocator, ref: []u8) AllocError!Target {
    if s.tab.page |p| {
        if nodeOfRef(s, ref) |n| {
            return Target { page: p, node: n, why: "" }
        }
        let why = try concat(tmp, "unknown ref ", ref, ": take a new snapshot (refs belong to one document)")
        return Target { page: null, node: null, why: why }
    }
    return Target { page: null, node: null, why: "no page: navigate first" }
}

/// `role "name" [eN]` of `el`.
fn describeNode(s: *mut Session, tmp: Allocator, el: NodeId) AllocError![]u8 {
    var ax = try newAx(s, tmp)
    var out = text.Builder.init(tmp)
    var role = roleOf(&ax, el)
    if role.len == 0 || text.eql(role, "skip") || text.eql(role, "generic-clickable") {
        role = "generic"
    }
    try out.append(role)
    let name = try nameOf(&mut ax, el, role)
    if name.len > 0 {
        try out.appendByte(' ')
        try quoteText(&mut out, name)
    }
    if s.ref_of.get(el.index) |r| {
        try out.append(" [e")
        try out.appendUint(r as u64)
        try out.appendByte(']')
    }
    return out.bytes()
}

fn nodeName(p: *Page, el: NodeId) []u8 {
    return p.doc.node(el).name
}

fn isTextInput(p: *Page, el: NodeId) bool {
    return dom.isTextField(&p.doc, el)
}

fn isCheckable(p: *Page, el: NodeId) bool {
    return dom.isCheckable(&p.doc, el)
}

fn isFocusable(p: *Page, el: NodeId) bool {
    let n = p.doc.node(el)
    if n.kind != Kind.Element {
        return false
    }
    if !rendered(p, el) || styleHidden(p, el) || isDisabled(p, el) {
        return false
    }
    if p.doc.attr(el, "tabindex") |v| {
        let i = text.parseInt(text.trim(v)) catch 0
        return i >= 0
    }
    if text.eql(n.name, "a") || text.eql(n.name, "area") {
        return p.doc.attr(el, "href") != null
    }
    return html.isIn(n.name, "button input select textarea summary")
}

fn removeAttr(doc: *mut Document, el: NodeId, name: []u8) {
    let n = doc.node(el)
    var k: usize = 0
    for i in 0..n.attrs.len {
        let at = n.attrs[i]
        if !text.eql(at.name, name) {
            n.attrs[k] = at
            k += 1
        }
    }
    n.attrs = n.attrs[0..k]
}

/// Records an event that forms or scripts will handle, and says so.
fn recordOn(s: *mut Session, tmp: Allocator, what: []u8, el: NodeId) AllocError![]u8 {
    let who = try describeNode(s, tmp, el)
    let ev = try concat(tmp, what, " ", who)
    try recordEvent(s, ev)
    return ev
}

// ---- click

fn click(s: *mut Session, tmp: Allocator, ref: []u8) AllocError!Outcome {
    let t = try findTarget(s, tmp, ref)
    let p = t.page orelse {
        return failed(t.why)
    }
    return clickNode(s, tmp, p, t.node.?)
}

fn clickNode(s: *mut Session, tmp: Allocator, p: *mut Page, el: NodeId) AllocError!Outcome {
    let who = try describeNode(s, tmp, el)
    if isDisabled(p, el) {
        return failed(try concat(tmp, "cannot click ", who, ": it is disabled"))
    }
    if isFocusable(p, el) {
        engine.setFocus(p, el)
    }
    if !(try fire(p, el, "click", "")) {
        return done(try concat(tmp, "clicked ", who, "; a script canceled the default action"))
    }
    // A link, or an element inside one.
    var cur: ?NodeId = el
    while cur |c| {
        if (p.doc.isElement(c, "a") || p.doc.isElement(c, "area")) && p.doc.attr(c, "href") != null {
            return followLink(s, tmp, p, c, who)
        }
        if p.doc.isElement(c, "button") || p.doc.isElement(c, "label") {
            break
        }
        cur = p.doc.parent(c)
    }
    if dom.isCheckable(&p.doc, el) || dom.isSubmitButton(&p.doc, el) || dom.isResetButton(&p.doc, el) {
        let act = try engine.activate(p, el)
        return activated(s, tmp, p, el, who, act)
    }
    if p.doc.attr(el, "role") |r| {
        if html.isIn(text.trim(r), "checkbox switch menuitemcheckbox") {
            if attrIs(p, el, "aria-checked", "true") {
                try p.doc.setAttr(el, "aria-checked", "false")
            } else {
                try p.doc.setAttr(el, "aria-checked", "true")
            }
            try relayout(s)
            try recordOn(s, tmp, "click on", el)
            return done(try concat(tmp, "toggled ", who, ""))
        }
    }
    if p.doc.isElement(el, "summary") {
        if p.doc.parent(el) |d| {
            if p.doc.isElement(d, "details") {
                if p.doc.attr(d, "open") != null {
                    removeAttr(&mut p.doc, d, "open")
                    try relayout(s)
                    return done(try concat(tmp, "collapsed ", who, ""))
                }
                try p.doc.setAttr(d, "open", "")
                try relayout(s)
                return done(try concat(tmp, "expanded ", who, ""))
            }
        }
    }
    if p.doc.isElement(el, "label") {
        if engine.labelControl(&p.doc, el) |control| {
            return clickNode(s, tmp, p, control)
        }
    }
    if p.doc.isElement(el, "option") {
        if dom.selectOf(&p.doc, el) |sel| {
            return chooseOption(s, tmp, p, sel, el)
        }
    }
    if isTextInput(p, el) || p.doc.isElement(el, "select") {
        try relayout(s)
        return done(try concat(tmp, "focused ", who, ""))
    }
    return clickedOnly(s, tmp, p, el, who)
}

// A click with no default action: the scripts had it.
fn clickedOnly(s: *mut Session, tmp: Allocator, p: *mut Page, el: NodeId, who: []u8) AllocError!Outcome {
    try recordOn(s, tmp, "click on", el)
    if engine.hasScripts(p) {
        return done(try concat(tmp, "clicked ", who, ""))
    }
    return done(try concat(tmp, "clicked ", who, "; nothing happens until scripts run (recorded the click event)"))
}

// The outcome of the default action of a checkbox, radio button, submit
// or reset button.
fn activated(s: *mut Session, tmp: Allocator, p: *mut Page, el: NodeId, who: []u8, act: engine.Activation) AllocError!Outcome {
    match act {
        .Submit { form, submitter } => {
            return submitForm(s, tmp, p, form, submitter, try concat(tmp, "clicked ", who, ""))
        }
        .Follow { target } => {
            target.deinit(s.alloc)
        }
        .Changed => {
            try relayout(s)
            if dom.isCheckable(&p.doc, el) {
                if dom.isChecked(&p.doc, el) {
                    return done(try concat(tmp, "checked ", who, ""))
                }
                return done(try concat(tmp, "unchecked ", who, ""))
            }
            if dom.isResetButton(&p.doc, el) {
                return done(try concat(tmp, "clicked ", who, "; the form was reset"))
            }
        }
        _ => {}
    }
    // A button outside a form: only scripts would do something.
    try relayout(s)
    return clickedOnly(s, tmp, p, el, who)
}

/// Submits `form` (by `submitter`, or implicitly) and loads the
/// response in a new history entry. `what` says what led to it.
fn submitForm(s: *mut Session, tmp: Allocator, p: *mut Page, form: NodeId, submitter: ?NodeId, what: []u8) AllocError!Outcome {
    try recordOn(s, tmp, "submit of", form)
    if !(try fire(p, form, "submit", "")) {
        try relayout(s)
        return done(try concat(tmp, what, "; a script canceled the submission", ""))
    }
    return submitNow(s, tmp, p, form, submitter, what)
}

/// The submission itself (the submit event already fired).
fn submitNow(s: *mut Session, tmp: Allocator, p: *mut Page, form: NodeId, submitter: ?NodeId, what: []u8) AllocError!Outcome {
    let sub = (try engine.submitForm(p, form, submitter)) orelse {
        return done(try concat(tmp, what, "; the form does not submit anywhere", ""))
    }
    defer sub.deinit(s.alloc)
    var body = net.Body { content_type: sub.content_type, data: sub.body }
    var post: ?*net.Body = null
    if sub.post {
        post = &body
    }
    let loaded = try engine.loadWith(s.alloc, &sub.target, post)
    if loaded.failure.len > 0 {
        return refused(tmp, loaded)
    }
    try s.tab.push(&sub.target, loaded)
    let o = try opened(s, tmp)
    var msg = text.Builder.init(tmp)
    try msg.append(what)
    if sub.post {
        try msg.append("; submitted the form by POST to ")
        try msg.append(sub.target.href)
        try msg.append("; ")
    } else {
        try msg.append("; submitted the form: ")
    }
    try msg.append(o.message)
    return Outcome { ok: true, message: msg.bytes(), navigated: true, diff: "" }
}

fn followLink(s: *mut Session, tmp: Allocator, p: *mut Page, a: NodeId, who: []u8) AllocError!Outcome {
    let href = text.trim(p.doc.attr(a, "href").?)
    if text.startsWith(href, "javascript:") {
        try recordOn(s, tmp, "click on", a)
        return done(try concat(tmp, "clicked ", who, "; it runs a script, which is not supported yet"))
    }
    let target = p.follow(tmp, href) catch |e| {
        return failed(try concat(tmp, "cannot follow ", who, ": not a URL"))
    }
    let o = try goTo(s, tmp, &target)
    if !o.ok {
        return o
    }
    var msg = text.Builder.init(tmp)
    try msg.append("clicked ")
    try msg.append(who)
    try msg.append("; ")
    try msg.append(o.message)
    return Outcome { ok: true, message: msg.bytes(), navigated: o.navigated, diff: "" }
}

// ---- type and select

fn typeInto(s: *mut Session, tmp: Allocator, ref: []u8, input: []u8, submit: bool) AllocError!Outcome {
    let t = try findTarget(s, tmp, ref)
    let p = t.page orelse {
        return failed(t.why)
    }
    let el = t.node.?
    let who = try describeNode(s, tmp, el)
    if !isTextInput(p, el) {
        return failed(try concat(tmp, "cannot type into ", who, ": it is not a text field"))
    }
    if isDisabled(p, el) || p.doc.attr(el, "readonly") != null {
        return failed(try concat(tmp, "cannot type into ", who, ": it is disabled or read-only"))
    }
    try dom.setValue(&mut p.doc, el, input)
    engine.setFocus(p, el)
    try fireChange(p, el)
    try relayout(s)
    var msg = text.Builder.init(tmp)
    try msg.append("typed ")
    try quoteText(&mut msg, input)
    try msg.append(" into ")
    try msg.append(who)
    if submit {
        return submitFrom(s, tmp, p, el, msg.bytes())
    }
    return done(msg.bytes())
}

/// Enter in a text field: submits its form (implicit submission).
fn submitFrom(s: *mut Session, tmp: Allocator, p: *mut Page, el: NodeId, what: []u8) AllocError!Outcome {
    let act = try engine.implicitSubmit(p, el)
    match act {
        .Submit { form, submitter } => {
            return submitForm(s, tmp, p, form, submitter, what)
        }
        _ => {}
    }
    if dom.formOwner(&p.doc, el) == null {
        return done(try concat(tmp, what, "; it is not in a form: nothing to submit", ""))
    }
    return done(try concat(tmp, what, "; the form has no submit button to submit it with", ""))
}

fn selectOption(s: *mut Session, tmp: Allocator, ref: []u8, option: []u8) AllocError!Outcome {
    let t = try findTarget(s, tmp, ref)
    let p = t.page orelse {
        return failed(t.why)
    }
    let sel = t.node.?
    let who = try describeNode(s, tmp, sel)
    if !p.doc.isElement(sel, "select") {
        return failed(try concat(tmp, "cannot select in ", who, ": it is not a select"))
    }
    if isDisabled(p, sel) {
        return failed(try concat(tmp, "cannot select in ", who, ": it is disabled"))
    }
    var ax = try newAx(s, tmp)
    let want = text.trim(option)
    var found: ?NodeId = null
    var names = text.Builder.init(tmp)
    // By value or label, exactly first, then ignoring case.
    for pass in 0..2 {
        var cur = p.doc.following(sel, sel)
        while cur |c| {
            if p.doc.isElement(c, "option") && found == null {
                let label = try optionLabel(&mut ax, c)
                var value = label
                if p.doc.attr(c, "value") |v| {
                    value = v
                }
                if pass == 0 {
                    if names.len() > 0 {
                        try names.append(", ")
                    }
                    try quoteText(&mut names, label)
                    if text.eql(label, want) || text.eql(value, want) {
                        found = c
                    }
                } else if text.eqlIgnoreCase(label, want) || text.eqlIgnoreCase(value, want) {
                    found = c
                }
            }
            cur = p.doc.following(c, sel)
        }
    }
    let opt = found orelse {
        var msg = text.Builder.init(tmp)
        try msg.append("no option ")
        try quoteText(&mut msg, want)
        try msg.append(" in ")
        try msg.append(who)
        try msg.append("; the options are ")
        try msg.append(names.bytes())
        return failed(msg.bytes())
    }
    return chooseOption(s, tmp, p, sel, opt)
}

fn chooseOption(s: *mut Session, tmp: Allocator, p: *mut Page, sel: NodeId, opt: NodeId) AllocError!Outcome {
    if isDisabled(p, opt) {
        return failed("that option is disabled")
    }
    try dom.selectOption(&mut p.doc, sel, opt)
    engine.setFocus(p, sel)
    try fireChange(p, sel)
    try relayout(s)
    var ax = try newAx(s, tmp)
    var msg = text.Builder.init(tmp)
    try msg.append("selected ")
    try quoteText(&mut msg, try optionLabel(&mut ax, opt))
    try msg.append(" in ")
    try msg.append(try describeNode(s, tmp, sel))
    return done(msg.bytes())
}

// ---- keys

/// A key press on the focused element: printable characters and
/// Backspace edit a text field, Enter follows a link, clicks a button
/// or submits; Space toggles; Tab and Shift+Tab move the focus;
/// PageDown, PageUp, Home, End, ArrowDown and ArrowUp scroll.
fn press(s: *mut Session, tmp: Allocator, key: []u8) AllocError!Outcome {
    let p = s.tab.page orelse {
        return failed("no page: navigate first")
    }
    if key.len == 0 {
        return failed("no key")
    }
    try recordEvent(s, try concat(tmp, "keydown ", key, ""))
    if !(try fire(p, keyTarget(p), "keydown", domKey(key))) {
        return done(try concat(tmp, "pressed ", key, "; a script canceled it"))
    }
    if text.eql(key, "Tab") || text.eql(key, "Shift+Tab") {
        return moveFocus(s, tmp, p, text.eql(key, "Tab"))
    }
    if p.doc.controls.focus |f| {
        let who = try describeNode(s, tmp, f)
        if isTextInput(p, f) {
            if text.eql(key, "Backspace") || text.eql(key, "Delete") {
                if text.eql(key, "Backspace") {
                    try dom.deleteBackward(&mut p.doc, f)
                } else {
                    try dom.deleteForward(&mut p.doc, f)
                }
                try fire(p, f, "input", "")
                try relayout(s)
                return done(try concat(tmp, "deleted a character in ", who, ""))
            }
            if text.eql(key, "ArrowLeft") || text.eql(key, "ArrowRight") || text.eql(key, "Home") || text.eql(key, "End") {
                var m = dom.Motion.Left
                if text.eql(key, "ArrowRight") {
                    m = dom.Motion.Right
                } else if text.eql(key, "Home") {
                    m = dom.Motion.Home
                } else if text.eql(key, "End") {
                    m = dom.Motion.End
                }
                try dom.moveCaret(&mut p.doc, f, m, false)
                return done(try concat(tmp, "moved the caret in ", who, ""))
            }
            if text.eql(key, "Enter") {
                if p.doc.isElement(f, "textarea") {
                    try dom.insertText(&mut p.doc, f, "\n")
                    try fire(p, f, "input", "")
                    try relayout(s)
                    return done(try concat(tmp, "new line in ", who, ""))
                }
                return submitFrom(s, tmp, p, f, try concat(tmp, "Enter in ", who, ""))
            }
            if isCharacter(key) {
                try dom.insertText(&mut p.doc, f, key)
                try fire(p, f, "input", key)
                try relayout(s)
                return done(try concat(tmp, "typed ", key, try concat(tmp, " into ", who, "")))
            }
        }
        if text.eql(key, "Enter") && !isCheckable(p, f) {
            return clickNode(s, tmp, p, f)
        }
        if (text.eql(key, " ") || text.eql(key, "Space")) && !p.doc.isElement(f, "a") {
            return clickNode(s, tmp, p, f)
        }
        if text.eql(key, "Escape") {
            engine.setFocus(p, null)
            return done(try concat(tmp, "left ", who, ""))
        }
    }
    var dy = 0.0
    if text.eql(key, "PageDown") || text.eql(key, " ") || text.eql(key, "Space") {
        dy = s.media.height * 0.875
    } else if text.eql(key, "PageUp") {
        dy = -s.media.height * 0.875
    } else if text.eql(key, "ArrowDown") {
        dy = 40.0
    } else if text.eql(key, "ArrowUp") {
        dy = -40.0
    } else if text.eql(key, "Home") {
        dy = -s.tab.scroll
    } else if text.eql(key, "End") {
        dy = maxScroll(s) - s.tab.scroll
    } else {
        return done(try concat(tmp, "pressed ", key, "; nothing to do (recorded the key event)"))
    }
    return scrollBy(s, tmp, dy)
}

// Where a key press goes: the focused element, else the body (else the
// document).
fn keyTarget(p: *mut Page) NodeId {
    if p.doc.controls.focus |f| {
        if p.doc.isLive(f) {
            return f
        }
    }
    if p.doc.documentElement() |root| {
        var cur = p.doc.firstChild(root)
        while cur |c| {
            if p.doc.isElement(c, "body") {
                return c
            }
            cur = p.doc.nextSibling(c)
        }
    }
    return p.doc.root
}

// KeyboardEvent.key of a key name of `press` ("Space" is " ").
fn domKey(key: []u8) []u8 {
    if text.eql(key, "Space") {
        return " "
    }
    if text.eql(key, "Shift+Tab") {
        return "Tab"
    }
    return key
}

// A key that types itself: one UTF-8 character.
fn isCharacter(key: []u8) bool {
    let d = text.decode(key)
    return d.len == key.len && d.code >= 0x20 && d.code != 0x7F
}

fn moveFocus(s: *mut Session, tmp: Allocator, p: *mut Page, forward: bool) AllocError!Outcome {
    var all = List(NodeId).init(tmp)
    var cur: ?NodeId = p.doc.root
    var at: ?usize = null
    while cur |h| {
        if isFocusable(p, h) {
            if p.doc.controls.focus |f| {
                if f == h {
                    at = all.len()
                }
            }
            try all.append(h)
        }
        cur = p.doc.following(h, p.doc.root)
    }
    if all.len() == 0 {
        return done("nothing on the page takes the focus")
    }
    var next: usize = 0
    if at |i| {
        if forward {
            next = (i + 1) % all.len()
        } else {
            next = (i + all.len() - 1) % all.len()
        }
    } else if !forward {
        next = all.len() - 1
    }
    let el = all.items()[next]
    engine.setFocus(p, el)
    try refFor(s, el)
    return done(try concat(tmp, "focused ", try describeNode(s, tmp, el), ""))
}

// ---- scroll

fn scroll(s: *mut Session, tmp: Allocator, ref: []u8, dy: f64) AllocError!Outcome {
    if ref.len == 0 {
        if s.tab.page == null {
            return failed("no page: navigate first")
        }
        return scrollBy(s, tmp, dy)
    }
    let t = try findTarget(s, tmp, ref)
    let p = t.page orelse {
        return failed(t.why)
    }
    let el = t.node.?
    let who = try describeNode(s, tmp, el)
    let r = rectOf(s, el) orelse {
        return failed(try concat(tmp, "cannot scroll to ", who, ": it has no box"))
    }
    scrollTo(s, r.y)
    return done(try scrollMessage(s, tmp, try concat(tmp, "scrolled to ", who, "")))
}

fn scrollBy(s: *mut Session, tmp: Allocator, dy: f64) AllocError!Outcome {
    scrollTo(s, s.tab.scroll + dy)
    return done(try scrollMessage(s, tmp, "scrolled"))
}

// Scrolls to `y`, kept within the document.
fn scrollTo(s: *mut Session, y: f64) {
    s.tab.scroll = y
    s.tab.clampScroll(maxScroll(s))
}

fn scrollMessage(s: *Session, tmp: Allocator, what: []u8) AllocError![]u8 {
    var b = text.Builder.init(tmp)
    try b.append(what)
    try b.append("; the viewport shows y ")
    try writeNumberTo(&mut b, s.tab.scroll)
    try b.append(" to ")
    try writeNumberTo(&mut b, s.tab.scroll + s.media.height)
    try b.append(" of ")
    try writeNumberTo(&mut b, maxF(docHeight(s), s.media.height))
    return b.bytes()
}

fn writeNumberTo(b: *mut text.Builder, v: f64) AllocError!void {
    try b.appendInt(std.math.round(v) as i64)
}

// ---- find

/// The places of `needle` in the visible text (ignoring ASCII case),
/// with the nearest element that has a ref; at most 20.
fn findText(s: *mut Session, tmp: Allocator, needle: []u8) AllocError!Outcome {
    let p = s.tab.page orelse {
        return failed("no page: navigate first")
    }
    let want = text.trim(needle)
    if want.len == 0 {
        return failed("nothing to find")
    }
    // Make sure every element that should have a ref has one.
    try buildAx(s, tmp)
    var out = text.Builder.init(tmp)
    var count: usize = 0
    var cur: ?NodeId = p.doc.root
    while cur |h| {
        let n = p.doc.node(h).*
        if n.kind == Kind.Element && (!rendered(p, h) || html.isIn(n.name, "script style template")) {
            cur = p.doc.followingSkip(h, p.doc.root)
            continue
        }
        if n.kind == Kind.Text && textVisible(p, h) {
            let flat = try collapse(tmp, n.data)
            var from: usize = 0
            while from < flat.len {
                let at = indexIgnoreCase(flat[from..], want) orelse break
                count += 1
                if count <= 20 {
                    try findLine(s, tmp, h, flat, from + at, want.len, count, &mut out)
                }
                from = from + at + want.len
            }
        }
        cur = p.doc.following(h, p.doc.root)
    }
    var msg = text.Builder.init(tmp)
    if count == 0 {
        try msg.append("no match for ")
        try quoteText(&mut msg, want)
        return done(msg.bytes())
    }
    try msg.appendUint(count as u64)
    if count == 1 {
        try msg.append(" match for ")
    } else {
        try msg.append(" matches for ")
    }
    try quoteText(&mut msg, want)
    if count > 20 {
        try msg.append(" (the first 20)")
    }
    try msg.appendByte('\n')
    try msg.append(out.bytes())
    return done(msg.bytes())
}

fn findLine(s: *mut Session, tmp: Allocator, t: NodeId, flat: []u8, at: usize, len: usize, count: usize, out: *mut text.Builder) AllocError!void {
    var lo = at
    var k: usize = 0
    while lo > 0 && k < 30 {
        lo -= 1
        k += 1
    }
    while lo > 0 && (flat[lo] & 0xC0) == 0x80 {
        lo -= 1
    }
    var hi = at + len
    k = 0
    while hi < flat.len && k < 30 {
        hi += 1
        k += 1
    }
    while hi < flat.len && (flat[hi] & 0xC0) == 0x80 {
        hi += 1
    }
    try out.appendUint(count as u64)
    try out.append(". \"")
    if lo > 0 {
        try out.append("…")
    }
    try out.append(flat[lo..hi])
    if hi < flat.len {
        try out.append("…")
    }
    try out.appendByte('"')
    // The nearest element around it that has a ref.
    let p = s.tab.page.?
    var cur = p.doc.parent(t)
    while cur |c| {
        if s.ref_of.get(c.index) |r| {
            try out.append(" in ")
            try out.append(try describeNode(s, tmp, c))
            break
        }
        cur = p.doc.parent(c)
    }
    if rectOf(s, t) |r| {
        if offscreen(s, r) {
            try out.append(" [offscreen]")
        }
    }
    try out.appendByte('\n')
}

fn indexIgnoreCase(hay: []u8, needle: []u8) ?usize {
    if needle.len > hay.len {
        return null
    }
    for i in 0..hay.len - needle.len + 1 {
        if text.eqlIgnoreCase(hay[i..i + needle.len], needle) {
            return i
        }
    }
    return null
}

// ---- diffs

/// The lines of `after` that differ from `before`, in order: removed
/// lines as "- old", added ones as "+ new" (a longest common subsequence
/// of lines stays out). Empty when nothing changed.
fn diffLines(tmp: Allocator, before: []u8, after: []u8) AllocError![]u8 {
    var a = List([]u8).init(tmp)
    var b = List([]u8).init(tmp)
    try splitLines(before, &mut a)
    try splitLines(after, &mut b)
    let x = a.items()
    let y = b.items()
    var head: usize = 0
    while head < x.len && head < y.len && text.eql(x[head], y[head]) {
        head += 1
    }
    var tail: usize = 0
    while tail < x.len - head && tail < y.len - head && text.eql(x[x.len - 1 - tail], y[y.len - 1 - tail]) {
        tail += 1
    }
    let xs = x[head..x.len - tail]
    let ys = y[head..y.len - tail]
    var out = text.Builder.init(tmp)
    let n = xs.len
    let m = ys.len
    if n * m > 4000000 {
        // Too big for the table: everything in between changed.
        for line in xs {
            try diffLine(&mut out, "- ", line)
        }
        for line in ys {
            try diffLine(&mut out, "+ ", line)
        }
        return out.bytes()
    }
    // lcs[i * (m + 1) + j]: the length of a longest common subsequence
    // of xs[i..] and ys[j..].
    let w = m + 1
    let lcs = try tmp.alloc(0 as u32, (n + 1) * w)
    var i = n
    while i > 0 {
        i -= 1
        var j = m
        while j > 0 {
            j -= 1
            if text.eql(xs[i], ys[j]) {
                lcs[i * w + j] = lcs[(i + 1) * w + j + 1] + 1
            } else if lcs[(i + 1) * w + j] >= lcs[i * w + j + 1] {
                lcs[i * w + j] = lcs[(i + 1) * w + j]
            } else {
                lcs[i * w + j] = lcs[i * w + j + 1]
            }
        }
    }
    var p: usize = 0
    var q: usize = 0
    while p < n || q < m {
        if p < n && q < m && text.eql(xs[p], ys[q]) {
            p += 1
            q += 1
        } else if p < n && (q == m || lcs[(p + 1) * w + q] >= lcs[p * w + q + 1]) {
            try diffLine(&mut out, "- ", xs[p])
            p += 1
        } else {
            try diffLine(&mut out, "+ ", ys[q])
            q += 1
        }
    }
    return out.bytes()
}

fn diffLine(out: *mut text.Builder, mark: []u8, line: []u8) AllocError!void {
    try out.append(mark)
    try out.append(line)
    try out.appendByte('\n')
}

fn splitLines(s: []u8, out: *mut List([]u8)) AllocError!void {
    var start: usize = 0
    for i in 0..s.len {
        if s[i] == '\n' {
            try out.append(s[start..i])
            start = i + 1
        }
    }
    if start < s.len {
        try out.append(s[start..])
    }
}
