// The page's scripts, seen from the agent: events for the agent's
// actions, `eval`, `wait`, and what happens after scripts ran (the
// navigation they asked for, a new layout, the focus they moved).
//
// Time is virtual: after an action, only timers already due run (a
// `setTimeout(f, 0)` chain); `wait` moves the page's clock forward,
// running the timers on the way.

import dom.NodeId
import engine
import engine.Page
import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url

// What `wait` without a selector or a time runs at most, in ms of the
// page's time.
let WAIT_IDLE_MS: f64 = 5000.0
let WAIT_SELECTOR_MS: f64 = 5000.0
// Navigations that scripts may chain after one action.
let MAX_SCRIPT_NAVIGATIONS: usize = 5

/// Fires `kind` (an event the prelude knows: click, input, change,
/// keydown with `key`...) at `el`; false when a listener canceled it.
/// The agent's own focus is what scripts see as activeElement.
fn fire(s: *mut Session, p: *mut Page, el: NodeId, kind: []u8, key: []u8) AllocError!bool {
    engine.setScriptFocus(p, s.focused)
    return engine.dispatchEvent(p, el, kind, key)
}

/// `input` then `change` at a control the agent changed.
fn fireChange(s: *mut Session, p: *mut Page, el: NodeId) AllocError!void {
    try fire(s, p, el, "input", "")
    try fire(s, p, el, "change", "")
}

/// After an action: runs the timers that are due, then does what the
/// scripts asked (a navigation, which `o` then reports) or lays the page
/// out again.
fn settleScripts(s: *mut Session, tmp: Allocator, o: *mut Outcome) AllocError!void {
    for round in 0..MAX_SCRIPT_NAVIGATIONS {
        let p = s.tab.page orelse return
        if !engine.hasScripts(p) {
            return
        }
        try engine.runDueTimers(p)
        if engine.scriptMovedFocus(p) {
            s.focused = engine.scriptFocus(p)
        }
        let nav = engine.takeNavigation(p)
        var step: i64 = 0
        match nav.kind {
            .None => {
                return relayout(s)
            }
            .To => {
                let href = try concat(tmp, nav.href, "", "")
                let target = url.parse(tmp, href) catch |e| {
                    return relayout(s)
                }
                let r = try goTo(s, tmp, &target)
                try merge(tmp, o, r)
                continue
            }
            .History => {
                step = nav.step
            }
            .Reload => {}
        }
        let r = try moveInHistory(s, tmp, step)
        try merge(tmp, o, r)
    }
}

// Adds what a navigation that scripts asked for did to `o`.
fn merge(tmp: Allocator, o: *mut Outcome, r: Outcome) AllocError!void {
    o.message = try concat(tmp, o.message, "; then a script navigated: ", r.message)
    if r.navigated {
        o.navigated = true
    }
}

/// `eval`: runs `src` in the page; the result as text.
fn evalScript(s: *mut Session, tmp: Allocator, src: []u8) AllocError!Outcome {
    let p = s.tab.page orelse return failed("no page: navigate first")
    var out = text.Builder.init(tmp)
    engine.setScriptFocus(p, s.focused)
    if try engine.evalInPage(p, src, &mut out) {
        return done(out.bytes())
    }
    return failed(out.bytes())
}

/// `wait`: for an element matching `selector` (at most `ms`, 5 s by
/// default), for `ms` of the page's time, or (neither) until no timer
/// is left (at most 5 s).
fn waitFor(s: *mut Session, tmp: Allocator, selector: []u8, ms: f64) AllocError!Outcome {
    let p = s.tab.page orelse return failed("no page: navigate first")
    let start = engine.pageClock(p)
    if selector.len > 0 {
        if !(try engine.isSelector(p, selector)) {
            return failed(try concat(tmp, "not a CSS selector: ", selector, ""))
        }
        var limit = WAIT_SELECTOR_MS
        if ms > 0.0 {
            limit = ms
        }
        while true {
            if try engine.querySelectorIn(p, selector) |el| {
                try relayout(s)
                var msg = text.Builder.init(tmp)
                try msg.append("found ")
                try msg.append(try describeNode(s, tmp, el))
                try msg.append(" after ")
                try writeNumberTo(&mut msg, engine.pageClock(p) - start)
                try msg.append(" ms")
                return done(msg.bytes())
            }
            if !(try engine.runNextTimer(p, start + limit)) {
                break
            }
            if engine.takeNavigation(p).kind != engine.NavKind.None {
                return failed("a script navigated while waiting")
            }
        }
        engine.setPageClock(p, start + limit)
        try relayout(s)
        var why = text.Builder.init(tmp)
        try why.append("timed out after ")
        try writeNumberTo(&mut why, limit)
        try why.append(" ms waiting for ")
        try why.append(selector)
        return failed(why.bytes())
    }
    if ms > 0.0 {
        try engine.advanceClock(p, ms)
    } else {
        try engine.runUntilIdle(p, WAIT_IDLE_MS)
    }
    var msg = text.Builder.init(tmp)
    try msg.append("waited ")
    try writeNumberTo(&mut msg, engine.pageClock(p) - start)
    try msg.append(" ms")
    if engine.msUntilNextTimer(p) == null {
        try msg.append("; no timer is left")
    }
    return done(msg.bytes())
}

/// The console messages of the page since the last response, in `tmp`.
fn consoleLines(s: *mut Session, tmp: Allocator) AllocError![][]u8 {
    var lines = List([]u8).init(tmp)
    if s.tab.page |p| {
        try engine.takeConsole(p, tmp, &mut lines)
    }
    return lines.items()
}
