import std.text

test "calendar formats and ISO weeks" {
    @expect(scalar("date", "2000-02-29") != null)
    @expect(scalar("date", "1900-02-29") == null)
    @expect(scalar("date", "2024-04-31") == null)
    @expect(scalar("date", "10000-01-01") != null)
    @expect(scalar("time", "23:59:59.999") != null)
    @expect(scalar("time", "23:59:59.9999") == null)
    @expect(scalar("time", "24:00") == null)
    @expect(scalar("month", "2024-00") == null)
    @expect(scalar("week", "2020-W53") != null)
    @expect(scalar("week", "2021-W53") == null)
    @expect(scalar("week", "1970-W01").? == -3.0)
    @expect(scalar("datetime-local", "2024-02-29T12:30") != null)
    @expect(scalar("datetime-local", "2024-02-30T12:30") == null)
}

test "patterns are whole strings and bounded" {
    @expect(patternMatches("[A-Z]{2}[0-9]+", "AB123"))
    @expect(!patternMatches("[A-Z]{2}[0-9]+", "ab123"))
    @expect(!patternMatches("[A-Z]{2}[0-9]+", "XAB123"))
    @expect(patternMatches("(ab|cd)+[0-9]?", "abcd2"))
    @expect(!patternMatches("(ab|cd)+[0-9]?", "abcd22"))
    @expect(patternMatches("\\d{2}:\\d{2}", "12:30"))
    @expect(patternMatches("(?:foo|bar)", "bar"))
    @expect(!patternMatches("(?:foo|bar)", "bars"))
    @expect(patternMatches("[", "ignored invalid pattern"))
    @expect(patternMatches("", ""))
    @expect(!patternMatches("", "nonempty"))
}

test "validation candidates, reset and numeric stepping" {
    var doc = try Document.init(@testAllocator())
    defer doc.deinit()
    let form = try addEl(&mut doc, doc.root, "form", []Attr{})
    let number = try addEl(&mut doc, form, "input", []Attr{})
    try doc.setAttr(number, "type", "number")
    try doc.setAttr(number, "min", "2")
    try doc.setAttr(number, "max", "9")
    try doc.setAttr(number, "step", "2")
    try doc.setAttr(number, "required", "")
    @expect(validityOf(&doc, number).valueMissing)
    @expect(try stepValue(&mut doc, number, true))
    @expectEqual("2", valueOf(&doc, number))
    try setValue(&mut doc, number, "3")
    @expect(validityOf(&doc, number).stepMismatch)
    @expect(try stepValue(&mut doc, number, true))
    @expectEqual("4", valueOf(&doc, number))
    try setValue(&mut doc, number, "8")
    @expect(try stepValue(&mut doc, number, true))
    @expectEqual("8", valueOf(&doc, number))
    let button = try addEl(&mut doc, form, "button", []Attr{})
    @expect(willValidate(&doc, button))
    try setCustomValidity(&mut doc, button, "blocked")
    @expect(validityOf(&doc, button).customError)
    try resetForm(&mut doc, form)
    @expectEqual("blocked", validationMessage(&doc, button))
    try doc.setAttr(button, "type", "reset")
    @expect(!willValidate(&doc, button))
    let checkbox = try addEl(&mut doc, form, "input", []Attr{})
    try doc.setAttr(checkbox, "type", "checkbox")
    try doc.setAttr(checkbox, "readonly", "")
    @expect(willValidate(&doc, checkbox))
}

test "maxlength editing counts UTF16 without splitting characters" {
    var doc = try Document.init(@testAllocator())
    defer doc.deinit()
    let field = try addEl(&mut doc, doc.root, "input", []Attr{})
    try doc.setAttr(field, "maxlength", "3")
    try insertText(&mut doc, field, "a😀b")
    @expectEqual("a😀", valueOf(&doc, field))
    try doc.setAttr(field, "maxlength", "1")
    try setValue(&mut doc, field, "")
    try insertText(&mut doc, field, "😀")
    @expectEqual("", valueOf(&doc, field))
}
