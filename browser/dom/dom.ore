// dom: the document tree. Nodes live in a `Pool(Node)` and refer to each
// other by `NodeId` (a `Handle(Node)`): parent, first and last child, and
// the previous and next sibling. The strings of a document (tag names,
// attributes, text) come from an arena that the document owns, so they
// are freed together by `deinit`.
//
// Nodes are freed from the pool only when scripts are done with them
// (design.md's JS boundary): a node that JavaScript holds has `js_refs`
// above 0 (one per wrapper), and `releaseIfUnused` frees a tree taken out
// of the document once no node of it is held. Their strings stay in the
// arena until the document is freed.

import std.heap.Arena
import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.pool.Handle
import std.pool.Pool
import std.text

pub enum Kind {
    Document
    Doctype
    Element
    Text
    Comment
}

// The namespace of an element (`Node.ns`). An element the HTML parser or
// `createElement` made is NS_HTML, also inside `svg` and `math`: what is
// under those tells (`namespaceOf`). `createElementNS` sets the others.
pub let NS_HTML: u8 = 0
pub let NS_SVG: u8 = 1
pub let NS_MATHML: u8 = 2
// Any other namespace, or none.
pub let NS_OTHER: u8 = 3

pub struct Attr {
    name: []u8
    value: []u8
}

pub struct Node {
    kind: Kind
    // Element: the tag name in lower case. Doctype: the doctype's name.
    name: []u8
    // Text and Comment: the content.
    data: []u8
    // Element: the attributes in source order, each name once.
    attrs: []mut Attr
    parent: ?NodeId
    first_child: ?NodeId
    last_child: ?NodeId
    prev: ?NodeId
    next: ?NodeId
    // The JavaScript objects that hold this node (wrappers).
    js_refs: u32
    // Element: NS_HTML, NS_SVG, ...
    ns: u8
    // A shadow host: its shadow root. A shadow root (a fragment): its
    // host (shadow.ore).
    shadow: ?NodeId
    // A child of a shadow host: the `slot` it is assigned to.
    slot: ?NodeId
    // Element: the custom element state (CE_*).
    ce: u8
}

// Custom element states (`Node.ce`): an element of no custom element
// definition yet (or never), one constructed or upgraded by its
// definition, one whose constructor failed.
pub let CE_NONE: u8 = 0
pub let CE_CUSTOM: u8 = 1
pub let CE_FAILED: u8 = 2

/// A change to the tree that `Document.log` records for scripts
/// (MutationObserver, custom element reactions): 0 `node` was added
/// to (`added`) or taken out of `target` between `prev` and `next`; 1
/// the attribute `name` of `target` changed (it was `old`); 2 the data
/// of `target` changed (it was `old`). Each node of a record counts in
/// `js_refs` until the record is taken (`takeLog`).
pub struct Mutation {
    kind: u8
    added: bool
    target: NodeId
    node: ?NodeId
    prev: ?NodeId
    next: ?NodeId
    name: []u8
    old: ?[]u8
}

/// Names a node of a `Document`.
pub let NodeId = Handle(Node)

/// The style sheets a script adopted for `root` (the document node or a
/// shadow root): their text (in the document's arena).
pub struct Adopted {
    root: NodeId
    css: []u8
}

/// Do `a` and `b` name the same node?
pub fn same(a: NodeId, b: NodeId) bool {
    return a.index == b.index && a.generation == b.generation
}

/// Is `a` a node and the same node as `b`?
pub fn isSame(a: ?NodeId, b: NodeId) bool {
    if a |x| {
        return same(x, b)
    }
    return false
}

pub struct Document {
    alloc: Allocator
    nodes: Pool(Node)
    // Owns the strings of the nodes. On the heap, so that the `Allocator`
    // it hands out stays valid when the document is moved.
    strings: *mut Arena
    root: NodeId
    // Changes to child/sibling links, not attributes or text data. Live
    // structural lookups (window.frames) need not rescan after src/style.
    tree_version: u64
    // The state of form controls and the focus (controls.ore).
    controls: Controls
    // Quirks mode (no doctype, or a legacy one): set by the HTML parser.
    quirks: bool
    // The contents of `template` elements: pairs of a template and the
    // root of its inert fragment (a tree out of the document).
    templates: List(NodeId)
    // The rules scripts gave style sheets through the CSSOM (cssom.ore).
    sheets: ScriptSheets
    // The shadow roots, in the order they were attached (shadow.ore).
    shadows: List(NodeId)
    // Slots whose assigned nodes changed (`assignSlots`), while
    // `recording`.
    changed_slots: List(NodeId)
    // The style sheets scripts adopted (`adoptedStyleSheets`): pairs of
    // the document node or a shadow root and the text of its sheets.
    adopted: List(Adopted)
    // Changes to the tree, recorded while `recording` (scripts observe).
    log: List(Mutation)
    recording: bool

    /// An empty document: only the `Document` node.
    pub fn init(alloc: Allocator) AllocError!Document {
        let strings = try alloc.create(Arena.init(alloc))
        var nodes = Pool(Node).init(alloc, 256)
        let root = nodes.insert(blank(Kind.Document, "", "")) catch |e| {
            alloc.destroy(strings)
            return e
        }
        return Document {
            alloc: alloc,
            nodes: nodes,
            strings: strings,
            root: root,
            tree_version: 0,
            controls: Controls.init(alloc),
            quirks: false,
            templates: List(NodeId).init(alloc),
            sheets: ScriptSheets.init(alloc),
            shadows: List(NodeId).init(alloc),
            changed_slots: List(NodeId).init(alloc),
            adopted: List(Adopted).init(alloc),
            log: List(Mutation).init(alloc),
            recording: false,
        }
    }

    pub fn deinit(self: *mut Self) {
        self.templates.deinit()
        self.sheets.deinit()
        self.shadows.deinit()
        self.changed_slots.deinit()
        self.adopted.deinit()
        self.log.deinit()
        self.controls.deinit()
        self.strings.deinit()
        self.alloc.destroy(self.strings)
        self.nodes.deinit()
    }

    /// The node of `h`. A `NodeId` stays valid until its node is freed
    /// (`releaseIfUnused`), which happens only to trees out of the
    /// document that scripts no longer hold; `isLive` tells.
    pub fn node(self: *Self, h: NodeId) *mut Node {
        if self.nodes.get(h) |n| {
            return n
        }
        // Unreachable: Ore has no `unreachable`, and a stale handle would
        // be a bug here. Index the slot anyway (see COMPILER_GAPS.md).
        return &mut self.nodes.slots[h.index].value
    }

    /// A copy of `s` in the document's string arena.
    pub fn dup(self: *mut Self, s: []u8) AllocError![]u8 {
        if s.len == 0 {
            return ""
        }
        let a = self.strings.allocator()
        let out = try a.alloc(0 as u8, s.len)
        for i, c in s {
            out[i] = c
        }
        return out
    }

    // ---- creating nodes (not yet in the tree)

    /// A new element named `name` (lower case) with copies of `attrs`.
    pub fn createElement(self: *mut Self, name: []u8, attrs: []Attr) AllocError!NodeId {
        var n = blank(Kind.Element, try self.dup(name), "")
        if attrs.len > 0 {
            let a = self.strings.allocator()
            let copy = try a.alloc(Attr { name: "", value: "" }, attrs.len)
            for i, at in attrs {
                copy[i] = Attr { name: try self.dup(at.name), value: try self.dup(at.value) }
            }
            n.attrs = copy
        }
        return self.nodes.insert(n)
    }

    pub fn createText(self: *mut Self, data: []u8) AllocError!NodeId {
        return self.nodes.insert(blank(Kind.Text, "", try self.dup(data)))
    }

    pub fn createComment(self: *mut Self, data: []u8) AllocError!NodeId {
        return self.nodes.insert(blank(Kind.Comment, "", try self.dup(data)))
    }

    pub fn createDoctype(self: *mut Self, name: []u8) AllocError!NodeId {
        return self.nodes.insert(blank(Kind.Doctype, try self.dup(name), ""))
    }

    /// A new, empty document fragment: a `Document` node that is not the
    /// document's, the root of a tree of its own.
    pub fn createFragment(self: *mut Self) AllocError!NodeId {
        return self.nodes.insert(blank(Kind.Document, "#document-fragment", ""))
    }

    /// Is `h` a document fragment (a template's contents, or one that a
    /// script made)?
    pub fn isFragment(self: *Self, h: NodeId) bool {
        return self.node(h).kind == Kind.Document && !same(h, self.root)
    }

    /// The namespace of the element `el`: its own when it has one, else
    /// SVG or MathML inside an `svg` or `math` element (up to a
    /// `foreignObject`), else HTML.
    pub fn namespaceOf(self: *Self, el: NodeId) u8 {
        var cur: ?NodeId = el
        while cur |c| {
            let n = self.node(c)
            if n.kind != Kind.Element {
                return NS_HTML
            }
            if n.ns != NS_HTML {
                return n.ns
            }
            if text.eql(n.name, "svg") {
                return NS_SVG
            }
            if text.eql(n.name, "math") {
                return NS_MATHML
            }
            if text.eql(n.name, "foreignobject") && !same(c, el) {
                return NS_HTML
            }
            cur = n.parent
        }
        return NS_HTML
    }

    /// A new, empty fragment for the contents of the template `t`: a
    /// tree of its own, out of the document, so that rendering, text and
    /// queries never see it. The template holds it (`js_refs`), so it is
    /// freed with the document only.
    pub fn createTemplateContent(self: *mut Self, t: NodeId) AllocError!NodeId {
        let frag = try self.createFragment()
        self.node(frag).js_refs = 1
        try self.templates.append(t)
        try self.templates.append(frag)
        return frag
    }

    /// The root of the contents of the template `t` (null when `t` is not
    /// a parsed template).
    pub fn templateContent(self: *Self, t: NodeId) ?NodeId {
        let items = self.templates.items()
        var i: usize = 0
        while i + 1 < items.len {
            if same(items[i], t) {
                return items[i + 1]
            }
            i += 2
        }
        return null
    }

    /// Is `h` in the contents of a template (is its root a template's
    /// fragment)? Such a node belongs to the template's inert document.
    pub fn inTemplateContent(self: *Self, h: NodeId) bool {
        var root = h
        while self.node(root).parent |p| {
            root = p
        }
        let items = self.templates.items()
        var i: usize = 1
        while i < items.len {
            if same(items[i], root) {
                return true
            }
            i += 2
        }
        return false
    }

    // ---- changing the tree

    /// Takes `child` out of its parent, if it has one.
    pub fn detach(self: *mut Self, child: NodeId) {
        let c = self.node(child)
        if c.parent |p| {
            if self.recording {
                self.record(Mutation { kind: 0, added: false, target: p, node: child, prev: c.prev, next: c.next, name: "", old: null })
            }
            self.tree_version += 1
            let parent = self.node(p)
            if c.prev |prev| {
                self.node(prev).next = c.next
            } else {
                parent.first_child = c.next
            }
            if c.next |next| {
                self.node(next).prev = c.prev
            } else {
                parent.last_child = c.prev
            }
        }
        c.parent = null
        c.prev = null
        c.next = null
        c.slot = null
    }

    /// Makes `child` the last child of `parent` (taking it out of where it
    /// was first).
    pub fn appendChild(self: *mut Self, parent: NodeId, child: NodeId) {
        self.tree_version += 1
        self.detach(child)
        let p = self.node(parent)
        let c = self.node(child)
        c.parent = parent
        c.prev = p.last_child
        if p.last_child |last| {
            self.node(last).next = child
        } else {
            p.first_child = child
        }
        p.last_child = child
        if self.recording {
            self.recordAdded(parent, child)
        }
    }

    /// Puts `child` into `parent` just before `before`, or last when
    /// `before` is null.
    pub fn insertBefore(self: *mut Self, parent: NodeId, child: NodeId, before: ?NodeId) {
        if before |b| {
            self.tree_version += 1
            self.detach(child)
            let c = self.node(child)
            let bn = self.node(b)
            c.parent = parent
            c.next = b
            c.prev = bn.prev
            if bn.prev |prev| {
                self.node(prev).next = child
            } else {
                self.node(parent).first_child = child
            }
            bn.prev = child
            if self.recording {
                self.recordAdded(parent, child)
            }
        } else {
            self.appendChild(parent, child)
        }
    }

    /// Appends text to `parent`: to its last child when that is a text
    /// node, else as a new text node.
    pub fn appendText(self: *mut Self, parent: NodeId, s: []u8) AllocError!void {
        if s.len == 0 {
            return
        }
        if self.node(parent).last_child |last| {
            let n = self.node(last)
            if n.kind == Kind.Text {
                let a = self.strings.allocator()
                let joined = try a.alloc(0 as u8, n.data.len + s.len)
                for i, c in n.data {
                    joined[i] = c
                }
                for i, c in s {
                    joined[n.data.len + i] = c
                }
                if self.recording {
                    self.record(Mutation { kind: 2, added: false, target: last, node: null, prev: null, next: null, name: "", old: n.data })
                }
                n.data = joined
                return
            }
        }
        let t = try self.createText(s)
        self.appendChild(parent, t)
    }

    /// Sets the attribute `name` of the element `el` to `value`.
    pub fn setAttr(self: *mut Self, el: NodeId, name: []u8, value: []u8) AllocError!void {
        let n = self.node(el)
        for i, at in n.attrs {
            if text.eql(at.name, name) {
                let v = try self.dup(value)
                if self.recording {
                    self.record(Mutation { kind: 1, added: false, target: el, node: null, prev: null, next: null, name: at.name, old: at.value })
                }
                self.node(el).attrs[i].value = v
                return
            }
        }
        if self.recording {
            self.record(Mutation { kind: 1, added: false, target: el, node: null, prev: null, next: null, name: try self.dup(name), old: null })
        }
        let a = self.strings.allocator()
        let more = try a.alloc(Attr { name: "", value: "" }, n.attrs.len + 1)
        for i, at in n.attrs {
            more[i] = at
        }
        more[n.attrs.len] = Attr { name: try self.dup(name), value: try self.dup(value) }
        self.node(el).attrs = more
    }

    /// Removes the attribute `name` of the element `el`, if it has one.
    pub fn removeAttr(self: *mut Self, el: NodeId, name: []u8) {
        let n = self.node(el)
        var k: usize = 0
        for i in 0..n.attrs.len {
            let at = n.attrs[i]
            if !text.eql(at.name, name) {
                n.attrs[k] = at
                k += 1
            } else if self.recording {
                self.record(Mutation { kind: 1, added: false, target: el, node: null, prev: null, next: null, name: at.name, old: at.value })
            }
        }
        n.attrs = n.attrs[0..k]
    }

    /// Sets the data of the text or comment node `h` to a copy of `data`.
    pub fn setData(self: *mut Self, h: NodeId, data: []u8) AllocError!void {
        let copy = try self.dup(data)
        if self.recording {
            self.record(Mutation { kind: 2, added: false, target: h, node: null, prev: null, next: null, name: "", old: self.node(h).data })
        }
        self.node(h).data = copy
    }

    // ---- recording changes for scripts

    fn recordAdded(self: *mut Self, parent: NodeId, child: NodeId) {
        let c = self.node(child)
        self.record(Mutation { kind: 0, added: true, target: parent, node: child, prev: c.prev, next: c.next, name: "", old: null })
    }

    // Appends `m` to the log, its nodes held until it is taken. A record
    // that cannot be kept (out of memory) is dropped.
    fn record(self: *mut Self, m: Mutation) {
        self.log.append(m) catch |e| {
            return
        }
        self.node(m.target).js_refs += 1
        if m.node |n| {
            self.node(n).js_refs += 1
        }
    }

    /// Moves the records of the log to `out` (empty first); the caller
    /// releases their nodes with `releaseRecord` once it is done.
    pub fn takeLog(self: *mut Self, out: *mut List(Mutation)) AllocError!void {
        out.clear()
        for m in self.log.items() {
            try out.append(m)
        }
        self.log.clear()
    }

    /// Lets go of the nodes of a record that `takeLog` gave.
    pub fn releaseRecord(self: *mut Self, m: Mutation) {
        self.release(m.target)
        if m.node |n| {
            self.release(n)
        }
    }

    // One js_ref of `h` less; frees its tree when nothing holds it.
    fn release(self: *mut Self, h: NodeId) {
        if !self.isLive(h) {
            return
        }
        let n = self.node(h)
        if n.js_refs > 0 {
            n.js_refs -= 1
        }
        if n.js_refs == 0 {
            self.releaseIfUnused(h)
        }
    }

    // ---- freeing nodes

    /// Does `h` name a node of the pool (not one freed)?
    pub fn isLive(self: *Self, h: NodeId) bool {
        return self.nodes.get(h) != null
    }

    /// The top of the tree `h` is in: the document node when `h` is in
    /// the document.
    pub fn treeRoot(self: *Self, h: NodeId) NodeId {
        var cur = h
        while self.node(cur).parent |p| {
            cur = p
        }
        return cur
    }

    /// The top of the tree `h` is in, through shadow roots to their
    /// hosts: the document node when `h` is in the document or in a
    /// shadow tree of an element in it.
    pub fn shadowIncludingRoot(self: *Self, h: NodeId) NodeId {
        var top = self.treeRoot(h)
        while self.node(top).kind == Kind.Document && !same(top, self.root) {
            let host = self.node(top).shadow orelse break
            if !self.isLive(host) {
                break
            }
            top = self.treeRoot(host)
        }
        return top
    }

    /// Is `h` in the document, or in a shadow tree of an element in it?
    pub fn isConnected(self: *Self, h: NodeId) bool {
        return same(self.shadowIncludingRoot(h), self.root)
    }

    /// Frees the tree that `h` is in when it is out of the document and
    /// no node of it is held by a script (`js_refs`). True if it did.
    pub fn releaseIfUnused(self: *mut Self, h: NodeId) bool {
        if !self.isLive(h) {
            return false
        }
        let top = self.treeRoot(h)
        if same(top, self.root) {
            return false
        }
        var cur: ?NodeId = top
        while cur |c| {
            if self.node(c).js_refs > 0 {
                return false
            }
            cur = self.following(c, top)
        }
        // Children before their parent, so the walk never visits a freed
        // node.
        while true {
            var leaf = top
            while self.node(leaf).last_child |l| {
                leaf = l
            }
            if same(leaf, top) {
                break
            }
            self.detach(leaf)
            self.nodes.remove(leaf)
        }
        self.nodes.remove(top)
        return true
    }

    // ---- reading the tree

    /// The value of the attribute `name` of `el`.
    pub fn attr(self: *Self, el: NodeId, name: []u8) ?[]u8 {
        for at in self.node(el).attrs {
            if text.eql(at.name, name) {
                return at.value
            }
        }
        return null
    }

    /// Is `h` an element named `name`?
    pub fn isElement(self: *Self, h: NodeId, name: []u8) bool {
        let n = self.node(h)
        return n.kind == Kind.Element && text.eql(n.name, name)
    }

    pub fn parent(self: *Self, h: NodeId) ?NodeId {
        return self.node(h).parent
    }

    pub fn firstChild(self: *Self, h: NodeId) ?NodeId {
        return self.node(h).first_child
    }

    pub fn lastChild(self: *Self, h: NodeId) ?NodeId {
        return self.node(h).last_child
    }

    pub fn nextSibling(self: *Self, h: NodeId) ?NodeId {
        return self.node(h).next
    }

    pub fn prevSibling(self: *Self, h: NodeId) ?NodeId {
        return self.node(h).prev
    }

    /// The node after `h` in document order (depth first, a node before
    /// its children), staying inside the subtree of `top`.
    pub fn following(self: *Self, h: NodeId, top: NodeId) ?NodeId {
        if self.node(h).first_child |c| {
            return c
        }
        return self.followingSkip(h, top)
    }

    /// Like `following`, but skips the children of `h`.
    pub fn followingSkip(self: *Self, h: NodeId, top: NodeId) ?NodeId {
        var cur = h
        while !same(cur, top) {
            let n = self.node(cur)
            if n.next |next| {
                return next
            }
            if n.parent |p| {
                cur = p
            } else {
                return null
            }
        }
        return null
    }

    /// The first element child of the document (normally `html`).
    pub fn documentElement(self: *Self) ?NodeId {
        var cur = self.node(self.root).first_child
        while cur |c| {
            if self.node(c).kind == Kind.Element {
                return c
            }
            cur = self.node(c).next
        }
        return null
    }

    /// The first element with the attribute `id` equal to `id`.
    pub fn getElementById(self: *Self, id: []u8) ?NodeId {
        var cur: ?NodeId = self.root
        while cur |h| {
            if self.node(h).kind == Kind.Element {
                if self.attr(h, "id") |v| {
                    if text.eql(v, id) {
                        return h
                    }
                }
            }
            cur = self.following(h, self.root)
        }
        return null
    }

    /// Appends to `out` every element named `name` in document order;
    /// `*` matches every element.
    pub fn getElementsByTagName(self: *Self, name: []u8, out: *mut List(NodeId)) AllocError!void {
        let all = text.eql(name, "*")
        var cur: ?NodeId = self.root
        while cur |h| {
            let n = self.node(h)
            if n.kind == Kind.Element && (all || text.eqlIgnoreCase(n.name, name)) {
                try out.append(h)
            }
            cur = self.following(h, self.root)
        }
    }

    /// Appends the text of every text node under `h` to `out`.
    pub fn textContent(self: *Self, h: NodeId, out: *mut text.Builder) AllocError!void {
        var cur: ?NodeId = h
        while cur |c| {
            let n = self.node(c)
            if n.kind == Kind.Text {
                try out.append(n.data)
            }
            cur = self.following(c, h)
        }
    }
}

fn blank(kind: Kind, name: []u8, data: []u8) Node {
    return Node {
        kind: kind,
        name: name,
        data: data,
        attrs: []mut Attr{},
        parent: null,
        first_child: null,
        last_child: null,
        prev: null,
        next: null,
        js_refs: 0,
        ns: NS_HTML,
        shadow: null,
        slot: null,
        ce: CE_NONE,
    }
}

test "build, query and walk a tree" {
    var doc = try Document.init(@testAllocator())
    defer doc.deinit()
    let html = try doc.createElement("html", []Attr{})
    doc.appendChild(doc.root, html)
    let body = try doc.createElement("body", []Attr{})
    doc.appendChild(html, body)
    let first = try doc.createElement("p", []Attr{})
    doc.appendChild(body, first)
    let third = try doc.createElement("p", []Attr{})
    doc.appendChild(body, third)
    let second = try doc.createElement("div", []Attr{})
    doc.insertBefore(body, second, third)
    try doc.setAttr(second, "id", "mid")
    try doc.appendText(second, "a")
    try doc.appendText(second, "b")

    @expect(isSame(doc.documentElement(), html))
    @expect(isSame(doc.getElementById("mid"), second))
    @expect(doc.getElementById("none") == null)
    @expect(isSame(doc.nextSibling(first), second))
    @expect(isSame(doc.prevSibling(third), second))
    @expect(isSame(doc.parent(second), body))
    @expect(isSame(doc.firstChild(body), first))
    @expect(isSame(doc.lastChild(body), third))

    var ps = List(NodeId).init(@testAllocator())
    defer ps.deinit()
    try doc.getElementsByTagName("p", &mut ps)
    @expectEqual(2, ps.len())
    @expect(same(ps.items()[1], third))

    var out = text.Builder.init(@testAllocator())
    defer out.deinit()
    try doc.textContent(body, &mut out)
    @expectEqual("ab", out.bytes())

    doc.detach(second)
    @expect(isSame(doc.nextSibling(first), third))
    @expect(doc.parent(second) == null)
}

test "trees out of the document are freed when nothing holds them" {
    var doc = try Document.init(@testAllocator())
    defer doc.deinit()
    let body = try doc.createElement("body", []Attr{})
    doc.appendChild(doc.root, body)
    let div = try doc.createElement("div", []Attr{})
    doc.appendChild(body, div)
    let span = try doc.createElement("span", []Attr{})
    doc.appendChild(div, span)
    try doc.appendText(span, "x")
    @expect(doc.isConnected(span))
    @expect(!doc.releaseIfUnused(div))

    doc.detach(div)
    @expect(!doc.isConnected(span))
    @expect(isSame(doc.treeRoot(span), div))
    doc.node(span).js_refs = 1
    @expect(!doc.releaseIfUnused(div))
    @expect(doc.isLive(span))
    doc.node(span).js_refs = 0
    @expect(doc.releaseIfUnused(span))
    @expect(!doc.isLive(div))
    @expect(!doc.isLive(span))
    @expect(doc.isLive(body))
    @expect(doc.firstChild(body) == null)

    try doc.setAttr(body, "class", "a")
    try doc.setAttr(body, "id", "b")
    doc.removeAttr(body, "class")
    @expect(doc.attr(body, "class") == null)
    @expectEqual("b", doc.attr(body, "id").?)
}
