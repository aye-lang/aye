// Form controls: the state HTML keeps beside the tree (a field's value
// and whether it is "dirty", the checkedness of checkboxes and radio
// buttons, the selectedness of options, the focus, and the caret and
// selection of the focused text field), keyed by node.
//
// It is the one place that the window, the agent and scripts read and
// change: `doc.controls` and the functions below. Attributes keep the
// defaults (`value`, `checked`, `selected`, a `textarea`'s text); a
// control without state of its own shows its default, and a form reset
// forgets the state of its controls.
//
// Text editing works on byte offsets at code point boundaries; the
// selection is `anchor..caret` in either order (empty when they are
// equal).

import std
import std.list.List
import std.map.IntMap
import std.mem.AllocError
import std.mem.Allocator
import std.text

/// The state of one control (or option).
pub struct Control {
    // The node's generation: a slot reused by another node does not
    // inherit the state.
    generation: u32
    // A text field's value once edited or set (`dirty`), owned.
    value: []mut u8
    dirty: bool
    // A checkbox or radio button, once changed.
    checked: bool
    checked_dirty: bool
    // An option, once (de)selected.
    selected: bool
    selected_dirty: bool
    // Text editing: the caret and the other end of the selection.
    caret: usize
    anchor: usize
    // How far the content of a text field is scrolled, in px: to the
    // left for an `input`, up for a `textarea`.
    scroll: f64
}

pub struct Controls {
    alloc: Allocator
    map: IntMap(u32, Control)
    // The focused element (a control, a link, or anything with a
    // `tabindex`); null for none.
    focus: ?NodeId

    pub fn init(alloc: Allocator) Controls {
        return Controls { alloc: alloc, map: IntMap(u32, Control).init(alloc), focus: null }
    }

    pub fn deinit(self: *mut Self) {
        var it = self.map.iterator()
        while it.next() |e| {
            self.alloc.free(e.value.value)
        }
        self.map.deinit()
    }

    /// The state of `el`, if it has any; valid until the next `ensure`.
    pub fn get(self: *Self, el: NodeId) ?*mut Control {
        if self.map.getPtr(el.index) |c| {
            if c.generation == el.generation {
                return c
            }
        }
        return null
    }

    /// The state of `el`, made (with nothing changed) when it has none.
    pub fn ensure(self: *mut Self, el: NodeId) AllocError!*mut Control {
        if self.get(el) |c| {
            return c
        }
        if self.map.getPtr(el.index) |stale| {
            self.alloc.free(stale.value)
        }
        let empty = try self.alloc.alloc(0 as u8, 0)
        try self.map.put(el.index, Control {
            generation: el.generation,
            value: empty,
            dirty: false,
            checked: false,
            checked_dirty: false,
            selected: false,
            selected_dirty: false,
            caret: 0,
            anchor: 0,
            scroll: 0.0,
        })
        return self.map.getPtr(el.index).?
    }

    /// Forgets the state of `el` (a reset).
    pub fn forget(self: *mut Self, el: NodeId) {
        if self.get(el) |c| {
            self.alloc.free(c.value)
            self.map.remove(el.index)
        }
    }
}

// ---- kinds of controls

/// The type of an `input`, in lower case: one of the types HTML knows,
/// else "text".
pub fn inputType(doc: *Document, el: NodeId) []u8 {
    let raw = doc.attr(el, "type") orelse return "text"
    let t = text.trim(raw)
    let known = [_][]u8{
        "text", "password", "email", "search", "number", "url", "tel", "checkbox", "radio",
        "submit", "reset", "button", "hidden", "image", "file", "range", "color", "date",
        "time", "datetime-local", "month", "week",
    }
    for k in known {
        if text.eqlIgnoreCase(k, t) {
            return k
        }
    }
    return "text"
}

/// Does `t` (an `inputType`) take typed text?
fn typesText(t: []u8) bool {
    let other = [_][]u8{"checkbox", "radio", "submit", "reset", "button", "hidden", "image", "file", "range", "color"}
    for k in other {
        if text.eql(k, t) {
            return false
        }
    }
    return true
}

/// Is `el` a field that takes typed text: a `textarea`, or an `input`
/// of a text type (text, password, email, search, number, url, ...)?
pub fn isTextField(doc: *Document, el: NodeId) bool {
    if doc.isElement(el, "textarea") {
        return true
    }
    return doc.isElement(el, "input") && typesText(inputType(doc, el))
}

/// Is `el` a checkbox or a radio button?
pub fn isCheckable(doc: *Document, el: NodeId) bool {
    if !doc.isElement(el, "input") {
        return false
    }
    let t = inputType(doc, el)
    return text.eql(t, "checkbox") || text.eql(t, "radio")
}

pub fn isRadio(doc: *Document, el: NodeId) bool {
    return doc.isElement(el, "input") && text.eql(inputType(doc, el), "radio")
}

/// The kind of a `button` element: "submit" (also for a missing or
/// unknown type), "reset" or "button".
pub fn buttonType(doc: *Document, el: NodeId) []u8 {
    if doc.attr(el, "type") |t| {
        let v = text.trim(t)
        if text.eqlIgnoreCase(v, "reset") {
            return "reset"
        }
        if text.eqlIgnoreCase(v, "button") {
            return "button"
        }
    }
    return "submit"
}

/// Is `el` a submit button: a `button` of type submit, an `input` of
/// type submit or image?
pub fn isSubmitButton(doc: *Document, el: NodeId) bool {
    if doc.isElement(el, "button") {
        return text.eql(buttonType(doc, el), "submit")
    }
    if doc.isElement(el, "input") {
        let t = inputType(doc, el)
        return text.eql(t, "submit") || text.eql(t, "image")
    }
    return false
}

pub fn isResetButton(doc: *Document, el: NodeId) bool {
    if doc.isElement(el, "button") {
        return text.eql(buttonType(doc, el), "reset")
    }
    return doc.isElement(el, "input") && text.eql(inputType(doc, el), "reset")
}

/// Is `el` a form control: `input`, `button`, `select`, `textarea`?
pub fn isControl(doc: *Document, el: NodeId) bool {
    let n = doc.node(el)
    if n.kind != Kind.Element {
        return false
    }
    return text.eql(n.name, "input") || text.eql(n.name, "button") || text.eql(n.name, "select") || text.eql(n.name, "textarea")
}

/// Is `el` disabled: a control or option with `disabled`, an option in
/// a disabled `optgroup`, or a control in a disabled `fieldset` (but not
/// in its first `legend`)?
pub fn isDisabled(doc: *Document, el: NodeId) bool {
    let n = doc.node(el)
    if n.kind != Kind.Element {
        return false
    }
    let name = n.name
    let control = isControl(doc, el) || text.eql(name, "fieldset")
    if text.eql(name, "option") || text.eql(name, "optgroup") {
        if doc.attr(el, "disabled") != null {
            return true
        }
        if doc.parent(el) |p| {
            if doc.isElement(p, "optgroup") && doc.attr(p, "disabled") != null {
                return true
            }
        }
        return false
    }
    if !control {
        return false
    }
    if doc.attr(el, "disabled") != null {
        return true
    }
    var child = el
    var cur = doc.parent(el)
    while cur |c| {
        if doc.isElement(c, "fieldset") && doc.attr(c, "disabled") != null {
            // Inside the fieldset's first legend, a control is enabled.
            if !(doc.isElement(child, "legend") && isFirstLegend(doc, c, child)) {
                return true
            }
        }
        child = c
        cur = doc.parent(c)
    }
    return false
}

fn isFirstLegend(doc: *Document, fieldset: NodeId, legend: NodeId) bool {
    var cur = doc.firstChild(fieldset)
    while cur |c| {
        if doc.isElement(c, "legend") {
            return c == legend
        }
        cur = doc.nextSibling(c)
    }
    return false
}

/// The form of a control: the element named by its `form` attribute
/// (when that is a `form`), else the nearest `form` around it.
pub fn formOwner(doc: *Document, el: NodeId) ?NodeId {
    if doc.attr(el, "form") |id| {
        if doc.getElementById(id) |f| {
            if doc.isElement(f, "form") {
                return f
            }
        }
        return null
    }
    var cur = doc.parent(el)
    while cur |c| {
        if doc.isElement(c, "form") {
            return c
        }
        cur = doc.parent(c)
    }
    return null
}

/// Appends to `out` the controls whose form is `form`, in tree order.
pub fn formControls(doc: *Document, form: NodeId, out: *mut List(NodeId)) AllocError!void {
    var cur: ?NodeId = doc.root
    while cur |h| {
        if isControl(doc, h) {
            if formOwner(doc, h) |f| {
                if f == form {
                    try out.append(h)
                }
            }
        }
        cur = doc.following(h, doc.root)
    }
}

// ---- values

/// The text of a `textarea`'s children (its default value).
fn childText(doc: *Document, el: NodeId) []u8 {
    let only = doc.firstChild(el) orelse return ""
    if doc.nextSibling(only) == null && doc.node(only).kind == Kind.Text {
        return doc.node(only).data
    }
    // Several children (changed by scripts): joined in the string arena.
    var b = text.Builder.init(doc.alloc)
    defer b.deinit()
    doc.textContent(el, &mut b) catch |e| {
        return ""
    }
    let a = doc.strings.allocator()
    let out = a.alloc(0 as u8, b.len()) catch |e| {
        return ""
    }
    std.mem.copy(out, b.bytes())
    return out
}

/// The default value of a control: an `input`'s `value` attribute, a
/// `textarea`'s text.
pub fn defaultValue(doc: *Document, el: NodeId) []u8 {
    if doc.isElement(el, "textarea") {
        return childText(doc, el)
    }
    return doc.attr(el, "value") orelse ""
}

/// The value of a control: the text of a text field (as typed or set,
/// else its default), a checkbox's or radio button's `value` ("on" by
/// default), the value of a `select`'s first selected option, a
/// button's `value`; of an `option`, its `value` or else its text.
pub fn valueOf(doc: *Document, el: NodeId) []u8 {
    if doc.isElement(el, "select") {
        if selectedOption(doc, el) |opt| {
            return valueOf(doc, opt)
        }
        return ""
    }
    if doc.isElement(el, "option") {
        if doc.attr(el, "value") |v| {
            return v
        }
        return childText(doc, el)
    }
    if isCheckable(doc, el) {
        return doc.attr(el, "value") orelse "on"
    }
    if doc.controls.get(el) |c| {
        if c.dirty {
            return c.value
        }
    }
    return defaultValue(doc, el)
}

/// Sets the value of a text field (the caret goes to the end), or
/// selects the first option of a `select` with that value.
pub fn setValue(doc: *mut Document, el: NodeId, v: []u8) AllocError!void {
    if doc.isElement(el, "select") {
        var opts = List(NodeId).init(doc.alloc)
        defer opts.deinit()
        try options(doc, el, &mut opts)
        for o in opts.items() {
            if text.eql(valueOf(doc, o), v) {
                return selectOption(doc, el, o)
            }
        }
        // No such option: nothing is selected.
        for o in opts.items() {
            try setSelected(doc, o, false)
        }
        return
    }
    var clean = v
    var stripped = text.Builder.init(doc.alloc)
    defer stripped.deinit()
    if doc.isElement(el, "input") {
        // An input's value is one line.
        for c in v {
            if c != '\n' && c != '\r' {
                try stripped.appendByte(c)
            }
        }
        clean = stripped.bytes()
    }
    let owned = try doc.controls.alloc.alloc(0 as u8, clean.len)
    std.mem.copy(owned, clean)
    let c = try doc.controls.ensure(el)
    doc.controls.alloc.free(c.value)
    c.value = owned
    c.dirty = true
    c.caret = owned.len
    c.anchor = owned.len
}

/// Is the checkbox or radio button `el` checked: as changed, else by
/// its `checked` attribute?
pub fn isChecked(doc: *Document, el: NodeId) bool {
    if doc.controls.get(el) |c| {
        if c.checked_dirty {
            return c.checked
        }
    }
    return doc.attr(el, "checked") != null
}

/// Checks or unchecks `el`; checking a radio button unchecks the others
/// of its group (same `name`, same form).
pub fn setChecked(doc: *mut Document, el: NodeId, on: bool) AllocError!void {
    if on && isRadio(doc, el) {
        var group = List(NodeId).init(doc.alloc)
        defer group.deinit()
        try radioGroup(doc, el, &mut group)
        for r in group.items() {
            if !(r == el) {
                let rc = try doc.controls.ensure(r)
                rc.checked = false
                rc.checked_dirty = true
            }
        }
    }
    let c = try doc.controls.ensure(el)
    c.checked = on
    c.checked_dirty = true
}

/// Appends to `out` the radio buttons of `el`'s group, `el` too: the
/// radio buttons with the same non-empty `name` and the same form.
pub fn radioGroup(doc: *Document, el: NodeId, out: *mut List(NodeId)) AllocError!void {
    let name = doc.attr(el, "name") orelse ""
    if name.len == 0 {
        return out.append(el)
    }
    let form = formOwner(doc, el)
    var cur: ?NodeId = doc.root
    while cur |h| {
        if isRadio(doc, h) {
            if doc.attr(h, "name") |g| {
                if text.eql(g, name) && formOwner(doc, h) == form {
                    try out.append(h)
                }
            }
        }
        cur = doc.following(h, doc.root)
    }
}

// ---- select and option

/// Appends to `out` the options of the `select` `sel` (also those in
/// `optgroup`s), in tree order.
pub fn options(doc: *Document, sel: NodeId, out: *mut List(NodeId)) AllocError!void {
    var cur = doc.following(sel, sel)
    while cur |c| {
        if doc.isElement(c, "option") {
            try out.append(c)
            cur = doc.followingSkip(c, sel)
        } else {
            cur = doc.following(c, sel)
        }
    }
}

/// Is the option selected by itself: as changed, else by its
/// `selected` attribute? (See `isSelected` for what a `select` shows.)
fn selectedness(doc: *Document, opt: NodeId) bool {
    if doc.controls.get(opt) |c| {
        if c.selected_dirty {
            return c.selected
        }
    }
    return doc.attr(opt, "selected") != null
}

/// The `select` an option belongs to.
pub fn selectOf(doc: *Document, opt: NodeId) ?NodeId {
    var cur = doc.parent(opt)
    while cur |c| {
        if doc.isElement(c, "select") {
            return c
        }
        if !doc.isElement(c, "optgroup") {
            return null
        }
        cur = doc.parent(c)
    }
    return null
}

/// The option a single `select` shows: the last selected one, else the
/// first one that is not disabled; for a `multiple` select, the first
/// selected one (null for none).
pub fn selectedOption(doc: *Document, sel: NodeId) ?NodeId {
    let multiple = doc.attr(sel, "multiple") != null
    var found: ?NodeId = null
    var first: ?NodeId = null
    var cur = doc.following(sel, sel)
    while cur |c| {
        if doc.isElement(c, "option") {
            if first == null && !isDisabled(doc, c) {
                first = c
            }
            if selectedness(doc, c) {
                if multiple {
                    return c
                }
                found = c
            }
            cur = doc.followingSkip(c, sel)
        } else {
            cur = doc.following(c, sel)
        }
    }
    if found != null || multiple {
        return found
    }
    return first
}

/// Is the option selected, as its `select` shows it?
pub fn isSelected(doc: *Document, opt: NodeId) bool {
    if selectOf(doc, opt) |sel| {
        if doc.attr(sel, "multiple") != null {
            return selectedness(doc, opt)
        }
        if selectedOption(doc, sel) |s| {
            return s == opt
        }
        return false
    }
    return selectedness(doc, opt)
}

/// Selects `opt` in `sel`; in a single select, the others are no
/// longer selected.
pub fn selectOption(doc: *mut Document, sel: NodeId, opt: NodeId) AllocError!void {
    if doc.attr(sel, "multiple") == null {
        var opts = List(NodeId).init(doc.alloc)
        defer opts.deinit()
        try options(doc, sel, &mut opts)
        for o in opts.items() {
            try setSelected(doc, o, o == opt)
        }
        return
    }
    try setSelected(doc, opt, true)
}

/// Sets the selectedness of one option.
pub fn setSelected(doc: *mut Document, opt: NodeId, on: bool) AllocError!void {
    let c = try doc.controls.ensure(opt)
    c.selected = on
    c.selected_dirty = true
}

/// The label of an option: its `label` attribute, else its text, with
/// runs of whitespace as one space, trimmed.
pub fn optionLabel(doc: *Document, opt: NodeId, out: *mut text.Builder) AllocError!void {
    var raw = text.Builder.init(doc.alloc)
    defer raw.deinit()
    if doc.attr(opt, "label") |l| {
        try raw.append(l)
    } else {
        try doc.textContent(opt, &mut raw)
    }
    var space = false
    let start = out.len()
    for c in raw.bytes() {
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\x0C' {
            space = out.len() > start
        } else {
            if space {
                try out.appendByte(' ')
                space = false
            }
            try out.appendByte(c)
        }
    }
}

/// The index of the option a `select` shows among its options; -1 for
/// none.
pub fn selectedIndex(doc: *Document, sel: NodeId) AllocError!i64 {
    let shown = selectedOption(doc, sel) orelse return -1
    var opts = List(NodeId).init(doc.alloc)
    defer opts.deinit()
    try options(doc, sel, &mut opts)
    for i, o in opts.items() {
        if o == shown {
            return i as i64
        }
    }
    return -1
}

// ---- reset

/// Resets the controls of `form` to their defaults: values, checkedness,
/// selectedness (also of the options of its selects).
pub fn resetForm(doc: *mut Document, form: NodeId) AllocError!void {
    var list = List(NodeId).init(doc.alloc)
    defer list.deinit()
    try formControls(doc, form, &mut list)
    for el in list.items() {
        doc.controls.forget(el)
        if doc.isElement(el, "select") {
            var opts = List(NodeId).init(doc.alloc)
            defer opts.deinit()
            try options(doc, el, &mut opts)
            for o in opts.items() {
                doc.controls.forget(o)
            }
        }
    }
}

// ---- text editing

/// The selected text of a text field ("" when the selection is empty).
pub fn selectedText(doc: *Document, el: NodeId) []u8 {
    let v = valueOf(doc, el)
    if doc.controls.get(el) |c| {
        let r = selRange(c, v.len)
        return v[r.lo..r.hi]
    }
    return ""
}

/// A selection or caret position: `lo..hi`.
pub struct Span {
    lo: usize
    hi: usize
}

fn selRange(c: *Control, len: usize) Span {
    var lo = c.anchor
    var hi = c.caret
    if lo > hi {
        lo = c.caret
        hi = c.anchor
    }
    if hi > len {
        hi = len
    }
    if lo > hi {
        lo = hi
    }
    return Span { lo: lo, hi: hi }
}

/// The caret and selection of a text field, within its value.
pub fn caretOf(doc: *Document, el: NodeId) Span {
    let v = valueOf(doc, el)
    if doc.controls.get(el) |c| {
        var k = c.caret
        if k > v.len {
            k = v.len
        }
        return Span { lo: k, hi: k }
    }
    return Span { lo: v.len, hi: v.len }
}

/// The selection of a text field (`lo == hi`: none).
pub fn selectionOf(doc: *Document, el: NodeId) Span {
    let v = valueOf(doc, el)
    if doc.controls.get(el) |c| {
        return selRange(c, v.len)
    }
    return Span { lo: v.len, hi: v.len }
}

// Makes the state of a text field dirty with its current value, so
// that edits have a value to change; returns it.
fn editable(doc: *mut Document, el: NodeId) AllocError!*mut Control {
    let has = doc.controls.get(el)
    var fresh = true
    if has |c| {
        fresh = !c.dirty
    }
    if fresh {
        let v = valueOf(doc, el)
        var caret = v.len
        var anchor = v.len
        if has |c| {
            caret = c.caret
            anchor = c.anchor
        }
        try setValue(doc, el, v)
        let c2 = doc.controls.get(el).?
        if caret <= c2.value.len && anchor <= c2.value.len {
            c2.caret = caret
            c2.anchor = anchor
        }
    }
    return doc.controls.get(el).?
}

// Replaces `lo..hi` of the field's value with `s`; the caret goes after
// `s`.
fn splice(doc: *mut Document, el: NodeId, lo: usize, hi: usize, s: []u8) AllocError!void {
    let c = try editable(doc, el)
    let old = c.value
    let fresh = try doc.controls.alloc.alloc(0 as u8, old.len - (hi - lo) + s.len)
    std.mem.copy(fresh, old[..lo])
    std.mem.copy(fresh[lo..], s)
    std.mem.copy(fresh[lo + s.len..], old[hi..])
    doc.controls.alloc.free(old)
    c.value = fresh
    c.caret = lo + s.len
    c.anchor = c.caret
}

/// Types `s` into the text field `el` at the caret, replacing the
/// selection (newlines are dropped in an `input`, and so is the text
/// beyond `maxlength`).
pub fn insertText(doc: *mut Document, el: NodeId, s: []u8) AllocError!void {
    let c = try editable(doc, el)
    let r = selRange(c, c.value.len)
    var clean = text.Builder.init(doc.alloc)
    defer clean.deinit()
    let one_line = doc.isElement(el, "input")
    for ch in s {
        if !(one_line && (ch == '\n' || ch == '\r')) {
            try clean.appendByte(ch)
        }
    }
    var add = clean.bytes()
    if doc.attr(el, "maxlength") |m| {
        let max = text.parseInt(text.trim(m)) catch -1
        if max >= 0 {
            let have = codePoints(c.value) - codePoints(c.value[r.lo..r.hi])
            if have + codePoints(add) > max as usize {
                var allowed: usize = 0
                if max as usize > have {
                    allowed = max as usize - have
                }
                add = add[..byteOfPoint(add, allowed)]
            }
        }
    }
    try splice(doc, el, r.lo, r.hi, add)
}

fn codePoints(s: []u8) usize {
    var n: usize = 0
    for c in s {
        if (c & 0xC0) != 0x80 {
            n += 1
        }
    }
    return n
}

// The byte offset of code point `n` of `s` (or its length).
fn byteOfPoint(s: []u8, n: usize) usize {
    var seen: usize = 0
    for i, c in s {
        if (c & 0xC0) != 0x80 {
            if seen == n {
                return i
            }
            seen += 1
        }
    }
    return s.len
}

/// Backspace: deletes the selection, else the code point before the
/// caret.
pub fn deleteBackward(doc: *mut Document, el: NodeId) AllocError!void {
    let c = try editable(doc, el)
    let r = selRange(c, c.value.len)
    if r.lo < r.hi {
        return splice(doc, el, r.lo, r.hi, "")
    }
    if r.lo == 0 {
        return
    }
    return splice(doc, el, prevPoint(c.value, r.lo), r.lo, "")
}

/// Delete: deletes the selection, else the code point after the caret.
pub fn deleteForward(doc: *mut Document, el: NodeId) AllocError!void {
    let c = try editable(doc, el)
    let r = selRange(c, c.value.len)
    if r.lo < r.hi {
        return splice(doc, el, r.lo, r.hi, "")
    }
    if r.hi >= c.value.len {
        return
    }
    return splice(doc, el, r.hi, nextPoint(c.value, r.hi), "")
}

pub enum Motion {
    Left
    Right
    // The start and end of the line (of the value, for an `input`).
    Home
    End
    // The line above and below (a `textarea`), else Home and End.
    Up
    Down
    // The start and end of the value.
    Start
    Finish
}

/// Moves the caret; with `extend`, the selection's other end stays.
/// Left and Right without `extend` collapse a selection to its start or
/// end.
pub fn moveCaret(doc: *mut Document, el: NodeId, m: Motion, extend: bool) AllocError!void {
    let c = try editable(doc, el)
    let v = c.value
    let r = selRange(c, v.len)
    var k = c.caret
    if k > v.len {
        k = v.len
    }
    match m {
        .Left => {
            if !extend && r.lo < r.hi {
                k = r.lo
            } else if k > 0 {
                k = prevPoint(v, k)
            }
        }
        .Right => {
            if !extend && r.lo < r.hi {
                k = r.hi
            } else if k < v.len {
                k = nextPoint(v, k)
            }
        }
        .Home => {
            k = lineStart(v, k)
        }
        .End => {
            k = lineEnd(v, k)
        }
        .Up => {
            let start = lineStart(v, k)
            if start == 0 {
                k = 0
            } else {
                let col = codePoints(v[start..k])
                let above = lineStart(v, start - 1)
                k = above + byteOfPoint(v[above..start - 1], col)
            }
        }
        .Down => {
            let end = lineEnd(v, k)
            if end >= v.len {
                k = v.len
            } else {
                let col = codePoints(v[lineStart(v, k)..k])
                let next = end + 1
                let next_end = lineEnd(v, next)
                k = next + byteOfPoint(v[next..next_end], col)
            }
        }
        .Start => {
            k = 0
        }
        .Finish => {
            k = v.len
        }
    }
    c.caret = k
    if !extend {
        c.anchor = k
    }
}

/// Selects the whole value of a text field.
pub fn selectAll(doc: *mut Document, el: NodeId) AllocError!void {
    let c = try editable(doc, el)
    c.anchor = 0
    c.caret = c.value.len
}

/// Puts the caret at byte `k` of the value (at a code point boundary at
/// or before it), with nothing selected.
pub fn setCaret(doc: *mut Document, el: NodeId, k: usize) AllocError!void {
    let c = try editable(doc, el)
    var at = k
    if at > c.value.len {
        at = c.value.len
    }
    while at > 0 && at < c.value.len && (c.value[at] & 0xC0) == 0x80 {
        at -= 1
    }
    c.caret = at
    c.anchor = at
}

fn lineStart(v: []u8, k: usize) usize {
    var i = k
    while i > 0 && v[i - 1] != '\n' {
        i -= 1
    }
    return i
}

fn lineEnd(v: []u8, k: usize) usize {
    var i = k
    while i < v.len && v[i] != '\n' {
        i += 1
    }
    return i
}

// The start of the code point before offset `i` (> 0).
fn prevPoint(s: []u8, i: usize) usize {
    var k = i - 1
    while k > 0 && (s[k] & 0xC0) == 0x80 {
        k -= 1
    }
    return k
}

// The end of the code point at offset `i` (< s.len).
fn nextPoint(s: []u8, i: usize) usize {
    var k = i + 1
    while k < s.len && (s[k] & 0xC0) == 0x80 {
        k += 1
    }
    return k
}

// ---- tests

fn addEl(doc: *mut Document, parent: NodeId, name: []u8, attrs: []Attr) AllocError!NodeId {
    let e = try doc.createElement(name, attrs)
    doc.appendChild(parent, e)
    return e
}

test "values, checkedness and reset" {
    var doc = try Document.init(@testAllocator())
    defer doc.deinit()
    let form = try addEl(&mut doc, doc.root, "form", []Attr{})
    var a1 = [_]Attr{Attr { name: "value", value: "ada" }, Attr { name: "type", value: "TEXT" }}
    let field = try addEl(&mut doc, form, "input", a1[..])
    @expectEqual("text", inputType(&doc, field))
    @expect(isTextField(&doc, field))
    @expectEqual("ada", valueOf(&doc, field))
    try setValue(&mut doc, field, "grace\nhopper")
    @expectEqual("gracehopper", valueOf(&doc, field))
    @expectEqual("ada", defaultValue(&doc, field))

    var r1 = [_]Attr{Attr { name: "type", value: "radio" }, Attr { name: "name", value: "p" }, Attr { name: "checked", value: "" }}
    var r2 = [_]Attr{Attr { name: "type", value: "radio" }, Attr { name: "name", value: "p" }, Attr { name: "value", value: "pro" }}
    let free = try addEl(&mut doc, form, "input", r1[..])
    let pro = try addEl(&mut doc, form, "input", r2[..])
    @expect(isChecked(&doc, free))
    @expectEqual("on", valueOf(&doc, free))
    try setChecked(&mut doc, pro, true)
    @expect(isChecked(&doc, pro))
    @expect(!isChecked(&doc, free))
    @expect(formOwner(&doc, pro) == form)

    try resetForm(&mut doc, form)
    @expect(isChecked(&doc, free))
    @expect(!isChecked(&doc, pro))
    @expectEqual("ada", valueOf(&doc, field))
}

test "select" {
    var doc = try Document.init(@testAllocator())
    defer doc.deinit()
    let sel = try addEl(&mut doc, doc.root, "select", []Attr{})
    var dis = [_]Attr{Attr { name: "disabled", value: "" }}
    let a = try addEl(&mut doc, sel, "option", dis[..])
    try doc.appendText(a, "A")
    let group = try addEl(&mut doc, sel, "optgroup", []Attr{})
    var bv = [_]Attr{Attr { name: "value", value: "b" }}
    let b = try addEl(&mut doc, group, "option", bv[..])
    try doc.appendText(b, "  Bee\n ")
    // The first option that is not disabled shows by default.
    @expect(selectedOption(&doc, sel) == b)
    @expectEqual("b", valueOf(&doc, sel))
    try setValue(&mut doc, sel, "A")
    @expect(isSelected(&doc, a))
    @expect(!isSelected(&doc, b))
    @expectEqual(0, try selectedIndex(&doc, sel))
    var label = text.Builder.init(@testAllocator())
    defer label.deinit()
    try optionLabel(&doc, b, &mut label)
    @expectEqual("Bee", label.bytes())
}

test "editing text" {
    var doc = try Document.init(@testAllocator())
    defer doc.deinit()
    var ml = [_]Attr{Attr { name: "maxlength", value: "6" }}
    let f = try addEl(&mut doc, doc.root, "input", ml[..])
    try insertText(&mut doc, f, "héllo")
    try moveCaret(&mut doc, f, Motion.Left, false)
    try moveCaret(&mut doc, f, Motion.Left, true)
    @expectEqual("l", selectedText(&doc, f))
    try insertText(&mut doc, f, "LLxyz")
    @expectEqual("hélLLo", valueOf(&doc, f))
    try moveCaret(&mut doc, f, Motion.Home, false)
    try deleteForward(&mut doc, f)
    try moveCaret(&mut doc, f, Motion.Right, false)
    try deleteBackward(&mut doc, f)
    @expectEqual("lLLo", valueOf(&doc, f))
    try selectAll(&mut doc, f)
    try deleteBackward(&mut doc, f)
    @expectEqual("", valueOf(&doc, f))

    let ta = try addEl(&mut doc, doc.root, "textarea", []Attr{})
    try doc.appendText(ta, "one\ntwo")
    @expectEqual("one\ntwo", valueOf(&doc, ta))
    try moveCaret(&mut doc, ta, Motion.Up, false)
    try insertText(&mut doc, ta, "!\n")
    @expectEqual("one!\n\ntwo", valueOf(&doc, ta))
}
