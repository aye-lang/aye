// Unit tests of the modules that import other browser modules (`net`,
// `html`, `css`): `aye test` compiles only the root module's tests, and those
// modules cannot be roots of their own. `aye test browser` runs them.
// url, dom and encoding have their tests in their own files.

import css
import dom
import dom.NodeId
import engine
import font
import html
import js
import net
import std.heap.Arena
import std.list.List
import std.mem.Allocator
import std.text
import url

test "content types" {
    let ct = net.parseContentType("text/html; charset=\"UTF-8\"")
    @expectEqual("text/html", ct.mime)
    @expectEqual("UTF-8", ct.charset)
    let plain = net.parseContentType("image/png")
    @expectEqual("image/png", plain.mime)
    @expectEqual("", plain.charset)
}

test "types of paths" {
    @expectEqual("text/html", net.typeOfPath("/a/b/index.HTML"))
    @expectEqual("text/plain", net.typeOfPath("notes.txt"))
    @expectEqual("application/octet-stream", net.typeOfPath("/a.d/README"))
}

test "base64" {
    let a = @testAllocator()
    let s = try net.base64Decode(a, "SGVs bG8=")
    defer a.free(s)
    @expectEqual("Hello", s)
    let t = try net.base64Decode(a, "SGVsbG8")
    defer a.free(t)
    @expectEqual("Hello", t)
    let bad = net.base64Decode(a, "SGV$") catch |e| {
        return
    }
    a.free(bad)
    @expect(false)
}

test "fetch a data: URL" {
    let a = @testAllocator()
    let u = try url.parse(a, "data:text/html;charset=latin1;base64,PHA+Q2Fm6TwvcD4=#frag")
    defer u.deinit(a)
    let res = try net.fetch(a, &u)
    defer res.deinit(a)
    @expectEqual("text/html", res.mime)
    @expectEqual("latin1", res.charset)
    @expectEqual("<p>Caf\xE9</p>", res.body)
}

test "parse and query a document" {
    let a = @testAllocator()
    var doc = try html.parse(a, "<ul id=l><li>a<li class=x>b</ul><p id=p>t")
    defer doc.deinit()
    var items = List(NodeId).init(a)
    defer items.deinit()
    try doc.getElementsByTagName("li", &mut items)
    @expectEqual(2, items.len())
    let second = items.items()[1]
    if doc.attr(second, "class") |v| {
        @expectEqual("x", v)
    } else {
        @expect(false)
    }
    if doc.getElementById("l") |list| {
        @expect(dom.isSame(doc.parent(second), list))
    } else {
        @expect(false)
    }
    @expect(dom.isSame(doc.nextSibling(items.items()[0]), second))
    @expect(doc.getElementById("missing") == null)
}

test "css tokens" {
    let a = @testAllocator()
    var arena = Arena.init(a)
    defer arena.deinit()
    var toks = List(css.Token).init(a)
    defer toks.deinit()
    try css.tokenize(arena.allocator(), "a.b#x 12px -3.5e1% url( p.png ) f( 'q\\'s' @media/**/<!-- \\31 x", &mut toks)
    let t = toks.items()
    @expectEqual(19, t.len)
    @expect(t[0].kind == css.Tok.Ident)
    @expect(t[1].kind == css.Tok.Delim && t[1].delim == '.')
    @expect(t[3].kind == css.Tok.Hash && t[3].flag)
    @expectEqual("x", t[3].text)
    @expect(t[5].kind == css.Tok.Dimension && t[5].num == 12.0 && t[5].flag)
    @expectEqual("px", t[5].text)
    @expect(t[7].kind == css.Tok.Percentage && t[7].num == -35.0)
    @expect(t[9].kind == css.Tok.Url)
    @expectEqual("p.png", t[9].text)
    @expect(t[11].kind == css.Tok.Function)
    @expectEqual("q's", t[13].text)
    @expect(t[15].kind == css.Tok.AtKeyword)
    @expect(t[16].kind == css.Tok.Cdo)
    @expect(t[17].kind == css.Tok.Whitespace)
    @expectEqual("1x", t[18].text)
}

// The specificity of the first selector of a one-rule sheet.
fn specificityOf(a: Allocator, src: []u8) !u32 {
    var sheet = try css.Sheet.init(a)
    defer sheet.deinit()
    try css.parseSheet(&mut sheet, src, css.Media { width: 800.0, height: 600.0 })
    if sheet.rules.len() != 1 {
        return 999999
    }
    return sheet.complexes.items()[sheet.rules.items()[0].sel_start].spec
}

test "css specificity" {
    let a = @testAllocator()
    @expectEqual(0x000001, try specificityOf(a, "p {}"))
    @expectEqual(0x010101, try specificityOf(a, "#a .b c {}"))
    @expectEqual(0x000200, try specificityOf(a, "[x]:first-child {}"))
    @expectEqual(0x010001, try specificityOf(a, "p:not(.a, #b) {}"))
    @expectEqual(0x000002, try specificityOf(a, "p::before {}"))
    @expectEqual(0, try specificityOf(a, "* {}"))
    @expectEqual(999999, try specificityOf(a, "p:nope {}"))
}

test "css colors and media" {
    let a = @testAllocator()
    if css.namedColor("RebeccaPurple") |c| {
        @expect(c.r == 102 && c.g == 51 && c.b == 153 && c.a == 1.0)
    } else {
        @expect(false)
    }
    @expect(css.namedColor("nocolor") == null)
    var sheet = try css.Sheet.init(a)
    defer sheet.deinit()
    let wide = css.Media { width: 1000.0, height: 600.0 }
    @expect(try css.mediaMatches(&mut sheet, "", wide))
    @expect(try css.mediaMatches(&mut sheet, "screen and (min-width: 900px)", wide))
    @expect(!(try css.mediaMatches(&mut sheet, "print", wide)))
    @expect(try css.mediaMatches(&mut sheet, "print, (orientation: landscape)", wide))
    @expect(!(try css.mediaMatches(&mut sheet, "not all and (width > 999px)", wide)))
}

test "css cascade" {
    let a = @testAllocator()
    var doc = try html.parse(a, "<style>p { color: red } #x { margin: 1em 2px }</style><div style='font-size: 20px'><p id=x>t")
    defer doc.deinit()
    let media = css.Media { width: 800.0, height: 600.0 }
    var ua = try css.Sheet.init(a)
    defer ua.deinit()
    try css.uaSheet(&mut ua, media)
    var author = try css.Sheet.init(a)
    defer author.deinit()
    var styles = try css.Styles.init(a)
    defer styles.deinit()
    var src = text.Builder.init(a)
    defer src.deinit()
    var sheets = List(NodeId).init(a)
    defer sheets.deinit()
    try doc.getElementsByTagName("style", &mut sheets)
    try doc.textContent(sheets.items()[0], &mut src)
    try css.parseSheet(&mut author, src.bytes(), media)
    try css.computeStyles(&doc, &ua, &author, media, &mut styles)
    var out = text.Builder.init(a)
    defer out.deinit()
    if doc.getElementById("x") |p| {
        if styles.get(p) |v| {
            try css.writeValue(v[css.COLOR], &mut out)
            try out.append(" ")
            try css.writeValue(v[css.MARGIN_TOP], &mut out)
            try out.append(" ")
            try css.writeValue(v[css.MARGIN_TOP + 1], &mut out)
            try out.append(" ")
            try css.writeValue(v[css.DISPLAY], &mut out)
        }
    }
    @expectEqual("rgb(255, 0, 0) 20px 2px block", out.bytes())
}

// The colors of the elements `ids` in `styles`, as text, into `out`.
fn colorsOf(doc: *dom.Document, styles: *css.Styles, ids: [][]u8, out: *mut text.Builder) !void {
    out.clear()
    for id in ids {
        try css.writeValue(styles.get(doc.getElementById(id).?).?[css.COLOR], out)
        try out.append(";")
    }
}

test "elements share equal computed values, and a restyle of one leaves the others" {
    let a = @testAllocator()
    var doc = try html.parse(a, "<p id=a>t</p><p id=b>u</p><p id=c style='color: red'>v</p>")
    defer doc.deinit()
    let media = css.Media { width: 800.0, height: 600.0 }
    var ua = try css.Sheet.init(a)
    defer ua.deinit()
    try css.uaSheet(&mut ua, media)
    var author = try css.Sheet.init(a)
    defer author.deinit()
    var styles = try css.Styles.init(a)
    defer styles.deinit()
    try css.computeStyles(&doc, &ua, &author, media, &mut styles)
    let pa = doc.getElementById("a").?
    let pb = doc.getElementById("b").?
    @expect(styles.get(pa).?.ptr == styles.get(pb).?.ptr)
    @expect(styles.get(pa).?.ptr != styles.get(doc.getElementById("c").?).?.ptr)
    let ids = [3][]u8{"a", "b", "c"}
    var out = text.Builder.init(a)
    defer out.deinit()
    let shallow = [1]bool{false}
    // `a` and `b` hold the same values: `a`'s new ones go elsewhere.
    try doc.setAttr(pa, "style", "color: blue")
    let roots_a = [1]NodeId{pa}
    _ = try css.restyleSubtrees(&doc, &ua, &author, media, roots_a[..], shallow[..], &mut styles)
    try colorsOf(&doc, &styles, ids[..], &mut out)
    @expectEqual("rgb(0, 0, 255);rgb(0, 0, 0);rgb(255, 0, 0);", out.bytes())
    // `b` takes `a`'s values; then `a` changes again, `b` keeps them.
    try doc.setAttr(pb, "style", "color: blue")
    let roots_b = [1]NodeId{pb}
    _ = try css.restyleSubtrees(&doc, &ua, &author, media, roots_b[..], shallow[..], &mut styles)
    @expect(styles.get(pa).?.ptr == styles.get(pb).?.ptr)
    try doc.setAttr(pa, "style", "color: green")
    _ = try css.restyleSubtrees(&doc, &ua, &author, media, roots_a[..], shallow[..], &mut styles)
    try colorsOf(&doc, &styles, ids[..], &mut out)
    @expectEqual("rgb(0, 128, 0);rgb(0, 0, 255);rgb(255, 0, 0);", out.bytes())
}

test "adopted sheets and shadow trees" {
    let a = @testAllocator()
    let src = "<x-a><template shadowrootmode=open><style>p { margin-top: 1px }</style><p>in</p><slot></slot></template><p>light</p></x-a>"
    // Fragment parsing keeps the template.
    var frag = try html.parseWith(a, src, false)
    defer frag.deinit()
    @expectEqual(0, frag.shadows.len())
    var doc = try html.parse(a, src)
    defer doc.deinit()
    @expectEqual(1, doc.shadows.len())
    let root = doc.shadows.items()[0]
    let host = dom.hostOf(&doc, root).?
    try doc.adopted.append(dom.Adopted { root: doc.root, css: "p { color: red }" })
    try doc.adopted.append(dom.Adopted { root: root, css: "p { color: blue } :host { margin-left: 3px }" })
    try dom.assignSlots(&mut doc)
    let media = css.Media { width: 800.0, height: 600.0 }
    var ua = try css.Sheet.init(a)
    defer ua.deinit()
    try css.uaSheet(&mut ua, media)
    var author = try css.Sheet.init(a)
    defer author.deinit()
    let address = try url.parse(a, "about:blank")
    defer address.deinit(a)
    try engine.authorSheets(a, &doc, &address, media, &mut author)
    @expectEqual(1, author.scoped.len())
    var styles = try css.Styles.init(a)
    defer styles.deinit()
    try css.computeStyles(&doc, &ua, &author, media, &mut styles)
    var out = text.Builder.init(a)
    defer out.deinit()
    var cur: ?NodeId = doc.root
    while cur |h| {
        if doc.isElement(h, "p") {
            let v = styles.get(h).?
            try css.writeValue(v[css.COLOR], &mut out)
            try out.append(" ")
            try css.writeValue(v[css.MARGIN_TOP], &mut out)
            try out.append("; ")
        }
        cur = dom.shadowIncludingFollowing(&doc, h, doc.root)
    }
    try css.writeValue(styles.get(host).?[css.MARGIN_TOP + 3], &mut out)
    @expectEqual("rgb(0, 0, 255) 1px; rgb(255, 0, 0) 16px; 3px", out.bytes())
}

// The value that the last declaration of `prop` in `sheet` gives.
fn declValue(sheet: *css.Sheet, prop: usize) css.Value {
    var v = css.Value.Unset
    for d in sheet.decls.items() {
        if d.prop == prop {
            v = d.value
        }
    }
    return v
}

fn keywordText(v: css.Value) []u8 {
    return match v {
        .Keyword { k } => k
        _ => ""
    }
}

test "css layered values" {
    let a = @testAllocator()
    var sheet = try css.Sheet.init(a)
    defer sheet.deinit()
    // A fetched sheet's URLs are absolute (not fragments or data: URLs).
    sheet.base = "http://example.test/css/site.css"
    let src = "p { background: url(../img/a.png) no-repeat right 10px top / 20px, linear-gradient(to right, red, blue 50%) #eee; -webkit-mask-image: url('#m'); border-radius: 4px 50% / 2px; box-shadow: inset 0 1px 2px rgb(0 0 0 / 50%) }"
    try css.parseSheet(&mut sheet, src, css.Media { width: 800.0, height: 600.0 })
    sheet.base = ""
    @expectEqual("url(\"http://example.test/img/a.png\"), linear-gradient(to right, red, blue 50%)", keywordText(declValue(&sheet, css.BACKGROUND_IMAGE)))
    @expectEqual("no-repeat, repeat", keywordText(declValue(&sheet, css.BACKGROUND_REPEAT)))
    @expectEqual("url(\"#m\")", keywordText(declValue(&sheet, css.MASK_IMAGE)))
    @expectEqual("50% 2px", keywordText(declValue(&sheet, css.BORDER_TOP_LEFT_RADIUS + 1)))
    // Read back for paint.
    var arena = Arena.init(a)
    defer arena.deinit()
    let aa = arena.allocator()
    var layers = List([]css.Comp).init(aa)
    try css.readLayers(aa, declValue(&sheet, css.BACKGROUND_POSITION), &mut layers)
    @expectEqual(2, layers.len())
    let pos = css.readPosition(layers.items()[0])
    @expect(pos.x.pct == 100.0 && pos.x.px == -10.0 && pos.y.pct == 0.0)
    layers.clear()
    try css.readLayers(aa, declValue(&sheet, css.BACKGROUND_IMAGE), &mut layers)
    @expectEqual("http://example.test/img/a.png", css.imageUrl(layers.items()[0][0]).?)
    let g = (try css.readGradient(aa, layers.items()[1][0])).?
    @expect(g.kind == 0 && g.angle == 90.0 && g.stops.len() == 2)
    @expect(g.stops.items()[0].pos == null && g.stops.items()[1].pos.?.pct == 50.0)
    layers.clear()
    try css.readLayers(aa, declValue(&sheet, css.BOX_SHADOW), &mut layers)
    let sh = css.readShadow(layers.items()[0]).?
    @expect(sh.inset && sh.y == 1.0 && sh.blur == 2.0)
}

// Runs `src` in the page; its result as text.
fn evalText(p: *mut engine.Page, src: []u8, out: *mut text.Builder) !bool {
    out.clear()
    return engine.evalInPage(p, src, out)
}

test "a node taken out of the document lives while a script holds it" {
    let a = @testAllocator()
    engine.setScripting(true)
    let u = try url.parse(a, "data:text/html,<div id=box><p id=kept>kept <b>x</b></p><p id=gone>gone</p></div>")
    defer u.deinit(a)
    let p = try engine.load(a, &u)
    defer p.destroy()
    let kept = p.doc.getElementById("kept").?
    let bold = p.doc.firstChild(kept).?
    let gone = p.doc.getElementById("gone").?
    var out = text.Builder.init(a)
    defer out.deinit()
    // Both are removed; a global holds one.
    @expect(try evalText(p, "const box = document.getElementById('box'); window.held = box.removeChild(document.getElementById('kept')); box.removeChild(document.getElementById('gone')); 0", &mut out))
    @expect(p.doc.isLive(kept) && p.doc.isLive(gone))
    js.collectGarbage(&mut p.script.?.it)
    // The held tree (and the node in it) stays; the other one is freed.
    @expect(p.doc.isLive(kept))
    @expect(p.doc.isLive(bold))
    @expect(!p.doc.isLive(gone))
    @expect(p.doc.node(kept).js_refs > 0)
    @expect(try evalText(p, "held.textContent", &mut out))
    @expectEqual("kept x", out.bytes())
    // A wrapper of a node inside the held tree keeps the whole tree.
    @expect(try evalText(p, "window.inner = held.firstElementChild; held = null; 0", &mut out))
    js.collectGarbage(&mut p.script.?.it)
    @expect(p.doc.isLive(kept) && p.doc.isLive(bold))
    @expect(try evalText(p, "inner.parentNode.id", &mut out))
    @expectEqual("kept", out.bytes())
    // Once no wrapper is left, the tree is freed.
    @expect(try evalText(p, "inner = null; 0", &mut out))
    js.collectGarbage(&mut p.script.?.it)
    @expect(!p.doc.isLive(kept))
    @expect(!p.doc.isLive(bold))
    @expect(p.doc.isLive(p.doc.getElementById("box").?))
}

test "wrappers of nodes in the document keep their properties" {
    let a = @testAllocator()
    engine.setScripting(true)
    let u = try url.parse(a, "data:text/html,<p id=p>x</p>")
    defer u.deinit(a)
    let p = try engine.load(a, &u)
    defer p.destroy()
    var out = text.Builder.init(a)
    defer out.deinit()
    @expect(try evalText(p, "document.getElementById('p').note = 'kept'; 0", &mut out))
    js.collectGarbage(&mut p.script.?.it)
    @expect(try evalText(p, "document.getElementById('p').note", &mut out))
    @expectEqual("kept", out.bytes())
}

// The color of `el` in the styles of `p`, as text, into `out`.
fn styledColor(p: *engine.Page, el: NodeId, out: *mut text.Builder) !void {
    out.clear()
    let v = p.styling.?.styles.get(el).?
    try css.writeValue(v[css.COLOR], out)
}

// Marks the color of `el` in the styles of `p`: it stays "marked" while
// those styles are kept. The element gets values of its own: others
// may share those it has.
fn markColor(p: *mut engine.Page, el: NodeId) !void {
    let styles = &mut p.styling.?.styles
    let v = styles.map.get(el.index).?
    let mine = try styles.arena.allocator().alloc(css.Value.Initial, css.NPROPS)
    for i in 0..css.NPROPS {
        mine[i] = v[i]
    }
    mine[css.COLOR] = css.Value.Keyword { k: "marked" }
    try styles.map.put(el.index, mine)
}

test "a restyle keeps the styles while nothing they depend on changed" {
    let a = @testAllocator()
    engine.setScripting(true)
    let u = try url.parse(a, "data:text/html,<style>.on { color: red } :focus { color: blue } @media (max-width: 500px) { p { color: green } }</style><p id=p class=x tabindex=0>t</p>")
    defer u.deinit(a)
    let p = try engine.load(a, &u)
    defer p.destroy()
    var fixed = font.Fixed.init()
    try p.layoutPage(&mut fixed, 800.0, 600.0)
    let el = p.doc.getElementById("p").?
    var out = text.Builder.init(a)
    defer out.deinit()
    try styledColor(p, el, &mut out)
    @expectEqual("rgb(0, 0, 0)", out.bytes())
    // Nothing changed: the styles stay.
    try markColor(p, el)
    try p.restyle()
    try p.layoutPage(&mut fixed, 800.0, 600.0)
    try styledColor(p, el, &mut out)
    @expectEqual("marked", out.bytes())
    // A class that no rule names changes no style.
    @expect(try evalText(p, "document.getElementById('p').classList.add('nobody'); 0", &mut out))
    try p.restyle()
    try styledColor(p, el, &mut out)
    @expectEqual("marked", out.bytes())
    // A class a rule names does.
    @expect(try evalText(p, "document.getElementById('p').classList.add('on'); 0", &mut out))
    try p.restyle()
    try styledColor(p, el, &mut out)
    @expectEqual("rgb(255, 0, 0)", out.bytes())
    // So does a change no script made (the agent's), which no version
    // counts.
    try markColor(p, el)
    try p.doc.setAttr(el, "class", "x")
    try p.restyle()
    try styledColor(p, el, &mut out)
    @expectEqual("rgb(0, 0, 0)", out.bytes())
    // And the focus.
    try markColor(p, el)
    p.doc.controls.focus = el
    try p.restyle()
    try styledColor(p, el, &mut out)
    @expectEqual("rgb(0, 0, 255)", out.bytes())
    // And the viewport.
    p.doc.controls.focus = null
    try p.restyle()
    try markColor(p, el)
    try p.layoutPage(&mut fixed, 400.0, 600.0)
    try styledColor(p, el, &mut out)
    @expectEqual("rgb(0, 128, 0)", out.bytes())
    try p.layoutPage(&mut fixed, 800.0, 600.0)
    try styledColor(p, el, &mut out)
    @expectEqual("rgb(0, 0, 0)", out.bytes())
}

test "style inputs see a class only where a selector can" {
    let a = @testAllocator()
    var doc = try html.parse(a, "<p id=p><a id=a>t</a><span id=s>u</span></p>")
    defer doc.deinit()
    let media = css.Media { width: 800.0, height: 600.0 }
    var ua = try css.Sheet.init(a)
    defer ua.deinit()
    var author = try css.Sheet.init(a)
    defer author.deinit()
    try css.parseSheet(&mut author, "a:not([class]) { color: red } .on { color: blue } :is(span):not([class~=k]) { margin-top: 1px } div [class$=z] { color: green }", media)
    var styles = try css.Styles.init(a)
    defer styles.deinit()
    try css.computeStyles(&doc, &ua, &author, media, &mut styles)
    let start = styles.inputs
    @expect(start != 0)
    @expectEqual(start, css.styleInputs(&doc, media, &styles))
    let p = doc.getElementById("p").?
    let link = doc.getElementById("a").?
    let span = doc.getElementById("s").?
    // Classes no selector names, where the attribute selectors on
    // `class` give the same answers.
    try doc.setAttr(span, "class", "nobody")
    try doc.setAttr(p, "class", "nobody else")
    @expectEqual(start, css.styleInputs(&doc, media, &styles))
    // `a:not([class])`: the first class of a link.
    try doc.setAttr(link, "class", "nobody")
    @expect(css.styleInputs(&doc, media, &styles) != start)
    doc.removeAttr(link, "class")
    @expectEqual(start, css.styleInputs(&doc, media, &styles))
    try doc.setAttr(span, "class", "nobody k")
    @expect(css.styleInputs(&doc, media, &styles) != start)
    try doc.setAttr(span, "class", "nobody")
    try doc.setAttr(p, "class", "On")
    @expect(css.styleInputs(&doc, media, &styles) != start)
    // The case of a named class counts (`.on` does not match "On").
    let upper = css.styleInputs(&doc, media, &styles)
    try doc.setAttr(p, "class", "on")
    @expect(css.styleInputs(&doc, media, &styles) != upper)
    try doc.setAttr(p, "class", "xyz")
    @expect(css.styleInputs(&doc, media, &styles) != start)
    try doc.setAttr(p, "class", "")
    @expectEqual(start, css.styleInputs(&doc, media, &styles))
    // Anything else counts.
    try doc.setAttr(p, "title", "x")
    @expect(css.styleInputs(&doc, media, &styles) != start)
    doc.removeAttr(p, "title")
    @expectEqual(start, css.styleInputs(&doc, media, &styles))
    @expect(css.styleInputs(&doc, css.Media { width: 799.0, height: 600.0 }, &styles) != start)
}
