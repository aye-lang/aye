// js/numconv: numbers to text and back, as ECMAScript specifies them.
//
// Number::toString finds the shortest decimal that reads back as the same
// double: it tries 1 to 17 significant digits with C's correctly rounded
// `%.*e` and keeps the first that strtod maps back to the value (17
// always does). That gives the same digits as the spec's "k as small as
// possible" rule; the layout (plain, `0.000ddd` or `d.ddde+n`) follows
// the spec.

import std.mem.AllocError
import std.text

extern fn snprintf(buf: [*]u8, size: usize, format: [*]u8, ...) i32
extern fn fmod(x: f64, y: f64) f64
extern fn trunc(x: f64) f64

pub fn isNaN(v: f64) bool {
    return v != v
}

pub fn isFinite(v: f64) bool {
    return v == v && v - v == 0.0
}

// 1/x is -Infinity only for -0.
pub fn isNegZero(v: f64) bool {
    return v == 0.0 && 1.0 / v < 0.0
}

/// Is `v` an integer that a double holds exactly (|v| < 2^53)?
pub fn isSafeInt(v: f64) bool {
    return v == v && trunc(v) == v && v < 9007199254740992.0 && v > -9007199254740992.0
}

// Writes the integer `v` (|v| < 2^64) in decimal.
fn appendWhole(b: *mut text.Builder, v: f64) AllocError!void {
    if v < 0.0 {
        try b.appendByte('-')
        return b.appendUint((-v) as u64)
    }
    return b.appendUint(v as u64)
}

// The shortest digits of positive finite `v`: digits into `out`, returns
// (count, n) where the value is 0.d1d2...dk * 10^n.
struct Shortest {
    k: usize
    n: i64
}

fn shortest(v: f64, out: []mut u8) Shortest {
    var buf = @zeroed([40]u8)
    var p: i32 = 1
    while p <= 17 {
        let len = snprintf(buf[..].ptr, buf.len, "%.*e".ptr, p - 1, v) as usize
        buf[len] = 0
        if strtod(buf[..].ptr, null) == v || p == 17 {
            // d.ddde[+-]xx
            var k: usize = 0
            var i: usize = 0
            while i < len && buf[i] != 'e' {
                if buf[i] != '.' {
                    out[k] = buf[i]
                    k += 1
                }
                i += 1
            }
            i += 1
            var neg = false
            if buf[i] == '-' {
                neg = true
            }
            i += 1
            var e: i64 = 0
            while i < len {
                e = e * 10 + (buf[i] - '0') as i64
                i += 1
            }
            if neg {
                e = -e
            }
            while k > 1 && out[k - 1] == '0' {
                k -= 1
            }
            return Shortest { k: k, n: e + 1 }
        }
        p += 1
    }
    return Shortest { k: 1, n: 1 }
}

/// Appends Number::toString(v).
pub fn formatNumber(b: *mut text.Builder, v: f64) AllocError!void {
    if v != v {
        return b.append("NaN")
    }
    if v == 0.0 {
        return b.appendByte('0')
    }
    if !isFinite(v) {
        if v < 0.0 {
            return b.append("-Infinity")
        }
        return b.append("Infinity")
    }
    if isSafeInt(v) {
        return appendWhole(b, v)
    }
    var x = v
    if x < 0.0 {
        try b.appendByte('-')
        x = -x
    }
    var digits = @zeroed([24]u8)
    let s = shortest(x, digits[..])
    let k = s.k
    let n = s.n
    let d = digits[..k]
    if k as i64 <= n && n <= 21 {
        try b.append(d)
        for i in (0 as i64)..n - k as i64 {
            try b.appendByte('0')
        }
        return
    }
    if 0 < n && n <= 21 {
        try b.append(d[..n as usize])
        try b.appendByte('.')
        return b.append(d[n as usize..])
    }
    if -6 < n && n <= 0 {
        try b.append("0.")
        for i in (0 as i64)..-n {
            try b.appendByte('0')
        }
        return b.append(d)
    }
    try b.appendByte(d[0])
    if k > 1 {
        try b.appendByte('.')
        try b.append(d[1..])
    }
    try b.appendByte('e')
    let e = n - 1
    if e < 0 {
        try b.appendByte('-')
        return b.appendInt(-e)
    }
    try b.appendByte('+')
    return b.appendInt(e)
}

let DIGITS = "0123456789abcdefghijklmnopqrstuvwxyz"

/// Appends Number.prototype.toString(radix) for radix 2..36 (not 10).
pub fn formatRadix(b: *mut text.Builder, v: f64, radix: u32) AllocError!void {
    if v != v || v == 0.0 || !isFinite(v) {
        return formatNumber(b, v)
    }
    var x = v
    if x < 0.0 {
        try b.appendByte('-')
        x = -x
    }
    let r = radix as f64
    var whole = trunc(x)
    var frac = x - whole
    return appendRadixParts(b, whole, frac, r)
}

fn appendRadixParts(b: *mut text.Builder, wholeIn: f64, fracIn: f64, r: f64) AllocError!void {
    // Integer part, least significant digit first.
    let start = b.len()
    var whole = wholeIn
    if whole == 0.0 {
        try b.appendByte('0')
    }
    while whole >= 1.0 {
        let digit = fmod(whole, r)
        try b.appendByte(DIGITS[digit as usize])
        whole = trunc(whole / r)
    }
    reverseTail(b, start)
    var frac = fracIn
    if frac > 0.0 {
        try b.appendByte('.')
        var n: usize = 0
        while frac > 0.0 && n < 52 {
            frac *= r
            let digit = trunc(frac)
            try b.appendByte(DIGITS[digit as usize])
            frac -= digit
            n += 1
        }
    }
}

fn reverseTail(b: *mut text.Builder, start: usize) {
    let s = b.buf[start..b.count]
    var i: usize = 0
    var j = s.len
    while i + 1 < j {
        j -= 1
        let t = s[i]
        s[i] = s[j]
        s[j] = t
        i += 1
    }
}

/// Number.prototype.toFixed(digits) for 0 <= digits <= 100.
pub fn formatFixed(b: *mut text.Builder, v: f64, digits: u32) AllocError!void {
    if !isFinite(v) || v >= 1e21 || v <= -1e21 {
        return formatNumber(b, v)
    }
    var x = v
    if x < 0.0 {
        x = -x
    }
    // Print 30 extra digits and round half up by hand (C rounds exact
    // ties to even; the spec picks the larger).
    return fixedDigits(b, v < 0.0, x, digits)
}

fn fixedDigits(b: *mut text.Builder, neg: bool, x: f64, digits: u32) AllocError!void {
    var buf = @zeroed([160]u8)
    let len = snprintf(buf[..].ptr, buf.len, "%.*f".ptr, (digits + 30) as i32, x) as usize
    // Keep everything up to the point plus `digits` after it.
    var point = len
    for i in 0..len {
        if buf[i] == '.' {
            point = i
            break
        }
    }
    var keep = point
    var next = point + 1
    if digits > 0 {
        keep = point + 1 + digits as usize
        next = keep
    }
    let t = buf[..keep]
    var carry = next < len && buf[next] >= '5'
    var i = keep
    while carry && i > 0 {
        i -= 1
        if t[i] == '.' {
            continue
        }
        if t[i] == '9' {
            t[i] = '0'
        } else {
            t[i] += 1
            carry = false
        }
    }
    var allZero = !carry
    for c in t {
        if c != '0' && c != '.' {
            allZero = false
        }
    }
    if neg && !allZero {
        try b.appendByte('-')
    }
    if carry {
        try b.appendByte('1')
    }
    return b.append(t)
}

/// Number.prototype.toPrecision(p), 1 <= p <= 100.
pub fn formatPrecision(b: *mut text.Builder, v: f64, p: u32) AllocError!void {
    if !isFinite(v) {
        return formatNumber(b, v)
    }
    var x = v
    if x < 0.0 {
        try b.appendByte('-')
        x = -x
    }
    var buf = @zeroed([160]u8)
    let len = snprintf(buf[..].ptr, buf.len, "%.*e".ptr, (p - 1) as i32, x) as usize
    return precisionLayout(b, buf[..len], p)
}

// `e` is C's "%.*e" text of a non-negative number with p digits.
fn precisionLayout(b: *mut text.Builder, e: []u8, p: u32) AllocError!void {
    var dbuf = @zeroed([128]u8)
    var n: usize = 0
    var i: usize = 0
    while i < e.len && e[i] != 'e' {
        if e[i] != '.' && n < 128 {
            dbuf[n] = e[i]
            n += 1
        }
        i += 1
    }
    i += 1
    var neg = false
    if e[i] == '-' {
        neg = true
    }
    i += 1
    var ex: i64 = 0
    while i < e.len {
        ex = ex * 10 + (e[i] - '0') as i64
        i += 1
    }
    if neg {
        ex = -ex
    }
    let d = dbuf[..n]
    if ex < -6 || ex >= p as i64 {
        try b.appendByte(d[0])
        if d.len > 1 {
            try b.appendByte('.')
            try b.append(d[1..])
        }
        try b.appendByte('e')
        if ex < 0 {
            try b.appendByte('-')
            return b.appendInt(-ex)
        }
        try b.appendByte('+')
        return b.appendInt(ex)
    }
    if ex >= 0 {
        let whole = ex as usize + 1
        try b.append(d[..whole])
        if whole < d.len {
            try b.appendByte('.')
            try b.append(d[whole..])
        }
        return
    }
    try b.append("0.")
    for k in (0 as i64)..-ex - 1 {
        try b.appendByte('0')
    }
    return b.append(d)
}

fn isJsSpace(c: u8) bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 0x0B || c == 0x0C
}

/// The bytes of `s` without white space at both ends (ASCII white space,
/// NBSP, BOM and the line and paragraph separators).
pub fn trimJs(s: []u8) []u8 {
    var a: usize = 0
    var z = s.len
    while a < z {
        let w = spaceAt(s, a)
        if w == 0 {
            break
        }
        a += w
    }
    while z > a {
        var w: usize = 0
        if isJsSpace(s[z - 1]) {
            w = 1
        } else if z - a >= 2 && spaceAt(s, z - 2) == 2 {
            w = 2
        } else if z - a >= 3 && spaceAt(s, z - 3) == 3 {
            w = 3
        }
        if w == 0 {
            break
        }
        z -= w
    }
    return s[a..z]
}

// The length of the white-space character at s[i], or 0.
pub fn spaceAt(s: []u8, i: usize) usize {
    let c = s[i]
    if isJsSpace(c) {
        return 1
    }
    if c == 0xC2 && i + 1 < s.len && s[i + 1] == 0xA0 {
        return 2
    }
    if c == 0xEF && i + 2 < s.len && s[i + 1] == 0xBB && s[i + 2] == 0xBF {
        return 3
    }
    if c == 0xE2 && i + 2 < s.len && s[i + 1] == 0x80 && (s[i + 2] == 0xA8 || s[i + 2] == 0xA9) {
        return 3
    }
    return 0
}

// The length of the longest prefix of s that is a decimal literal
// ([+-] digits [. digits] [e [+-] digits], or "Infinity" with a sign);
// 0 when there is none.
fn decimalPrefix(s: []u8) usize {
    var i: usize = 0
    if i < s.len && (s[i] == '+' || s[i] == '-') {
        i += 1
    }
    if text.startsWith(s[i..], "Infinity") {
        return i + 8
    }
    let digitsStart = i
    while i < s.len && s[i] >= '0' && s[i] <= '9' {
        i += 1
    }
    var any = i > digitsStart
    if i < s.len && s[i] == '.' {
        let f = i + 1
        var j = f
        while j < s.len && s[j] >= '0' && s[j] <= '9' {
            j += 1
        }
        if j > f || any {
            any = any || j > f
            i = j
        }
    }
    if !any {
        return 0
    }
    if i < s.len && (s[i] == 'e' || s[i] == 'E') {
        var j = i + 1
        if j < s.len && (s[j] == '+' || s[j] == '-') {
            j += 1
        }
        let e0 = j
        while j < s.len && s[j] >= '0' && s[j] <= '9' {
            j += 1
        }
        if j > e0 {
            i = j
        }
    }
    return i
}

// strtod of s (a decimal literal) through a NUL-terminated copy.
fn decimalValue(s: []u8) f64 {
    var neg = false
    var t = s
    if t.len > 0 && (t[0] == '+' || t[0] == '-') {
        neg = t[0] == '-'
        t = t[1..]
    }
    var v = 0.0
    if text.eql(t, "Infinity") {
        v = 1.0 / 0.0
    } else {
        v = strtodSlice(t)
    }
    if neg {
        return -v
    }
    return v
}

/// The global parseFloat.
pub fn parseFloatPrefix(s: []u8) f64 {
    let t = trimJs(s)
    let n = decimalPrefix(t)
    if n == 0 {
        return 0.0 / 0.0
    }
    return decimalValue(t[..n])
}

/// ToNumber of a string.
pub fn stringToNumber(s: []u8) f64 {
    let t = trimJs(s)
    if t.len == 0 {
        return 0.0
    }
    if t.len > 2 && t[0] == '0' {
        let r = t[1] | 0x20
        var radix: u32 = 0
        if r == 'x' {
            radix = 16
        } else if r == 'o' {
            radix = 8
        } else if r == 'b' {
            radix = 2
        }
        if radix != 0 {
            var v = 0.0
            for c in t[2..] {
                let d = digitValue(c)
                if d >= radix {
                    return 0.0 / 0.0
                }
                v = v * radix as f64 + d as f64
            }
            return v
        }
    }
    let n = decimalPrefix(t)
    if n != t.len {
        return 0.0 / 0.0
    }
    return decimalValue(t)
}

/// The value of a digit or letter in bases up to 36; 99 for others.
pub fn digitValue(c: u8) u32 {
    if c >= '0' && c <= '9' {
        return (c - '0') as u32
    }
    let l = c | 0x20
    if l >= 'a' && l <= 'z' {
        return (l - 'a') as u32 + 10
    }
    return 99
}

/// The global parseInt; radix 0 means "10, or 16 after 0x".
pub fn parseIntPrefix(s: []u8, radixIn: u32) f64 {
    var t = trimJs(s)
    var neg = false
    if t.len > 0 && (t[0] == '+' || t[0] == '-') {
        neg = t[0] == '-'
        t = t[1..]
    }
    var radix = radixIn
    if (radix == 0 || radix == 16) && t.len >= 2 && t[0] == '0' && (t[1] | 0x20) == 'x' {
        t = t[2..]
        radix = 16
    }
    if radix == 0 {
        radix = 10
    }
    if radix < 2 || radix > 36 {
        return 0.0 / 0.0
    }
    var n: usize = 0
    while n < t.len && digitValue(t[n]) < radix {
        n += 1
    }
    if n == 0 {
        return 0.0 / 0.0
    }
    var v = 0.0
    if radix == 10 {
        v = strtodSlice(t[..n])
    } else {
        for c in t[..n] {
            v = v * radix as f64 + digitValue(c) as f64
        }
    }
    if neg {
        return -v
    }
    return v
}

// strtod of the bytes of s (digits, '.', 'e', signs) copied with a NUL.
fn strtodSlice(s: []u8) f64 {
    return strtodCopy(s)
}

fn strtodCopy(s: []u8) f64 {
    var buf = @zeroed([512]u8)
    var n = s.len
    if n > 511 {
        n = 511
    }
    for i in 0..n {
        buf[i] = s[i]
    }
    buf[n] = 0
    return strtod(buf[..].ptr, null)
}

/// Number.prototype.toExponential(d); d < 0: as many digits as needed.
pub fn formatExponential(b: *mut text.Builder, v: f64, d: i32) AllocError!void {
    var x = v
    if x < 0.0 {
        try b.appendByte('-')
        x = -x
    }
    var digits = @zeroed([128]u8)
    var k: usize = 0
    var e: i64 = 0
    if x == 0.0 {
        digits[0] = '0'
        k = 1
        if d > 0 {
            k = d as usize + 1
            for i in 0..k {
                digits[i] = '0'
            }
        }
    } else if d < 0 {
        let s = shortest(x, digits[..])
        k = s.k
        e = s.n - 1
    } else {
        var buf = @zeroed([160]u8)
        let len = snprintf(buf[..].ptr, buf.len, "%.*e".ptr, d, x) as usize
        var i: usize = 0
        while i < len && buf[i] != 'e' {
            if buf[i] != '.' {
                digits[k] = buf[i]
                k += 1
            }
            i += 1
        }
        i += 1
        var neg = false
        if buf[i] == '-' {
            neg = true
        }
        i += 1
        while i < len {
            e = e * 10 + (buf[i] - '0') as i64
            i += 1
        }
        if neg {
            e = -e
        }
    }
    try b.appendByte(digits[0])
    if k > 1 {
        try b.appendByte('.')
        try b.append(digits[1..k])
    }
    try b.appendByte('e')
    if e < 0 {
        try b.appendByte('-')
        return b.appendInt(-e)
    }
    try b.appendByte('+')
    return b.appendInt(e)
}
