// js/builtins_global: `Function` and `eval` of strings (both run the code
// as a new script at the top level: `eval` is always the indirect eval,
// it never sees the caller's local variables), and the URI functions.

import std.text

fn installGlobalExtras(it: *mut Interp) JsError!void {
    let g = it.global
    try it.defineNative(g, "eval", 1, globalEval)
    try it.defineNative(g, "encodeURIComponent", 1, globalEncodeURIComponent)
    try it.defineNative(g, "encodeURI", 1, globalEncodeURI)
    try it.defineNative(g, "decodeURIComponent", 1, globalDecodeURIComponent)
    try it.defineNative(g, "decodeURI", 1, globalDecodeURI)
}

// new Function(p1, ..., body): the source
// "(function anonymous(p1,...\n) {\nbody\n})" run as a script.
fn functionCtor(it: *mut Interp, a: Args) JsError!Value {
    let b = try it.builder()
    defer it.release(b)
    try b.append("(function anonymous(")
    var i: usize = 0
    while i + 1 < a.argc {
        if i > 0 {
            try b.appendByte(',')
        }
        let p = try argString(it, a, i)
        try b.append(it.heap.bytes(strOf(p)))
        i += 1
    }
    try b.append("\n) {\n")
    if a.argc > 0 {
        let body = try argString(it, a, a.argc - 1)
        try b.append(it.heap.bytes(strOf(body)))
    }
    try b.append("\n})")
    return it.evalScript(b.bytes())
}

fn globalEval(it: *mut Interp, a: Args) JsError!Value {
    let v = it.arg(a, 0)
    if !isStr(v) {
        return v
    }
    let b = try it.builder()
    defer it.release(b)
    try b.append(it.heap.bytes(strOf(v)))
    return it.evalScript(b.bytes())
}

// ---- URI

let URI_HEX = "0123456789ABCDEF"



// Characters encodeURIComponent keeps; encodeURI also keeps `reserved`.
fn uriUnreserved(c: u8) bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '!' || c == '~' || c == '*' || c == '\'' || c == '(' || c == ')'
}

fn uriReserved(c: u8) bool {
    return c == ';' || c == ',' || c == '/' || c == '?' || c == ':' || c == '@' || c == '&' || c == '=' || c == '+' || c == '$' || c == '#'
}

fn uriError(it: *mut Interp) JsError!Value {
    return it.throwError(it.uri_error_proto, "URI malformed")
}

fn encodeUri(it: *mut Interp, a: Args, keepReserved: bool) JsError!Value {
    let s = try argString(it, a, 0)
    try it.push(s)
    let src = it.heap.bytes(strOf(s))
    let b = try it.builder()
    defer it.release(b)
    var i: usize = 0
    while i < src.len {
        let c = src[i]
        if c < 0x80 {
            if uriUnreserved(c) || (keepReserved && uriReserved(c)) {
                try b.appendByte(c)
            } else {
                try b.appendByte('%')
                try b.appendByte(URI_HEX[(c >> 4) as usize])
                try b.appendByte(URI_HEX[(c & 15) as usize])
            }
            i += 1
            continue
        }
        let d = decodeAt(src, i)
        if d.cp >= 0xD800 && d.cp <= 0xDFFF {
            it.pop()
            return uriError(it)
        }
        for k in i..i + d.len {
            let x = src[k]
            try b.appendByte('%')
            try b.appendByte(URI_HEX[(x >> 4) as usize])
            try b.appendByte(URI_HEX[(x & 15) as usize])
        }
        i += d.len
    }
    it.pop()
    return it.newString(b.bytes())
}

fn hexValue(c: u8) i32 {
    if c >= '0' && c <= '9' {
        return (c - '0') as i32
    }
    if c >= 'a' && c <= 'f' {
        return (c - 'a') as i32 + 10
    }
    if c >= 'A' && c <= 'F' {
        return (c - 'A') as i32 + 10
    }
    return -1
}

// The byte of the escape "%XY" at src[i], or -1.
fn escapedByte(src: []u8, i: usize) i32 {
    if i + 2 >= src.len {
        return -1
    }
    if src[i] != '%' {
        return -1
    }
    let h = hexValue(src[i + 1])
    let l = hexValue(src[i + 2])
    if h < 0 || l < 0 {
        return -1
    }
    return h * 16 + l
}

fn decodeUri(it: *mut Interp, a: Args, keepReserved: bool) JsError!Value {
    let s = try argString(it, a, 0)
    try it.push(s)
    let src = it.heap.bytes(strOf(s))
    let b = try it.builder()
    defer it.release(b)
    var i: usize = 0
    while i < src.len {
        if src[i] != '%' {
            try b.appendByte(src[i])
            i += 1
            continue
        }
        if i + 2 >= src.len {
            it.pop()
            return uriError(it)
        }
        let first = escapedByte(src, i)
        if first < 0 {
            it.pop()
            return uriError(it)
        }
        let c = first as u8
        if c < 0x80 {
            if keepReserved && uriReserved(c) {
                try b.append(src[i..i + 3])
            } else {
                try b.appendByte(c)
            }
            i += 3
            continue
        }
        var n: usize = 0
        if c >= 0xC2 && c < 0xE0 {
            n = 2
        } else if c >= 0xE0 && c < 0xF0 {
            n = 3
        } else if c >= 0xF0 && c < 0xF5 {
            n = 4
        } else {
            it.pop()
            return uriError(it)
        }
        if i + n * 3 > src.len {
            it.pop()
            return uriError(it)
        }
        var bytes = [4]u8{c, 0, 0, 0}
        for k in 1..n {
            let x = escapedByte(src, i + k * 3)
            if x < 0 || (x & 0xC0) != 0x80 {
                it.pop()
                return uriError(it)
            }
            bytes[k] = x as u8
        }
        let d = decodeAt(bytes[0..n], 0)
        if d.len != n || (d.cp >= 0xD800 && d.cp <= 0xDFFF) {
            it.pop()
            return uriError(it)
        }
        try b.append(bytes[0..n])
        i += n * 3
    }
    it.pop()
    return it.newString(b.bytes())
}

fn globalEncodeURIComponent(it: *mut Interp, a: Args) JsError!Value {
    return encodeUri(it, a, false)
}

fn globalEncodeURI(it: *mut Interp, a: Args) JsError!Value {
    return encodeUri(it, a, true)
}

fn globalDecodeURIComponent(it: *mut Interp, a: Args) JsError!Value {
    return decodeUri(it, a, false)
}

fn globalDecodeURI(it: *mut Interp, a: Args) JsError!Value {
    return decodeUri(it, a, true)
}
