// js: the JavaScript engine of anyknown (docs/browser.md, B6).
//
//     var it = try Interp.create(alloc)
//     defer it.deinit()
//     try installBuiltins(&mut it)
//     it.runScript(src) catch ...   // JsError.Thrown: it.exception
//
// `runFile` is `anyknown js FILE`.

import std
import std.mem.Allocator
import std.text

/// Runs the script in file `path`: console output goes to stdout, an
/// uncaught exception prints `Uncaught <Name>: <message>` to stderr and
/// gives status 1.
pub fn runFile(alloc: Allocator, path: []u8) i32 {
    let src = std.fs.readFile(alloc, path) catch |e| {
        std.log.err("cannot read {}", path)
        return 1
    }
    defer alloc.free(src)
    return runSource(alloc, src)
}

/// Runs a script's source in a new engine; returns the exit status.
pub fn runSource(alloc: Allocator, src: []u8) i32 {
    var it = Interp.create(alloc) catch |e| {
        std.log.err("out of memory")
        return 1
    }
    defer it.deinit()
    if gcStressRequested() {
        it.heap.threshold = 1
    }
    installBuiltins(&mut it) catch |e| {
        std.log.err("out of memory")
        return 1
    }
    it.runScript(src) catch |e| {
        reportUncaught(&mut it)
        return 1
    }
    return 0
}

/// Writes "Uncaught <error>" for the pending exception to stderr.
pub fn reportUncaught(it: *mut Interp) {
    var b = text.Builder.init(it.alloc)
    defer b.deinit()
    describeException(it, &mut b) catch |e| {}
    b.appendByte('\n') catch |e| {}
    std.fs.stderr().write(b.bytes()) catch |e| {}
}

fn describeException(it: *mut Interp, b: *mut text.Builder) JsError!void {
    let ex = it.exception
    try it.push(ex)
    try b.append("Uncaught ")
    if it.classOf(ex) |c| {
        if c == Class.Error {
            try appendErrorText(it, b, ex)
            it.pop()
            return
        }
    }
    try inspectNested(it, b, ex)
    it.pop()
}
