// js: the JavaScript engine of anyknown (docs/browser.md, B6).
//
//     var it = try Interp.create(alloc)
//     defer it.deinit()
//     try installBuiltins(&mut it)
//     it.runScript(src) catch ...   // JsError.Thrown: it.exception
//
// `runFile` is `anyknown js FILE`.

import std
import std.mem.Allocator
import std.text
import url

@link("pthread")

// The POSIX threads API, declared from the system's `pthread.h` (an
// attribute and a thread handle have the platform's own types).
let pthread = @cimport("pthread.h")

/// Runs the script in file `path`: console output goes to stdout, an
/// uncaught exception prints `Uncaught <Name>: <message>` to stderr and
/// gives status 1.
pub fn runFile(alloc: Allocator, path: []u8) i32 {
    let src = std.fs.readFile(alloc, path) catch |e| {
        std.log.err("cannot read {}", path)
        return 1
    }
    defer alloc.free(src)
    var b = text.Builder.init(alloc)
    defer b.deinit()
    b.append("file://") catch return 1
    if !text.startsWith(path, "/") {
        let buf = alloc.alloc(0 as u8, 4096) catch return 1
        defer alloc.free(buf)
        getcwd(buf.ptr, buf.len)
        var n: usize = 0
        while n < buf.len && buf[n] != 0 {
            n += 1
        }
        b.append(buf[..n]) catch return 1
        b.appendByte('/') catch return 1
    }
    b.append(path) catch return 1
    let target = url.parse(alloc, b.bytes()) catch return 1
    defer target.deinit(alloc)
    return runOnBigStackAt(alloc, src, target.href, text.endsWith(path, ".mjs"))
}

// The interpreter recurses on the C stack (several KB per JS call in
// debug builds), so scripts run on a thread with a large stack.
let STACK_BYTES: usize = 1 << 30
// What scripts may use of it (Interp.markStackBase).
let RUNNER_ROOM: u64 = 900 << 20

struct Job {
    alloc: Allocator
    src: []u8
    status: i32
    href: []u8
    module: bool
}

fn jobMain(arg: ?[*]u8) ?[*]u8 {
    if arg |p| {
        let job = @ptrCast(*mut Job, p)
        job.status = runSourceAt(job.alloc, job.src, job.href, job.module)
    }
    return null
}

/// runSource on a thread with a 1 GB stack (reserved, not committed).
pub fn runOnBigStack(alloc: Allocator, src: []u8) i32 {
    return runOnBigStackAt(alloc, src, "", false)
}

extern fn getcwd(buf: [*]u8, size: usize) [*]u8

fn runOnBigStackAt(alloc: Allocator, src: []u8, href: []u8, module: bool) i32 {
    var job = Job { alloc: alloc, src: src, status: 1, href: href, module: module }
    var attr = @zeroed(pthread.pthread_attr_t)
    var thread = @zeroed(pthread.pthread_t)
    if pthread.pthread_attr_init(&mut attr) != 0 || pthread.pthread_attr_setstacksize(&mut attr, STACK_BYTES) != 0 {
        return runSourceAt(alloc, src, href, module)
    }
    if pthread.pthread_create(&mut thread, &attr, jobMain, @ptrCast([*]u8, &mut job)) != 0 {
        return runSourceAt(alloc, src, href, module)
    }
    pthread.pthread_join(thread, null)
    return job.status
}

/// Runs a script's source in a new engine; returns the exit status.
pub fn runSource(alloc: Allocator, src: []u8) i32 {
    return runSourceAt(alloc, src, "", false)
}

fn runSourceAt(alloc: Allocator, src: []u8, href: []u8, module: bool) i32 {
    var it = Interp.create(alloc) catch |e| {
        std.log.err("out of memory")
        return 1
    }
    defer it.deinit()
    // Built-ins are made before any collection can run (they are roots
    // only once installed).
    installBuiltins(&mut it) catch |e| {
        std.log.err("out of memory")
        return 1
    }
    if gcStressRequested() {
        it.heap.threshold = 1
    }
    it.markStackBase(RUNNER_ROOM)
    it.script_url = it.intern(href) catch return 1
    if module {
        importModule(&mut it, href, it.script_url) catch |e| {
            return uncaughtStatus(&mut it, e)
        }
    } else {
        it.runScript(src) catch |e| {
            return uncaughtStatus(&mut it, e)
        }
    }
    // The microtasks (promise reactions), as Node runs them after the
    // script, then each due FinalizationRegistry callback as a task of
    // its own.
    while true {
        while it.takeJob() |f| {
            if callTask(&mut it, f, Value.Undefined, 0) |status| {
                return status
            }
        }
        clearKeptObjects(&mut it)
        let c = takeCleanup(&mut it) orelse break
        if callTask(&mut it, c.callback, c.held, 1) |status| {
            return status
        }
    }
    // The module entry's evaluation is asynchronous, including parse and
    // fetch failures. Do not silently succeed when its promise rejected.
    if module {
        let rejected = it.takeUnhandled() catch |e| {
            return uncaughtStatus(&mut it, e)
        }
        if isObject(rejected) && it.heap.obj(objectOf(rejected)).nelems > 0 {
            it.exception = it.heap.obj(objectOf(rejected)).elems[0]
            return uncaughtStatus(&mut it, JsError.Thrown)
        }
    }
    return 0
}

// Calls f (with argument `arg` when argc is 1): null, or the exit status
// of an uncaught exception.
fn callTask(it: *mut Interp, f: Value, arg: Value, argc: usize) ?i32 {
    let base = it.stack.len()
    it.push(f) catch |e| {
        return 1
    }
    it.push(Value.Undefined) catch |e| {
        return 1
    }
    if argc == 1 {
        it.push(arg) catch |e| {
            return 1
        }
    }
    it.callAt(base, argc) catch |e| {
        return uncaughtStatus(it, e)
    }
    return null
}

fn uncaughtStatus(it: *mut Interp, e: JsError) i32 {
    if e == JsError.Terminated {
        std.fs.stderr().write("Uncaught: the script ran out of time\n") catch |err| {}
        return 1
    }
    reportUncaught(it)
    return 1
}

/// Writes "Uncaught <error>" for the pending exception to stderr.
pub fn reportUncaught(it: *mut Interp) {
    var b = text.Builder.init(it.alloc)
    defer b.deinit()
    describeException(it, &mut b) catch |e| {}
    b.appendByte('\n') catch |e| {}
    std.fs.stderr().write(b.bytes()) catch |e| {}
}

pub fn describeException(it: *mut Interp, b: *mut text.Builder) JsError!void {
    return describeThrown(it, b, "Uncaught ")
}

/// describeException with another prefix ("Uncaught (in promise) ").
pub fn describeThrown(it: *mut Interp, b: *mut text.Builder, prefix: []u8) JsError!void {
    let ex = it.exception
    try it.push(ex)
    try b.append(prefix)
    if it.classOf(ex) |c| {
        if c == Class.Error {
            try appendErrorText(it, b, ex)
            it.pop()
            return
        }
    }
    try inspectNested(it, b, ex)
    it.pop()
}
