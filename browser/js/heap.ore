// js/heap: the engine's own heap. Objects, strings and environments live
// in three lists and are named by their index (a `u32`); freed slots are
// reused through free lists. Nothing here frees a live value: the
// mark-and-sweep collector (gc.ore) decides that from the roots.
//
// Strings are WTF-8 bytes (UTF-8 that may hold lone surrogates, see
// lexer.appendWtf8) with their UTF-16 length cached, so `length` and
// indexing follow JavaScript's UTF-16 semantics while the engine and the
// DOM keep UTF-8. A string of only ASCII bytes (the common case) indexes
// its bytes directly.

import std.list.List
import std.map.IntMap
import std.mem.AllocError
import std.mem.Allocator

pub enum Value {
    Undefined
    Null
    Bool { b: bool }
    Num { n: f64 }
    // Binary limb payload in a GC-managed flat byte cell (bigint.ore).
    Big { s: u32 }
    Str { s: u32 }
    Obj { o: u32 }
    // Internal: an array hole; never visible to scripts.
    Empty
}

pub enum Class {
    Object
    Array
    Function
    Error
    Boolean
    Number
    BigInt
    String
    Date
    Arguments
    RegExp
    Map
    Set
    // Array, Map and Set iterators: the values to give are the elements,
    // the next index is the primitive.
    Iterator
    Host
    // A symbol (symbol.ore): the primitive is its key atom.
    Symbol
    // A generator object (coroutine.ore): the primitive is the index of
    // its coroutine.
    Generator
    // A proxy (proxy.ore): its data is Proxy.
    Proxy
    // Weak collections (weak.ore): their entries and targets live in the
    // interpreter's weak tables, which the collector does not trace.
    WeakMap
    WeakSet
    WeakRef
    // A FinalizationRegistry: the primitive is its cleanup callback.
    FinalizationRegistry
    // Internal live cell of a module binding (ObjData.Cell, or Prim for a
    // fixed value), and an ES module namespace exotic object.
    ModuleBinding
    ModuleNamespace
}

pub enum ObjData {
    None
    // A function of the script. `home`: the object whose prototype
    // `super.x` searches; `outer`: for arrows, the enclosing non-arrow
    // function (for `super`).
    Closure { func: u32, env: u32, home: u32, outer: u32 }
    Native { id: u32 }
    // Bound function: the bound arguments are the elements.
    Bound { target: u32, this_v: Value }
    // Boolean, Number and String wrappers; a Date's time value.
    Prim { v: Value }
    // A host object (a DOM node): an opaque handle.
    Host { tag: u32, index: u32, generation: u32 }
    // A proxy: its target and handler (NONE once revoked).
    Proxy { target: u32, handler: u32 }
    // A module binding's live cell: slot `slot` of environment `env`;
    // `name` (an atom) for the error of a read before its initialization.
    Cell { env: u32, slot: u32, name: u32 }
}

// Prop.flags
pub let F_ENUM: u8 = 1
pub let F_WRITE: u8 = 2
pub let F_CONFIG: u8 = 4
// An accessor: `value` is the getter, `setter` the setter (Undefined when
// missing).
pub let F_ACCESSOR: u8 = 8
// A live module export: internal getter, externally a data descriptor.
pub let F_MODULE: u8 = 16
pub let F_DEFAULT: u8 = 7
pub let F_HIDDEN: u8 = 6

pub struct Prop {
    key: u32
    value: Value
    setter: Value
    flags: u8
}

// An object with more properties than this gets a hash index.
let INDEX_AT: u32 = 24

pub struct Obj {
    class: Class
    proto: u32
    props: []mut Prop
    nprops: u32
    // Shared own-property layout; NONE after a deletion (dictionary).
    shape: u32
    index: ?*mut IntMap(u32, u32)
    // Arrays and arguments: the elements; Map and Set: keys (and values).
    elems: []mut Value
    nelems: u32
    // Map and Set: the hash index of the keys in `elems` (builtins_misc.ore).
    keys: ?*mut KeyIndex
    data: ObjData
    extensible: bool
    frozen: bool
    mark: bool
    live: bool
    // [[IsHTMLDDA]] (`document.all`): typeof "undefined", falsy, and
    // loosely equal to null and undefined.
    htmldda: bool
}

/// The hash index of a Map's or Set's keys. A slot is 0 (empty),
/// KEY_TOMB (deleted), or hash << 32 | (element index + 1).
pub struct KeyIndex {
    slots: []mut u64
    // Slots that are not empty (entries and tombstones).
    used: u32
    // Live entries (the size).
    count: u32
    // forEach loops running over the collection: element indices must
    // not move (no compaction) until they end.
    walking: u32
}

pub struct StrCell {
    // Empty for a rope until it is flattened.
    bytes: []mut u8
    // A rope (a concatenation not yet copied): its halves, and its length
    // in bytes. NONE for a flat string.
    left: u32
    right: u32
    rope_len: usize
    len16: u32
    ascii: bool
    // The atom with these bytes, once interned (NONE before).
    atom: u32
    // `bytes` belong to the cell (freed with it).
    owned: bool
    // Never collected (atom strings).
    perm: bool
    mark: bool
    live: bool
}

pub struct Env {
    slots: []mut Value
    parent: u32
    mark: bool
    live: bool
}

pub struct Heap {
    alloc: Allocator
    objs: List(Obj)
    free_objs: List(u32)
    strs: List(StrCell)
    free_strs: List(u32)
    envs: List(Env)
    free_envs: List(u32)
    atoms: Atoms
    shapes: List(Shape)
    transitions: IntMap(u64, u32)
    prop_mem: Slabs(Prop)
    val_mem: Slabs(Value)
    byte_mem: Slabs(u8)
    int_mem: Slabs(i64)
    rope_stack: List(u32)
    // Allocations since the last collection, and the count that starts
    // the next one.
    since_gc: usize
    threshold: usize

    pub fn init(alloc: Allocator) AllocError!Heap {
        var h = Heap {
            alloc: alloc,
            objs: List(Obj).init(alloc),
            free_objs: List(u32).init(alloc),
            strs: List(StrCell).init(alloc),
            free_strs: List(u32).init(alloc),
            envs: List(Env).init(alloc),
            free_envs: List(u32).init(alloc),
            atoms: Atoms.init(alloc),
            shapes: List(Shape).init(alloc),
            transitions: IntMap(u64, u32).init(alloc),
            prop_mem: Slabs(Prop).init(alloc),
            val_mem: Slabs(Value).init(alloc),
            byte_mem: Slabs(u8).init(alloc),
            int_mem: Slabs(i64).init(alloc),
            rope_stack: List(u32).init(alloc),
            since_gc: 0,
            threshold: 20000,
        }
        try h.shapes.append(Shape { parent: NONE, key: NONE, slot: 0, index: null })
        try h.atoms.predefine()
        return h
    }

    pub fn deinit(self: *mut Self) {
        for i in 0..self.objs.len() {
            if self.objs.items()[i].live {
                self.freeObj(i as u32)
            }
        }
        for i in 0..self.strs.len() {
            if self.strs.items()[i].live {
                self.freeStr(i as u32)
            }
        }
        for i in 0..self.envs.len() {
            if self.envs.items()[i].live {
                self.freeEnv(i as u32)
            }
        }
        self.objs.deinit()
        self.free_objs.deinit()
        self.strs.deinit()
        self.free_strs.deinit()
        self.envs.deinit()
        self.free_envs.deinit()
        self.atoms.deinit()
        for s in self.shapes.items() {
            if s.index |ix| {
                ix.deinit()
                self.alloc.destroy(ix)
            }
        }
        self.shapes.deinit()
        self.transitions.deinit()
        self.prop_mem.deinit()
        self.val_mem.deinit()
        self.byte_mem.deinit()
        self.int_mem.deinit()
        self.rope_stack.deinit()
    }

    // ---- objects

    pub fn obj(self: *Self, o: u32) *mut Obj {
        return &mut self.objs.items()[o]
    }

    pub fn newObj(self: *mut Self, class: Class, proto: u32, data: ObjData) AllocError!u32 {
        self.since_gc += 1
        let o = Obj {
            class: class,
            proto: proto,
            props: []mut Prop{},
            nprops: 0,
            shape: 0,
            index: null,
            elems: []mut Value{},
            nelems: 0,
            keys: null,
            data: data,
            extensible: true,
            frozen: false,
            mark: false,
            live: true,
            htmldda: false,
        }
        if self.free_objs.pop() |i| {
            self.objs.items()[i] = o
            return i
        }
        let i = self.objs.len() as u32
        try self.objs.append(o)
        return i
    }

    pub fn freeObj(self: *mut Self, o: u32) {
        let ob = self.obj(o)
        self.prop_mem.put(ob.props)
        self.val_mem.put(ob.elems)
        if ob.index |ix| {
            ix.deinit()
            self.alloc.destroy(ix)
        }
        if ob.keys |ki| {
            if ki.slots.len > 0 {
                self.alloc.free(ki.slots)
            }
            self.alloc.destroy(ki)
        }
        ob.keys = null
        ob.props = []mut Prop{}
        ob.elems = []mut Value{}
        ob.index = null
        ob.nprops = 0
        ob.nelems = 0
        ob.live = false
    }

    /// The index in `props` of the own property `key`.
    pub fn findProp(self: *Self, o: u32, key: u32) ?u32 {
        let ob = self.obj(o)
        if ob.shape != NONE {
            if self.shapes.items()[ob.shape].index |ix| {
                return ix.get(key)
            }
        }
        if ob.index |ix| {
            return ix.get(key)
        }
        let props = ob.props
        for i in 0..ob.nprops as usize {
            if props[i].key == key {
                return i as u32
            }
        }
        return null
    }

    /// Adds a property that the object does not have yet.
    pub fn addProp(self: *mut Self, o: u32, key: u32, value: Value, setter: Value, flags: u8) AllocError!void {
        let ob = self.obj(o)
        let n = ob.nprops
        if n as usize == ob.props.len {
            var cap = ob.props.len * 2
            if cap < 4 {
                cap = 4
            }
            ob.props = try self.prop_mem.grow(ob.props, cap, Prop { key: 0, value: Value.Undefined, setter: Value.Undefined, flags: 0 })
        }
        ob.props[n] = Prop { key: key, value: value, setter: setter, flags: flags }
        ob.nprops = n + 1
        if ob.shape != NONE {
            ob.shape = try shapeTransition(self, ob.shape, key, n)
            if ob.shape != NONE {
                return
            }
        }
        if ob.index |ix| {
            try ix.put(key, n)
        } else if n + 1 > INDEX_AT {
            try self.buildIndex(o)
        }
    }

    fn buildIndex(self: *mut Self, o: u32) AllocError!void {
        let ob = self.obj(o)
        if ob.index |old| {
            old.deinit()
            self.alloc.destroy(old)
            ob.index = null
        }
        if ob.nprops <= INDEX_AT {
            return
        }
        let ix = try self.alloc.create(IntMap(u32, u32).init(self.alloc))
        for i in 0..ob.nprops {
            ix.put(ob.props[i].key, i) catch |e| {
                ix.deinit()
                self.alloc.destroy(ix)
                return e
            }
        }
        self.obj(o).index = ix
    }

    /// Removes own property number `i` (keeps the order of the others).
    pub fn removeProp(self: *mut Self, o: u32, i: u32) AllocError!void {
        let ob = self.obj(o)
        ob.shape = NONE
        var j = i
        while j + 1 < ob.nprops {
            ob.props[j] = ob.props[j + 1]
            j += 1
        }
        ob.nprops -= 1
        if ob.nprops > INDEX_AT || ob.index != null {
            try self.buildIndex(o)
        }
    }

    /// Makes room for `n` elements and sets the length to `n` (new
    /// elements are `fill`).
    pub fn setLength(self: *mut Self, o: u32, n: u32, fill: Value) AllocError!void {
        let ob = self.obj(o)
        if n as usize > ob.elems.len {
            var cap = ob.elems.len * 2
            if cap < 4 {
                cap = 4
            }
            if cap < n as usize {
                cap = n as usize
            }
            ob.elems = try self.val_mem.grow(ob.elems, cap, Value.Undefined)
        }
        var i = ob.nelems
        while i < n {
            ob.elems[i] = fill
            i += 1
        }
        ob.nelems = n
    }

    pub fn pushElem(self: *mut Self, o: u32, v: Value) AllocError!void {
        let n = self.obj(o).nelems
        try self.setLength(o, n + 1, v)
    }

    pub fn elems(self: *Self, o: u32) []mut Value {
        let ob = self.obj(o)
        return ob.elems[..ob.nelems as usize]
    }

    // ---- strings

    pub fn str(self: *Self, s: u32) *mut StrCell {
        return &mut self.strs.items()[s]
    }

    /// The bytes of string s (a rope is flattened first).
    pub fn bytes(self: *mut Self, s: u32) []u8 {
        if self.strs.items()[s].left != NONE {
            self.flatten(s)
        }
        return self.strs.items()[s].bytes
    }

    /// The length in bytes of string s.
    pub fn byteLen(self: *Self, s: u32) usize {
        let c = self.strs.items()[s]
        if c.left != NONE {
            return c.rope_len
        }
        return c.bytes.len
    }

    /// A rope for the concatenation of a and b (no bytes are copied).
    pub fn concat(self: *mut Self, a: u32, b: u32) AllocError!u32 {
        self.since_gc += 1
        let ca = self.strs.items()[a]
        let cb = self.strs.items()[b]
        let c = StrCell {
            bytes: []mut u8{},
            left: a,
            right: b,
            rope_len: self.byteLen(a) + self.byteLen(b),
            len16: ca.len16 + cb.len16,
            ascii: ca.ascii && cb.ascii,
            atom: NONE,
            owned: false,
            perm: false,
            mark: false,
            live: true,
        }
        if self.free_strs.pop() |k| {
            self.strs.items()[k] = c
            return k
        }
        let k = self.strs.len() as u32
        try self.strs.append(c)
        return k
    }

    // Copies the leaves of rope s into one buffer (from the right end,
    // with a small explicit stack: ropes can be very deep).
    fn flatten(self: *mut Self, s: u32) {
        let total = self.strs.items()[s].rope_len
        let buf = self.byte_mem.get(total, 0) catch |e| {
            return
        }
        var pos = total
        self.rope_stack.clear()
        self.rope_stack.append(s) catch |e| {
            return
        }
        while self.rope_stack.pop() |x| {
            let c = self.strs.items()[x]
            if c.left == NONE {
                let n = c.bytes.len
                for i in 0..n {
                    buf[pos - n + i] = c.bytes[i]
                }
                pos -= n
            } else {
                self.rope_stack.append(c.left) catch |e| {
                    return
                }
                self.rope_stack.append(c.right) catch |e| {
                    return
                }
            }
        }
        let cell = &mut self.strs.items()[s]
        cell.bytes = buf
        cell.owned = true
        cell.left = NONE
        cell.right = NONE
        cell.rope_len = 0
    }

    // A cell for `b`; `owned`: the cell gives `b` back to byte_mem.
    fn cell(self: *mut Self, b: []mut u8, owned: bool, perm: bool) AllocError!u32 {
        self.since_gc += 1
        var ascii = true
        var units: u32 = 0
        var i: usize = 0
        while i < b.len {
            let c = b[i]
            if c < 0x80 {
                i += 1
                units += 1
            } else {
                ascii = false
                if c >= 0xF0 {
                    i += 4
                    units += 2
                } else if c >= 0xE0 {
                    i += 3
                    units += 1
                } else if c >= 0xC0 {
                    i += 2
                    units += 1
                } else {
                    i += 1
                    units += 1
                }
            }
        }
        let c = StrCell {
            bytes: b,
            left: NONE,
            right: NONE,
            rope_len: 0,
            len16: units,
            ascii: ascii,
            atom: NONE,
            owned: owned,
            perm: perm,
            mark: false,
            live: true,
        }
        if self.free_strs.pop() |k| {
            self.strs.items()[k] = c
            return k
        }
        let k = self.strs.len() as u32
        try self.strs.append(c)
        return k
    }

    /// A new string cell with a copy of `b`.
    pub fn newStr(self: *mut Self, b: []u8) AllocError!u32 {
        if b.len == 0 {
            return self.cell([]mut u8{}, false, false)
        }
        let copy = try self.byte_mem.get(b.len, 0)
        for i, c in b {
            copy[i] = c
        }
        return self.cell(copy, true, false)
    }

    /// The permanent string of an atom.
    pub fn atomStr(self: *mut Self, a: u32) AllocError!u32 {
        let s = self.atoms.list.items()[a].str
        if s != NONE {
            return s
        }
        let k = try self.cell(self.atoms.list.items()[a].bytes, false, true)
        self.str(k).atom = a
        self.atoms.list.items()[a].str = k
        return k
    }

    /// The atom of string `s`.
    pub fn strAtom(self: *mut Self, s: u32) AllocError!u32 {
        let a = self.str(s).atom
        if a != NONE {
            return a
        }
        let b = self.bytes(s)
        let k = try self.atoms.intern(b)
        self.str(s).atom = k
        return k
    }

    pub fn freeStr(self: *mut Self, s: u32) {
        let c = self.str(s)
        if c.owned {
            self.byte_mem.put(c.bytes)
        }
        c.bytes = []mut u8{}
        c.left = NONE
        c.right = NONE
        c.live = false
    }

    // ---- environments

    /// An environment of n slots, each `fill` (Empty for let/const not
    /// yet initialized).
    pub fn newEnv(self: *mut Self, n: u32, parent: u32, fill: Value) AllocError!u32 {
        self.since_gc += 1
        var slots = []mut Value{}
        if n > 0 {
            slots = try self.val_mem.get(n as usize, fill)
        }
        let e = Env { slots: slots, parent: parent, mark: false, live: true }
        if self.free_envs.pop() |i| {
            self.envs.items()[i] = e
            return i
        }
        let i = self.envs.len() as u32
        try self.envs.append(e)
        return i
    }

    pub fn env(self: *Self, e: u32) *mut Env {
        return &mut self.envs.items()[e]
    }

    /// Makes the environment `e` at least `n` slots long.
    pub fn growEnv(self: *mut Self, e: u32, n: u32) AllocError!void {
        let ev = self.env(e)
        if ev.slots.len < n as usize {
            ev.slots = try self.val_mem.grow(ev.slots, n as usize, Value.Empty)
        }
    }

    pub fn freeEnv(self: *mut Self, e: u32) {
        let ev = self.env(e)
        self.val_mem.put(ev.slots)
        ev.slots = []mut Value{}
        ev.live = false
    }
}

// ---- values

pub fn isObject(v: Value) bool {
    return match v {
        .Obj { .. } => true
        _ => false
    }
}

pub fn isNullish(v: Value) bool {
    return match v {
        .Undefined => true
        .Null => true
        .Empty => true
        _ => false
    }
}

/// The object of `v`, or NONE.
pub fn objectOf(v: Value) u32 {
    return match v {
        .Obj { o } => o
        _ => NONE
    }
}

pub fn numVal(n: f64) Value {
    return Value.Num { n: n }
}

pub fn boolVal(b: bool) Value {
    return Value.Bool { b: b }
}

pub fn objVal(o: u32) Value {
    return Value.Obj { o: o }
}

pub fn strVal(s: u32) Value {
    return Value.Str { s: s }
}
