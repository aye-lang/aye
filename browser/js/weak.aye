// js/weak: WeakMap, WeakSet, WeakRef and FinalizationRegistry.
//
// Their entries live in tables of the interpreter that the collector
// does not trace (gc.aye):
//
// - `weak_entries`: the entries of every WeakMap and WeakSet, keyed by
//   (collection << 32 | key). They are ephemerons: the collector marks a
//   value only once both its collection and its key are marked, and
//   drops the entries whose collection or key died.
// - `weak_refs`: the target of each WeakRef; it is dropped (deref gives
//   undefined) when the target dies. A target made or returned by a
//   WeakRef stays alive until the end of the job (`kept`, cleared by the
//   host at each microtask checkpoint: clearKeptObjects).
// - `fin_cells`: the cells of the FinalizationRegistries. A registry
//   holds its held values strongly and its targets and unregister tokens
//   weakly. When a target dies its cell waits (with target NONE) until
//   the host calls the registry's callback in a task of its own
//   (takeCleanup).
//
// Keys and targets are objects or symbols not made by Symbol.for
// (CanBeHeldWeakly). Symbols are roots (symbol.aye), so a symbol key is
// never dropped.

import std.list.List
import std.map.IntMap

pub struct FinCell {
    registry: u32
    // NONE once the target died (the callback is due).
    target: u32
    held: Value
    // NONE: no unregister token (or it died).
    token: u32
}

/// A due cleanup callback of a FinalizationRegistry (takeCleanup).
pub struct Cleanup {
    callback: Value
    held: Value
}

fn installWeak(it: *mut Interp) JsError!void {
    it.weakmap_proto = try weakProto(it, "WeakMap")
    let mp = it.weakmap_proto
    try makeConstructor(it, "WeakMap", 0, weakMapCtor, mp)
    try it.defineNative(mp, "get", 1, weakMapGet)
    try it.defineNative(mp, "set", 2, weakMapSet)
    try it.defineNative(mp, "has", 1, weakMapHas)
    try it.defineNative(mp, "delete", 1, weakMapDelete)

    it.weakset_proto = try weakProto(it, "WeakSet")
    let sp = it.weakset_proto
    try makeConstructor(it, "WeakSet", 0, weakSetCtor, sp)
    try it.defineNative(sp, "add", 1, weakSetAdd)
    try it.defineNative(sp, "has", 1, weakSetHas)
    try it.defineNative(sp, "delete", 1, weakSetDelete)

    it.weakref_proto = try weakProto(it, "WeakRef")
    try makeConstructor(it, "WeakRef", 1, weakRefCtor, it.weakref_proto)
    try it.defineNative(it.weakref_proto, "deref", 0, weakRefDeref)

    it.finreg_proto = try weakProto(it, "FinalizationRegistry")
    let fp = it.finreg_proto
    try makeConstructor(it, "FinalizationRegistry", 1, finRegCtor, fp)
    try it.defineNative(fp, "register", 2, finRegRegister)
    try it.defineNative(fp, "unregister", 1, finRegUnregister)
}

// A prototype (a root) with Symbol.toStringTag `name`.
fn weakProto(it: *mut Interp, name: []u8) JsError!u32 {
    let p = try it.newObject(it.object_proto)
    try it.addRoot(objVal(p))
    let tag = try it.newString(name)
    try it.heap.addProp(p, it.sym_to_string_tag, tag, Value.Undefined, F_CONFIG)
    return p
}

/// CanBeHeldWeakly: an object, or a symbol not made by Symbol.for.
pub fn canBeHeldWeakly(it: *mut Interp, v: Value) bool {
    let o = objectOf(v)
    if o == NONE {
        return false
    }
    if it.heap.obj(o).class != Class.Symbol {
        return true
    }
    var all = it.symbol_registry.iterator()
    while all.next() |e| {
        if e.value.* == o {
            return false
        }
    }
    return true
}

fn entryKey(coll: u32, key: u32) u64 {
    return ((coll as u64) << 32) | (key as u64)
}

// The object `new` made (or the subclass instance), of class `cls`.
fn weakTarget(it: *mut Interp, a: Args, cls: Class, proto: u32, name: []u8) JsError!u32 {
    if a.new_target == NONE {
        try it.typeErrorAbout("Constructor ", name, " requires 'new'")
        return NONE
    }
    if isObject(a.this) {
        let o = objectOf(a.this)
        it.heap.obj(o).class = cls
        return o
    }
    return it.newObjectOf(cls, proto, ObjData.None)
}

fn thisWeak(it: *mut Interp, a: Args, cls: Class, method: []u8) JsError!u32 {
    let o = objectOf(a.this)
    if o != NONE && it.heap.obj(o).class == cls {
        return o
    }
    try it.typeErrorAbout("Method ", method, " called on incompatible receiver")
    return NONE
}

// Adds the values of iterable `src` to new collection o with its adder
// method (`set` with [key, value] entries, or `add`).
fn fillFrom(it: *mut Interp, o: u32, src: Value, adder: []u8, pairs: bool) JsError!void {
    if isNullish(src) {
        return
    }
    let base = it.stack.len()
    defer it.truncate(base)
    try it.push(objVal(o))
    let f = try it.getProp(objVal(o), try it.intern(adder))
    if !it.isCallable(f) {
        try it.typeErrorAbout("'", adder, "' returned for property of the collection is not a function")
    }
    try it.push(f)
    let arr = try it.iterToArray(src)
    try it.push(objVal(arr))
    var i: u32 = 0
    while i < it.heap.obj(arr).nelems {
        let e = holeToUndef(it.heap.obj(arr).elems[i])
        if pairs {
            if !isObject(e) {
                try it.notA(e, "an entry object")
            }
            let k = try it.getIndex(e, numVal(0.0))
            try it.push(k)
            let v = try it.getIndex(e, numVal(1.0))
            try it.push(v)
            try it.call2(f, objVal(o), k, v)
            it.pop()
            it.pop()
        } else {
            try it.call1(f, objVal(o), e)
        }
        i += 1
    }
}

// ---- WeakMap

fn weakMapCtor(it: *mut Interp, a: Args) JsError!Value {
    let o = try weakTarget(it, a, Class.WeakMap, it.weakmap_proto, "WeakMap")
    try fillFrom(it, o, it.arg(a, 0), "set", true)
    return objVal(o)
}

fn weakMapGet(it: *mut Interp, a: Args) JsError!Value {
    let o = try thisWeak(it, a, Class.WeakMap, "WeakMap.prototype.get")
    let k = it.arg(a, 0)
    if !canBeHeldWeakly(it, k) {
        return Value.Undefined
    }
    return it.weak_entries.get(entryKey(o, objectOf(k))) orelse Value.Undefined
}

fn weakMapSet(it: *mut Interp, a: Args) JsError!Value {
    let o = try thisWeak(it, a, Class.WeakMap, "WeakMap.prototype.set")
    let k = it.arg(a, 0)
    if !canBeHeldWeakly(it, k) {
        return it.typeError("Invalid value used as weak map key")
    }
    try it.weak_entries.put(entryKey(o, objectOf(k)), it.arg(a, 1))
    return a.this
}

fn weakMapHas(it: *mut Interp, a: Args) JsError!Value {
    let o = try thisWeak(it, a, Class.WeakMap, "WeakMap.prototype.has")
    return weakHas(it, o, it.arg(a, 0))
}

fn weakMapDelete(it: *mut Interp, a: Args) JsError!Value {
    let o = try thisWeak(it, a, Class.WeakMap, "WeakMap.prototype.delete")
    return weakDelete(it, o, it.arg(a, 0))
}

fn weakHas(it: *mut Interp, o: u32, k: Value) Value {
    if !canBeHeldWeakly(it, k) {
        return boolVal(false)
    }
    return boolVal(it.weak_entries.contains(entryKey(o, objectOf(k))))
}

fn weakDelete(it: *mut Interp, o: u32, k: Value) Value {
    if !canBeHeldWeakly(it, k) {
        return boolVal(false)
    }
    return boolVal(it.weak_entries.remove(entryKey(o, objectOf(k))))
}

// ---- WeakSet

fn weakSetCtor(it: *mut Interp, a: Args) JsError!Value {
    let o = try weakTarget(it, a, Class.WeakSet, it.weakset_proto, "WeakSet")
    try fillFrom(it, o, it.arg(a, 0), "add", false)
    return objVal(o)
}

fn weakSetAdd(it: *mut Interp, a: Args) JsError!Value {
    let o = try thisWeak(it, a, Class.WeakSet, "WeakSet.prototype.add")
    let k = it.arg(a, 0)
    if !canBeHeldWeakly(it, k) {
        return it.typeError("Invalid value used in weak set")
    }
    try it.weak_entries.put(entryKey(o, objectOf(k)), Value.Undefined)
    return a.this
}

fn weakSetHas(it: *mut Interp, a: Args) JsError!Value {
    let o = try thisWeak(it, a, Class.WeakSet, "WeakSet.prototype.has")
    return weakHas(it, o, it.arg(a, 0))
}

fn weakSetDelete(it: *mut Interp, a: Args) JsError!Value {
    let o = try thisWeak(it, a, Class.WeakSet, "WeakSet.prototype.delete")
    return weakDelete(it, o, it.arg(a, 0))
}

// ---- WeakRef

fn weakRefCtor(it: *mut Interp, a: Args) JsError!Value {
    let t = it.arg(a, 0)
    if a.new_target != NONE && !canBeHeldWeakly(it, t) {
        return it.typeError("WeakRef: invalid target")
    }
    let o = try weakTarget(it, a, Class.WeakRef, it.weakref_proto, "WeakRef")
    try it.kept.append(t)
    try it.weak_refs.put(o, objectOf(t))
    return objVal(o)
}

fn weakRefDeref(it: *mut Interp, a: Args) JsError!Value {
    let o = try thisWeak(it, a, Class.WeakRef, "WeakRef.prototype.deref")
    if it.weak_refs.get(o) |t| {
        try it.kept.append(objVal(t))
        return objVal(t)
    }
    return Value.Undefined
}

// ---- FinalizationRegistry

fn finRegCtor(it: *mut Interp, a: Args) JsError!Value {
    let cb = it.arg(a, 0)
    if a.new_target != NONE && !it.isCallable(cb) {
        return it.typeError("FinalizationRegistry: cleanup must be callable")
    }
    let o = try weakTarget(it, a, Class.FinalizationRegistry, it.finreg_proto, "FinalizationRegistry")
    it.heap.obj(o).data = ObjData.Prim { v: cb }
    return objVal(o)
}

fn finRegRegister(it: *mut Interp, a: Args) JsError!Value {
    let o = try thisWeak(it, a, Class.FinalizationRegistry, "FinalizationRegistry.prototype.register")
    let target = it.arg(a, 0)
    let held = it.arg(a, 1)
    let token = it.arg(a, 2)
    if !canBeHeldWeakly(it, target) {
        return it.typeError("FinalizationRegistry.prototype.register: invalid target")
    }
    if sameValue(it, target, held) {
        return it.typeError("FinalizationRegistry.prototype.register: target and holdings must not be same")
    }
    if !isUndef(token) && !canBeHeldWeakly(it, token) {
        return it.typeError("FinalizationRegistry.prototype.register: invalid unregister token")
    }
    var tok = NONE
    if !isUndef(token) {
        tok = objectOf(token)
    }
    try it.fin_cells.append(FinCell { registry: o, target: objectOf(target), held: held, token: tok })
    return Value.Undefined
}

fn finRegUnregister(it: *mut Interp, a: Args) JsError!Value {
    let o = try thisWeak(it, a, Class.FinalizationRegistry, "FinalizationRegistry.prototype.unregister")
    let token = it.arg(a, 0)
    if !canBeHeldWeakly(it, token) {
        return it.typeError("FinalizationRegistry.prototype.unregister: invalid unregister token")
    }
    let t = objectOf(token)
    var removed = false
    var i: usize = 0
    while i < it.fin_cells.len() {
        let c = it.fin_cells.items()[i]
        if c.registry == o && c.token == t {
            it.fin_cells.orderedRemove(i)
            removed = true
        } else {
            i += 1
        }
    }
    return boolVal(removed)
}

/// The next due callback of a FinalizationRegistry (its cell is
/// removed), for the host to call in a task: `callback(held)`.
pub fn takeCleanup(it: *mut Interp) ?Cleanup {
    for i, c in it.fin_cells.items() {
        if c.target == NONE {
            it.fin_cells.orderedRemove(i)
            let cb = match it.heap.obj(c.registry).data {
                .Prim { v } => v
                _ => Value.Undefined
            }
            return Cleanup { callback: cb, held: c.held }
        }
    }
    return null
}

/// ClearKeptObjects: the targets WeakRefs made or returned in this job
/// may be collected (the host calls it after each microtask checkpoint).
pub fn clearKeptObjects(it: *mut Interp) {
    it.kept.clear()
}

// ---- the collector's part (collectGarbage)

/// Roots: the kept targets, and the registries with a due callback with
/// their held values.
fn markWeakRoots(it: *mut Interp) {
    for v in it.kept.items() {
        markValue(it, v)
    }
    for c in it.fin_cells.items() {
        if c.target == NONE {
            markObj(it, c.registry)
            markValue(it, c.held)
        }
    }
}

/// One pass of the ephemerons: marks the value of each entry whose
/// collection and key are marked, and the held values of the live
/// registries. The collector repeats it until nothing new is marked.
fn markEphemerons(it: *mut Interp) {
    var all = it.weak_entries.iterator()
    while all.next() |e| {
        let coll = (e.key >> 32) as u32
        let key = (e.key & 0xFFFFFFFF) as u32
        if gcMarked(it, coll) && gcMarked(it, key) {
            markValue(it, e.value.*)
        }
    }
    for c in it.fin_cells.items() {
        if gcMarked(it, c.registry) {
            markValue(it, c.held)
        }
    }
}

/// After marking: drops the entries and WeakRef targets that died, and
/// makes the callbacks of the registries whose targets died due.
fn clearDeadWeak(it: *mut Interp) {
    var dead = List(u64).init(it.alloc)
    defer dead.deinit()
    var all = it.weak_entries.iterator()
    while all.next() |e| {
        let coll = (e.key >> 32) as u32
        let key = (e.key & 0xFFFFFFFF) as u32
        if !gcMarked(it, coll) || !gcMarked(it, key) {
            dead.append(e.key) catch |err| {
                return
            }
        }
    }
    for k in dead.items() {
        it.weak_entries.remove(k)
    }
    if dead.len() > 0 {
        it.weak_entries = shrunk(it, it.weak_entries)
    }
    var refs = List(u32).init(it.alloc)
    defer refs.deinit()
    var rs = it.weak_refs.iterator()
    while rs.next() |e| {
        if !gcMarked(it, e.key) || !gcMarked(it, e.value.*) {
            refs.append(e.key) catch |err| {
                return
            }
        }
    }
    for r in refs.items() {
        it.weak_refs.remove(r)
    }
    var i: usize = 0
    while i < it.fin_cells.len() {
        let c = &mut it.fin_cells.items()[i]
        if !gcMarked(it, c.registry) {
            it.fin_cells.orderedRemove(i)
            continue
        }
        if c.token != NONE && !gcMarked(it, c.token) {
            c.token = NONE
        }
        if c.target != NONE && !gcMarked(it, c.target) {
            c.target = NONE
        }
        i += 1
    }
}

// The entries of m in a table of fitting size, when m's table is
// mostly empty (a table never shrinks by itself).
fn shrunk(it: *mut Interp, m: IntMap(u64, Value)) IntMap(u64, Value) {
    var old = m
    if old.slots.len <= 64 || old.len() * 8 > old.slots.len {
        return old
    }
    var fresh = IntMap(u64, Value).init(it.alloc)
    var all = old.iterator()
    while all.next() |e| {
        fresh.put(e.key, e.value.*) catch |err| {
            fresh.deinit()
            return old
        }
    }
    old.deinit()
    return fresh
}

/// The number of entries of all WeakMaps and WeakSets (for tests).
pub fn weakEntryCount(it: *mut Interp) usize {
    return it.weak_entries.len()
}
