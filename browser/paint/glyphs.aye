// Drawing text: with the system's fonts, glyphs rendered by FreeType
// (antialiased, 8-bit coverage) are kept in a glyph cache and blended
// into the canvas; with the fixed-metric test font, each glyph is a
// plain box in its cell, so screenshots do not depend on the machine.
//
// Glyphs go at the pen positions that layout measured: the advances are
// those of `font.Measurer.width`, scaled to device pixels, and each
// glyph's origin is rounded to a whole pixel.

import font
import std.list.List
import std.map.IntMap
import std.math
import std.mem.AllocError
import std.mem.Allocator
import std.text

// A cached glyph bitmap: `w` x `h` coverage bytes at `data[offset..]`;
// a color glyph (emoji) has `w` x `h` RGBA pixels there instead, drawn
// `scale` times their size.
struct Glyph {
    ok: bool
    w: usize
    h: usize
    left: i64
    top: i64
    offset: usize
    color: bool
    scale: f64
}

/// Where a glyph's bitmap goes (`left`, `top` from the pen position, y
/// up) and its size in pixels.
pub struct GlyphBox {
    left: i64
    top: i64
    w: usize
    h: usize
    color: bool
}

pub struct TextPainter {
    alloc: Allocator
    // The system's fonts; null to draw the fixed-metric font's boxes.
    system: ?*mut font.System
    // Key: face << 52 | glyph id << 32 | size in 1/64 px.
    index: IntMap(u64, usize)
    glyphs: List(Glyph)
    data: List(u8)
    // The glyphs of the text being drawn.
    placed: List(font.Placed)

    pub fn init(alloc: Allocator, system: ?*mut font.System) TextPainter {
        return TextPainter {
            alloc: alloc,
            system: system,
            index: IntMap(u64, usize).init(alloc),
            glyphs: List(Glyph).init(alloc),
            data: List(u8).init(alloc),
            placed: List(font.Placed).init(alloc),
        }
    }

    pub fn deinit(self: *mut Self) {
        self.index.deinit()
        self.glyphs.deinit()
        self.data.deinit()
        self.placed.deinit()
    }

    /// Draws `s` in `f` (CSS px) and color `c`, its baseline starting at
    /// (`x`, `y`) in device pixels, at `scale` device pixels per CSS px.
    pub fn draw(self: *mut Self, canvas: *mut Canvas, x: f64, y: f64, s: []u8, f: font.Font, scale: f64, c: Rgba) AllocError!void {
        if self.system |sys| {
            return self.drawSystem(sys, canvas, x, y, s, f, scale, c)
        }
        drawFixed(canvas, x, y, s, f, scale, c)
    }

    fn drawSystem(self: *mut Self, sys: *mut font.System, canvas: *mut Canvas, x: f64, y: f64, s: []u8, f: font.Font, scale: f64, c: Rgba) AllocError!void {
        let size64 = math.floor(f.size * scale * 64.0 + 0.5) as i64
        if size64 <= 0 || size64 > 0x1FFFFFFF {
            return
        }
        let base = roundPx(y)
        self.placed.clear()
        try sys.shapeText(f, s, &mut self.placed)
        for k in 0..self.placed.len() {
            let p = self.placed.items()[k]
            let ch = s[p.cluster as usize]
            if ch == ' ' || ch == '\t' || ch == '\n' {
                continue
            }
            let origin = roundPx(x + p.x * scale)
            let top = base - roundPx(p.y * scale)
            let gi = try self.glyph(sys, p.face, size64, p.glyph)
            let gl = self.glyphs.items()[gi]
            if !gl.ok || gl.w == 0 || gl.h == 0 {
                continue
            }
            if gl.color {
                let px = self.data.items()[gl.offset..gl.offset + gl.w * gl.h * 4]
                let x0 = origin + roundPx(gl.left as f64 * gl.scale)
                let y0 = top - roundPx(gl.top as f64 * gl.scale)
                let r = IRect { x0: x0, y0: y0, x1: x0 + roundPx(gl.w as f64 * gl.scale), y1: y0 + roundPx(gl.h as f64 * gl.scale) }
                canvas.drawImage(r, gl.w, gl.h, px)
            } else {
                let mask = self.data.items()[gl.offset..gl.offset + gl.w * gl.h]
                canvas.blitMask(origin + gl.left, top - gl.top, gl.w, gl.h, mask, gl.w, c)
            }
        }
    }

    /// The box of glyph `g` of `face` at `size64` (1/64 px) as drawn,
    /// rendering and caching it on first use; null without pixels.
    pub fn glyphBox(self: *mut Self, sys: *mut font.System, face: u32, size64: i64, g: u32) AllocError!?GlyphBox {
        let gi = try self.glyph(sys, face, size64, g)
        let gl = self.glyphs.items()[gi]
        if !gl.ok || gl.w == 0 || gl.h == 0 {
            return null
        }
        return GlyphBox { left: gl.left, top: gl.top, w: gl.w, h: gl.h, color: gl.color }
    }

    /// The bytes the glyph cache holds.
    pub fn cached(self: *Self) usize {
        return self.data.len()
    }

    // The index in `glyphs` of glyph `g` of face `face` at `size64`,
    // rendering it on first use.
    fn glyph(self: *mut Self, sys: *mut font.System, face: u32, size64: i64, g: u32) AllocError!usize {
        let key = (face as u64 << 52) | ((g as u64 & 0xFFFFF) << 32) | size64 as u64
        if self.index.get(key) |gi| {
            return gi
        }
        var gl = Glyph { ok: false, w: 0, h: 0, left: 0, top: 0, offset: self.data.len(), color: false, scale: 1.0 }
        if sys.render(face, size64, g) |bm| {
            if bm.buffer |buf| {
                gl.ok = true
                gl.w = bm.width as usize
                gl.h = bm.rows as usize
                gl.left = bm.left as i64
                gl.top = bm.top as i64
                gl.color = bm.color
                if bm.color && bm.ppem > 0.0 {
                    gl.scale = size64 as f64 / 64.0 / bm.ppem
                }
                for row in 0..gl.h {
                    // A negative pitch means rows go bottom-up.
                    var start: usize = 0
                    if bm.pitch >= 0 {
                        start = row * bm.pitch as usize
                    } else {
                        start = (gl.h - 1 - row) * (-bm.pitch) as usize
                    }
                    if gl.color {
                        // Premultiplied BGRA to straight RGBA.
                        for col in 0..gl.w {
                            let o = start + col * 4
                            let a = buf[o + 3] as u32
                            if a == 0 {
                                try self.data.append(0)
                                try self.data.append(0)
                                try self.data.append(0)
                                try self.data.append(0)
                            } else {
                                try self.data.append(math.minOf(u32, 255, (buf[o + 2] as u32 * 255 + a / 2) / a) as u8)
                                try self.data.append(math.minOf(u32, 255, (buf[o + 1] as u32 * 255 + a / 2) / a) as u8)
                                try self.data.append(math.minOf(u32, 255, (buf[o] as u32 * 255 + a / 2) / a) as u8)
                                try self.data.append(a as u8)
                            }
                        }
                    } else {
                        for col in 0..gl.w {
                            try self.data.append(buf[start + col])
                        }
                    }
                }
            } else {
                gl.ok = true
            }
        }
        try self.glyphs.append(gl)
        let gi = self.glyphs.len() - 1
        try self.index.put(key, gi)
        return gi
    }
}

/// Rounds a device coordinate to the nearest pixel edge.
pub fn roundPx(v: f64) i64 {
    return math.floor(v + 0.5) as i64
}

// The fixed-metric font: each glyph advances 0.5em (1em when wide) and
// is drawn as a box inset in its cell: x-height tall for lower-case
// letters (with a descender for g, j, p, q, y), cap height for the rest.
// Spaces and zero-width characters draw nothing.
fn drawFixed(canvas: *mut Canvas, x: f64, y: f64, s: []u8, f: font.Font, scale: f64, c: Rgba) {
    let em = f.size * scale
    var pen = x
    var i: usize = 0
    while i < s.len {
        let d = text.decode(s[i..])
        i += d.len
        let adv = 0.5 * em * font.columns(d.code) as f64
        if adv > 0.0 && d.code > 0x20 && d.code != 0xA0 {
            var top = y - 0.7 * em
            var bottom = y
            if d.code >= 'a' as u32 && d.code <= 'z' as u32 {
                top = y - 0.5 * em
                if d.code == 'g' as u32 || d.code == 'j' as u32 || d.code == 'p' as u32 || d.code == 'q' as u32 || d.code == 'y' as u32 {
                    bottom = y + 0.2 * em
                }
            }
            let r = IRect { x0: roundPx(pen + adv * 0.15), y0: roundPx(top), x1: roundPx(pen + adv * 0.85), y1: roundPx(bottom) }
            canvas.fillRect(r, c)
        }
        pen += adv
    }
}
