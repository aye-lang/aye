// css: style sheets and computed style.
//
// - tokenizer.ore: CSS Syntax tokens.
// - parser.ore: style sheets (rules, declarations, `@media`; other
//   at-rules are skipped) into a `Sheet`, with error recovery.
// - selector.ore: selectors (parsing, specificity, matching).
// - values.ore: property values (lengths, colors, keywords, shorthands).
// - media.ore: media queries against a `Media` (the viewport).
// - cascade.ore: the cascade and computed values (`Styles`).
// - ua.ore: the user-agent style sheet.
//
// A `Sheet` owns everything it parsed in an arena, including the strings
// that computed values point to: keep the sheets alive as long as the
// `Styles` computed from them.

import dom.NodeId
import std.heap.Arena
import std.list.List
import std.mem.AllocError
import std.mem.Allocator

/// An RGBA color; `a` from 0 (transparent) to 1.
pub struct Color {
    r: u8
    g: u8
    b: u8
    a: f64
}

/// A property value. Specified values may be any variant; computed values
/// are `Keyword`, `Px`, `Percent`, `Calc`, `Number`, `Rgba` or
/// `CurrentColor`.
pub enum Value {
    // A keyword, or a list of them ("underline overline"), or a font
    // family list.
    Keyword { k: []u8 }
    Px { v: f64 }
    Em { v: f64 }
    Rem { v: f64 }
    Vw { v: f64 }
    Vh { v: f64 }
    Percent { v: f64 }
    Number { v: f64 }
    Rgba { c: Color }
    // A `calc()` length that mixes a percentage and pixels: `pct`% of the
    // reference length plus `px` (layout resolves it).
    Calc { pct: f64, px: f64 }
    CurrentColor
    Inherit
    Initial
    Unset
}

/// The viewport that media queries and `vw`/`vh` refer to.
pub struct Media {
    width: f64
    height: f64
}

// ---- properties

// What a property accepts.
pub enum PKind {
    // One of `keywords`.
    Keywords
    // A length or percentage (negative allowed), or one of `keywords`.
    Length
    // A length or percentage that is not negative, or one of `keywords`.
    LengthNonNeg
    Color
    FontSize
    FontWeight
    LineHeight
    FontFamily
    BorderWidth
    TextDecoration
    // A number that is not negative, or one of `keywords`.
    Number
    // An integer (any sign), or one of `keywords`.
    Int
    // Any component values, or one of `keywords`: kept as their text
    // (a `Keyword`) for layout to read (the grid properties, transforms).
    Raw
    // An SVG paint: a color, or one of `keywords`, or `url(#id)` with an
    // optional fallback, kept as its text (a `Keyword`) for svg to read.
    Paint
    // Comma-separated layers of component values (backgrounds, masks,
    // corner radii, shadows, dashes), or one of `keywords`: kept as their
    // text (a `Keyword`), lengths in px and URLs absolute, for paint to
    // read with `readLayers` (layers.ore).
    Layers
}

pub struct Property {
    name: []u8
    inherited: bool
    kind: PKind
    // Space-separated keywords.
    keywords: []u8
    // The initial value, already computed (except border widths, which
    // compute to 0 while the border style is `none`).
    initial: Value
}

