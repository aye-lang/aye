/// The index of the longhand property `name` (lower case).
pub fn propertyIndex(name: []u8) ?usize {
    for i, p in PROPERTIES {
        if eqlBytes(p.name, name) {
            return i
        }
    }
    return null
}

// Ranks the sublayers of `p` (in the order they were made), then `p`.
fn rankLayer(layers: []mut Layer, p: u32, next: *mut u32) {
    for k in 1..layers.len {
        if layers[k].parent == p && k as u32 != p {
            rankLayer(layers, k as u32, next)
        }
    }
    layers[p].rank = next.*
    next.* += 1
}

fn eqlBytes(a: []u8, b: []u8) bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// ---- style sheets

/// `Decl.prop` of a custom property (`--name`).
pub let CUSTOM: usize = 100000

/// A declaration of a longhand property (or of a custom property).
pub struct Decl {
    prop: usize
    value: Value
    important: bool
    // A value computed at computed-value time (one with `var()` or
    // `calc()`): its tokens, and `value` is unused. Also the value of a
    // custom property.
    raw: []Token
    // A custom property: its name. A longhand of a shorthand with `var()`:
    // the shorthand, parsed again once `var()` is substituted.
    name: []u8
}

/// A style rule: selectors `sel_start..sel_end` of `Sheet.complexes` and
/// declarations `decl_start..decl_end` of `Sheet.decls`.
pub struct Rule {
    sel_start: usize
    sel_end: usize
    decl_start: usize
    decl_end: usize
    // Its cascade layer: an index of `Sheet.layers` (0: not in a layer).
    layer: u32
    // The `@container` condition it is under: 1 + an index of
    // `Sheet.conditions`; 0 for none.
    cond: u32
    // In `@scope`: at equal specificity, it wins over rules in none.
    scoped: bool
}

/// A cascade layer (`@layer`): `name` is the full dotted name ("" for an
/// anonymous layer), `parent` the layer it is in (0: none). `rank` orders
/// the layers for the cascade: the sublayers of a layer come before its
/// own rules, layers in the order they were first declared, and rules in
/// no layer last (`rankLayers`).
pub struct Layer {
    name: []u8
    parent: u32
    rank: u32
}

/// An `@container` condition: the container's name ("" for the nearest
/// container), the condition's tokens, and the condition of an
/// enclosing `@container` (1 + index; 0 for none).
pub struct ContainerCondition {
    name: []u8
    toks: []Token
    parent: u32
}

/// A style sheet: the rules of every source added to it, in order.
pub struct Sheet {
    alloc: Allocator
    // Owns every list and string of the sheet. On the heap, so that the
    // `Allocator` the lists hold stays valid when the sheet is moved.
    arena: *mut Arena
    rules: List(Rule)
    complexes: List(Complex)
    compounds: List(Compound)
    simples: List(Simple)
    decls: List(Decl)
    // The URLs of the `@import` rules whose media match, as the parser
    // met them (the loader fetches them: engine/sheets.ore).
    imports: List([]u8)
    // The layer each of `imports` goes into (`layer`, `layer(name)`; 0
    // when in none: the importing sheet's).
    import_layers: List(u32)
    // The `@font-face` rules (fontface.ore).
    font_faces: List(FontFace)
    // The URL that the `url()`s of the source being parsed are relative
    // to ("": they stay as written); set by the loader around a parse.
    base: []u8
    // The cascade layers; the first is the place of rules in no layer.
    layers: List(Layer)
    // The layer the rules of the source being parsed go into (an
    // imported sheet's `layer()`); set by the loader around a parse.
    base_layer: u32
    // The `@container` conditions of rules.
    conditions: List(ContainerCondition)
    // The element that a `@scope` without a prelude scopes to while the
    // source being parsed is a `style` element's (its parent); set by
    // the loader.
    scope_root: ?NodeId

    pub fn init(alloc: Allocator) AllocError!Sheet {
        let arena = try alloc.create(Arena.init(alloc))
        let a = arena.allocator()
        var layers = List(Layer).init(a)
        layers.append(Layer { name: "", parent: 0, rank: 0 }) catch |e| {
            arena.deinit()
            alloc.destroy(arena)
            return e
        }
        return Sheet {
            alloc: alloc,
            arena: arena,
            rules: List(Rule).init(a),
            complexes: List(Complex).init(a),
            compounds: List(Compound).init(a),
            simples: List(Simple).init(a),
            decls: List(Decl).init(a),
            imports: List([]u8).init(a),
            import_layers: List(u32).init(a),
            font_faces: List(FontFace).init(a),
            base: "",
            layers: layers,
            base_layer: 0,
            conditions: List(ContainerCondition).init(a),
            scope_root: null,
        }
    }

    /// The layer named `name` (a full dotted name) inside the layer
    /// `parent`, made when it does not exist yet.
    pub fn layerNamed(self: *mut Self, parent: u32, name: []u8) AllocError!u32 {
        let layers = self.layers.items()
        for i, l in layers {
            if i > 0 && l.name.len > 0 && l.parent == parent && eqlBytes(l.name, name) {
                return i as u32
            }
        }
        return self.newLayer(parent, name)
    }

    /// A new layer in `parent` (`name` "" for an anonymous one).
    pub fn newLayer(self: *mut Self, parent: u32, name: []u8) AllocError!u32 {
        try self.layers.append(Layer { name: name, parent: parent, rank: 0 })
        return (self.layers.len() - 1) as u32
    }

    /// Orders the layers (`Layer.rank`) after layers were added.
    pub fn rankLayers(self: *mut Self) {
        var next: u32 = 0
        rankLayer(self.layers.items(), 0, &mut next)
    }

    pub fn deinit(self: *mut Self) {
        self.arena.deinit()
        self.alloc.destroy(self.arena)
    }

    /// Moves the rules `mid..` (those of imported sheets, parsed last)
    /// before the rules `from..mid`, so that they come first in the
    /// cascade order as `@import` wants.
    pub fn moveRulesFirst(self: *mut Self, from: usize, mid: usize) AllocError!void {
        let rules = self.rules.items()
        if mid <= from || mid >= rules.len {
            return
        }
        let a = self.arena.allocator()
        let copy = try a.alloc(rules[0], rules.len - from)
        var n: usize = 0
        for k in mid..rules.len {
            copy[n] = rules[k]
            n += 1
        }
        for k in from..mid {
            copy[n] = rules[k]
            n += 1
        }
        for k in 0..n {
            rules[from + k] = copy[k]
        }
    }
}
