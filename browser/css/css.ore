    Property { name: "float", inherited: false, kind: PKind.Keywords, keywords: "none left right inline-start inline-end", initial: Value.Keyword { k: "none" } },
    Property { name: "clear", inherited: false, kind: PKind.Keywords, keywords: "none left right both inline-start inline-end", initial: Value.Keyword { k: "none" } },
    Property { name: "z-index", inherited: false, kind: PKind.Int, keywords: "auto", initial: Value.Keyword { k: "auto" } },
    Property { name: "grid-template-columns", inherited: false, kind: PKind.Raw, keywords: "none", initial: Value.Keyword { k: "none" } },
    Property { name: "grid-template-rows", inherited: false, kind: PKind.Raw, keywords: "none", initial: Value.Keyword { k: "none" } },
    Property { name: "grid-template-areas", inherited: false, kind: PKind.Raw, keywords: "none", initial: Value.Keyword { k: "none" } },
