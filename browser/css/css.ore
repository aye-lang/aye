let DISPLAYS = "inline block list-item inline-block table inline-table table-row-group table-header-group table-footer-group table-row table-cell table-column-group table-column table-caption flex inline-flex grid inline-grid flow-root contents none"
let BORDER_STYLES = "none hidden dotted dashed solid double groove ridge inset outset"
let LIST_STYLES = "disc circle square decimal decimal-leading-zero lower-roman upper-roman lower-greek lower-alpha lower-latin upper-alpha upper-latin armenian georgian none"
let OVERFLOWS = "visible hidden clip scroll auto"
let ALIGNS = "normal stretch flex-start flex-end start end self-start self-end center baseline"
let BLACK = Color { r: 0, g: 0, b: 0, a: 1.0 }
let TRANSPARENT = Color { r: 0, g: 0, b: 0, a: 0.0 }

