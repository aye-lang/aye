// The user-agent style sheet: a subset of the rendering section of the
// HTML standard (display types, margins of blocks, headings, lists,
// links, phrasing elements, `pre`, tables, `hr`, hidden elements, form
// controls).
// One rule per string (Ore strings are single-line); `uaSheet` parses
// them in order.

import std.mem.AllocError

let UA_RULES = [_][]u8{
    "html, address, blockquote, body, center, dialog, div, figure, figcaption, footer, form, header, hr, legend, listing, main, p, plaintext, pre, search, xmp { display: block }",
    "article, aside, h1, h2, h3, h4, h5, h6, hgroup, nav, section { display: block }",
    "dir, dd, dl, dt, menu, ol, ul, details, summary, fieldset, optgroup, address { display: block }",
    "area, base, basefont, datalist, head, link, meta, noembed, noframes, param, rp, script, style, template, title { display: none }",
    "[hidden] { display: none }",
    "[dir=rtl i] { direction: rtl }",
    "[dir=ltr i] { direction: ltr }",
    "li { display: list-item }",
    "table { display: table }",
    "caption { display: table-caption; text-align: center }",
    "colgroup { display: table-column-group }",
    "col { display: table-column }",
    "thead { display: table-header-group }",
    "tbody { display: table-row-group }",
    "tfoot { display: table-footer-group }",
    "tr { display: table-row }",
    "td, th { display: table-cell; padding: 1px }",
    "th { font-weight: bold; text-align: center }",
    "input, select, button, textarea { display: inline-block; font-size: 13.333px; font-family: sans-serif; font-weight: normal; font-style: normal; color: black; line-height: normal; text-align: left; text-decoration: none; text-indent: 0 }",
    "input, select, textarea { background-color: white; border: 1px solid #767676; padding: 1px 2px; overflow: hidden }",
    "input, select { white-space: pre }",
    "select { padding-right: 20px }",
    "button, input[type=submit i], input[type=reset i], input[type=button i] { background-color: #efefef; border: 1px solid #767676; padding: 1px 6px; text-align: center }",
    "input[type=checkbox i], input[type=radio i] { margin: 3px 3px 3px 4px; padding: 0; border-style: none; background-color: transparent }",
    "input[type=image i] { padding: 0; border-style: none; background-color: transparent }",
    "input[type=hidden i] { display: none }",
    "input:disabled, select:disabled, textarea:disabled, button:disabled { color: #6d6d6d; border-color: #c4c4c4 }",
    "body { margin: 8px }",
    "p, dl, listing, pre, plaintext, xmp { margin-top: 1em; margin-bottom: 1em }",
    "blockquote, figure { margin: 1em 40px }",
    "dd { margin-left: 40px }",
    "dir, menu, ol, ul { margin-top: 1em; margin-bottom: 1em; padding-left: 40px }",
    "ol ol, ol ul, ul ol, ul ul, ol menu, ul menu, menu ol, menu ul { margin-top: 0; margin-bottom: 0 }",
    "ul, menu, dir { list-style-type: disc }",
    "ol { list-style-type: decimal }",
    "ul ul, ol ul, menu ul, ul menu { list-style-type: circle }",
    "ul ul ul, ul ol ul, ol ul ul, ol ol ul { list-style-type: square }",
    "h1 { font-size: 2em; margin-top: 0.67em; margin-bottom: 0.67em; font-weight: bold }",
    "h2 { font-size: 1.5em; margin-top: 0.83em; margin-bottom: 0.83em; font-weight: bold }",
    "h3 { font-size: 1.17em; margin-top: 1em; margin-bottom: 1em; font-weight: bold }",
    "h4 { font-size: 1em; margin-top: 1.33em; margin-bottom: 1.33em; font-weight: bold }",
    "h5 { font-size: 0.83em; margin-top: 1.67em; margin-bottom: 1.67em; font-weight: bold }",
    "h6 { font-size: 0.67em; margin-top: 2.33em; margin-bottom: 2.33em; font-weight: bold }",
    "b, strong { font-weight: bolder }",
    "i, em, cite, var, dfn, address { font-style: italic }",
    "u, ins { text-decoration: underline }",
    "s, strike, del { text-decoration: line-through }",
    "code, kbd, samp, tt, pre, listing, xmp, plaintext { font-family: monospace }",
    "pre, listing, xmp, plaintext { white-space: pre }",
    "textarea { white-space: pre-wrap; font-family: monospace }",
    "nobr { white-space: nowrap }",
    "small { font-size: smaller }",
    "big { font-size: larger }",
    "sub, sup { font-size: smaller }",
    "center { text-align: center }",
    "a:link { color: #0000ee; text-decoration: underline }",
    "mark { background-color: yellow; color: black }",
    "hr { margin: 0.5em auto; border-style: inset; border-width: 1px; color: gray; overflow: hidden }",
    "fieldset { margin-left: 2px; margin-right: 2px; padding: 0.35em 0.75em 0.625em; border: 2px groove gray }",
    "legend { padding-left: 2px; padding-right: 2px }",
}

// In quirks mode only (HTML, "Rendering", 15.3.1): tables do not inherit
// the font and text alignment of their surroundings.
let QUIRKS_RULES = [_][]u8{
    "table { font-weight: initial; font-style: initial; font-size: initial; line-height: initial; white-space: initial; text-align: initial }",
    "form { margin-bottom: 1em }",
    "img[align=left i] { margin-right: 3px }",
    "img[align=right i] { margin-left: 3px }",
}

/// Parses the rules that the user-agent style sheet adds in quirks mode
/// into `sheet`.
pub fn quirksSheet(sheet: *mut Sheet) AllocError!void {
    for rule in QUIRKS_RULES {
        try parseSheet(sheet, rule, Media { width: 0.0, height: 0.0 })
    }
}

/// Parses the user-agent style sheet into `sheet`.
pub fn uaSheet(sheet: *mut Sheet, media: Media) AllocError!void {
    for rule in UA_RULES {
        try parseSheet(sheet, rule, media)
    }
}
