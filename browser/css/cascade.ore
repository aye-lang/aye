// The cascade and computed values. For each element, every declaration of
// a matching rule competes per property: the higher level wins (UA
// normal < author normal < `style` attribute < author !important <
// `style` attribute !important < UA !important), then the higher
// specificity, then the later declaration. A property without a winner
// inherits (inherited properties) or takes its initial value. Computed
// values are absolute where CSS says so: lengths in px (percentages stay,
// except for font-size and line-height), font weights as numbers, colors
// as RGBA (`currentcolor` stays, except for `color`).
//
// Custom properties cascade per name and inherit by sharing levels
// (vars.ore). A declaration kept as tokens (`var()`, `calc()`) is
// substituted and parsed when its property is computed; when that fails
// it is `unset` (invalid at computed-value time).
//
// Presentational hints (hints.ore) come before the author sheets at
// specificity zero, and in quirks mode the quirks rules of the UA sheet
// apply. A block-level child in flow of `<center>` (or of an element
// with `align=center`) gets auto side margins, as the `-webkit-center`
// alignment of browsers does.
//
// The `::before` and `::after` pseudo-elements of an element get styles
// of their own (`Styles.pseudo`) from the rules that select them (no
// `style` attribute), inheriting from the element, when their `content`
// is not `normal` or `none`.

import dom
import dom.Document
import dom.Kind
import dom.NodeId
import perf
import std.heap.Arena
import std.list.List
import std.map.IntMap
import std.map.StrMap
import std.math
import std.mem.AllocError
import std.mem.Allocator
import std.text

/// The computed styles of the elements of a document: `NPROPS` values per
/// element, indexed like `PROPERTIES`.
pub struct Styles {
    alloc: Allocator
    arena: *mut Arena
    // Node index to its values.
    map: IntMap(u32, []mut Value)
    // Node index to the values of its `::before` and `::after`.
    before: IntMap(u32, []mut Value)
    after: IntMap(u32, []mut Value)
    // The `style` attributes and presentational hints, parsed.
    inline: Sheet
    // The UA rules of quirks mode.
    quirks: Sheet
    // Node index to the custom properties the element has (null: none).
    customs: IntMap(u32, *mut CustomLevel)
    // The computed initial values (what an element without any rule and
    // without a parent gets).
    initial: []mut Value
    // Candidate rule indices, shared with lazy getComputedStyle reads.
    ua_index: RuleIndex
    author_index: RuleIndex
    quirks_index: RuleIndex

    pub fn init(alloc: Allocator) AllocError!Styles {
        let arena = try alloc.create(Arena.init(alloc))
        var inline = Sheet.init(alloc) catch |e| {
            alloc.destroy(arena)
            return e
        }
        var quirks = Sheet.init(alloc) catch |e| {
            inline.deinit()
            alloc.destroy(arena)
            return e
        }
        quirksSheet(&mut quirks) catch |e| {
            quirks.deinit()
            inline.deinit()
            alloc.destroy(arena)
            return e
        }
        let initial = arena.allocator().alloc(Value.Initial, NPROPS) catch |e| {
            quirks.deinit()
            inline.deinit()
            arena.deinit()
            alloc.destroy(arena)
            return e
        }
        for i, p in PROPERTIES {
            initial[i] = p.initial
        }
        fixBorderWidths(initial)
        return Styles {
            alloc: alloc,
            arena: arena,
            map: IntMap(u32, []mut Value).init(alloc),
            before: IntMap(u32, []mut Value).init(alloc),
            after: IntMap(u32, []mut Value).init(alloc),
            inline: inline,
            quirks: quirks,
            customs: IntMap(u32, *mut CustomLevel).init(alloc),
            initial: initial,
            ua_index: RuleIndex.init(alloc),
            author_index: RuleIndex.init(alloc),
            quirks_index: RuleIndex.init(alloc),
        }
    }

    pub fn deinit(self: *mut Self) {
        self.ua_index.deinit()
        self.author_index.deinit()
        self.quirks_index.deinit()
        self.map.deinit()
        self.before.deinit()
        self.after.deinit()
        self.customs.deinit()
        self.quirks.deinit()
        self.inline.deinit()
        self.arena.deinit()
        self.alloc.destroy(self.arena)
    }

    /// The computed values of the element `el` (null for other nodes).
    pub fn get(self: *Self, el: NodeId) ?[]Value {
        if self.map.get(el.index) |v| {
            return v
        }
        return null
    }

    /// The computed values of the `::before` (`pseudo` 1) or `::after`
    /// (2) of `el`; null when it has none (no `content`).
    pub fn pseudo(self: *Self, el: NodeId, pseudo: u8) ?[]Value {
        var m = &self.before
        if pseudo == 2 {
            m = &self.after
        }
        if m.get(el.index) |v| {
            let values: []Value = v
            return values
        }
        return null
    }
}

// The best declaration so far for one property.
struct Win {
    set: bool
    level: u8
    spec: u32
    d: Decl
}

// The best declaration so far for one custom property.
struct CustomWin {
    name: []u8
    raw: []Token
    level: u8
    spec: u32
}

let NO_DECL = Decl { prop: 0, value: Value.Initial, important: false, raw: []Token{}, name: "" }

/// Computes the style of every element of `doc` from the user-agent
/// sheet `ua` and the author sheet `author` (and `style` attributes).
pub fn computeStyles(doc: *Document, ua: *Sheet, author: *Sheet, media: Media, out: *mut Styles) AllocError!void {
    let began = perf.start()
    defer perf.end("cascade", began, "document")
    let a = out.arena.allocator()
    let wins = try a.alloc(Win { set: false, level: 0, spec: 0, d: NO_DECL }, NPROPS)
    var c = Computer {
        doc: doc,
        media: media,
        out: out,
        wins: wins,
        root_font: 16.0,
        centered: IntMap(u32, bool).init(out.alloc),
        custom_wins: List(CustomWin).init(out.alloc),
        custom_index: StrMap(usize).init(out.alloc),
        level: null,
    }
    defer c.deinit()
    var hints = text.Builder.init(out.alloc)
    defer hints.deinit()
    // The rules that select pseudo-elements.
    var ua_pseudo = List(usize).init(out.alloc)
    defer ua_pseudo.deinit()
    var author_pseudo = List(usize).init(out.alloc)
    defer author_pseudo.deinit()
    try pseudoRules(ua, &mut ua_pseudo)
    try pseudoRules(author, &mut author_pseudo)
    var cur: ?NodeId = doc.root
    while cur |h| {
        if doc.node(h).kind == Kind.Element {
            try styleElement(&mut c, ua, author, &mut hints, h)
            if ua_pseudo.len() + author_pseudo.len() > 0 {
                for which in 1..3 {
                    for i in 0..wins.len {
                        wins[i].set = false
                    }
                    c.clearCustoms()
                    var any = try c.considerPseudo(ua, h, false, which as u8)
                    if try c.considerPseudo(author, h, true, which as u8) {
                        any = true
                    }
                    if any {
                        try c.computePseudo(h, which as u8)
                    }
                }
            }
        }
        cur = doc.following(h, doc.root)
    }
}

/// Computes the style of the element `el` and of its ancestors only (what
/// getComputedStyle needs), into `out`; nothing when `out` has it.
pub fn computeStylesOf(doc: *Document, ua: *Sheet, author: *Sheet, media: Media, el: NodeId, out: *mut Styles) AllocError!void {
    let began = perf.start()
    defer perf.end("cascade_read", began, "ancestors")
    if out.map.contains(el.index) {
        return
    }
    let a = out.arena.allocator()
    let wins = try a.alloc(Win { set: false, level: 0, spec: 0, d: NO_DECL }, NPROPS)
    var c = Computer {
        doc: doc,
        media: media,
        out: out,
        wins: wins,
        root_font: 16.0,
        centered: IntMap(u32, bool).init(out.alloc),
        custom_wins: List(CustomWin).init(out.alloc),
        custom_index: StrMap(usize).init(out.alloc),
        level: null,
    }
    defer c.deinit()
    var hints = text.Builder.init(out.alloc)
    defer hints.deinit()
    // From the root down, so that each element inherits from its parent.
    var chain = List(NodeId).init(out.alloc)
    defer chain.deinit()
    var cur: ?NodeId = el
    while cur |h| {
        if doc.node(h).kind == Kind.Element {
            try chain.append(h)
        }
        cur = doc.node(h).parent
    }
    var i = chain.len()
    while i > 0 {
        i -= 1
        try styleElement(&mut c, ua, author, &mut hints, chain.items()[i])
    }
}

// The cascade for one element whose parent has its style.
fn styleElement(c: *mut Computer, ua: *Sheet, author: *Sheet, hints: *mut text.Builder, h: NodeId) AllocError!void {
    let doc = c.doc
    let out = c.out
    for i in 0..c.wins.len {
        c.wins[i].set = false
    }
    c.clearCustoms()
    try c.consider(ua, h, false)
    if doc.quirks {
        try c.consider(&out.quirks, h, false)
    }
    hints.clear()
    try writeHints(doc, h, hints)
    if hints.len() > 0 {
        let range = try parseInline(&mut out.inline, hints.bytes())
        for k in range.start..range.end {
            try c.offer(out.inline.decls.items()[k], 2, 0)
        }
    }
    try c.consider(author, h, true)
    if doc.attr(h, "style") |src| {
        let range = try parseInline(&mut out.inline, src)
        for k in range.start..range.end {
            let d = out.inline.decls.items()[k]
            var level: u8 = 3
            if d.important {
                level = 5
            }
            try c.offer(d, level, 0)
        }
    }
    try c.compute(h)
}

// The indices of the rules of `sheet` with a selector of a
// pseudo-element.
fn pseudoRules(sheet: *Sheet, out: *mut List(usize)) AllocError!void {
    let complexes = sheet.complexes.items()
    for ri, r in sheet.rules.items() {
        for k in r.sel_start..r.sel_end {
            if complexes[k].pseudo != 0 {
                try out.append(ri)
                break
            }
        }
    }
}

struct Computer {
    doc: *Document
    media: Media
    out: *mut Styles
    wins: []mut Win
    // The font size of the root element, for `rem`.
    root_font: f64
    // The elements that align their block children to the center.
    centered: IntMap(u32, bool)
    // The custom properties of the element: the winners, and the index
    // of each name among them.
    custom_wins: List(CustomWin)
    custom_index: StrMap(usize)
    // The custom properties the element sees.
    level: ?*mut CustomLevel

    fn deinit(self: *mut Self) {
        self.centered.deinit()
        self.custom_wins.deinit()
        self.custom_index.deinit()
    }

    fn clearCustoms(self: *mut Self) {
        if self.custom_wins.len() > 0 {
            self.custom_wins.clear()
            self.custom_index.deinit()
            self.custom_index = StrMap(usize).init(self.out.alloc)
        }
    }

    // Offers the declarations of every rule of `sheet` that matches `el`.
    fn consider(self: *mut Self, sheet: *Sheet, el: NodeId, author: bool) AllocError!void {
        let complexes = sheet.complexes.items()
        let decls = sheet.decls.items()
        var index = &mut self.out.ua_index
        if author {
            index = &mut self.out.author_index
        } else if sheet == &self.out.quirks {
            index = &mut self.out.quirks_index
        }
        let candidates = try index.candidates(sheet, self.doc, el)
        var previous: ?usize = null
        for ri in candidates {
            if previous == ri {
                continue
            }
            previous = ri
            let r = sheet.rules.items()[ri]
            var matched = false
            var spec: u32 = 0
            for k in r.sel_start..r.sel_end {
                let cx = complexes[k]
                if (!matched || cx.spec > spec) && matchesComplex(sheet, self.doc, cx, el) {
                    matched = true
                    if cx.spec > spec {
                        spec = cx.spec
                    }
                }
            }
            if !matched {
                continue
            }
            for k in r.decl_start..r.decl_end {
                let d = decls[k]
                var level: u8 = 1
                if author && d.important {
                    level = 4
                } else if author {
                    level = 2
                } else if d.important {
                    level = 6
                }
                try self.offer(d, level, spec)
            }
        }
    }

    // Offers the declarations of the rules of `sheet` that select
    // the pseudo-element `pseudo` of `el`; whether one did.
    fn considerPseudo(self: *mut Self, sheet: *Sheet, el: NodeId, author: bool, pseudo: u8) AllocError!bool {
        let complexes = sheet.complexes.items()
        let decls = sheet.decls.items()
        var any = false
        var index = &mut self.out.ua_index
        if author {
            index = &mut self.out.author_index
        }
        let candidates = try index.candidates(sheet, self.doc, el)
        var previous: ?usize = null
        for ri in candidates {
            if previous == ri {
                continue
            }
            previous = ri
            let r = sheet.rules.items()[ri]
            var matched = false
            var spec: u32 = 0
            for k in r.sel_start..r.sel_end {
                let cx = complexes[k]
                if (!matched || cx.spec > spec) && matchesPseudo(sheet, self.doc, cx, el, pseudo) {
                    matched = true
                    if cx.spec > spec {
                        spec = cx.spec
                    }
                }
            }
            if !matched {
                continue
            }
            any = true
            for k in r.decl_start..r.decl_end {
                let d = decls[k]
                var level: u8 = 1
                if author && d.important {
                    level = 4
                } else if author {
                    level = 2
                } else if d.important {
                    level = 6
                }
                try self.offer(d, level, spec)
            }
        }
        return any
    }

    // `d` wins its property unless an earlier declaration has a higher
    // level, or the same level and a higher specificity.
    fn offer(self: *mut Self, d: Decl, level: u8, spec: u32) AllocError!void {
        if d.prop == CUSTOM {
            return self.offerCustom(d, level, spec)
        }
        let w = self.wins[d.prop]
        if !w.set || level > w.level || (level == w.level && spec >= w.spec) {
            self.wins[d.prop] = Win { set: true, level: level, spec: spec, d: d }
        }
    }

    fn offerCustom(self: *mut Self, d: Decl, level: u8, spec: u32) AllocError!void {
        let win = CustomWin { name: d.name, raw: d.raw, level: level, spec: spec }
        if self.custom_index.get(d.name) |i| {
            let w = self.custom_wins.items()[i]
            if level > w.level || (level == w.level && spec >= w.spec) {
                self.custom_wins.items()[i] = win
            }
            return
        }
        try self.custom_index.put(d.name, self.custom_wins.len())
        try self.custom_wins.append(win)
    }

    // The custom properties of an element (or pseudo-element): its own
    // over those it inherits.
    fn customLevel(self: *mut Self, inherited: ?*mut CustomLevel) AllocError!void {
        self.level = inherited
        if self.custom_wins.len() > 0 {
            let a = self.out.arena.allocator()
            let lvl = try a.create(CustomLevel { parent: inherited, vars: StrMap(CustomVar).init(a) })
            for w in self.custom_wins.items() {
                try lvl.vars.put(w.name, CustomVar { raw: w.raw, state: 0, value: []Token{} })
            }
            self.level = lvl
        }
    }

    // The value of a declaration kept as tokens: `var()` substituted, then
    // parsed (math functions see the calc context); `unset` when invalid.
    fn pending(self: *mut Self, p: usize, d: Decl) AllocError!Value {
        var toks = d.raw
        if hasVar(toks) {
            toks = (try substituteVars(self.out.arena.allocator(), toks, self.level, 0)) orelse return Value.Unset
        }
        let sheet = &mut self.out.inline
        let comps = try components(sheet, toks)
        if comps.len == 0 {
            return Value.Unset
        }
        if d.name.len > 0 {
            return (try shorthandValue(sheet, d.name, comps, p)) orelse Value.Unset
        }
        return (try parseValue(sheet, p, comps)) orelse Value.Unset
    }

    // The computed values of `el` from the winning declarations.
    fn compute(self: *mut Self, el: NodeId) AllocError!void {
        var parent = self.out.initial
        var is_root = true
        var inherited: ?*mut CustomLevel = null
        if parentElement(self.doc, el) |p| {
            if self.out.map.get(p.index) |pv| {
                parent = pv
                is_root = false
            }
            inherited = self.out.customs.get(p.index)
        }
        try self.customLevel(inherited)
        if self.level |l| {
            try self.out.customs.put(el.index, l)
        }
        let values = try self.computeValues(parent, is_root)
        try self.alignCenter(el, values)
        try self.out.map.put(el.index, values)
    }

    // The computed values of the pseudo-element `pseudo` of `el` from the
    // winning declarations, kept when its `content` makes a box.
    fn computePseudo(self: *mut Self, el: NodeId, pseudo: u8) AllocError!void {
        let parent = self.out.map.get(el.index) orelse return
        try self.customLevel(self.out.customs.get(el.index))
        let values = try self.computeValues(parent, false)
        let content = keywordText(values[CONTENT])
        if content.len == 0 || text.eql(content, "normal") || text.eql(content, "none") {
            return
        }
        if pseudo == 1 {
            try self.out.before.put(el.index, values)
        } else {
            try self.out.after.put(el.index, values)
        }
    }

    // The computed values from the winning declarations, inheriting from
    // `parent`.
    fn computeValues(self: *mut Self, parent: []Value, is_root: bool) AllocError![]mut Value {
        let values = try self.out.arena.allocator().alloc(Value.Initial, NPROPS)
        // font-size first: the other lengths are relative to it.
        let parent_font = numberOr(parent[FONT_SIZE], 16.0)
        if is_root {
            // `rem` on the root element refers to the initial font size.
            self.root_font = 16.0
        }
        let vw = self.media.width / 100.0
        let vh = self.media.height / 100.0
        setCalcContext(parent_font, self.root_font, vw, vh, parent_font)
        var font = try self.specified(FONT_SIZE, parent)
        match font {
            .Keyword { k } => {
                if text.eql(k, "larger") {
                    font = Value.Px { v: parent_font * 1.2 }
                } else {
                    font = Value.Px { v: parent_font / 1.2 }
                }
            }
            .Percent { v } => {
                font = Value.Px { v: parent_font * v / 100.0 }
            }
            _ => {}
        }
        values[FONT_SIZE] = self.absolute(font, parent_font)
        let font_px = numberOr(values[FONT_SIZE], 16.0)
        if is_root {
            self.root_font = font_px
        }
        for p in 0..NPROPS {
            if p == FONT_SIZE {
                continue
            }
            if p == LINE_HEIGHT {
                setCalcContext(font_px, self.root_font, vw, vh, font_px)
            } else {
                setCalcContext(font_px, self.root_font, vw, vh, -1.0)
            }
            var v = try self.specified(p, parent)
            if p == COLOR && isCurrentColor(v) {
                v = parent[COLOR]
            } else if p == FONT_WEIGHT {
                v = relativeWeight(v, numberOr(parent[FONT_WEIGHT], 400.0))
            } else if p == LINE_HEIGHT {
                match v {
                    .Percent { v: pct } => {
                        v = Value.Px { v: font_px * pct / 100.0 }
                    }
                    _ => {}
                }
            }
            values[p] = self.absolute(v, font_px)
        }
        fixBorderWidths(values)
        return values
    }

    // `<center>` and `align=center`: a block-level child in flow gets auto
    // side margins (unless it has margins of its own): a table or a box
    // narrower than the line (`width`, `max-width`) is centered, an
    // auto-width block keeps its full width. The alignment passes on to
    // descendants until something sets another alignment.
    fn alignCenter(self: *mut Self, el: NodeId, values: []mut Value) AllocError!void {
        var parent_centers = false
        if parentElement(self.doc, el) |p| {
            parent_centers = self.centered.contains(p.index)
        }
        let display = keywordText(values[DISPLAY])
        if parent_centers && (text.eql(display, "block") || text.eql(display, "table")) && text.eql(keywordText(values[FLOAT]), "none") && !text.eql(keywordText(values[POSITION]), "absolute") && !text.eql(keywordText(values[POSITION]), "fixed") && isZeroPx(values[MARGIN_TOP + 1]) && isZeroPx(values[MARGIN_TOP + 3]) {
            values[MARGIN_TOP + 1] = Value.Keyword { k: "auto" }
            values[MARGIN_TOP + 3] = Value.Keyword { k: "auto" }
        }
        let name = self.doc.node(el).name
        var centers = false
        if !text.eql(keywordText(values[TEXT_ALIGN]), "center") {
            centers = false
        } else if text.eql(name, "center") {
            centers = true
        } else if self.doc.attr(el, "align") |a| {
            let v = text.trim(a)
            centers = text.eqlIgnoreCase(v, "center") || text.eqlIgnoreCase(v, "middle")
        } else {
            centers = parent_centers
        }
        if centers {
            try self.centered.put(el.index, true)
        }
    }

    // The winning value of `p`, with `inherit`, `initial` and `unset`
    // resolved (to the parent's computed value or the initial value).
    fn specified(self: *mut Self, p: usize, parent: []Value) AllocError!Value {
        var v = Value.Unset
        if self.wins[p].set {
            let d = self.wins[p].d
            if d.raw.len > 0 {
                v = try self.pending(p, d)
            } else {
                v = d.value
            }
        }
        let inherited = PROPERTIES[p].inherited
        return match v {
            .Inherit => parent[p]
            .Initial => PROPERTIES[p].initial
            .Unset => unsetValue(inherited, parent[p], PROPERTIES[p].initial)
            _ => v
        }
    }

    // `v` with relative lengths in px (`em` is `font` px).
    fn absolute(self: *Self, v: Value, font: f64) Value {
        return match v {
            .Em { v: n } => Value.Px { v: n * font }
            .Rem { v: n } => Value.Px { v: n * self.root_font }
            .Vw { v: n } => Value.Px { v: n * self.media.width / 100.0 }
            .Vh { v: n } => Value.Px { v: n * self.media.height / 100.0 }
            _ => v
        }
    }
}

fn keywordText(v: Value) []u8 {
    return match v {
        .Keyword { k } => k
        _ => ""
    }
}

fn isZeroPx(v: Value) bool {
    return match v {
        .Px { v: n } => n == 0.0
        _ => false
    }
}

fn unsetValue(inherited: bool, from_parent: Value, initial: Value) Value {
    if inherited {
        return from_parent
    }
    return initial
}

fn isCurrentColor(v: Value) bool {
    return match v {
        .CurrentColor => true
        _ => false
    }
}

// The number of a `Px` or `Number` value, else `fallback`.
fn numberOr(v: Value, fallback: f64) f64 {
    return match v {
        .Px { v: n } => n
        .Number { v: n } => n
        _ => fallback
    }
}

// `bolder` and `lighter` from the parent's weight (CSS Fonts 4, 2.2).
fn relativeWeight(v: Value, parent: f64) Value {
    var k: []u8 = ""
    match v {
        .Keyword { k: word } => {
            k = word
        }
        _ => {
            return v
        }
    }
    var w = parent
    if text.eql(k, "bolder") {
        if parent < 350.0 {
            w = 400.0
        } else if parent < 550.0 {
            w = 700.0
        } else {
            w = 900.0
        }
    } else if parent < 100.0 {
        w = parent
    } else if parent < 550.0 {
        w = 100.0
    } else if parent < 750.0 {
        w = 400.0
    } else {
        w = 700.0
    }
    return Value.Number { v: w }
}

// A border whose style is `none` or `hidden` has width 0.
fn fixBorderWidths(values: []mut Value) {
    for side in 0..4 {
        match values[BORDER_TOP_STYLE + side] {
            .Keyword { k } => {
                if text.eql(k, "none") || text.eql(k, "hidden") {
                    values[BORDER_TOP_WIDTH + side] = Value.Px { v: 0.0 }
                }
            }
            _ => {}
        }
    }
}

// ---- writing values

/// Appends the CSS text of the computed value `v`: `12px`, `50%`, `700`,
/// `rgb(255, 0, 0)`, `rgba(0, 0, 0, 0.5)`, a keyword.
pub fn writeValue(v: Value, out: *mut text.Builder) AllocError!void {
    match v {
        .Keyword { k } => {
            try out.append(k)
        }
        .Px { v: n } => {
            try writeNumber(n, out)
            try out.append("px")
        }
        .Em { v: n } => {
            try writeNumber(n, out)
            try out.append("em")
        }
        .Rem { v: n } => {
            try writeNumber(n, out)
            try out.append("rem")
        }
        .Vw { v: n } => {
            try writeNumber(n, out)
            try out.append("vw")
        }
        .Vh { v: n } => {
            try writeNumber(n, out)
            try out.append("vh")
        }
        .Percent { v: n } => {
            try writeNumber(n, out)
            try out.append("%")
        }
        .Number { v: n } => {
            try writeNumber(n, out)
        }
        .Calc { pct, px } => {
            try out.append("calc(")
            try writeNumber(pct, out)
            if px < 0.0 {
                try out.append("% - ")
                try writeNumber(-px, out)
            } else {
                try out.append("% + ")
                try writeNumber(px, out)
            }
            try out.append("px)")
        }
        .Rgba { c } => {
            if c.a >= 1.0 {
                try out.append("rgb(")
            } else {
                try out.append("rgba(")
            }
            try out.appendUint(c.r as u64)
            try out.append(", ")
            try out.appendUint(c.g as u64)
            try out.append(", ")
            try out.appendUint(c.b as u64)
            if c.a < 1.0 {
                try out.append(", ")
                try writeNumber(c.a, out)
            }
            try out.append(")")
        }
        .CurrentColor => {
            try out.append("currentcolor")
        }
        .Inherit => {
            try out.append("inherit")
        }
        .Initial => {
            try out.append("initial")
        }
        .Unset => {
            try out.append("unset")
        }
    }
}

/// Appends `n` rounded to two decimals, without trailing zeros.
pub fn writeNumber(n: f64, out: *mut text.Builder) AllocError!void {
    var hundredths = math.round(n * 100.0) as i64
    if hundredths < 0 {
        try out.appendByte('-')
        hundredths = -hundredths
    }
    try out.appendInt(hundredths / 100)
    let frac = hundredths % 100
    if frac != 0 {
        try out.appendByte('.')
        try out.appendInt(frac / 10)
        if frac % 10 != 0 {
            try out.appendInt(frac % 10)
        }
    }
}

/// Are two computed values the same?
pub fn sameValue(a: Value, b: Value) bool {
    return tagOf(a) == tagOf(b) && numberOf(a) == numberOf(b) && calcPxOf(a) == calcPxOf(b) && text.eql(keywordOf(a), keywordOf(b)) && sameColor(colorOf(a), colorOf(b))
}

fn calcPxOf(v: Value) f64 {
    return match v {
        .Calc { px, .. } => px
        _ => 0.0
    }
}

fn tagOf(v: Value) u8 {
    return match v {
        .Keyword { .. } => 1
        .Px { .. } => 2
        .Em { .. } => 3
        .Rem { .. } => 4
        .Vw { .. } => 5
        .Vh { .. } => 6
        .Percent { .. } => 7
        .Number { .. } => 8
        .Rgba { .. } => 9
        .Calc { .. } => 14
        .CurrentColor => 10
        .Inherit => 11
        .Initial => 12
        .Unset => 13
    }
}

fn numberOf(v: Value) f64 {
    return match v {
        .Calc { pct, .. } => pct
        .Px { v: n } => n
        .Em { v: n } => n
        .Rem { v: n } => n
        .Vw { v: n } => n
        .Vh { v: n } => n
        .Percent { v: n } => n
        .Number { v: n } => n
        _ => 0.0
    }
}

fn keywordOf(v: Value) []u8 {
    return match v {
        .Keyword { k } => k
        _ => ""
    }
}

fn colorOf(v: Value) Color {
    return match v {
        .Rgba { c } => c
        _ => Color { r: 0, g: 0, b: 0, a: 0.0 }
    }
}

fn sameColor(a: Color, b: Color) bool {
    return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a
}
