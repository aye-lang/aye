// What the computed styles of a document depend on besides its sheets,
// as one number (`styleInputs`). When it is the same, computing the
// styles again with the same sheets gives the same styles, so the engine
// keeps the ones it has (engine.ore `Page.restyle`, geometry.ore). It
// covers:
// - every node of the document's tree and of its shadow trees, in
//   shadow-including order: its handle, kind, name, namespace, parent,
//   attributes, text (of a script, whether it is empty), custom element
//   state, shadow root and slot;
// - of a `class` attribute, only the classes a selector of the sheets
//   names (`ClassInfo`) and whether each attribute selector on
//   `class` matches it (on the elements of the type it is for): a class
//   that no rule names changes no style;
// - the state of the form controls and the focus, the rules scripts
//   gave the sheets (their generation) and the sheets they adopted,
//   quirks mode;
// - the viewport and the container sizes the styles were computed with.
// It is a fingerprint, not a version: it also sees the changes that no
// counter records (the agent opening a `details`, typing into a field).

import dom
import dom.Document
import dom.Kind
import dom.NodeId
import std.list.List
import std.map.IntMap
import std.mem.AllocError
import std.mem.Allocator
import std.text

/// An attribute selector on `class` (`ClassInfo.tests`), and the type of
/// element it can make a difference for ("": any).
pub struct ClassTest {
    selector: Simple
    type_name: []u8
}

/// What the selectors of a sheet look at of `class` (`Sheet.class_info`):
/// the classes they name and their attribute selectors on `class`. Made
/// again when the sheet grew since.
pub struct ClassInfo {
    alloc: Allocator
    // `classKey` of each class a selector names.
    keys: IntMap(u64, bool)
    // Each once.
    tests: List(ClassTest)
    // The sheet's numbers of simple selectors and compounds when made.
    simples: usize
    compounds: usize
    ready: bool

    pub fn init(alloc: Allocator) ClassInfo {
        return ClassInfo { alloc: alloc, keys: IntMap(u64, bool).init(alloc), tests: List(ClassTest).init(alloc), simples: 0, compounds: 0, ready: false }
    }

    pub fn deinit(self: *mut Self) {
        self.keys.deinit()
        self.tests.deinit()
    }
}

/// Adds the `ClassInfo` of `sheet` and of its shadow trees' sheets to
/// `out.class_infos` (made first when needed).
pub fn noteClasses(sheet: *Sheet, out: *mut Styles) AllocError!void {
    let info = sheet.class_info
    if !info.ready || info.simples != sheet.simples.len() || info.compounds != sheet.compounds.len() {
        try buildClassInfo(sheet, info)
    }
    try out.class_infos.append(info)
    for sc in sheet.scoped.items() {
        try noteClasses(sc.sheet, out)
    }
}

fn buildClassInfo(sheet: *Sheet, info: *mut ClassInfo) AllocError!void {
    info.ready = false
    info.keys.deinit()
    info.keys = IntMap(u64, bool).init(info.alloc)
    info.tests.clear()
    let simples = sheet.simples.items()
    var tests: usize = 0
    for s in simples {
        if s.kind == SelKind.Class {
            try info.keys.put(classKey(s.name), true)
        } else if isClassTest(s) {
            tests += 1
        }
    }
    if tests > 0 {
        var types = try compoundTypes(sheet, info.alloc)
        defer types.deinit()
        var placed: usize = 0
        for ci, comp in sheet.compounds.items() {
            for si in comp.start..comp.end {
                if isClassTest(simples[si]) {
                    placed += 1
                    try addClassTest(info, simples[si], types.items()[ci])
                }
            }
        }
        if placed != tests {
            // Some are in no compound: they count for every element.
            for s in simples {
                if isClassTest(s) {
                    try addClassTest(info, s, "")
                }
            }
        }
    }
    info.simples = simples.len
    info.compounds = sheet.compounds.len()
    info.ready = true
}

fn isClassTest(s: Simple) bool {
    return s.kind == SelKind.Attr && text.eql(s.name, "class")
}

fn addClassTest(info: *mut ClassInfo, s: Simple, type_name: []u8) AllocError!void {
    for t in info.tests.items() {
        if t.selector.op == s.op && t.selector.ci == s.ci && text.eql(t.selector.value, s.value) && text.eql(t.type_name, type_name) {
            return
        }
    }
    try info.tests.append(ClassTest { selector: s, type_name: type_name })
}

// The type each compound of `sheet` needs its element to be ("": any):
// that of its own type selector, else that of the compound whose `:is()`
// or `:not()` argument it is the subject of (the same element), when it
// is the subject of no other argument and of no rule's selector.
fn compoundTypes(sheet: *Sheet, alloc: Allocator) AllocError!List([]u8) {
    let compounds = sheet.compounds.items()
    let complexes = sheet.complexes.items()
    let simples = sheet.simples.items()
    // 0: not reached (yet); 1: `given` is the type of its context; 2: any.
    var state = List(u8).init(alloc)
    defer state.deinit()
    var given = List([]u8).init(alloc)
    defer given.deinit()
    for c in compounds {
        try state.append(0)
        try given.append("")
    }
    for r in sheet.rules.items() {
        for k in r.sel_start..r.sel_end {
            anyCompounds(complexes[k], state.items(), true)
        }
    }
    for s in simples {
        let same = s.kind == SelKind.Is || s.kind == SelKind.Not
        for k in s.sub_start..s.sub_end {
            anyCompounds(complexes[k], state.items(), !same)
        }
    }
    var changed = true
    var passes: usize = 0
    while changed && passes < 32 {
        changed = false
        passes += 1
        for ci, comp in compounds {
            var t = ownType(simples, comp)
            if t.len == 0 {
                if state.items()[ci] == 0 {
                    continue
                }
                t = given.items()[ci]
            }
            for si in comp.start..comp.end {
                let s = simples[si]
                if s.kind != SelKind.Is && s.kind != SelKind.Not {
                    continue
                }
                for k in s.sub_start..s.sub_end {
                    let cx = complexes[k]
                    if cx.end > cx.start && giveType(state.items(), given.items(), cx.end - 1, t) {
                        changed = true
                    }
                }
            }
        }
    }
    var out = List([]u8).init(alloc)
    errdefer out.deinit()
    for ci, comp in compounds {
        var t = ownType(simples, comp)
        if t.len == 0 && !changed && state.items()[ci] == 1 {
            t = given.items()[ci]
        }
        try out.append(t)
    }
    return out
}

// Marks the compounds of `cx` as any element's: all of them when `all`,
// else those before its subject (other elements than the context's).
fn anyCompounds(cx: Complex, state: []mut u8, all: bool) {
    var end = cx.end
    if !all && end > cx.start {
        end -= 1
    }
    for c in cx.start..end {
        state[c] = 2
    }
}

// The context of the compound `c` has the type `t` ("": any); whether
// that changed what `c` is known to be.
fn giveType(state: []mut u8, given: []mut []u8, c: usize, t: []u8) bool {
    if state[c] == 2 {
        return false
    }
    if t.len == 0 || (state[c] == 1 && !text.eql(given[c], t)) {
        state[c] = 2
        return true
    }
    if state[c] == 0 {
        state[c] = 1
        given[c] = t
        return true
    }
    return false
}

fn ownType(simples: []Simple, comp: Compound) []u8 {
    for si in comp.start..comp.end {
        if simples[si].kind == SelKind.Type {
            return simples[si].name
        }
    }
    return ""
}

/// The fingerprint of what the styles `styles` of `doc` for `media`
/// depend on besides the sheets (never 0).
pub fn styleInputs(doc: *Document, media: Media, styles: *Styles) u64 {
    var h = inputWord(INPUT_SEED, @hash(media.width))
    h = inputWord(h, @hash(media.height))
    var cur: ?NodeId = doc.root
    while cur |n| {
        h = inputNode(doc, styles, n, h)
        cur = dom.shadowIncludingFollowing(doc, n, doc.root)
    }
    let ctl = &doc.controls
    h = inputNodeId(h, ctl.focus)
    h = inputNodeId(h, ctl.validation)
    h = inputWord(h, inputBit(ctl.focus_visible))
    // The controls in any order: a sum of their own fingerprints.
    var controls: u64 = 0
    var it = ctl.map.iterator()
    while it.next() |e| {
        let c = e.value
        var x = inputWord(INPUT_SEED, e.key as u64)
        x = inputWord(x, c.generation as u64)
        x = inputText(x, c.value)
        x = inputText(x, c.custom)
        x = inputWord(x, inputBit(c.dirty) | (inputBit(c.checked) << 1) | (inputBit(c.checked_dirty) << 2) | (inputBit(c.selected) << 3) | (inputBit(c.selected_dirty) << 4))
        controls = controls +% x
    }
    h = inputWord(h, controls)
    h = inputWord(h, ctl.map.len() as u64)
    h = inputWord(h, doc.sheets.generation)
    for ad in doc.adopted.items() {
        h = inputNodeId(h, ad.root)
        h = inputText(h, ad.css)
    }
    h = inputWord(h, inputBit(doc.quirks))
    var sizes: u64 = 0
    var sit = styles.sizes.iterator()
    while sit.next() |e| {
        var x = inputWord(INPUT_SEED, e.key as u64)
        x = inputWord(x, e.value.generation as u64)
        x = inputWord(x, @hash(e.value.w))
        x = inputWord(x, @hash(e.value.h))
        sizes = sizes +% x
    }
    h = inputWord(h, sizes)
    h = inputWord(h, styles.sizes.len() as u64)
    if h == 0 {
        return 1
    }
    return h
}

let INPUT_SEED: u64 = 14695981039346656037

// The key of the class `name` in `ClassInfo.keys`: FNV-1a of it in
// lower case (quirks mode matches classes ignoring case).
fn classKey(name: []u8) u64 {
    var h = INPUT_SEED
    for b in name {
        var c = b
        if c >= 'A' && c <= 'Z' {
            c += 32
        }
        h = (h ^ (c as u64)) *% 1099511628211
    }
    return h
}

fn inputNode(doc: *Document, styles: *Styles, n: NodeId, seed: u64) u64 {
    let node = doc.node(n)
    var h = inputWord(seed, inputId(n))
    h = inputWord(h, @hash(node.kind) ^ ((node.ns as u64) | ((node.ce as u64) << 8)))
    h = inputWord(h, inputOptId(node.parent))
    h = inputWord(h, inputOptId(node.shadow) ^ (inputOptId(node.slot) *% 0x9E3779B97F4A7C15))
    h = inputText(h, node.name)
    if node.kind != Kind.Element {
        if node.parent |up| {
            if doc.isElement(up, "script") {
                // Only `:empty` sees a script's text.
                return inputWord(h, inputBit(node.data.len > 0))
            }
        }
        return inputText(h, node.data)
    }
    var count: u64 = 0
    for at in node.attrs {
        if text.eql(at.name, "class") {
            continue
        }
        h = inputText(h, at.name)
        h = inputText(h, at.value)
        count += 1
    }
    h = inputWord(h, count)
    // The class attribute, present or not, as the selectors see it.
    h = inputClasses(h, doc.attr(n, "class") orelse "", styles)
    for info in styles.class_infos.items() {
        for t in info.tests.items() {
            if t.type_name.len == 0 || text.eql(node.name, t.type_name) {
                h = inputWord(h, inputBit(attrMatches(doc, t.selector, n)))
            }
        }
    }
    return h
}

// The classes of the `class` attribute `list` that a selector names.
fn inputClasses(seed: u64, list: []u8, styles: *Styles) u64 {
    var h = seed
    var i: usize = 0
    while i < list.len {
        while i < list.len && inputSpace(list[i]) {
            i += 1
        }
        let start = i
        while i < list.len && !inputSpace(list[i]) {
            i += 1
        }
        if i > start {
            let key = classKey(list[start..i])
            for info in styles.class_infos.items() {
                if info.keys.contains(key) {
                    // As written: outside quirks mode `.on` does not
                    // match "On".
                    h = inputText(h, list[start..i])
                    break
                }
            }
        }
    }
    return h
}

fn inputSpace(c: u8) bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\x0C'
}

fn inputNodeId(h: u64, n: ?NodeId) u64 {
    return inputWord(h, inputOptId(n))
}

fn inputId(n: NodeId) u64 {
    return ((n.generation as u64) << 32) | (n.index as u64)
}

// A node's handle, or 0 for none.
fn inputOptId(n: ?NodeId) u64 {
    if n |v| {
        return inputId(v) +% 1
    }
    return 0
}

fn inputBit(b: bool) u64 {
    if b {
        return 1
    }
    return 0
}

fn inputText(seed: u64, s: []u8) u64 {
    var h = inputWord(seed, s.len as u64)
    for b in s {
        h = (h ^ (b as u64)) *% 1099511628211
    }
    return h
}

// Mixes the word `w` into `h` (the SplitMix64 finalizer of their xor).
fn inputWord(h: u64, w: u64) u64 {
    var x = h ^ w
    x = (x ^ (x >> 30)) *% 0xBF58476D1CE4E5B9
    x = (x ^ (x >> 27)) *% 0x94D049BB133111EB
    return x ^ (x >> 31)
}
