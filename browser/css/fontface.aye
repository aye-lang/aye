// `@font-face` rules (CSS Fonts 4, 4): `font-family`, `src` (`url()`
// with `format()`; `local()` is skipped), `font-weight` (a weight or a
// range), `font-style` and `unicode-range`, into `Sheet.font_faces` for
// the loader (engine/fonts.aye). They are read from the sheet's text,
// since `unicode-range` values (`U+4E00-9FFF`) do not survive the
// tokenizer; rules inside `@media` and `@supports` blocks count whatever
// their condition.

import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text

/// A source of an `@font-face` rule: its URL as written and its
/// `format()` in lower case ("" when there is none).
pub struct FontSrc {
    url: []u8
    format: []u8
}

/// An `@font-face` rule.
pub struct FontFace {
    family: []u8
    srcs: []FontSrc
    weight_lo: f64
    weight_hi: f64
    italic: bool
    // `unicode-range`: pairs of code points (first, last); empty for all.
    ranges: []u32
    // The URL of the sheet, which `srcs` are relative to (set by the
    // loader; "" until then).
    base: []u8
}

/// Appends the `@font-face` rules of the sheet text `text_in` to
/// `sheet.font_faces` (their strings in the sheet's arena).
fn fontFaceRules(sheet: *mut Sheet, text_in: []u8) AllocError!void {
    if !hasFontFace(text_in) {
        return
    }
    let a = sheet.arena.allocator()
    let src = try a.alloc(0 as u8, text_in.len)
    for k, ch in text_in {
        src[k] = ch
    }
    var i: usize = 0
    while i < src.len {
        let c = src[i]
        if c == '/' && i + 1 < src.len && src[i + 1] == '*' {
            i = skipComment(src, i)
        } else if c == '"' || c == '\'' {
            i = skipString(src, i)
        } else if c == '@' && i + 10 <= src.len && text.eqlIgnoreCase(src[i + 1..i + 10], "font-face") {
            var open = i + 10
            while open < src.len && src[open] != '{' && src[open] != ';' {
                open += 1
            }
            if open >= src.len || src[open] == ';' {
                i = open
                continue
            }
            let close = blockClose(src, open)
            if try fontFace(a, src[open + 1..close]) |face| {
                try sheet.font_faces.append(face)
            }
            i = close
        } else {
            i += 1
        }
    }
}

fn hasFontFace(s: []u8) bool {
    var i: usize = 0
    while i + 10 <= s.len {
        if s[i] == '@' && text.eqlIgnoreCase(s[i + 1..i + 10], "font-face") {
            return true
        }
        i += 1
    }
    return false
}

// The `@font-face` rule with the declarations `body`; null without a
// family or a usable source.
fn fontFace(a: Allocator, body: []u8) AllocError!?FontFace {
    var face = FontFace { family: "", srcs: []FontSrc{}, weight_lo: 400.0, weight_hi: 400.0, italic: false, ranges: []u32{}, base: "" }
    var decls = List([]u8).init(a)
    try splitTop(a, body, ';', &mut decls)
    for d in decls.items() {
        let colon = text.indexOf(d, ":") orelse continue
        let name = text.trim(d[..colon])
        let value = text.trim(stripImportant(d[colon + 1..]))
        if text.eqlIgnoreCase(name, "font-family") {
            face.family = unquote(value)
        } else if text.eqlIgnoreCase(name, "src") {
            face.srcs = try sources(a, value)
        } else if text.eqlIgnoreCase(name, "font-weight") {
            var words = List([]u8).init(a)
            try splitTop(a, value, ' ', &mut words)
            if words.len() >= 1 {
                face.weight_lo = weightOf(words.items()[0])
                face.weight_hi = face.weight_lo
            }
            if words.len() >= 2 {
                face.weight_hi = weightOf(words.items()[1])
            }
        } else if text.eqlIgnoreCase(name, "font-style") {
            face.italic = text.startsWith(value, "italic") || text.startsWith(value, "oblique")
        } else if text.eqlIgnoreCase(name, "unicode-range") {
            face.ranges = try unicodeRanges(a, value)
        }
    }
    if face.family.len == 0 || face.srcs.len == 0 {
        return null
    }
    return face
}

// The `url()` sources of a `src` value, with their formats.
fn sources(a: Allocator, value: []u8) AllocError![]FontSrc {
    var parts = List([]u8).init(a)
    try splitTop(a, value, ',', &mut parts)
    var out = List(FontSrc).init(a)
    for part in parts.items() {
        let p = text.trim(part)
        if p.len < 4 || !text.eqlIgnoreCase(p[..4], "url(") {
            continue
        }
        let close = text.indexOf(p, ")") orelse continue
        let address = unquote(text.trim(p[4..close]))
        var format: []u8 = ""
        if text.indexOf(p[close..], "format(") |f| {
            let rest = p[close + f + 7..]
            let end = text.indexOf(rest, ")") orelse rest.len
            let lower = try a.alloc(0 as u8, end)
            let name = unquote(text.trim(rest[..end]))
            for k, ch in name {
                lower[k] = ch
            }
            text.toLower(lower[..name.len])
            format = lower[..name.len]
        }
        if address.len > 0 {
            try out.append(FontSrc { url: address, format: format })
        }
    }
    return out.items()
}

fn weightOf(w: []u8) f64 {
    if text.eqlIgnoreCase(w, "bold") || text.eqlIgnoreCase(w, "bolder") {
        return 700.0
    }
    if text.eqlIgnoreCase(w, "normal") || text.eqlIgnoreCase(w, "lighter") {
        return 400.0
    }
    let n = text.parseFloat(w) catch |e| {
        return 400.0
    }
    if n < 1.0 || n > 1000.0 {
        return 400.0
    }
    return n
}

// `unicode-range` (CSS Fonts 4, 4.5): `U+26`, `U+0-7F`, `U+4??`.
fn unicodeRanges(a: Allocator, value: []u8) AllocError![]u32 {
    var parts = List([]u8).init(a)
    try splitTop(a, value, ',', &mut parts)
    var out = List(u32).init(a)
    for part in parts.items() {
        let p = text.trim(part)
        if p.len < 3 || (p[0] != 'U' && p[0] != 'u') || p[1] != '+' {
            continue
        }
        let body = p[2..]
        var lo: u32 = 0
        var hi: u32 = 0
        if text.indexOf(body, "-") |dash| {
            let first = hexOf(body[..dash]) orelse continue
            let last = hexOf(body[dash + 1..]) orelse continue
            lo = first
            hi = last
        } else {
            // Wildcards: `?` is any hex digit.
            var low_text = List(u8).init(a)
            var high_text = List(u8).init(a)
            for ch in body {
                if ch == '?' {
                    try low_text.append('0')
                    try high_text.append('F')
                } else {
                    try low_text.append(ch)
                    try high_text.append(ch)
                }
            }
            let first = hexOf(low_text.items()) orelse continue
            let last = hexOf(high_text.items()) orelse continue
            lo = first
            hi = last
        }
        if lo <= hi && hi <= 0x10FFFF {
            try out.append(lo)
            try out.append(hi)
        }
    }
    return out.items()
}

fn hexOf(s: []u8) ?u32 {
    if s.len == 0 || s.len > 6 {
        return null
    }
    var v: u32 = 0
    for c in s {
        var d: u32 = 0
        if c >= '0' && c <= '9' {
            d = (c - '0') as u32
        } else if c >= 'a' && c <= 'f' {
            d = (c - 'a') as u32 + 10
        } else if c >= 'A' && c <= 'F' {
            d = (c - 'A') as u32 + 10
        } else {
            return null
        }
        v = v * 16 + d
    }
    return v
}

fn unquote(s: []u8) []u8 {
    if s.len >= 2 && (s[0] == '"' || s[0] == '\'') && s[s.len - 1] == s[0] {
        return s[1..s.len - 1]
    }
    return s
}

fn stripImportant(s: []u8) []u8 {
    if text.indexOf(s, "!") |bang| {
        return s[..bang]
    }
    return s
}

// Splits `s` at `sep` outside strings, parentheses and comments into
// `out` (the parts not trimmed; empty ones dropped).
fn splitTop(a: Allocator, s: []u8, sep: u8, out: *mut List([]u8)) AllocError!void {
    var depth: usize = 0
    var start: usize = 0
    var i: usize = 0
    while i < s.len {
        let c = s[i]
        if c == '"' || c == '\'' {
            i = skipString(s, i)
            continue
        }
        if c == '/' && i + 1 < s.len && s[i + 1] == '*' {
            i = skipComment(s, i)
            continue
        }
        if c == '(' {
            depth += 1
        } else if c == ')' && depth > 0 {
            depth -= 1
        } else if c == sep && depth == 0 {
            if text.trim(s[start..i]).len > 0 {
                try out.append(s[start..i])
            }
            start = i + 1
        }
        i += 1
    }
    if text.trim(s[start..]).len > 0 {
        try out.append(s[start..])
    }
}

// The index after the string that starts at `i`.
fn skipString(s: []u8, i: usize) usize {
    let q = s[i]
    var j = i + 1
    while j < s.len && s[j] != q && s[j] != '\n' {
        if s[j] == '\\' {
            j += 1
        }
        j += 1
    }
    if j < s.len {
        return j + 1
    }
    return s.len
}

// The index after the comment that starts at `i`.
fn skipComment(s: []u8, i: usize) usize {
    if text.indexOf(s[i + 2..], "*/") |e| {
        return i + 2 + e + 2
    }
    return s.len
}

// The index of the `}` that closes the block opened at `open`.
fn blockClose(s: []u8, open: usize) usize {
    var depth: usize = 0
    var i = open
    while i < s.len {
        let c = s[i]
        if c == '"' || c == '\'' {
            i = skipString(s, i)
            continue
        }
        if c == '/' && i + 1 < s.len && s[i + 1] == '*' {
            i = skipComment(s, i)
            continue
        }
        if c == '{' {
            depth += 1
        } else if c == '}' {
            depth -= 1
            if depth == 0 {
                return i
            }
        }
        i += 1
    }
    return s.len
}

test "@font-face rules" {
    var sheet = Sheet.init(@testAllocator()) catch |e| {
        @expect(false)
        return
    }
    defer sheet.deinit()
    let src = "p { color: red } /* @font-face { x } */ @font-face { font-family: 'Material Icons'; font-style: normal; font-weight: 400; src: url(https://f.test/m.ttf) format('truetype'); } @media screen { @FONT-FACE { font-family: Inter; src: local(Inter), url(\"inter.woff2\") format(\"WOFF2\"), url(inter.woff); font-weight: 100 900; font-style: italic; unicode-range: U+0000-00FF, U+0131, U+4??; } } @font-face { src: url(x.ttf) }"
    fontFaceRules(&mut sheet, src) catch |e| {
        @expect(false)
    }
    let faces = sheet.font_faces.items()
    @expectEqual(2, faces.len)
    @expect(text.eql(faces[0].family, "Material Icons"))
    @expectEqual(1, faces[0].srcs.len)
    @expect(text.eql(faces[0].srcs[0].url, "https://f.test/m.ttf"))
    @expect(text.eql(faces[0].srcs[0].format, "truetype"))
    @expect(!faces[0].italic)
    @expectEqual(400.0, faces[0].weight_hi)
    @expect(text.eql(faces[1].family, "Inter"))
    @expectEqual(2, faces[1].srcs.len)
    @expect(text.eql(faces[1].srcs[0].url, "inter.woff2"))
    @expect(text.eql(faces[1].srcs[0].format, "woff2"))
    @expect(text.eql(faces[1].srcs[1].format, ""))
    @expectEqual(100.0, faces[1].weight_lo)
    @expectEqual(900.0, faces[1].weight_hi)
    @expect(faces[1].italic)
    @expectEqual(6, faces[1].ranges.len)
    @expectEqual(0xFF, faces[1].ranges[1])
    @expectEqual(0x131, faces[1].ranges[2])
    @expectEqual(0x400, faces[1].ranges[4])
    @expectEqual(0x4FF, faces[1].ranges[5])
}
