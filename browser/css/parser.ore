// The style sheet parser (CSS Syntax 3, section 5, simplified): a sheet is
// a list of style rules and at-rules. The rules of `@media` blocks whose
// query matches the `Media`, of `@supports` blocks whose condition holds
// and of `@layer` blocks (layer order is ignored) are parsed as if they
// were at the top level. `@import` rules before the first style rule are
// recorded in `Sheet.imports` (with their media and `supports()`
// checked) for the loader to fetch. `@font-face` rules are read from the
// text (fontface.ore). Other at-rules (`@keyframes`, `@container`,
// `@page`, ...) are skipped with their block.
// A rule with an invalid selector is dropped whole; an invalid
// declaration is dropped up to the next `;`. Blocks are matched by their
// bracket kind, so a stray `}` or `)` inside a value cannot end a rule.

import std.list.List
import std.mem
import std.mem.AllocError
import std.text

/// Declarations `start..end` of `Sheet.decls`.
pub struct DeclRange {
    start: usize
    end: usize
}

/// Parses the style sheet `src` and appends its rules to `sheet`.
pub fn parseSheet(sheet: *mut Sheet, src: []u8, media: Media) AllocError!void {
    let toks = try tokens(sheet, src)
    var p = Parser { sheet: sheet, toks: toks, media: media, styled: false }
    try p.rules(0, toks.len, true)
    try fontFaceRules(sheet, src)
}

/// Parses a list of declarations (a `style` attribute) into `sheet` and
/// returns where they are.
pub fn parseInline(sheet: *mut Sheet, src: []u8) AllocError!DeclRange {
    let toks = try tokens(sheet, src)
    var p = Parser { sheet: sheet, toks: toks, media: Media { width: 0.0, height: 0.0 }, styled: false }
    let start = sheet.decls.len()
    try p.declarations(0, toks.len)
    return DeclRange { start: start, end: sheet.decls.len() }
}

/// Does the media query list `query` (a `media` attribute) match? An
/// empty list matches.
pub fn mediaMatches(sheet: *mut Sheet, query: []u8, media: Media) AllocError!bool {
    let toks = try tokens(sheet, query)
    return mediaListMatches(toks, media)
}

// The tokens of a copy of `src` in the sheet's arena.
fn tokens(sheet: *mut Sheet, src: []u8) AllocError![]Token {
    let a = sheet.arena.allocator()
    let copy = try a.alloc(0 as u8, src.len)
    mem.copy(copy, src)
    var list = List(Token).init(a)
    try tokenize(a, copy, &mut list)
    return list.items()
}

// ---- blocks and component values, on a token slice

fn isOpener(k: Tok) bool {
    return k == Tok.LBrace || k == Tok.LBracket || k == Tok.LParen || k == Tok.Function
}

fn closerOf(k: Tok) Tok {
    if k == Tok.LBrace {
        return Tok.RBrace
    }
    if k == Tok.LBracket {
        return Tok.RBracket
    }
    return Tok.RParen
}

/// The index of the token that closes the block opened at `i`, or
/// `toks.len` when it is not closed.
pub fn blockEnd(toks: []Token, i: usize) usize {
    let want = closerOf(toks[i].kind)
    var j = i + 1
    while j < toks.len {
        let k = toks[j].kind
        if k == want {
            return j
        }
        if isOpener(k) {
            j = blockEnd(toks, j)
        }
        j += 1
    }
    return toks.len
}

/// The index just after the component value that starts at `i`: one
/// token, or a whole block or function.
pub fn skipComponent(toks: []Token, i: usize) usize {
    if isOpener(toks[i].kind) {
        let end = blockEnd(toks, i)
        if end < toks.len {
            return end + 1
        }
        return end
    }
    return i + 1
}

/// The index of the first non-whitespace token at or after `i`.
pub fn skipWhitespace(toks: []Token, i: usize) usize {
    var j = i
    while j < toks.len && toks[j].kind == Tok.Whitespace {
        j += 1
    }
    return j
}

struct Parser {
    sheet: *mut Sheet
    toks: []Token
    media: Media
    // A style rule (or a block at-rule) was met: `@import` is no longer
    // allowed.
    styled: bool

    // Rules in `lo..hi`.
    fn rules(self: *mut Self, lo: usize, hi: usize, top: bool) AllocError!void {
        var i = lo
        while i < hi {
            let k = self.toks[i].kind
            if k == Tok.Whitespace || (top && (k == Tok.Cdo || k == Tok.Cdc)) {
                i += 1
            } else if k == Tok.AtKeyword {
                i = try self.atRule(i, hi)
            } else {
                self.styled = true
                i = try self.styleRule(i, hi)
            }
        }
    }

    // The at-rule at `i`; returns the index after it.
    fn atRule(self: *mut Self, i: usize, hi: usize) AllocError!usize {
        let within = self.toks[..hi]
        let name = self.toks[i].text
        var j = i + 1
        while j < hi {
            let k = self.toks[j].kind
            if k == Tok.Semicolon {
                if text.eqlIgnoreCase(name, "import") && !self.styled {
                    try self.importRule(self.toks[i + 1..j])
                }
                return j + 1
            }
            if k == Tok.LBrace {
                let close = blockEnd(within, j)
                let prelude = self.toks[i + 1..j]
                self.styled = true
                if text.eqlIgnoreCase(name, "media") {
                    if mediaListMatches(prelude, self.media) {
                        try self.rules(j + 1, close, false)
                    }
                } else if text.eqlIgnoreCase(name, "supports") {
                    if try supportsMatches(self.sheet, prelude) {
                        try self.rules(j + 1, close, false)
                    }
                } else if text.eqlIgnoreCase(name, "layer") {
                    try self.rules(j + 1, close, false)
                }
                return close + 1
            }
            j = skipComponent(within, j)
        }
        if text.eqlIgnoreCase(name, "import") && !self.styled {
            try self.importRule(self.toks[i + 1..hi])
        }
        return hi
    }

    // `@import url [layer|layer(...)] [supports(...)] [media];`: the URL
    // goes to `Sheet.imports` when the conditions hold.
    fn importRule(self: *mut Self, toks: []Token) AllocError!void {
        var i = skipWhitespace(toks, 0)
        if i >= toks.len {
            return
        }
        let t = toks[i]
        var href: []u8 = ""
        if t.kind == Tok.Url || t.kind == Tok.String {
            href = t.text
            i += 1
        } else if t.kind == Tok.Function && text.eqlIgnoreCase(t.text, "url") {
            let close = blockEnd(toks, i)
            let s = skipWhitespace(toks, i + 1)
            if s >= close || toks[s].kind != Tok.String {
                return
            }
            href = toks[s].text
            i = close + 1
        } else {
            return
        }
        i = skipWhitespace(toks, i)
        if i < toks.len && toks[i].kind == Tok.Ident && text.eqlIgnoreCase(toks[i].text, "layer") {
            i = skipWhitespace(toks, i + 1)
        } else if i < toks.len && toks[i].kind == Tok.Function && text.eqlIgnoreCase(toks[i].text, "layer") {
            i = skipWhitespace(toks, skipComponent(toks, i))
        }
        if i < toks.len && toks[i].kind == Tok.Function && text.eqlIgnoreCase(toks[i].text, "supports") {
            let close = blockEnd(toks, i)
            if !(try supportsMatches(self.sheet, toks[i + 1..close])) && !(try supportsDeclaration(self.sheet, toks[i + 1..close])) {
                return
            }
            i = skipWhitespace(toks, close + 1)
        }
        if i < toks.len && !mediaListMatches(toks[i..], self.media) {
            return
        }
        try self.sheet.imports.append(href)
    }

    // The style rule at `i`; returns the index after it.
    fn styleRule(self: *mut Self, i: usize, hi: usize) AllocError!usize {
        let within = self.toks[..hi]
        var j = i
        while j < hi && self.toks[j].kind != Tok.LBrace {
            j = skipComponent(within, j)
        }
        if j >= hi {
            return hi
        }
        let close = blockEnd(within, j)
        if try parseSelectors(self.sheet, self.toks[i..j]) |sel| {
            let start = self.sheet.decls.len()
            try self.declarations(j + 1, close)
            try self.sheet.rules.append(Rule {
                sel_start: sel.start,
                sel_end: sel.end,
                decl_start: start,
                decl_end: self.sheet.decls.len(),
            })
        }
        return close + 1
    }

    // Declarations in `lo..hi`, separated by `;`.
    fn declarations(self: *mut Self, lo: usize, hi: usize) AllocError!void {
        let within = self.toks[..hi]
        var i = lo
        while i < hi {
            let k = self.toks[i].kind
            if k == Tok.Whitespace || k == Tok.Semicolon {
                i += 1
                continue
            }
            var end = i
            if k == Tok.AtKeyword {
                // A nested at-rule: skipped, with its block.
                end = i + 1
                while end < hi && self.toks[end].kind != Tok.Semicolon && self.toks[end].kind != Tok.LBrace {
                    end = skipComponent(within, end)
                }
                if end < hi && self.toks[end].kind == Tok.LBrace {
                    end = blockEnd(within, end)
                }
                i = end + 1
                continue
            }
            while end < hi && self.toks[end].kind != Tok.Semicolon {
                end = skipComponent(within, end)
            }
            if k == Tok.Ident {
                try self.declaration(i, end)
            }
            i = end + 1
        }
    }

    // `name : value [!important]` in `lo..hi`.
    fn declaration(self: *mut Self, lo: usize, hi: usize) AllocError!void {
        let toks = self.toks[..hi]
        var j = skipWhitespace(toks, lo + 1)
        if j >= hi || toks[j].kind != Tok.Colon {
            return
        }
        j = skipWhitespace(toks, j + 1)
        var end = trimEnd(toks, j, hi)
        var important = false
        if end > j && toks[end - 1].kind == Tok.Ident && text.eqlIgnoreCase(toks[end - 1].text, "important") {
            let bang = trimEnd(toks, j, end - 1)
            if bang > j && toks[bang - 1].kind == Tok.Delim && toks[bang - 1].delim == '!' {
                important = true
                end = trimEnd(toks, j, bang - 1)
            }
        }
        if end <= j {
            return
        }
        try addDeclaration(self.sheet, toks[lo].text, toks[j..end], important)
    }
}

// ---- @supports (CSS Conditional 3)

/// Does the `@supports` condition `toks` hold? A declaration test holds
/// when the property is known and its value parses; `selector()` holds;
/// other functions do not.
fn supportsMatches(sheet: *mut Sheet, toks: []Token) AllocError!bool {
    var c = Supports { sheet: sheet, toks: toks, i: 0 }
    let ok = try c.condition(toks.len)
    return ok && skipWhitespace(toks, c.i) >= toks.len
}

// The inside of `supports(...)` in `@import`: a declaration without
// parentheses is allowed there.
fn supportsDeclaration(sheet: *mut Sheet, toks: []Token) AllocError!bool {
    var c = Supports { sheet: sheet, toks: toks, i: 0 }
    return c.declarationTest(toks)
}

struct Supports {
    sheet: *mut Sheet
    toks: []Token
    i: usize

    fn condition(self: *mut Self, end: usize) AllocError!bool {
        self.i = skipWhitespace(self.toks[..end], self.i)
        if self.i < end && self.isWord(self.i, "not") {
            self.i += 1
            return !(try self.inParens(end))
        }
        var v = try self.inParens(end)
        while true {
            self.i = skipWhitespace(self.toks[..end], self.i)
            if self.i >= end {
                return v
            }
            let and = self.isWord(self.i, "and")
            if !and && !self.isWord(self.i, "or") {
                self.i = end + 1
                return false
            }
            self.i += 1
            let w = try self.inParens(end)
            if and {
                v = v && w
            } else {
                v = v || w
            }
        }
        return v
    }

    fn isWord(self: *Self, i: usize, word: []u8) bool {
        let t = self.toks[i]
        return t.kind == Tok.Ident && text.eqlIgnoreCase(t.text, word)
    }

    // `( condition )`, `( declaration )` or a function.
    fn inParens(self: *mut Self, end: usize) AllocError!bool {
        self.i = skipWhitespace(self.toks[..end], self.i)
        if self.i >= end {
            return false
        }
        let t = self.toks[self.i]
        if t.kind == Tok.Function {
            self.i = skipComponent(self.toks[..end], self.i)
            return text.eqlIgnoreCase(t.text, "selector")
        }
        if t.kind != Tok.LParen {
            self.i = end + 1
            return false
        }
        let close = blockEnd(self.toks[..end], self.i)
        let inner = self.toks[self.i + 1..close]
        self.i = close + 1
        let k = skipWhitespace(inner, 0)
        if k < inner.len && inner[k].kind == Tok.Ident {
            let colon = skipWhitespace(inner, k + 1)
            if colon < inner.len && inner[colon].kind == Tok.Colon {
                return self.declarationTest(inner)
            }
        }
        var c = Supports { sheet: self.sheet, toks: inner, i: 0 }
        let ok = try c.condition(inner.len)
        return ok && skipWhitespace(inner, c.i) >= inner.len
    }

    // `name: value`: does it make a declaration?
    fn declarationTest(self: *mut Self, toks: []Token) AllocError!bool {
        let k = skipWhitespace(toks, 0)
        if k >= toks.len || toks[k].kind != Tok.Ident {
            return false
        }
        let colon = skipWhitespace(toks, k + 1)
        if colon >= toks.len || toks[colon].kind != Tok.Colon {
            return false
        }
        let v = skipWhitespace(toks, colon + 1)
        let end = trimEnd(toks, v, toks.len)
        if end <= v {
            return false
        }
        let before = self.sheet.decls.len()
        try addDeclaration(self.sheet, toks[k].text, toks[v..end], false)
        let ok = self.sheet.decls.len() > before
        while self.sheet.decls.len() > before {
            _ = self.sheet.decls.pop()
        }
        return ok
    }
}

// `hi` without the whitespace tokens before it (not going below `lo`).
fn trimEnd(toks: []Token, lo: usize, hi: usize) usize {
    var e = hi
    while e > lo && toks[e - 1].kind == Tok.Whitespace {
        e -= 1
    }
    return e
}
