<html>
  display: block
  <head>
    display: none
    <style>
      display: none
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    <section id="outer" class="a">
      display: block
      <p class="b c">
        display: block
        color: rgb(255, 0, 0)
        margin-top: 4px
        margin-bottom: 16px
        margin-left: 3px
        ::before
          display: inline
          margin-top: 0px
          margin-bottom: 0px
          margin-left: 0px
          content: "+"
      <x-box class="host">
        #shadow-root (open)
          <style>
            display: none
          <div class="wrap">
            display: block
            <span class="in">
              color: rgb(0, 128, 0)
              padding-top: 9px
              ::after
                padding-top: 0px
                content: "*"
          <slot>
            display: contents
        <span class="kid b">
          color: rgb(255, 0, 0)
          padding-left: 5px
          ::before
            padding-left: 0px
            content: "+"
