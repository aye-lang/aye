<html>
  display: block
  <head>
    display: none
    <style>
      display: none
  <body>
    display: block
    <div id="a">
      display: flex
      flex-direction: column
      flex-wrap: wrap
      justify-content: space-between
      align-items: center
      row-gap: 4px
      column-gap: 32px
      <div id="b">
        display: block
        flex-grow: 1
        flex-basis: 0px
      <div id="c">
        display: block
        flex-shrink: 0
        align-self: flex-end
      <div id="d">
        display: block
        flex-grow: 2
        flex-shrink: 3
        flex-basis: 10%
      <div id="e">
        display: block
        flex-grow: 1
        flex-basis: 50px
      <div id="f">
        display: block
        flex-grow: 1
      <div id="g">
        display: block
        position: relative
        box-sizing: border-box
        top: 1px
        right: 2px
        bottom: 1px
        left: 2px
      <div id="h">
        display: block
      <div id="i">
        display: block
        flex-shrink: 2
        flex-basis: content
        row-gap: 5%
        column-gap: 5%
