<html>
  display: block
  <head>
    display: none
    <style>
      display: none
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    <div class="f">
      display: block
      float: left
      clear: both
      z-index: -3
    <div class="g">
      display: grid
      row-gap: 4px
      column-gap: 8px
      grid-template-columns: [full-start] repeat(2, minmax(10em, 1fr)) 200px [full-end]
      grid-template-rows: auto 1fr
      grid-template-areas: "head head" "nav main"
      <p class="a">
        display: block
        margin-top: 16px
        margin-bottom: 16px
        grid-column-start: 1
        grid-column-end: span 2
        grid-row-start: 2
      <p class="b">
        display: block
        margin-top: 16px
        margin-bottom: 16px
        grid-column-start: main
        grid-column-end: main
        grid-row-start: main
        grid-row-end: main
      <p class="c">
        display: block
        margin-top: 16px
        margin-bottom: 16px
        grid-column-start: 2
        grid-row-start: 1
        grid-row-end: 3
      <p class="d">
        display: block
        margin-top: 16px
        margin-bottom: 16px
        row-gap: 3px
        grid-column-start: nav
        grid-column-end: nav
