<html>
  display: block
  font-size: 10px
  <head>
    display: none
    font-size: 10px
    <style>
      display: none
      font-size: 10px
  <body>
    display: block
    font-size: 10px
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    <p class="a">
      display: block
      background-color: rgb(238, 238, 238)
      font-size: 10px
      margin-top: 10px
      margin-bottom: 10px
      background-image: url("img/a.png"), linear-gradient(to right, red, rgb(0 0 255) 20px)
      background-position: right 10px top, 0% 0%
      background-size: 20px auto, auto
      background-repeat: no-repeat, repeat
      background-origin: padding-box, padding-box
      background-clip: border-box, border-box
      background-attachment: scroll, scroll
    <p class="b">
      display: block
      font-size: 10px
      margin-top: 10px
      margin-bottom: 10px
      background-image: url("../b.svg")
      background-position: center
      background-size: cover
      mask-size: 14px
      border-top-left-radius: 4px 2px
      border-top-right-radius: 10px 2px
      border-bottom-right-radius: 4px 2px
      border-bottom-left-radius: 10px 2px
    <p class="c">
      display: block
      font-size: 10px
      margin-top: 10px
      margin-bottom: 10px
      background-size: 20px 50%
      border-top-left-radius: 50%
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3), inset 0 0 0 1px red
    <p class="d">
      display: block
      font-size: 10px
      margin-top: 10px
      margin-bottom: 10px
      mask-image: url("data:image/svg+xml;utf8,<svg/>")
      box-shadow: 1px 1px gray
    <p class="e">
      display: block
      font-size: 10px
      margin-top: 10px
      margin-bottom: 10px
      mask-image: url("m.svg")
      mask-position: center
      mask-size: contain
      mask-repeat: no-repeat
      border-top-left-radius: 3px
      border-top-right-radius: 3px
      border-bottom-right-radius: 3px
      border-bottom-left-radius: 3px
    <p class="f">
      display: block
      font-size: 10px
      margin-top: 10px
      margin-bottom: 10px
    <p class="g">
      display: block
      font-size: 10px
      margin-top: 10px
      margin-bottom: 10px
      stroke-dasharray: 4, 2 1
      stroke-dashoffset: 3
