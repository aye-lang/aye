<html>
  display: block
  <head>
    display: none
    <style>
      display: none
  <body>
    display: block
    color: rgb(18, 52, 86)
    margin-top: 4px
    margin-right: 8px
    margin-bottom: 4px
    margin-left: 8px
    <div class="box">
      display: block
      color: rgb(18, 52, 86)
      padding-top: 5px
      padding-right: 5px
      padding-bottom: 5px
      padding-left: 5px
      border-top-width: 1px
      border-right-width: 1px
      border-bottom-width: 1px
      border-left-width: 1px
      border-top-style: solid
      border-right-style: solid
      border-bottom-style: solid
      border-left-style: solid
      border-top-color: rgb(18, 52, 86)
      border-right-color: rgb(18, 52, 86)
      border-bottom-color: rgb(18, 52, 86)
      border-left-color: rgb(18, 52, 86)
      <p class="override">
        display: block
        color: rgb(255, 0, 0)
        background-color: rgb(255, 0, 0)
        margin-top: 16px
        margin-bottom: 16px
      <p class="cycle">
        display: block
        color: rgb(0, 128, 0)
        margin-top: 16px
        margin-bottom: 16px
    <p class="missing">
      display: block
      color: rgb(18, 52, 86)
      margin-top: 7px
      margin-bottom: 16px
    <p class="case">
      display: block
      color: rgb(18, 52, 86)
      margin-top: 16px
      margin-right: 3px
      margin-bottom: 16px
      margin-left: 1px
    <p class="important later">
      display: block
      color: rgb(18, 52, 86)
      margin-top: 16px
      margin-bottom: 16px
    <p class="font">
      display: block
      color: rgb(18, 52, 86)
      font-size: 20px
      font-weight: 700
      font-style: italic
      font-family: Georgia, serif
      line-height: 1.5
      margin-top: 20px
      margin-bottom: 20px
    <p class="nested">
      display: block
      color: rgb(18, 52, 86)
      margin-top: 16px
      margin-bottom: 16px
      border-left-width: 2px
      border-left-style: solid
      border-left-color: rgb(18, 52, 86)
    <p class="bad">
      display: block
      color: rgb(18, 52, 86)
      margin-top: 16px
      margin-bottom: 16px
    <p style="--fg: orange; color: var(--fg)">
      display: block
      color: rgb(255, 165, 0)
      margin-top: 16px
      margin-bottom: 16px
