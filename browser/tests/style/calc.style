<html>
  display: block
  <head>
    display: none
    <style>
      display: none
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    <p class="a">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      padding-top: 10px
      padding-right: 5px
      padding-bottom: 10px
      padding-left: 5px
      width: calc(100% - 20px)
    <p class="b">
      display: block
      font-size: 28px
      line-height: 32px
      margin-top: 28px
      margin-bottom: 28px
    <p class="c">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      margin-left: 30px
      width: 600px
      height: 32px
    <p class="d">
      display: block
      margin-top: 42px
      margin-bottom: 16px
      width: 50%
      flex-grow: 2
    <p class="e">
      display: block
      margin-top: -10px
      margin-right: -10px
      margin-bottom: -10px
      margin-left: -10px
      width: 30px
    <p class="f">
      display: block
      margin-top: 16px
      margin-bottom: 16px
    <p class="g">
      display: block
      margin-top: 16px
      margin-bottom: 16px
    <p class="h">
      display: block
      font-size: 24px
      line-height: 1.2
      margin-top: 24px
      margin-bottom: 24px
    <p class="i">
      display: block
      margin-top: 16px
      margin-bottom: 16px
      width: calc(100% - 26px)
