<html>
  display: block
  <head>
    display: none
  <body bgcolor="#ffffee" text="navy" link="red" marginwidth="0" topmargin="4">
    display: block
    color: rgb(0, 0, 128)
    background-color: rgb(255, 255, 238)
    margin-top: 4px
    margin-bottom: 8px
    <center>
      display: block
      color: rgb(0, 0, 128)
      text-align: center
      <table id="t" width="85%" bgcolor="ff6600" border="1" cellpadding="3">
        display: table
        color: rgb(0, 0, 128)
        background-color: rgb(255, 102, 0)
        margin-right: auto
        margin-left: auto
        border-top-width: 1px
        border-right-width: 1px
        border-bottom-width: 1px
        border-left-width: 1px
        border-top-style: outset
        border-right-style: outset
        border-bottom-style: outset
        border-left-style: outset
        border-top-color: rgb(128, 128, 128)
        border-right-color: rgb(128, 128, 128)
        border-bottom-color: rgb(128, 128, 128)
        border-left-color: rgb(128, 128, 128)
        width: 85%
        <tbody>
          display: table-row-group
          color: rgb(0, 0, 128)
          <tr>
            display: table-row
            color: rgb(0, 0, 128)
            <td align="right" nowrap="">
              display: table-cell
              color: rgb(0, 0, 128)
              padding-top: 3px
              padding-right: 3px
              padding-bottom: 3px
              padding-left: 3px
              border-top-width: 1px
              border-right-width: 1px
              border-bottom-width: 1px
              border-left-width: 1px
              border-top-style: inset
              border-right-style: inset
              border-bottom-style: inset
              border-left-style: inset
              border-top-color: rgb(128, 128, 128)
              border-right-color: rgb(128, 128, 128)
              border-bottom-color: rgb(128, 128, 128)
              border-left-color: rgb(128, 128, 128)
              text-align: right
              white-space: nowrap
            <td width="50" bgcolor="chucknorris">
              display: table-cell
              color: rgb(0, 0, 128)
              background-color: rgb(192, 0, 0)
              padding-top: 3px
              padding-right: 3px
              padding-bottom: 3px
              padding-left: 3px
              border-top-width: 1px
              border-right-width: 1px
              border-bottom-width: 1px
              border-left-width: 1px
              border-top-style: inset
              border-right-style: inset
              border-bottom-style: inset
              border-left-style: inset
              border-top-color: rgb(128, 128, 128)
              border-right-color: rgb(128, 128, 128)
              border-bottom-color: rgb(128, 128, 128)
              border-left-color: rgb(128, 128, 128)
              width: 50px
    <font color="green" face="Verdana, sans-serif" size="+2">
      color: rgb(0, 128, 0)
      font-size: 24px
      font-family: Verdana, sans-serif
    <font size="1">
      color: rgb(0, 0, 128)
      font-size: 10px
    <div align="center">
      display: block
      color: rgb(0, 0, 128)
      text-align: center
      <p>
        display: block
        color: rgb(0, 0, 128)
        margin-top: 16px
        margin-right: auto
        margin-bottom: 16px
        margin-left: auto
        text-align: center
      <table width="200">
        display: table
        color: rgb(0, 0, 128)
        margin-right: auto
        margin-left: auto
        width: 200px
        <tbody>
          display: table-row-group
          color: rgb(0, 0, 128)
          <tr>
            display: table-row
            color: rgb(0, 0, 128)
            <td>
              display: table-cell
              color: rgb(0, 0, 128)
              padding-top: 1px
              padding-right: 1px
              padding-bottom: 1px
              padding-left: 1px
    <a href="x">
      color: rgb(255, 0, 0)
      text-decoration-line: underline
    <a name="anchor">
      color: rgb(0, 0, 128)
    <ol type="a">
      display: block
      color: rgb(0, 0, 128)
      margin-top: 16px
      margin-bottom: 16px
      padding-left: 40px
      list-style-type: lower-alpha
      <li>
        display: list-item
        color: rgb(0, 0, 128)
        list-style-type: lower-alpha
      <li type="I">
        display: list-item
        color: rgb(0, 0, 128)
        list-style-type: upper-roman
    <hr width="50%" align="left">
      display: block
      color: rgb(128, 128, 128)
      margin-top: 8px
      margin-right: auto
      margin-bottom: 8px
      border-top-width: 1px
      border-right-width: 1px
      border-bottom-width: 1px
      border-left-width: 1px
      border-top-style: inset
      border-right-style: inset
      border-bottom-style: inset
      border-left-style: inset
      width: 50%
      overflow-x: hidden
      overflow-y: hidden
    <img src="x" border="2" hspace="4">
      color: rgb(0, 0, 128)
      margin-right: 4px
      margin-left: 4px
      border-top-width: 2px
      border-right-width: 2px
      border-bottom-width: 2px
      border-left-width: 2px
      border-top-style: solid
      border-right-style: solid
      border-bottom-style: solid
      border-left-style: solid
    <table width="0" height="40" style="width: 120px">
      display: table
      color: rgb(0, 0, 128)
      width: 120px
      height: 40px
      <tbody>
        display: table-row-group
        color: rgb(0, 0, 128)
        <tr height="20">
          display: table-row
          color: rgb(0, 0, 128)
          height: 20px
          <th align="left">
            display: table-cell
            color: rgb(0, 0, 128)
            font-weight: 700
            padding-top: 1px
            padding-right: 1px
            padding-bottom: 1px
            padding-left: 1px
            text-align: left
