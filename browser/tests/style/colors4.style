<html>
  display: block
  <head>
    display: none
    <style>
      display: none
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    <p class="h1">
      display: block
      color: rgb(0, 128, 0)
      margin-top: 16px
      margin-bottom: 16px
    <p class="h2">
      display: block
      color: rgba(255, 0, 0, 0.5)
      margin-top: 16px
      margin-bottom: 16px
    <p class="h3">
      display: block
      color: rgba(0, 0, 255, 0.25)
      margin-top: 16px
      margin-bottom: 16px
    <p class="h4">
      display: block
      color: rgb(64, 191, 191)
      margin-top: 16px
      margin-bottom: 16px
    <p class="h5">
      display: block
      color: rgb(0, 0, 255)
      margin-top: 16px
      margin-bottom: 16px
    <p class="r1">
      display: block
      color: rgba(255, 0, 0, 0.5)
      margin-top: 16px
      margin-bottom: 16px
    <p class="r2">
      display: block
      color: rgba(0, 255, 0, 0.53)
      margin-top: 16px
      margin-bottom: 16px
    <p class="r3">
      display: block
      color: rgba(0, 0, 255, 0.1)
      margin-top: 16px
      margin-bottom: 16px
    <p class="ld">
      display: block
      color: rgb(17, 17, 17)
      margin-top: 16px
      margin-bottom: 16px
    <p class="sys">
      display: block
      color: rgb(0, 0, 238)
      background-color: rgb(255, 255, 255)
      margin-top: 16px
      margin-bottom: 16px
    <p class="cur">
      display: block
      color: rgb(0, 128, 0)
      margin-top: 16px
      margin-bottom: 16px
      border-top-width: 1px
      border-right-width: 1px
      border-bottom-width: 1px
      border-left-width: 1px
      border-top-style: solid
      border-right-style: solid
      border-bottom-style: solid
      border-left-style: solid
    <p class="bad1">
      display: block
      color: rgb(255, 0, 0)
      margin-top: 16px
      margin-bottom: 16px
    <p class="bad2">
      display: block
      color: rgb(0, 116, 122)
      margin-top: 16px
      margin-bottom: 16px
    <p class="bad3">
      display: block
      background-color: rgb(0, 116, 122)
      margin-top: 16px
      margin-bottom: 16px
    <p class="ok">
      display: block
      background-color: rgb(170, 187, 204)
      margin-top: 16px
      margin-bottom: 16px
      background-image: url("x.png")
      background-repeat: no-repeat
    <p class="named">
      display: block
      color: rgb(102, 51, 153)
      background-color: rgb(250, 250, 210)
      margin-top: 16px
      margin-bottom: 16px
