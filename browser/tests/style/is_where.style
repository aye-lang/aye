<html>
  display: block
  <head>
    display: none
    <style>
      display: none
  <body>
    display: block
    margin-top: 8px
    margin-right: 8px
    margin-bottom: 8px
    margin-left: 8px
    <div class="a">
      display: block
      <p>
        display: block
        color: rgb(0, 128, 0)
        margin-top: 16px
        margin-bottom: 16px
    <div class="b">
      display: block
      <p>
        display: block
        color: rgb(0, 128, 0)
        margin-top: 16px
        margin-bottom: 16px
    <div id="w">
      display: block
      <p>
        display: block
        margin-top: 16px
        margin-bottom: 16px
    <div id="i">
      display: block
      <p class="x">
        display: block
