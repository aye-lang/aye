{"jsonrpc":"2.0","id":0,"result":{"protocolVersion":"2025-06-18","capabilities":{"tools":{"listChanged":false}},"serverInfo":{"name":"anyknown","title":"anyknown browser","version":"0.1.0"},"instructions":"A web browser without pixels. Start with browser_navigate; browser_snapshot lists the page as an accessibility tree whose interactive elements and headings carry refs like e12; act on them with browser_click, browser_type, browser_select. browser_read gives the main content as Markdown. Pages run their scripts: browser_eval runs JavaScript in the page, browser_wait lets timers run (page time, not real time)."}}
{"jsonrpc":"2.0","id":1,"result":{"tools":[{"name":"browser_navigate","title":"Navigate","description":"Load a URL (absolute, relative to the current page, or a file path) and return the accessibility snapshot of the new page.","inputSchema":{"type":"object","properties":{"url":{"type":"string","description":"The URL to load."}},"required":["url"],"additionalProperties":false},"annotations":{"readOnlyHint":false}},{"name":"browser_back","title":"Back","description":"Go back in the history.","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"annotations":{"readOnlyHint":false}},{"name":"browser_forward","title":"Forward","description":"Go forward in the history.","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"annotations":{"readOnlyHint":false}},{"name":"browser_reload","title":"Reload","description":"Load the current page again.","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"annotations":{"readOnlyHint":false}},{"name":"browser_snapshot","title":"Snapshot","description":"The page as an accessibility tree: roles, names, values and states. Interactive elements and headings carry refs (e12) for the other tools; [offscreen] marks elements outside the viewport.","inputSchema":{"type":"object","properties":{"boxes":{"type":"boolean","description":"Add the layout box of each element: [box=x,y,width,height] in px."}},"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"browser_read","title":"Read","description":"The main content of the page as Markdown (navigation, headers and footers are left out when the page marks its main content). Links are followed by their refs.","inputSchema":{"type":"object","properties":{"refs":{"type":"boolean","description":"Write the ref after each link (default true)."}},"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"browser_click","title":"Click","description":"Click an element by ref: the page's scripts get the click event, then (unless they cancel it) follow a link, toggle a checkbox or radio button, submit a form, open a details element.","inputSchema":{"type":"object","properties":{"ref":{"type":"string","description":"The ref of the element, from the snapshot (e12)."}},"required":["ref"],"additionalProperties":false},"annotations":{"readOnlyHint":false}},{"name":"browser_type","title":"Type","description":"Replace the text of a text field (input or textarea) by ref.","inputSchema":{"type":"object","properties":{"ref":{"type":"string","description":"The ref of the text field."},"text":{"type":"string","description":"The text to put in the field."},"submit":{"type":"boolean","description":"Press Enter afterwards."}},"required":["ref","text"],"additionalProperties":false},"annotations":{"readOnlyHint":false}},{"name":"browser_select","title":"Select","description":"Choose an option of a select element by its label or value.","inputSchema":{"type":"object","properties":{"ref":{"type":"string","description":"The ref of the select element (a combobox or listbox)."},"option":{"type":"string","description":"The label or value of the option."}},"required":["ref","option"],"additionalProperties":false},"annotations":{"readOnlyHint":false}},{"name":"browser_press","title":"Press key","description":"Press a key on the focused element: a character, Enter, Backspace, Tab, Shift+Tab, Escape, Space, PageDown, PageUp, Home, End, ArrowDown, ArrowUp.","inputSchema":{"type":"object","properties":{"key":{"type":"string","description":"The key."}},"required":["key"],"additionalProperties":false},"annotations":{"readOnlyHint":false}},{"name":"browser_scroll","title":"Scroll","description":"Scroll the viewport to an element (ref) or by a distance (dy, in px; negative is up).","inputSchema":{"type":"object","properties":{"ref":{"type":"string","description":"The ref of the element to scroll to."},"dy":{"type":"number","description":"Pixels to scroll down (negative: up)."}},"additionalProperties":false},"annotations":{"readOnlyHint":false}},{"name":"browser_find","title":"Find","description":"Find text on the page (ignoring case): each match with its context and the nearest element with a ref.","inputSchema":{"type":"object","properties":{"text":{"type":"string","description":"The text to find."}},"required":["text"],"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"browser_wait","title":"Wait","description":"Let the page's scripts run: until an element matches a CSS selector, for a time, or (neither) until no timer is left (at most 5 s). Time is the page's: waiting takes no real time.","inputSchema":{"type":"object","properties":{"selector":{"type":"string","description":"A CSS selector to wait for (at most ms, 5000 by default)."},"ms":{"type":"number","description":"Milliseconds of the page's time to wait."}},"additionalProperties":false},"annotations":{"readOnlyHint":false}},{"name":"browser_eval","title":"Evaluate JavaScript","description":"Run JavaScript in the page and return the value of its last expression (strings as they are, other values as console.log shows them).","inputSchema":{"type":"object","properties":{"expression":{"type":"string","description":"The script; its last expression statement is the result."}},"required":["expression"],"additionalProperties":false},"annotations":{"readOnlyHint":false}}]}}
