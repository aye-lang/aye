#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "DOMParser"
      "\n"
    <body>
      <pre id="out">
        "title Parsed en 1\nhead 2 /* swaps <head> and <body> on navigation */\nbody b form,a,x-frame,p\ncollections 1 1 1 0\nowner true true true\nupgraded false true\nmoved true\nremoved true true\ncreated true true true\ninserted true\nkept true\nadopt true true true\nimport true true\nadopted true true\nsub-before true\nsub-in true true\nsub-out true true\ndoc  \nclone true 200 true true application/json true\nused TypeError\n"
      "\n"
      <script>
        "\n// DOMParser parses a whole document: a script's text that mentions\n// <head> or <body> stays text (mistral.ai's Astro router), the html\n// element keeps its attributes, and the document has scripts, forms and\n// links. Its nodes' ownerDocument is the parsed document until they are\n// inserted elsewhere, so importNode makes an upgraded custom element\n// (Turbo's frames on GitHub). A fetched Response can be cloned.\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\ncustomElements.define('x-frame', class extends HTMLElement {});\nconst src = '<!DOCTYPE html><html lang=\"en\" data-x=\"1\"><head><title>Parsed</title>' +\n  '<script>/* swaps <head> and <body> on navigation */<\\/script></head>' +\n  '<body class=\"b\"><form></form><a href=\"/n\">n</a><x-frame id=\"f\"></x-frame><p>end</p></body></html>';\nconst doc = new DOMParser().parseFromString(src, 'text/html');\nlog('title', doc.title, doc.documentElement.getAttribute('lang'), doc.documentElement.getAttribute('data-x'));\nlog('head', doc.head.children.length, doc.head.querySelector('script').textContent);\nlog('body', doc.body.className, Array.from(doc.body.children, c => c.localName).join(','));\nlog('collections', doc.scripts.length, doc.forms.length, doc.links.length, doc.images.length);\nconst frame = doc.body.querySelector('x-frame');\nconst X = customElements.get('x-frame');\nlog('owner', frame.ownerDocument === doc, doc.documentElement.ownerDocument === doc, frame.ownerDocument !== document);\nlog('upgraded', frame instanceof X, document.importNode(frame, true) instanceof X);\nconst p = doc.body.querySelector('p');\ndocument.body.appendChild(p);\nlog('moved', p.ownerDocument === document);\n// Node document changes only by adoption: a removed node keeps the parsed\n// document; importNode clones and adoptNode take the adopting document's.\nconst q = doc.body.querySelector('a');\nq.remove();\nlog('removed', q.ownerDocument === doc, q.ownerDocument !== document);\nconst q2 = doc.createElement('b');\nq2.appendChild(doc.createTextNode('t'));\nlog('created', q2.ownerDocument === doc, q2.firstChild.ownerDocument === doc, doc.createElement('i').ownerDocument === doc);\ndocument.body.appendChild(q);\nlog('inserted', q.ownerDocument === document);\nq.remove();\nlog('kept', q.ownerDocument === document);\nconst q3 = document.adoptNode(q2);\nlog('adopt', q3 === q2, q2.ownerDocument === document, q2.firstChild.ownerDocument === document);\nconst q4 = doc.importNode(document.createElement('u'), true);\nlog('import', q4.ownerDocument === doc, document.importNode(q4, true).ownerDocument === document);\nconst q5 = document.createElement('s');\ndoc.adoptNode(q5);\nlog('adopted', q5.ownerDocument === doc, doc.createElement('s').ownerDocument === doc);\nconst sub = doc.createElement('div');\nsub.innerHTML = '<section><span id=\"gc\">x</span></section>';\nconst gc = sub.querySelector('#gc');\nlog('sub-before', gc.ownerDocument === doc);\ndocument.body.appendChild(sub);\nlog('sub-in', gc.ownerDocument === document, sub.firstChild.ownerDocument === document);\nsub.remove();\nlog('sub-out', gc.ownerDocument === document, sub.ownerDocument === document);\nlog('doc', doc.ownerDocument, document.ownerDocument);\nfetch('scripts/items.json').then(async r => {\n  const c = r.clone();\n  log('clone', c instanceof Response, c.status, c.ok, c.url === r.url, c.headers.get('content-type'), (await c.text()) === (await r.text()));\n  try { r.clone(); } catch (e) { log('used', e.name); }\n});\n"
      "\n"
      <p>
        "end"
