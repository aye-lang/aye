#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "DOMParser"
      "\n"
    <body>
      <pre id="out">
        "title Parsed en 1\nhead 2 /* swaps <head> and <body> on navigation */\nbody b form,a,x-frame,p\ncollections 1 1 1 0\nowner true true true\nupgraded false true\nmoved true\nclone true 200 true true application/json true\nused TypeError\n"
      "\n"
      <script>
        "\n// DOMParser parses a whole document: a script's text that mentions\n// <head> or <body> stays text (mistral.ai's Astro router), the html\n// element keeps its attributes, and the document has scripts, forms and\n// links. Its nodes' ownerDocument is the parsed document until they are\n// inserted elsewhere, so importNode makes an upgraded custom element\n// (Turbo's frames on GitHub). A fetched Response can be cloned.\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\ncustomElements.define('x-frame', class extends HTMLElement {});\nconst src = '<!DOCTYPE html><html lang=\"en\" data-x=\"1\"><head><title>Parsed</title>' +\n  '<script>/* swaps <head> and <body> on navigation */<\\/script></head>' +\n  '<body class=\"b\"><form></form><a href=\"/n\">n</a><x-frame id=\"f\"></x-frame><p>end</p></body></html>';\nconst doc = new DOMParser().parseFromString(src, 'text/html');\nlog('title', doc.title, doc.documentElement.getAttribute('lang'), doc.documentElement.getAttribute('data-x'));\nlog('head', doc.head.children.length, doc.head.querySelector('script').textContent);\nlog('body', doc.body.className, Array.from(doc.body.children, c => c.localName).join(','));\nlog('collections', doc.scripts.length, doc.forms.length, doc.links.length, doc.images.length);\nconst frame = doc.body.querySelector('x-frame');\nconst X = customElements.get('x-frame');\nlog('owner', frame.ownerDocument === doc, doc.documentElement.ownerDocument === doc, frame.ownerDocument !== document);\nlog('upgraded', frame instanceof X, document.importNode(frame, true) instanceof X);\nconst p = doc.body.querySelector('p');\ndocument.body.appendChild(p);\nlog('moved', p.ownerDocument === document);\nfetch('scripts/items.json').then(async r => {\n  const c = r.clone();\n  log('clone', c instanceof Response, c.status, c.ok, c.url === r.url, c.headers.get('content-type'), (await c.text()) === (await r.text()));\n  try { r.clone(); } catch (e) { log('used', e.name); }\n});\n"
      "\n"
      <p>
        "end"
