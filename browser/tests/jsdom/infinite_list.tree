#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Infinite list"
      "\n"
      <style>
        "\nbody { margin: 0 }\nli { height: 100px }\n"
      "\n"
    <body>
      <h1>
        "Infinite list"
      "\n"
      <ol id="list">
        <li>
          "Item 1"
        <li>
          "Item 2"
        <li>
          "Item 3"
        <li>
          "Item 4"
        <li>
          "Item 5"
        <li>
          "Item 6"
        <li>
          "Item 7"
        <li>
          "Item 8"
        <li>
          "Item 9"
        <li>
          "Item 10"
        <li>
          "Item 11"
        <li>
          "Item 12"
        <li>
          "Item 13"
        <li>
          "Item 14"
        <li>
          "Item 15"
        <li>
          "Item 16"
        <li>
          "Item 17"
        <li>
          "Item 18"
        <li>
          "Item 19"
        <li>
          "Item 20"
        <li>
          "Item 21"
        <li>
          "Item 22"
        <li>
          "Item 23"
        <li>
          "Item 24"
        <li>
          "Item 25"
        <li>
          "Item 26"
        <li>
          "Item 27"
        <li>
          "Item 28"
        <li>
          "Item 29"
        <li>
          "Item 30"
        <li>
          "Item 31"
        <li>
          "Item 32"
        <li>
          "Item 33"
        <li>
          "Item 34"
        <li>
          "Item 35"
        <li>
          "Item 36"
        <li>
          "Item 37"
        <li>
          "Item 38"
        <li>
          "Item 39"
        <li>
          "Item 40"
        <li>
          "Item 41"
        <li>
          "Item 42"
        <li>
          "Item 43"
        <li>
          "Item 44"
        <li>
          "Item 45"
        <li>
          "Item 46"
        <li>
          "Item 47"
        <li>
          "Item 48"
        <li>
          "Item 49"
        <li>
          "Item 50"
      "\n"
      <p id="more">
        "End of the list."
      "\n"
      <script>
        "\n// Ten items at a time, when the \"Loading more\" line comes into view\n// (fetched after 200 ms), until there are 50.\nconst list = document.getElementById('list');\nconst more = document.getElementById('more');\nlet busy = false;\nfunction load() {\n  busy = true;\n  setTimeout(() => {\n    const n = list.children.length;\n    for (let i = 1; i <= 10; i++) {\n      const li = document.createElement('li');\n      li.textContent = 'Item ' + (n + i);\n      list.append(li);\n    }\n    busy = false;\n    if (list.children.length >= 50) {\n      io.disconnect();\n      more.textContent = 'End of the list.';\n    }\n  }, 200);\n}\nconst io = new IntersectionObserver(entries => {\n  if (entries.some(e => e.isIntersecting) && !busy) load();\n});\nio.observe(more);\n"
      "\n"
