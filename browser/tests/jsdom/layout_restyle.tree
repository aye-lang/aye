      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\nconst $ = id => document.getElementById(id);\n// Every element's box (read after each change, as a framework does).\nfunction boxes() {\n  return [...document.body.querySelectorAll('*')].filter(e => e.id && e.id !== 'out').map(e => e.id + ':' + [e.offsetLeft, e.offsetTop, e.offsetWidth, e.offsetHeight].join(',')).join(' ');\n}\nconst steps = [\n  ['class on an ancestor', () => $('list').classList.add('wide')],\n  ['class on an ancestor again', () => $('list').classList.remove('wide')],\n  ['class before siblings', () => $('i2').classList.add('big')],\n  ['same class', () => $('i2').setAttribute('class', 'item big')],\n  ['insert a sibling', () => $('list').insertBefore(Object.assign(document.createElement('div'), { className: 'item', id: 'i0' }), $('i1'))],\n  ['remove a sibling', () => $('i0').remove()],\n  ['fill an empty box', () => $('box').append('x')],\n  ['empty the box', () => { $('box').textContent = ''; }],\n  [':has() deep', () => $('b1').classList.add('flag')],\n  [':has() deep off', () => $('b1').className = ''],\n  [':has(>) child', () => $('t1').classList.add('tick')],\n  [':has(>) grandchild', () => { $('t1').classList.remove('tick'); $('t1').append(Object.assign(document.createElement('u'), { className: 'tick', id: 'u1' })); }],\n  ['attribute on an ancestor', () => $('mode').dataset.mode = 'x'],\n  ['attribute on the subject', () => $('l2').setAttribute('data-own', '')],\n  ['attribute removed', () => $('l2').removeAttribute('data-own')],\n  ['inherited font size', () => $('inh').classList.add('inh')],\n  ['custom property', () => $('vars').classList.add('vars')],\n  ['custom property inline', () => $('vars').style.setProperty('--w', '44px')],\n  ['root font size', () => document.documentElement.classList.add('r')],\n  ['center', () => $('center').setAttribute('align', 'center')],\n  ['hidden subtree', () => $('hide').classList.add('gone')],\n  ['change inside hidden', () => $('h1').classList.add('big')],\n  ['shown again', () => $('hide').classList.remove('gone')],\n  ['detached work', () => { const d = document.createElement('div'); d.className = 'item big'; d.append(document.createElement('span')); $('list').append(d); }],\n  ['style attribute', () => $('i3').style.width = '7px'],\n];\nlog('start', boxes());\nfor (const [name, change] of steps) {\n  change();\n  log(name, boxes());\n}\n"
      "\n"
