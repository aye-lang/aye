        "\nbody { margin: 0; font-size: 10px }\n.item { height: 10px; width: 20px }\n.wide .item { width: 50px }\n.item + .item { margin-top: 2px }\n.item.big ~ .item { width: 30px }\n.item:nth-child(3) { height: 15px }\n.box { width: 40px; height: 3px }\n.box:empty { height: 7px }\n.card:has(.flag) .label { width: 60px }\n:has(> .tick) { padding-left: 3px }\n[data-mode=x] .label { height: 12px }\n.label { display: inline-block; width: 10px; height: 4px }\n.label[data-own] { width: 70px }\n.inh { font-size: 20px }\n.em { width: 2em; height: 1em }\n.vars { --w: 33px }\n.usevar { width: var(--w); height: 5px }\n.rem { width: 5rem; height: 1rem }\nhtml.r { font-size: 12px }\n.blk { width: 10px; height: 2px; display: table }\n.gone { display: none }\n"
