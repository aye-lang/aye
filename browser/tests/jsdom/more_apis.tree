#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "More web APIs"
      "\n"
      <style>
        "p { color: red }"
      "\n"
    <body>
      <form id="f">
        <input name="q" value="text">
        <input type="checkbox" name="c" checked="">
        <input type="checkbox" name="d">
        <select name="s">
          <option>
            "x"
          <option selected="">
            "y"
        <textarea name="t">
          "area"
        <button name="b">
          "go"
      "\n"
      <p id="p">
        "para"
        <b>
          "bold"
      "\n"
      <pre id="out">
        "42 https://x true 3 5 true m 1\n5 3 true \n4 text/plain 1 true\na.txt 3 7 true\nq=text&c=on&s=y&t=area\ntext,more set false  q,s,t,q\ntrue 2 false true\ntrue 0\n11 2 I\nar 0 function\ntrue 0 4 6\nT n parsed 0\n<p id=\"p\">para<b>bold</b></p>\n1 STYLE true\n2 true\ntrue false true a\\ b\\#1 \\31 x\ntext hé!\nreader 2 data:text/plain;base64,YWJj\nport 1 true\nwindow posted true\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\n// Event interfaces.\nconst me = new MessageEvent('message', { data: 42, origin: 'https://x' });\nconst pe = new PointerEvent('pointerdown', { pointerId: 3, clientX: 5, bubbles: true });\nlog(me.data, me.origin, me instanceof Event, pe.pointerId, pe.clientX, pe instanceof MouseEvent, new ErrorEvent('error', { message: 'm' }).message, new PopStateEvent('popstate', { state: 1 }).state);\nlog(new ProgressEvent('load', { loaded: 5, total: 9 }).loaded, new WheelEvent('wheel', { deltaY: 3 }).deltaY, new HashChangeEvent('hashchange').newURL === '', new SubmitEvent('submit').submitter);\n// Blob, File, FileReader.\nconst blob = new Blob(['hé', new Uint8Array([33])], { type: 'Text/Plain' });\nlog(blob.size, blob.type, blob.slice(0, 1).size, blob instanceof Blob);\nconst file = new File(['abc'], 'a.txt', { type: 'text/plain', lastModified: 7 });\nlog(file.name, file.size, file.lastModified, file instanceof Blob);\nblob.text().then(t => log('text', t));\nconst fr = new FileReader();\nfr.onload = () => log('reader', fr.readyState, fr.result);\nfr.readAsDataURL(file);\n// FormData from a form.\nconst fd = new FormData(document.getElementById('f'));\nlog([...fd].map(([k, v]) => k + '=' + v).join('&'));\nfd.append('q', 'more');\nfd.set('t', 'set');\nfd.delete('c');\nlog(fd.getAll('q').join(','), fd.get('t'), fd.has('c'), fd.get('none'), [...fd.keys()].join(','));\n// Messages.\nconst mc = new MessageChannel();\nmc.port2.onmessage = e => log('port', e.data, e instanceof MessageEvent);\nmc.port1.postMessage({ n: 1 }.n);\nwindow.addEventListener('message', e => log('window', e.data, e.source === window));\nwindow.postMessage('posted', '*');\n// Range, Selection, DOMRect.\nconst p = document.getElementById('p');\nconst r = document.createRange();\nr.selectNodeContents(p);\nlog(r.startContainer === p, r.endOffset, r.collapsed, r.commonAncestorContainer === p);\nr.collapse(true);\nlog(r.collapsed, r.endOffset);\nconst frag = r.createContextualFragment('<i>x</i>y');\nlog(frag.nodeType, frag.childNodes.length, frag.firstChild.tagName);\nconst t = p.firstChild;\nconst r2 = document.createRange();\nr2.setStart(t, 1);\nr2.setEnd(t, 3);\nlog(r2.toString(), getSelection().rangeCount, typeof getSelection().removeAllRanges);\nconst rect = p.getBoundingClientRect();\nlog(rect instanceof DOMRect, rect.width, new DOMRect(1, 2, 3, 4).right, new DOMRect(1, 2, 3, 4).bottom);\n// DOMParser, XMLSerializer.\nconst doc = new DOMParser().parseFromString('<html><head><title>T</title></head><body><p class=\"n\">parsed</p></body></html>', 'text/html');\nlog(doc.title, doc.body.firstChild.className, doc.querySelector('p').textContent, document.querySelectorAll('.n').length);\nlog(new XMLSerializer().serializeToString(p));\n// Style sheets and CSS.\nlog(document.styleSheets.length, document.styleSheets[0].ownerNode.tagName, document.querySelector('style').sheet === document.styleSheets[0]);\nconst sheet = new CSSStyleSheet();\nsheet.insertRule('a { color: blue }');\nsheet.replaceSync('b { x: y } c { z: w }');\nlog(sheet.cssRules.length, Array.isArray(document.adoptedStyleSheets));\nlog(CSS.supports('display', 'grid'), CSS.supports('display', 'bogus'), CSS.supports('(color: red) and (display: block)'), CSS.escape('a b#1'), CSS.escape('1x'));\n"
      "\n"
