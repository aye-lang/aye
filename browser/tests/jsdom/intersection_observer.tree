#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "IntersectionObserver from the layout"
      "\n"
      <style>
        "\nbody { margin: 0 }\n.tile { height: 100px }\n#below { margin-top: 1000px; height: 100px }\n#list { height: 50px; overflow: auto }\n#list div { height: 40px }\n#none { display: none }\n"
      "\n"
    <body>
      <div class="tile" id="top" title="x">
      "\n"
      <div id="half" style="height: 100px; margin-top: 450px">
      "\n"
      <div id="list">
        <div id="first">
        <div id="hiddenInList">
      "\n"
      <div id="none" style="display: block; height: 10px; margin-top: 900px;">
      "\n"
      <div id="below">
      "\n"
      <pre id="out">
        "io top true 1 0 100 0 600\nio half true 0.5 550 50 550 600\nio first false 0 0 0 650 600\nio hiddenInList false 0 0 0 690 600\nio none false 0 0 0 0 600\nio below false 0 0 0 1700 600\nnear below false 0 0 0 1700 1100\nlist hiddenInList true 0.25 690 10 690 50\n-- scroll\nio top false 0 0 0 -900 600\nio half false 0 0 0 -350 600\nnear below true 1 800 100 800 1100\n-- list\n-- shown\nio none false 0 0 0 700 600\nnear below false 0 0 0 1710 1100\n-- unchanged\n-- done\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\nconst $ = id => document.getElementById(id);\nfunction show(e) {\n  const r = e.intersectionRect;\n  return [e.target.id, e.isIntersecting, e.intersectionRatio, r.y, r.height, e.boundingClientRect.y, e.rootBounds.height].join(' ');\n}\n// Every target is reported once at first, intersecting or not.\nconst io = new IntersectionObserver(entries => {\n  for (const e of entries) log('io', show(e));\n}, { threshold: [0, 0.5, 1] });\nfor (const id of ['top', 'half', 'first', 'hiddenInList', 'none', 'below']) io.observe($(id));\n// rootMargin grows the root's box.\nconst near = new IntersectionObserver(entries => {\n  for (const e of entries) log('near', show(e));\n}, { rootMargin: '0px 0px 500px 0px' });\nnear.observe($('below'));\n// A root element: its padding box.\nconst inList = new IntersectionObserver(entries => {\n  for (const e of entries) log('list', show(e));\n}, { root: $('list') });\ninList.observe($('hiddenInList'));\n// After a scroll or a change, only the targets whose state changed.\nsetTimeout(() => {\n  log('-- scroll');\n  scrollTo(0, 900);\n  setTimeout(() => {\n    log('-- list');\n    $('list').scrollTop = 30;\n    setTimeout(() => {\n      log('-- shown');\n      $('none').style.display = 'block';\n      $('none').style.height = '10px';\n      $('none').style.marginTop = '900px';\n      setTimeout(() => {\n        log('-- unchanged');\n        $('top').title = 'x';\n        setTimeout(() => log('-- done'), 50);\n      }, 50);\n    }, 50);\n  }, 50);\n}, 50);\n"
      "\n"
