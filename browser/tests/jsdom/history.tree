#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "History"
      "\n"
    <body>
      <a id="rel" href="#t">
        "relative"
      "\n"
      <pre id="out">
        "start 1  auto true [object History]\npush returns \npush 1 {\"n\":1,\"list\":[1,2]} false true ?a=1 history.html?a=1 history.html?a=1 history.html?a=1#t\npush 2 {\"n\":2} ?b=2 #frag\nreplace 2 {\"n\":3} history.html?b=2#frag\nreplace url 2  history.html?c=3\ncross-origin SecurityError true\nother file SecurityError true\nfunction DataCloneError true\nafter errors 2 history.html?c=3\nscrollRestoration manual\nback called history.html?c=3\nmicrotask before the traversal history.html?c=3\npopstate PopStateEvent {\"n\":1,\"list\":[1,2]} true history.html?a=1 true false false\npopstate PopStateEvent null true history.html?c=3 true false false\npopstate PopStateEvent null true history.html?c=3#x true false false\nhash set 3  history.html?c=3#x\nsame hash 3\npopstate PopStateEvent null true history.html?c=3#y true false false\nhref set 4 history.html?c=3#y\nhashchange HashChangeEvent history.html?c=3 history.html?c=3#x true\nhashchange HashChangeEvent history.html?c=3#x history.html?c=3#y true\npopstate PopStateEvent null true history.html?c=3 true false false\nhashchange HashChangeEvent history.html?c=3#y history.html?c=3 true\npopstate PopStateEvent {\"n\":1,\"list\":[1,2]} true history.html?a=1 true false false\nscrollRestoration of the entry auto\npush drops forward 2 history.html?d=4 auto\npopstate PopStateEvent {\"n\":1,\"list\":[1,2]} true history.html?a=1 true false false\nfragment set history.html?a=1#x\nempty replace history.html?a=1\nempty push 2 history.html?a=1\nomitted 5 history.html?a=1#x\ndone 5 null history.html?a=1#x\n"
      "\n"
      <script>
        "\n// The History API (HTML \"session history\"): pushState and replaceState\n// change the URL without loading and fire nothing; back, forward and go\n// traverse in a task, firing popstate (and hashchange when the fragment\n// differs); fragment navigations add entries. On file: URLs only the\n// query and fragment may change.\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\nconst file = s => s.split('/').pop();\nconst start = history.length;\nlog('start', start, history.state, history.scrollRestoration, history instanceof History, Object.prototype.toString.call(history));\naddEventListener('popstate', e => log('popstate', e.constructor.name, JSON.stringify(e.state), e.state === history.state, file(location.href), e.isTrusted, e.bubbles, e.cancelable));\nonhashchange = e => log('hashchange', e.constructor.name, file(e.oldURL), file(e.newURL), e.isTrusted);\nconst s1 = { n: 1, list: [1, 2] };\nlog('push returns', history.pushState(s1, '', '?a=1'));\nlog('push', history.length - start, JSON.stringify(history.state), history.state === s1, history.state === history.state, location.search, file(location.href), file(document.URL), file(document.getElementById('rel').href));\nhistory.pushState({ n: 2 }, 'ignored', '?b=2#frag');\nlog('push', history.length - start, JSON.stringify(history.state), location.search, location.hash);\nhistory.replaceState({ n: 3 }, '');\nlog('replace', history.length - start, JSON.stringify(history.state), file(location.href));\nhistory.replaceState(null, '', 'history.html?c=3');\nlog('replace url', history.length - start, history.state, file(location.href));\nfor (const [what, f] of [\n  ['cross-origin', () => history.pushState(null, '', 'https://example.com/')],\n  ['other file', () => history.replaceState(null, '', 'other.html')],\n  ['function', () => history.pushState(function () {}, '')],\n]) {\n  try { f(); log(what, 'no error'); } catch (e) { log(what, e.name, e instanceof DOMException); }\n}\nlog('after errors', history.length - start, file(location.href));\nhistory.scrollRestoration = 'manual';\nhistory.scrollRestoration = 'bogus';\nlog('scrollRestoration', history.scrollRestoration);\n\nconst steps = [\n  () => {\n    history.back();\n    Promise.resolve().then(() => log('microtask before the traversal', file(location.href)));\n    log('back called', file(location.href));\n  },\n  () => { history.forward(); },\n  () => {\n    quiet = true;\n    location.hash = 'x';\n    log('hash set', history.length - start, history.state, file(location.href));\n    location.hash = 'x';\n    log('same hash', history.length - start);\n    location.href = '#y';\n    log('href set', history.length - start, file(location.href));\n    quiet = false;\n    setTimeout(next, 10);\n  },\n  () => { history.go(-2); },\n  () => { history.go(-1); },\n  () => {\n    log('scrollRestoration of the entry', history.scrollRestoration);\n    history.go(10);\n    history.pushState({ n: 4 }, '', '?d=4');\n    log('push drops forward', history.length - start, file(location.href), history.scrollRestoration);\n    history.back();\n  },\n  () => {\n    // An empty url resolves against the base URL: the fragment goes. An\n    // omitted, undefined or null url leaves the URL (and fragment) alone.\n    history.replaceState(null, '', '#x');\n    log('fragment set', file(location.href));\n    history.replaceState(null, '', '');\n    log('empty replace', file(location.href));\n    history.replaceState(null, '', '#x');\n    history.pushState(null, '', '');\n    log('empty push', history.length - start, file(location.href));\n    history.replaceState(null, '', '#x');\n    history.pushState(null, '');\n    history.pushState(null, '', undefined);\n    history.pushState(null, '', null);\n    history.replaceState(null, '');\n    log('omitted', history.length - start, file(location.href));\n    setTimeout(next, 10);\n  },\n  () => { log('done', history.length - start, JSON.stringify(history.state), file(location.href)); },\n];\nfunction next() {\n  const step = steps.shift();\n  if (step) step();\n}\nlet quiet = false;\naddEventListener('popstate', () => { if (!quiet) setTimeout(next, 10); });\nsetTimeout(next, 0);\n"
      "\n"
