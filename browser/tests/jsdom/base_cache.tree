#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "base cache"
      "\n"
    <body>
      <pre id="out">
        "none: jsdom/x.png jsdom/x.png\ninserted: https://a.example/one/x.png\nchanged: https://b.example/two/x.png https://b.example/two/x.png\nno href: jsdom/x.png\nrelative: jsdom/sub/x.png\nremoved: jsdom/x.png\nreinserted: jsdom/sub/x.png\npushState: jsdom/x.png\nagain: jsdom/x.png\nabsolute: https://c.example/x.png\nend: jsdom/x.png\n"
      "\n"
      <script>
        "\n// The document base URL is cached; each change that can move it must\n// show in the next relative URL an image resolves.\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\nconst tail = (s) => s.startsWith('http') ? s : s.slice(s.lastIndexOf('/jsdom/') + 1);\n// (baseURI, the URL attributes and the image loads read the cached\n// document base.)\nfunction src() { return tail(new URL('x.png', document.baseURI).href); }\nlog('none:', src(), src());\nconst base = document.createElement('base');\nbase.setAttribute('href', 'https://a.example/one/');\ndocument.head.appendChild(base);\nlog('inserted:', src());\nbase.setAttribute('href', 'https://b.example/two/');\nlog('changed:', src(), src());\nbase.removeAttribute('href');\nlog('no href:', src());\nbase.setAttribute('href', 'sub/');\nlog('relative:', src());\nbase.remove();\nlog('removed:', src());\ndocument.head.appendChild(base);\nlog('reinserted:', src());\nbase.remove();\nhistory.pushState(null, '', 'base_cache.html?q=1');\nlog('pushState:', src());\nhistory.pushState(null, '', 'base_cache.html#z');\nlog('again:', src());\nbase.setAttribute('href', 'https://c.example/');\ndocument.head.appendChild(base);\nlog('absolute:', src());\nbase.remove();\nlog('end:', src());\n"
      "\n"
