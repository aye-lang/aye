#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "url attributes and base"
      "\n"
    <body>
      <a id="link" href="page?q#h">
        "link"
      "\n"
      <pre id="out">
        "-- no base\na.href jsdom/page?q#h jsdom/page  ?q #h\nimg.src jsdom/pic.png\nlink.href jsdom/style.css\nscript.src jsdom/app.js\niframe.src jsdom/frame.html\nform.action jsdom/submit\narea.href jsdom/map\nsource.src jsdom/clip.webm\nvideo.src jsdom/movie.mp4\naudio.src jsdom/sound.ogg\nobject.data jsdom/thing.svg\n-- inserted\na.href https://x.test/dir/page?q#h /dir/page x.test ?q #h\nimg.src https://x.test/dir/pic.png\nlink.href https://x.test/dir/style.css\nscript.src https://x.test/dir/app.js\niframe.src https://x.test/dir/frame.html\nform.action https://x.test/dir/submit\narea.href https://x.test/dir/map\nsource.src https://x.test/dir/clip.webm\nvideo.src https://x.test/dir/movie.mp4\naudio.src https://x.test/dir/sound.ogg\nobject.data https://x.test/dir/thing.svg\nbase.href https://x.test/dir/\n-- relative base\na.href jsdom/sub/page?q#h jsdom/sub/page  ?q #h\nimg.src jsdom/sub/pic.png\nlink.href jsdom/sub/style.css\nscript.src jsdom/sub/app.js\niframe.src jsdom/sub/frame.html\nform.action jsdom/sub/submit\narea.href jsdom/sub/map\nsource.src jsdom/sub/clip.webm\nvideo.src jsdom/sub/movie.mp4\naudio.src jsdom/sub/sound.ogg\nobject.data jsdom/sub/thing.svg\nbase.href jsdom/sub/\n-- changed\na.href https://y.test/other/page?q#h /other/page y.test ?q #h\nimg.src https://y.test/other/pic.png\nlink.href https://y.test/other/style.css\nscript.src https://y.test/other/app.js\niframe.src https://y.test/other/frame.html\nform.action https://y.test/other/submit\narea.href https://y.test/other/map\nsource.src https://y.test/other/clip.webm\nvideo.src https://y.test/other/movie.mp4\naudio.src https://y.test/other/sound.ogg\nobject.data https://y.test/other/thing.svg\n-- removed\na.href jsdom/page?q#h jsdom/page  ?q #h\nimg.src jsdom/pic.png\nlink.href jsdom/style.css\nscript.src jsdom/app.js\niframe.src jsdom/frame.html\nform.action jsdom/submit\narea.href jsdom/map\nsource.src jsdom/clip.webm\nvideo.src jsdom/movie.mp4\naudio.src jsdom/sound.ogg\nobject.data jsdom/thing.svg\n-- fallbacks\nabsent img.src \"\" absent form.action jsdom/url_base.html empty form.action jsdom/url_base.html\nempty img.src jsdom/url_base.html\ninvalid a.href http://a b/ http://:80/\nsource.srcset a.png 1x, b.png 2x\nbase.href no attr jsdom/url_base.html relative jsdom/sub/\n-- pushState\na.href jsdom/url_base.html?pushed=1#frag jsdom/pic.png jsdom/url_base.html?pushed=1\nwith base https://y.test/other/#frag https://y.test/other/\n"
      "\n"
      <script>
        "\n// URL-reflecting attributes resolve against the document's current base\n// URL: a `base` a script inserts, changes or removes, and the document\n// URL after pushState. `base.href` resolves against the document URL.\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\nconst tail = (s) => s.includes('/jsdom/') ? s.slice(s.lastIndexOf('/jsdom/') + 1) : s;\nfunction mk(tag, attr, value) { const e = document.createElement(tag); if (attr) e.setAttribute(attr, value); return e; }\nconst a = document.getElementById('link');\nconst els = [\n  ['img.src', mk('img', 'src', 'pic.png'), 'src'],\n  ['link.href', mk('link', 'href', 'style.css'), 'href'],\n  ['script.src', mk('script', 'src', 'app.js'), 'src'],\n  ['iframe.src', mk('iframe', 'src', 'frame.html'), 'src'],\n  ['form.action', mk('form', 'action', 'submit'), 'action'],\n  ['area.href', mk('area', 'href', 'map'), 'href'],\n  ['source.src', mk('source', 'src', 'clip.webm'), 'src'],\n  ['video.src', mk('video', 'src', 'movie.mp4'), 'src'],\n  ['audio.src', mk('audio', 'src', 'sound.ogg'), 'src'],\n  ['object.data', mk('object', 'data', 'thing.svg'), 'data'],\n];\nfunction show(label) {\n  log('-- ' + label);\n  log('a.href', tail(a.href), tail(a.pathname), a.host, a.search, a.hash);\n  for (const [name, el, prop] of els) log(name, tail(el[prop]));\n}\nshow('no base');\nconst base = document.createElement('base');\nbase.setAttribute('href', 'https://x.test/dir/');\ndocument.head.appendChild(base);\nshow('inserted');\nlog('base.href', tail(base.href));\nbase.href = 'sub/';\nshow('relative base');\nlog('base.href', tail(base.href));\nbase.setAttribute('href', 'https://y.test/other/');\nshow('changed');\nbase.remove();\nshow('removed');\nlog('-- fallbacks');\nlog('absent img.src', JSON.stringify(mk('img').src), 'absent form.action', tail(mk('form').action), 'empty form.action', tail(mk('form', 'action', '').action));\nlog('empty img.src', tail(mk('img', 'src', '').src));\nlog('invalid a.href', mk('a', 'href', 'http://a b/').href, mk('a', 'href', 'http://:80/').href);\nlog('source.srcset', mk('source', 'srcset', 'a.png 1x, b.png 2x').srcset);\nlog('base.href no attr', tail(mk('base').href), 'relative', tail(mk('base', 'href', 'sub/').href));\n// On file: pushState may change only the query and fragment.\nconst frag = mk('a', 'href', '#frag');\nhistory.pushState(null, '', 'url_base.html?pushed=1');\nlog('-- pushState');\nlog('a.href', tail(frag.href), tail(mk('img', 'src', 'pic.png').src), tail(mk('form').action));\ndocument.head.appendChild(base);\nlog('with base', tail(frag.href), tail(base.href));\nbase.remove();\n"
      "\n"
