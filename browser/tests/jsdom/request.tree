#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Request"
      "\n"
    <body>
      <pre id="out">
        "defaults https://example.com/a/b?q=1#frag GET cors same-origin default follow about:client  false\nmore  false true false true 0\ntypes true function 0 [object Request] [object Headers] true function\nurl object https://example.com/x\nmethods GET,POST,PUT,DELETE,HEAD,OPTIONS,patch,Foo\nbad methods TypeError TypeError TypeError TypeError\nget body TypeError TypeError no error no error\nbad args TypeError TypeError TypeError TypeError\nbad init TypeError TypeError TypeError TypeError TypeError\ninit POST same-origin include no-store manual \"\" true sha256-x true false\nheaders 1 text/html text/plain;charset=UTF-8  accept,content-type,x-one\nonly-if-cached only-if-cached\nclone true true https://example.com/a/b?q=1#frag POST true 1 true false\ntext hello true TypeError TypeError hello\njson {\"a\":[1,2]} application/json true\nparams application/x-www-form-urlencoded;charset=UTF-8 a=1&b=x+y\nempty text \"\" false\nfrom headers 1, 2 true\ncopy https://example.com/a/b?q=1#frag POST no-cors v false true abc\noverride patch  o\nfrom used TypeError no error\nsignal true false\nsignal aborted true AbortError true\nnull signal false\npatch patched GET\nheaders api 1, 3 true false [[\"a\",\"1, 3\"]] TypeError TypeError\nforEach y=2;z=1 [[\"k\",\"v\"]] [\"1\",\"3\"]\nrelative true true\nfetch request 200 true application/json false 3 true TypeError\ninit over request TypeError\nfetch post TypeError TypeError\nfetch errors TypeError TypeError AbortError\nreferrer about:client about:client\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\n// Up to pageTests, the same output as Node 22 (absolute URLs only).\nconst U = 'https://example.com/a/b?q=1#frag';\nfunction err(f) {\n  try { f(); return 'no error'; } catch (e) { return e.name; }\n}\nasync function rejects(p) {\n  try { await p; return 'resolved'; } catch (e) { return e.name; }\n}\nasync function requestTests() {\n  const r = new Request(U);\n  log('defaults', r.url, r.method, r.mode, r.credentials, r.cache, r.redirect, r.referrer, r.integrity, r.keepalive);\n  log('more', r.body, r.bodyUsed, r.signal instanceof AbortSignal, r.signal.aborted, r.headers instanceof Headers, [...r.headers].length);\n  log('types', r instanceof Request, typeof Request, Object.keys(r).length, Object.prototype.toString.call(r), Object.prototype.toString.call(r.headers), 'url' in Request.prototype, typeof Request.prototype.clone);\n  log('url object', new Request(new URL('https://example.com/x')).url);\n  log('methods', ['get', 'post', 'Put', 'delete', 'head', 'options', 'patch', 'Foo'].map(m => new Request(U, { method: m }).method).join(','));\n  log('bad methods', err(() => new Request(U, { method: 'CONNECT' })), err(() => new Request(U, { method: 'trace' })), err(() => new Request(U, { method: 'a b' })), err(() => new Request(U, { method: '' })));\n  log('get body', err(() => new Request(U, { body: 'x' })), err(() => new Request(U, { method: 'HEAD', body: 'x' })), err(() => new Request(U, { body: null })), err(() => new Request(U, { body: undefined })));\n  log('bad args', err(() => new Request()), err(() => Request(U)), err(() => new Request('http://a b/')), err(() => new Request('https://u:p@example.com/')));\n  log('bad init', err(() => new Request(U, { mode: 'navigate' })), err(() => new Request(U, { mode: 'bogus' })), err(() => new Request(U, { credentials: 'all' })), err(() => new Request(U, { cache: 'only-if-cached' })), err(() => new Request(U, { redirect: 'never' })));\n  const o = new Request(U, { method: 'POST', mode: 'same-origin', credentials: 'include', cache: 'no-store', redirect: 'manual', referrer: '', keepalive: true, integrity: 'sha256-x', headers: { 'X-One': ' 1 ', accept: 'text/html' }, body: 'hello' });\n  log('init', o.method, o.mode, o.credentials, o.cache, o.redirect, JSON.stringify(o.referrer), o.keepalive, o.integrity, o.body !== null, o.bodyUsed);\n  log('headers', o.headers.get('x-one'), o.headers.get('Accept'), o.headers.get('content-type'), o.headers.get('missing'), [...o.headers.keys()].join(','));\n  log('only-if-cached', new Request(U, { cache: 'only-if-cached', mode: 'same-origin' }).cache);\n  const c = o.clone();\n  log('clone', c instanceof Request, c !== o, c.url, c.method, c.headers !== o.headers, c.headers.get('x-one'), c.keepalive, c.bodyUsed);\n  log('text', await o.text(), o.bodyUsed, await rejects(o.text()), err(() => o.clone()), await c.text());\n  const j = new Request(U, { method: 'PUT', body: '{\"a\":[1,2]}', headers: [['Content-Type', 'application/json']] });\n  log('json', JSON.stringify(await j.json()), j.headers.get('content-type'), j.bodyUsed);\n  const p = new Request(U, { method: 'POST', body: new URLSearchParams({ a: '1', b: 'x y' }) });\n  log('params', p.headers.get('content-type'), await p.text());\n  log('empty text', JSON.stringify(await new Request(U).text()), new Request(U).bodyUsed);\n  const h = new Headers();\n  h.append('X-A', '1');\n  h.append('x-a', '2');\n  h.set('B', 'b');\n  log('from headers', new Request(U, { headers: h }).headers.get('x-a'), new Request(U, { headers: h }).headers !== h);\n  const base = new Request(U, { method: 'POST', body: 'abc', headers: { 'x-k': 'v' }, mode: 'no-cors' });\n  const copy = new Request(base);\n  log('copy', copy.url, copy.method, copy.mode, copy.headers.get('x-k'), copy.bodyUsed, base.bodyUsed, await copy.text());\n  const over = new Request(new Request(U, { headers: { 'x-k': 'v' } }), { method: 'patch', headers: { 'x-o': 'o' } });\n  log('override', over.method, over.headers.get('x-k'), over.headers.get('x-o'));\n  const used = new Request(U, { method: 'POST', body: 'z' });\n  await used.text();\n  log('from used', err(() => new Request(used)), err(() => new Request(used, { body: 'new' })));\n  const ac = new AbortController();\n  const s = new Request(U, { signal: ac.signal });\n  log('signal', s.signal !== ac.signal, s.signal.aborted);\n  ac.abort();\n  log('signal aborted', s.signal.aborted, s.signal.reason && s.signal.reason.name, new Request(U, { signal: AbortSignal.abort() }).signal.aborted);\n  log('null signal', new Request(U, { signal: null }).signal.aborted);\n  Request.prototype.extra = function () { return 'patched ' + this.method; };\n  log('patch', new Request(U).extra());\n  delete Request.prototype.extra;\n  const hh = new Headers({ b: '2', a: '1' });\n  hh.append('a', '3');\n  hh.delete('b');\n  log('headers api', hh.get('a'), hh.has('A'), hh.has('b'), JSON.stringify([...hh]), err(() => new Headers({ 'a b': '1' })), err(() => hh.set('x', 'a\\nb')));\n  const seen = [];\n  new Headers([['z', '1'], ['y', '2']]).forEach((v, k) => seen.push(k + '=' + v));\n  log('forEach', seen.join(';'), JSON.stringify([...new Headers(new Headers({ k: 'v' })).entries()]), JSON.stringify([...new Headers({ c: '3', a: '1' }).values()]));\n}\n\n// What Node cannot show: URLs resolved against the document, and fetch.\nasync function pageTests() {\n  const rel = new Request('scripts/items.json');\n  log('relative', rel.url === new URL('scripts/items.json', document.baseURI).href, rel.url.endsWith('/browser/tests/jsdom/scripts/items.json'));\n  const res = await fetch(new Request('scripts/items.json'));\n  log('fetch request', res.status, res.ok, res.headers.get('Content-Type'), res.bodyUsed, (await res.json()).length, res.bodyUsed, await rejects(res.text()));\n  const res2 = await fetch(new Request('scripts/nothing.json', { method: 'POST', body: 'x' }), { method: 'GET', body: null }).catch(e => e.name);\n  log('init over request', res2);\n  log('fetch post', await rejects(fetch(new Request('scripts/items.json', { method: 'POST', body: 'x' }))), await rejects(fetch(new Request('scripts/items.json'), { method: 'POST' })));\n  log('fetch errors', await rejects(fetch('http://a b/')), await rejects(fetch('scripts/items.json', { body: 'x' })), await rejects(fetch(new Request('scripts/items.json', { signal: AbortSignal.abort() }))));\n  log('referrer', new Request('x', { referrer: 'https://elsewhere.example/' }).referrer, new Request('x', { referrer: 'about:client' }).referrer);\n}\nrequestTests().then(pageTests).catch(e => log('FAIL', e));\n"
      "\n"
