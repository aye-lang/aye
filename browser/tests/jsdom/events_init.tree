#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Event constructors and init"
      "\n"
    <body>
      <div id="outer">
        <button id="b">
          "b"
      "\n"
      <pre id="out">
        "ping false false false false true number\nTypeError\nbutton ping false 2\nbutton ping false 2\nouter ping [object Object] true true true\n 0\ntrue true\nbutton ping true 2\nouter ping old true true true\nbutton ping false 2\nouter ping  true true false\nclick true true\ndispatched false\nmouse 7 8 true true\nNotSupportedError\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\nconst b = document.getElementById('b');\nconst outer = document.getElementById('outer');\nouter.addEventListener('ping', e => log('outer', e.type, e.detail, e.bubbles, e.target === b, e instanceof CustomEvent));\nb.addEventListener('ping', e => log('button', e.type, e.cancelable, e.eventPhase));\n// The constructors.\nconst e1 = new Event('ping');\nlog(e1.type, e1.bubbles, e1.cancelable, e1.defaultPrevented, e1.isTrusted, e1 instanceof Event, typeof e1.timeStamp);\nlet missing = '';\ntry { new Event(); } catch (e) { missing = e.name; }\nlog(missing);\nb.dispatchEvent(e1);\nb.dispatchEvent(new CustomEvent('ping', { bubbles: true, detail: { n: 1 } }));\nlog(new CustomEvent('x').detail, new CustomEvent('x', { detail: 0 }).detail);\n// The old way: createEvent, then initEvent or initCustomEvent.\nconst e2 = document.createEvent('CustomEvent');\nlog(e2 instanceof CustomEvent, e2.type === '');\ne2.initCustomEvent('ping', true, true, 'old');\nb.dispatchEvent(e2);\nconst e3 = document.createEvent('Event');\ne3.initEvent('ping', true, false);\nb.dispatchEvent(e3);\nconst e4 = document.createEvent('HTMLEvents');\ne4.initEvent('click', true, true);\nb.addEventListener('click', e => { e.preventDefault(); log('click', e instanceof Event, e.defaultPrevented); });\nlog('dispatched', b.dispatchEvent(e4));\nconst e5 = document.createEvent('MouseEvents');\ne5.initMouseEvent('mousedown', true, true, window, 1, 0, 0, 7, 8, false, false, true, false, 0, null);\nb.addEventListener('mousedown', e => log('mouse', e.clientX, e.clientY, e.shiftKey, e instanceof MouseEvent));\nb.dispatchEvent(e5);\nlet bad = '';\ntry { document.createEvent('NoSuchEvent'); } catch (e) { bad = e.name; }\nlog(bad);\n"
      "\n"
