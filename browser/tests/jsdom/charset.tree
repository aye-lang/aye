#document
  <!DOCTYPE html>
  <html>
    <head>
      <meta charset="euc-kr">
      "\n"
      <title>
        "Character set"
      "\n"
      <!--  document.characterSet names the encoding the page was decoded from.  -->
      "\n"
    <body>
      <p id="out">
        "한국어 EUC-KR EUC-KR EUC-KR"
      "\n"
      <script>
        "\ndocument.getElementById(\"out\").textContent += \" \" + document.characterSet + \" \" + document.charset + \" \" + document.inputEncoding;\n"
      "\n"
