#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Iframes"
      "\n"
    <body>
      <iframe id="a" name="first" src="../frames/iframe_child.html">
      "\n"
      <iframe id="b" srcdoc="<p>Inline <b>srcdoc</b></p><script>console.log('srcdoc:', location.href, '| parent title', parent.document.title)</script>">
      "\n"
      <iframe id="c" sandbox="" srcdoc="<script>console.log('sandboxed: ran')</script><p>sandboxed</p>">
      "\n"
      <iframe id="d" sandbox="allow-scripts" srcdoc="<script>try { parent.document } catch (e) { console.log('opaque:', e.name) } parent.postMessage('hi from opaque', '*')</script>">
      "\n"
      <iframe id="e">
      "\n"
      <pre id="out">
        "length 5 | frames[0] is a true | window[1] is b true\ntop is window true | parent is window true | frameElement \nc document  | e document about:blank\nb text Inline srcdocconsole.log('srcdoc:', location.href, '| parent title', parent.document.title)\na name true true\nmade made by a script | length 6\na load: Child text\nparent load\nmessage \"hi from opaque\" | from a false | origin null | true\nmessage {\"reply\":2} | from a true | origin null | true\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\nconst a = document.getElementById('a');\nlog('length', window.length, '| frames[0] is a', frames[0] === a.contentWindow, '| window[1] is b', window[1] === document.getElementById('b').contentWindow);\nlog('top is window', top === window, '| parent is window', parent === window, '| frameElement', frameElement);\nlog('c document', document.getElementById('c').contentDocument, '| e document', document.getElementById('e').contentDocument.URL);\nlog('b text', document.getElementById('b').contentDocument.body.textContent);\nlog('a name', frames.first === undefined, a.contentWindow.location.href.endsWith('iframe_child.html'));\nconst made = document.createElement('iframe');\nmade.srcdoc = '<p id=x>made by a script</p>';\ndocument.body.appendChild(made);\nlog('made', made.contentDocument.getElementById('x').textContent, '| length', window.length);\na.addEventListener('load', () => {\n  log('a load:', a.contentDocument.getElementById('msg').textContent);\n  a.contentDocument.getElementById('msg').textContent = 'Changed by the parent';\n  a.contentWindow.postMessage({ n: 1 }, '*');\n});\naddEventListener('message', e => log('message', JSON.stringify(e.data), '| from a', e.source === a.contentWindow, '| origin', e.origin, '|', e instanceof MessageEvent));\naddEventListener('load', () => log('parent load'));\n"
      "\n"
      <iframe srcdoc="<p id=x>made by a script</p>">
