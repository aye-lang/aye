#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Style sheet changes after a style read"
      "\n"
    <body>
      <p id="p">
        "text"
      "\n"
      "\n"
      <pre id="out">
        "none rgb(0, 0, 0)\ndoc style rgb(0, 128, 128)\ndoc text rgb(0, 0, 128)\ndoc media off rgb(0, 0, 0)\ndoc media on rgb(0, 0, 128)\ndoc inserted rgb(255, 0, 255)\ndoc deleted rgb(0, 0, 128)\ndoc disabled rgb(0, 0, 0)\ndoc enabled rgb(0, 0, 128)\ndoc removed rgb(0, 0, 0)\nadopted rgb(255, 0, 0)\nreplaced rgb(0, 128, 0)\ninserted rgb(128, 0, 128)\ndisabled rgb(0, 0, 0) true\nenabled rgb(128, 0, 128) false\ndropped rgb(0, 0, 0)\nshadow rgb(0, 0, 0)\nshadow style rgb(0, 0, 255)\nshadow text rgb(128, 128, 0)\nshadow media off rgb(0, 0, 0)\nshadow media on rgb(128, 128, 0)\nshadow removed rgb(0, 0, 0)\nshadow adopted rgb(128, 0, 0) rgb(0, 0, 0)\nshadow replaced rgb(0, 255, 0)\nshadow disabled rgb(0, 0, 0)\nshadow dropped rgb(0, 0, 0)\nhost out \"\"\nhost back rgb(0, 255, 0)\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\nconst p = document.getElementById('p');\nlog('none', getComputedStyle(p).color);\n// The document's style elements: adding, changing the text and the\n// media, removing.\nconst docStyle = document.createElement('style');\ndocStyle.textContent = 'p { color: teal }';\ndocument.head.appendChild(docStyle);\nlog('doc style', getComputedStyle(p).color);\ndocStyle.textContent = 'p { color: navy }';\nlog('doc text', getComputedStyle(p).color);\ndocStyle.setAttribute('media', 'print');\nlog('doc media off', getComputedStyle(p).color);\ndocStyle.removeAttribute('media');\nlog('doc media on', getComputedStyle(p).color);\n// The CSSOM: rules a script inserts into, deletes from, or disables in\n// an element's sheet.\ndocStyle.sheet.insertRule('p { color: fuchsia }', 1);\nlog('doc inserted', getComputedStyle(p).color);\ndocStyle.sheet.deleteRule(1);\nlog('doc deleted', getComputedStyle(p).color);\ndocStyle.sheet.disabled = true;\nlog('doc disabled', getComputedStyle(p).color);\ndocStyle.sheet.disabled = false;\nlog('doc enabled', getComputedStyle(p).color);\ndocStyle.remove();\nlog('doc removed', getComputedStyle(p).color);\n// Adopted sheets: adopting, replacing the text, disabling, dropping.\nconst sheet = new CSSStyleSheet();\nsheet.replaceSync('p { color: red }');\ndocument.adoptedStyleSheets = [sheet];\nlog('adopted', getComputedStyle(p).color);\nsheet.replaceSync('p { color: green }');\nlog('replaced', getComputedStyle(p).color);\nsheet.insertRule('p { color: purple }', 1);\nlog('inserted', getComputedStyle(p).color);\nsheet.disabled = true;\nlog('disabled', getComputedStyle(p).color, sheet.disabled);\nsheet.disabled = false;\nlog('enabled', getComputedStyle(p).color, sheet.disabled);\ndocument.adoptedStyleSheets = [];\nlog('dropped', getComputedStyle(p).color);\n// A shadow tree's style element and adopted sheets.\nconst root = document.getElementById('host').attachShadow({ mode: 'open' });\nroot.innerHTML = '<b id=\"b\">b</b>';\nconst b = root.getElementById('b');\nlog('shadow', getComputedStyle(b).color);\nconst style = document.createElement('style');\nstyle.textContent = 'b { color: blue }';\nroot.appendChild(style);\nlog('shadow style', getComputedStyle(b).color);\nstyle.textContent = 'b { color: olive }';\nlog('shadow text', getComputedStyle(b).color);\nstyle.setAttribute('media', 'print');\nlog('shadow media off', getComputedStyle(b).color);\nstyle.removeAttribute('media');\nlog('shadow media on', getComputedStyle(b).color);\nstyle.remove();\nlog('shadow removed', getComputedStyle(b).color);\nconst shadowSheet = new CSSStyleSheet();\nshadowSheet.replaceSync('b { color: maroon }');\nroot.adoptedStyleSheets = [shadowSheet];\nlog('shadow adopted', getComputedStyle(b).color, getComputedStyle(p).color);\nshadowSheet.replaceSync('b { color: lime }');\nlog('shadow replaced', getComputedStyle(b).color);\nshadowSheet.disabled = true;\nlog('shadow disabled', getComputedStyle(b).color);\nshadowSheet.disabled = false;\nroot.adoptedStyleSheets = [];\nlog('shadow dropped', getComputedStyle(b).color);\n// The host leaving the document takes its shadow sheets along.\nroot.adoptedStyleSheets = [shadowSheet];\nconst host = document.getElementById('host');\nhost.remove();\nlog('host out', JSON.stringify(getComputedStyle(b).color));\ndocument.body.appendChild(host);\nlog('host back', getComputedStyle(b).color);\n"
      "\n"
      <div id="host">
        #shadow-root (open)
          <b id="b">
            "b"
