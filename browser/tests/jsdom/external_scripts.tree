#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "External scripts"
      "\n"
    <body>
      <pre id="out">
        "external script, relative to the page\ntyped inline\nnomodule runs\nlast inline, sees number\nasync script (runs like defer)\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\n"
      "\n"
      <script src="scripts/first.js">
      "\n"
      <script type="module">
        "log('module: not run');"
      "\n"
      <script type="text/template">
        "log('template: not run');"
      "\n"
      <script type="text/javascript">
        "log('typed inline');"
      "\n"
      <script src="scripts/async.js" async="">
      "\n"
      <script src="scripts/missing.js">
      "\n"
      <script nomodule="">
        "log('nomodule runs');"
      "\n"
      <script>
        "log('last inline, sees', typeof fromFirst);"
      "\n"
