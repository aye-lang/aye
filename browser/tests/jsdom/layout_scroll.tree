#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Scrolling from scripts"
      "\n"
      <style>
        "\nbody { margin: 0 }\n#list { height: 100px; overflow: auto; border: 5px solid; padding: 10px }\n.item { height: 40px }\n#plain { height: 20px }\n#tall { height: 2000px }\n#fixed { position: fixed; top: 10px; left: 0; width: 50px; height: 4000px }\n"
      "\n"
    <body>
      <div id="list">
        <div class="item" id="i0">
        <div class="item">
        <div class="item">
        <div class="item" id="i3">
        <div class="item">
      "\n"
      <div id="plain">
        <div style="height: 50px">
      "\n"
      <div id="fixed">
      "\n"
      <div id="tall">
      "\n"
      <pre id="out">
        "area 790 120 790 260 0\nscrolled 50 85 85 135 0\nclamped 140 140\nscrollTo 0\nscrollBy 42\nscroll 7 0\nplain 0 50 20\ndocument true 0 0 0\nwindow 300 300 300 true 150\nfixed 10 10\nfixed area true\nwindow 201 201\nwindow max true\ninto view 140 75 0\ninto view end 0 0\ninto view nearest 0\nshrunk 100 220\nevents list 100, window 0 true\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\nconst $ = id => document.getElementById(id);\nconst list = $('list');\nconst events = [];\nlist.addEventListener('scroll', e => events.push('list ' + list.scrollTop));\nwindow.addEventListener('scroll', e => events.push('window ' + scrollY + ' ' + (e.target === document)));\n// A scroll container: its scrolling area is its padding box and the\n// content that overflows it.\nlog('area', list.clientWidth, list.clientHeight, list.scrollWidth, list.scrollHeight, list.scrollTop);\nconst top0 = $('i3').getBoundingClientRect().top;\nlist.scrollTop = 50;\nlog('scrolled', list.scrollTop, $('i3').getBoundingClientRect().top, top0 - 50, $('i3').offsetTop, list.getBoundingClientRect().top);\n// Offsets stay within the scrolling area.\nlist.scrollTop = 1e6;\nlog('clamped', list.scrollTop, list.scrollHeight - list.clientHeight);\nlist.scrollTo(0, -5);\nlog('scrollTo', list.scrollTop);\nlist.scrollBy({ top: 30 });\nlist.scrollBy(0, 12);\nlog('scrollBy', list.scrollTop);\nlist.scroll({ top: 7, left: 99 });\nlog('scroll', list.scrollTop, list.scrollLeft);\n// Only scroll containers scroll.\n$('plain').scrollTop = 20;\nlog('plain', $('plain').scrollTop, $('plain').scrollHeight, $('plain').clientHeight);\n// The window: the document is the scrolling area.\nlog('document', document.documentElement.scrollHeight > 2000, scrollX, scrollY, pageYOffset);\nconst tallTop = $('tall').getBoundingClientRect().top;\nwindow.scrollTo(0, 300);\nlog('window', scrollY, pageYOffset, document.documentElement.scrollTop, $('tall').getBoundingClientRect().top === tallTop - 300, $('tall').offsetTop);\nlog('fixed', $('fixed').getBoundingClientRect().top, $('fixed').offsetTop);\n// A fixed box is in the viewport: it does not make the document taller.\nlog('fixed area', document.documentElement.scrollHeight < 4000);\nwindow.scrollBy(0, -100);\ndocument.documentElement.scrollTop += 1;\nlog('window', scrollY, document.scrollingElement.scrollTop);\nscrollTo({ top: 1e7 });\nlog('window max', scrollY === document.documentElement.scrollHeight - innerHeight);\n// scrollIntoView: the list, then the window.\nscrollTo(0, 0);\n$('last').scrollIntoView();\nlog('into view', list.scrollTop, scrollY, $('last').getBoundingClientRect().top);\n$('i0').scrollIntoView({ block: 'end' });\nlog('into view end', list.scrollTop, scrollY);\n$('i0').scrollIntoView({ block: 'nearest' });\nlog('into view nearest', list.scrollTop);\n// A list that changed size keeps its offset within the new area.\nlist.scrollTop = 100;\nlist.removeChild($('last'));\nlog('shrunk', list.scrollTop, list.scrollHeight);\nsetTimeout(() => log('events', events.join(', ')), 10);\n"
      "\n"
