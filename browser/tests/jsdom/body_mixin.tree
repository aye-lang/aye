#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Body mixin"
      "\n"
    <body>
      <pre id="out">
        "string 200 true \"\" text/plain;charset=UTF-8 false function function function\narrayBuffer true 3 104,195,169 true\nused TypeError TypeError TypeError TypeError TypeError TypeError\nblob true 3 text/plain;charset=utf-8 abc\nbuffer body  1,2,250\nview body 2 \"\" AB\nblob body text/custom text/custom xyz\nblob text q \nparams application/x-www-form-urlencoded;charset=UTF-8 [[\"a\",\"1\"],[\"b\",\"x y\"]]\nmultipart true\nmultipart back true [[\"name\",\"value 1\"],[\"name\",\"two\\r\\nlines\"],[\"file\",\"File\",\"a.txt\",\"text/plain\",9]] file body\nformData errors TypeError TypeError TypeError\nurlencoded [[\"a\",\"1\"],[\"b\",\" \"],[\"c\",\"\"]]\nhand multipart [[\"k\",\"v\"],[\"f\",\"File\",\"b.bin\",\"application/octet-stream\",2]]\njson {\"a\":[1]} SyntaxError\ninit 404 false Nope 1 text/html\nbad init RangeError RangeError\nnull body   false \"\" false 0 0 false\nbody true true false false function\nreader true false TypeError TypeError\nread false true 104,105 true\nread end true  TypeError TypeError\nreleased false\ncancel true {\"done\":true}\nbody then text abc true\nstream body true  one two true\nchunks 7 | 8,9\nlate hi\nclone twice twice v true true\nstream clone ab ab\nrequest body true  112,97,121,108,111,97,100 application/x-www-form-urlencoded [[\"payload\",\"\"]]\nrequest read payload true TypeError\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\n// The same output as Node 22: the Fetch body mixin (text, json,\n// arrayBuffer, blob, formData, body) of Response and Request.\nconst U = 'https://example.com/';\nfunction err(f) {\n  try { f(); return 'no error'; } catch (e) { return e.name; }\n}\nasync function rejects(p) {\n  try { await p; return 'resolved'; } catch (e) { return e.name; }\n}\nconst bytes = buf => Array.from(new Uint8Array(buf)).join(',');\nconst entries = fd => JSON.stringify([...fd].map(([k, v]) => typeof v === 'string' ? [k, v] : [k, v.constructor.name, v.name, v.type, v.size]));\nasync function bodyTests() {\n  const s = new Response('hé');\n  log('string', s.status, s.ok, JSON.stringify(s.statusText), s.headers.get('content-type'), s.bodyUsed, typeof s.arrayBuffer, typeof s.blob, typeof s.formData);\n  const ab = await s.arrayBuffer();\n  log('arrayBuffer', ab instanceof ArrayBuffer, ab.byteLength, bytes(ab), s.bodyUsed);\n  log('used', await rejects(s.text()), await rejects(s.json()), await rejects(s.arrayBuffer()), await rejects(s.blob()), await rejects(s.formData()), err(() => s.clone()));\n  const b = await new Response('abc').blob();\n  log('blob', b instanceof Blob, b.size, b.type, await b.text());\n  const buf = new Uint8Array([1, 2, 250]).buffer;\n  const r1 = new Response(buf);\n  log('buffer body', r1.headers.get('content-type'), bytes(await r1.arrayBuffer()));\n  const b1 = await new Response(new Uint8Array([65, 66])).blob();\n  log('view body', b1.size, JSON.stringify(b1.type), await b1.text());\n  const r2 = new Response(new Blob(['xyz'], { type: 'Text/Custom' }));\n  const b2 = await r2.blob();\n  log('blob body', r2.headers.get('content-type'), b2.type, await b2.text());\n  log('blob text', await new Response(new Blob(['q'])).text(), new Response(new Blob(['q'])).headers.get('content-type'));\n  const p = new Response(new URLSearchParams({ a: '1', b: 'x y' }));\n  log('params', p.headers.get('content-type'), entries(await p.formData()));\n  const fd = new FormData();\n  fd.append('name', 'value 1');\n  fd.append('name', 'two\\nlines');\n  fd.append('file', new File(['file body'], 'a.txt', { type: 'text/plain' }));\n  const m = new Response(fd);\n  log('multipart', m.headers.get('content-type').startsWith('multipart/form-data; boundary='));\n  const back = await m.formData();\n  log('multipart back', back instanceof FormData, entries(back), await back.get('file').text());\n  log('formData errors', await rejects(new Response('a=1').formData()), await rejects(new Response('a=1', { headers: { 'content-type': 'application/json' } }).formData()), await rejects(new Response(null).formData()));\n  const typed = new Response('a=1&b=%20&c', { headers: { 'Content-Type': 'application/x-www-form-urlencoded' } });\n  log('urlencoded', entries(await typed.formData()));\n  const hand = '--XyZ\\r\\nContent-Disposition: form-data; name=\"k\"\\r\\n\\r\\nv\\r\\n--XyZ\\r\\nContent-Disposition: form-data; name=\"f\"; filename=\"b.bin\"\\r\\nContent-Type: application/octet-stream\\r\\n\\r\\n\\x01\\x02\\r\\n--XyZ--\\r\\n';\n  const hf = await new Response(hand, { headers: { 'content-type': 'multipart/form-data; boundary=XyZ' } }).formData();\n  log('hand multipart', entries(hf));\n  log('json', JSON.stringify(await new Response('{\"a\":[1]}').json()), await rejects(new Response('{').json()));\n  const st = new Response('x', { status: 404, statusText: 'Nope', headers: { 'X-A': '1', 'content-type': 'text/html' } });\n  log('init', st.status, st.ok, st.statusText, st.headers.get('x-a'), st.headers.get('content-type'));\n  log('bad init', err(() => new Response('x', { status: 99 })), err(() => new Response('x', { status: 600 })));\n}\nasync function streamTests() {\n  const n = new Response(null);\n  log('null body', n.body, new Response().body, n.bodyUsed, JSON.stringify(await n.text()), n.bodyUsed, (await n.arrayBuffer()).byteLength, (await n.blob()).size, n.bodyUsed);\n  const r = new Response('hi');\n  const body = r.body;\n  log('body', body instanceof ReadableStream, r.body === body, body.locked, r.bodyUsed, typeof ReadableStream);\n  const reader = body.getReader();\n  log('reader', body.locked, r.bodyUsed, err(() => body.getReader()), await rejects(r.text()));\n  const c1 = await reader.read();\n  log('read', c1.done, c1.value instanceof Uint8Array, bytes(c1.value), r.bodyUsed);\n  const c2 = await reader.read();\n  log('read end', c2.done, c2.value, await rejects(r.text()), err(() => r.clone()));\n  reader.releaseLock();\n  log('released', body.locked);\n  const r3 = new Response('cancel me');\n  const rd3 = r3.body.getReader();\n  await rd3.cancel();\n  log('cancel', r3.bodyUsed, JSON.stringify(await rd3.read()));\n  const r4 = new Response('abc');\n  r4.body;\n  log('body then text', await r4.text(), r4.bodyUsed);\n  const stream = new ReadableStream({\n    start(controller) {\n      controller.enqueue(new TextEncoder().encode('one '));\n      controller.enqueue(new TextEncoder().encode('two'));\n      controller.close();\n    },\n  });\n  const fromStream = new Response(stream);\n  log('stream body', fromStream.body === stream, fromStream.headers.get('content-type'), await fromStream.text(), fromStream.bodyUsed);\n  const chunks = [];\n  const rs = new ReadableStream({ start(c) { c.enqueue(new Uint8Array([7])); c.enqueue(new Uint8Array([8, 9])); c.close(); } }).getReader();\n  for (let x = await rs.read(); !x.done; x = await rs.read()) chunks.push(bytes(x.value));\n  log('chunks', chunks.join(' | '));\n  const late = new ReadableStream({ start(c) { setTimeout(() => { c.enqueue(new Uint8Array([104, 105])); c.close(); }, 0); } });\n  log('late', await new Response(late).text());\n  const orig = new Response('twice', { headers: { 'x-h': 'v' } });\n  const copy = orig.clone();\n  log('clone', await orig.text(), await copy.text(), copy.headers.get('x-h'), orig.bodyUsed, copy.bodyUsed);\n  const so = new Response(new ReadableStream({ start(c) { c.enqueue(new Uint8Array([97, 98])); c.close(); } }));\n  const sc = so.clone();\n  log('stream clone', await so.text(), await sc.text());\n  const req = new Request(U, { method: 'POST', body: 'payload', headers: { 'content-type': 'application/x-www-form-urlencoded' } });\n  log('request body', req.body instanceof ReadableStream, new Request(U).body, bytes(await req.clone().arrayBuffer()), (await req.clone().blob()).type, entries(await req.clone().formData()));\n  const rr = req.body.getReader();\n  const rc = await rr.read();\n  log('request read', new TextDecoder().decode(rc.value), req.bodyUsed, await rejects(req.text()));\n}\nbodyTests().then(streamTests).catch(e => log('FAIL', e));\n"
      "\n"
