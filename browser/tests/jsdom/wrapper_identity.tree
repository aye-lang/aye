#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Wrappers of detached nodes the browser still holds"
      "\n"
    <body>
      <div id="box">
      "\n"
      <iframe id="f" srcdoc="<p id=q>in a frame</p>">
      "\n"
      <pre id="out">
        "list child expando kept state kept\nframe q expando kept state kept\nrecord victim expando kept state kept\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\nconst state = new WeakMap();\nlet junk = [];\nfunction churn() { for (let i = 0; i < 60000; i++) { junk.push({ i }); if (junk.length > 1000) junk = []; } }\n// A removed node that only a pending mutation record holds.\nconst mo = new MutationObserver(records => {\n  for (const r of records) for (const n of r.removedNodes) log('record', n.id, n.expando, state.get(n) && state.get(n).v);\n});\nmo.observe(document.getElementById('box'), { childList: true });\n(function () {\n  const p = document.getElementById('victim');\n  p.expando = 'expando kept';\n  state.set(p, { v: 'state kept' });\n  p.remove();\n})();\nchurn();\n// A detached child that only a live NodeList holds.\nconst kids = (function () {\n  const d = document.createElement('div');\n  d.innerHTML = '<i id=\"child\">child</i>';\n  const c = d.firstChild;\n  c.expando = 'expando kept';\n  state.set(c, { v: 'state kept' });\n  return d.childNodes;\n})();\nchurn();\nlog('list', kids[0].id, kids[0].expando, state.get(kids[0]) && state.get(kids[0]).v);\n// A node of another document (a frame's), reached again from there.\nconst frameDoc = () => document.getElementById('f').contentDocument;\n(function () {\n  const q = frameDoc().getElementById('q');\n  q.expando = 'expando kept';\n  state.set(q, { v: 'state kept' });\n})();\nchurn();\nconst q = frameDoc().getElementById('q');\nlog('frame', q.id, q.expando, state.get(q) && state.get(q).v);\n"
      "\n"
