#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Web APIs"
      "\n"
    <body>
      <div id="box">
        <img id="lazy" data-src="a.png" src="a.png">
      "\n"
      <pre id="out">
        "https://user:pw@example.com:8080/b/c?x=1&y=two+words#frag https://example.com:8080 https: user pw example.com:8080 example.com 8080 /b/c ?x=1&y=two+words #frag\nhttps://user:pw@example.com:8080/new/path?x=1&y=two+words&z=a+b%26c#top two words true x,y,z\nhttps://user:pw@example.com:8080/new/path?q=1#top 1 {\"u\":\"https://user:pw@example.com:8080/new/path?q=1#top\"} http://example.com/ http://example.com/b\nTypeError false true null\na=1+&a=%21%27%28%29%7E*&b=2 2 3 A%zz|2 x=y\na=only 1\naGVsbG8sIHdvcmxk hello, world  hi //4=\nInvalidCharacterError InvalidCharacterError\n10 97,195,169,226,130,172,240,159,152,128 aé€😀 �a� utf-8\nfalse\ntrue AbortError 2 why\nAbortError string true 4\nping ping true\n1 true\nmedia true false false screen\nrecords 1\nxhr sent 1\nsync xhr 4 200 3\ncustom function \nimage IMG 10 OPTION Label v true\norigin null true function\nfetch aborted AbortError\ndefined XY\ndecode without src EncodingError\ndecoded\nvisible lazy true true\nxhr load 200 3 application/json 1,2,3,4\nxhr error 4 0\nidle false true\nresized 1 box\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\n// The same results as Node: URL, URLSearchParams, atob/btoa, TextEncoder,\n// AbortController, EventTarget.\nconst u = new URL('../b/c?x=1&y=two+words#frag', 'https://user:pw@Example.com:8080/a/index.html');\nlog(u.href, u.origin, u.protocol, u.username, u.password, u.host, u.hostname, u.port, u.pathname, u.search, u.hash);\nu.searchParams.append('z', 'a b&c');\nu.hash = 'top';\nu.pathname = 'new/path';\nlog(u.href, u.searchParams.get('y'), u.searchParams.has('x'), [...u.searchParams.keys()].join(','));\nu.search = '?q=1';\nlog(u.toString(), u.searchParams.get('q'), JSON.stringify({ u }), String(new URL('http://example.com')), new URL('HTTP://EXAMPLE.COM:80/./a/../b').href);\nlet bad = '';\ntry { new URL('not a url'); } catch (e) { bad = e.name; }\nlog(bad, URL.canParse('/x'), URL.canParse('/x', 'http://h/'), new URL('mailto:a@b.c').origin);\nconst p = new URLSearchParams({ b: '2', a: '1 ' });\np.append('a', \"!'()~*\");\np.sort();\nlog(p.toString(), p.getAll('a').length, p.size, new URLSearchParams('?k=%41%zz&e=&k=2').getAll('k').join('|'), new URLSearchParams([['x', 'y']]).toString());\np.set('a', 'only');\np.delete('b');\nconst seen = [];\np.forEach((v, k) => seen.push(k + '=' + v));\nlog(seen.join(';'), [...p].length);\nlog(btoa('hello, world'), atob('aGVsbG8sIHdvcmxk'), btoa(''), atob(' aGk= '), btoa('\\xff\\xfe'));\nlet e1 = '', e2 = '';\ntry { btoa('Ā'); } catch (e) { e1 = e.name; }\ntry { atob('a'); } catch (e) { e2 = e.name; }\nlog(e1, e2);\nconst bytes = new TextEncoder().encode('aé€😀');\nlog(bytes.length, Array.from(bytes).join(','), new TextDecoder().decode(bytes), new TextDecoder().decode(new Uint8Array([0xff, 0x61, 0xe2, 0x82])), new TextEncoder().encoding);\nconst ac = new AbortController();\nlet fired = 0;\nac.signal.addEventListener('abort', () => fired++);\nac.signal.onabort = () => fired++;\nlog(ac.signal.aborted);\nac.abort();\nac.abort();\nlog(ac.signal.aborted, ac.signal.reason.name, fired, AbortSignal.abort('why').reason);\nlet thrown = '';\ntry { ac.signal.throwIfAborted(); } catch (e) { thrown = e.name; }\nlog(thrown, typeof crypto.randomUUID(), /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(crypto.randomUUID()), crypto.getRandomValues(new Uint8Array(4)).length);\nclass Emitter extends EventTarget { constructor() { super(); this.n = 0; } }\nconst em = new Emitter();\nem.addEventListener('ping', ev => { em.n++; log('ping', ev.type, ev.target === em); });\nem.dispatchEvent(new Event('ping'));\nlog(em.n, em instanceof EventTarget);\n// Page-only APIs.\nlog('media', matchMedia('(min-width: 600px)').matches, matchMedia('(max-width: 600px)').matches, matchMedia('print').matches, matchMedia('screen').media);\nconst lazy = document.getElementById('lazy');\nconst io = new IntersectionObserver((entries, obs) => {\n  for (const e of entries) {\n    log('visible', e.target.id, e.isIntersecting, obs === io);\n    e.target.src = e.target.dataset.src;\n    obs.unobserve(e.target);\n  }\n});\nio.observe(lazy);\nnew ResizeObserver(entries => log('resized', entries.length, entries[0].target.id)).observe(document.getElementById('box'));\nconst mo = new MutationObserver(() => log('not called: takeRecords took the record'));\nmo.observe(document.body, { childList: true });\ndocument.body.appendChild(document.createElement('hr'));\nlog('records', mo.takeRecords().length);\nconst xhr = new XMLHttpRequest();\nconst states = [];\nxhr.onreadystatechange = () => states.push(xhr.readyState);\nxhr.addEventListener('load', () => log('xhr load', xhr.status, xhr.response.length, xhr.getResponseHeader('content-type'), states.join(',')));\nxhr.responseType = 'json';\nxhr.open('GET', 'scripts/items.json');\nxhr.send();\nlog('xhr sent', xhr.readyState);\nconst sync = new XMLHttpRequest();\nsync.open('GET', 'scripts/items.json', false);\nsync.send();\nlog('sync xhr', sync.readyState, sync.status, JSON.parse(sync.responseText).length);\nconst failed = new XMLHttpRequest();\nfailed.onerror = () => log('xhr error', failed.readyState, failed.status);\nfailed.open('POST', 'scripts/items.json');\nfailed.send();\nfetch('scripts/items.json', { signal: AbortSignal.abort() }).catch(e => log('fetch aborted', e.name));\nrequestIdleCallback(deadline => log('idle', deadline.didTimeout, deadline.timeRemaining() >= 0));\ncustomElements.whenDefined('x-y').then(c => log('defined', c.name));\ncustomElements.define('x-y', class XY extends HTMLElement {});\nlog('custom', typeof customElements.get('x-y'), customElements.get('x-z'));\nconst img = new Image(10, 20);\nconst opt = new Option('Label', 'v', true);\nlog('image', img.tagName, img.getAttribute('width'), opt.tagName, opt.textContent, opt.getAttribute('value'), opt.hasAttribute('selected'));\nimg.decode().catch(e => log('decode without src', e.name));\nimg.src = '../paint/img/photo.png';\nimg.decode().then(() => log('decoded'));\nlog('origin', origin, isSecureContext, typeof reportError);\nreportError(new Error('reported'));\n"
      "\n"
      <hr>
