#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Resource reflections"
    <body>
      <pre id="results">
        "parser script defaults: PASS\n"
        "style defaults: PASS\n"
        "style setters: PASS\n"
        "style attribute: PASS\n"
        "link defaults: PASS\n"
        "link setters: PASS\n"
        "live relList: PASS\n"
        "rel attribute: PASS\n"
        "relList forwarding: PASS\n"
        "link credentials: PASS\n"
        "link anonymous: PASS\n"
        "link null: PASS\n"
        "script credentials: PASS\n"
        "script anonymous: PASS\n"
        "script null: PASS\n"
        "dynamic script async: PASS\n"
        "script setters: PASS\n"
        "script boolean presence: PASS\n"
        "image reflection defaults: PASS\n"
        "image alt: PASS\n"
        "image srcset: PASS\n"
        "image sizes: PASS\n"
        "image useMap: PASS\n"
        "image isMap set: PASS\n"
        "image isMap attribute: PASS\n"
        "image loading enum: PASS\n"
        "image loading invalid: PASS\n"
        "image decoding enum: PASS\n"
        "image decoding invalid: PASS\n"
        "image fetchPriority enum: PASS\n"
        "image fetchPriority invalid: PASS\n"
        "image referrerPolicy enum: PASS\n"
        "image referrerPolicy invalid: PASS\n"
        "image crossorigin empty: PASS\n"
        "image crossorigin null: PASS\n"
        "anchor parts: PASS\n"
        "anchor setters: PASS\n"
        "anchor host: PASS\n"
        "anchor absent href: PASS\n"
      <script>
        "\nconst out = document.getElementById('results');\nfunction check(name, value) { out.append(name + ': ' + (value ? 'PASS' : 'FAIL') + '\\n'); }\ncheck('parser script defaults', !document.currentScript.async && !document.currentScript.defer && !document.currentScript.noModule);\nconst style = document.createElement('style');\ncheck('style defaults', style.media === '' && style.type === '');\nstyle.media = 'screen'; style.type = 'text/css';\ncheck('style setters', style.getAttribute('media') === 'screen' && style.getAttribute('type') === 'text/css');\nstyle.setAttribute('media', 'print');\ncheck('style attribute', style.media === 'print');\nconst link = document.createElement('link');\ncheck('link defaults', link.media === '' && link.type === '' && link.rel === '' && link.as === '' && link.crossOrigin === null);\nlink.media = 'screen'; link.type = 'text/css'; link.rel = 'stylesheet stylesheet'; link.as = 'STYLE';\ncheck('link setters', link.getAttribute('media') === 'screen' && link.type === 'text/css' && link.relList.length === 1 && link.as === 'style');\nconst list = link.relList;\nlist.add('preload'); list.remove('stylesheet');\ncheck('live relList', list === link.relList && link.rel === 'preload');\nlink.setAttribute('rel', 'stylesheet alternate');\ncheck('rel attribute', list.contains('stylesheet') && list.item(1) === 'alternate');\nlink.relList = 'preload'; link.as = 'bogus';\ncheck('relList forwarding', list.value === 'preload' && link.as === '');\nfor (const el of [link, document.createElement('script')]) {\n  el.crossOrigin = 'USE-CREDENTIALS';\n  check(el.localName + ' credentials', el.crossOrigin === 'use-credentials');\n  el.crossOrigin = 'bogus';\n  check(el.localName + ' anonymous', el.crossOrigin === 'anonymous');\n  el.crossOrigin = null;\n  check(el.localName + ' null', el.crossOrigin === null && !el.hasAttribute('crossorigin'));\n}\nconst script = document.createElement('script');\ncheck('dynamic script async', script.async === true && !script.hasAttribute('async'));\nscript.async = false; script.defer = true; script.noModule = true; script.type = 'module'; script.integrity = 'sha256-test';\ncheck('script setters', !script.async && script.hasAttribute('defer') && script.hasAttribute('nomodule') && script.getAttribute('type') === 'module' && script.getAttribute('integrity') === 'sha256-test');\nscript.setAttribute('async', 'false'); script.removeAttribute('defer'); script.removeAttribute('nomodule');\ncheck('script boolean presence', script.async && !script.defer && !script.noModule);\nconst img = document.createElement('img');\ncheck('image reflection defaults', img.alt === '' && img.srcset === '' && img.sizes === '' && img.useMap === '' && !img.isMap && img.loading === 'eager' && img.decoding === 'auto' && img.fetchPriority === 'auto' && img.crossOrigin === null && img.referrerPolicy === '');\nfor (const [name, value, attr] of [['alt', 'caption', 'alt'], ['srcset', 'pic.png 2x', 'srcset'], ['sizes', '50vw', 'sizes'], ['useMap', '#map', 'usemap']]) {\n  img[name] = value;\n  check('image ' + name, img.getAttribute(attr) === value && img[name] === value);\n}\nimg.isMap = true;\ncheck('image isMap set', img.hasAttribute('ismap'));\nimg.removeAttribute('ismap');\ncheck('image isMap attribute', !img.isMap);\nfor (const [name, value, normalized, fallback] of [['loading', 'LAZY', 'lazy', 'eager'], ['decoding', 'ASYNC', 'async', 'auto'], ['fetchPriority', 'HIGH', 'high', 'auto'], ['referrerPolicy', 'NO-REFERRER', 'no-referrer', '']]) {\n  img[name] = value;\n  check('image ' + name + ' enum', img[name] === normalized && img.getAttribute(name.toLowerCase()) === value);\n  img.setAttribute(name.toLowerCase(), 'invalid');\n  check('image ' + name + ' invalid', img[name] === fallback);\n}\nimg.crossOrigin = '';\ncheck('image crossorigin empty', img.crossOrigin === 'anonymous');\nimg.crossOrigin = null;\ncheck('image crossorigin null', img.crossOrigin === null);\nconst a = document.createElement('a');\na.href = 'https://example.com:8443/a/b?q=1#top';\ncheck('anchor parts', a.protocol === 'https:' && a.host === 'example.com:8443' && a.hostname === 'example.com' && a.port === '8443' && a.pathname === '/a/b' && a.search === '?q=1' && a.hash === '#top' && a.origin === 'https://example.com:8443');\na.protocol = 'http:'; a.hostname = 'other.test'; a.port = '8080'; a.pathname = '/next'; a.search = '?x=2'; a.hash = '#end';\ncheck('anchor setters', a.href === 'http://other.test:8080/next?x=2#end');\na.host = 'final.test:9090';\ncheck('anchor host', a.href === 'http://final.test:9090/next?x=2#end' && a.getAttribute('href') === a.href);\na.removeAttribute('href');\ncheck('anchor absent href', a.href === '' && a.hostname === '' && a.pathname === '');\n"
      "\n"
