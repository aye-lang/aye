#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Form values"
      "\n"
    <body>
      <form id="f">
        "\n"
        <input id="name" value="initial">
        "\n"
        <input id="agree" type="checkbox" checked="">
        "\n"
        <select id="color">
          <option value="r">
            "Red"
          <option value="g">
            "Green"
        "\n"
        <textarea id="notes">
          "old notes"
        "\n"
        <button id="send">
          "Send"
        "\n"
      "\n"
      <pre id="out">
        "initial text f\ntrue on\nr 0 2\ng 1\nold notes\nsubmit f Ada\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\nconst name = document.getElementById('name');\nlog(name.value, name.type, name.form.id);\nname.value = 'Ada';\nconst agree = document.getElementById('agree');\nlog(agree.checked, agree.value);\nagree.checked = false;\nconst color = document.getElementById('color');\nlog(color.value, color.selectedIndex, color.options.length);\ncolor.value = 'g';\nlog(color.value, color.selectedIndex);\nconst notes = document.getElementById('notes');\nlog(notes.value);\nnotes.value = 'new notes';\nconst f = document.getElementById('f');\nf.addEventListener('submit', e => { e.preventDefault(); log('submit', e.target.id, name.value); });\ndocument.getElementById('send').click();\n"
      "\n"
