      "\n"
      <div class="card" id="card">
        <p>
          <b id="b1" class="flag">
            "b"
        <span class="label" id="l1">
          "a"
      "\n"
      <pre id="out">
        "start 0 0,0 10\nappended 2099 14000,733950 10\nbig 2099 17490,733950 10\nwide flag 2799 17490,978600 60\nremoved 1599 10990,319200 60\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.join(' ') + '\\n'; }\nconst $ = id => document.getElementById(id);\nconst list = $('list');\n// More changes between two reads than the restyle keeps one by one\n// (geometry.ore MAX_RESTYLE), many of them the same change again.\nfunction sum() {\n  let w = 0, h = 0;\n  for (const e of list.children) { w += e.offsetWidth; h += e.offsetTop; }\n  return w + ',' + h + ' ' + $('l1').offsetWidth;\n}\nlog('start', list.offsetHeight, sum());\nfor (let i = 0; i < 700; i++) {\n  const d = document.createElement('div');\n  d.className = 'item';\n  list.append(d);\n}\nlog('appended', list.offsetHeight, sum());\nfor (let i = 0; i < 700; i += 7) list.children[i].classList.toggle('x');\nlist.children[350].classList.add('big');\nlog('big', list.offsetHeight, sum());\nfor (let i = 0; i < 400; i++) list.setAttribute('data-n', String(i));\nlist.classList.add('wide');\n$('b1').classList.add('flag');\nlog('wide flag', list.offsetHeight, sum());\nfor (let i = 0; i < 300; i++) list.lastElementChild.remove();\nlist.children[100].classList.add('big');\nlog('removed', list.offsetHeight, sum());\n"
      "\n"
