#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Shadow sheets and the rule index"
      "\n"
      <style>
        ".a { color: red } span { font-weight: bold } i { margin-left: 4px }"
      "\n"
    <body>
      <div id="host">
        #shadow-root (open)
          <style>
            ".b { color: green } em { margin-left: 2px } ::slotted(.s) { color: blue }"
          <p id="inner" class="b">
            <em>
              "x"
          <slot>
        <span id="light" class="s">
          "slotted"
      "\n"
      <script>
        "\n// The shadow tree's sheet has as many rules as the document's, but\n// others: each sheet must be matched with its own rules.\nconst root = document.getElementById('host').attachShadow({ mode: 'open' });\nroot.innerHTML = '<style>.b { color: green } em { margin-left: 2px } ::slotted(.s) { color: blue }</style><p id=\"inner\" class=\"b\"><em>x</em></p><slot></slot>';\n"
      "\n"
