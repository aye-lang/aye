#document
  <!DOCTYPE html>
  <html>
    <head>
      <title>
        "Web Animations"
      "\n"
    <body>
      <div id="box" style="color: red;">
      "\n"
      <div id="other" style="width: 30px;">
      "\n"
      <pre id="out">
        "interfaces function function function function function function\ntimeline true true number\nbefore [] []\na true true true true true true\na state running false 0 true 1\na timing {\"delay\":0,\"endDelay\":0,\"fill\":\"auto\",\"iterationStart\":0,\"iterations\":1,\"duration\":100,\"direction\":\"normal\",\"easing\":\"linear\"}\na keyframes [{\"offset\":null,\"easing\":\"linear\",\"composite\":\"auto\",\"computedOffset\":0,\"opacity\":\"0\"},{\"offset\":null,\"easing\":\"linear\",\"composite\":\"auto\",\"computedOffset\":1,\"opacity\":\"1\"}]\nb keyframes [[0,\"0\",\"red\"],[0.5,\"0.5\",null],[1,\"1\",\"blue\"]]\nafter animate [a] [b] [a,b] [a,b]\nc listed [a,c]\nc after cancel idle null null true [a]\nd paused paused 0 null\ne running running red\ne finish() finished 5000 green [a,d,e]\ne cancel idle red [a,d]\nf finish throws InvalidStateError\nc rejected true AbortError\nc oncancel true null\nc cancel listener\nd still paused paused 0\nd play running\na finished resolves true finished\nawaited a finished [d,f]\na onfinish finish 100\na finish listener\nd finished finished 50\nb finished finished 200 [b,g]\nb fill 1 blue\ng finished 30px\ng committed 30px\nb cancel idle \"\" \"\" []\nsettled fulfilled,fulfilled,rejected []\nbox style color: red;\n"
      "\n"
      <script>
        "\nfunction log(...parts) { document.getElementById('out').textContent += parts.map(String).join(' ') + '\\n'; }\nconst box = document.getElementById('box');\nconst other = document.getElementById('other');\nconst ids = list => '[' + list.map(a => a.id).join(',') + ']';\n\nlog('interfaces', typeof Animation, typeof KeyframeEffect, typeof AnimationEffect, typeof DocumentTimeline, typeof AnimationTimeline, typeof AnimationPlaybackEvent);\nlog('timeline', document.timeline instanceof DocumentTimeline, document.timeline instanceof AnimationTimeline, typeof document.timeline.currentTime);\nlog('before', ids(box.getAnimations()), ids(document.getAnimations()));\n\n// Numeric options, array keyframes.\nconst a = box.animate([{ opacity: 0 }, { opacity: 1 }], 100);\na.id = 'a';\nlog('a', a instanceof Animation, a instanceof EventTarget, a.effect instanceof KeyframeEffect, a.effect instanceof AnimationEffect, a.effect.target === box, a.timeline === document.timeline);\nlog('a state', a.playState, a.pending, a.currentTime, a.startTime !== null, a.playbackRate);\nlog('a timing', JSON.stringify(a.effect.getTiming()));\nlog('a keyframes', JSON.stringify(a.effect.getKeyframes()));\n\n// Property-indexed keyframes, fill forwards, an id from the options.\nconst b = other.animate({ opacity: [0, 0.5, 1], backgroundColor: ['red', 'blue'] }, { duration: 200, fill: 'forwards', id: 'b' });\nlog('b keyframes', JSON.stringify(b.effect.getKeyframes().map(k => [k.computedOffset, k.opacity, k.backgroundColor])));\nlog('after animate', ids(box.getAnimations()), ids(other.getAnimations()), ids(document.getAnimations()), ids(document.body.getAnimations({ subtree: true })));\n\n// Cancel: finished rejects with an AbortError, a cancel event, the list loses it.\nconst c = box.animate(null, { duration: 1000, id: 'c' });\nconst cFinished = c.finished;\ncFinished.then(() => log('c finished?!'), e => log('c rejected', e instanceof DOMException, e.name));\nc.oncancel = e => log('c oncancel', e instanceof AnimationPlaybackEvent, e.currentTime);\nc.addEventListener('cancel', () => log('c cancel listener'));\nlog('c listed', ids(box.getAnimations()));\nc.cancel();\nlog('c after cancel', c.playState, c.currentTime, c.startTime, c.finished !== cFinished, ids(box.getAnimations()));\n\n// Finish order: the finished promise, then onfinish, then listeners.\na.finished.then(x => log('a finished resolves', x === a, a.playState));\na.onfinish = e => log('a onfinish', e.type, e.currentTime);\na.addEventListener('finish', () => log('a finish listener'));\n\n// Pause and play.\nconst d = box.animate({ transform: ['none', 'translateX(10px)'] }, { duration: 50, id: 'd' });\nd.pause();\nlog('d paused', d.playState, d.currentTime, d.startTime);\nsetTimeout(() => {\n  log('d still paused', d.playState, d.currentTime);\n  d.play();\n  log('d play', d.playState);\n  d.finished.then(() => log('d finished', d.playState, d.currentTime));\n}, 80);\n\n// finish() jumps to the end; play() again restarts.\nconst e = box.animate({ color: 'green' }, { duration: 5000, fill: 'both', id: 'e' });\nlog('e running', e.playState, box.style.color);\ne.finish();\nlog('e finish()', e.playState, e.currentTime, box.style.color, ids(box.getAnimations()));\ne.cancel();\nlog('e cancel', e.playState, box.style.color, ids(box.getAnimations()));\n\n// Infinite iterations never finish.\nconst f = box.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 10, iterations: Infinity, id: 'f' });\ntry { f.finish(); } catch (err) { log('f finish throws', err.name); }\n\n// commitStyles writes the end into the inline style, which stays after cancel.\nconst g = other.animate([{ width: '1px' }, { width: '30px' }], { duration: 20, fill: 'forwards', id: 'g' });\n\n(async () => {\n  await a.finished;\n  log('awaited a', a.playState, ids(box.getAnimations()));\n  await b.finished;\n  log('b finished', b.playState, b.currentTime, ids(other.getAnimations()));\n  log('b fill', other.style.opacity, other.style.backgroundColor);\n  log('g', g.playState, other.style.width);\n  g.commitStyles();\n  g.cancel();\n  log('g committed', other.style.width);\n  b.cancel();\n  log('b cancel', b.playState, JSON.stringify(other.style.opacity), JSON.stringify(other.style.backgroundColor), ids(other.getAnimations()));\n  f.cancel();\n  c.play();\n  c.finish();\n  const settled = await Promise.allSettled([a.finished, c.finished, cFinished]);\n  log('settled', settled.map(r => r.status).join(','), ids(document.getAnimations()));\n  log('box style', box.getAttribute('style'));\n})();\n"
      "\n"
