// A tab: the current page, its vertical scroll offset, and its session
// history (history.aye): the pages it showed, and the entries their
// scripts added (back and forward).

import std
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url
import url.Url

/// What a move in the history did (`Tab.go`).
pub enum Moved {
    // There is no such entry.
    None
    // It is an entry of the document shown (popstate fired).
    InDocument
    // Its page was loaded.
    Loaded
}

pub struct Tab {
    alloc: Allocator
    page: ?*mut Page
    // The pages it showed take their place in it (`Page.shared`).
    history: SessionHistory
    // The vertical scroll offset of the page, in CSS px.
    scroll: f64
    // The horizontal one (a page wider than the window).
    scroll_x: f64
    // After the next layout (`settle`): the scroll offset to go back to,
    // or else the fragment to scroll to (owned; empty for none).
    restore: ?f64
    fragment: []mut u8

    pub fn init(alloc: Allocator) Tab {
        return Tab {
            alloc: alloc,
            page: null,
            history: SessionHistory.init(alloc),
            scroll: 0.0,
            scroll_x: 0.0,
            restore: null,
            fragment: alloc.alloc(0 as u8, 0) catch unreachable,
        }
    }

    pub fn deinit(self: *mut Self) {
        if self.page |p| {
            p.destroy()
        }
        self.history.deinit()
        self.alloc.free(self.fragment)
    }

    /// The URL of the current entry ("" before the first navigation).
    pub fn href(self: *Self) []u8 {
        if self.history.current < self.history.len() {
            return self.history.entries.items()[self.history.current].href
        }
        return ""
    }

    pub fn canGoBack(self: *Self) bool {
        return self.history.current > 0
    }

    pub fn canGoForward(self: *Self) bool {
        return self.history.current + 1 < self.history.len()
    }

    /// Goes to `target` in a new entry after the current one (dropping
    /// the entries forward of it). A link to a fragment of the current
    /// document only scrolls (`toFragment`). Returns whether a new page
    /// was loaded (which then needs a layout).
    pub fn navigate(self: *mut Self, target: *Url) AllocError!bool {
        if self.sameDocument(target) {
            try self.toFragment(target)
            return false
        }
        let p = try load(self.alloc, target)
        errdefer p.destroy()
        try self.push(target, p)
        return true
    }

    /// Is `target` a fragment of the document shown?
    pub fn sameDocument(self: *Self, target: *Url) bool {
        if self.page |p| {
            return isFragmentOf(p, target)
        }
        return false
    }

    /// Navigates to `target`, a fragment of the document shown
    /// (`sameDocument`): a new entry of the document, popstate and
    /// hashchange; `settle` scrolls to it (an empty fragment is the top).
    pub fn toFragment(self: *mut Self, target: *Url) AllocError!void {
        let p = self.page.?
        self.saveScroll()
        let old = try self.alloc.alloc(0 as u8, p.url.href.len)
        defer self.alloc.free(old)
        std.mem.copy(old, p.url.href)
        try fragmentNavigate(p, target, false)
        try self.setFragment(target.fragment)
        self.restore = null
        if target.fragment.len == 0 {
            self.restore = 0.0
        }
        try fragmentNavigated(p, old)
    }

    /// Adds an entry for `target` after the current one (dropping the
    /// entries forward of it) and shows `page`, the page of `target`
    /// loaded, with the entries its scripts added while it loaded.
    pub fn push(self: *mut Self, target: *Url, page: *mut Page) AllocError!void {
        self.saveScroll()
        try self.history.adoptPushed(&mut page.history)
        page.shared = &mut self.history
        try self.setFragment(target.fragment)
        self.restore = null
        try self.show(page)
    }

    /// Goes one entry back.
    pub fn back(self: *mut Self) AllocError!Moved {
        return self.go(-1)
    }

    pub fn forward(self: *mut Self) AllocError!Moved {
        return self.go(1)
    }

    /// Loads the current entry again, keeping the scroll offset.
    pub fn reload(self: *mut Self) AllocError!Moved {
        return self.go(0)
    }

    /// Goes to the entry `step` away from the current one: in the
    /// document shown when it is one of its entries (`inDocument`), else
    /// by loading its page.
    pub fn go(self: *mut Self, step: i64) AllocError!Moved {
        let at = self.history.indexAt(step) orelse return Moved.None
        if step != 0 && try self.inDocument(step) {
            return Moved.InDocument
        }
        let target = url.parse(self.alloc, self.history.entries.items()[at].href) catch |e| {
            return AllocError.OutOfMemory
        }
        defer target.deinit(self.alloc)
        let p = try loadState(self.alloc, &target, self.history.entries.items()[at].state)
        errdefer p.destroy()
        try self.moveTo(step, p)
        return Moved.Loaded
    }

    /// Moves `step` entries when that entry is of the document shown: the
    /// document takes its URL, its scripts get popstate (and hashchange
    /// in a task), and `settle` scrolls to where it was left. False when
    /// it is not such an entry.
    pub fn inDocument(self: *mut Self, step: i64) AllocError!bool {
        let p = self.page orelse return false
        self.saveScroll()
        if !(try traverseInDocument(p, step)) {
            return false
        }
        let e = self.history.now()
        try self.setFragment("")
        self.restore = null
        if !e.manual_scroll {
            self.restore = e.scroll
        }
        return true
    }

    /// The URL of the entry `step` entries away from the current one
    /// (-1: back, 0: the current one, 1: forward); "" when there is none.
    pub fn hrefAt(self: *Self, step: i64) []u8 {
        let at = self.history.indexAt(step) orelse return ""
        return self.history.entries.items()[at].href
    }

    /// The serialized state of that entry (null for none).
    pub fn stateAt(self: *Self, step: i64) ?[]u8 {
        let at = self.history.indexAt(step) orelse return null
        return self.history.entries.items()[at].state
    }

    /// Moves `step` entries (-1: back, 1: forward, 0: reload; see
    /// `hrefAt`) and shows `page`, the page of that entry loaded
    /// (`loadState`), at the scroll offset the entry was left at.
    pub fn moveTo(self: *mut Self, step: i64, page: *mut Page) AllocError!void {
        self.saveScroll()
        let at = (self.history.current as i64 + step) as usize
        let e = self.history.entries.items()[at]
        try self.history.adoptAt(at, &mut page.history)
        page.shared = &mut self.history
        try self.setFragment("")
        self.restore = null
        if !e.manual_scroll {
            self.restore = e.scroll
        }
        try self.show(page)
    }

    fn saveScroll(self: *mut Self) {
        if self.history.current < self.history.len() {
            self.history.now().scroll = self.scroll
        }
    }

    fn setFragment(self: *mut Self, f: []u8) AllocError!void {
        let copy = try self.alloc.alloc(0 as u8, f.len)
        std.mem.copy(copy, f)
        self.alloc.free(self.fragment)
        self.fragment = copy
    }

    // Replaces the page with `p`, the current entry's (which has the URL
    // after redirects: the page's own entry).
    fn show(self: *mut Self, p: *mut Page) AllocError!void {
        if self.page |old| {
            old.destroy()
        }
        self.page = p
        self.scroll = 0.0
        self.scroll_x = 0.0
    }

    /// After a layout of the page: scrolls to where the last navigation
    /// wants (the saved offset, or the fragment's element), then keeps
    /// the offset within `0..max`.
    pub fn settle(self: *mut Self, max: f64) {
        if self.restore |r| {
            self.scroll = r
        } else if self.fragment.len > 0 {
            if self.page |p| {
                var y: ?f64 = null
                if p.tree |t| {
                    y = fragmentY(t, self.fragment)
                }
                // Without such an element, `top` is the top.
                if y == null && text.eqlIgnoreCase(self.fragment, "top") {
                    y = 0.0
                }
                if y |top| {
                    self.scroll = top
                }
            }
        }
        self.restore = null
        self.setFragment("") catch |e| {
        }
        self.clampScroll(max)
    }

    pub fn clampScroll(self: *mut Self, max: f64) {
        if self.scroll > max {
            self.scroll = max
        }
        if self.scroll < 0.0 {
            self.scroll = 0.0
        }
    }
}
