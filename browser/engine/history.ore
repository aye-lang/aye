// The session history of a tab or a frame (HTML "session history"): its
// entries, the current one, and which document each belongs to.
//
// A page has a history of its own from its load (`Page.history`: one
// entry, its URL). A tab takes those entries into its history when it
// shows the page (`adoptPushed`, `adoptAt`; tab.ore), and the page uses
// the tab's from then on (`Page.shared`). A frame's next page takes the
// frame's history over from the page before it (frames.ore).
//
// pushState, replaceState and fragment navigations add or change entries
// of the document shown, without loading (`doc`, the id of the page). A
// traversal to an entry of the same document fires popstate (the
// prelude's `historyChanged`); to an entry of another document, the
// front end loads it, with the entry's state (`loadState`).

import js
import js.Args
import js.Interp
import js.JsError
import js.Value
import std
import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url
import url.Url

/// A session history entry.
pub struct HistoryEntry {
    // The URL (owned).
    href: []mut u8
    // The vertical scroll offset it was left at, in CSS px.
    scroll: f64
    // The id of the page whose document it is (`Page.id`).
    doc: u32
    // pushState's serialized state (owned; the prelude's format), or
    // null for none.
    state: ?[]mut u8
    // history.scrollRestoration is "manual": traversing to the entry
    // does not restore its scroll offset.
    manual_scroll: bool
}

pub struct SessionHistory {
    alloc: Allocator
    entries: List(HistoryEntry)
    current: usize

    pub fn init(alloc: Allocator) SessionHistory {
        return SessionHistory { alloc: alloc, entries: List(HistoryEntry).init(alloc), current: 0 }
    }

    pub fn deinit(self: *mut Self) {
        self.truncate(0)
        self.entries.deinit()
    }

    pub fn len(self: *Self) usize {
        return self.entries.len()
    }

    /// The current entry (there must be one).
    pub fn now(self: *mut Self) *mut HistoryEntry {
        return &mut self.entries.items()[self.current]
    }

    /// The index of the entry `step` entries away from the current one;
    /// null when there is none.
    pub fn indexAt(self: *Self, step: i64) ?usize {
        let i = self.current as i64 + step
        if i < 0 || i >= self.entries.len() as i64 {
            return null
        }
        return i as usize
    }

    /// Adds an entry of the document `doc` after the current one (the
    /// entries after it go) and makes it the current one.
    pub fn push(self: *mut Self, href: []u8, doc: u32, state: ?[]u8, manual_scroll: bool) AllocError!void {
        var at: usize = 0
        if self.entries.len() > 0 {
            at = self.current + 1
        }
        let copy = try historyCopy(self.alloc, href)
        errdefer self.alloc.free(copy)
        var saved: ?[]mut u8 = null
        if state |st| {
            saved = try historyCopy(self.alloc, st)
        }
        errdefer historyFree(self.alloc, saved)
        self.truncate(at)
        try self.entries.append(HistoryEntry { href: copy, scroll: 0.0, doc: doc, state: saved, manual_scroll: manual_scroll })
        self.current = at
    }

    /// Gives the current entry the URL `href` and the state `state`.
    pub fn replace(self: *mut Self, href: []u8, state: ?[]u8) AllocError!void {
        let copy = try historyCopy(self.alloc, href)
        errdefer self.alloc.free(copy)
        var saved: ?[]mut u8 = null
        if state |st| {
            saved = try historyCopy(self.alloc, st)
        }
        let e = self.now()
        self.alloc.free(e.href)
        historyFree(self.alloc, e.state)
        e.href = copy
        e.state = saved
    }

    /// Takes the entries of `own` (a page's own history, left empty) as
    /// those of a new document after the current entry: a navigation.
    pub fn adoptPushed(self: *mut Self, own: *mut SessionHistory) AllocError!void {
        var at: usize = 0
        if self.entries.len() > 0 {
            at = self.current + 1
        }
        self.truncate(at)
        try self.appendAll(own, 0)
        self.current = at + own.current
        own.entries.clear()
        own.current = 0
    }

    /// Takes the entries of `own` (a page loaded for entry `at`, left
    /// empty): its first entry replaces `at`, keeping its scroll offset;
    /// the other entries of `at`'s document are of the new page now.
    /// Entries `own` added while it loaded replace those after `at`.
    pub fn adoptAt(self: *mut Self, at: usize, own: *mut SessionHistory) AllocError!void {
        if own.entries.len() > 1 {
            self.truncate(at + 1)
            try self.appendAll(own, 1)
        }
        let items = self.entries.items()
        let old = items[at].doc
        let first = own.entries.items()[0]
        for i in 0..items.len {
            if items[i].doc == old {
                items[i].doc = first.doc
            }
        }
        self.alloc.free(items[at].href)
        historyFree(self.alloc, items[at].state)
        items[at].href = first.href
        items[at].state = first.state
        self.current = at + own.current
        own.entries.clear()
        own.current = 0
    }

    // Appends the entries of `own` from `from` on (moved: `own` must
    // forget them); on failure, none.
    fn appendAll(self: *mut Self, own: *mut SessionHistory, from: usize) AllocError!void {
        let base = self.entries.len()
        for e in own.entries.items()[from..] {
            self.entries.append(e) catch |err| {
                while self.entries.len() > base {
                    _ = self.entries.pop()
                }
                return AllocError.OutOfMemory
            }
        }
    }

    // Frees the entries from `n` on.
    fn truncate(self: *mut Self, n: usize) {
        while self.entries.len() > n {
            if self.entries.pop() |e| {
                self.alloc.free(e.href)
                historyFree(self.alloc, e.state)
            }
        }
    }
}

fn historyCopy(alloc: Allocator, b: []u8) AllocError![]mut u8 {
    let copy = try alloc.alloc(0 as u8, b.len)
    std.mem.copy(copy, b)
    return copy
}

fn historyFree(alloc: Allocator, b: ?[]mut u8) {
    if b |bytes| {
        alloc.free(bytes)
    }
}

/// Makes `href` (a valid URL) the URL of the document of `p`, which its
/// base URL follows: pushState, a fragment navigation, a traversal.
fn setDocumentUrl(p: *mut Page, href: []u8) AllocError!void {
    var u = url.parse(p.alloc, href) catch |e| {
        return AllocError.OutOfMemory
    }
    errdefer u.deinit(p.alloc)
    let base = try documentBase(p.alloc, &p.doc, &u)
    p.url.deinit(p.alloc)
    p.url = u
    p.base.deinit(p.alloc)
    p.base = base
}

/// Is `target` the URL of the document of `p` with a fragment (a
/// navigation to it only scrolls)?
pub fn isFragmentOf(p: *mut Page, target: *Url) bool {
    return target.has_fragment && text.eql(target.withoutFragment(), p.url.withoutFragment())
}

/// Navigates `p` to `target`, a fragment of its document (HTML "navigate
/// to a fragment"): a new entry (or the current one when `replace`, or
/// when `target` is the document's URL) with no state; the document
/// takes its URL. Events and scrolling are the caller's.
pub fn fragmentNavigate(p: *mut Page, target: *Url, replace: bool) AllocError!void {
    let h = p.sessionHistory()
    if replace || text.eql(target.href, p.url.href) {
        try h.replace(target.href, null)
    } else {
        saveScriptScroll(p)
        let e = h.now()
        try h.push(target.href, e.doc, null, e.manual_scroll)
    }
    return setDocumentUrl(p, target.href)
}

/// Can the document of `p` have its URL rewritten to `target` (HTML
/// "can have its URL rewritten"): the same scheme, user, host and port;
/// on `file:` the same path too, and on other schemes (but http and
/// https) the same path and query.
fn canRewrite(doc: *Url, target: *Url) bool {
    if !text.eql(doc.scheme, target.scheme) || !text.eql(doc.username, target.username) || !text.eql(doc.password, target.password) || !text.eql(doc.host, target.host) || !text.eql(doc.port, target.port) {
        return false
    }
    if text.eql(target.scheme, "http") || text.eql(target.scheme, "https") {
        return true
    }
    if !text.eql(doc.path, target.path) {
        return false
    }
    if text.eql(target.scheme, "file") {
        return true
    }
    return doc.has_query == target.has_query && text.eql(doc.query, target.query)
}

// The current entry keeps the scroll offset the scripts see.
fn saveScriptScroll(p: *mut Page) {
    if p.script |s| {
        p.sessionHistory().now().scroll = s.scroll_y
    }
}

/// Moves the history of `p` to entry `at`, an entry of its document:
/// the document takes its URL, and (unless its scroll restoration is
/// manual) the scripts its scroll offset, which the front end then
/// scrolls to (`takeScriptScroll`). No events: see `traverseInDocument`.
pub fn moveInDocument(p: *mut Page, at: usize) AllocError!void {
    let h = p.sessionHistory()
    saveScriptScroll(p)
    h.current = at
    let e = h.now()
    try setDocumentUrl(p, e.href)
    if e.manual_scroll {
        return
    }
    if p.script |s| {
        if s.scroll_y != e.scroll {
            s.scroll_y = e.scroll
            s.scroll_moved = true
            s.geometry_changes += 1
        }
    }
}

/// The front end moves `p`'s history `step` entries, to an entry of its
/// document: as `history.go(step)` would, in a task of its own (popstate,
/// then hashchange as a task when the fragment changed). False when
/// there is no such entry or it is of another document.
pub fn traverseInDocument(p: *mut Page, step: i64) AllocError!bool {
    let h = p.sessionHistory()
    let at = h.indexAt(step) orelse return false
    if h.entries.items()[at].doc != h.now().doc {
        return false
    }
    if p.script |s| {
        if s.history_hook != js.NONE {
            try callHistoryHook(s, 0, step, "")
            return true
        }
    }
    try moveInDocument(p, at)
    return true
}

/// The front end navigated `p` to a fragment of its document
/// (`fragmentNavigate`; the URL was `old`): popstate, and hashchange as
/// a task when the fragment changed.
pub fn fragmentNavigated(p: *mut Page, old: []u8) AllocError!void {
    let s = p.script orelse return
    if s.history_hook == js.NONE {
        return
    }
    return callHistoryHook(s, 1, 0, old)
}

// Calls the prelude's hostHistory(op, step, oldURL) as a task.
fn callHistoryHook(s: *mut Script, op: i64, step: i64, old: []u8) AllocError!void {
    let it = &mut s.it
    let base = it.stack.len()
    try jsPush(s, it.roots.items()[s.history_hook])
    try jsPush(s, Value.Undefined)
    try jsPush(s, js.numVal(op as f64))
    try jsPush(s, js.numVal(step as f64))
    try jsPush(s, try stringFor(s, old))
    _ = try callReported(s, base, 3)
    s.it.truncate(base)
    try runMicrotasks(s)
    return afterTask(s)
}

// ---- natives (the prelude's History and Location)

fn installHistory(s: *mut Script, o: u32) JsError!void {
    let it = &mut s.it
    try defMethod(it, o, "historyLength", 0, akHistoryLength)
    try defMethod(it, o, "historyState", 0, akHistoryState)
    try defMethod(it, o, "historyPush", 3, akHistoryPush)
    try defMethod(it, o, "historyGo", 1, akHistoryGo)
    try defMethod(it, o, "historyMove", 1, akHistoryMove)
    try defMethod(it, o, "scrollRestoration", 1, akScrollRestoration)
    try defMethod(it, o, "setHistoryHandler", 1, akSetHistoryHandler)
}

fn akHistoryLength(it: *mut Interp, a: Args) JsError!Value {
    return js.numVal(scriptOf(it).page.sessionHistory().len() as f64)
}

// The current entry's serialized state, or null.
fn akHistoryState(it: *mut Interp, a: Args) JsError!Value {
    if scriptOf(it).page.sessionHistory().now().state |st| {
        return it.newString(st)
    }
    return Value.Null
}

// historyPush(serialized, url, replace): pushState (replaceState when
// `replace`) with the state serialized; `url` undefined or null for the
// document's. Null when done, else the message of the SecurityError.
fn akHistoryPush(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)
    let p = s.page
    let state = try it.builder()
    defer it.release(state)
    try argText(it, a, 0, state)
    let replace = it.toBoolean(it.arg(a, 2))
    let href = try it.builder()
    defer it.release(href)
    try href.append(p.url.href)
    let given = it.arg(a, 1)
    if !js.isNullish(given) {
        let b = try it.builder()
        defer it.release(b)
        try argText(it, a, 1, b)
        if b.bytes().len > 0 {
            let u = p.resolve(it.alloc, b.bytes()) catch |e| {
                match e {
                    .OutOfMemory => {
                        return JsError.OutOfMemory
                    }
                    _ => {}
                }
                return securityMessage(it, p, b.bytes(), replace)
            }
            defer u.deinit(it.alloc)
            if !canRewrite(&p.url, &u) {
                return securityMessage(it, p, u.href, replace)
            }
            href.clear()
            try href.append(u.href)
        }
    }
    let h = p.sessionHistory()
    if replace {
        try h.replace(href.bytes(), state.bytes())
    } else {
        saveScriptScroll(p)
        let e = h.now()
        try h.push(href.bytes(), e.doc, state.bytes(), e.manual_scroll)
    }
    try setDocumentUrl(p, href.bytes())
    return Value.Null
}

// Chrome's message for a URL pushState cannot take.
fn securityMessage(it: *mut Interp, p: *mut Page, target: []u8, replace: bool) JsError!Value {
    let b = try it.builder()
    defer it.release(b)
    try b.append("Failed to execute '")
    if replace {
        try b.append("replaceState")
    } else {
        try b.append("pushState")
    }
    try b.append("' on 'History': A history state object with URL '")
    try b.append(target)
    try b.append("' cannot be created in a document with origin '")
    try appendUrlPart(b, &p.url, "origin")
    try b.append("' and URL '")
    try b.append(p.url.href)
    try b.append("'.")
    return it.newString(b.bytes())
}

// historyGo(step), step not 0: true when the entry is of this document
// (the prelude traverses to it in a task: `historyMove`); for another
// document's, the front end loads it after the script.
fn akHistoryGo(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)
    let step = (try it.toNumber(it.arg(a, 0))) as i64
    let h = s.page.sessionHistory()
    let at = h.indexAt(step) orelse return js.boolVal(false)
    if h.entries.items()[at].doc == h.now().doc {
        return js.boolVal(true)
    }
    s.nav_kind = NavKind.History
    s.nav_step = step
    return js.boolVal(false)
}

// historyMove(step): the traversal history.go queued, now: to an entry
// of this document, [old URL, new URL, its serialized state or null];
// else null (for another document's, the front end loads it).
fn akHistoryMove(it: *mut Interp, a: Args) JsError!Value {
    let s = scriptOf(it)
    let p = s.page
    let step = (try it.toNumber(it.arg(a, 0))) as i64
    let h = p.sessionHistory()
    let at = h.indexAt(step) orelse return Value.Null
    if h.entries.items()[at].doc != h.now().doc {
        s.nav_kind = NavKind.History
        s.nav_step = step
        return Value.Null
    }
    let arr = try it.newArray(0)
    try it.push(js.objVal(arr))
    let old = try it.newString(p.url.href)
    try it.heap.pushElem(arr, old)
    try moveInDocument(p, at)
    let now = try it.newString(p.url.href)
    try it.heap.pushElem(arr, now)
    if h.now().state |st| {
        let v = try it.newString(st)
        try it.heap.pushElem(arr, v)
    } else {
        try it.heap.pushElem(arr, Value.Null)
    }
    return it.pop()
}

// scrollRestoration(): is the current entry's "manual"?
// scrollRestoration(manual): sets it.
fn akScrollRestoration(it: *mut Interp, a: Args) JsError!Value {
    let e = scriptOf(it).page.sessionHistory().now()
    if !js.isUndef(it.arg(a, 0)) {
        e.manual_scroll = it.toBoolean(it.arg(a, 0))
    }
    return js.boolVal(e.manual_scroll)
}

fn akSetHistoryHandler(it: *mut Interp, a: Args) JsError!Value {
    let f = try js.callableArg(it, a, 0)
    scriptOf(it).history_hook = try it.addRoot(f)
    return Value.Undefined
}
