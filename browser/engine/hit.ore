// Questions about a laid-out page, in document coordinates (CSS px from
// the top-left of the document): what is at a point (`nodeAt`,
// `linkAt`), where text occurs (`findText`), and where a fragment's
// element is (`fragmentY`).

import css
import dom
import dom.Kind
import dom.NodeId
import layout
import layout.BoxKind
import layout.FragKind
import layout.Tree
import paint
import std.list.List
import std.mem.AllocError
import std.sort
import std.text

/// A link: the `a` element and its `href` (in the document).
pub struct Link {
    el: NodeId
    href: []u8
}

fn inside(x: f64, y: f64, rx: f64, ry: f64, rw: f64, rh: f64) bool {
    return x >= rx && x < rx + rw && y >= ry && y < ry + rh
}

/// The deepest node whose box (or line fragment) contains (`x`, `y`):
/// a text node or an element; null for none. The topmost wins: layers
/// (positioned and transformed boxes) are searched in the reverse of
/// their painting order (inside the transforms of their layers), and
/// content clipped by `overflow` is not hit outside its clip.
pub fn nodeAt(t: *Tree, x: f64, y: f64) ?NodeId {
    if t.root |r| {
        return hitLayer(t, r, x, y) catch null
    }
    return null
}

fn hitLayer(t: *Tree, i: usize, x0: f64, y0: f64) AllocError!?NodeId {
    // A point of a transformed layer: where it was before the transform.
    var x = x0
    var y = y0
    if t.bx(i).xform != null {
        let inv = layout.xformOf(t, i).inverse() orelse return null
        x = inv.x(x0, y0)
        y = inv.y(x0, y0)
    }
    var ls = List(paint.LayerRef).init(t.backing)
    defer ls.deinit()
    try paint.layersOf(t, i, &mut ls)
    let all = ls.items()
    var k = all.len
    while k > 0 {
        k -= 1
        if all[k].z >= 0.0 {
            if try hitLayer(t, all[k].box, x, y) |n| {
                return n
            }
        }
    }
    if hitBox(t, i, x, y, i) |n| {
        return n
    }
    k = all.len
    while k > 0 {
        k -= 1
        if all[k].z < 0.0 {
            if try hitLayer(t, all[k].box, x, y) |n| {
                return n
            }
        }
    }
    return null
}

// Does box `i` clip its content to its padding box (overflow other
// than visible; not the root and the body)?
fn clips(t: *Tree, i: usize) bool {
    let b = t.bx(i)
    if layout.isKeyword(b.style[css.OVERFLOW_X], "visible") && layout.isKeyword(b.style[css.OVERFLOW_Y], "visible") {
        return false
    }
    if t.root == i {
        return false
    }
    if b.node |el| {
        if t.doc.isElement(el, "body") {
            return false
        }
    }
    return true
}

// The floats among the inline content of box `i`, topmost first.
fn hitFloats(t: *Tree, i: usize, x: f64, y: f64, layer: usize) ?NodeId {
    let kids = t.children(i)
    var k = kids.len
    while k > 0 {
        k -= 1
        let c = kids[k]
        if t.bx(c).float != 0 {
            if hitBox(t, c, x, y, layer) |n| {
                return n
            }
        } else if t.bx(c).kind == BoxKind.Inline {
            if hitFloats(t, c, x, y, layer) |n| {
                return n
            }
        }
    }
    return null
}

// Box `i` of the layer `layer` (other layers are left out).
fn hitBox(t: *Tree, i: usize, x: f64, y: f64, layer: usize) ?NodeId {
    if i != layer && paint.isLayer(t, i) {
        return null
    }
    let b = t.bx(i).*
    if clips(t, i) && !inside(x, y, b.ax + b.border[3], b.ay + b.border[0], b.w - b.border[1] - b.border[3], b.h - b.border[0] - b.border[2]) {
        if inside(x, y, b.ax, b.ay, b.w, b.h) {
            return b.node
        }
        return null
    }
    if layout.hasInlineContent(t, i) {
        let cx = b.ax + b.border[3] + b.padding[3]
        let cy = b.ay + b.border[0] + b.padding[0]
        var li = b.line_end
        while li > b.line_start {
            li -= 1
            let line = t.lines.items()[li]
            var fi = line.frag_end
            while fi > line.frag_start {
                fi -= 1
                let f = t.frags.items()[fi]
                if f.kind == FragKind.Atomic {
                    if hitBox(t, f.box, x, y, layer) |n| {
                        return n
                    }
                } else if inside(x, y, cx + f.x, cy + f.y, f.w, f.h) {
                    if nodeOf(t, f.box) |n| {
                        return n
                    }
                }
            }
        }
        if hitFloats(t, i, x, y, layer) |n| {
            return n
        }
    } else {
        let kids = t.children(i)
        var k = kids.len
        while k > 0 {
            k -= 1
            if hitBox(t, kids[k], x, y, layer) |n| {
                return n
            }
        }
    }
    if b.kind != BoxKind.Inline && b.kind != BoxKind.Text && inside(x, y, b.ax, b.ay, b.w, b.h) {
        return nodeOf(t, i)
    }
    return null
}

// The node of box `i`: for a pseudo-element's box, its element's.
fn nodeOf(t: *Tree, i: usize) ?NodeId {
    var cur: ?usize = i
    while cur |k| {
        let b = t.bx(k)
        if b.pseudo == 0 {
            return b.node
        }
        cur = b.parent
    }
    return null
}

/// The link at (`x`, `y`): the nearest `a` element with an `href`
/// around the node there, or a frame (`iframe`, `embed`, `object`) and
/// the address it shows.
pub fn linkAt(t: *Tree, x: f64, y: f64) ?Link {
    var cur = nodeAt(t, x, y)
    while cur |n| {
        if paint.frameSource(t.doc, n) |src| {
            if src.len > 0 {
                return Link { el: n, href: src }
            }
        }
        if t.doc.isElement(n, "a") {
            if t.doc.attr(n, "href") |href| {
                return Link { el: n, href: href }
            }
        }
        cur = t.doc.parent(n)
    }
    return null
}

/// Appends to `out` the rectangle of each occurrence of `query` (ASCII
/// letters in any case) in the text of the page, top to bottom. Text
/// that spans fragments (across lines or inline boxes) is not found.
pub fn findText(t: *mut Tree, query: []u8, out: *mut List(paint.Rect)) AllocError!void {
    if query.len == 0 {
        return
    }
    let first = out.len()
    for i in 0..t.boxes.len() {
        if !layout.hasInlineContent(t, i) {
            continue
        }
        let b = t.bx(i).*
        let cx = b.ax + b.border[3] + b.padding[3]
        let cy = b.ay + b.border[0] + b.padding[0]
        for li in b.line_start..b.line_end {
            let line = t.lines.items()[li]
            for fi in line.frag_start..line.frag_end {
                let f = t.frags.items()[fi]
                if f.kind != FragKind.Text {
                    continue
                }
                let tb = t.bx(f.box).*
                if !layout.isKeyword(tb.style[css.VISIBILITY], "visible") {
                    continue
                }
                let s = tb.text[f.start..f.end]
                let face = layout.fontOf(tb.style)
                var k: usize = 0
                while k + query.len <= s.len {
                    if text.eqlIgnoreCase(s[k..k + query.len], query) {
                        let x0 = t.measure.width(face, s[..k])
                        let w = t.measure.width(face, s[k..k + query.len])
                        try out.append(paint.Rect { x: cx + f.x + x0, y: cy + f.y, w: w, h: f.h })
                        k += query.len
                    } else {
                        k += 1
                    }
                }
            }
        }
    }
    sort.sort(paint.Rect, out.items()[first..], above)
}

fn above(a: paint.Rect, b: paint.Rect) bool {
    if a.y != b.y {
        return a.y < b.y
    }
    return a.x < b.x
}

/// The top of the element whose `id` (or, for an `a`, `name`) is
/// `fragment`; null when there is none or it has no box.
pub fn fragmentY(t: *Tree, fragment: []u8) ?f64 {
    var target: ?NodeId = t.doc.getElementById(fragment)
    if target == null {
        var cur: ?NodeId = t.doc.root
        while cur |n| {
            if t.doc.isElement(n, "a") {
                if t.doc.attr(n, "name") |name| {
                    if text.eql(name, fragment) {
                        target = n
                        break
                    }
                }
            }
            cur = t.doc.following(n, t.doc.root)
        }
    }
    if target |el| {
        return topOf(t, el)
    }
    return null
}

// The top of the first box or fragment of `el`, or of the first one of
// a node after it.
fn topOf(t: *Tree, el: NodeId) ?f64 {
    var cur: ?NodeId = el
    while cur |n| {
        for i in 0..t.boxes.len() {
            let b = t.bx(i)
            if dom.isSame(b.node, n) {
                if b.kind != BoxKind.Inline && b.kind != BoxKind.Text {
                    return b.ay
                }
                if fragTop(t, i) |y| {
                    return y
                }
            }
        }
        cur = t.doc.following(n, t.doc.root)
    }
    return null
}

// The top of the first fragment of the inline or text box `i`.
fn fragTop(t: *Tree, i: usize) ?f64 {
    for c in 0..t.boxes.len() {
        if !layout.hasInlineContent(t, c) {
            continue
        }
        let b = t.bx(c).*
        for li in b.line_start..b.line_end {
            let line = t.lines.items()[li]
            for fi in line.frag_start..line.frag_end {
                let f = t.frags.items()[fi]
                if f.box == i {
                    return b.ay + b.border[0] + b.padding[0] + f.y
                }
            }
        }
    }
    return null
}
