// Default actions of an activation (a click that no listener canceled)
// for clicks that scripts make (`el.click()`): links navigate (after the
// script returns), checkboxes and radio buttons change and fire `input`
// and `change`, submit buttons fire `submit` at their form, labels pass
// the click to their control.
//
// The window and the agent have default actions of their own for the
// user's clicks; forms (submitting, editing) belong to them and to B5:
// `submitForm` is where a submission goes.

import dom.Kind
import dom.NodeId
import html
import std
import std.mem.AllocError
import std.text
import url

/// The default action of a click on `el` that no listener canceled.
pub fn activate(p: *mut Page, el: NodeId) AllocError!void {
    let doc = &mut p.doc
    var cur: ?NodeId = el
    while cur |c| {
        if (doc.isElement(c, "a") || doc.isElement(c, "area")) && doc.attr(c, "href") != null {
            return followFromScript(p, doc.attr(c, "href").?)
        }
        cur = doc.parent(c)
    }
    if doc.isElement(el, "input") {
        let kind = inputKind(p, el)
        if text.eqlIgnoreCase(kind, "checkbox") {
            if doc.attr(el, "checked") != null {
                doc.removeAttr(el, "checked")
            } else {
                try doc.setAttr(el, "checked", "")
            }
            return changedByUser(p, el)
        }
        if text.eqlIgnoreCase(kind, "radio") {
            if doc.attr(el, "checked") == null {
                uncheckGroup(p, el)
                try p.doc.setAttr(el, "checked", "")
                return changedByUser(p, el)
            }
            return
        }
    }
    if isSubmitter(p, el) {
        if formAround(p, el) |f| {
            if try dispatchEvent(p, f, "submit", "") {
                try submitForm(p, f)
            }
        }
        return
    }
    if doc.isElement(el, "label") {
        if controlOf(p, el) |control| {
            if try dispatchEvent(p, control, "click", "") {
                try activate(p, control)
            }
        }
    }
}

/// Submits `form` (no listener canceled its submit event). Submitting
/// belongs to forms (B5); until then nothing happens.
pub fn submitForm(p: *mut Page, form: NodeId) AllocError!void {
}

// The type of an input, "text" when missing.
fn inputKind(p: *mut Page, el: NodeId) []u8 {
    return text.trim(p.doc.attr(el, "type") orelse "text")
}

fn changedByUser(p: *mut Page, el: NodeId) AllocError!void {
    if p.script |s| {
        s.version += 1
    }
    try dispatchEvent(p, el, "input", "")
    try dispatchEvent(p, el, "change", "")
}

// Unchecks the other radio buttons of the group of `el`.
fn uncheckGroup(p: *mut Page, el: NodeId) {
    let group = p.doc.attr(el, "name") orelse return
    let form = formAround(p, el)
    var cur: ?NodeId = p.doc.root
    while cur |h| {
        if !(h == el) && p.doc.isElement(h, "input") && text.eqlIgnoreCase(inputKind(p, h), "radio") {
            if p.doc.attr(h, "name") |g| {
                if text.eql(g, group) && formAround(p, h) == form {
                    p.doc.removeAttr(h, "checked")
                }
            }
        }
        cur = p.doc.following(h, p.doc.root)
    }
}

fn isSubmitter(p: *mut Page, el: NodeId) bool {
    if p.doc.isElement(el, "button") {
        if p.doc.attr(el, "type") |t| {
            return text.eqlIgnoreCase(text.trim(t), "submit")
        }
        return true
    }
    if p.doc.isElement(el, "input") {
        let t = inputKind(p, el)
        return text.eqlIgnoreCase(t, "submit") || text.eqlIgnoreCase(t, "image")
    }
    return false
}

// The form of a control: its `form` attribute, else the nearest `form`
// around it.
fn formAround(p: *mut Page, el: NodeId) ?NodeId {
    if p.doc.attr(el, "form") |id| {
        if p.doc.getElementById(id) |f| {
            return f
        }
    }
    var cur = p.doc.parent(el)
    while cur |c| {
        if p.doc.isElement(c, "form") {
            return c
        }
        cur = p.doc.parent(c)
    }
    return null
}

// The control of a label: `for`, else the first control inside it.
fn controlOf(p: *mut Page, label: NodeId) ?NodeId {
    if p.doc.attr(label, "for") |id| {
        return p.doc.getElementById(id)
    }
    var cur = p.doc.following(label, label)
    while cur |c| {
        let n = p.doc.node(c)
        if n.kind == Kind.Element && html.isIn(n.name, "input select textarea button") {
            return c
        }
        cur = p.doc.following(c, label)
    }
    return null
}

// A link a script clicked: the tab navigates once the script returns.
fn followFromScript(p: *mut Page, href: []u8) AllocError!void {
    let s = p.script orelse return
    let target = url.resolve(s.alloc, &p.url, text.trim(href)) catch |e| {
        return
    }
    defer target.deinit(s.alloc)
    if text.eql(target.scheme, "javascript") {
        return
    }
    let copy = try s.alloc.alloc(0 as u8, target.href.len)
    std.mem.copy(copy, target.href)
    s.alloc.free(s.nav_href)
    s.nav_href = copy
    s.nav_kind = NavKind.To
}
