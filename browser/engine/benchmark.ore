// Only the offline benchmark runner opts into this environment. Pin
// JavaScript's wall clock to a fixed epoch plus the page's clock
// (`ak.now()`, which `performance.now()` returns too; virtual in `dump`)
// and seed the PRNG, so cache-busting request URLs replay; ordinary
// browsing and the conformance tests keep the real builtins.
extern fn getenv(name: [*]u8) ?[*]u8

fn benchmarkEnabled() bool {
    if getenv("ANYKNOWN_BENCHMARK".ptr) |p| {
        return p[0] == '1'
    }
    return false
}

let BENCHMARK_PRELUDE =
    \\(function () {
    \\  const RealDate = Date;
    \\  const ak = globalThis.__ak;
    \\  const epoch = 1791331200000;
    \\  function now() { return epoch + Math.floor(ak.now()); }
    \\  function FrozenDate(...args) {
    \\    if (!new.target) return new RealDate(now()).toString();
    \\    return args.length ? new RealDate(...args) : new RealDate(now());
    \\  }
    \\  Object.setPrototypeOf(FrozenDate, RealDate);
    \\  FrozenDate.prototype = RealDate.prototype;
    \\  FrozenDate.now = now;
    \\  Date = FrozenDate;
    \\  let seed = 1;
    \\  Math.random = function () {
    \\    seed = (seed * 1664525 + 1013904223) >>> 0;
    \\    return seed / 4294967296;
    \\  };
    \\})();
