// The images of a page: every `img` (and `input type=image`) with a
// `src` or a `srcset` (sources.ore picks one) is fetched (relative to the page's base URL, with the page's URL
// as the Referer; `data:` URLs too) and decoded once per URL (an SVG
// image becomes an `svg.Picture` and a bitmap with its natural size and
// no pixels), and the elements are mapped to their bitmaps for layout
// (natural sizes) and paint. `updateImages` runs before each layout and
// only fetches what is new (elements added by scripts); a URL that
// failed is not fetched again. The images of the style sheets
// (`background-image`, `mask-image` of the elements that are displayed)
// are fetched with them, and mapped by their URL for paint.

import css
import dom
import dom.Document
import dom.NodeId
import image
import font
import layout
import net
import perf
import std
import std.heap.Arena
import std.list.List
import std.mem.AllocError
import std.mem.Allocator
import std.text
import svg
import url
import url.Url

/// One fetched URL and its bitmap (null when it could not be fetched
/// or decoded), and its picture when it is an SVG image.
struct CachedImage {
    href: []mut u8
    bmp: ?*mut image.Bitmap
    pic: ?*mut svg.Picture
    // Canvas reads are refused for cross-origin images, including redirects.
    tainted: bool
}

pub struct ImageCache {
    alloc: Allocator
    entries: List(CachedImage)
    nodes: layout.Images
    canvases: List(CanvasBitmap)
    canvas_fonts: ?*mut font.System
    // The URL of the page, sent as the Referer (owned).
    referrer: []mut u8
    // The keys of `nodes.urls` (owned).
    keys: List([]mut u8)

    pub fn init(alloc: Allocator) ImageCache {
        return ImageCache { alloc: alloc, entries: List(CachedImage).init(alloc), nodes: layout.Images.init(alloc), canvases: List(CanvasBitmap).init(alloc), canvas_fonts: null, referrer: alloc.alloc(0 as u8, 0) catch unreachable, keys: List([]mut u8).init(alloc) }
    }

    pub fn deinit(self: *mut Self) {
        for e in self.entries.items() {
            self.alloc.free(e.href)
            if e.bmp |b| {
                b.deinit(self.alloc)
                self.alloc.destroy(b)
            }
            if e.pic |p| {
                p.deinit()
                self.alloc.destroy(p)
            }
        }
        self.entries.deinit()
        for c in self.canvases.items() {
            c.bmp.deinit(self.alloc)
            self.alloc.destroy(c.bmp)
        }
        self.canvases.deinit()
        if self.canvas_fonts |sys| {
            sys.deinit()
            self.alloc.destroy(sys)
        }
        self.nodes.deinit()
        self.alloc.free(self.referrer)
        for k in self.keys.items() {
            self.alloc.free(k)
        }
        self.keys.deinit()
    }

    // Sends `href` as the Referer of the images fetched from now on.
    fn setReferrer(self: *mut Self, href: []u8) AllocError!void {
        let copy = try self.alloc.alloc(0 as u8, href.len)
        std.mem.copy(copy, href)
        self.alloc.free(self.referrer)
        self.referrer = copy
    }

    // Was `href` fetched already (decoded or not)?
    fn known(self: *Self, href: []u8) bool {
        for e in self.entries.items() {
            if text.eql(e.href, href) {
                return true
            }
        }
        return false
    }

    /// The picture of `href` when it is a fetched SVG image.
    fn pictureOf(self: *Self, href: []u8) ?*mut svg.Picture {
        for e in self.entries.items() {
            if text.eql(e.href, href) {
                return e.pic
            }
        }
        return null
    }

    /// The bitmap of `href`, fetched and decoded the first time.
    fn bitmapOf(self: *mut Self, href: []u8) AllocError!?*mut image.Bitmap {
        for e in self.entries.items() {
            if text.eql(e.href, href) {
                return e.bmp
            }
        }
        let owned = try self.alloc.alloc(0 as u8, href.len)
        std.mem.copy(owned, href)
        var bmp: ?*mut image.Bitmap = null
        var pic: ?*mut svg.Picture = null
        var tainted = true
        let decoded = fetchImage(self.alloc, href, self.referrer, &mut pic, &mut tainted)
        if decoded |d| {
            bmp = self.alloc.create(d) catch |e| {
                var lost = d
                lost.deinit(self.alloc)
                self.alloc.free(owned)
                dropPicture(self.alloc, pic)
                return e
            }
        }
        self.entries.append(CachedImage { href: owned, bmp: bmp, pic: pic, tainted: tainted }) catch |e| {
            self.alloc.free(owned)
            if bmp |b| {
                b.deinit(self.alloc)
                self.alloc.destroy(b)
            }
            dropPicture(self.alloc, pic)
            return e
        }
        return bmp
    }
}

// Image responses do not yet implement CORS validation. A crossorigin
// attribute alone must never grant access to pixels. Compare the final
// response URL; a same-origin redirect may lead to another origin.
fn imageOriginDiffers(alloc: Allocator, referrer: []u8, href: []u8) bool {
    let imageUrl = url.parse(alloc, href) catch |e| {
        return true
    }
    defer imageUrl.deinit(alloc)
    if text.eql(imageUrl.scheme, "data") {
        return false
    }
    let pageUrl = url.parse(alloc, referrer) catch |e| {
        return true
    }
    defer pageUrl.deinit(alloc)
    return !text.eql(imageUrl.scheme, pageUrl.scheme) || !text.eql(imageUrl.host, pageUrl.host) || !text.eql(imageUrl.port, pageUrl.port)
}

fn dropPicture(alloc: Allocator, pic: ?*mut svg.Picture) {
    if pic |p| {
        p.deinit()
        alloc.destroy(p)
    }
}

// Fetches and decodes `href`; null when either fails. An SVG image
// goes to `pic`, its bitmap is only its natural size.
fn fetchImage(alloc: Allocator, href: []u8, referrer: []u8, pic: *mut ?*mut svg.Picture, tainted: *mut bool) ?image.Bitmap {
    let target = url.parse(alloc, href) catch |e| {
        return null
    }
    defer target.deinit(alloc)
    let res = net.request(alloc, &target, net.Request { kind: net.Kind.Image, referrer: referrer }) catch |e| {
        return null
    }
    defer res.deinit(alloc)
    if res.status >= 400 {
        return null
    }
    var responseHref = target.href
    if res.url.len > 0 {
        responseHref = res.url
    }
    tainted.* = imageOriginDiffers(alloc, referrer, responseHref)
    let decode_began = perf.start()
    defer perf.end("image_decode", decode_began, href)
    if isSvg(res.mime, res.body) {
        return svgImage(alloc, res.body, pic)
    }
    let bmp = image.decode(alloc, res.body) catch |e| {
        return null
    }
    return bmp
}

// Is the response an SVG image (by its type, or by a start that is
// markup and not a raster signature)?
fn isSvg(mime: []u8, body: []u8) bool {
    if image.sniff(body) != image.Format.Unknown {
        return false
    }
    if text.eql(mime, "image/svg+xml") {
        return true
    }
    let head = text.trim(body[..std.math.minOf(usize, body.len, 1024)])
    return text.startsWith(head, "<") && text.indexOf(head, "<svg") != null
}

fn svgImage(alloc: Allocator, body: []u8, out: *mut ?*mut svg.Picture) ?image.Bitmap {
    let p = svg.parseImage(alloc, body) catch |e| {
        return null
    }
    let pic = p orelse return null
    let size = pic.naturalSize()
    let none = alloc.alloc(0 as u8, 0) catch |e| {
        dropPicture(alloc, pic)
        return null
    }
    out.* = pic
    return image.Bitmap { width: pixelsOf(size.w), height: pixelsOf(size.h), pixels: none }
}

fn pixelsOf(v: f64) usize {
    if v < 1.0 {
        return 1
    }
    if v > 16384.0 {
        return 16384
    }
    return std.math.floor(v + 0.5) as usize
}

// One selected request, with an owned resolved URL. Script state and
// rendering use the same source selector and the same decoded URL cache.
struct LoadedElementImage {
    // Owned resolved URL; the caller releases it with cache.alloc.
    target: Url
    // Borrowed decoded bitmap; null for a broken request.
    bmp: ?*mut image.Bitmap
    // Selected source density in image pixels per CSS pixel.
    density: f64
}

fn loadElementImage(cache: *mut ImageCache, doc: *Document, h: NodeId, base: *Url, media: css.Media) AllocError!?LoadedElementImage {
    // Even an empty or broken replacement must drop the old rendered bitmap.
    cache.nodes.map.remove(h.index)
    let choice = (try chooseImage(cache.alloc, doc, h, media)) orelse return null
    let target = url.resolve(cache.alloc, base, choice.url) catch return null
    errdefer target.deinit(cache.alloc)
    let bmp = try cache.bitmapOf(target.withoutFragment())
    if bmp |b| {
        if cache.pictureOf(target.withoutFragment()) |pic| {
            try cache.nodes.putPicture(h, b, pic)
        } else {
            try cache.nodes.putScaled(h, b, choice.density)
        }
    }
    return LoadedElementImage { target: target, bmp: bmp, density: choice.density }
}

/// Fetches the images of the page's elements and style sheets that have
/// none yet, and maps the elements (and URLs) to their bitmaps. `media`
/// (the viewport) picks among `srcset` candidates and `picture` sources.
pub fn updateImages(page: *mut Page, media: css.Media) AllocError!void {
    if page.images == null {
        page.images = try page.alloc.create(ImageCache.init(page.alloc))
    }
    var styles: ?*css.Styles = null
    if page.styling |st| {
        styles = &st.styles
    }
    return fillImagesWith(page.images.?, &page.doc, &page.url, styles, media)
}

/// Fetches the images of the elements of `doc` (whose URL is
/// `address`) that `cache` has no bitmap for, resolving their URLs
/// against the document's base URL.
pub fn fillImages(cache: *mut ImageCache, doc: *Document, address: *Url, media: css.Media) AllocError!void {
    return fillImagesWith(cache, doc, address, null, media)
}

// `fillImages`, and the images of the style sheets when there are
// `styles`.
fn fillImagesWith(cache: *mut ImageCache, doc: *Document, address: *Url, styles: ?*css.Styles, media: css.Media) AllocError!void {
    if cache.referrer.len == 0 {
        try cache.setReferrer(address.href)
    }
    var base = try documentBase(cache.alloc, doc, address)
    defer base.deinit(cache.alloc)
    var arena = Arena.init(cache.alloc)
    defer arena.deinit()
    var keys = List([]u8).init(arena.allocator())
    if styles |st| {
        try styleUrls(arena.allocator(), doc, st, &cache.nodes, &mut keys)
    }
    try prefetchImages(cache, doc, &base, keys.items(), media)
    for key in keys.items() {
        if cache.nodes.hasUrl(key) {
            continue
        }
        let target = url.resolve(cache.alloc, &base, text.trim(key)) catch |e| {
            continue
        }
        defer target.deinit(cache.alloc)
        if try cache.bitmapOf(target.withoutFragment()) |bmp| {
            let owned = try cache.alloc.alloc(0 as u8, key.len)
            std.mem.copy(owned, key)
            cache.keys.append(owned) catch |e| {
                cache.alloc.free(owned)
                return e
            }
            try cache.nodes.putUrl(owned, bmp, cache.pictureOf(target.withoutFragment()))
        }
    }
    var cur: ?NodeId = doc.root
    while cur |h| {
        cur = dom.shadowIncludingFollowing(doc, h, doc.root)
        if !isImageElement(doc, h) {
            continue
        }
        if try loadElementImage(cache, doc, h, &base, media) |loaded| {
            loaded.target.deinit(cache.alloc)
        }
    }
}

// Fetches the new images of `doc` (and the URLs `extra` of its style
// sheets) concurrently into the session's cache (net.prefetch), before
// `fillImages` takes them one by one.
fn prefetchImages(cache: *mut ImageCache, doc: *Document, base: *Url, extra: [][]u8, media: css.Media) AllocError!void {
    var hrefs = text.Builder.init(cache.alloc)
    defer hrefs.deinit()
    for key in extra {
        if cache.nodes.hasUrl(key) {
            continue
        }
        let target = url.resolve(cache.alloc, base, text.trim(key)) catch |e| {
            continue
        }
        defer target.deinit(cache.alloc)
        if !cache.known(target.withoutFragment()) && !text.startsWith(target.href, "data:") {
            try hrefs.append(target.withoutFragment())
            try hrefs.appendByte('\n')
        }
    }
    var cur: ?NodeId = doc.root
    while cur |h| {
        cur = dom.shadowIncludingFollowing(doc, h, doc.root)
        if !isImageElement(doc, h) {
            continue
        }
        let choice = (try chooseImage(cache.alloc, doc, h, media)) orelse continue
        let target = url.resolve(cache.alloc, base, choice.url) catch |e| {
            continue
        }
        defer target.deinit(cache.alloc)
        if cache.known(target.withoutFragment()) {
            continue
        }
        try hrefs.append(target.withoutFragment())
        try hrefs.appendByte('\n')
    }
    net.prefetch(cache.alloc, hrefs.bytes(), net.Kind.Image, cache.referrer)
}

// The URLs of the images of the style sheets (as their computed values
// write them) that elements of `doc` that are displayed (or their
// `::before` and `::after`) use, and that
// `nodes` has no image for, into `out` (allocated with `alloc`, an
// arena).
fn styleUrls(alloc: Allocator, doc: *Document, styles: *css.Styles, nodes: *layout.Images, out: *mut List([]u8)) AllocError!void {
    var cur: ?NodeId = doc.root
    while cur |h| {
        cur = dom.shadowIncludingFollowing(doc, h, doc.root)
        let values = styles.get(h) orelse continue
        let start = out.len()
        try css.layerUrls(alloc, values[css.BACKGROUND_IMAGE], out)
        try css.layerUrls(alloc, values[css.MASK_IMAGE], out)
        // Its `::before` and `::after` too.
        for which in 1..3 {
            if styles.pseudo(h, which as u8) |pv| {
                try css.layerUrls(alloc, pv[css.BACKGROUND_IMAGE], out)
                try css.layerUrls(alloc, pv[css.MASK_IMAGE], out)
            }
        }
        if out.len() == start {
            continue
        }
        if !displayed(doc, styles, h) {
            while out.len() > start {
                _ = out.pop()
            }
            continue
        }
        var k = start
        while k < out.len() {
            let key = out.items()[k]
            var seen = nodes.hasUrl(key)
            for j in 0..k {
                seen = seen || text.eql(out.items()[j], key)
            }
            if seen {
                _ = out.swapRemove(k)
            } else {
                k += 1
            }
        }
    }
}

// Is `el` displayed (no `display: none` on it or an ancestor)?
fn displayed(doc: *Document, styles: *css.Styles, el: NodeId) bool {
    var cur: ?NodeId = el
    while cur |h| {
        if styles.get(h) |values| {
            if layout.isKeyword(values[css.DISPLAY], "none") {
                return false
            }
        }
        cur = dom.flatParent(doc, h)
    }
    return true
}

fn isImageElement(doc: *Document, el: NodeId) bool {
    if doc.isElement(el, "img") {
        return true
    }
    return doc.isElement(el, "input") && text.eql(dom.inputType(doc, el), "image")
}
