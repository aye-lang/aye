// Web components for scripts: shadow roots and slots (attachShadow,
// ShadowRoot, assignedNodes, assignedSlot), what custom elements need
// from the DOM (the elements that may be custom in shadow-including
// order, their state for `:defined`), adopted style sheets, and the
// document's mutation log handed to the prelude's hook, which turns it
// into MutationObserver records, custom element reactions and
// slotchange events (prelude.ore).
//
// The log (dom.Document.log) is kept only while `recording`, which the
// prelude turns on once a script observes mutations, defines a custom
// element or attaches a shadow root. Every native that changes the tree
// ends with `changed` (dom_api.ore), which hands the records over: the
// reactions run before the native returns, as [CEReactions] want.

import dom
import dom.Document
import dom.Kind
import dom.Mutation
import dom.NodeId
import js
import js.Args
import js.Interp
import js.JsError
import js.Value
import std.list.List
import std.mem.AllocError
import std.text

fn installComponents(s: *mut Script, ak: u32) JsError!void {
    let it = &mut s.it
    s.shadow_proto = try newProto(it, s.fragment_proto)
    try interfaceObject(it, "ShadowRoot", s.shadow_proto)
    try accessor(it, s.shadow_proto, "host", shadowHost, null)
    try accessor(it, s.shadow_proto, "mode", shadowMode, null)
    try accessor(it, s.shadow_proto, "innerHTML", shadowInnerHtml, shadowSetInnerHtml)
    try defMethod(it, s.plain_element_proto, "attachShadow", 1, elementAttachShadow)
    try accessor(it, s.plain_element_proto, "shadowRoot", elementShadowRoot, null)
    try accessor(it, s.node_proto, "assignedSlot", nodeAssignedSlot, null)
    if s.tag_protos.get("slot") |sp| {
        try defMethod(it, sp, "assignedNodes", 0, slotAssignedNodes)
        try defMethod(it, sp, "assignedElements", 0, slotAssignedElements)
    }
    try defMethod(it, ak, "setMutationHook", 1, akSetMutationHook)
    try defMethod(it, ak, "setRecording", 1, akSetRecording)
    try defMethod(it, ak, "shadowRoot", 1, akShadowRoot)
    try defMethod(it, ak, "assignedSlot", 1, akAssignedSlot)
    try defMethod(it, ak, "shadowCount", 0, akShadowCount)
    try defMethod(it, ak, "slotChanges", 0, akSlotChanges)
    try defMethod(it, ak, "customIn", 2, akCustomIn)
    try defMethod(it, ak, "ceState", 1, akCeState)
    try defMethod(it, ak, "setCeState", 2, akSetCeState)
    try defMethod(it, ak, "setAdopted", 2, akSetAdopted)
}

// ---- the mutation log

/// Hands the records of the document's log to the prelude's hook as one
/// array of 7 values per record: the kind (0 a node taken out, 1 an
/// attribute, 2 character data, 3 a node added), the target, the node,
/// its previous and next sibling, the attribute's name and the old value.
fn flushMutations(it: *mut Interp) JsError!void {
    let s = scriptOf(it)
    let doc = docOf(it)
    if doc.log.len() == 0 {
        return
    }
    var recs = List(Mutation).init(s.alloc)
    defer recs.deinit()
    try doc.takeLog(&mut recs)
    defer {
        for m in recs.items() {
            docOf(it).releaseRecord(m)
        }
    }
    if s.mutation_hook == js.NONE {
        return
    }
    let base = it.stack.len()
    try it.push(it.roots.items()[s.mutation_hook])
    try it.push(Value.Undefined)
    let arr = try it.newArray(0)
    try it.push(js.objVal(arr))
    for m in recs.items() {
        var kind = m.kind as f64
        if m.kind == 0 && m.added {
            kind = 3.0
        }
        try it.heap.pushElem(arr, js.numVal(kind))
        try it.heap.pushElem(arr, try liveWrap(it, m.target))
        try it.heap.pushElem(arr, try liveWrapOpt(it, m.node))
        try it.heap.pushElem(arr, try liveWrapOpt(it, m.prev))
        try it.heap.pushElem(arr, try liveWrapOpt(it, m.next))
        if m.kind == 1 {
            try it.heap.pushElem(arr, try it.newString(m.name))
        } else {
            try it.heap.pushElem(arr, Value.Null)
        }
        if m.old |o| {
            try it.heap.pushElem(arr, try it.newString(o))
        } else {
            try it.heap.pushElem(arr, Value.Null)
        }
    }
    try it.callAt(base, 1)
}

/// flushMutations for the browser's own changes (outside a native): an
/// exception is reported.
fn flushReported(s: *mut Script) AllocError!void {
    if s.page.doc.log.len() == 0 {
        return
    }
    enter(s)
    flushMutations(&mut s.it) catch |e| {
        leave(s)
        return uncaught(s, e)
    }
    leave(s)
}

fn liveWrap(it: *mut Interp, h: NodeId) JsError!Value {
    if docOf(it).isLive(h) {
        return wrap(it, h)
    }
    return Value.Null
}

fn liveWrapOpt(it: *mut Interp, h: ?NodeId) JsError!Value {
    if h |n| {
        return liveWrap(it, n)
    }
    return Value.Null
}

fn akSetMutationHook(it: *mut Interp, a: Args) JsError!Value {
    let f = try js.callableArg(it, a, 0)
    let s = scriptOf(it)
    if s.mutation_hook != js.NONE {
        it.removeRoot(s.mutation_hook)
    }
    s.mutation_hook = try it.addRoot(f)
    return Value.Undefined
}

fn akSetRecording(it: *mut Interp, a: Args) JsError!Value {
    docOf(it).recording = it.toBoolean(it.arg(a, 0))
    return Value.Undefined
}

// ---- shadow roots

fn thisShadowRoot(it: *mut Interp, a: Args) JsError!NodeId {
    let h = try thisNode(it, a)
    if !dom.isShadowRoot(docOf(it), h) {
        try it.typeError("Illegal invocation")
    }
    return h
}

fn elementAttachShadow(it: *mut Interp, a: Args) JsError!Value {
    let h = try thisElement(it, a)
    let init = it.arg(a, 0)
    if !js.isObject(init) {
        return it.typeError("Failed to execute 'attachShadow' on 'Element': 1 argument required, but only 0 present.")
    }
    let mv = try it.getProp(init, try it.intern("mode"))
    var closed = false
    if js.isStr(mv) && text.eql(it.heap.bytes(js.strOf(mv)), "closed") {
        closed = true
    } else if !js.isStr(mv) || !text.eql(it.heap.bytes(js.strOf(mv)), "open") {
        return it.typeError("Failed to execute 'attachShadow' on 'Element': Failed to read the 'mode' property from 'ShadowRootInit': The provided value is not a valid enum value of type ShadowRootMode.")
    }
    let doc = docOf(it)
    if !dom.canHostShadow(doc, h) {
        return domError(it, "NotSupportedError", "Failed to execute 'attachShadow' on 'Element': This element does not support attachShadow")
    }
    if doc.node(h).shadow != null {
        return domError(it, "NotSupportedError", "Failed to execute 'attachShadow' on 'Element': Shadow root cannot be created on a host which already hosts a shadow tree.")
    }
    let root = try dom.attachShadow(doc, h, closed)
    doc.recording = true
    try changed(it)
    return wrap(it, root)
}

fn elementShadowRoot(it: *mut Interp, a: Args) JsError!Value {
    let h = try thisElement(it, a)
    let doc = docOf(it)
    if dom.shadowRootOf(doc, h) |r| {
        if !dom.isClosedShadow(doc, r) {
            return wrap(it, r)
        }
    }
    return Value.Null
}

fn shadowHost(it: *mut Interp, a: Args) JsError!Value {
    let h = try thisShadowRoot(it, a)
    return wrapOpt(it, dom.hostOf(docOf(it), h))
}

fn shadowMode(it: *mut Interp, a: Args) JsError!Value {
    let h = try thisShadowRoot(it, a)
    return it.newString(docOf(it).node(h).data)
}

fn shadowInnerHtml(it: *mut Interp, a: Args) JsError!Value {
    let h = try thisShadowRoot(it, a)
    let b = try it.builder()
    defer it.release(b)
    try serializeChildren(docOf(it), h, b)
    return it.newString(b.bytes())
}

fn shadowSetInnerHtml(it: *mut Interp, a: Args) JsError!Value {
    let h = try thisShadowRoot(it, a)
    let b = try it.builder()
    defer it.release(b)
    if !js.isNullish(it.arg(a, 0)) {
        try argText(it, a, 0, b)
    }
    try replaceWithMarkup(it, h, "div", b.bytes())
    return Value.Undefined
}

// ---- slots

fn nodeAssignedSlot(it: *mut Interp, a: Args) JsError!Value {
    let h = try thisNode(it, a)
    let doc = docOf(it)
    try dom.assignSlots(doc)
    if doc.node(h).slot |slot| {
        let root = doc.treeRoot(slot)
        if !dom.isClosedShadow(doc, root) {
            return wrap(it, slot)
        }
    }
    return Value.Null
}

fn slotAssignedNodes(it: *mut Interp, a: Args) JsError!Value {
    return assigned(it, a, false)
}

fn slotAssignedElements(it: *mut Interp, a: Args) JsError!Value {
    return assigned(it, a, true)
}

// assignedNodes({ flatten }) and assignedElements: the nodes assigned
// to the slot; flattened, a slot among them is replaced by its own
// (and a slot with none by its children).
fn assigned(it: *mut Interp, a: Args, elements: bool) JsError!Value {
    let h = try thisElement(it, a)
    let doc = docOf(it)
    try dom.assignSlots(doc)
    var flatten = false
    let opts = it.arg(a, 0)
    if js.isObject(opts) {
        flatten = it.toBoolean(try it.getProp(opts, try it.intern("flatten")))
    }
    var out = List(NodeId).init(it.alloc)
    defer out.deinit()
    try collectAssigned(doc, h, flatten, elements, &mut out)
    return wrapAll(it, out.items())
}

fn collectAssigned(doc: *Document, slot: NodeId, flatten: bool, elements: bool, out: *mut List(NodeId)) AllocError!void {
    var cur = dom.firstAssigned(doc, slot)
    // Flattened, a slot with nothing assigned stands for its children.
    var own = false
    if cur == null && flatten {
        cur = doc.firstChild(slot)
        own = true
    }
    while cur |c| {
        let k = doc.node(c).kind
        if flatten && dom.isSlot(doc, c) && dom.hostOfTree(doc, c) != null {
            try collectAssigned(doc, c, true, elements, out)
        } else if k == Kind.Element || (!elements && k == Kind.Text) {
            try out.append(c)
        }
        if own {
            cur = doc.nextSibling(c)
        } else {
            cur = dom.flatNextSibling(doc, c)
        }
    }
}

// ---- for the prelude

fn akShadowRoot(it: *mut Interp, a: Args) JsError!Value {
    if handleOf(it, it.arg(a, 0), TAG_NODE) |h| {
        return wrapOpt(it, dom.shadowRootOf(docOf(it), h))
    }
    return Value.Null
}

fn akAssignedSlot(it: *mut Interp, a: Args) JsError!Value {
    if handleOf(it, it.arg(a, 0), TAG_NODE) |h| {
        let doc = docOf(it)
        try dom.assignSlots(doc)
        return wrapOpt(it, doc.node(h).slot)
    }
    return Value.Null
}

fn akShadowCount(it: *mut Interp, a: Args) JsError!Value {
    return js.numVal(docOf(it).shadows.len() as f64)
}

// The slots whose assigned nodes changed since the last call, after
// assigning the slots again.
fn akSlotChanges(it: *mut Interp, a: Args) JsError!Value {
    let doc = docOf(it)
    try dom.assignSlots(doc)
    var slots = List(NodeId).init(it.alloc)
    defer slots.deinit()
    for x in doc.changed_slots.items() {
        if doc.isLive(x) {
            try slots.append(x)
        }
    }
    doc.changed_slots.clear()
    return wrapAll(it, slots.items())
}

// customIn(node, name): the elements in the shadow-including inclusive
// subtree of `node`, in shadow-including tree order, that may be custom
// elements (a name with a hyphen, or an `is` attribute); only those
// named `name` (as local name or `is`) when it is a string.
fn akCustomIn(it: *mut Interp, a: Args) JsError!Value {
    let top = handleOf(it, it.arg(a, 0), TAG_NODE) orelse return wrapAll(it, []NodeId{})
    let doc = docOf(it)
    var want: []u8 = ""
    let nv = it.arg(a, 1)
    let b = try it.builder()
    defer it.release(b)
    if js.isStr(nv) {
        try b.append(it.heap.bytes(js.strOf(nv)))
        want = b.bytes()
    }
    var out = List(NodeId).init(it.alloc)
    defer out.deinit()
    var cur: ?NodeId = top
    while cur |h| {
        let n = doc.node(h)
        if n.kind == Kind.Element && n.ns == dom.NS_HTML {
            let is_attr = doc.attr(h, "is")
            var hit = false
            if want.len > 0 {
                hit = text.eql(n.name, want) || (is_attr != null && text.eql(is_attr.?, want))
            } else {
                hit = text.indexOf(n.name, "-") != null || is_attr != null
            }
            if hit {
                try out.append(h)
            }
        }
        cur = dom.shadowIncludingFollowing(doc, h, top)
    }
    return wrapAll(it, out.items())
}

fn akCeState(it: *mut Interp, a: Args) JsError!Value {
    if handleOf(it, it.arg(a, 0), TAG_NODE) |h| {
        return js.numVal(docOf(it).node(h).ce as f64)
    }
    return js.numVal(0.0)
}

fn akSetCeState(it: *mut Interp, a: Args) JsError!Value {
    if handleOf(it, it.arg(a, 0), TAG_NODE) |h| {
        let n = try it.toNumber(it.arg(a, 1))
        docOf(it).node(h).ce = n as u8
        let s = scriptOf(it)
        s.version += 1
        s.style_version += 1
    }
    return Value.Undefined
}

// setAdopted(root, css): the text of the style sheets adopted by the
// document or a shadow root.
fn akSetAdopted(it: *mut Interp, a: Args) JsError!Value {
    let root = handleOf(it, it.arg(a, 0), TAG_NODE) orelse return Value.Undefined
    let b = try it.builder()
    defer it.release(b)
    try argText(it, a, 1, b)
    let doc = docOf(it)
    let css = try doc.dup(b.bytes())
    var found = false
    for i in 0..doc.adopted.len() {
        if dom.same(doc.adopted.items()[i].root, root) {
            doc.adopted.items()[i].css = css
            found = true
        }
    }
    if !found {
        try doc.adopted.append(dom.Adopted { root: root, css: css })
        doc.node(root).js_refs += 1
    }
    try changed(it)
    return Value.Undefined
}
