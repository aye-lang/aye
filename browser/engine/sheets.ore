// The author style sheet of a document: its `<style>` elements and
// `<link rel=stylesheet>` sheets (fetched relative to the document's
// base URL, with the document's URL as the Referer; the session's cache
// keeps them), in document order, for the media that match. A sheet's
// `@import` rules are fetched relative to the sheet (its URL the Referer)
// and come before its rules (at most `MAX_IMPORT_DEPTH` sheets deep). The
// `url()`s of a fetched sheet are made absolute against its URL as it is
// parsed.

import css
import dom.Document
import dom.NodeId
import encoding
import net
import std.mem.AllocError
import std.mem.Allocator
import std.text
import url
import url.Url

/// Appends to `sheet` the style sheets of `doc`, whose URL is
/// `address`, whose media match. Sheets that cannot be fetched are
/// skipped.
pub fn authorSheets(alloc: Allocator, doc: *Document, address: *Url, media: css.Media, sheet: *mut css.Sheet) AllocError!void {
    var base = try documentBase(alloc, doc, address)
    defer base.deinit(alloc)
    try prefetchSheets(alloc, doc, &base, address, media, sheet)
    var cur: ?NodeId = doc.root
    while cur |h| {
        if doc.isElement(h, "style") && (try mediaOk(doc, h, media, sheet)) {
            var src = text.Builder.init(alloc)
            defer src.deinit()
            try doc.textContent(h, &mut src)
            try parseWithImports(alloc, &base, address, src.bytes(), media, sheet, false)
        } else if doc.isElement(h, "link") && isStylesheetLink(doc, h) && (try mediaOk(doc, h, media, sheet)) {
            if doc.attr(h, "href") |href| {
                try linkedSheet(alloc, &base, address, href, media, sheet)
            }
        }
        cur = doc.following(h, doc.root)
    }
}

// Fetches the linked sheets concurrently into the session's cache
// (net.prefetch), before they are taken one by one.
fn prefetchSheets(alloc: Allocator, doc: *Document, base: *Url, address: *Url, media: css.Media, sheet: *mut css.Sheet) AllocError!void {
    var hrefs = text.Builder.init(alloc)
    defer hrefs.deinit()
    var cur: ?NodeId = doc.root
    while cur |h| {
        if doc.isElement(h, "link") && isStylesheetLink(doc, h) && (try mediaOk(doc, h, media, sheet)) {
            if doc.attr(h, "href") |href| {
                if url.resolve(alloc, base, text.trim(href)) |target| {
                    defer target.deinit(alloc)
                    try hrefs.append(target.withoutFragment())
                    try hrefs.appendByte('\n')
                } else |e| {
                }
            }
        }
        cur = doc.following(h, doc.root)
    }
    net.prefetch(alloc, hrefs.bytes(), net.Kind.Style, address.href)
}

fn mediaOk(doc: *Document, el: NodeId, media: css.Media, sheet: *mut css.Sheet) AllocError!bool {
    if doc.attr(el, "media") |q| {
        return css.mediaMatches(sheet, q, media)
    }
    return true
}

// `rel` has the word `stylesheet` and not `alternate`.
fn isStylesheetLink(doc: *Document, el: NodeId) bool {
    var found = false
    if doc.attr(el, "rel") |rel| {
        var words = text.split(rel, " ")
        while words.next() |w| {
            if text.eqlIgnoreCase(w, "alternate") {
                return false
            }
            if text.eqlIgnoreCase(w, "stylesheet") {
                found = true
            }
        }
    }
    return found
}

fn linkedSheet(alloc: Allocator, base: *Url, address: *Url, href: []u8, media: css.Media, sheet: *mut css.Sheet) AllocError!void {
    let target = url.resolve(alloc, base, text.trim(href)) catch |e| {
        return
    }
    defer target.deinit(alloc)
    let res = net.request(alloc, &target, net.Request { kind: net.Kind.Style, referrer: address.href }) catch |e| {
        return
    }
    defer res.deinit(alloc)
    let src = try encoding.toUtf8(alloc, res.body, encoding.sniff(res.body, res.charset))
    defer alloc.free(src)
    try parseWithImports(alloc, &target, &target, src, media, sheet, true)
}

let MAX_IMPORT_DEPTH: usize = 4
var import_depth: usize = 0

// Parses the sheet `src` (at `base`, fetched for `address`) into `sheet`,
// with the sheets it imports before its rules. A fetched sheet
// (`fetched`) has its `url()`s made absolute; those of a `style` element
// stay relative to the document.
fn parseWithImports(alloc: Allocator, base: *Url, address: *Url, src: []u8, media: css.Media, sheet: *mut css.Sheet, fetched: bool) AllocError!void {
    let first_rule = sheet.rules.len()
    let first_import = sheet.imports.len()
    // `url()`s are relative to the sheet.
    let outer_base = sheet.base
    sheet.base = ""
    if fetched {
        sheet.base = base.href
    }
    defer sheet.base = outer_base
    try css.parseSheet(sheet, src, media)
    let n = sheet.imports.len() - first_import
    if n == 0 || import_depth >= MAX_IMPORT_DEPTH {
        return
    }
    let mid = sheet.rules.len()
    import_depth += 1
    defer import_depth -= 1
    for k in 0..n {
        let href = sheet.imports.items()[first_import + k]
        try linkedSheet(alloc, base, address, href, media, sheet)
    }
    try sheet.moveRulesFirst(first_rule, mid)
}
