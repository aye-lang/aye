import dom

test "stylesheet fingerprints follow only cascade sources" {
    let a = @testAllocator()
    var doc = try dom.Document.init(a)
    defer doc.deinit()
    let empty = sheetSourceKey(&doc)
    let style = try doc.createElement("style", []dom.Attr{})
    doc.appendChild(doc.root, style)
    @expectEqual(empty, sheetSourceKey(&doc))
    let link = try doc.createElement("link", []dom.Attr{})
    try doc.setAttr(link, "rel", "preload")
    try doc.setAttr(link, "href", "unused.css")
    doc.appendChild(doc.root, link)
    @expectEqual(empty, sheetSourceKey(&doc))
    try doc.appendText(style, "p { color: red }")
    let styled = sheetSourceKey(&doc)
    @expect(styled != empty)
    try doc.setAttr(style, "media", "(max-width: 1px)")
    let media = sheetSourceKey(&doc)
    @expect(media != styled)
    try doc.setAttr(link, "rel", "stylesheet")
    let linked = sheetSourceKey(&doc)
    @expect(linked != media)
    let base = try doc.createElement("base", []dom.Attr{})
    try doc.setAttr(base, "href", "/css/")
    doc.appendChild(doc.root, base)
    @expect(sheetSourceKey(&doc) != linked)
}
