// font: text measurement for layout. A `Measurer` gives the metrics of a
// font and the advance width of a run of text. Two implementations:
//
// - `Fixed` (this file): a font where every glyph is 0.5em wide (1em for
//   wide East Asian characters), with ascent 0.8em, descent 0.2em and a
//   line gap of 0.25em, so that layout goldens do not depend on the fonts
//   of the machine.
// - `System` (freetype.ore): the system's TrueType fonts through
//   FreeType, for the window and screenshots, with fallback faces,
//   shaping and web fonts.
//
// All lengths are in CSS px.

import std
import std.list.List
import std.mem.AllocError
import std.text

/// What layout asks of a font: its size and the variant to use.
pub struct Font {
    size: f64
    bold: bool
    italic: bool
    mono: bool
    // A serif face (when `mono` is false).
    serif: bool = false
    // The CSS weight (`bold` is weight >= 600), for web fonts.
    weight: f64 = 400.0
    // The CSS `font-family` list, for web fonts; "" for none.
    family: []u8 = ""
    // Right-to-left text (an odd bidi level): shaped and drawn from its
    // end.
    rtl: bool = false
}

/// The descriptors of an `@font-face` rule, for `Measurer.addWebFont`.
pub struct FaceDesc {
    family: []u8
    // The `font-weight` range (one weight: both ends equal).
    weight_lo: f64
    weight_hi: f64
    italic: bool
    // `unicode-range`: pairs of code points (first, last); empty for all.
    ranges: []u32
    // The URL of the file, so that a file is added once.
    url: []u8
}

/// The kinds of faces a CSS font family list maps to.
pub enum Generic {
    Sans
    Serif
    Mono
}

// Family names (lower case) of each kind; the generic names included.
let SANS_NAMES = "sans-serif|ui-sans-serif|system-ui|-apple-system|blinkmacsystemfont|segoe ui|segoe ui variable|roboto|helvetica neue|helvetica|arial|verdana|geneva|tahoma|trebuchet ms|noto sans|liberation sans|dejavu sans|ubuntu|cantarell|open sans|lucida grande|lucida sans unicode|inter|mona sans|hubot sans|fira sans|source sans pro|arimo|sf pro text|sf pro display"
let SERIF_NAMES = "serif|ui-serif|georgia|times|times new roman|cambria|palatino|palatino linotype|book antiqua|garamond|linux libertine|noto serif|dejavu serif|liberation serif|source serif pro|charter|iowan old style|tinos"
let MONO_NAMES = "monospace|ui-monospace|menlo|monaco|consolas|courier|courier new|sfmono-regular|sf mono|liberation mono|dejavu sans mono|lucida console|andale mono|source code pro|fira code|fira mono|roboto mono|jetbrains mono|cascadia code|cascadia mono|ubuntu mono|noto sans mono|cousine"

/// The kind of face for the CSS `font-family` list `families`: the first
/// family that names a known font or a generic family decides; a list
/// of only unknown families gets the default, serif.
pub fn genericOf(families: []u8) Generic {
    var parts = text.split(families, ",")
    while parts.next() |part| {
        var name = text.trim(part)
        if name.len >= 2 && (name[0] == '"' || name[0] == '\'') {
            name = text.trim(name[1..name.len - 1])
        }
        if inNames(name, MONO_NAMES) {
            return Generic.Mono
        }
        if inNames(name, SANS_NAMES) {
            return Generic.Sans
        }
        if inNames(name, SERIF_NAMES) {
            return Generic.Serif
        }
    }
    return Generic.Serif
}

fn inNames(name: []u8, names: []u8) bool {
    var words = text.split(names, "|")
    while words.next() |w| {
        if text.eqlIgnoreCase(w, name) {
            return true
        }
    }
    return false
}

/// Vertical metrics of a font at a size, in px. The `normal` line height
/// is `ascent + descent + line_gap`.
pub struct Metrics {
    ascent: f64
    descent: f64
    line_gap: f64
}

pub interface Measurer {
    fn metrics(self: *mut Self, f: Font) Metrics
    fn width(self: *mut Self, f: Font, s: []u8) f64
    // Does one of the faces `f` draws with have a glyph for `code`?
    fn hasGlyph(self: *mut Self, f: Font, code: u32) bool
    // Should the file of the web font `d` be fetched (it is not there
    // yet, and did not fail before)? The fixed-metric font ignores web
    // fonts.
    fn webFontWanted(self: *mut Self, d: FaceDesc) bool
    // Adds a web font (a TrueType or OpenType file, copied; empty when it
    // could not be fetched); false when it cannot be used.
    fn addWebFont(self: *mut Self, d: FaceDesc, file: []u8) AllocError!bool
}

/// The fixed-metric font of the layout tests.
pub struct Fixed {
    // Advance of a narrow glyph, in em.
    advance: f64

    pub fn init() Fixed {
        return Fixed { advance: 0.5 }
    }

    pub fn metrics(self: *mut Self, f: Font) Metrics {
        return Metrics { ascent: f.size * 0.8, descent: f.size * 0.2, line_gap: f.size * 0.25 }
    }

    pub fn width(self: *mut Self, f: Font, s: []u8) f64 {
        var ems = 0.0
        var i: usize = 0
        while i < s.len {
            let d = text.decode(s[i..])
            ems += self.advance * columns(d.code) as f64
            i += d.len
        }
        return ems * f.size
    }

    pub fn hasGlyph(self: *mut Self, f: Font, code: u32) bool {
        return true
    }

    pub fn webFontWanted(self: *mut Self, d: FaceDesc) bool {
        return false
    }

    pub fn addWebFont(self: *mut Self, d: FaceDesc, file: []u8) AllocError!bool {
        return false
    }
}

/// How many narrow columns the code point `c` takes: 0 for combining
/// marks and zero-width characters, 2 for wide East Asian characters
/// and emoji, else 1.
pub fn columns(c: u32) u32 {
    if (c >= 0x300 && c <= 0x36F) || (c >= 0x200B && c <= 0x200F) || c == 0xFEFF {
        return 0
    }
    if (c >= 0x1100 && c <= 0x115F) || (c >= 0x2E80 && c <= 0xA4CF) || (c >= 0xAC00 && c <= 0xD7A3) || (c >= 0xF900 && c <= 0xFAFF) || (c >= 0xFE30 && c <= 0xFE4F) || (c >= 0xFF00 && c <= 0xFF60) || (c >= 0xFFE0 && c <= 0xFFE6) || (c >= 0x1F300 && c <= 0x1F64F) || (c >= 0x1F900 && c <= 0x1F9FF) || (c >= 0x20000 && c <= 0x3FFFD) {
        return 2
    }
    return 1
}

test "font families" {
    @expect(genericOf("Verdana, Geneva, sans-serif") == Generic.Sans)
    @expect(genericOf("\"Mona Sans\", -apple-system, sans-serif") == Generic.Sans)
    @expect(genericOf("ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, monospace") == Generic.Mono)
    @expect(genericOf("Georgia, \"Times New Roman\", serif") == Generic.Serif)
    @expect(genericOf("serif") == Generic.Serif)
    @expect(genericOf("SomeWebFont") == Generic.Serif)
    @expect(genericOf("SomeWebFont, Arial") == Generic.Sans)
}

test "fixed metrics" {
    var f = Fixed.init()
    let m: dyn Measurer = &mut f
    let big = Font { size: 20.0, bold: false, italic: false, mono: false }
    @expectEqual(50.0, m.width(big, "abcde"))
    @expectEqual(40.0, m.width(big, "日本"))
    @expectEqual(10.0, m.width(big, "e\xCC\x81"))
    let mm = m.metrics(big)
    @expectEqual(16.0, mm.ascent)
    @expectEqual(4.0, mm.descent)
    @expectEqual(5.0, mm.line_gap)
}

test "system fonts, when there are any" {
    var s = System.init(@testAllocator()) catch |e| {
        return
    }
    defer s.deinit()
    let m: dyn Measurer = &mut s
    let f = Font { size: 16.0, bold: false, italic: false, mono: false }
    let w = m.width(f, "Hello")
    @expect(w > 20.0 && w < 60.0)
    let mono = Font { size: 16.0, bold: true, italic: false, mono: true }
    @expectEqual(m.width(mono, "iiii"), m.width(mono, "MMMM"))
    let mm = m.metrics(f)
    @expect(mm.ascent > 10.0 && mm.ascent < 18.0)
    @expect(mm.descent > 1.0 && mm.descent < 6.0)
    // The placed glyphs end where the width says.
    var placed = List(Placed).init(@testAllocator())
    defer placed.deinit()
    let w2 = s.shapeText(f, "AVATAR Hello", &mut placed) catch |e| {
        return
    }
    @expectEqual(12, placed.len())
    @expect(w2 > m.width(f, "AVATAR") + m.width(f, "Hello"))
    @expect(placed.items()[11].x > placed.items()[10].x)
    let g = placed.items()[7]
    if s.render(g.face, 16 * 64, g.glyph) |bm| {
        @expect(bm.width > 4 && bm.width < 20)
        @expect(bm.top > 8 && bm.top < 16)
        @expect(bm.buffer != null)
    } else {
        @expect(false)
    }
}

test "fallback faces for characters the font lacks" {
    var s = System.init(@testAllocator()) catch |e| {
        return
    }
    defer s.deinit()
    var placed = List(Placed).init(@testAllocator())
    defer placed.deinit()
    let f = Font { size: 16.0, bold: false, italic: false, mono: false, serif: true }
    let w = s.shapeText(f, "a日本", &mut placed) catch |e| {
        return
    }
    @expectEqual(3, placed.len())
    if placed.items()[1].glyph == 0 {
        // No CJK font on this machine.
        return
    }
    // The CJK characters come from another face, about 1em wide each.
    @expect(placed.items()[1].face != placed.items()[0].face)
    @expectEqual(placed.items()[1].face, placed.items()[2].face)
    @expect(w > 2.0 * 12.0 && w < 10.0 + 2.0 * 20.0)
    @expectEqual(w, s.width(f, "a日本"))
}

test "right-to-left text and shaping" {
    var s = System.init(@testAllocator()) catch |e| {
        return
    }
    defer s.deinit()
    var ltr = List(Placed).init(@testAllocator())
    defer ltr.deinit()
    var rtl = List(Placed).init(@testAllocator())
    defer rtl.deinit()
    let f = Font { size: 16.0, bold: false, italic: false, mono: false }
    let r = Font { size: 16.0, bold: false, italic: false, mono: false, rtl: true }
    // Hebrew right to left: the first letter is drawn last, at the right.
    let wl = s.shapeText(f, "אבג", &mut ltr) catch |e| {
        return
    }
    let wr = s.shapeText(r, "אבג", &mut rtl) catch |e| {
        return
    }
    @expectEqual(3, rtl.len())
    @expect(wl > wr - 0.01 && wl < wr + 0.01)
    @expectEqual(0, rtl.items()[2].cluster)
    @expectEqual(4, rtl.items()[0].cluster)
    @expect(rtl.items()[2].x > rtl.items()[0].x)
    if !s.shapes() {
        return
    }
    // Arabic letters join: the shaped glyphs of "سلام" are not the
    // isolated forms the characters map to.
    var arabic = List(Placed).init(@testAllocator())
    defer arabic.deinit()
    s.shapeText(r, "سلام", &mut arabic) catch |e| {
        return
    }
    let first = arabic.items()[arabic.len() - 1]
    @expectEqual(0, first.cluster)
    var alone = List(Placed).init(@testAllocator())
    defer alone.deinit()
    s.shapeText(r, "س", &mut alone) catch |e| {
        return
    }
    @expect(alone.items()[0].glyph != first.glyph)
}

test "web fonts by family, weight and unicode-range" {
    var s = System.init(@testAllocator()) catch |e| {
        return
    }
    defer s.deinit()
    var file: []mut u8 = []mut u8{}
    let paths = [2][]u8{"/System/Library/Fonts/Supplemental/Courier New.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"}
    for p in paths {
        if file.len == 0 {
            if std.fs.open(p) |f| {
                defer f.close()
                file = f.readAll(@testAllocator()) catch |e| {
                    return
                }
            } else |e| {
            }
        }
    }
    if file.len == 0 {
        return
    }
    defer @testAllocator().free(file)
    let latin = [2]u32{0x20, 0x7E}
    let d = FaceDesc { family: "Test Face", weight_lo: 400.0, weight_hi: 400.0, italic: false, ranges: latin[..], url: "https://f.test/a.ttf" }
    @expect(s.webFontWanted(d))
    let added = s.addWebFont(d, file) catch |e| {
        return
    }
    @expect(added)
    @expect(!s.webFontWanted(d))
    let bad = FaceDesc { family: "Bad", weight_lo: 400.0, weight_hi: 400.0, italic: false, ranges: latin[0..0], url: "https://f.test/bad.ttf" }
    let junk = [4]u8{1, 2, 3, 4}
    let ok = s.addWebFont(bad, junk[..]) catch |e| {
        return
    }
    @expect(!ok)
    @expect(!s.webFontWanted(bad))
    var placed = List(Placed).init(@testAllocator())
    defer placed.deinit()
    // The web face is monospace: "iiii" and "MMMM" are as wide.
    let f = Font { size: 16.0, bold: false, italic: false, mono: false, family: "\"Test Face\", serif" }
    let wi = s.width(f, "iiii")
    @expectEqual(wi, s.width(f, "MMMM"))
    let serif = Font { size: 16.0, bold: false, italic: false, mono: false, family: "serif, \"Test Face\"" }
    @expect(s.width(serif, "iiii") != s.width(serif, "MMMM"))
    // A bold font still takes the only face of the family.
    let bold = Font { size: 16.0, bold: true, italic: false, mono: false, weight: 700.0, family: "'test face'" }
    @expectEqual(wi, s.width(bold, "iiii"))
    // Outside its unicode-range, a character comes from the system face.
    s.shapeText(f, "aé", &mut placed) catch |e| {
        return
    }
    @expect(placed.items()[0].face != placed.items()[1].face)
}
