// `anyknown screenshot FILE|URL -o OUT.png [--width W] [--height H]
// [--font fixed|system] [--full]`: loads a page, lays it out in a
// viewport W x H CSS px (default 800 x 600), paints it at one device
// pixel per CSS px and writes a PNG. `--full` makes the image as tall as
// the document. The font is the system's (FreeType; `fixed` when none is
// found) unless `--font` says otherwise; `--font system` fails without
// one.

import engine
import font
import paint
import std
import std.mem.Allocator
import std.text

let SHOT_USAGE = "usage: anyknown screenshot FILE|URL -o OUT.png [--width W] [--height H] [--font fixed|system] [--full]"

struct ShotOptions {
    target: []u8
    out: []u8
    width: f64
    height: f64
    // "fixed", "system" or "" (the system's when there is one).
    face: []u8
    full: bool
}

fn shotOptions(args: [][]u8) ?ShotOptions {
    var o = ShotOptions { target: "", out: "", width: 800.0, height: 600.0, face: "", full: false }
    var i: usize = 0
    while i < args.len {
        let a = args[i]
        let more = i + 1 < args.len
        if text.eql(a, "-o") && more {
            o.out = args[i + 1]
            i += 1
        } else if (text.eql(a, "--width") || text.eql(a, "--height")) && more {
            let v = text.parseFloat(args[i + 1]) catch |e| {
                return null
            }
            if v < 1.0 || v > 16384.0 {
                return null
            }
            if text.eql(a, "--width") {
                o.width = std.math.floor(v)
            } else {
                o.height = std.math.floor(v)
            }
            i += 1
        } else if text.eql(a, "--font") && more && (text.eql(args[i + 1], "fixed") || text.eql(args[i + 1], "system")) {
            o.face = args[i + 1]
            i += 1
        } else if text.eql(a, "--full") {
            o.full = true
        } else if o.target.len == 0 && !text.startsWith(a, "-") {
            o.target = a
        } else {
            return null
        }
        i += 1
    }
    if o.target.len == 0 || o.out.len == 0 {
        return null
    }
    return o
}

fn screenshot(alloc: Allocator, args: [][]u8) i32 {
    var o = ShotOptions { target: "", out: "", width: 0.0, height: 0.0, face: "", full: false }
    if shotOptions(args) |parsed| {
        o = parsed
    } else {
        std.log.err("{}", SHOT_USAGE)
        return 2
    }
    var sys = font.System.init(alloc) catch |e| {
        if text.eql(o.face, "system") {
            std.log.err("no system font found ({})", e)
            return 1
        }
        var fixed = font.Fixed.init()
        return shoot(alloc, o, &mut fixed, null)
    }
    defer sys.deinit()
    if text.eql(o.face, "fixed") {
        var fixed = font.Fixed.init()
        return shoot(alloc, o, &mut fixed, null)
    }
    return shoot(alloc, o, &mut sys, &mut sys)
}

// Takes the screenshot, measuring text with `measure` and drawing it
// with `system` (null: the fixed-metric font's boxes).
fn shoot(alloc: Allocator, o: ShotOptions, measure: dyn font.Measurer, system: ?*mut font.System) i32 {
    let location = engine.urlOfInput(alloc, o.target) catch |e| {
        std.log.err("not a URL or file: {}", o.target)
        return 1
    }
    defer location.deinit(alloc)
    let page = engine.load(alloc, &location) catch |e| {
        std.log.err("out of memory")
        return 1
    }
    defer page.destroy()
    if page.failure.len > 0 {
        std.log.err("cannot fetch {}: {}", location.href, page.failure)
        return 1
    }
    let png = render(alloc, page, o, measure, system) catch |e| {
        std.log.err("out of memory")
        return 1
    }
    defer alloc.free(png)
    let f = std.fs.create(o.out) catch |e| {
        std.log.err("cannot write {}", o.out)
        return 1
    }
    defer f.close()
    f.write(png) catch |e| {
        std.log.err("cannot write {}", o.out)
        return 1
    }
    return 0
}

fn render(alloc: Allocator, page: *mut engine.Page, o: ShotOptions, measure: dyn font.Measurer, system: ?*mut font.System) ![]mut u8 {
    try page.layoutPage(measure, o.width, o.height)
    var list = try paint.build(alloc, page.tree.?)
    defer list.deinit()
    var height = o.height
    if o.full {
        height = std.math.ceil(list.height)
    }
    var canvas = try paint.Canvas.init(alloc, o.width as usize, height as usize)
    defer canvas.deinit()
    canvas.clear(list.background)
    var painter = paint.TextPainter.init(alloc, system)
    defer painter.deinit()
    try paint.render(&list, &mut canvas, paint.View { scale: 1.0, dx: 0.0, dy: 0.0 }, &mut painter)
    return paint.encodePng(alloc, canvas.width, canvas.height, canvas.pixels)
}
