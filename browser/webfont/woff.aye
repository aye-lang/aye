// webfont: the files of web fonts, made into what FreeType reads. WOFF 1
// (zlib-compressed tables, inflated with the PNG decoder's inflate) is
// turned back into the TrueType/OpenType file it wraps; TrueType,
// OpenType and collections are taken as they are; WOFF 2 needs Brotli
// (woff2.aye).

import image
import std.mem.AllocError
import std.mem.Allocator

/// The font file of the web font file `data`, which FreeType reads
/// (allocated); null when it is not a font file we read.
pub fn sfntOf(alloc: Allocator, data: []u8) AllocError!?[]mut u8 {
    match fontFormat(data) {
        .Sfnt => {
            let out = try alloc.alloc(0 as u8, data.len)
            for i, c in data {
                out[i] = c
            }
            return out
        }
        .Woff => {
            return unwoff(alloc, data)
        }
        .Woff2 => {
            return unwoff2(alloc, data)
        }
        .Unknown => {
            return null
        }
    }
}

/// The kinds of font files.
pub enum FontFormat {
    Sfnt
    Woff
    Woff2
    Unknown
}

/// The kind of the font file `data`, by its signature.
pub fn fontFormat(data: []u8) FontFormat {
    if data.len < 4 {
        return FontFormat.Unknown
    }
    let tag = be32(data, 0)
    if tag == 0x00010000 || tag == 0x4F54544F || tag == 0x74727565 || tag == 0x74746366 {
        // 1.0, 'OTTO', 'true', 'ttcf'.
        return FontFormat.Sfnt
    }
    if tag == 0x774F4646 {
        return FontFormat.Woff
    }
    if tag == 0x774F4632 {
        return FontFormat.Woff2
    }
    return FontFormat.Unknown
}

/// The TrueType/OpenType file of the WOFF file `data` (allocated); null
/// when it is malformed.
pub fn unwoff(alloc: Allocator, data: []u8) AllocError!?[]mut u8 {
    if data.len < 44 || fontFormat(data) != FontFormat.Woff {
        return null
    }
    let flavor = be32(data, 4)
    let n = be16(data, 12) as usize
    if n == 0 || 44 + n * 20 > data.len {
        return null
    }
    // The size of the result: the header, the table records, each table
    // padded to 4 bytes.
    var size = 12 + n * 16
    for k in 0..n {
        let e = 44 + k * 20
        let orig = be32(data, e + 12) as usize
        if orig > 0x10000000 {
            return null
        }
        size += (orig + 3) & ~(3 as usize)
    }
    if size > 0x20000000 {
        return null
    }
    let out = try alloc.alloc(0 as u8, size)
    put32(out, 0, flavor)
    put16(out, 4, n as u32)
    var pow: usize = 1
    var log: u32 = 0
    while pow * 2 <= n {
        pow *= 2
        log += 1
    }
    put16(out, 6, (pow * 16) as u32)
    put16(out, 8, log)
    put16(out, 10, (n * 16 - pow * 16) as u32)
    var at = 12 + n * 16
    for k in 0..n {
        let e = 44 + k * 20
        let offset = be32(data, e + 4) as usize
        let comp = be32(data, e + 8) as usize
        let orig = be32(data, e + 12) as usize
        if offset > data.len || comp > data.len - offset || comp > orig {
            alloc.free(out)
            return null
        }
        let r = 12 + k * 16
        put32(out, r, be32(data, e))
        put32(out, r + 4, be32(data, e + 16))
        put32(out, r + 8, at as u32)
        put32(out, r + 12, orig as u32)
        if comp == orig {
            for i in 0..orig {
                out[at + i] = data[offset + i]
            }
        } else {
            let table = image.inflateZlib(alloc, data[offset..offset + comp]) catch |err| {
                alloc.free(out)
                return null
            }
            defer alloc.free(table)
            if table.len != orig {
                alloc.free(out)
                return null
            }
            for i in 0..orig {
                out[at + i] = table[i]
            }
        }
        at += (orig + 3) & ~(3 as usize)
    }
    return out
}

fn be16(d: []u8, at: usize) u32 {
    return (d[at] as u32 << 8) | d[at + 1] as u32
}

fn be32(d: []u8, at: usize) u32 {
    return (d[at] as u32 << 24) | (d[at + 1] as u32 << 16) | (d[at + 2] as u32 << 8) | d[at + 3] as u32
}

fn put16(d: []mut u8, at: usize, v: u32) {
    d[at] = ((v >> 8) & 0xFF) as u8
    d[at + 1] = (v & 0xFF) as u8
}

fn put32(d: []mut u8, at: usize, v: u32) {
    d[at] = (v >> 24) as u8
    d[at + 1] = ((v >> 16) & 0xFF) as u8
    d[at + 2] = ((v >> 8) & 0xFF) as u8
    d[at + 3] = (v & 0xFF) as u8
}

test "WOFF 1 to TrueType" {
    // Two tables: 'abcd' stored (4 bytes), 'zzzz' compressed (zlib of
    // "hello hello hello!", 18 bytes).
    let zlib = [_]u8{0x78, 0x9C, 0xCB, 0x48, 0xCD, 0xC9, 0xC9, 0x57, 0xC8, 0x40, 0x90, 0x8A, 0x00, 0x40, 0xCC, 0x06, 0x9E}
    var file = @testAllocator().alloc(0 as u8, 44 + 40 + 4 + zlib.len) catch |e| {
        return
    }
    defer @testAllocator().free(file)
    put32(file, 0, 0x774F4646)
    put32(file, 4, 0x00010000)
    put32(file, 8, file.len as u32)
    put16(file, 12, 2)
    put32(file, 44, 0x61626364)
    put32(file, 48, 84)
    put32(file, 52, 4)
    put32(file, 56, 4)
    put32(file, 60, 0x11111111)
    put32(file, 64, 0x7A7A7A7A)
    put32(file, 68, 88)
    put32(file, 72, zlib.len as u32)
    put32(file, 76, 18)
    put32(file, 80, 0x22222222)
    file[84] = 'W'
    file[85] = 'O'
    file[86] = 'F'
    file[87] = 'F'
    for i, b in zlib {
        file[88 + i] = b
    }
    @expect(fontFormat(file) == FontFormat.Woff)
    let got = unwoff(@testAllocator(), file) catch |e| {
        @expect(false)
        return
    }
    if got |sfnt| {
        defer @testAllocator().free(sfnt)
        @expect(fontFormat(sfnt) == FontFormat.Sfnt)
        @expectEqual(12 + 32 + 4 + 20, sfnt.len)
        @expectEqual(2, be16(sfnt, 4))
        @expectEqual(0x7A7A7A7A, be32(sfnt, 28))
        @expectEqual(0x22222222, be32(sfnt, 32))
        let off = be32(sfnt, 36) as usize
        @expectEqual(48, off)
        @expectEqual(18, be32(sfnt, 40))
        @expectEqual('h', sfnt[off])
        @expectEqual('!', sfnt[off + 17])
        @expectEqual('W', sfnt[be32(sfnt, 20) as usize])
    } else {
        @expect(false)
    }
}
