// WOFF 2 (W3C WOFF File Format 2.0), when libbrotlidec is installed: the
// table data is one Brotli stream; the `glyf` and `loca` tables may be
// transformed (5.1: the glyphs split into streams of contour counts,
// point counts, flags, triplet-encoded coordinates, composites,
// bounding boxes and instructions; `loca` rebuilt from the glyphs) and
// `hmtx` too (5.4: left side bearings dropped where they equal the
// glyph's xMin). The result is a TrueType/OpenType file with its tables
// sorted by tag. Collections (`ttcf` flavor) are not read. Checksums are
// left 0 (FreeType does not check them).

@linkOptional("libbrotlidec")

import std.list.List
import std.mem.AllocError
import std.mem.Allocator

extern fn BrotliDecoderDecompress(encoded_size: usize, encoded: [*]u8, decoded_size: *mut usize, decoded: [*]u8) i32

/// Can `sfntOf` read WOFF 2 files?
pub fn woff2Supported() bool {
    return @hasLink("libbrotlidec")
}

// The tags of the known-table index of a table directory entry (5.2).
let WOFF2_TAGS = [63]u32{
    0x636D6170, 0x68656164, 0x68686561, 0x686D7478, 0x6D617870, 0x6E616D65, 0x4F532F32, 0x706F7374,
    0x63767420, 0x6670676D, 0x676C7966, 0x6C6F6361, 0x70726570, 0x43464620, 0x564F5247, 0x45424454,
    0x45424C43, 0x67617370, 0x68646D78, 0x6B65726E, 0x4C545348, 0x50434C54, 0x56444D58, 0x76686561,
    0x766D7478, 0x42415345, 0x47444546, 0x47504F53, 0x47535542, 0x45425343, 0x4A535446, 0x4D415448,
    0x43424454, 0x43424C43, 0x434F4C52, 0x4350414C, 0x53564720, 0x73626978, 0x61636E74, 0x61766172,
    0x62646174, 0x626C6F63, 0x62736C6E, 0x63766172, 0x66647363, 0x66656174, 0x666D7478, 0x66766172,
    0x67766172, 0x68737479, 0x6A757374, 0x6C636172, 0x6D6F7274, 0x6D6F7278, 0x6F706264, 0x70726F70,
    0x7472616B, 0x5A617066, 0x53696C66, 0x476C6174, 0x476C6F63, 0x46656174, 0x53696C6C,
}

let TAG_GLYF: u32 = 0x676C7966
let TAG_LOCA: u32 = 0x6C6F6361
let TAG_HMTX: u32 = 0x686D7478
let TAG_HHEA: u32 = 0x68686561
let TAG_HEAD: u32 = 0x68656164

// A table of the directory: its data is `stream[at..at + len]` of the
// decompressed stream (transformed when `transformed`); the rebuilt
// table goes in `out`.
struct Woff2Table {
    tag: u32
    orig: usize
    at: usize
    len: usize
    transformed: bool
    out: []mut u8
}

// A cursor over bytes; reads past the end set `bad` and give 0.
struct Reader {
    d: []u8
    pos: usize
    bad: bool

    fn u8v(self: *mut Self) u32 {
        if self.pos >= self.d.len {
            self.bad = true
            return 0
        }
        let v = self.d[self.pos] as u32
        self.pos += 1
        return v
    }

    fn u16v(self: *mut Self) u32 {
        let hi = self.u8v()
        return (hi << 8) | self.u8v()
    }

    fn i16v(self: *mut Self) i32 {
        let v = self.u16v() as i32
        if v >= 32768 {
            return v - 65536
        }
        return v
    }

    fn u32v(self: *mut Self) u32 {
        let hi = self.u16v()
        return (hi << 16) | self.u16v()
    }

    // UIntBase128 (5.2.1).
    fn base128(self: *mut Self) u32 {
        var v: u32 = 0
        for k in 0..5 {
            let b = self.u8v()
            if (k == 0 && b == 0x80) || (v & 0xFE000000) != 0 {
                self.bad = true
                return 0
            }
            v = (v << 7) | (b & 0x7F)
            if (b & 0x80) == 0 {
                return v
            }
        }
        self.bad = true
        return 0
    }

    // 255UInt16 (6.1.1).
    fn u255(self: *mut Self) u32 {
        let code = self.u8v()
        if code == 253 {
            return self.u16v()
        }
        if code == 255 {
            return self.u8v() + 253
        }
        if code == 254 {
            return self.u8v() + 506
        }
        return code
    }

    fn take(self: *mut Self, n: usize) []u8 {
        if n > self.d.len - self.pos {
            self.bad = true
            self.pos = self.d.len
            return self.d[0..0]
        }
        let s = self.d[self.pos..self.pos + n]
        self.pos += n
        return s
    }
}

fn reader(d: []u8) Reader {
    return Reader { d: d, pos: 0, bad: false }
}

fn unwoff2(alloc: Allocator, data: []u8) AllocError!?[]mut u8 {
    if @hasLink("libbrotlidec") {
        return decodeWoff2(alloc, data)
    }
    return null
}

fn decodeWoff2(alloc: Allocator, data: []u8) AllocError!?[]mut u8 {
    var r = reader(data)
    if r.u32v() != 0x774F4632 {
        return null
    }
    let flavor = r.u32v()
    r.u32v()
    let n = r.u16v() as usize
    r.u16v()
    r.u32v()
    let compressed = r.u32v() as usize
    r.take(24)
    if flavor == 0x74746366 || n == 0 || r.bad {
        return null
    }
    var tables = List(Woff2Table).init(alloc)
    defer {
        for t in tables.items() {
            if t.out.len > 0 {
                alloc.free(t.out)
            }
        }
        tables.deinit()
    }
    var total: usize = 0
    for k in 0..n {
        let flags = r.u8v()
        var tag: u32 = 0
        if (flags & 63) == 63 {
            tag = r.u32v()
        } else {
            tag = WOFF2_TAGS[(flags & 63) as usize]
        }
        let version = flags >> 6
        let orig = r.base128() as usize
        var len = orig
        var transformed = false
        if tag == TAG_GLYF || tag == TAG_LOCA {
            transformed = version == 0
        } else {
            transformed = version != 0
        }
        if transformed {
            len = r.base128() as usize
        }
        if r.bad || orig > 0x10000000 || len > 0x10000000 {
            return null
        }
        try tables.append(Woff2Table { tag: tag, orig: orig, at: total, len: len, transformed: transformed, out: []mut u8{} })
        total += len
    }
    if r.bad || compressed > data.len - r.pos || total > 0x20000000 {
        return null
    }
    let stream = try alloc.alloc(0 as u8, total + 1)
    defer alloc.free(stream)
    var got = total + 1
    if BrotliDecoderDecompress(compressed, data[r.pos..].ptr, &mut got, stream.ptr) != 1 || got != total {
        return null
    }
    // Rebuild the transformed tables: glyf and loca together, then hmtx
    // (which needs the glyphs' xMin).
    var glyf_i: ?usize = null
    var loca_i: ?usize = null
    var hmtx_i: ?usize = null
    var hhea_i: ?usize = null
    for k, t in tables.items() {
        if t.tag == TAG_GLYF {
            glyf_i = k
        } else if t.tag == TAG_LOCA {
            loca_i = k
        } else if t.tag == TAG_HMTX {
            hmtx_i = k
        } else if t.tag == TAG_HHEA {
            hhea_i = k
        }
    }
    var xmins = List(i32).init(alloc)
    defer xmins.deinit()
    if glyf_i |gi| {
        let gt = tables.items()[gi]
        if gt.transformed {
            let li = loca_i orelse return null
            var glyf = List(u8).init(alloc)
            defer glyf.deinit()
            var loca = List(u8).init(alloc)
            defer loca.deinit()
            if !(try rebuildGlyf(alloc, stream[gt.at..gt.at + gt.len], &mut glyf, &mut loca, &mut xmins)) {
                return null
            }
            tables.items()[gi].out = try copyOf(alloc, glyf.items())
            tables.items()[li].out = try copyOf(alloc, loca.items())
        }
    }
    if hmtx_i |hi| {
        let ht = tables.items()[hi]
        if ht.transformed {
            let hh = hhea_i orelse return null
            let hd = tables.items()[hh]
            if hd.len < 36 || xmins.len() == 0 {
                return null
            }
            let metrics = (stream[hd.at + 34] as usize << 8) | stream[hd.at + 35] as usize
            let out = try rebuildHmtx(alloc, stream[ht.at..ht.at + ht.len], metrics, xmins.items())
            if out |o| {
                tables.items()[hi].out = o
            } else {
                return null
            }
        }
    }
    // The file: header, records sorted by tag, tables padded to 4.
    let count = tables.len()
    var order = List(usize).init(alloc)
    defer order.deinit()
    for k in 0..count {
        var at = order.len()
        while at > 0 && tables.items()[order.items()[at - 1]].tag > tables.items()[k].tag {
            at -= 1
        }
        try order.insert(at, k)
    }
    var size = 12 + 16 * count
    for t in tables.items() {
        size += (tableLen(t) + 3) & ~(3 as usize)
    }
    let out = try alloc.alloc(0 as u8, size)
    put32(out, 0, flavor)
    put16(out, 4, count as u32)
    var pow: usize = 1
    var log: u32 = 0
    while pow * 2 <= count {
        pow *= 2
        log += 1
    }
    put16(out, 6, (pow * 16) as u32)
    put16(out, 8, log)
    put16(out, 10, (count * 16 - pow * 16) as u32)
    var at = 12 + 16 * count
    for slot, k in order.items() {
        let t = tables.items()[k]
        let len = tableLen(t)
        let rec = 12 + 16 * slot
        put32(out, rec, t.tag)
        put32(out, rec + 4, 0)
        put32(out, rec + 8, at as u32)
        put32(out, rec + 12, len as u32)
        if t.out.len > 0 || t.transformed {
            for i in 0..t.out.len {
                out[at + i] = t.out[i]
            }
        } else {
            for i in 0..len {
                out[at + i] = stream[t.at + i]
            }
        }
        if t.tag == TAG_HEAD && len >= 12 {
            // checkSumAdjustment: unknown, 0.
            put32(out, at + 8, 0)
        }
        at += (len + 3) & ~(3 as usize)
    }
    return out
}

fn tableLen(t: Woff2Table) usize {
    if t.transformed {
        return t.out.len
    }
    return t.len
}

fn copyOf(alloc: Allocator, s: []u8) AllocError![]mut u8 {
    let out = try alloc.alloc(0 as u8, s.len)
    for i, c in s {
        out[i] = c
    }
    return out
}

// Rebuilds `glyf` and `loca` from the transformed glyf table `t` (5.1),
// and the xMin of every glyph; false when it is malformed.
fn rebuildGlyf(alloc: Allocator, t: []u8, glyf: *mut List(u8), loca: *mut List(u8), xmins: *mut List(i32)) AllocError!bool {
    var h = reader(t)
    h.u16v()
    let options = h.u16v()
    let glyphs = h.u16v() as usize
    let long_loca = h.u16v() != 0
    var sizes = [7]usize{0, ..}
    for k in 0..7 {
        sizes[k] = h.u32v() as usize
    }
    if h.bad {
        return false
    }
    var streams = [7]Reader{reader(t[0..0]), ..}
    var pos = h.pos
    for k in 0..7 {
        if sizes[k] > t.len - pos {
            return false
        }
        streams[k] = reader(t[pos..pos + sizes[k]])
        pos += sizes[k]
    }
    var overlap = t[0..0]
    if (options & 1) != 0 {
        let n = (glyphs + 7) / 8
        if n > t.len - pos {
            return false
        }
        overlap = t[pos..pos + n]
    }
    var ncont = streams[0]
    var npoints = streams[1]
    var flags = streams[2]
    var gs = streams[3]
    var comp = streams[4]
    var bbox = streams[5]
    var instr = streams[6]
    // The bounding box bitmap comes first in its stream.
    let bitmap = bbox.take(((glyphs + 31) / 32) * 4)
    var xs = List(i32).init(alloc)
    defer xs.deinit()
    var ys = List(i32).init(alloc)
    defer ys.deinit()
    var on = List(bool).init(alloc)
    defer on.deinit()
    var ends = List(u32).init(alloc)
    defer ends.deinit()
    for g in 0..glyphs {
        let offset = glyf.len()
        if long_loca {
            try add32(loca, offset as u32)
        } else {
            try add16(loca, (offset / 2) as u32)
        }
        let n = ncont.i16v()
        let has_box = (bitmap.len > g / 8) && ((bitmap[g / 8] >> (7 - (g % 8) as u8)) & 1) == 1
        if n == 0 {
            try xmins.append(0)
            continue
        }
        if n > 0 {
            // A simple glyph.
            ends.clear()
            var total: u32 = 0
            for c in 0..n as usize {
                total += npoints.u255()
                if total == 0 {
                    return false
                }
                try ends.append(total - 1)
            }
            xs.clear()
            ys.clear()
            on.clear()
            var x: i32 = 0
            var y: i32 = 0
            for p in 0..total as usize {
                let flag = flags.u8v()
                let triplet = decodeTriplet(flag & 0x7F, &mut gs)
                x += triplet.dx
                y += triplet.dy
                try xs.append(x)
                try ys.append(y)
                try on.append((flag & 0x80) == 0)
            }
            let ilen = gs.u255() as usize
            let code = instr.take(ilen)
            var x0: i32 = 0
            var y0: i32 = 0
            var x1: i32 = 0
            var y1: i32 = 0
            if has_box {
                x0 = bbox.i16v()
                y0 = bbox.i16v()
                x1 = bbox.i16v()
                y1 = bbox.i16v()
            } else {
                x0 = xs.items()[0]
                x1 = x0
                y0 = ys.items()[0]
                y1 = y0
                for p in 0..xs.len() {
                    x0 = minI(x0, xs.items()[p])
                    x1 = maxI(x1, xs.items()[p])
                    y0 = minI(y0, ys.items()[p])
                    y1 = maxI(y1, ys.items()[p])
                }
            }
            try xmins.append(x0)
            try add16(glyf, n as u32)
            try addI16(glyf, x0)
            try addI16(glyf, y0)
            try addI16(glyf, x1)
            try addI16(glyf, y1)
            for e in ends.items() {
                try add16(glyf, e)
            }
            try add16(glyf, ilen as u32)
            for b in code {
                try glyf.append(b)
            }
            // Flags (on curve; the first with OVERLAP_SIMPLE when the
            // bitmap says so), then coordinates as 16-bit deltas.
            let overlaps = overlap.len > g / 8 && ((overlap[g / 8] >> (7 - (g % 8) as u8)) & 1) == 1
            var px: i32 = 0
            var py: i32 = 0
            for p in 0..xs.len() {
                var f = on.items()[p] as u8
                if p == 0 && overlaps {
                    f = f | 0x40
                }
                try glyf.append(f)
            }
            for p in 0..xs.len() {
                try addI16(glyf, xs.items()[p] - px)
                px = xs.items()[p]
            }
            for p in 0..ys.len() {
                try addI16(glyf, ys.items()[p] - py)
                py = ys.items()[p]
            }
        } else {
            // A composite glyph: its components, then its instructions.
            if !has_box {
                return false
            }
            let x0 = bbox.i16v()
            try xmins.append(x0)
            try add16(glyf, 0xFFFF)
            try addI16(glyf, x0)
            try addI16(glyf, bbox.i16v())
            try addI16(glyf, bbox.i16v())
            try addI16(glyf, bbox.i16v())
            var more = true
            var instructions = false
            while more {
                let cf = comp.u16v()
                var len: usize = 2
                if (cf & 1) != 0 {
                    len += 4
                } else {
                    len += 2
                }
                if (cf & 8) != 0 {
                    len += 2
                } else if (cf & 0x40) != 0 {
                    len += 4
                } else if (cf & 0x80) != 0 {
                    len += 8
                }
                try add16(glyf, cf)
                for b in comp.take(len) {
                    try glyf.append(b)
                }
                if (cf & 0x100) != 0 {
                    instructions = true
                }
                more = (cf & 0x20) != 0 && !comp.bad
            }
            if instructions {
                let ilen = gs.u255() as usize
                try add16(glyf, ilen as u32)
                for b in instr.take(ilen) {
                    try glyf.append(b)
                }
            }
        }
        while glyf.len() % 4 != 0 {
            try glyf.append(0)
        }
        if ncont.bad || npoints.bad || flags.bad || gs.bad || comp.bad || bbox.bad || instr.bad {
            return false
        }
    }
    if long_loca {
        try add32(loca, glyf.len() as u32)
    } else {
        try add16(loca, (glyf.len() / 2) as u32)
    }
    return !ncont.bad
}

struct Triplet {
    dx: i32
    dy: i32
}

fn withSign(flag: u32, v: i32) i32 {
    if (flag & 1) != 0 {
        return v
    }
    return -v
}

// The point deltas of the triplet with flag `flag` (low 7 bits), its
// data read from `gs` (5.2, table 3).
fn decodeTriplet(flag: u32, gs: *mut Reader) Triplet {
    if flag < 10 {
        let b = gs.u8v() as i32
        return Triplet { dx: 0, dy: withSign(flag, (((flag & 14) << 7) as i32) + b) }
    }
    if flag < 20 {
        let b = gs.u8v() as i32
        return Triplet { dx: withSign(flag, ((((flag - 10) & 14) << 7) as i32) + b), dy: 0 }
    }
    if flag < 84 {
        let b0 = (flag - 20) as i32
        let b1 = gs.u8v() as i32
        return Triplet { dx: withSign(flag, 1 + (b0 & 0x30) + (b1 >> 4)), dy: withSign(flag >> 1, 1 + ((b0 & 0x0C) << 2) + (b1 & 0x0F)) }
    }
    if flag < 120 {
        let b0 = (flag - 84) as i32
        let bx = gs.u8v() as i32
        let by = gs.u8v() as i32
        return Triplet { dx: withSign(flag, 1 + ((b0 / 12) << 8) + bx), dy: withSign(flag >> 1, 1 + (((b0 % 12) >> 2) << 8) + by) }
    }
    if flag < 124 {
        let b0 = gs.u8v() as i32
        let b1 = gs.u8v() as i32
        let b2 = gs.u8v() as i32
        return Triplet { dx: withSign(flag, (b0 << 4) + (b1 >> 4)), dy: withSign(flag >> 1, ((b1 & 0x0F) << 8) + b2) }
    }
    let b0 = gs.u8v() as i32
    let b1 = gs.u8v() as i32
    let b2 = gs.u8v() as i32
    let b3 = gs.u8v() as i32
    return Triplet { dx: withSign(flag, (b0 << 8) + b1), dy: withSign(flag >> 1, (b2 << 8) + b3) }
}

// The `hmtx` table of the transformed one `t` (5.4), with `metrics`
// advance widths and the glyphs' `xmins`.
fn rebuildHmtx(alloc: Allocator, t: []u8, metrics: usize, xmins: []i32) AllocError!?[]mut u8 {
    let glyphs = xmins.len
    if metrics == 0 || metrics > glyphs {
        return null
    }
    var r = reader(t)
    let flags = r.u8v()
    let out = try alloc.alloc(0 as u8, metrics * 4 + (glyphs - metrics) * 2)
    for k in 0..metrics {
        put16(out, k * 4, r.u16v())
    }
    for k in 0..metrics {
        var lsb = xmins[k]
        if (flags & 1) == 0 {
            lsb = r.i16v()
        }
        put16(out, k * 4 + 2, (lsb & 0xFFFF) as u32)
    }
    for k in metrics..glyphs {
        var lsb = xmins[k]
        if (flags & 2) == 0 {
            lsb = r.i16v()
        }
        put16(out, metrics * 4 + (k - metrics) * 2, (lsb & 0xFFFF) as u32)
    }
    if r.bad {
        alloc.free(out)
        return null
    }
    return out
}

fn add16(l: *mut List(u8), v: u32) AllocError!void {
    try l.append(((v >> 8) & 0xFF) as u8)
    try l.append((v & 0xFF) as u8)
}

fn addI16(l: *mut List(u8), v: i32) AllocError!void {
    return add16(l, (v & 0xFFFF) as u32)
}

fn add32(l: *mut List(u8), v: u32) AllocError!void {
    try add16(l, v >> 16)
    try add16(l, v & 0xFFFF)
}

fn minI(a: i32, b: i32) i32 {
    if a < b {
        return a
    }
    return b
}

fn maxI(a: i32, b: i32) i32 {
    if a > b {
        return a
    }
    return b
}

test "triplet decoding" {
    let d = [4]u8{0x12, 0x34, 0x56, 0x78}
    var r = reader(d[..])
    // Flag 1: dx 0, dy +0x12.
    let t1 = decodeTriplet(1, &mut r)
    @expectEqual(0, t1.dx)
    @expectEqual(0x12, t1.dy)
    // Flag 124 (even): dx -(0x34 << 8 | 0x56), dy -(0x78 << 8 | ...).
    var r2 = reader(d[..])
    let t2 = decodeTriplet(125, &mut r2)
    @expectEqual(0x1234, t2.dx)
    @expectEqual(-0x5678, t2.dy)
    var r3 = reader(d[..])
    let t3 = decodeTriplet(20, &mut r3)
    @expectEqual(-(1 + 1), t3.dx)
    @expectEqual(-(1 + 2), t3.dy)
}
