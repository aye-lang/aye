// svg: SVG drawings, from the DOM to pixels.
//
// - svg.aye: `Picture`, what an `svg` element draws with everything
//   resolved (paths in the coordinates of its viewBox, colors, stroke
//   widths), and `build`, which makes one from an `svg` element of a
//   document and its computed styles. Paint builds the inline `<svg>`
//   elements of a page; an SVG image (`<img src=x.svg>`) is a document
//   of its own, built once when it is loaded (`parseImage`).
// - path.aye: matrices, `transform`, `viewBox`, path data, shapes.
// - raster.aye: `render`: curves flattened, strokes as polygons,
//   scanline filling with antialiasing, into an RGBA buffer.
//
// Elements: `svg` (nested too), `g`, `a`, `switch` (all its children),
// `path`, `rect` (`rx`/`ry`), `circle`, `ellipse`, `line`, `polyline`,
// `polygon`, `use` (of an element or a `symbol`, `href` or
// `xlink:href`); `defs`, `symbol`, gradients and the like draw nothing
// themselves. Styling goes through the cascade (css): presentation
// attributes are hints, so `style` attributes and style sheets work, with
// `fill`, `stroke` (`currentColor`, linear and radial gradients:
// gradient.aye), their opacities, `stroke-width`, `fill-rule`,
// `stroke-linecap`, `stroke-linejoin`, `stroke-miterlimit`,
// `stroke-dasharray`, `stroke-dashoffset`, `opacity` (a group's drawn
// into a layer of its own, then blended), `display: none` and
// `visibility`; the `clip-path` attribute (a `clipPath` of shapes in user
// space, `clip-rule`), and the `mask` attribute as a clip to the union of
// the mask's shapes. Content inside a `use` inherits from the `use`.
// Left out: text, images, patterns, luminance and partial masks,
// markers, filters.

import css
import css.Value
import dom
import dom.Document
import dom.Kind
import dom.NodeId
import html
import std.list.List
import std.math
import std.mem.AllocError
import std.mem.Allocator
import std.text

/// An 8-bit color with straight alpha.
pub struct Color {
    r: u8
    g: u8
    b: u8
    a: u8
}

/// A filled and/or stroked path of a `Picture`: its verbs are
/// `verbs[verb_start..verb_end]`, its points from `coords[coord_start]`.
pub struct Shape {
    verb_start: usize
    verb_end: usize
    coord_start: usize
    // Alpha 0 when not filled or not stroked.
    fill: Color
    stroke: Color
    // In the picture's coordinates.
    stroke_width: f64
    evenodd: bool
    // 0 butt, 1 round, 2 square.
    cap: u8
    // 0 miter, 1 round, 2 bevel.
    join: u8
    miter_limit: f64
    // A gradient paints the fill (stroke) instead of a color: its index
    // in `Picture.gradients` plus 1; 0 for none.
    fill_grad: usize
    stroke_grad: usize
    // The stroke's dashes and gaps (`Picture.dashes`), and where the
    // pattern starts, in the picture's coordinates.
    dash_start: usize
    dash_end: usize
    dash_offset: f64
    // Not a path but the start (1) or the end (2) of a group: the shapes
    // in between are drawn into a layer of their own, which the end
    // blends below with `opacity`, through the clip path `clip` (its
    // index in `Picture.clips` plus 1; 0 for none).
    group: u8
    opacity: f64
    clip: usize
}

/// A clip path: the union of the fills of `Picture.clip_shapes[start..end]`.
pub struct ClipPath {
    start: usize
    end: usize
}

/// What an `svg` element draws, in the coordinates of its viewBox (or in
/// CSS px without one).
pub struct Picture {
    alloc: Allocator
    view: ?ViewBox
    aspect: Aspect
    // The `width` and `height` attributes in px (0 when missing or
    // relative).
    width: f64
    height: f64
    shapes: List(Shape)
    verbs: List(u8)
    coords: List(f64)
    gradients: List(Gradient)
    dashes: List(f64)
    clips: List(ClipPath)
    clip_shapes: List(Shape)

    pub fn deinit(self: *mut Self) {
        self.shapes.deinit()
        self.verbs.deinit()
        self.coords.deinit()
        for g in self.gradients.items() {
            self.alloc.free(g.stops)
        }
        self.gradients.deinit()
        self.dashes.deinit()
        self.clips.deinit()
        self.clip_shapes.deinit()
    }

    /// The natural size of an SVG image: its `width` and `height`, a
    /// missing one from the other by the viewBox's ratio, else 300 x 150
    /// (fitted to the ratio).
    pub fn naturalSize(self: *Self) Size {
        var w = self.width
        var h = self.height
        var ratio = 0.0
        if self.view |vb| {
            ratio = vb.w / vb.h
        }
        if w > 0.0 && h > 0.0 {
            return Size { w: w, h: h }
        }
        if ratio > 0.0 {
            if w > 0.0 {
                return Size { w: w, h: w / ratio }
            }
            if h > 0.0 {
                return Size { w: h * ratio, h: h }
            }
            if ratio >= 2.0 {
                return Size { w: 300.0, h: 300.0 / ratio }
            }
            return Size { w: 150.0 * ratio, h: 150.0 }
        }
        if w <= 0.0 {
            w = 300.0
        }
        if h <= 0.0 {
            h = 150.0
        }
        return Size { w: w, h: h }
    }

    /// The transform from the picture's coordinates to a box at (`x`,
    /// `y`), `w` x `h` (device px), where a CSS px is `px` device px.
    pub fn placement(self: *Self, x: f64, y: f64, w: f64, h: f64, px: f64) Matrix {
        if self.view |vb| {
            return viewBoxTransform(vb, self.aspect, x, y, w, h)
        }
        return Matrix { a: px, b: 0.0, c: 0.0, d: px, e: x, f: y }
    }
}

pub struct Size {
    w: f64
    h: f64
}

/// The picture of the `svg` element `root` of `doc` (styled by
/// `styles`), allocated with `alloc`. Free it with `deinit` and
/// `alloc.destroy`.
pub fn build(alloc: Allocator, doc: *Document, styles: *css.Styles, root: NodeId) AllocError!*mut Picture {
    var view: ?ViewBox = null
    if doc.attr(root, "viewbox") |v| {
        view = parseViewBox(v)
    }
    var aspect = DEFAULT_ASPECT
    if doc.attr(root, "preserveaspectratio") |v| {
        aspect = parseAspect(v)
    }
    let pic = try alloc.create(Picture {
        alloc: alloc,
        view: view,
        aspect: aspect,
        width: absoluteLength(doc, root, "width"),
        height: absoluteLength(doc, root, "height"),
        shapes: List(Shape).init(alloc),
        verbs: List(u8).init(alloc),
        coords: List(f64).init(alloc),
        gradients: List(Gradient).init(alloc),
        dashes: List(f64).init(alloc),
        clips: List(ClipPath).init(alloc),
        clip_shapes: List(Shape).init(alloc),
    })
    var b = Builder { doc: doc, styles: styles, pic: pic, clipping: false, clip_depth: 0 }
    let values = styles.get(root) orelse return pic
    var vw = 300.0
    var vh = 150.0
    if view |vb| {
        vw = vb.w
        vh = vb.h
    } else {
        let n = pic.naturalSize()
        vw = n.w
        vh = n.h
    }
    var ctx = Ctx {
        m: IDENTITY,
        color: colorOf(values[css.COLOR], BLACK),
        fill: paintOf(values[css.FILL]),
        stroke: paintOf(values[css.STROKE]),
        stroke_width: 1.0,
        fill_opacity: 1.0,
        stroke_opacity: 1.0,
        opacity: 1.0,
        evenodd: false,
        cap: 0,
        join: 0,
        miter_limit: 4.0,
        dashes: Value.Keyword { k: "none" },
        dash_offset: 0.0,
        visible: true,
        vw: vw,
        vh: vh,
        depth: 0,
    }
    b.inherit(&mut ctx, values, null)
    b.children(root, ctx) catch |e| {
        pic.deinit()
        alloc.destroy(pic)
        return e
    }
    return pic
}

/// The picture of an SVG file (`src`, UTF-8): parsed as HTML (its `svg`
/// element is foreign content there), styled by its `<style>` elements;
/// null when it has no `svg` element.
pub fn parseImage(alloc: Allocator, src: []u8) AllocError!?*mut Picture {
    var doc = try html.parse(alloc, src)
    defer doc.deinit()
    var root: ?NodeId = null
    var cur: ?NodeId = doc.root
    while cur |h| {
        if doc.isElement(h, "svg") {
            root = h
            break
        }
        cur = doc.following(h, doc.root)
    }
    let el = root orelse return null
    let media = css.Media { width: 300.0, height: 150.0 }
    var ua = try css.Sheet.init(alloc)
    defer ua.deinit()
    var author = try css.Sheet.init(alloc)
    defer author.deinit()
    var sheet = text.Builder.init(alloc)
    defer sheet.deinit()
    cur = el
    while cur |h| {
        if doc.isElement(h, "style") {
            sheet.clear()
            try doc.textContent(h, &mut sheet)
            try css.parseSheet(&mut author, withoutCdata(sheet.bytes()), media)
        }
        cur = doc.following(h, el)
    }
    var styles = try css.Styles.init(alloc)
    defer styles.deinit()
    try css.computeStyles(&doc, &ua, &author, media, &mut styles)
    return try build(alloc, &doc, &styles, el)
}

// A style sheet without its `<![CDATA[` and `]]>` (the HTML parser keeps
// them as text).
fn withoutCdata(s: []u8) []u8 {
    var t = text.trim(s)
    if text.startsWith(t, "<![CDATA[") {
        t = t[9..]
    }
    if text.endsWith(t, "]]>") {
        t = t[..t.len - 3]
    }
    return t
}

// An absolute length attribute in px; 0 when missing or relative.
fn absoluteLength(doc: *Document, el: NodeId, name: []u8) f64 {
    if doc.attr(el, name) |v| {
        if text.indexOf(v, "%") == null {
            if lengthOf(v, 0.0) |n| {
                if n > 0.0 {
                    return n
                }
            }
        }
    }
    return 0.0
}

let BLACK = Color { r: 0, g: 0, b: 0, a: 255 }
let NO_COLOR = Color { r: 0, g: 0, b: 0, a: 0 }

// A `fill` or `stroke`: nothing, a color, `currentColor`, or a reference
// (`url(#id)`, its text).
enum Paint {
    None
    Solid { c: Color }
    Current
    Ref { s: []u8 }
}

fn paintOf(v: Value) Paint {
    return match v {
        .Rgba { c } => Paint.Solid { c: Color { r: c.r, g: c.g, b: c.b, a: alpha(c.a) } }
        .CurrentColor => Paint.Current
        .Keyword { k } => keywordPaint(k)
        _ => Paint.None
    }
}

fn keywordPaint(k: []u8) Paint {
    if text.eql(k, "none") {
        return Paint.None
    }
    return Paint.Ref { s: k }
}

fn alpha(a: f64) u8 {
    return math.floor(math.clamp(a, 0.0, 1.0) * 255.0 + 0.5) as u8
}

fn colorOf(v: Value, current: Color) Color {
    return match v {
        .Rgba { c } => Color { r: c.r, g: c.g, b: c.b, a: alpha(c.a) }
        _ => current
    }
}

fn numberOf(v: Value, d: f64) f64 {
    return match v {
        .Number { v: n } => n
        .Px { v: n } => n
        _ => d
    }
}

fn keywordOf(v: Value) []u8 {
    return match v {
        .Keyword { k } => k
        _ => ""
    }
}

// The resolved styles and the transform that an element passes on to its
// children.
struct Ctx {
    // From the element's coordinates to the picture's.
    m: Matrix
    color: Color
    fill: Paint
    stroke: Paint
    stroke_width: f64
    fill_opacity: f64
    stroke_opacity: f64
    // The product of the `opacity` of the element and its ancestors.
    opacity: f64
    evenodd: bool
    cap: u8
    join: u8
    miter_limit: f64
    // `stroke-dasharray` (its computed value) and `stroke-dashoffset`.
    dashes: Value
    dash_offset: f64
    visible: bool
    // The size of the nearest viewport, for percentages.
    vw: f64
    vh: f64
    // `use` elements followed.
    depth: usize
}

struct Builder {
    doc: *Document
    styles: *css.Styles
    pic: *mut Picture
    // Building a clip path: shapes go to `clip_shapes`, filled opaque.
    clipping: bool
    clip_depth: usize

    // Takes into `ctx` the properties that the cascade set on the element
    // whose computed values are `values` (those that differ from its
    // parent's, `parent`; all of them without one): the others keep the
    // values `ctx` inherited, maybe from a `use` rather than from the
    // parent in the document.
    fn inherit(self: *mut Self, ctx: *mut Ctx, values: []Value, parent: ?[]Value) {
        if set(values, parent, css.COLOR) {
            ctx.color = colorOf(values[css.COLOR], ctx.color)
        }
        if set(values, parent, css.FILL) {
            ctx.fill = paintOf(values[css.FILL])
        }
        if set(values, parent, css.STROKE) {
            ctx.stroke = paintOf(values[css.STROKE])
        }
        if set(values, parent, css.STROKE_WIDTH) {
            ctx.stroke_width = match values[css.STROKE_WIDTH] {
                .Number { v } => v
                .Px { v } => v
                .Percent { v } => v / 100.0 * math.sqrt((ctx.vw * ctx.vw + ctx.vh * ctx.vh) / 2.0)
                _ => 1.0
            }
        }
        if set(values, parent, css.FILL_OPACITY) {
            ctx.fill_opacity = math.min(1.0, numberOf(values[css.FILL_OPACITY], 1.0))
        }
        if set(values, parent, css.STROKE_OPACITY) {
            ctx.stroke_opacity = math.min(1.0, numberOf(values[css.STROKE_OPACITY], 1.0))
        }
        if set(values, parent, css.FILL_RULE) {
            ctx.evenodd = text.eql(keywordOf(values[css.FILL_RULE]), "evenodd")
        }
        if set(values, parent, css.STROKE_LINECAP) {
            let cap = keywordOf(values[css.STROKE_LINECAP])
            ctx.cap = 0
            if text.eql(cap, "round") {
                ctx.cap = 1
            } else if text.eql(cap, "square") {
                ctx.cap = 2
            }
        }
        if set(values, parent, css.STROKE_LINEJOIN) {
            let join = keywordOf(values[css.STROKE_LINEJOIN])
            ctx.join = 0
            if text.eql(join, "round") {
                ctx.join = 1
            } else if text.eql(join, "bevel") {
                ctx.join = 2
            }
        }
        if set(values, parent, css.STROKE_MITERLIMIT) {
            ctx.miter_limit = math.max(1.0, numberOf(values[css.STROKE_MITERLIMIT], 4.0))
        }
        if set(values, parent, css.VISIBILITY) {
            ctx.visible = text.eql(keywordOf(values[css.VISIBILITY]), "visible")
        }
        if set(values, parent, css.STROKE_DASHARRAY) {
            ctx.dashes = values[css.STROKE_DASHARRAY]
        }
        if set(values, parent, css.STROKE_DASHOFFSET) {
            ctx.dash_offset = numberOf(values[css.STROKE_DASHOFFSET], 0.0)
        }
        ctx.opacity *= math.clamp(numberOf(values[css.OPACITY], 1.0), 0.0, 1.0)
    }

    fn children(self: *mut Self, el: NodeId, ctx: Ctx) AllocError!void {
        var cur = self.doc.firstChild(el)
        while cur |c| {
            if self.doc.node(c).kind == Kind.Element {
                try self.element(c, ctx)
            }
            cur = self.doc.nextSibling(c)
        }
    }

    // Element `el` inside an element whose context is `outer`. A
    // container with an `opacity` below 1, or an element with a clip path,
    // is a group.
    fn element(self: *mut Self, el: NodeId, outer: Ctx) AllocError!void {
        let values = self.styles.get(el) orelse return
        if text.eql(keywordOf(values[css.DISPLAY]), "none") {
            return
        }
        let name = self.doc.node(el).name
        if isOneOf(name, "defs symbol clippath mask lineargradient radialgradient pattern marker filter title desc metadata style script text foreignobject image") {
            return
        }
        var parent: ?[]Value = null
        if self.doc.parent(el) |p| {
            parent = self.styles.get(p)
        }
        var ctx = outer
        self.inherit(&mut ctx, values, parent)
        if self.doc.attr(el, "transform") |t| {
            ctx.m = mul(ctx.m, parseTransform(t))
        }
        if self.clipping {
            return self.content(el, name, ctx)
        }
        let own = math.clamp(numberOf(values[css.OPACITY], 1.0), 0.0, 1.0)
        let container = isOneOf(name, "g a switch svg use")
        let clip = try self.clipPathOf(el, ctx)
        if !(container && own < 1.0) && clip == 0 {
            return self.content(el, name, ctx)
        }
        if own <= 0.0 {
            return
        }
        var opacity = 1.0
        if container {
            // The group's opacity, not each shape's.
            ctx.opacity = outer.opacity
            opacity = own
        }
        try self.mark(1, 1.0, 0)
        try self.content(el, name, ctx)
        return self.mark(2, opacity, clip)
    }

    // The start (1) or end (2) of a group.
    fn mark(self: *mut Self, kind: u8, opacity: f64, clip: usize) AllocError!void {
        let n = self.pic.verbs.len()
        try self.pic.shapes.append(Shape {
            verb_start: n,
            verb_end: n,
            coord_start: self.pic.coords.len(),
            fill: NO_COLOR,
            stroke: NO_COLOR,
            stroke_width: 0.0,
            evenodd: false,
            cap: 0,
            join: 0,
            miter_limit: 4.0,
            fill_grad: 0,
            stroke_grad: 0,
            dash_start: 0,
            dash_end: 0,
            dash_offset: 0.0,
            group: kind,
            opacity: opacity,
            clip: clip,
        })
    }

    // The clip path of `el` (its `clip-path` attribute: a `clipPath` in
    // user space) as its index in `Picture.clips` plus 1; 0 for none.
    // A `mask` (the `mask` attribute) clips the same way, to the union of
    // its shapes: what icons' masks of white or opaque shapes do.
    fn clipPathOf(self: *mut Self, el: NodeId, ctx: Ctx) AllocError!usize {
        var target = el
        if self.doc.attr(el, "clip-path") |attr| {
            target = idRef(self.doc, attr) orelse return 0
            if !self.doc.isElement(target, "clippath") {
                return 0
            }
        } else if self.doc.attr(el, "mask") |attr| {
            target = idRef(self.doc, attr) orelse return 0
            if !self.doc.isElement(target, "mask") {
                return 0
            }
            if self.doc.attr(target, "maskcontentunits") |u| {
                if text.eql(text.trim(u), "objectBoundingBox") {
                    return 0
                }
            }
        } else {
            return 0
        }
        if self.clip_depth > 2 {
            return 0
        }
        if self.doc.attr(target, "clippathunits") |u| {
            if text.eql(text.trim(u), "objectBoundingBox") {
                return 0
            }
        }
        var cctx = ctx
        if self.doc.attr(target, "transform") |t| {
            cctx.m = mul(cctx.m, parseTransform(t))
        }
        let start = self.pic.clip_shapes.len()
        self.clipping = true
        self.clip_depth += 1
        self.children(target, cctx) catch |e| {
            self.clipping = false
            self.clip_depth -= 1
            return e
        }
        self.clipping = false
        self.clip_depth -= 1
        try self.pic.clips.append(ClipPath { start: start, end: self.pic.clip_shapes.len() })
        return self.pic.clips.len()
    }

    // What element `el` draws, its context resolved.
    fn content(self: *mut Self, el: NodeId, name: []u8, ctx: Ctx) AllocError!void {
        if text.eql(name, "g") || text.eql(name, "a") || text.eql(name, "switch") {
            return self.children(el, ctx)
        }
        if text.eql(name, "svg") {
            return self.viewport(el, el, ctx, 0.0, 0.0)
        }
        if text.eql(name, "use") {
            return self.use(el, ctx)
        }
        if !ctx.visible {
            return
        }
        let start = self.pic.verbs.len()
        let coord_start = self.pic.coords.len()
        var pen = Pen { m: ctx.m, verbs: &mut self.pic.verbs, coords: &mut self.pic.coords }
        if !(try self.shape(el, name, &mut pen, ctx)) {
            return
        }
        if self.pic.verbs.len() == start {
            return
        }
        var shape = Shape {
            verb_start: start,
            verb_end: self.pic.verbs.len(),
            coord_start: coord_start,
            fill: NO_COLOR,
            stroke: NO_COLOR,
            stroke_width: 0.0,
            evenodd: ctx.evenodd,
            cap: ctx.cap,
            join: ctx.join,
            miter_limit: ctx.miter_limit,
            fill_grad: 0,
            stroke_grad: 0,
            dash_start: 0,
            dash_end: 0,
            dash_offset: 0.0,
            group: 0,
            opacity: 1.0,
            clip: 0,
        }
        if self.clipping {
            shape.fill = Color { r: 255, g: 255, b: 255, a: 255 }
            var rule: []u8 = ""
            if self.doc.attr(el, "clip-rule") |r| {
                rule = text.trim(r)
            }
            shape.evenodd = text.eql(rule, "evenodd")
            return self.pic.clip_shapes.append(shape)
        }
        let fill = try self.resolve(ctx.fill, ctx, ctx.fill_opacity * ctx.opacity, coord_start)
        var stroke = try self.resolve(ctx.stroke, ctx, ctx.stroke_opacity * ctx.opacity, coord_start)
        let width = ctx.stroke_width * ctx.m.scale()
        if width <= 0.0 {
            stroke.c.a = 0
        }
        if fill.c.a == 0 && stroke.c.a == 0 {
            return
        }
        shape.fill = fill.c
        shape.fill_grad = fill.grad
        shape.stroke = stroke.c
        shape.stroke_grad = stroke.grad
        shape.stroke_width = width
        if stroke.c.a > 0 {
            try self.dashes(&mut shape, ctx)
        }
        try self.pic.shapes.append(shape)
    }

    // The dash pattern of the context into `Picture.dashes` for `shape`
    // (none when it is invalid or adds up to nothing).
    fn dashes(self: *mut Self, shape: *mut Shape, ctx: Ctx) AllocError!void {
        if text.eql(keywordOf(ctx.dashes), "none") {
            return
        }
        let start = self.pic.dashes.len()
        let k = ctx.m.scale()
        if !(try css.readNumbers(ctx.dashes, &mut self.pic.dashes)) {
            self.dropDashes(start)
            return
        }
        var total = 0.0
        let n = self.pic.dashes.len() - start
        for i in start..start + n {
            let d = self.pic.dashes.items()[i]
            if d < 0.0 {
                self.dropDashes(start)
                return
            }
            self.pic.dashes.items()[i] = d * k
            total += d
        }
        if total <= 0.0 {
            self.dropDashes(start)
            return
        }
        if n % 2 == 1 {
            for i in start..start + n {
                try self.pic.dashes.append(self.pic.dashes.items()[i])
            }
        }
        shape.dash_start = start
        shape.dash_end = self.pic.dashes.len()
        shape.dash_offset = ctx.dash_offset * k
    }

    fn dropDashes(self: *mut Self, start: usize) {
        while self.pic.dashes.len() > start {
            _ = self.pic.dashes.pop()
        }
    }

    // The path of a basic shape or `path` into `pen`; false for other
    // elements.
    fn shape(self: *mut Self, el: NodeId, name: []u8, pen: *mut Pen, ctx: Ctx) AllocError!bool {
        if text.eql(name, "path") {
            if self.doc.attr(el, "d") |d| {
                try parsePath(pen, d)
            }
            return true
        }
        if text.eql(name, "rect") {
            let x = self.len(el, "x", ctx.vw, 0.0)
            let y = self.len(el, "y", ctx.vh, 0.0)
            let w = self.len(el, "width", ctx.vw, 0.0)
            let h = self.len(el, "height", ctx.vh, 0.0)
            if w <= 0.0 || h <= 0.0 {
                return true
            }
            var rx = self.len(el, "rx", ctx.vw, -1.0)
            var ry = self.len(el, "ry", ctx.vh, -1.0)
            if rx < 0.0 {
                rx = ry
            }
            if ry < 0.0 {
                ry = rx
            }
            try rectPath(pen, x, y, w, h, math.clamp(rx, 0.0, w / 2.0), math.clamp(ry, 0.0, h / 2.0))
            return true
        }
        if text.eql(name, "circle") {
            let r = self.len(el, "r", math.sqrt((ctx.vw * ctx.vw + ctx.vh * ctx.vh) / 2.0), 0.0)
            if r > 0.0 {
                try ellipsePath(pen, self.len(el, "cx", ctx.vw, 0.0), self.len(el, "cy", ctx.vh, 0.0), r, r)
            }
            return true
        }
        if text.eql(name, "ellipse") {
            var rx = self.len(el, "rx", ctx.vw, -1.0)
            var ry = self.len(el, "ry", ctx.vh, -1.0)
            if rx < 0.0 {
                rx = ry
            }
            if ry < 0.0 {
                ry = rx
            }
            if rx > 0.0 && ry > 0.0 {
                try ellipsePath(pen, self.len(el, "cx", ctx.vw, 0.0), self.len(el, "cy", ctx.vh, 0.0), rx, ry)
            }
            return true
        }
        if text.eql(name, "line") {
            try pen.moveTo(self.len(el, "x1", ctx.vw, 0.0), self.len(el, "y1", ctx.vh, 0.0))
            try pen.lineTo(self.len(el, "x2", ctx.vw, 0.0), self.len(el, "y2", ctx.vh, 0.0))
            return true
        }
        if text.eql(name, "polyline") || text.eql(name, "polygon") {
            if self.doc.attr(el, "points") |p| {
                try pointsPath(pen, p, text.eql(name, "polygon"))
            }
            return true
        }
        return false
    }

    // The length attribute `name` of `el` (percentages of `ref`), or `d`.
    fn len(self: *mut Self, el: NodeId, name: []u8, ref: f64, d: f64) f64 {
        if self.doc.attr(el, name) |v| {
            if lengthOf(v, ref) |n| {
                return n
            }
        }
        return d
    }

    // A nested `svg` (`el`), or a `symbol` (`el`) used by a `use`
    // (`sized`, whose `width` and `height` win): a new viewport at its
    // `x`, `y` (plus `dx`, `dy`), its viewBox mapped into it.
    fn viewport(self: *mut Self, el: NodeId, sized: NodeId, outer: Ctx, dx: f64, dy: f64) AllocError!void {
        var ctx = outer
        let x = self.len(el, "x", ctx.vw, 0.0) + dx
        let y = self.len(el, "y", ctx.vh, 0.0) + dy
        var w = self.len(sized, "width", ctx.vw, -1.0)
        var h = self.len(sized, "height", ctx.vh, -1.0)
        if w < 0.0 {
            w = self.len(el, "width", ctx.vw, ctx.vw)
        }
        if h < 0.0 {
            h = self.len(el, "height", ctx.vh, ctx.vh)
        }
        if w <= 0.0 || h <= 0.0 {
            return
        }
        var view: ?ViewBox = null
        if self.doc.attr(el, "viewbox") |v| {
            view = parseViewBox(v)
        }
        if view |vb| {
            var aspect = DEFAULT_ASPECT
            if self.doc.attr(el, "preserveaspectratio") |v| {
                aspect = parseAspect(v)
            }
            ctx.m = mul(ctx.m, viewBoxTransform(vb, aspect, x, y, w, h))
            ctx.vw = vb.w
            ctx.vh = vb.h
        } else {
            ctx.m = mul(ctx.m, translate(x, y))
            ctx.vw = w
            ctx.vh = h
        }
        return self.children(el, ctx)
    }

    // A `use`: the element it refers to, moved by its `x` and `y`,
    // inheriting from the `use`.
    fn use(self: *mut Self, el: NodeId, outer: Ctx) AllocError!void {
        if outer.depth >= 8 {
            return
        }
        var href = self.doc.attr(el, "href") orelse ""
        if href.len == 0 {
            href = self.doc.attr(el, "xlink:href") orelse ""
        }
        let id = text.trim(href)
        if id.len < 2 || id[0] != '#' {
            return
        }
        let target = self.doc.getElementById(id[1..]) orelse return
        var ctx = outer
        ctx.depth += 1
        let x = self.len(el, "x", ctx.vw, 0.0)
        let y = self.len(el, "y", ctx.vh, 0.0)
        if self.doc.isElement(target, "symbol") || self.doc.isElement(target, "svg") {
            let values = self.styles.get(target) orelse return
            var parent: ?[]Value = null
            if self.doc.parent(target) |p| {
                parent = self.styles.get(p)
            }
            self.inherit(&mut ctx, values, parent)
            return self.viewport(target, el, ctx, x, y)
        }
        ctx.m = mul(ctx.m, translate(x, y))
        return self.element(target, ctx)
    }

    // The color (or gradient) of a paint for a shape whose points start
    // at `coord_start`, in context `ctx`, with `opacity` applied (alpha 0:
    // nothing).
    fn resolve(self: *mut Self, p: Paint, ctx: Ctx, opacity: f64, coord_start: usize) AllocError!Painted {
        var c = NO_COLOR
        match p {
            .None => {}
            .Solid { c: k } => {
                c = k
            }
            .Current => {
                c = ctx.color
            }
            .Ref { s } => {
                if gradientRef(self.doc, s) |g| {
                    let k = try self.gradient(g, ctx, opacity, coord_start)
                    if k > 0 {
                        return Painted { c: Color { r: 0, g: 0, b: 0, a: 255 }, grad: k }
                    }
                    return Painted { c: NO_COLOR, grad: 0 }
                }
                c = fallback(s, ctx.color)
            }
        }
        c.a = alpha(c.a as f64 / 255.0 * opacity)
        return Painted { c: c, grad: 0 }
    }

    // The gradient element `g` for the shape whose points start at
    // `coord_start`: its index in `Picture.gradients` plus 1; 0 when it
    // paints nothing.
    fn gradient(self: *mut Self, g: NodeId, ctx: Ctx, opacity: f64, coord_start: usize) AllocError!usize {
        // The shape's box in user space (of its points, control points
        // included).
        var x0 = 0.0
        var y0 = 0.0
        var x1 = 0.0
        var y1 = 0.0
        if invert(ctx.m) |inv| {
            let co = self.pic.coords.items()
            var i = coord_start
            while i + 1 < co.len {
                let x = inv.mapX(co[i], co[i + 1])
                let y = inv.mapY(co[i], co[i + 1])
                if i == coord_start || x < x0 {
                    x0 = x
                }
                if i == coord_start || x > x1 {
                    x1 = x
                }
                if i == coord_start || y < y0 {
                    y0 = y
                }
                if i == coord_start || y > y1 {
                    y1 = y
                }
                i += 2
            }
        }
        let made = try gradientOf(self.pic.alloc, self.doc, self.styles, g, ctx.m, x0, y0, x1 - x0, y1 - y0, ctx.vw, ctx.vh, opacity, ctx.color)
        let grad = made orelse return 0
        try self.pic.gradients.append(grad)
        return self.pic.gradients.len()
    }
}

// A paint resolved: a color, or a gradient (`grad` > 0) whose stops have
// the opacity.
struct Painted {
    c: Color
    grad: usize
}

// The fallback of a paint `url(#id) fallback` (the text `s`, maybe
// without `url(`) that refers to no gradient: `currentColor` (`current`),
// or nothing.
fn fallback(s: []u8, current: Color) Color {
    var end: usize = 0
    while end < s.len && s[end] != '#' {
        end += 1
    }
    while end < s.len && s[end] != ' ' && s[end] != ')' {
        end += 1
    }
    var rest = s[end..]
    if rest.len > 0 && rest[0] == ')' {
        rest = rest[1..]
    }
    rest = text.trim(rest)
    if text.eql(rest, "currentcolor") || text.eql(rest, "currentColor") {
        return current
    }
    return NO_COLOR
}

// The element that `url(#id)` (or `#id`) in `s` names.
fn idRef(doc: *Document, s: []u8) ?NodeId {
    var i: usize = 0
    while i < s.len && s[i] != '#' {
        i += 1
    }
    var end = i + 1
    while end < s.len && s[end] != ' ' && s[end] != '"' && s[end] != '\'' && s[end] != ')' {
        end += 1
    }
    if i >= s.len || end <= i + 1 {
        return null
    }
    return doc.getElementById(s[i + 1..end])
}

// Is the property `p` set on the element itself (not inherited)?
fn set(values: []Value, parent: ?[]Value, p: usize) bool {
    if parent |pv| {
        return !css.sameValue(values[p], pv[p])
    }
    return true
}

fn isOneOf(name: []u8, set_: []u8) bool {
    var words = text.split(set_, " ")
    while words.next() |w| {
        if text.eql(w, name) {
            return true
        }
    }
    return false
}
