// Fetching many subresources at once (the images, style sheets or
// scripts of a page) with libcurl's multi interface: `prefetch` runs the
// GET requests concurrently (at most 6 connections per host, HTTP/2
// streams shared) and puts the responses in the session's cache, where
// the fetches that follow, one by one, find them. A redirect is not
// followed here (that later fetch does it); a response that may not be
// cached (an error status, `no-store`) is kept for one use. Cookies are
// sent and stored as for any request.

import perf
import std
import std.list.List
import std.mem.Allocator
import std.text
import url
import url.Url

extern struct CurlMulti {}
extern struct CurlMsg {
    msg: i32
    easy: ?*mut Curl
    result: i32
}

extern fn curl_multi_init() ?*mut CurlMulti
extern fn curl_multi_setopt(m: *mut CurlMulti, option: i32, ...) i32
extern fn curl_multi_add_handle(m: *mut CurlMulti, e: *mut Curl) i32
extern fn curl_multi_remove_handle(m: *mut CurlMulti, e: *mut Curl) i32
extern fn curl_multi_perform(m: *mut CurlMulti, running: *mut i32) i32
extern fn curl_multi_poll(m: *mut CurlMulti, fds: ?[*]u8, nfds: u32, timeout_ms: i32, numfds: ?*mut i32) i32
extern fn curl_multi_info_read(m: *mut CurlMulti, left: *mut i32) ?*CurlMsg
extern fn curl_multi_cleanup(m: *mut CurlMulti) i32

let CURLMOPT_MAX_HOST_CONNECTIONS: i32 = 7
let CURLMOPT_MAX_TOTAL_CONNECTIONS: i32 = 13
let CURLMSG_DONE: i32 = 1

// One request of a batch.
struct Job {
    curl: *mut Curl
    at: Url
    // `at.href`, NUL-terminated.
    address: []mut u8
    headers: ?*mut CurlList
    sink: Sink
    result: i32
}

/// Fetches the `http:` and `https:` URLs of `hrefs` (one per line, no
/// fragments) concurrently into the session's cache, for requests of
/// `kind` from the page at `referrer`. URLs already cached are skipped;
/// failures are left to the fetch that follows. Does nothing without a
/// session.
pub fn prefetch(alloc: Allocator, hrefs: []u8, kind: Kind, referrer: []u8) {
    let began = perf.start()
    defer perf.end("prefetch", began, referrer)
    if archiveReplay() {
        return
    }
    let s = session orelse return
    let m = curl_multi_init() orelse return
    defer curl_multi_cleanup(m)
    curl_multi_setopt(m, CURLMOPT_MAX_HOST_CONNECTIONS, 6 as i64)
    curl_multi_setopt(m, CURLMOPT_MAX_TOTAL_CONNECTIONS, 16 as i64)
    var jobs = List(*mut Job).init(alloc)
    defer finishJobs(alloc, s, m, &mut jobs)
    let req = Request { kind: kind, referrer: referrer }
    var lines = text.split(hrefs, "\n")
    while lines.next() |href| {
        if !text.startsWith(href, "http://") && !text.startsWith(href, "https://") {
            continue
        }
        if s.cache.has(href) || queued(&jobs, href) {
            continue
        }
        let job = startJob(alloc, s, m, href, req) orelse continue
        jobs.append(job) catch |e| {
            dropJob(alloc, m, job)
            return
        }
    }
    var running: i32 = 1
    while running > 0 {
        if curl_multi_perform(m, &mut running) != 0 {
            break
        }
        // The background loads go on meanwhile (loader.ore).
        pumpLoads()
        if running > 0 {
            var wait: i32 = 1000
            if loadsRunning() {
                wait = 10
            }
            curl_multi_poll(m, null, 0, wait, null)
        }
    }
    var left: i32 = 0
    while curl_multi_info_read(m, &mut left) |msg| {
        if msg.msg != CURLMSG_DONE {
            continue
        }
        for job in jobs.items() {
            if msg.easy == job.curl {
                job.result = msg.result
            }
        }
    }
}

fn queued(jobs: *List(*mut Job), href: []u8) bool {
    for job in jobs.items() {
        if text.eql(job.at.href, href) {
            return true
        }
    }
    return false
}

// A request for `href` added to `m`; null when it cannot be made.
fn startJob(alloc: Allocator, s: *mut Session, m: *mut CurlMulti, href: []u8, req: Request) ?*mut Job {
    let at = url.parse(alloc, href) catch |e| {
        return null
    }
    let address = alloc.alloc(0 as u8, href.len + 1) catch |e| {
        at.deinit(alloc)
        return null
    }
    std.mem.copy(address, href)
    let curl = curl_easy_init() orelse {
        alloc.free(address)
        at.deinit(alloc)
        return null
    }
    let job = alloc.create(Job {
        curl: curl,
        at: at,
        address: address,
        headers: null,
        sink: Sink {
            body: text.Builder.init(alloc),
            limit: MAX_SUBRESOURCE,
            out_of_memory: false,
            too_large: false,
            cookies: text.Builder.init(alloc),
            no_store: false,
        },
        result: -1,
    }) catch |e| {
        curl_easy_cleanup(curl)
        alloc.free(address)
        at.deinit(alloc)
        return null
    }
    job.headers = prepare(alloc, curl, address.ptr, &job.at, req, null, s, &mut job.sink) catch |e| {
        freeJob(alloc, job)
        return null
    }
    if curl_multi_add_handle(m, curl) != 0 {
        freeJob(alloc, job)
        return null
    }
    return job
}

// After the transfers: keeps the responses and frees the jobs.
fn finishJobs(alloc: Allocator, s: *mut Session, m: *mut CurlMulti, jobs: *mut List(*mut Job)) {
    for job in jobs.items() {
        if job.result == 0 && !job.sink.out_of_memory && !job.sink.too_large {
            keepResponse(alloc, s, job) catch |e| {
            }
        }
        dropJob(alloc, m, job)
    }
    jobs.deinit()
}

fn keepResponse(alloc: Allocator, s: *mut Session, job: *mut Job) FetchError!void {
    try storeCookies(s, &job.at, &job.sink)
    var status: i64 = 0
    curl_easy_getinfo(job.curl, CURLINFO_RESPONSE_CODE, &mut status)
    if status >= 300 && status < 400 {
        return
    }
    var content_type: ?[*]u8 = null
    curl_easy_getinfo(job.curl, CURLINFO_CONTENT_TYPE, &mut content_type)
    var ct: []u8 = ""
    if content_type |p| {
        ct = p[0..strlen(p)]
    } else {
        ct = typeOfPath(job.at.path)
    }
    let body = try job.sink.body.toOwned()
    var res = try respond(alloc, ct, body)
    defer res.deinit(alloc)
    res.status = status
    let lasting = status >= 200 && status < 300 && !job.sink.no_store
    try s.cache.keep(job.at.href, &res, !lasting)
}

fn dropJob(alloc: Allocator, m: *mut CurlMulti, job: *mut Job) {
    curl_multi_remove_handle(m, job.curl)
    freeJob(alloc, job)
}

fn freeJob(alloc: Allocator, job: *mut Job) {
    curl_easy_cleanup(job.curl)
    curl_slist_free_all(job.headers)
    job.sink.body.deinit()
    job.sink.cookies.deinit()
    alloc.free(job.address)
    job.at.deinit(alloc)
    alloc.destroy(job)
}
