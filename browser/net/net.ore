// net: fetching a URL: `file:` (file.ore), `data:` (data.ore), and
// `http:` and `https:` through libcurl (http.ore), with the cookie jar
// (cookies.ore) and the cache (cache.ore) of the process's session
// (session.ore).

import std.mem.AllocError
import std.mem.Allocator
import std.text
import url
import url.Url

pub error FetchError {
    NotFound
    AccessDenied
    OpenFailed
    ReadFailed
    OutOfMemory
    Invalid
    Unsupported
    CannotResolve
    CannotConnect
    Timeout
    TooManyRedirects
    TooLarge
    Tls
    Network
}

/// What a fetch returns. Every slice is owned by the response: free them
/// with `deinit`.
pub struct Response {
    // The MIME type in lower case, without parameters: "text/html".
    mime: []mut u8
    // The `charset` parameter of the content type, or empty.
    charset: []mut u8
    body: []mut u8
    // The HTTP status; 200 for `file:` and `data:`.
    status: i64
    // The URL of the body when redirects led elsewhere, else empty.
    url: []mut u8

    pub fn deinit(self: *Self, alloc: Allocator) {
        alloc.free(self.mime)
        alloc.free(self.charset)
        alloc.free(self.body)
        if self.url.len > 0 {
            alloc.free(self.url)
        }
    }
}

/// The body of a POST request.
pub struct Body {
    // The `Content-Type` header: "application/x-www-form-urlencoded",
    // "multipart/form-data; boundary=...", "text/plain".
    content_type: []u8
    data: []u8
}

/// What a request is for: it decides the `Accept` header, the size
/// limit, and whether the response may come from the cache.
pub enum Kind {
    // A page (a navigation, a form submission).
    Document
    Style
    Image
    Script
    // A script's `fetch()`.
    Other
}

pub struct Request {
    kind: Kind = Kind.Document
    // The URL of the page that asks, sent as the Referer (see
    // `referrerOf`); "" for none (a URL the user typed). A document
    // request without one takes the referrer of `noteNavigation`.
    referrer: []u8 = ""
    // A POST body (for `http:` and `https:`; other URLs ignore it).
    body: ?*Body = null
}

/// Fetches `target` as a document the user asked for.
pub fn fetch(alloc: Allocator, target: *Url) FetchError!Response {
    return request(alloc, target, Request {})
}

/// Fetches `target`, by POST with `body` when there is one (for `http:`
/// and `https:`; other URLs ignore it).
pub fn fetchWith(alloc: Allocator, target: *Url, body: ?*Body) FetchError!Response {
    return request(alloc, target, Request { body: body })
}

/// Fetches `target` for `req`.
pub fn request(alloc: Allocator, target: *Url, req: Request) FetchError!Response {
    if try archiveRead(alloc, target, req) |res| {
        return res
    }
    let res = requestLive(alloc, target, req) catch |e| {
        archiveWrite(alloc, target, req, null, describe(e))
        return e
    }
    archiveWrite(alloc, target, req, &res, "")
    return res
}

fn requestLive(alloc: Allocator, target: *Url, req: Request) FetchError!Response {
    if text.eql(target.scheme, "file") {
        return fetchFile(alloc, target)
    }
    if text.eql(target.scheme, "data") {
        return fetchData(alloc, target)
    }
    if !text.eql(target.scheme, "http") && !text.eql(target.scheme, "https") {
        return FetchError.Unsupported
    }
    if req.kind != Kind.Document {
        return fetchHttp(alloc, target, req)
    }
    // A navigation from a page (noteNavigation) sends the page's URL.
    let s = session orelse return fetchHttp(alloc, target, req)
    let hint_target = s.nav_target
    let hint_referrer = s.nav_referrer
    s.nav_target = []mut u8{}
    s.nav_referrer = []mut u8{}
    defer release(s.alloc, hint_target)
    defer release(s.alloc, hint_referrer)
    var r = req
    if r.referrer.len == 0 && text.eql(hint_target, target.withoutFragment()) {
        r.referrer = hint_referrer
    }
    return fetchHttp(alloc, target, r)
}

/// A message for a fetch error, for the command line.
pub fn describe(e: FetchError) []u8 {
    return match e {
        .NotFound => "not found"
        .AccessDenied => "access denied"
        .OpenFailed => "cannot open"
        .ReadFailed => "cannot read"
        .OutOfMemory => "out of memory"
        .Invalid => "invalid data: URL"
        .Unsupported => "this kind of URL is not supported yet"
        .CannotResolve => "cannot resolve the host"
        .CannotConnect => "cannot connect"
        .Timeout => "timed out"
        .TooManyRedirects => "too many redirects"
        .TooLarge => "the response is too large"
        .Tls => "the secure connection failed (TLS)"
        .Network => "network error"
    }
}

// A response with a copy of the type parts of `content_type` ("text/html;
// charset=utf-8") and `body` (taken over).
fn respond(alloc: Allocator, content_type: []u8, body: []mut u8) AllocError!Response {
    let ct = parseContentType(content_type)
    let mime = alloc.alloc(0 as u8, ct.mime.len) catch |e| {
        alloc.free(body)
        return e
    }
    for i, c in ct.mime {
        mime[i] = lowerByte(c)
    }
    let charset = alloc.alloc(0 as u8, ct.charset.len) catch |e| {
        alloc.free(mime)
        alloc.free(body)
        return e
    }
    for i, c in ct.charset {
        charset[i] = c
    }
    return Response { mime: mime, charset: charset, body: body, status: 200, url: []mut u8{} }
}

/// A content type split into its MIME type and `charset` parameter.
pub struct ContentType {
    mime: []u8
    charset: []u8
}

/// Splits "text/html; charset=UTF-8" into "text/html" and "UTF-8" (the
/// MIME type keeps its case; quotes around the charset go).
pub fn parseContentType(s: []u8) ContentType {
    var parts = text.split(s, ";")
    var mime: []u8 = ""
    var charset: []u8 = ""
    var first = true
    while parts.next() |part| {
        let p = text.trim(part)
        if first {
            mime = p
            first = false
        } else if p.len > 8 && text.eqlIgnoreCase(p[..8], "charset=") {
            var v = text.trim(p[8..])
            if v.len >= 2 && v[0] == '"' && v[v.len - 1] == '"' {
                v = v[1..v.len - 1]
            }
            charset = v
        }
    }
    return ContentType { mime: mime, charset: charset }
}

fn lowerByte(c: u8) u8 {
    if c >= 'A' && c <= 'Z' {
        return c + 32
    }
    return c
}
