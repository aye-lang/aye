// The in-memory HTTP cache of the session: style sheets, images and
// scripts fetched by GET with a 2xx status are kept by URL (without the
// fragment), so laying out again, reloading or visiting another page of
// the site does not fetch them again. A response with `Cache-Control:
// no-store` is not kept; nothing expires within a session. At most
// MAX_CACHE_BYTES of bodies are kept (later responses are not).

import std
import std.list.List
import std.mem.AllocError
import std.mem.Allocator

let MAX_CACHE_BYTES: usize = 128 << 20

struct Cached {
    href: []mut u8
    mime: []mut u8
    charset: []mut u8
    body: []mut u8
    status: i64
    // The URL after redirects, or empty.
    moved: []mut u8
}

pub struct Cache {
    alloc: Allocator
    entries: List(Cached)
    bytes: usize

    pub fn init(alloc: Allocator) Cache {
        return Cache { alloc: alloc, entries: List(Cached).init(alloc), bytes: 0 }
    }

    pub fn deinit(self: *mut Self) {
        for e in self.entries.items() {
            release(self.alloc, e.href)
            release(self.alloc, e.mime)
            release(self.alloc, e.charset)
            release(self.alloc, e.body)
            release(self.alloc, e.moved)
        }
        self.entries.deinit()
    }

    /// A copy (from `alloc`) of the response kept for `href`, or null.
    pub fn lookup(self: *Self, alloc: Allocator, href: []u8) AllocError!?Response {
        for e in self.entries.items() {
            if std.mem.eql(e.href, href) {
                let mime = try copyBytes(alloc, e.mime)
                errdefer alloc.free(mime)
                let charset = try copyBytes(alloc, e.charset)
                errdefer alloc.free(charset)
                let body = try copyBytes(alloc, e.body)
                errdefer alloc.free(body)
                var moved = []mut u8{}
                if e.moved.len > 0 {
                    moved = try dup(alloc, e.moved)
                }
                return Response { mime: mime, charset: charset, body: body, status: e.status, url: moved }
            }
        }
        return null
    }

    /// Keeps a copy of `res`, the response for `href`.
    pub fn keep(self: *mut Self, href: []u8, res: *Response) AllocError!void {
        if self.bytes + res.body.len > MAX_CACHE_BYTES {
            return
        }
        let a = self.alloc
        let e = Cached {
            href: try dup(a, href),
            mime: try dup(a, res.mime),
            charset: try dup(a, res.charset),
            body: try dup(a, res.body),
            status: res.status,
            moved: try dup(a, res.url),
        }
        self.entries.append(e) catch |err| {
            release(a, e.href)
            release(a, e.mime)
            release(a, e.charset)
            release(a, e.body)
            release(a, e.moved)
            return err
        }
        self.bytes += res.body.len
    }
}
