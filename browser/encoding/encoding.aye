// encoding: turning fetched bytes into UTF-8, and form data into the
// page's encoding. It knows UTF-8, Windows-1252 (which browsers use for
// the labels "latin1", "ascii" and "iso-8859-1" too) and the legacy CJK
// encodings of the WHATWG Encoding Standard (cjk.aye, with the indexes
// in tables.aye): Shift_JIS, EUC-JP, ISO-2022-JP, GBK, gb18030, Big5 and
// EUC-KR.

import std.mem.AllocError
import std.mem.Allocator
import std.text

pub enum Encoding {
    Utf8
    Windows1252
    ShiftJis
    EucJp
    Iso2022Jp
    Gbk
    Gb18030
    Big5
    EucKr
}

// The labels of each encoding (WHATWG), in the order of `ENCODINGS`.
let LABELS = [9][]u8{
    "utf-8 utf8 unicode-1-1-utf-8 unicode11utf8 unicode20utf8 x-unicode20utf8",
    "windows-1252 cp1252 x-cp1252 latin1 l1 iso-8859-1 iso8859-1 iso88591 iso_8859-1 iso_8859-1:1987 iso-ir-100 ibm819 cp819 csisolatin1 ascii us-ascii ansi_x3.4-1968",
    "shift_jis csshiftjis ms932 ms_kanji shift-jis sjis windows-31j x-sjis",
    "euc-jp cseucpkdfmtjapanese x-euc-jp",
    "iso-2022-jp csiso2022jp",
    "gbk chinese csgb2312 csiso58gb231280 gb2312 gb_2312 gb_2312-80 iso-ir-58 x-gbk",
    "gb18030",
    "big5 big5-hkscs cn-big5 csbig5 x-x-big5",
    "euc-kr cseuckr csksc56011987 iso-ir-149 korean ks_c_5601-1987 ks_c_5601-1989 ksc5601 ksc_5601 windows-949",
}

let ENCODINGS = [9]Encoding{
    Encoding.Utf8, Encoding.Windows1252, Encoding.ShiftJis, Encoding.EucJp, Encoding.Iso2022Jp,
    Encoding.Gbk, Encoding.Gb18030, Encoding.Big5, Encoding.EucKr,
}

let NAMES = [9][]u8{"UTF-8", "windows-1252", "Shift_JIS", "EUC-JP", "ISO-2022-JP", "GBK", "gb18030", "Big5", "EUC-KR"}

/// The encoding named by a label such as "utf-8", "ISO-8859-1" or
/// "Shift_JIS"; null for a label it does not know.
pub fn fromLabel(label: []u8) ?Encoding {
    let l = text.trim(label)
    for k in 0..LABELS.len {
        var words = text.split(LABELS[k], " ")
        while words.next() |w| {
            if text.eqlIgnoreCase(l, w) {
                return ENCODINGS[k]
            }
        }
    }
    return null
}

/// The name of `enc` (`document.characterSet`): "UTF-8", "Shift_JIS", ...
pub fn nameOf(enc: Encoding) []u8 {
    for k in 0..ENCODINGS.len {
        if ENCODINGS[k] == enc {
            return NAMES[k]
        }
    }
    return "UTF-8"
}

/// Picks the encoding of an HTML document: a byte order mark first, then
/// the `charset` of the Content-Type, then a `<meta charset>` (or
/// `content="...; charset=..."`) in the first 1024 bytes, and finally UTF-8
/// if the bytes are valid UTF-8, else Windows-1252.
pub fn sniff(bytes: []u8, content_charset: []u8) Encoding {
    return sniffOr(bytes, content_charset, Encoding.Windows1252)
}

/// `sniff`, with `fallback` instead of Windows-1252 for bytes that
/// declare nothing and are not UTF-8: the encoding of the document that
/// loads them (a frame, a script, a style sheet).
pub fn sniffOr(bytes: []u8, content_charset: []u8, fallback: Encoding) Encoding {
    if text.startsWith(bytes, "\xEF\xBB\xBF") {
        return Encoding.Utf8
    }
    if fromLabel(content_charset) |e| {
        return e
    }
    var head = bytes
    if head.len > 1024 {
        head = head[..1024]
    }
    if metaCharset(head) |label| {
        if fromLabel(label) |e| {
            return e
        }
    }
    if isUtf8(bytes) {
        return Encoding.Utf8
    }
    return fallback
}

/// The encoding label declared by a `meta` element in `head` (the first
/// 1024 bytes), as WHATWG's prescan finds it, simplified: comments and
/// other tags are skipped; a `meta` declares with `charset=` or with
/// `http-equiv=content-type` and a `content` that has `charset=`.
/// A UTF-16 label means UTF-8 there (the bytes were read as ASCII).
pub fn metaCharset(head: []u8) ?[]u8 {
    var i: usize = 0
    while i < head.len {
        if head[i] != '<' {
            i += 1
            continue
        }
        let rest = head[i..]
        if text.startsWith(rest, "<!--") {
            i += 4
            while i < head.len && !text.startsWith(head[i..], "-->") {
                i += 1
            }
            i += 3
            continue
        }
        if rest.len > 5 && text.eqlIgnoreCase(rest[1..5], "meta") && (isSpace(rest[5]) || rest[5] == '/') {
            var tag = Tag { src: head, at: i + 5 }
            var pragma = false
            var declared: ?[]u8 = null
            var from_content: ?[]u8 = null
            while tag.next() |attr| {
                if text.eqlIgnoreCase(attr.name, "charset") {
                    if declared == null {
                        declared = text.trim(attr.value)
                    }
                } else if text.eqlIgnoreCase(attr.name, "http-equiv") {
                    pragma = pragma || text.eqlIgnoreCase(text.trim(attr.value), "content-type")
                } else if text.eqlIgnoreCase(attr.name, "content") {
                    from_content = charsetIn(attr.value)
                }
            }
            if declared |label| {
                return forMeta(label)
            }
            if pragma {
                if from_content |label| {
                    return forMeta(label)
                }
            }
            i = tag.at
            continue
        }
        // Another tag, `</...>`, `<!...>` or `<?...>`: skipped whole.
        i += 1
        while i < head.len && head[i] != '>' {
            i += 1
        }
    }
    return null
}

fn forMeta(label: []u8) []u8 {
    if label.len >= 6 && text.eqlIgnoreCase(label[..6], "utf-16") {
        return "utf-8"
    }
    return label
}

// The value of `charset=` in a `content` attribute ("text/html;
// charset=ISO-8859-1"), quotes left out.
fn charsetIn(content: []u8) ?[]u8 {
    var k: usize = 0
    while k + 7 <= content.len {
        if text.eqlIgnoreCase(content[k..k + 7], "charset") {
            var lo = k + 7
            while lo < content.len && isSpace(content[lo]) {
                lo += 1
            }
            if lo < content.len && content[lo] == '=' {
                lo += 1
                while lo < content.len && (isSpace(content[lo]) || content[lo] == '"' || content[lo] == '\'') {
                    lo += 1
                }
                var hi = lo
                while hi < content.len && isLabelByte(content[hi]) {
                    hi += 1
                }
                if hi > lo {
                    return content[lo..hi]
                }
                return null
            }
        }
        k += 1
    }
    return null
}

fn isSpace(c: u8) bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 0x0C
}

struct Attr {
    name: []u8
    value: []u8
}

// The attributes of a tag in `src` from `at` (after the tag name) to
// its `>`; `at` ends after the `>`.
struct Tag {
    src: []u8
    at: usize

    fn next(self: *mut Self) ?Attr {
        let s = self.src
        while self.at < s.len && (isSpace(s[self.at]) || s[self.at] == '/') {
            self.at += 1
        }
        if self.at >= s.len || s[self.at] == '>' {
            self.at += 1
            return null
        }
        let start = self.at
        while self.at < s.len && s[self.at] != '=' && s[self.at] != '>' && !isSpace(s[self.at]) && !(s[self.at] == '/' && self.at > start) {
            self.at += 1
        }
        let name = s[start..self.at]
        while self.at < s.len && isSpace(s[self.at]) {
            self.at += 1
        }
        if self.at >= s.len || s[self.at] != '=' {
            return Attr { name: name, value: "" }
        }
        self.at += 1
        while self.at < s.len && isSpace(s[self.at]) {
            self.at += 1
        }
        if self.at < s.len && (s[self.at] == '"' || s[self.at] == '\'') {
            let quote = s[self.at]
            self.at += 1
            let lo = self.at
            while self.at < s.len && s[self.at] != quote {
                self.at += 1
            }
            let value = s[lo..self.at]
            if self.at < s.len {
                self.at += 1
            }
            return Attr { name: name, value: value }
        }
        let lo = self.at
        while self.at < s.len && !isSpace(s[self.at]) && s[self.at] != '>' {
            self.at += 1
        }
        return Attr { name: name, value: s[lo..self.at] }
    }
}

/// Is `s` valid UTF-8?
pub fn isUtf8(s: []u8) bool {
    var i: usize = 0
    while i < s.len {
        let d = text.decode(s[i..])
        if d.code == 0xFFFD && !text.startsWith(s[i..], "\xEF\xBF\xBD") {
            return false
        }
        i += d.len
    }
    return true
}

/// `bytes` in `enc` as UTF-8, in new memory from `alloc`; a UTF-8 byte
/// order mark is dropped and invalid UTF-8 becomes U+FFFD.
pub fn toUtf8(alloc: Allocator, bytes: []u8, enc: Encoding) AllocError![]mut u8 {
    var out = text.Builder.init(alloc)
    errdefer out.deinit()
    match enc {
        .Utf8 => {
            var i: usize = 0
            if text.startsWith(bytes, "\xEF\xBB\xBF") {
                i = 3
            }
            while i < bytes.len {
                let d = text.decode(bytes[i..])
                if d.len == 1 && d.code != 0xFFFD {
                    try out.appendByte(bytes[i])
                } else if d.code == 0xFFFD {
                    try out.appendChar(0xFFFD)
                } else {
                    try out.append(bytes[i..i + d.len])
                }
                i += d.len
            }
        }
        .Windows1252 => {
            for b in bytes {
                try out.appendChar(windows1252(b))
            }
        }
        .ShiftJis => {
            try decodeShiftJis(&mut out, bytes)
        }
        .EucJp => {
            try decodeEucJp(&mut out, bytes)
        }
        .Iso2022Jp => {
            try decodeIso2022Jp(&mut out, bytes)
        }
        .Gbk, .Gb18030 => {
            try decodeGb18030(&mut out, bytes)
        }
        .Big5 => {
            try decodeBig5(&mut out, bytes)
        }
        .EucKr => {
            try decodeEucKr(&mut out, bytes)
        }
    }
    return out.toOwned()
}

/// `s` (UTF-8) in `enc`, in new memory from `alloc`, for form data: a
/// code point that `enc` cannot write becomes `&#N;` (N in decimal), as
/// browsers send it.
pub fn fromUtf8(alloc: Allocator, s: []u8, enc: Encoding) AllocError![]mut u8 {
    var out = text.Builder.init(alloc)
    errdefer out.deinit()
    if enc == Encoding.Utf8 {
        try out.append(s)
        return out.toOwned()
    }
    var jp = Iso2022JpEncoder { state: 0 }
    var i: usize = 0
    while i < s.len {
        let d = text.decode(s[i..])
        i += d.len
        let cp = d.code
        var done = false
        if enc == Encoding.Iso2022Jp {
            done = try encodeIso2022Jp(&mut out, &mut jp, cp)
        } else if cp < 0x80 {
            try out.appendByte(cp as u8)
            done = true
        } else {
            done = try encodeOne(&mut out, cp, enc)
        }
        if !done {
            try out.append("&#")
            try out.appendUint(cp as u64)
            try out.appendByte(';')
        }
    }
    try finishIso2022Jp(&mut out, &mut jp)
    return out.toOwned()
}

// One code point (not ASCII) in `enc`, except UTF-8 and ISO-2022-JP;
// false when `enc` has none for it.
fn encodeOne(out: *mut text.Builder, cp: u32, enc: Encoding) AllocError!bool {
    return match enc {
        .Windows1252 => try encodeWindows1252(out, cp)
        .ShiftJis => try encodeShiftJis(out, cp)
        .EucJp => try encodeEucJp(out, cp)
        .Gbk => try encodeGb18030(out, cp, true)
        .Gb18030 => try encodeGb18030(out, cp, false)
        .Big5 => try encodeBig5(out, cp)
        .EucKr => try encodeEucKr(out, cp)
        .Utf8, .Iso2022Jp => false
    }
}

fn encodeWindows1252(out: *mut text.Builder, cp: u32) AllocError!bool {
    if cp >= 0xA0 && cp <= 0xFF {
        try out.appendByte(cp as u8)
        return true
    }
    for k in 0..CP1252.len {
        if CP1252[k] == cp {
            try out.appendByte((0x80 + k) as u8)
            return true
        }
    }
    return false
}

/// The code point of the Windows-1252 byte `b`. The bytes 0x80 to 0x9F
/// are not Latin-1's control characters but the table below (the five
/// unassigned ones stay as they are).
pub fn windows1252(b: u8) u32 {
    if b < 0x80 || b > 0x9F {
        return b as u32
    }
    return CP1252[(b - 0x80) as usize]
}

let CP1252 = [32]u32{
    0x20AC, 0x81, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021,
    0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, 0x8D, 0x017D, 0x8F,
    0x90, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014,
    0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, 0x9D, 0x017E, 0x0178,
}

fn isLabelByte(c: u8) bool {
    return match c {
        'a'..='z', 'A'..='Z', '0'..='9', '-', '_', ':', '.' => true
        _ => false
    }
}

test "labels" {
    @expect(fromLabel("UTF-8") == Encoding.Utf8)
    @expect(fromLabel(" iso-8859-1 ") == Encoding.Windows1252)
    @expect(fromLabel("koi8-r") == null)
}

test "prescan" {
    @expect(sniff("<!-- <meta charset=latin1> --><meta charset=utf-8>caf\xE9", "") == Encoding.Utf8)
    @expect(sniff("<meta name=description content=\"charset=latin1\">caf\xC3\xA9", "") == Encoding.Utf8)
    @expect(sniff("<meta content='text/html; charset=windows-1252' http-equiv='Content-Type'>\xC3\xA9", "") == Encoding.Windows1252)
    @expect(sniff("<metadata charset=latin1>caf\xC3\xA9", "") == Encoding.Utf8)
    @expect(sniff("<meta charset=\"UTF-16LE\">caf\xE9", "") == Encoding.Utf8)
    @expect(sniff("<title>x > y</title><META CHARSET=ISO-8859-1>", "") == Encoding.Windows1252)
    @expect(fromLabel("ISO_8859-1:1987") == Encoding.Windows1252)
}

test "sniffing" {
    @expect(sniff("<meta charset=\"latin1\">", "") == Encoding.Windows1252)
    @expect(sniff("<meta charset=\"latin1\">", "utf-8") == Encoding.Utf8)
    @expect(sniff("<meta http-equiv=content-type content=\"text/html; charset=ISO-8859-1\">", "") == Encoding.Windows1252)
    @expect(sniff("caf\xC3\xA9", "") == Encoding.Utf8)
    @expect(sniff("caf\xE9", "") == Encoding.Windows1252)
}

test "decoding" {
    let a = @testAllocator()
    let s = try toUtf8(a, "caf\xE9 \x80", Encoding.Windows1252)
    defer a.free(s)
    @expectEqual("caf\xC3\xA9 \xE2\x82\xAC", s)
    let u = try toUtf8(a, "\xEF\xBB\xBFok\xFF", Encoding.Utf8)
    defer a.free(u)
    @expectEqual("ok\xEF\xBF\xBD", u)
}

// `bytes` in `enc`, decoded, must be `want` (UTF-8); and `want` encoded
// must be `bytes` again when `round` is set.
fn roundTrip(a: Allocator, enc: Encoding, bytes: []u8, want: []u8, round: bool) bool {
    let s = toUtf8(a, bytes, enc) catch |e| {
        return false
    }
    defer a.free(s)
    if !text.eql(s, want) {
        return false
    }
    if !round {
        return true
    }
    let b = fromUtf8(a, want, enc) catch |e| {
        return false
    }
    defer a.free(b)
    return text.eql(b, bytes)
}

test "CJK labels" {
    @expect(fromLabel("Shift_JIS") == Encoding.ShiftJis)
    @expect(fromLabel("windows-31j") == Encoding.ShiftJis)
    @expect(fromLabel("x-euc-jp") == Encoding.EucJp)
    @expect(fromLabel("ISO-2022-JP") == Encoding.Iso2022Jp)
    @expect(fromLabel("gb2312") == Encoding.Gbk)
    @expect(fromLabel("GB18030") == Encoding.Gb18030)
    @expect(fromLabel("big5-hkscs") == Encoding.Big5)
    @expect(fromLabel("ks_c_5601-1987") == Encoding.EucKr)
    @expectEqual("Shift_JIS", nameOf(Encoding.ShiftJis))
    @expect(sniff("<meta http-equiv=\"Content-Type\" content=\"text/html; charset=Shift_JIS\">", "") == Encoding.ShiftJis)
    @expect(sniff("<meta charset=\"gbk\" />\xD6\xD0", "") == Encoding.Gbk)
    @expect(sniff("\xD6\xD0", "gbk") == Encoding.Gbk)
    @expect(sniffOr("\xD6\xD0", "", Encoding.Gbk) == Encoding.Gbk)
}

test "Shift_JIS" {
    @expect(roundTrip(@testAllocator(), Encoding.ShiftJis, "\x93\xFA\x96\x7B\x8C\xEA\xC3\xB7\xBD\xC4\x87\x40", "\xE6\x97\xA5\xE6\x9C\xAC\xE8\xAA\x9E\xEF\xBE\x83\xEF\xBD\xB7\xEF\xBD\xBD\xEF\xBE\x84\xE2\x91\xA0", true))
    // A bad trail byte that is ASCII is read again; a lone lead at the end.
    @expect(roundTrip(@testAllocator(), Encoding.ShiftJis, "\x93 \x93", "\xEF\xBF\xBD \xEF\xBF\xBD", false))
    // User-defined area: private use.
    @expect(roundTrip(@testAllocator(), Encoding.ShiftJis, "\xF0\x40", "\xEE\x80\x80", false))
}

test "EUC-JP" {
    @expect(roundTrip(@testAllocator(), Encoding.EucJp, "\xC6\xFC\xCB\xDC\xB8\xEC\x8E\xC3\x8E\xB7\x8E\xBD\x8E\xC4", "\xE6\x97\xA5\xE6\x9C\xAC\xE8\xAA\x9E\xEF\xBE\x83\xEF\xBD\xB7\xEF\xBD\xBD\xEF\xBE\x84", true))
    // JIS X 0212 (three bytes) decodes; it is not encoded.
    @expect(roundTrip(@testAllocator(), Encoding.EucJp, "\x8F\xB0\xA1", "\xE4\xB8\x82", false))
}

test "ISO-2022-JP" {
    @expect(roundTrip(@testAllocator(), Encoding.Iso2022Jp, "\x1B$BF|K\\8l%F%-%9%H\x1B(B abc", "\xE6\x97\xA5\xE6\x9C\xAC\xE8\xAA\x9E\xE3\x83\x86\xE3\x82\xAD\xE3\x82\xB9\xE3\x83\x88 abc", true))
    // Roman: \ is the yen sign; two escapes in a row are an error.
    @expect(roundTrip(@testAllocator(), Encoding.Iso2022Jp, "\x1B(J\\\x1B(B\x1B(Bx", "\xC2\xA5\xEF\xBF\xBDx", false))
    // An unknown escape is written as text after U+FFFD.
    @expect(roundTrip(@testAllocator(), Encoding.Iso2022Jp, "\x1B(Zok", "\xEF\xBF\xBD(Zok", false))
}

test "GBK and gb18030" {
    @expect(roundTrip(@testAllocator(), Encoding.Gbk, "\xD6\xD0\xB9\xD8\xB4\xE5\xD4\xDA\xCF\xDF", "\xE4\xB8\xAD\xE5\x85\xB3\xE6\x9D\x91\xE5\x9C\xA8\xE7\xBA\xBF", true))
    @expect(roundTrip(@testAllocator(), Encoding.Gb18030, "\xD6\xD0\xCE\xC4\x81\x30\x81\x30\x94\x39\xFC\x36\xA8\xA6", "\xE4\xB8\xAD\xE6\x96\x87\xC2\x80\xF0\x9F\x98\x80\xC3\xA9", true))
    // GBK reads four-byte sequences too, and writes the euro as 0x80.
    @expect(roundTrip(@testAllocator(), Encoding.Gbk, "\x81\x30\x81\x30", "\xC2\x80", false))
    let a = @testAllocator()
    let euro = try fromUtf8(a, "\xE2\x82\xAC\xF0\x9F\x98\x80", Encoding.Gbk)
    defer a.free(euro)
    @expectEqual("\x80&#128512;", euro)
}

test "Big5" {
    @expect(roundTrip(@testAllocator(), Encoding.Big5, "\xC1\x63\xC5\xE9\xA4\xA4\xA4\xE5", "\xE7\xB9\x81\xE9\xAB\x94\xE4\xB8\xAD\xE6\x96\x87", true))
    // Pointer 1133: two code points.
    @expect(roundTrip(@testAllocator(), Encoding.Big5, "\x88\x62", "\xC3\x8A\xCC\x84", false))
}

test "EUC-KR" {
    @expect(roundTrip(@testAllocator(), Encoding.EucKr, "\xC7\xD1\xB1\xB9\xBE\xEE", "\xED\x95\x9C\xEA\xB5\xAD\xEC\x96\xB4", true))
    @expect(roundTrip(@testAllocator(), Encoding.EucKr, "\xC7", "\xEF\xBF\xBD", false))
}

test "form data in legacy encodings" {
    let a = @testAllocator()
    let w = try fromUtf8(a, "caf\xC3\xA9 \xE2\x82\xAC \xE4\xB8\xAD", Encoding.Windows1252)
    defer a.free(w)
    @expectEqual("caf\xE9 \x80 &#20013;", w)
    let j = try fromUtf8(a, "\xE4\xB8\xAD\xED\x95\x9C", Encoding.ShiftJis)
    defer a.free(j)
    @expectEqual("\x92\x86&#54620;", j)
}
