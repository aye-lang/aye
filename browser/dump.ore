// `anyknown dump`: a document as an indented tree (`--tree`) or as
// readable text (`--text`).

import dom
import dom.Document
import dom.Kind
import dom.NodeId
import engine
import html
import std.mem.AllocError
import std.mem.Allocator
import std.text

// ---- the tree

/// Appends the subtree of `top` to `out`, one node per line, children
/// indented by two spaces:
///
///     #document
///       <!DOCTYPE html>
///       <html>
///         <head>
///         <body class="x">
///           "text\n"
///           <!-- comment -->
///
/// A `template` element's contents follow it as a `#document-fragment`.
pub fn dumpTree(doc: *Document, top: NodeId, out: *mut text.Builder) AllocError!void {
    return dumpTreeAt(doc, top, 0, out)
}

fn dumpTreeAt(doc: *Document, top: NodeId, base: usize, out: *mut text.Builder) AllocError!void {
    var cur: ?NodeId = top
    var depth = base
    while cur |h| {
        for i in 0..depth {
            try out.append("  ")
        }
        let n = doc.node(h)
        match n.kind {
            .Document => {
                if n.name.len > 0 {
                    try out.append(n.name)
                } else {
                    try out.append("#document")
                }
            }
            .Doctype => {
                try out.append("<!DOCTYPE ")
                try out.append(n.name)
                try out.append(">")
            }
            .Element => {
                try out.appendByte('<')
                try out.append(n.name)
                for a in n.attrs {
                    try out.appendByte(' ')
                    try out.append(a.name)
                    try out.append("=")
                    try quoted(out, a.value)
                }
                try out.appendByte('>')
            }
            .Text => {
                try quoted(out, n.data)
            }
            .Comment => {
                try out.append("<!-- ")
                try escaped(out, n.data)
                try out.append(" -->")
            }
        }
        try out.appendByte('\n')
        if n.kind == Kind.Element {
            if doc.templateContent(h) |frag| {
                try dumpTreeAt(doc, frag, depth + 1, out)
            }
        }
        // Next in document order, tracking the depth.
        if n.first_child |c| {
            depth += 1
            cur = c
        } else {
            cur = null
            var up = h
            while !dom.same(up, top) {
                let u = doc.node(up)
                if u.next |next| {
                    cur = next
                    break
                }
                if u.parent |p| {
                    up = p
                    depth -= 1
                } else {
                    break
                }
            }
        }
    }
}

// `s` in double quotes, with `"`, `\` and control characters escaped.
fn quoted(out: *mut text.Builder, s: []u8) AllocError!void {
    try out.appendByte('"')
    try escaped(out, s)
    try out.appendByte('"')
}

// `s` with `"`, `\` and control characters escaped, so that it stays on
// one line.
fn escaped(out: *mut text.Builder, s: []u8) AllocError!void {
    for c in s {
        if c == '"' || c == '\\' {
            try out.appendByte('\\')
            try out.appendByte(c)
        } else if c == '\n' {
            try out.append("\\n")
        } else if c == '\t' {
            try out.append("\\t")
        } else if c < 0x20 {
            try out.append("\\x")
            try out.appendByte(HEX[(c >> 4) as usize])
            try out.appendByte(HEX[(c & 15) as usize])
        } else {
            try out.appendByte(c)
        }
    }
}

let HEX = "0123456789abcdef"

// ---- readable text

// Elements whose content is not shown.
let HIDDEN = "head script style template title noembed noframes select datalist iframe object svg math"
// Blocks that stand apart by an empty line.
let PARAGRAPHS = "p h1 h2 h3 h4 h5 h6 pre blockquote ul ol dl table figure hr form"
// Blocks that start and end a line.
let BLOCKS = "address article aside body center caption details dialog dir div dd dt fieldset figcaption footer header hgroup html legend li listing main menu nav noscript option plaintext search section summary tr xmp"

/// Appends the readable text of the subtree of `top` to `out`: block
/// elements on their own lines, whitespace collapsed (except in `pre`),
/// hidden content left out, list items as "- item", images as their
/// `[alt]` text, table cells separated by " | ".
pub fn dumpText(alloc: Allocator, doc: *Document, top: NodeId, out: *mut text.Builder) AllocError!void {
    var buf = text.Builder.init(alloc)
    defer buf.deinit()
    var w = TextWriter {
        doc: doc,
        out: &mut buf,
        breaks: 0,
        space: false,
        marker: "",
        lists: 0,
        pre: 0,
        cells: 0,
    }
    try w.node(top)
    // Without the newlines at the end (`pre` text may leave some), then
    // exactly one.
    var all = buf.bytes()
    while all.len > 0 && all[all.len - 1] == '\n' {
        all = all[..all.len - 1]
    }
    if all.len > 0 {
        try out.append(all)
        try out.appendByte('\n')
    }
}

struct TextWriter {
    doc: *Document
    out: *mut text.Builder
    // Line breaks wanted before the next text: 0, 1 (new line) or 2
    // (empty line).
    breaks: usize
    // A space is wanted before the next text on the same line.
    space: bool
    // The list item marker that starts the next line ("- ").
    marker: []u8
    // How deep in lists (indentation of items), and in `pre`.
    lists: usize
    pre: usize
    // Cells so far in the current table row.
    cells: usize

    fn node(self: *mut Self, h: NodeId) AllocError!void {
        let n = self.doc.node(h)
        match n.kind {
            .Text => {
                if self.pre > 0 {
                    try self.preText(n.data)
                } else {
                    try self.words(n.data)
                }
            }
            .Document => {
                try self.children(h)
            }
            .Element => {
                try self.element(h)
            }
            .Doctype => {}
            .Comment => {}
        }
    }

    fn children(self: *mut Self, h: NodeId) AllocError!void {
        var cur = self.doc.firstChild(h)
        while cur |c| {
            try self.node(c)
            cur = self.doc.nextSibling(c)
        }
    }

    fn element(self: *mut Self, h: NodeId) AllocError!void {
        let name = self.doc.node(h).name
        if html.isIn(name, HIDDEN) || self.doc.attr(h, "hidden") != null {
            return
        }
        // `noscript` is shown only when scripts do not run.
        if text.eql(name, "noscript") && engine.scriptingEnabled() {
            return
        }
        if text.eql(name, "br") {
            return self.lineBreak()
        }
        if text.eql(name, "img") {
            if self.doc.attr(h, "alt") |alt| {
                let t = text.trim(alt)
                if t.len > 0 {
                    try self.put("[")
                    try self.words(t)
                    try self.put("]")
                }
            }
            return
        }
        if text.eql(name, "hr") {
            self.block(2)
            try self.put("---")
            self.block(2)
            return
        }
        if text.eql(name, "td") || text.eql(name, "th") {
            if self.cells > 0 && self.breaks == 0 && !self.atLineStart() {
                self.space = false
                try self.put(" | ")
            }
            self.cells += 1
            return self.children(h)
        }
        var gap: usize = 0
        if html.isIn(name, PARAGRAPHS) {
            gap = 2
            // A list inside a list item only needs a new line.
            if self.lists > 0 && (text.eql(name, "ul") || text.eql(name, "ol")) {
                gap = 1
            }
        } else if html.isIn(name, BLOCKS) {
            gap = 1
        }
        self.block(gap)
        let saved_cells = self.cells
        if text.eql(name, "tr") {
            self.cells = 0
        }
        if text.eql(name, "li") {
            self.marker = "- "
        }
        let list = text.eql(name, "ul") || text.eql(name, "ol")
        if list {
            self.lists += 1
        }
        let pre = text.eql(name, "pre") || text.eql(name, "textarea") || text.eql(name, "listing") || text.eql(name, "plaintext") || text.eql(name, "xmp")
        if pre {
            self.pre += 1
        }
        try self.children(h)
        if list {
            self.lists -= 1
        }
        if pre {
            self.pre -= 1
        }
        if text.eql(name, "li") {
            self.marker = ""
        }
        self.cells = saved_cells
        self.block(gap)
    }

    // Asks for `n` line breaks before the next text.
    fn block(self: *mut Self, n: usize) {
        if n > self.breaks {
            self.breaks = n
        }
    }

    // `<br>`: ends the line, even an empty one.
    fn lineBreak(self: *mut Self) AllocError!void {
        if self.out.len() == 0 {
            return
        }
        try self.flushBreaks()
        try self.out.appendByte('\n')
        self.space = false
    }

    // Text with its whitespace collapsed: runs of spaces, tabs and
    // newlines become one space between words.
    fn words(self: *mut Self, s: []u8) AllocError!void {
        var i: usize = 0
        while i < s.len {
            if isSpace(s[i]) {
                self.space = true
                i += 1
                continue
            }
            var j = i
            while j < s.len && !isSpace(s[j]) {
                j += 1
            }
            try self.put(s[i..j])
            i = j
        }
    }

    // Text inside `pre`: as it is, line by line.
    fn preText(self: *mut Self, s: []u8) AllocError!void {
        var lines = text.split(s, "\n")
        var first = true
        while lines.next() |line| {
            if !first {
                try self.flushBreaks()
                try self.out.appendByte('\n')
                self.space = false
            }
            first = false
            if line.len > 0 {
                try self.put(line)
            }
        }
    }

    // Writes `s` after the pending line breaks, indentation, list marker
    // or space.
    fn put(self: *mut Self, s: []u8) AllocError!void {
        try self.flushBreaks()
        if self.atLineStart() {
            if self.marker.len > 0 {
                for i in 1..self.lists {
                    try self.out.append("  ")
                }
                try self.out.append(self.marker)
                self.marker = ""
            } else if self.lists > 0 {
                for i in 0..self.lists {
                    try self.out.append("  ")
                }
            }
        } else if self.space {
            try self.out.appendByte(' ')
        }
        self.space = false
        try self.out.append(s)
    }

    fn flushBreaks(self: *mut Self) AllocError!void {
        if self.out.len() == 0 {
            self.breaks = 0
            return
        }
        while self.trailingNewlines() < self.breaks {
            try self.out.appendByte('\n')
        }
        if self.breaks > 0 {
            self.space = false
        }
        self.breaks = 0
    }

    fn atLineStart(self: *Self) bool {
        return self.out.len() == 0 || self.trailingNewlines() > 0
    }

    fn trailingNewlines(self: *Self) usize {
        let b = self.out.bytes()
        var n: usize = 0
        while n < b.len && b[b.len - 1 - n] == '\n' {
            n += 1
        }
        return n
    }
}

fn isSpace(c: u8) bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\x0C'
}
