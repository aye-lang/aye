// Named character references (`&amp;`, `&eacute;`, ...): the 252 of HTML 4,
// `&apos;`, and common single-code-point ones of HTML 5. Sorted by name
// (byte order) for a binary search. `legacy` marks the 106 names that
// HTML also recognizes without the final `;` (`&copy`, `&amp`).

struct Entity {
    name: []u8
    code: u32
    legacy: bool
}

/// The entity named exactly `name` (without `&` and `;`).
fn findEntity(name: []u8) ?Entity {
    var lo: usize = 0
    var hi = ENTITIES.len
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let c = compareBytes(ENTITIES[mid].name, name)
        if c == 0 {
            return ENTITIES[mid]
        }
        if c < 0 {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return null
}

// Byte order of `a` and `b`: negative, zero or positive.
fn compareBytes(a: []u8, b: []u8) i64 {
    var i: usize = 0
    while i < a.len && i < b.len {
        if a[i] != b[i] {
            return a[i] as i64 - b[i] as i64
        }
        i += 1
    }
    return a.len as i64 - b.len as i64
}

